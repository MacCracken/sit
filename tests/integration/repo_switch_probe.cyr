# repo_switch_probe.cyr — one process, several repositories (1.11.0, R6).
#
# Built by tests/integration/run.sh against the SHIPPED read bundle
# (dist/sit-read.cyr — what owl and thoth link). Each argument is a step:
#
#   <path>         sit_repo_open(<path>), then print one line:
#                  "<path> <M> <N> <D>" — the counts sit_repo_status reports
#   @wait:<file>   print "WAITING", then wait (up to 30 s) until <file> exists
#
# Through 1.10.1 the second repository was read through the first one's store
# and index handles. Between the steps no store lock is held (store sessions),
# so a `sit gc` can run during an @wait. Not part of the product.
include "dist/sit-read.cyr"

fn _put(s) {
    stdout_write(s, strlen(s));
    return 0;
}

fn _put_num(v) {
    var nb[24];
    var k = write_decimal(&nb, v);
    stdout_write(&nb, k);
    return 0;
}

# Open `path` and print its status counts.
fn _step_repo(path) {
    if (sit_repo_open(path) == 0) {
        _put(path);
        _put(" OPEN-FAILED\n");
        return 1;
    }
    var st = sit_repo_status(1);
    var m = 0;
    var nn = 0;
    var d = 0;
    var i = 0;
    while (i < vec_len(st)) {
        var k = sit_status_kind(vec_get(st, i));
        if (k == 1) { m = m + 1; }
        if (k == 2) { nn = nn + 1; }
        if (k == 3) { d = d + 1; }
        i = i + 1;
    }
    _put(path);
    _put(" ");
    _put_num(m);
    _put(" ");
    _put_num(nn);
    _put(" ");
    _put_num(d);
    _put("\n");
    return 0;
}

# Wait until `file` exists, at most 30 s.
fn _step_wait(file) {
    _put("WAITING\n");
    stdout_flush();
    var tries = 0;
    while (tries < 600) {
        if (path_lstat_kind(file) >= 0) { tries = 600; }
        else {
            sleep_ms(50);
            tries = tries + 1;
        }
    }
    return 0;
}

# Run each argument as a step.
fn main() {
    alloc_init();
    args_init();
    var i = 1;
    while (i < argc()) {
        var a = argv_heap(i);
        if (memeq(a, "@wait:", 6) == 1) { _step_wait(a + 6); }
        else { _step_repo(a); }
        stdout_flush();
        i = i + 1;
    }
    stdout_flush();
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
