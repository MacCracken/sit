# sit — fuzz harness
# Pokes random/adversarial bytes at the primitives that parse untrusted data
# (zlib frames in object files, tree/commit bodies from disk, /sit/v1/want
# response frames). Confirms no crash on malformed input.
#
# v0.7.1: add validate.cyr include for url_scheme + remote_url_valid fuzzing.
# v0.7.5: include src/lib.cyr to reach `_wire_http_decode_frames` for the
#   `/sit/v1/want` frame-decoder fuzz target. Pulls in the whole sit surface
#   (cmd_*, serve, etc.) but DCE strips everything not reachable from the
#   fuzz `main()`.
# Stdlib + deps are auto-included via cyrius.cyml.
include "src/lib.cyr"

fn fill_pseudo_random(buf, len, seed) {
    var s = seed;
    var i = 0;
    while (i < len) {
        s = s * 2654435769 + 1;
        store8(buf + i, s & 0xFF);
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to zlib_decompress; it must return safely (likely error).
fn fuzz_zlib_decompress(rounds) {
    var buf_cap = 8192;
    var out_cap = 65536;
    var input = alloc(buf_cap);
    var output = alloc(out_cap);
    var seed = 1;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFFF) + 1;  # 1..4096
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        zlib_decompress(input, size, output, out_cap);
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to hash_data at varied sizes; verify return is non-null.
fn fuzz_hash_data(rounds) {
    var buf_cap = 16384;
    var input = alloc(buf_cap);
    var seed = 0x13379001;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0x3FFF);  # 0..16383
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        var hex = hash_data(input, size);
        if (hex == 0) {
            println("fuzz: hash_data returned 0 — unexpected");
            return 1;
        }
        seed = seed * 2862933555 + 3037000493;
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to hex_decode — malformed hex should return 0, not crash.
fn fuzz_hex_decode(rounds) {
    var buf_cap = 128;
    var input = alloc(buf_cap);
    var seed = 0x5a5a5a5a;
    var i = 0;
    while (i < rounds) {
        var size = seed & 0x7F;  # 0..127
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        hex_decode(input, size);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# v0.7.1: feed random bytes to url_scheme + remote_url_valid. Both must return
# cleanly (0 / -1 / 1) for any input. NUL-terminator is forced at the end of
# the random region so strlen() never reads past the buffer; embedded NULs
# inside the body are deliberately preserved so strlen-truncation behavior
# also gets exercised. Catches: scheme-prefix off-by-one, body-validator
# bounds slip, sign-extension on `load8 & 0xFF`-missing branches.
fn fuzz_url_validators(rounds) {
    var buf_cap = 256;
    var input = alloc(buf_cap);
    var seed = 0xdeadbeef;
    var i = 0;
    while (i < rounds) {
        var size = seed & 0xFF;  # 0..255
        if (size >= buf_cap) { size = buf_cap - 1; }
        fill_pseudo_random(input, size, seed);
        store8(input + size, 0);  # NUL terminate
        url_scheme(input);
        remote_url_valid(input);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# v0.7.5 — fuzz the `/sit/v1/want` response-frame decoder.
# Adversarial pseudo-random bytes go through `_wire_http_decode_frames`;
# the parser must terminate cleanly (returns 0 or -1) on every input
# without OOB reads, infinite loops, or oversized allocs. The decoder
# is the single trust boundary for compressed-bytes-from-the-wire and
# every byte of its input is attacker-controlled when an http remote
# is in use, so 10M+ iterations are warranted (per ADR 0006 success
# gate). Each round draws a fresh size in [0, 4096] — exercises both
# "frame fits" (rare, mostly empty cache) and "frame doesn't fit"
# (common, parser must reject without alloc'ing the bogus payload
# size). Buffer sizes >= 80 occasionally produce a syntactically
# complete header followed by a clen large enough to extend past
# the buffer; the parser must reject those instead of reading OOB.
fn fuzz_want_frame_decoder(rounds) {
    var buf_cap = 4096;
    var input = alloc(buf_cap);
    var seed = 0xfa57b047;
    var i = 0;
    while (i < rounds) {
        var size = seed & 0xFFF;  # 0..4095
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        # Use a fresh map per round to keep the parser path pristine —
        # collisions in the cache key space don't crash but they
        # waste memory across millions of iterations.
        var cache = map_new();
        _wire_http_decode_frames(input, size, cache);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# Drive pseudo-random bytes through _ssh_parse_url. The parser is the
# load-bearing CVE-2017-1000117 defense (rejects user / host / path
# components starting with `-`). Verifies the parser survives malformed
# input without OOB-reads or infinite loops — every byte sequence
# either returns a parsed handle or 0. Particularly exercises the
# leading-dash rejection, the user@host @-separator, and host:port
# colon detection.
fn fuzz_ssh_url_parser(rounds) {
    var buf_cap = 256;
    var input = alloc(buf_cap + 1);
    memcpy(input, "ssh://", 6);
    var u_cell = alloc(8);
    var h_cell = alloc(8);
    var p_cell = alloc(8);
    var path_cell = alloc(8);
    var seed = 0x55534831;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFF) + 6;
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input + 6, size - 6, seed);
        store8(input + size, 0);
        store64(u_cell, 0); store64(h_cell, 0);
        store64(p_cell, 0); store64(path_cell, 0);
        _ssh_parse_url(input, u_cell, h_cell, p_cell, path_cell);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to the reflog index/parse core as if it were a log
# buffer. count/nth/msg must never read past `len` or crash on garbage.
fn fuzz_reflog_index(rounds) {
    var buf_cap = 4096;
    var input = alloc(buf_cap);
    var out = alloc(80);
    var pair[16];
    var seed = 7;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFFF) + 1;  # 1..4096
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        _reflog_count_in_buf(input, size);
        var n = (seed >> 8) & 0x3F;
        _reflog_nth_in_buf(input, size, n, out);
        _reflog_nth_in_buf(input, size, 0, out);
        _reflog_nth_in_buf(input, size, 0 - 1, out);
        _reflog_line_msg(input, size, &pair);
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# S-24: the git packfile decoders had NO fuzz target through v1.3.6, and that is
# exactly where the 2026-08-17 audit found an unbounded `.idx` table read
# (SIGSEGV) and an out-of-bounds delta literal read that leaked heap bytes —
# including a live pointer — into `cat-file` output. Every one of these parses
# attacker-controlled bytes from a cloned repo, so they get a harness.
#
# The varint decoders and `_git_apply_delta` are pure (buffer + length), so they
# fuzz in-process. `_git_idx_lookup` takes a path, so its hostile-input coverage
# lives in the integration corpus (tests/integration/hostile_pack.py) instead.
fn fuzz_pack_varints(rounds) {
    var buf_cap = 512;
    var input = alloc(buf_cap);
    var cur[8];
    var type_slot[8];
    var seed = 0x9E3779B1;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFF) + 1;   # 1..256
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        # Start the cursor at a random in-range offset, including the last byte,
        # so a continuation bit on the final byte is exercised every round.
        var start = seed & 0x7F;
        if (start >= size) { start = size - 1; }

        store64(&cur, start);
        _pack_obj_header(input, &cur, &type_slot, size);
        store64(&cur, start);
        _ofs_varint(input, &cur, size);
        store64(&cur, start);
        _delta_varint(input, &cur, size);

        # Cursor already past the end must fail closed, not read.
        store64(&cur, size);
        _pack_obj_header(input, &cur, &type_slot, size);
        store64(&cur, size);
        _ofs_varint(input, &cur, size);
        store64(&cur, size);
        _delta_varint(input, &cur, size);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# Random delta instruction streams against a fixed base. Every accepted result
# must have consumed exactly `result_size` bytes; the harness only asserts no
# crash, which is what the OOB literal read would have produced under ASAN.
fn fuzz_apply_delta(rounds) {
    var base_cap = 4096;
    var delta_cap = 1024;
    var base = alloc(base_cap);
    var delta = alloc(delta_cap);
    var out24[24];
    fill_pseudo_random(base, base_cap, 0x5EED);
    var seed = 0xC0FFEE;
    var i = 0;
    while (i < rounds) {
        var dlen = (seed & 0x3FF) + 1;  # 1..1024
        if (dlen > delta_cap) { dlen = delta_cap; }
        fill_pseudo_random(delta, dlen, seed);
        _git_apply_delta(base, base_cap, delta, dlen, &out24);
        # Zero-length and negative-length deltas must fail closed.
        _git_apply_delta(base, base_cap, delta, 0, &out24);
        _git_apply_delta(base, 0, delta, dlen, &out24);
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# ── v1.4.7: the four remaining unfuzzed parsers ───────────────────────────
# From the 2026-08-17 audit, whose central lesson was that the one module with
# NO fuzz target held every serious finding. These four all parse untrusted
# bytes and had unit tests but no harness.
#
# All four branch on the active backend's object-id width — `_id_rawlen()` /
# `_id_hexlen()` return 32/64 for sit's SHA-256, 20/40 for a git SHA-1 repo and
# 32/64 for git SHA-256 — so each target cycles `_repo_backend` /
# `_git_hash_algo` across rounds. The SHA-1 path is different arithmetic on the
# same buffers, and it is the one reached when reading a real-world `.git/`.

fn _fz_set_backend(sel) {
    if (sel == 0) { _repo_backend = 0; _git_hash_algo = 1; return 0; }
    if (sel == 1) { _repo_backend = 1; _git_hash_algo = 0; return 0; }
    _repo_backend = 1;
    _git_hash_algo = 1;
    return 0;
}

# Tree bodies: "<mode> <name>\0<rawhash>" repeated. Random bytes hit the
# framing checks; the seeded well-formed prefix walks the accept path far
# enough to reach the mode/name validators and the entry-drop counter.
fn fuzz_parse_tree(rounds) {
    var cap = 4096;
    var body = alloc(cap);
    var seed = 0x7EE00001;
    var i = 0;
    while (i < rounds) {
        _fz_set_backend(seed % 3);
        var rawlen = _id_rawlen();

        # Build a WELL-FORMED body of 3 entries, then corrupt one random byte.
        # Pure random bytes never synthesise a valid "<mode> <name>\0<rawhash>"
        # record — a first cut of this target parsed 0 entries in 200k rounds
        # while dropping 160k, i.e. it only ever exercised the reject path. The
        # accept path is where the hash read and the entry allocation live, so
        # it is the half that matters for memory safety. Seeding valid records
        # and mutating reaches both: most rounds parse, mutated rounds land on
        # the mode digits, the name, the NUL, or the hash and near-miss.
        var w = 0;
        var e = 0;
        while (e < 3) {
            store8(body + w, 49); w = w + 1;      # '1'
            store8(body + w, 48); w = w + 1;      # '0'
            store8(body + w, 48); w = w + 1;      # '0'
            store8(body + w, 54); w = w + 1;      # '6'
            store8(body + w, 52); w = w + 1;      # '4'
            store8(body + w, 52); w = w + 1;      # '4'
            store8(body + w, 32); w = w + 1;      # ' '
            var nlen = ((seed >> (e * 3)) & 0x07) + 1;   # 1..8 byte name
            var k = 0;
            while (k < nlen) {
                store8(body + w, 97 + ((seed + k + e) & 0x0F));
                w = w + 1;
                k = k + 1;
            }
            store8(body + w, 0); w = w + 1;       # NUL terminator
            var h = 0;
            while (h < rawlen) {
                store8(body + w, (seed + h * 31 + e) & 0xFF);
                w = w + 1;
                h = h + 1;
            }
            e = e + 1;
        }

        # Corrupt one byte on 3 of every 4 rounds; leave a clean parse on the 4th.
        if ((seed & 3) != 0) {
            var off = (seed >> 5) % w;
            store8(body + off, (seed >> 11) & 0xFF);
        }

        tree_dropped_reset();
        parse_tree(body, w);

        # Truncation at every prefix length is the classic tree-parser bug:
        # a record header that promises more bytes than the body holds.
        parse_tree(body, (seed >> 7) % (w + 1));
        parse_tree(body, 0);

        # A fully random body still gets a turn — it covers the "no space, no
        # NUL anywhere" shapes the seeded builder cannot produce.
        var rsize = (seed & 0x1FF) + 1;
        fill_pseudo_random(body, rsize, seed);
        tree_dropped_reset();
        parse_tree(body, rsize);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    _fz_set_backend(0);
    return 0;
}

# Commit bodies: header block ("tree "/"parent "/"author "/"committer ") then a
# blank line then the message. Hostile timestamps are in scope — S-25 clamps
# them, and `epoch_to_date`'s year-at-a-time walk is what that guards.
fn fuzz_parse_commit_body(rounds) {
    var cap = 4096;
    var body = alloc(cap);
    var info[56];
    var seed = 0xC0FFEE11;
    var i = 0;
    while (i < rounds) {
        _fz_set_backend(seed % 3);
        var size = (seed & 0x3FF) + 1;   # 1..1024
        if (size > cap) { size = cap; }
        fill_pseudo_random(body, size, seed);

        if ((seed & 3) == 0) {
            # "tree " — drives the hex-width read at the object-id boundary.
            store8(body + 0, 116); store8(body + 1, 114); store8(body + 2, 101);
            store8(body + 3, 101); store8(body + 4, 32);
        }
        if ((seed & 3) == 1) {
            # "parent " — the multi-parent vec path (v0.8.7, out+48).
            store8(body + 0, 112); store8(body + 1, 97); store8(body + 2, 114);
            store8(body + 3, 101); store8(body + 4, 110); store8(body + 5, 116);
            store8(body + 6, 32);
        }
        if ((seed & 3) == 2) {
            # "author " — reaches parse_author_line and the timestamp clamp.
            store8(body + 0, 97); store8(body + 1, 117); store8(body + 2, 116);
            store8(body + 3, 104); store8(body + 4, 111); store8(body + 5, 114);
            store8(body + 6, 32);
        }
        parse_commit_body(body, size, &info);
        parse_commit_body(body, 0, &info);
        seed = seed * 2862933555 + 3037000493;
        i = i + 1;
    }
    _fz_set_backend(0);
    return 0;
}

# packed-refs buffers. Fuzzes the pure scanner split out in v1.4.7; the disk
# wrapper only supplies (buf, len). Refname length is varied because the line
# test is `line_len == hexlen + 1 + rn_len`, so rn_len steers which random
# lines reach the hex validator and the memeq.
fn fuzz_packed_ref_scan(rounds) {
    var cap = 2048;
    var buf = alloc(cap);
    var out[128];
    var rn = alloc(64);
    var seed = 0x9ACD0011;
    var i = 0;
    while (i < rounds) {
        _fz_set_backend(seed % 3);
        var hexlen = _id_hexlen();

        # Refname first — the line test is `line_len == hexlen + 1 + rn_len`,
        # so the buffer has to be built to match a specific refname length.
        var rlen = ((seed >> 3) & 0x0F) + 1;   # 1..16
        var k = 0;
        while (k < rlen) {
            store8(rn + k, 97 + ((seed + k) & 0x0F));
            k = k + 1;
        }
        store8(rn + rlen, 0);

        # Build WELL-FORMED "<hex> <refname>\n" lines, preceded by a '#' comment
        # and a '^' peeled line so both skip branches are walked. Random bytes
        # alone scored 0 hits in 200k rounds — the memcpy into out_buf, which is
        # the whole memory-safety question here, was never reached.
        var w = 0;
        store8(buf + w, 35); w = w + 1;        # '#' comment line
        store8(buf + w, 120); w = w + 1;
        store8(buf + w, 10); w = w + 1;
        store8(buf + w, 94); w = w + 1;        # '^' peeled line
        store8(buf + w, 97); w = w + 1;
        store8(buf + w, 10); w = w + 1;

        var h = 0;
        while (h < hexlen) {
            var nib = (seed + h * 7) & 0x0F;
            if (nib < 10) { store8(buf + w, 48 + nib); }
            else { store8(buf + w, 97 + nib - 10); }
            w = w + 1;
            h = h + 1;
        }
        store8(buf + w, 32); w = w + 1;        # the OID/name boundary space
        var m = 0;
        while (m < rlen) {
            store8(buf + w, load8(rn + m));
            w = w + 1;
            m = m + 1;
        }
        store8(buf + w, 10); w = w + 1;

        # Corrupt one byte on 3 of every 4 rounds so near-misses (bad hex, a
        # non-space at the boundary, a refname off by one byte) get covered
        # alongside the clean hit.
        if ((seed & 3) != 0) {
            var off = (seed >> 9) % w;
            store8(buf + off, (seed >> 17) & 0xFF);
        }

        _git_packed_ref_scan(buf, w, rn, &out);

        # Truncation mid-OID and mid-name: a line that runs off the buffer end
        # without its newline is the shape that would over-read.
        _git_packed_ref_scan(buf, (seed >> 6) % (w + 1), rn, &out);
        _git_packed_ref_scan(buf, 0, rn, &out);

        # Empty refname is a degenerate accept-path edge (rn_len == 0).
        store8(rn + 0, 0);
        _git_packed_ref_scan(buf, w, rn, &out);

        # Fully random buffer still gets a turn for the no-newline shapes.
        var rsize = (seed & 0x1FF) + 1;
        if (rsize > cap) { rsize = cap; }
        fill_pseudo_random(buf, rsize, seed);
        _git_packed_ref_scan(buf, rsize, rn, &out);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    _fz_set_backend(0);
    return 0;
}

# _wildmatch: random patterns against random subjects, plus the adversarial
# star-heavy shapes that motivated 1.3.8's per-match step budget. The budget is
# the only thing standing between a hostile `.sitignore` and exponential
# backtracking, so the point of this target is that these RETURN — the harness
# would hang, not crash, if the budget regressed.
fn fuzz_wildmatch(rounds) {
    var pcap = 128;
    var scap = 256;
    var pat = alloc(pcap);
    var str = alloc(scap);
    var seed = 0x51DE0001;
    var i = 0;
    while (i < rounds) {
        var plen = (seed & 0x1F) + 1;    # 1..32
        var slen = ((seed >> 5) & 0x3F) + 1;  # 1..64

        # Draw from a small alphabet heavy in glob metacharacters, so random
        # draws actually produce globs rather than literals that never branch.
        var k = 0;
        while (k < plen) {
            var c = (seed + k * 7) & 0x07;
            if (c == 0) { store8(pat + k, 42); }        # *
            if (c == 1) { store8(pat + k, 63); }        # ?
            if (c == 2) { store8(pat + k, 91); }        # [
            if (c == 3) { store8(pat + k, 93); }        # ]
            if (c == 4) { store8(pat + k, 47); }        # /
            if (c == 5) { store8(pat + k, 97); }        # a
            if (c == 6) { store8(pat + k, 98); }        # b
            if (c == 7) { store8(pat + k, 92); }        # backslash
            k = k + 1;
        }
        store8(pat + plen, 0);

        var j = 0;
        while (j < slen) {
            var d = (seed + j * 3) & 0x03;
            if (d == 0) { store8(str + j, 97); }        # a
            if (d == 1) { store8(str + j, 98); }        # b
            if (d == 2) { store8(str + j, 47); }        # /
            if (d == 3) { store8(str + j, 46); }        # .
            j = j + 1;
        }
        store8(str + slen, 0);

        _wildmatch(pat, plen, str, slen);
        # Zero lengths on either side must fail closed.
        _wildmatch(pat, 0, str, slen);
        _wildmatch(pat, plen, str, 0);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }

    # Explicit catastrophic-backtracking shape: "a*a*...a*b" (10 star groups)
    # against a run of 96 'a'. The trailing 'b' never matches, so a naive
    # backtracking matcher must try every way of splitting the run across the
    # stars before concluding "no" — exponential in the star count. 1.3.8's
    # per-match step budget is the only thing that bounds it, and this shape is
    # the A/B probe for that: with the budget raised to 2e9 the harness hangs,
    # with the shipped 200k it returns immediately.
    var stars = 10;
    var bp = 0;
    while (bp < stars) {
        store8(pat + bp * 2, 97);          # 'a'
        store8(pat + bp * 2 + 1, 42);      # '*'
        bp = bp + 1;
    }
    var cat_plen = stars * 2 + 1;
    store8(pat + stars * 2, 98);           # trailing 'b', unmatchable
    store8(pat + cat_plen, 0);
    var sp = 0;
    while (sp < 96) {
        store8(str + sp, 97);
        sp = sp + 1;
    }
    store8(str + 96, 0);
    _wildmatch(pat, cat_plen, str, 96);
    return 0;
}

# tree_entry_name_valid + the v1.4.8 UTF-8 decoder underneath it. The decoder
# reads attacker-controlled bytes (tree entry names arrive from any remote, via
# parse_tree or a push that `_serve_rehash_and_insert` accepts without parsing
# the body), so it is fuzzed directly rather than only through parse_tree —
# whose generated names are ASCII and would never reach the multi-byte paths.
fn fuzz_tree_entry_name(rounds) {
    var cap = 256;
    var name = alloc(cap + 1);
    var seed = 0x7F000111;
    var i = 0;
    while (i < rounds) {
        var nlen = (seed & 0x3F) + 1;   # 1..64
        fill_pseudo_random(name, nlen, seed);
        store8(name + nlen, 0);
        tree_entry_name_valid(name);

        # Seed a guarded prefix so the dot-directory comparison is reached with
        # hostile continuation bytes after it, not just on random noise.
        if ((seed & 3) == 0) {
            store8(name + 0, 46);   # '.'
            store8(name + 1, 103);  # 'g'
            store8(name + 2, 105);  # 'i'
            store8(name + 3, 116);  # 't'
            store8(name + nlen, 0);
            tree_entry_name_valid(name);
            # ".git" + one ignorable + NUL: the exact spoof shape, 7 bytes.
            store8(name + 4, 0xE2);
            store8(name + 5, 0x80);
            store8(name + 6, 0x8C);
            store8(name + 7, 0);
            tree_entry_name_valid(name);
        }

        # Splice a real HFS-ignorable sequence in. Random bytes hit E2 80 8C by
        # chance about once in 16M positions, so without this the skip branch
        # the whole check exists for would never execute under fuzz. Combined
        # with the ".git" prefix above this reaches the spoof comparison with
        # attacker-shaped input, which the unit tests only cover by hand.
        if ((seed & 7) == 1) {
            var at = 4;
            if (at + 3 <= nlen) {
                store8(name + at, 0xE2);
                store8(name + at + 1, 0x80);
                var pick = (seed >> 9) & 3;
                if (pick == 0) { store8(name + at + 2, 0x8C); }   # ZWNJ
                if (pick == 1) { store8(name + at + 2, 0x8D); }   # ZWJ
                if (pick == 2) { store8(name + at + 2, 0xAE); }   # RLO
                if (pick == 3) { store8(name + at + 2, 0x8E); }   # LRM
                store8(name + nlen, 0);
                tree_entry_name_valid(name);
            }
        }

        # Truncated multi-byte sequences at the very end of the buffer are the
        # shape that would over-read past the NUL.
        if (nlen >= 2) {
            store8(name + nlen - 2, 0xE2);
            store8(name + nlen - 1, 0x80);
            store8(name + nlen, 0);
            tree_entry_name_valid(name);
            store8(name + nlen - 1, 0xF0);
            store8(name + nlen, 0);
            tree_entry_name_valid(name);
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    println("fuzz: zlib_decompress (10000 rounds)");
    if (fuzz_zlib_decompress(10000) != 0) { return 1; }
    println("fuzz: hash_data (5000 rounds)");
    if (fuzz_hash_data(5000) != 0) { return 1; }
    println("fuzz: hex_decode (10000 rounds)");
    if (fuzz_hex_decode(10000) != 0) { return 1; }
    println("fuzz: url_validators (10000 rounds)");
    if (fuzz_url_validators(10000) != 0) { return 1; }
    println("fuzz: ssh_url_parser (100000 rounds)");
    if (fuzz_ssh_url_parser(100000) != 0) { return 1; }
    println("fuzz: want_frame_decoder (10000000 rounds)");
    if (fuzz_want_frame_decoder(10000000) != 0) { return 1; }
    println("fuzz: reflog_index (200000 rounds)");
    if (fuzz_reflog_index(200000) != 0) { return 1; }
    println("fuzz: pack_varints (500000 rounds)");
    if (fuzz_pack_varints(500000) != 0) { return 1; }
    println("fuzz: apply_delta (200000 rounds)");
    if (fuzz_apply_delta(200000) != 0) { return 1; }
    println("fuzz: parse_tree (200000 rounds)");
    if (fuzz_parse_tree(200000) != 0) { return 1; }
    println("fuzz: parse_commit_body (200000 rounds)");
    if (fuzz_parse_commit_body(200000) != 0) { return 1; }
    println("fuzz: packed_ref_scan (200000 rounds)");
    if (fuzz_packed_ref_scan(200000) != 0) { return 1; }
    println("fuzz: wildmatch (100000 rounds)");
    if (fuzz_wildmatch(100000) != 0) { return 1; }
    println("fuzz: tree_entry_name (200000 rounds)");
    if (fuzz_tree_entry_name(200000) != 0) { return 1; }
    println("fuzz: no crashes");
    return 0;
}

var r = main();
syscall(60, r);
