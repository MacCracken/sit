# sit — fuzz harness
# Pokes random/adversarial bytes at the primitives that parse untrusted data
# (zlib frames in object files, tree/commit bodies from disk, /sit/v1/want
# response frames). Confirms no crash on malformed input.
#
# v0.7.1: add validate.cyr include for url_scheme + remote_url_valid fuzzing.
# v0.7.5: include src/lib.cyr to reach `_wire_http_decode_frames` for the
#   `/sit/v1/want` frame-decoder fuzz target. Pulls in the whole sit surface
#   (cmd_*, serve, etc.) but DCE strips everything not reachable from the
#   fuzz `main()`.
# Stdlib + deps are auto-included via cyrius.cyml.
include "src/lib.cyr"

# Fill `buf` with deterministic pseudo-random bytes.
fn fill_pseudo_random(buf, len, seed) {
    var s = seed;
    var i = 0;
    while (i < len) {
        s = s * 2654435769 + 1;
        store8(buf + i, s & 0xFF);
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to zlib_decompress; it must return safely (likely error).
fn fuzz_zlib_decompress(rounds) {
    var buf_cap = 8192;
    var out_cap = 65536;
    var input = alloc(buf_cap);
    var output = alloc(out_cap);
    var seed = 1;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFFF) + 1;  # 1..4096
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        zlib_decompress(input, size, output, out_cap);
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to hash_data at varied sizes; verify return is non-null.
fn fuzz_hash_data(rounds) {
    var buf_cap = 16384;
    var input = alloc(buf_cap);
    var seed = 0x13379001;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0x3FFF);  # 0..16383
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        var hex = hash_data(input, size);
        if (hex == 0) {
            println("fuzz: hash_data returned 0 — unexpected");
            return 1;
        }
        seed = seed * 2862933555 + 3037000493;
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to hex_decode — malformed hex should return 0, not crash.
fn fuzz_hex_decode(rounds) {
    var buf_cap = 128;
    var input = alloc(buf_cap);
    var seed = 0x5a5a5a5a;
    var i = 0;
    while (i < rounds) {
        var size = seed & 0x7F;  # 0..127
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        hex_decode(input, size);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# v0.7.1: feed random bytes to url_scheme + remote_url_valid. Both must return
# cleanly (0 / -1 / 1) for any input. NUL-terminator is forced at the end of
# the random region so strlen() never reads past the buffer; embedded NULs
# inside the body are deliberately preserved so strlen-truncation behavior
# also gets exercised. Catches: scheme-prefix off-by-one, body-validator
# bounds slip, sign-extension on `load8 & 0xFF`-missing branches.
fn fuzz_url_validators(rounds) {
    var buf_cap = 256;
    var input = alloc(buf_cap);
    var seed = 0xdeadbeef;
    var i = 0;
    while (i < rounds) {
        var size = seed & 0xFF;  # 0..255
        if (size >= buf_cap) { size = buf_cap - 1; }
        fill_pseudo_random(input, size, seed);
        store8(input + size, 0);  # NUL terminate
        url_scheme(input);
        remote_url_valid(input);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# v0.7.5 — fuzz the `/sit/v1/want` response-frame decoder.
# Adversarial pseudo-random bytes go through `_wire_http_decode_frames`;
# the parser must terminate cleanly (returns 0 or -1) on every input
# without OOB reads, infinite loops, or oversized allocs. The decoder
# is the single trust boundary for compressed-bytes-from-the-wire and
# every byte of its input is attacker-controlled when an http remote
# is in use, so 10M+ iterations are warranted (per ADR 0006 success
# gate). Each round draws a fresh size in [0, 4096] — exercises both
# "frame fits" (rare, mostly empty cache) and "frame doesn't fit"
# (common, parser must reject without alloc'ing the bogus payload
# size). Buffer sizes >= 80 occasionally produce a syntactically
# complete header followed by a clen large enough to extend past
# the buffer; the parser must reject those instead of reading OOB.
fn fuzz_want_frame_decoder(rounds) {
    var buf_cap = 4096;
    var input = alloc(buf_cap);
    var seed = 0xfa57b047;
    var i = 0;
    while (i < rounds) {
        var size = seed & 0xFFF;  # 0..4095
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        # Use a fresh map per round to keep the parser path pristine —
        # collisions in the cache key space don't crash but they
        # waste memory across millions of iterations.
        var cache = map_new();
        _wire_http_decode_frames(input, size, cache);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# Drive pseudo-random bytes through _ssh_parse_url. The parser is the
# load-bearing CVE-2017-1000117 defense (rejects user / host / path
# components starting with `-`). Verifies the parser survives malformed
# input without OOB-reads or infinite loops — every byte sequence
# either returns a parsed handle or 0. Particularly exercises the
# leading-dash rejection, the user@host @-separator, and host:port
# colon detection.
fn fuzz_ssh_url_parser(rounds) {
    var buf_cap = 256;
    var input = alloc(buf_cap + 1);
    memcpy(input, "ssh://", 6);
    var u_cell = alloc(8);
    var h_cell = alloc(8);
    var p_cell = alloc(8);
    var path_cell = alloc(8);
    var seed = 0x55534831;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFF) + 6;
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input + 6, size - 6, seed);
        store8(input + size, 0);
        store64(u_cell, 0); store64(h_cell, 0);
        store64(p_cell, 0); store64(path_cell, 0);
        _ssh_parse_url(input, u_cell, h_cell, p_cell, path_cell);
        seed = seed * 1664525 + 1013904223;
        i = i + 1;
    }
    return 0;
}

# Feed random bytes to the reflog index/parse core as if it were a log
# buffer. count/nth/msg must never read past `len` or crash on garbage.
fn fuzz_reflog_index(rounds) {
    var buf_cap = 4096;
    var input = alloc(buf_cap);
    var out = alloc(80);
    var pair[16];
    var seed = 7;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFFF) + 1;  # 1..4096
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        _reflog_count_in_buf(input, size);
        var n = (seed >> 8) & 0x3F;
        _reflog_nth_in_buf(input, size, n, out);
        _reflog_nth_in_buf(input, size, 0, out);
        _reflog_nth_in_buf(input, size, 0 - 1, out);
        _reflog_line_msg(input, size, &pair);
        # 1.8.0: the time readers over the same bytes. A timestamp is never
        # negative, and an at-time resolve writes a 64-hex oid or nothing.
        if (_reflog_line_ts(input, size) < 0 - 1) { println("fuzz: _reflog_line_ts below -1"); return 1; }
        if (_reflog_at_time_in_buf(input, size, seed & 0xFFFFFFFF, out) == 1) {
            if (hex_prefix_valid(out, 64) == 0) {
                println("fuzz: _reflog_at_time_in_buf wrote a non-hex oid");
                return 1;
            }
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# 1.8.0: `@{<time>}` and `--expire=<when>` come from the command line. The
# parser either refuses (-1) or returns a time in [0, now]; a selector parse
# hands back a base inside the string. Inputs mix time-spec vocabulary with
# random bytes.
fn fuzz_reflog_time(rounds) {
    var cap = 64;
    var input = alloc(cap + 8);
    var name = alloc(cap + 16);
    var words = "now yesterday 2026-10-19 12:34:56 T 1.week.ago 3 days ago months year seconds";
    var wl = strlen(words);
    var now = 1790000000;
    var seed = 13;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0x3F) + 1;
        fill_pseudo_random(input, size, seed);
        if ((i & 1) == 1) {
            var j = 0;
            while (j < size) {
                store8(input + j, load8(words + ((load8(input + j) & 0xFF) % wl)));
                j = j + 1;
            }
        }
        var t = reflog_time_parse(input, size, now);
        if (t != 0 - 1) {
            if (t < 0) { println("fuzz: reflog_time_parse returned a negative time"); return 1; }
            if (t > 253402300799) { println("fuzz: reflog_time_parse returned a time past 9999"); return 1; }
        }
        memcpy(name, "HEAD@{", 6);
        memcpy(name + 6, input, size);
        store8(name + 6 + size, 125);
        store8(name + 7 + size, 0);
        var ds[16];
        if (_reflog_date_spec_parse(name, now, &ds) == 1) {
            if (load64(&ds) != 4) { println("fuzz: date selector base is not HEAD"); return 1; }
            if (load64(&ds + 8) < 0) { println("fuzz: date selector time is negative"); return 1; }
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# S-24: the git packfile decoders had NO fuzz target through v1.3.6, and that is
# exactly where the 2026-08-17 audit found an unbounded `.idx` table read
# (SIGSEGV) and an out-of-bounds delta literal read that leaked heap bytes —
# including a live pointer — into `cat-file` output. Every one of these parses
# attacker-controlled bytes from a cloned repo, so they get a harness.
#
# The varint decoders and `_git_apply_delta` are pure (buffer + length), so they
# fuzz in-process. `_git_idx_lookup` takes a path, so its hostile-input coverage
# lives in the integration corpus (tests/integration/hostile_pack.py) instead.
fn fuzz_pack_varints(rounds) {
    var buf_cap = 512;
    var input = alloc(buf_cap);
    var cur[8];
    var type_slot[8];
    var seed = 0x9E3779B1;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFF) + 1;   # 1..256
        if (size > buf_cap) { size = buf_cap; }
        fill_pseudo_random(input, size, seed);
        # Start the cursor at a random in-range offset, including the last byte,
        # so a continuation bit on the final byte is exercised every round.
        var start = seed & 0x7F;
        if (start >= size) { start = size - 1; }

        store64(&cur, start);
        _pack_obj_header(input, &cur, &type_slot, size);
        store64(&cur, start);
        _ofs_varint(input, &cur, size);
        store64(&cur, start);
        _delta_varint(input, &cur, size);

        # Cursor already past the end must fail closed, not read.
        store64(&cur, size);
        _pack_obj_header(input, &cur, &type_slot, size);
        store64(&cur, size);
        _ofs_varint(input, &cur, size);
        store64(&cur, size);
        _delta_varint(input, &cur, size);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# Random delta instruction streams against a fixed base. Every accepted result
# must have consumed exactly `result_size` bytes; the harness only asserts no
# crash, which is what the OOB literal read would have produced under ASAN.
fn fuzz_apply_delta(rounds) {
    var base_cap = 4096;
    var delta_cap = 1024;
    var base = alloc(base_cap);
    var delta = alloc(delta_cap);
    var out24[24];
    fill_pseudo_random(base, base_cap, 0x5EED);
    var seed = 0xC0FFEE;
    var i = 0;
    while (i < rounds) {
        var dlen = (seed & 0x3FF) + 1;  # 1..1024
        if (dlen > delta_cap) { dlen = delta_cap; }
        fill_pseudo_random(delta, dlen, seed);
        _git_apply_delta(base, base_cap, delta, dlen, &out24);
        # Zero-length and negative-length deltas must fail closed.
        _git_apply_delta(base, base_cap, delta, 0, &out24);
        _git_apply_delta(base, 0, delta, dlen, &out24);
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# ── v1.4.7: the four remaining unfuzzed parsers ───────────────────────────
# From the 2026-08-17 audit, whose central lesson was that the one module with
# NO fuzz target held every serious finding. These four all parse untrusted
# bytes and had unit tests but no harness.
#
# All four branch on the active backend's object-id width — `_id_rawlen()` /
# `_id_hexlen()` return 32/64 for sit's SHA-256, 20/40 for a git SHA-1 repo and
# 32/64 for git SHA-256 — so each target cycles `_repo_backend` /
# `_git_hash_algo` across rounds. The SHA-1 path is different arithmetic on the
# same buffers, and it is the one reached when reading a real-world `.git/`.

fn _fz_set_backend(sel) {
    if (sel == 0) { _repo_backend = 0; _git_hash_algo = 1; return 0; }
    if (sel == 1) { _repo_backend = 1; _git_hash_algo = 0; return 0; }
    _repo_backend = 1;
    _git_hash_algo = 1;
    return 0;
}

# Tree bodies: "<mode> <name>\0<rawhash>" repeated. Random bytes hit the
# framing checks; the seeded well-formed prefix walks the accept path far
# enough to reach the mode/name validators and the entry-drop counter.
fn fuzz_parse_tree(rounds) {
    var cap = 4096;
    var body = alloc(cap);
    var seed = 0x7EE00001;
    var i = 0;
    while (i < rounds) {
        _fz_set_backend(seed % 3);
        var rawlen = _id_rawlen();

        # Build a WELL-FORMED body of 3 entries, then corrupt one random byte.
        # Pure random bytes never synthesise a valid "<mode> <name>\0<rawhash>"
        # record — a first cut of this target parsed 0 entries in 200k rounds
        # while dropping 160k, i.e. it only ever exercised the reject path. The
        # accept path is where the hash read and the entry allocation live, so
        # it is the half that matters for memory safety. Seeding valid records
        # and mutating reaches both: most rounds parse, mutated rounds land on
        # the mode digits, the name, the NUL, or the hash and near-miss.
        var w = 0;
        var e = 0;
        while (e < 3) {
            store8(body + w, 49); w = w + 1;      # '1'
            store8(body + w, 48); w = w + 1;      # '0'
            store8(body + w, 48); w = w + 1;      # '0'
            store8(body + w, 54); w = w + 1;      # '6'
            store8(body + w, 52); w = w + 1;      # '4'
            store8(body + w, 52); w = w + 1;      # '4'
            store8(body + w, 32); w = w + 1;      # ' '
            var nlen = ((seed >> (e * 3)) & 0x07) + 1;   # 1..8 byte name
            var k = 0;
            while (k < nlen) {
                store8(body + w, 97 + ((seed + k + e) & 0x0F));
                w = w + 1;
                k = k + 1;
            }
            store8(body + w, 0); w = w + 1;       # NUL terminator
            var h = 0;
            while (h < rawlen) {
                store8(body + w, (seed + h * 31 + e) & 0xFF);
                w = w + 1;
                h = h + 1;
            }
            e = e + 1;
        }

        # Corrupt one byte on 3 of every 4 rounds; leave a clean parse on the 4th.
        if ((seed & 3) != 0) {
            var off = (seed >> 5) % w;
            store8(body + off, (seed >> 11) & 0xFF);
        }

        tree_dropped_reset();
        parse_tree(body, w);

        # Truncation at every prefix length is the classic tree-parser bug:
        # a record header that promises more bytes than the body holds.
        parse_tree(body, (seed >> 7) % (w + 1));
        parse_tree(body, 0);

        # A fully random body still gets a turn — it covers the "no space, no
        # NUL anywhere" shapes the seeded builder cannot produce.
        var rsize = (seed & 0x1FF) + 1;
        fill_pseudo_random(body, rsize, seed);
        tree_dropped_reset();
        parse_tree(body, rsize);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    _fz_set_backend(0);
    return 0;
}

# Commit bodies: header block ("tree "/"parent "/"author "/"committer ") then a
# blank line then the message. Hostile timestamps are in scope — S-25 clamps
# them, and `epoch_to_date`'s year-at-a-time walk is what that guards.
fn fuzz_parse_commit_body(rounds) {
    var cap = 4096;
    var body = alloc(cap);
    var info[56];
    var ainfo[56];
    var fa = arena_allocator_growable(65536);
    var seed = 0xC0FFEE11;
    var i = 0;
    while (i < rounds) {
        _fz_set_backend(seed % 3);
        var size = (seed & 0x3FF) + 1;   # 1..1024
        if (size > cap) { size = cap; }
        fill_pseudo_random(body, size, seed);

        if ((seed & 3) == 0) {
            # "tree " — drives the hex-width read at the object-id boundary.
            store8(body + 0, 116); store8(body + 1, 114); store8(body + 2, 101);
            store8(body + 3, 101); store8(body + 4, 32);
        }
        if ((seed & 3) == 1) {
            # "parent " — the multi-parent vec path (v0.8.7, out+48).
            store8(body + 0, 112); store8(body + 1, 97); store8(body + 2, 114);
            store8(body + 3, 101); store8(body + 4, 110); store8(body + 5, 116);
            store8(body + 6, 32);
        }
        if ((seed & 3) == 2) {
            # "author " — reaches parse_author_line and the timestamp clamp.
            store8(body + 0, 97); store8(body + 1, 117); store8(body + 2, 116);
            store8(body + 3, 104); store8(body + 4, 111); store8(body + 5, 114);
            store8(body + 6, 32);
        }
        var rg = parse_commit_body(body, size, &info);
        # 1.7.5: the arena form must agree with the global-heap form. (Compared
        # before the zero-length call below, which clears `info`.)
        reset_via(fa);
        var rx = parse_commit_body_a(fa, body, size, &ainfo);
        if (rx != rg) { println("fuzz: parse_commit_body_a disagrees on the verdict"); return 1; }
        if (rg == 0) {
            var why = 0;
            if (streq(load64(&ainfo), load64(&info)) == 0) { why = "fuzz: parse_commit_body_a disagrees on the tree"; }
            if (load64(&ainfo + 24) != load64(&info + 24)) { why = "fuzz: parse_commit_body_a disagrees on the time"; }
            if (load64(&ainfo + 40) != load64(&info + 40)) { why = "fuzz: parse_commit_body_a disagrees on msg_start"; }
            if (why != 0) { println(why); return 1; }
            var gp = load64(&info + 48);
            var xp = load64(&ainfo + 48);
            var gn = 0;
            var xn = 0;
            if (gp != 0) { gn = vec_len(gp); }
            if (xp != 0) { xn = vec_len(xp); }
            if (gn != xn) { println("fuzz: parse_commit_body_a disagrees on the parents"); return 1; }
        }
        parse_commit_body(body, 0, &info);
        seed = seed * 2862933555 + 3037000493;
        i = i + 1;
    }
    _fz_set_backend(0);
    return 0;
}

# packed-refs buffers. Fuzzes the pure scanner split out in v1.4.7; the disk
# wrapper only supplies (buf, len). Refname length is varied because the line
# test is `line_len == hexlen + 1 + rn_len`, so rn_len steers which random
# lines reach the hex validator and the memeq.
fn fuzz_packed_ref_scan(rounds) {
    var cap = 2048;
    var buf = alloc(cap);
    var out[128];
    var rn = alloc(64);
    var seed = 0x9ACD0011;
    var i = 0;
    while (i < rounds) {
        _fz_set_backend(seed % 3);
        var hexlen = _id_hexlen();

        # Refname first — the line test is `line_len == hexlen + 1 + rn_len`,
        # so the buffer has to be built to match a specific refname length.
        var rlen = ((seed >> 3) & 0x0F) + 1;   # 1..16
        var k = 0;
        while (k < rlen) {
            store8(rn + k, 97 + ((seed + k) & 0x0F));
            k = k + 1;
        }
        store8(rn + rlen, 0);

        # Build WELL-FORMED "<hex> <refname>\n" lines, preceded by a '#' comment
        # and a '^' peeled line so both skip branches are walked. Random bytes
        # alone scored 0 hits in 200k rounds — the memcpy into out_buf, which is
        # the whole memory-safety question here, was never reached.
        var w = 0;
        store8(buf + w, 35); w = w + 1;        # '#' comment line
        store8(buf + w, 120); w = w + 1;
        store8(buf + w, 10); w = w + 1;
        store8(buf + w, 94); w = w + 1;        # '^' peeled line
        store8(buf + w, 97); w = w + 1;
        store8(buf + w, 10); w = w + 1;

        var h = 0;
        while (h < hexlen) {
            var nib = (seed + h * 7) & 0x0F;
            if (nib < 10) { store8(buf + w, 48 + nib); }
            else { store8(buf + w, 97 + nib - 10); }
            w = w + 1;
            h = h + 1;
        }
        store8(buf + w, 32); w = w + 1;        # the OID/name boundary space
        var m = 0;
        while (m < rlen) {
            store8(buf + w, load8(rn + m));
            w = w + 1;
            m = m + 1;
        }
        store8(buf + w, 10); w = w + 1;

        # Corrupt one byte on 3 of every 4 rounds so near-misses (bad hex, a
        # non-space at the boundary, a refname off by one byte) get covered
        # alongside the clean hit.
        if ((seed & 3) != 0) {
            var off = (seed >> 9) % w;
            store8(buf + off, (seed >> 17) & 0xFF);
        }

        _git_packed_ref_scan(buf, w, rn, &out);

        # Truncation mid-OID and mid-name: a line that runs off the buffer end
        # without its newline is the shape that would over-read.
        _git_packed_ref_scan(buf, (seed >> 6) % (w + 1), rn, &out);
        _git_packed_ref_scan(buf, 0, rn, &out);

        # Empty refname is a degenerate accept-path edge (rn_len == 0).
        store8(rn + 0, 0);
        _git_packed_ref_scan(buf, w, rn, &out);

        # Fully random buffer still gets a turn for the no-newline shapes.
        var rsize = (seed & 0x1FF) + 1;
        if (rsize > cap) { rsize = cap; }
        fill_pseudo_random(buf, rsize, seed);
        _git_packed_ref_scan(buf, rsize, rn, &out);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    _fz_set_backend(0);
    return 0;
}

# _wildmatch: random patterns against random subjects, plus the adversarial
# star-heavy shapes that motivated 1.3.8's per-match step budget. The budget is
# the only thing standing between a hostile `.sitignore` and exponential
# backtracking, so the point of this target is that these RETURN — the harness
# would hang, not crash, if the budget regressed.
fn fuzz_wildmatch(rounds) {
    var pcap = 128;
    var scap = 256;
    var pat = alloc(pcap);
    var str = alloc(scap);
    var seed = 0x51DE0001;
    var i = 0;
    while (i < rounds) {
        var plen = (seed & 0x1F) + 1;    # 1..32
        var slen = ((seed >> 5) & 0x3F) + 1;  # 1..64

        # Draw from a small alphabet heavy in glob metacharacters, so random
        # draws actually produce globs rather than literals that never branch.
        var k = 0;
        while (k < plen) {
            var c = (seed + k * 7) & 0x07;
            if (c == 0) { store8(pat + k, 42); }        # *
            if (c == 1) { store8(pat + k, 63); }        # ?
            if (c == 2) { store8(pat + k, 91); }        # [
            if (c == 3) { store8(pat + k, 93); }        # ]
            if (c == 4) { store8(pat + k, 47); }        # /
            if (c == 5) { store8(pat + k, 97); }        # a
            if (c == 6) { store8(pat + k, 98); }        # b
            if (c == 7) { store8(pat + k, 92); }        # backslash
            k = k + 1;
        }
        store8(pat + plen, 0);

        var j = 0;
        while (j < slen) {
            var d = (seed + j * 3) & 0x03;
            if (d == 0) { store8(str + j, 97); }        # a
            if (d == 1) { store8(str + j, 98); }        # b
            if (d == 2) { store8(str + j, 47); }        # /
            if (d == 3) { store8(str + j, 46); }        # .
            j = j + 1;
        }
        store8(str + slen, 0);

        _wildmatch(pat, plen, str, slen);
        # Zero lengths on either side must fail closed.
        _wildmatch(pat, 0, str, slen);
        _wildmatch(pat, plen, str, 0);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }

    # Explicit catastrophic-backtracking shape: "a*a*...a*b" (10 star groups)
    # against a run of 96 'a'. The trailing 'b' never matches, so a naive
    # backtracking matcher must try every way of splitting the run across the
    # stars before concluding "no" — exponential in the star count. 1.3.8's
    # per-match step budget is the only thing that bounds it, and this shape is
    # the A/B probe for that: with the budget raised to 2e9 the harness hangs,
    # with the shipped 200k it returns immediately.
    var stars = 10;
    var bp = 0;
    while (bp < stars) {
        store8(pat + bp * 2, 97);          # 'a'
        store8(pat + bp * 2 + 1, 42);      # '*'
        bp = bp + 1;
    }
    var cat_plen = stars * 2 + 1;
    store8(pat + stars * 2, 98);           # trailing 'b', unmatchable
    store8(pat + cat_plen, 0);
    var sp = 0;
    while (sp < 96) {
        store8(str + sp, 97);
        sp = sp + 1;
    }
    store8(str + 96, 0);
    _wildmatch(pat, cat_plen, str, 96);
    return 0;
}

# tree_entry_name_valid + the v1.4.8 UTF-8 decoder underneath it. The decoder
# reads attacker-controlled bytes (tree entry names arrive from any remote, via
# parse_tree or a push that `_serve_rehash_and_insert` accepts without parsing
# the body), so it is fuzzed directly rather than only through parse_tree —
# whose generated names are ASCII and would never reach the multi-byte paths.
fn fuzz_tree_entry_name(rounds) {
    var cap = 256;
    var name = alloc(cap + 1);
    var seed = 0x7F000111;
    var i = 0;
    while (i < rounds) {
        var nlen = (seed & 0x3F) + 1;   # 1..64
        fill_pseudo_random(name, nlen, seed);
        store8(name + nlen, 0);
        tree_entry_name_valid(name);

        # Seed a guarded prefix so the dot-directory comparison is reached with
        # hostile continuation bytes after it, not just on random noise.
        if ((seed & 3) == 0) {
            store8(name + 0, 46);   # '.'
            store8(name + 1, 103);  # 'g'
            store8(name + 2, 105);  # 'i'
            store8(name + 3, 116);  # 't'
            store8(name + nlen, 0);
            tree_entry_name_valid(name);
            # ".git" + one ignorable + NUL: the exact spoof shape, 7 bytes.
            store8(name + 4, 0xE2);
            store8(name + 5, 0x80);
            store8(name + 6, 0x8C);
            store8(name + 7, 0);
            tree_entry_name_valid(name);
        }

        # Splice a real HFS-ignorable sequence in. Random bytes hit E2 80 8C by
        # chance about once in 16M positions, so without this the skip branch
        # the whole check exists for would never execute under fuzz. Combined
        # with the ".git" prefix above this reaches the spoof comparison with
        # attacker-shaped input, which the unit tests only cover by hand.
        if ((seed & 7) == 1) {
            var at = 4;
            if (at + 3 <= nlen) {
                store8(name + at, 0xE2);
                store8(name + at + 1, 0x80);
                var pick = (seed >> 9) & 3;
                if (pick == 0) { store8(name + at + 2, 0x8C); }   # ZWNJ
                if (pick == 1) { store8(name + at + 2, 0x8D); }   # ZWJ
                if (pick == 2) { store8(name + at + 2, 0xAE); }   # RLO
                if (pick == 3) { store8(name + at + 2, 0x8E); }   # LRM
                store8(name + nlen, 0);
                tree_entry_name_valid(name);
            }
        }

        # Truncated multi-byte sequences at the very end of the buffer are the
        # shape that would over-read past the NUL.
        if (nlen >= 2) {
            store8(name + nlen - 2, 0xE2);
            store8(name + nlen - 1, 0x80);
            store8(name + nlen, 0);
            tree_entry_name_valid(name);
            store8(name + nlen - 1, 0xF0);
            store8(name + nlen, 0);
            tree_entry_name_valid(name);
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# parse_tag_body (v1.5.0). Tag objects arrive from any remote and
# `_serve_rehash_and_insert` accepts a pushed object on framing + SHA-256
# without parsing its body, so this reads attacker-controlled bytes.
#
# Seed-and-mutate, for the reason 1.4.7 established the hard way: pure random
# bytes never synthesise "object <64 hex>\n" and would exercise only the reject
# path while reporting a clean pass.
fn fuzz_parse_tag_body(rounds) {
    var cap = 1024;
    var body = alloc(cap);
    var out[40];
    var seed = 0x7A600011;
    var i = 0;
    while (i < rounds) {
        # Build a well-formed tag body, then corrupt one byte on most rounds.
        var w = 0;
        memcpy(body + w, "object ", 7); w = w + 7;
        var h = 0;
        while (h < 64) {
            var nib = (seed + h * 7) & 0x0F;
            if (nib < 10) { store8(body + w, 48 + nib); }
            else { store8(body + w, 97 + nib - 10); }
            w = w + 1;
            h = h + 1;
        }
        store8(body + w, 10); w = w + 1;
        memcpy(body + w, "type commit\n", 12); w = w + 12;
        memcpy(body + w, "tag ", 4); w = w + 4;
        var nlen = ((seed >> 5) & 0x0F) + 1;
        var k = 0;
        while (k < nlen) {
            store8(body + w, 97 + ((seed + k) & 0x0F));
            w = w + 1;
            k = k + 1;
        }
        store8(body + w, 10); w = w + 1;
        memcpy(body + w, "tagger n <e> 1700000000 +0000\n", 30); w = w + 30;
        store8(body + w, 10); w = w + 1;
        memcpy(body + w, "msg", 3); w = w + 3;
        store8(body + w, 10); w = w + 1;

        if ((seed & 3) != 0) {
            var off = (seed >> 11) % w;
            store8(body + off, (seed >> 19) & 0xFF);
        }
        parse_tag_body(body, w, &out);

        # Truncation at every prefix length: a header that promises more bytes
        # than the body holds is the shape that would over-read.
        parse_tag_body(body, (seed >> 7) % (w + 1), &out);
        parse_tag_body(body, 0, &out);

        # Fully random body covers the shapes the builder cannot produce.
        var rsize = (seed & 0x1FF) + 1;
        fill_pseudo_random(body, rsize, seed);
        parse_tag_body(body, rsize, &out);

        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# 1.7.2 (E10): text_sanitized on arbitrary bytes. The output is never longer
# than the input, a second classification pass finds no unsafe run in it, and
# sanitizing it again changes nothing. Odd rounds draw from an alphabet of
# UTF-8 fragments (C1, bidi, overlong, surrogate, continuation bytes), which
# uniform random bytes rarely assemble into well-formed sequences.
fn fuzz_text_sanitized(rounds) {
    var cap = 256;
    var input = alloc(cap);
    var alpha = alloc(24);
    var a_hex = "41c29be280aec3a9f09f98801b097fd89ceda080c0af9b";
    var an = strlen(a_hex) / 2;
    memcpy(alpha, hex_decode(a_hex, strlen(a_hex)), an);
    var seed = 7;
    var i = 0;
    while (i < rounds) {
        var size = (seed & 0xFF) + 1;                 # 1..256
        fill_pseudo_random(input, size, seed);
        if ((i & 1) == 1) {
            var j = 0;
            while (j < size) {
                store8(input + j, load8(alpha + ((load8(input + j) & 0xFF) % an)));
                j = j + 1;
            }
        }
        var n1[8];
        var o1 = text_sanitized(input, size, &n1);
        var l1 = load64(&n1);
        if (l1 > size) { println("fuzz: text_sanitized grew its input"); return 1; }
        var p = 0;
        while (p < l1) {
            var r = _text_run(o1 + p, l1 - p);
            if (r > 0) { println("fuzz: text_sanitized left an unsafe run"); return 1; }
            p = p + (0 - r);
        }
        var n2[8];
        var o2 = text_sanitized(o1, l1, &n2);
        if (load64(&n2) != l1) { println("fuzz: text_sanitized is not idempotent (length)"); return 1; }
        if (memeq(o1, o2, l1) == 0) { println("fuzz: text_sanitized is not idempotent"); return 1; }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# 1.7.4 (C1): `sit serve` parses Content-Length itself, over the request arena,
# because sandhi_server_content_length allocates on the global heap. The two must
# agree on every request: a disagreement is a framing difference between the
# server's recv loop and its handlers, which is how request smuggling starts.
# Values draw from digits (most), spaces, tabs, commas, signs, letters and CR, up
# to 26 bytes (past the 0x7FFFFFFF bound and the i64 wrap), under three
# spellings of the header name, sometimes twice.
fn fuzz_serve_content_length(rounds) {
    var req = alloc(512);
    var rnd = alloc(64);
    var alpha = "01234567890123456789012345678901234567890123456789  \t\t,+-xA\r";
    var an = strlen(alpha);
    var names = vec_new();
    vec_push(names, "Content-Length:");
    vec_push(names, "content-length:");
    vec_push(names, "CONTENT-LENGTH: ");
    var a = _serve_req_alloc();
    var seed = 0x51715174;
    var i = 0;
    while (i < rounds) {
        reset_via(a);
        fill_pseudo_random(rnd, 64, seed);
        var n = 0;
        var head = "POST /sit/v1/want HTTP/1.1\r\nHost: x\r\n";
        memcpy(req, head, strlen(head));
        n = strlen(head);
        var copies = 1;
        if (((load8(rnd) & 0xFF) % 8) == 0) { copies = 2; }
        var c = 0;
        while (c < copies) {
            var nm = vec_get(names, (load8(rnd + 1 + c) & 0xFF) % 3);
            memcpy(req + n, nm, strlen(nm));
            n = n + strlen(nm);
            var vlen = (load8(rnd + 3 + c) & 0xFF) % 27;
            var j = 0;
            while (j < vlen) {
                store8(req + n, load8(alpha + ((load8(rnd + 8 + c * 28 + j) & 0xFF) % an)));
                n = n + 1;
                j = j + 1;
            }
            memcpy(req + n, "\r\n", 2);
            n = n + 2;
            c = c + 1;
        }
        memcpy(req + n, "\r\n", 2);
        n = n + 2;
        store8(req + n, 0);
        var mine = _serve_content_length(a, req, n);
        var theirs = sandhi_server_content_length(req, n);
        if (mine != theirs) {
            println("fuzz: _serve_content_length disagrees with sandhi_server_content_length");
            return 1;
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# 1.7.4 (D6): the iterative delta resolver. Each round builds a real pack — a
# blob, then a chain of 0..90 OFS_DELTAs (past 1.7.3's 64), each copying its base
# — and reads the chain's tip. Unmutated, it must reconstruct the blob exactly.
# Three rounds in four then flip a few bytes past the header, which reaches the
# header, varint, back-reference, inflate and delta-instruction failures, and,
# where a type bit flips to REF_DELTA, a lookup by a random id. The repo root is
# pointed at a directory that does not exist, so that lookup finds nothing. A
# read that succeeds anyway is held to the 16 MiB ceiling.

# Write git's biased big-endian OFS_DELTA back-offset; returns its length.
fn _fz_ofs_put(buf, n) {
    var tmp[16];
    store8(&tmp, n & 0x7F);
    var k = 1;
    n = n / 128;
    while (n > 0) {
        n = n - 1;
        store8(&tmp + k, 0x80 | (n & 0x7F));
        k = k + 1;
        n = n / 128;
    }
    var i = 0;
    while (i < k) { store8(buf + i, load8(&tmp + k - 1 - i)); i = i + 1; }
    return k;
}

# git_pack.cyr — _git_pack_obj over mutated OFS_DELTA chains: no crash, right bytes when it succeeds.
fn fuzz_pack_obj(rounds) {
    var cap = 8192;
    var pack = alloc(cap);
    var zbase = alloc(64);
    var zbl = zlib_compress("abcdefgh", 8, zbase, 64);
    var delta = alloc(8);
    store8(delta, 8);                              # base size 8
    store8(delta + 1, 8);                          # result size 8
    store8(delta + 2, 0x90);                       # COPY, one size byte, offset 0
    store8(delta + 3, 8);                          # 8 bytes
    var zdelta = alloc(64);
    var zdl = zlib_compress(delta, 4, zdelta, 64);
    if (zbl <= 0) { println("fuzz: pack_obj could not build its base"); return 1; }
    if (zdl <= 0) { println("fuzz: pack_obj could not build its delta"); return 1; }
    sit_set_repo_root("/nonexistent/sit-fuzz-pack");
    _fz_set_backend(1);                            # git, SHA-1 ids
    var seed = 0xD6D6D6;
    var i = 0;
    while (i < rounds) {
        memcpy(pack, "PACK", 4);
        store64(pack + 4, 0);
        var pos = 12;
        store8(pack + pos, 0x38);                  # blob, size 8
        pos = pos + 1;
        memcpy(pack + pos, zbase, zbl);
        pos = pos + zbl;
        var prev = 12;
        var depth = (seed & 0xFFFF) % 91;
        var d = 0;
        while (d < depth) {
            var here = pos;
            store8(pack + pos, 0x64);              # OFS_DELTA, size 4
            pos = pos + 1;
            pos = pos + _fz_ofs_put(pack + pos, here - prev);
            memcpy(pack + pos, zdelta, zdl);
            pos = pos + zdl;
            prev = here;
            d = d + 1;
        }
        var mutated = 0;
        if ((i & 3) != 0) {
            var flips = 1 + ((seed >> 16) & 3);
            var f = 0;
            while (f < flips) {
                var at = 12 + ((seed >> (f * 7)) & 0x7FFFFFFF) % (pos - 12);
                store8(pack + at, load8(pack + at) ^ (1 + ((seed >> (f * 5 + 3)) & 0x7F)));
                f = f + 1;
            }
            mutated = 1;
        }
        var out[24];
        var r = _git_pack_obj(pack, pos, prev, &out);
        if (mutated == 0) {
            if (r != 0) { println("fuzz: pack_obj failed on a valid chain"); return 1; }
            if (load64(&out + 8) != 8) { println("fuzz: pack_obj rebuilt the wrong length"); return 1; }
            if (memeq(load64(&out), "abcdefgh", 8) == 0) {
                println("fuzz: pack_obj rebuilt the wrong bytes");
                return 1;
            }
        }
        if (r == 0) {
            if (load64(&out + 8) > 16777216) { println("fuzz: pack_obj passed the 16 MiB ceiling"); return 1; }
            fl_free(load64(&out));
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    sit_set_repo_root(0);
    _fz_set_backend(0);
    return 0;
}

# Run every bounded fuzz harness; nonzero on the first crash or invariant break.
# 1.7.6 (R10): obj_frame_total reads at most `avail` bytes and returns -1 or a
# length past the header it parsed; obj_inflate_fl, given a real object of any
# compression ratio (the retry sized from the header is the new path), returns
# exactly the framed bytes — and given garbage, fails without crashing.
fn fuzz_obj_inflate(rounds) {
    var raw = alloc(70000);
    var cbuf = alloc(80000);
    var hdr = alloc(40);
    var seed = 11;
    var i = 0;
    while (i < rounds) {
        fill_pseudo_random(hdr, 40, seed);
        if ((i & 3) == 0) { memcpy(hdr, "blob 1", 6); }
        var ft = obj_frame_total(hdr, 32);
        if (ft != 0 - 1) {
            if (ft < 4) { println("fuzz: obj_frame_total returned a length inside its own header"); return 1; }
        }
        # A real object: half compressible runs (ratio far past 4:1), half random.
        var clen_c = (seed & 0xFFFF) % 60000;
        memcpy(raw, "blob ", 5);
        var dg = write_decimal(raw + 5, clen_c);
        store8(raw + 5 + dg, 0);
        var ho = 5 + dg + 1;
        if ((i & 1) == 0) { memset(raw + ho, 65 + (seed & 7), clen_c); }
        else { fill_pseudo_random(raw + ho, clen_c, seed); }
        var cl = zlib_compress(raw, ho + clen_c, cbuf, 80000);
        if (cl > 0) {
            var o[24];
            if (obj_inflate_fl(cbuf, cl, &o) != 0) { println("fuzz: obj_inflate_fl refused a valid object"); return 1; }
            if (load64(&o + 8) != ho + clen_c) { println("fuzz: obj_inflate_fl length differs"); return 1; }
            if (load64(&o + 16) != ho) { println("fuzz: obj_inflate_fl content offset differs"); return 1; }
            if (memeq(load64(&o), raw, ho + clen_c) == 0) { println("fuzz: obj_inflate_fl bytes differ"); return 1; }
            fl_free(load64(&o));
            # Corrupt one byte of the stream: any verdict but a crash.
            if (cl > 8) {
                var at = 2 + (seed & 0x7FFF) % (cl - 2);
                store8(cbuf + at, load8(cbuf + at) ^ 0x55);
                var o2[24];
                if (obj_inflate_fl(cbuf, cl, &o2) == 0) {
                    if (load64(&o2 + 16) > load64(&o2 + 8)) {
                        println("fuzz: obj_inflate_fl offset past its length");
                        return 1;
                    }
                    fl_free(load64(&o2));
                }
            }
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    return 0;
}

# 1.7.6 (N7): the http refs parser over truncated and mutated bodies — the
# quote after a hash ending at the body's end was read one byte past it.
fn fuzz_http_refs(rounds) {
    var good = "{\"refs\":[{\"name\":\"refs/heads/main\",\"hash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}";  #skip-lint (fixture literal)
    var gl = strlen(good);
    var buf = fl_alloc(256);
    var seed = 5;
    var i = 0;
    while (i < rounds) {
        var n = (seed & 0x7FFF) % (gl + 1);
        # The body ends exactly at `n`: the fl block beyond it is poisoned, so an
        # overread that matched a quote there would still be caught by a verdict
        # that cannot hold (a hash with no closing quote accepted).
        memset(buf, 34, 256);
        memcpy(buf, good, n);
        if ((i & 1) == 1) {
            if (n > 0) { store8(buf + (seed & 0xFF) % n, (seed >> 8) & 0xFF); }
        }
        var pairs = vec_new();
        var r = _wire_http_parse_refs(buf, n, pairs);
        if (r == 0) {
            if (vec_len(pairs) > 0) {
                if (n < gl - 3) { println("fuzz: refs parser accepted a body cut inside the hash"); return 1; }
            }
        }
        seed = seed * 1103515245 + 12345;
        i = i + 1;
    }
    fl_free(buf);
    return 0;
}

# Run every fuzz target; exit 1 on the first invariant broken.
fn main() {
    alloc_init();
    println("fuzz: zlib_decompress (10000 rounds)");
    if (fuzz_zlib_decompress(10000) != 0) { return 1; }
    println("fuzz: hash_data (5000 rounds)");
    if (fuzz_hash_data(5000) != 0) { return 1; }
    println("fuzz: hex_decode (10000 rounds)");
    if (fuzz_hex_decode(10000) != 0) { return 1; }
    println("fuzz: url_validators (10000 rounds)");
    if (fuzz_url_validators(10000) != 0) { return 1; }
    println("fuzz: ssh_url_parser (100000 rounds)");
    if (fuzz_ssh_url_parser(100000) != 0) { return 1; }
    println("fuzz: want_frame_decoder (10000000 rounds)");
    if (fuzz_want_frame_decoder(10000000) != 0) { return 1; }
    println("fuzz: reflog_index (200000 rounds)");
    if (fuzz_reflog_index(200000) != 0) { return 1; }
    println("fuzz: pack_varints (500000 rounds)");
    if (fuzz_pack_varints(500000) != 0) { return 1; }
    println("fuzz: apply_delta (200000 rounds)");
    if (fuzz_apply_delta(200000) != 0) { return 1; }
    println("fuzz: parse_tree (200000 rounds)");
    if (fuzz_parse_tree(200000) != 0) { return 1; }
    println("fuzz: parse_commit_body (200000 rounds)");
    if (fuzz_parse_commit_body(200000) != 0) { return 1; }
    println("fuzz: packed_ref_scan (200000 rounds)");
    if (fuzz_packed_ref_scan(200000) != 0) { return 1; }
    println("fuzz: wildmatch (100000 rounds)");
    if (fuzz_wildmatch(100000) != 0) { return 1; }
    println("fuzz: tree_entry_name (200000 rounds)");
    if (fuzz_tree_entry_name(200000) != 0) { return 1; }
    println("fuzz: parse_tag_body (200000 rounds)");
    if (fuzz_parse_tag_body(200000) != 0) { return 1; }
    println("fuzz: text_sanitized (100000 rounds)");
    if (fuzz_text_sanitized(100000) != 0) { return 1; }
    println("fuzz: serve_content_length (200000 rounds)");
    if (fuzz_serve_content_length(200000) != 0) { return 1; }
    println("fuzz: pack_obj (50000 rounds)");
    if (fuzz_pack_obj(50000) != 0) { return 1; }
    println("fuzz: obj_inflate (3000 rounds)");
    if (fuzz_obj_inflate(3000) != 0) { return 1; }
    println("fuzz: http_refs (200000 rounds)");
    if (fuzz_http_refs(200000) != 0) { return 1; }
    println("fuzz: reflog_time (300000 rounds)");
    if (fuzz_reflog_time(300000) != 0) { return 1; }
    println("fuzz: no crashes");
    return 0;
}

var r = main();
syscall(60, r);
