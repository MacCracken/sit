    test_patra_col_bytes_small();
    test_patra_col_bytes_overflow();
    test_ed25519_sign_verify_roundtrip();
    test_validate_refname();
    test_validate_tree_entry_name();
    test_validate_tree_flat_path();
    test_validate_hex_prefix();
    test_validate_config_value();
    test_validate_remote_url();
    test_validate_url_scheme();
    test_parse_commit_multiparent();
    test_tofu_pin_lookup();
    test_sitignore_wildmatch();
    test_sitignore_negation_anchor();
    test_myers_diff_differential();
    test_reflog_format_and_index();
    test_reflog_spec_parse();
    test_fsck_commit_author_ts();
    test_sort_entries_differential();
    test_hfs_dotdir_spoofing();
    test_nested_ignore_scope();
    test_parse_tag_body();
    test_ignore_dir_only();
    test_delta_roundtrip();
    test_wire_io_send_short_write();
    test_wire_ssh_recv_deadline();
    test_split_lines_final_newline();
    test_text_sanitized();
    test_parse_tree_order();
    test_audit_164_pure();
    test_170_pure();
    test_serve_request_arena();
    test_apply_delta_into();
    test_parse_commit_body_a();
    test_176_pure();
    test_180_reflog_time();
    test_1100_packs();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
