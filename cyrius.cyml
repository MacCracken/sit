[package]
name = "sit"
version = "${file:VERSION}"
description = "Sovereign version control — a Cyrius-native git replacement"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/sit"
language = "cyrius"
cyrius = "6.7.15"

[build]
entry = "src/main.cyr"
test = "tests/sit.tcyr"
output = "sit"

[lib]
modules = [
    "src/version.cyr",
    "src/util.cyr",
    "src/validate.cyr",
    "src/config.cyr",
    "src/reflog.cyr",
    "src/git_read.cyr",
    "src/git_pack.cyr",
    "src/delta.cyr",
    "src/object_db.cyr",
    "src/index.cyr",
    "src/refs.cyr",
    "src/tree.cyr",
    "src/tag.cyr",
    "src/diff.cyr",
    "src/commit.cyr",
    "src/merge.cyr",
    "src/history.cyr",
    "src/blame.cyr",
    "src/rebase.cyr",
    "src/sign.cyr",
    "src/wire.cyr",
    "src/wire_http.cyr",
    "src/serve.cyr",
    "src/gc.cyr",
    "src/api.cyr",
]

[lib.read]
modules = [
    "src/util.cyr",
    "src/validate.cyr",
    "src/config.cyr",
    "src/reflog.cyr",
    "src/git_read.cyr",
    "src/git_pack.cyr",
    "src/object_db.cyr",
    "src/index.cyr",
    "src/refs.cyr",
    "src/tree.cyr",
    "src/tag.cyr",
    "src/diff.cyr",
    "src/commit.cyr",
    "src/merge.cyr",
    "src/api.cyr",
]

[deps]
stdlib = [
    "slice",
    "string",
    "fmt",
    "alloc",
    "io",
    "vec",
    "str",
    "syscalls",
    "assert",
    "fs",
    "args",
    "chrono",
    "hashmap",
    "process",
    "tagged",
    "fnptr",
    "thread",
    "thread_local",
    "sync",
    "freelist",
    "bayan",
    "ct",
    "keccak",
    "random",
    "bench",
    "net",
    "mmap",
    "dynlib",
    "fdlopen",
    "tls",
    "tls_native",
    "ws",
    "http",
    "sandhi",
    "sakshi",
    "sankoch",
    "sigil",
    "patra",
]

[deps.cmdit]
git = "https://github.com/MacCracken/cmdit.git"
tag = "1.4.0"
modules = ["dist/cmdit.cyr"]
