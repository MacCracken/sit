# refs.cyr — HEAD / branch / tag / resolution.
#
# Refs live at .sit/HEAD (symbolic), .sit/refs/heads/<name>, .sit/refs/tags/<name>,
# and .sit/refs/remotes/<remote>/<name>. ensure_parent_dirs (util.cyr) is called
# by every write path so nested names like feature/foo work.

# Resolve a reflog selector to an oid: "<base>@{N}" — the new-oid recorded N
# moves ago — or, since 1.8.0, "<base>@{<time>}" — the value the ref had then
# (`HEAD@{yesterday}`, `main@{2 days ago}`, `main@{2026-10-01}`; UTC). Writes
# 64-hex + nul into out_buf. Returns 1 on success, 0 if `name` isn't a reflog
# selector or the base has no log / the entry is out of range. The base's log
# is found by class: HEAD → logs/HEAD; otherwise logs/refs/heads/<base>, then
# logs/refs/remotes/<base> (tags aren't logged). Called from resolve_ref_name
# in REVISION context — distinct from refname_valid, which rejects '@{' in
# ref-NAME context (so x@{0} never becomes a ref file).
fn resolve_reflog_spec(name, out_buf) {
    var spec[24];
    var blen = 0;
    var num = 0;
    var when = 0 - 1;
    if (_reflog_spec_parse(name, &spec) == 1) {
        blen = load64(&spec + 8);
        num = load64(&spec + 16);
    }
    else {
        var ds[16];
        if (_reflog_date_spec_parse(name, clock_epoch_secs(), &ds) == 0) { return 0; }
        blen = load64(&ds);
        when = load64(&ds + 8);
    }
    var base = alloc(blen + 1);
    memcpy(base, name, blen);
    store8(base + blen, 0);
    var refpath = _reflog_spec_refpath(base);
    if (refpath == 0) { return 0; }
    if (when >= 0) { return reflog_read_at_time(refpath, when, out_buf); }
    return reflog_read_nth(refpath, num, out_buf);
}

# The log refpath a selector's base names — "HEAD", or the branch or
# remote-tracking ref that has a log — or 0.
fn _reflog_spec_refpath(base) {
    if (streq(base, "HEAD") == 1) { return "HEAD"; }

    # S-02: the base becomes a .sit/logs/ path component below; reject
    # traversal ('..', leading '/') and control chars before it does. An
    # invalid base simply isn't a resolvable selector → fall through (0).
    if (refname_valid(base) == 0) { return 0; }
    var blen = strlen(base);

    var hp = alloc(11 + blen + 1);
    memcpy(hp, "refs/heads/", 11);
    memcpy(hp + 11, base, blen);
    store8(hp + 11 + blen, 0);
    if (sf_exists(reflog_log_path(hp)) == 1) { return hp; }

    var rp = alloc(13 + blen + 1);
    memcpy(rp, "refs/remotes/", 13);
    memcpy(rp + 13, base, blen);
    store8(rp + 13 + blen, 0);
    if (sf_exists(reflog_log_path(rp)) == 1) { return rp; }
    return 0;
}

# Resolve a ref name (HEAD, <ref>@{N}, or a name under refs/) to 64-hex in `out_buf`; 1 on success.
fn resolve_ref_name(name, out_buf) {
    # Storage seam (roadmap 1.2.0): a .git/ repo resolves refs from .git/HEAD,
    # .git/refs/, and .git/packed-refs. @{N} reflog specs are .sit-only for now (roadmap: `.git/` CLI parity).
    if (_repo_backend == 1) { return _git_resolve_ref_name(name, out_buf); }

    # Reflog selector <ref>@{N} takes precedence over plain-name lookup.
    if (resolve_reflog_spec(name, out_buf) == 1) { return 1; }
    if (streq(name, "HEAD") == 1) {
        var h = read_head_ref();
        if (h == 0) { return 0; }
        memcpy(out_buf, h, 64);
        store8(out_buf + 64, 0);
        return 1;
    }

    var name_len = strlen(name);

    var tag_path = alloc(15 + name_len + 1);
    memcpy(tag_path, ".sit/refs/tags/", 15);
    memcpy(tag_path + 15, name, name_len);
    store8(tag_path + 15 + name_len, 0);
    # S-11: all three ref-file readers below validate that the first 64 bytes
    # are actual hex before accepting. A garbage or attacker-crafted ref is
    # treated as "no such ref" rather than flowed through as a "hash".
    if (sf_exists(tag_path) == 1) {
        var tfd = sf_open(tag_path, 0, 0);
        if (tfd >= 0) {
            var tbuf = alloc(80);
            var tn = file_read(tfd, tbuf, 80);
            file_close(tfd);
            if (tn >= 64) {
                if (hex_prefix_valid(tbuf, 64) == 1) {
                    memcpy(out_buf, tbuf, 64);
                    store8(out_buf + 64, 0);
                    return 1;
                }
            }
        }
    }

    var head_path = alloc(16 + name_len + 1);
    memcpy(head_path, ".sit/refs/heads/", 16);
    memcpy(head_path + 16, name, name_len);
    store8(head_path + 16 + name_len, 0);
    if (sf_exists(head_path) == 1) {
        var hfd = sf_open(head_path, 0, 0);
        if (hfd >= 0) {
            var hbuf = alloc(80);
            var hn = file_read(hfd, hbuf, 80);
            file_close(hfd);
            if (hn >= 64) {
                if (hex_prefix_valid(hbuf, 64) == 1) {
                    memcpy(out_buf, hbuf, 64);
                    store8(out_buf + 64, 0);
                    return 1;
                }
            }
        }
    }

    # Remote-tracking ref (e.g. "origin/main" → .sit/refs/remotes/origin/main)
    var rem_path = alloc(18 + name_len + 1);
    memcpy(rem_path, ".sit/refs/remotes/", 18);
    memcpy(rem_path + 18, name, name_len);
    store8(rem_path + 18 + name_len, 0);
    if (sf_exists(rem_path) == 1) {
        var rfd = sf_open(rem_path, 0, 0);
        if (rfd >= 0) {
            var rbuf = alloc(80);
            var rn = file_read(rfd, rbuf, 80);
            file_close(rfd);
            if (rn >= 64) {
                if (hex_prefix_valid(rbuf, 64) == 1) {
                    memcpy(out_buf, rbuf, 64);
                    store8(out_buf + 64, 0);
                    return 1;
                }
            }
        }
    }

    return 0;
}

# Resolve a reference: either a symbolic name (HEAD, tag, branch) or a hex hash
# (full 64 chars or a prefix of 4+). Writes null-terminated hash into out_buf
# (65 bytes) and returns:
#    1  exact match
#    0  no match
#   -1  ambiguous
#   -2  prefix too short
fn read_head_ref_path() {
    return read_head_ref_path_a(0);
}

# How much of HEAD read_head_ref_path_a reads. Past "ref: " and a name of
# VAL_REFNAME_MAX bytes nothing can validate, so a longer HEAD is refused here
# exactly as reading it all would refuse it.
var HEAD_READ_MAX = 1024;

# read_head_ref_path with the returned name drawn from `a` (0 = the global
# heap). 1.7.5: HEAD is read into a stack buffer, not through read_file_heap,
# which kept the file and its joined path on the heap per call — once per ref
# push in `sit serve`, which passes its request arena here.
fn read_head_ref_path_a(a) {
    # Backend-aware HEAD path: ".sit/HEAD" or ".git/HEAD" (both 9 bytes; the
    # "ref: <path>" symref format is identical across backends).
    var hp[12];
    memcpy(&hp, _repo_dir(), 5);
    memcpy(&hp + 5, "HEAD", 4);
    store8(&hp + 9, 0);
    var abuf[4352];
    var ap = sit_abs_into(&hp, &abuf, 4352);
    if (ap == 0) { return 0; }
    if (_sf_special(ap) == 1) { return 0; }          # 1.7.6 (R11): not a FIFO
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0; }
    var hbuf[1032];                                # HEAD_READ_MAX bytes are read at most
    var buf = &hbuf;
    var len = 0;
    var reading = 1;
    while (reading == 1) {
        if (len >= HEAD_READ_MAX) { reading = 0; }
        else {
            var got = file_read(fd, buf + len, HEAD_READ_MAX - len);
            if (got <= 0) { reading = 0; }
            else { len = len + got; }
        }
    }
    file_close(fd);

    if (len < 5) { return 0; }
    if (memeq(buf, "ref: ", 5) == 0) { return 0; }

    var stop = 5;
    var scanning = 1;
    while (scanning == 1) {
        if (stop >= len) { scanning = 0; }
        else {
            var c = load8(buf + stop);
            if (c == 10) { scanning = 0; }
            else {
                if (c == 13) { scanning = 0; }
                else { stop = stop + 1; }
            }
        }
    }

    var ref_len = stop - 5;
    if (ref_len == 0) { return 0; }
    if (ref_len > VAL_REFNAME_MAX) { return 0; }   # refname_valid's verdict, before the copy

    var ref = 0;
    if (a == 0) { ref = alloc(ref_len + 1); }
    else { ref = alloc_via(a, ref_len + 1); }
    if (ref == 0) { return 0; }
    memcpy(ref, buf + 5, ref_len);
    store8(ref + ref_len, 0);
    # S-25: validate the symref TARGET before anyone builds a path out of it.
    #
    # This is the single choke point feeding read_head_ref (read path),
    # write_head_ref (".sit/" + target) and reflog_head_move (".sit/logs/" +
    # target). It used to return the raw bytes after "ref: " unchecked, so a
    # HEAD file reading `ref: ../../PWNED` made `sit commit` write 64 hex chars
    # + LF to a file OUTSIDE the repository — verified end to end — and
    # `refs/heads/../../../../home/u/.bashrc` additionally passed the
    # memeq("refs/heads/", 11) test in reflog_head_move, appending reflog lines
    # (which carry the user's commit message) onto that path.
    #
    # Reachable from any repo whose .sit/ arrived from outside: tarball, shared
    # checkout, restored backup, CI workspace. git blocks the same shape via
    # check_refname_format() on the referent in parse_loose_ref_contents.
    # refname_valid rejects `..` components, leading/trailing '/', and the
    # control/space/special bytes git forbids.
    if (refname_valid(ref) == 0) { return 0; }
    # 1.6.4 (E2): and it must name something under refs/, as git requires of
    # HEAD. refname_valid accepts single-component names, so `ref:
    # objects.patra` passed, and the next `sit commit` overwrote the whole
    # object database with 65 bytes (likewise config, index.patra, HEAD).
    if (ref_len < 6) { return 0; }
    if (memeq(ref, "refs/", 5) == 0) { return 0; }
    return ref;
}

# Read the ref file pointed at by HEAD. Returns 64-char hex or 0.
fn read_head_ref() {
    # Storage seam (roadmap 1.2.0): git refs may be loose or in packed-refs, and
    # the id width is _id_hexlen(). Dispatch to the git reader before the .sit path.
    if (_repo_backend == 1) { return _git_read_head_ref(); }

    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0; }
    var ref_len = strlen(ref_path);
    var full = alloc(5 + ref_len + 1);
    memcpy(full, ".sit/", 5);
    memcpy(full + 5, ref_path, ref_len);
    store8(full + 5 + ref_len, 0);

    if (sf_exists(full) != 1) { return 0; }
    var fd = sf_open(full, 0, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(80);
    var n = file_read(fd, buf, 80);
    file_close(fd);
    if (n < 64) { return 0; }
    # S-11: validate the first 64 bytes are actual hex before returning —
    # otherwise a corrupt or hostile ref file flows garbage through the
    # whole stack (and into resolve_hash's LIKE after S-01 rejects it).
    if (hex_prefix_valid(buf, 64) == 0) { return 0; }
    store8(buf + 64, 0);
    return buf;
}

# 1 when HEAD's branch ref exists but holds no valid id — empty, short,
# non-hex or unreadable — as opposed to an unborn branch, whose ref file does
# not exist. read_head_ref answers 0 for both. 1.7.6 (L5): commit and pull took
# a broken ref for an unborn branch, so the next commit started a new root over
# the history and `fsck --prune` could then delete it; they refuse instead, as
# git does ("reference broken").
fn head_ref_broken() {
    if (_repo_backend == 1) { return 0; }
    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0; }
    var ref_len = strlen(ref_path);
    var full = alloc(5 + ref_len + 1);
    memcpy(full, ".sit/", 5);
    memcpy(full + 5, ref_path, ref_len);
    store8(full + 5 + ref_len, 0);
    if (path_lstat_kind(sit_abs(full)) < 0) { return 0; }   # absent: unborn
    if (read_head_ref() == 0) { return 1; }
    return 0;
}

# Write the given 64-char hex to the ref file HEAD points at.
fn write_head_ref(hex) {
    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0 - 1; }
    var ref_len = strlen(ref_path);
    var full = alloc(5 + ref_len + 1);
    memcpy(full, ".sit/", 5);
    memcpy(full + 5, ref_path, ref_len);
    store8(full + 5 + ref_len, 0);
    ensure_parent_dirs(full);

    var out = alloc(66);
    memcpy(out, hex, 64);
    store8(out + 64, 10);
    store8(out + 65, 0);
    if (sf_write_atomic(full, out, 65) < 0) { return 0 - 1; }
    return 0;
}

# Record a HEAD movement in the reflog. A branch-tip move that HEAD points
# at is logged TWICE per git semantics — once to .sit/logs/HEAD and once to
# the branch log (.sit/logs/refs/heads/<b>); a detached HEAD logs only to
# .sit/logs/HEAD. Call this AFTER a successful write_head_ref, passing the
# tip read BEFORE the write as old_hex (0 → creation). Best-effort: a failed
# append never propagates, so logging can't undo a committed ref move.
# Lives here (not reflog.cyr) because it reads read_head_ref_path, which is
# defined later than reflog.cyr in the single-pass dist bundle order.
fn reflog_head_move(old_hex, new_hex, msg) {
    # Resolve identity + timestamp ONCE so the HEAD log and the branch log
    # record an identical (ts, name, email) for this one atomic move (git's
    # single-timestamp-per-transaction behaviour).
    var nm = _reflog_user_name();
    var em = _reflog_user_email();
    var ts = clock_epoch_secs();
    _reflog_append_full("HEAD", old_hex, new_hex, msg, nm, em, ts);
    var branch = read_head_ref_path();
    if (branch != 0) {
        if (memeq(branch, "refs/heads/", 11) == 1) {
            _reflog_append_full(branch, old_hex, new_hex, msg, nm, em, ts);
        }
    }
    return 0;
}

# Extract the branch name from HEAD (e.g. "main" from "refs/heads/main").
# Returns heap cstring or 0 if HEAD isn't a branch ref.
fn current_branch_name() {
    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0; }
    var ref_len = strlen(ref_path);
    if (ref_len <= 11) { return ref_path; }
    if (memeq(ref_path, "refs/heads/", 11) == 0) { return ref_path; }
    var name_len = ref_len - 11;
    var name = alloc(name_len + 1);
    memcpy(name, ref_path + 11, name_len);
    store8(name + name_len, 0);
    return name;
}

# Build and write a commit object. Returns hex hash or 0.
fn set_head_ref(ref_path) {
    var rlen = strlen(ref_path);
    var total = 5 + rlen + 1;
    var buf = alloc(total + 1);
    memcpy(buf, "ref: ", 5);
    memcpy(buf + 5, ref_path, rlen);
    store8(buf + 5 + rlen, 10);
    store8(buf + total, 0);
    if (sf_write_atomic(".sit/HEAD", buf, total) < 0) { return 0 - 1; }
    return 0;
}

# Every ref under `dir` (".sit/refs/tags", ".sit/refs/heads"), named by its
# path relative to it ("release/v1"), sorted. 1.7.3 (E14): the tag and branch
# listings, and describe, read one level, so a nested name listed as its
# directory ("release") and describe never saw the ref. fsck's root walk
# (dir_walk) always recursed.
fn ref_names_under(dir) {
    var names = vec_new();
    if (sf_exists(dir) != 1) { return names; }
    _ref_names_walk(dir, "", names, 0);
    sort_cstrings(names);
    return names;
}

# Recursive half of ref_names_under. Only a real directory is descended (a
# symlinked one is a leaf, as in the worktree walk), 64 levels at most.
fn _ref_names_walk(fs_dir, prefix, names, depth) {
    if (depth > 64) { return 0; }
    var raw = sf_dir_list(str_from(fs_dir));
    var dl = strlen(fs_dir);
    var pl = strlen(prefix);
    var i = 0;
    while (i < vec_len(raw)) {
        var s = vec_get(raw, i);
        var sl = str_len(s);
        var child = alloc(dl + 1 + sl + 1);
        memcpy(child, fs_dir, dl);
        store8(child + dl, 47);
        memcpy(child + dl + 1, str_data(s), sl);
        store8(child + dl + 1 + sl, 0);
        var name = alloc(pl + sl + 2);
        memcpy(name, prefix, pl);
        memcpy(name + pl, str_data(s), sl);
        store8(name + pl + sl, 0);
        if (path_lstat_kind(sit_abs(child)) == 0x4000) {
            store8(name + pl + sl, 47);                  # "<prefix><dir>/"
            store8(name + pl + sl + 1, 0);
            _ref_names_walk(child, name, names, depth + 1);
        }
        else { vec_push(names, name); }
        i = i + 1;
    }
    return 0;
}

# Remove the directories a nested ref's deletion left empty between `path` and
# its root (the first `root_len` bytes, e.g. ".sit/refs/heads"), deepest first;
# the root itself always stays. An empty `feature/` would otherwise block a
# later ref named `feature`, as it does in git.
fn _ref_prune_empty_dirs(path, root_len) {
    var len = strlen(path);
    var buf = alloc(len + 1);
    memcpy(buf, path, len);
    store8(buf + len, 0);
    var i = len - 1;
    var go = 1;
    while (go == 1) {
        if (i <= root_len) { go = 0; }
        else {
            if (load8(buf + i) == 47) {
                store8(buf + i, 0);
                if (sf_rmdir(buf) != 0) { go = 0; }
            }
            i = i - 1;
        }
    }
    return 0;
}

# 1.7.6 (L17): a name being CREATED that starts with '-' is an option sit does
# not have — `sit branch -D feature` made a branch named "-D", `sit tag -f v1`
# a tag named "-f". git refuses such names too. Says so and returns 1.
fn ref_name_is_option(name) {
    if (load8(name) != 45) { return 0; }
    eprint3("sit: unknown option '", name, "'\n");
    return 1;
}

# `sit tag [-a|-s] [-d <name> | <name> [-m <msg>] [<commit>]]` — list, create or delete tags.
fn cmd_tag() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    if (argc() < 3) {
        if (sf_exists(".sit/refs/tags") != 1) { return 0; }
        var names = ref_names_under(".sit/refs/tags");
        var m = vec_len(names);
        var i = 0;
        while (i < m) {
            var nm = vec_get(names, i);
            # 1.6.4 (E8): names come from the directory listing, not from
            # refname_valid — a `.sit/refs/tags/$'\e]0;...'` file set the
            # terminal title. Control bytes print as '?'.
            write_sanitized(STDOUT, nm, strlen(nm));
            stdout_write("\n", 1);
            i = i + 1;
        }
        return 0;
    }

    # Deletion: sit tag -d <name>
    if (streq(argv(2), "-d") == 1) {
        if (argc() < 4) {
            eprintln("usage: sit tag -d <name>");
            return 1;
        }
        var dname = argv_heap(3);
        # S-25: the CREATE path below validates the name (S-02) but the DELETE
        # path did not, so `sit tag -d ../../..<path>` built an unlink target
        # outside .sit/refs/tags/. Same grammar, same gate, both directions.
        if (refname_valid(dname) == 0) {
            eprintln("sit: invalid tag name (see git check-ref-format rules)");
            return 1;
        }
        var dnlen = strlen(dname);
        var dpath = alloc(15 + dnlen + 1);
        memcpy(dpath, ".sit/refs/tags/", 15);
        memcpy(dpath + 15, dname, dnlen);
        store8(dpath + 15 + dnlen, 0);
        if (sf_exists(dpath) != 1) {
            syscall(SYS_WRITE, STDERR, "sit: tag '", 10);
            syscall(SYS_WRITE, STDERR, dname, dnlen);
            syscall(SYS_WRITE, STDERR, "' not found\n", 12);
            return 1;
        }
        if (sf_unlink(dpath) != 0) {
            eprintln("sit: failed to remove tag ref");
            return 1;
        }
        _ref_prune_empty_dirs(dpath, 14);                # ".sit/refs/tags"
        stdout_write("deleted tag '", 13);
        write_sanitized(STDOUT, dname, dnlen);   # 1.7.6 (R13)
        stdout_write("'\n", 2);
        return 0;
    }

    # v1.5.0: -a (annotated) / -s (annotated + signed) write a real tag object
    # and point the ref at IT rather than at the commit. Without either flag a
    # tag stays lightweight — a ref file holding a commit oid — which is what
    # every tag before 1.5.0 was, and what git does too.
    var annotated = 0;
    var sign_tag = 0;
    var argi = 2;
    if (streq(argv(2), "-a") == 1) { annotated = 1; argi = 3; }
    else {
        if (streq(argv(2), "-s") == 1) { annotated = 1; sign_tag = 1; argi = 3; }
    }

    var tagmsg = 0;
    if (annotated == 1) {
        if (argc() <= argi) {
            eprintln("usage: sit tag -a|-s <name> [-m <msg>] [<commit>]");
            return 1;
        }
    }

    var name = argv_heap(argi);
    var nlen = strlen(name);
    if (ref_name_is_option(name) == 1) { return 1; }   # 1.7.6 (L17)
    # S-02: tag names follow the same ref-format grammar as branches.
    if (refname_valid(name) == 0) {
        eprintln("sit: invalid tag name (see git check-ref-format rules)");
        return 1;
    }
    var path = alloc(15 + nlen + 1);
    memcpy(path, ".sit/refs/tags/", 15);
    memcpy(path + 15, name, nlen);
    store8(path + 15 + nlen, 0);

    if (sf_exists(path) == 1) {
        syscall(SYS_WRITE, STDERR, "sit: tag '", 10);
        syscall(SYS_WRITE, STDERR, name, nlen);
        syscall(SYS_WRITE, STDERR, "' already exists\n", 17);
        return 1;
    }

    # -m <msg> and an optional <commit>, in either order after the name.
    var targ_i = argi + 1;
    if (annotated == 1) {
        if (argc() > targ_i) {
            if (streq(argv(targ_i), "-m") == 1) {
                if (argc() <= targ_i + 1) {
                    eprintln("sit: -m requires a message");
                    return 1;
                }
                tagmsg = argv_heap(targ_i + 1);
                targ_i = targ_i + 2;
            }
        }
        if (tagmsg == 0) { tagmsg = name; }
    }

    var target_hex = 0;
    if (argc() > targ_i) {
        var prefix = argv_heap(targ_i);
        var hex[72];
        var rr = resolve_hash(prefix, &hex);
        if (rr != 1) {
            eprintln("sit: cannot resolve target commit");
            return 1;
        }
        target_hex = alloc(65);
        memcpy(target_hex, &hex, 64);
        store8(target_hex + 64, 0);
    }
    else {
        target_hex = read_head_ref();
        if (target_hex == 0) {
            eprintln("sit: cannot tag with no commits");
            return 1;
        }
    }

    ensure_dir(".sit/refs/tags");
    ensure_parent_dirs(path);

    # An annotated tag stores an object and the ref points at THAT; the commit
    # is reachable by peeling. fsck's reachability walk peels the same way, so
    # the tagged commit is not reported dangling.
    var ref_hex = target_hex;
    if (annotated == 1) {
        var seed = 0;
        if (sign_tag == 1) {
            seed = load_signing_seed();
            if (seed == 0) {
                eprintln("sit: no signing key (run 'sit key generate')");
                return 1;
            }
        }
        var tag_hex = write_tag_object(target_hex, name, tagmsg, seed);
        if (tag_hex == 0) {
            eprintln("sit: failed to write tag object");
            return 1;
        }
        ref_hex = tag_hex;
    }

    var buf = alloc(66);
    memcpy(buf, ref_hex, 64);
    store8(buf + 64, 10);
    store8(buf + 65, 0);
    if (sf_write_atomic(path, buf, 65) < 0) {
        eprintln("sit: failed to write tag ref");
        return 1;
    }

    stdout_write("created tag '", 13);
    write_sanitized(STDOUT, name, nlen);   # 1.7.6 (R13)
    stdout_write("'\n", 2);
    return 0;
}

# `sit branch [-d <name> | <name>]` — list, create or delete a branch.
fn cmd_branch() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    if (argc() < 3) {
        if (sf_exists(".sit/refs/heads") != 1) { return 0; }
        var names = ref_names_under(".sit/refs/heads");
        var curr = current_branch_name();
        var i = 0;
        var m = vec_len(names);
        while (i < m) {
            var nm = vec_get(names, i);
            var is_current = 0;
            if (curr != 0) {
                if (streq(nm, curr) == 1) { is_current = 1; }
            }
            if (is_current == 1) { stdout_write("* ", 2); }
            else                 { stdout_write("  ", 2); }
            write_sanitized(STDOUT, nm, strlen(nm));   # E8, as for tags
            stdout_write("\n", 1);
            i = i + 1;
        }
        return 0;
    }

    # Deletion: sit branch -d <name>
    if (streq(argv(2), "-d") == 1) {
        if (argc() < 4) {
            eprintln("usage: sit branch -d <name>");
            return 1;
        }
        var dname = argv_heap(3);
        # S-25: same gap as `sit tag -d` — the create path validates, the delete
        # path did not, so the unlink target could escape .sit/refs/heads/.
        # Note this also gates the reflog unlink below (reflog_log_path(dlref)).
        if (refname_valid(dname) == 0) {
            eprintln("sit: invalid branch name (see git check-ref-format rules)");
            return 1;
        }
        var dnlen = strlen(dname);
        var dpath = alloc(16 + dnlen + 1);
        memcpy(dpath, ".sit/refs/heads/", 16);
        memcpy(dpath + 16, dname, dnlen);
        store8(dpath + 16 + dnlen, 0);
        if (sf_exists(dpath) != 1) {
            syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
            syscall(SYS_WRITE, STDERR, dname, dnlen);
            syscall(SYS_WRITE, STDERR, "' not found\n", 12);
            return 1;
        }
        var curr_br = current_branch_name();
        if (curr_br != 0) {
            if (streq(curr_br, dname) == 1) {
                eprintln("sit: cannot delete the currently checked-out branch");
                return 1;
            }
        }
        if (sf_unlink(dpath) != 0) {
            eprintln("sit: failed to remove branch ref");
            return 1;
        }
        # Mirror git: deleting a branch deletes its reflog too. Leaving the
        # log orphaned would pin the branch's objects against fsck --prune
        # forever (it walks every .sit/logs/** file) and corrupt <name>@{N}
        # if the branch were later recreated (append to a stale log). Best-
        # effort unlink — a missing log (branch never logged) is fine.
        var dlref = alloc(11 + dnlen + 1);
        memcpy(dlref, "refs/heads/", 11);
        memcpy(dlref + 11, dname, dnlen);
        store8(dlref + 11 + dnlen, 0);
        var dlog = reflog_log_path(dlref);
        sf_unlink(dlog);
        _ref_prune_empty_dirs(dpath, 15);                # ".sit/refs/heads"
        _ref_prune_empty_dirs(dlog, strlen(dlog) - dnlen - 1);   # ".../logs/refs/heads"
        stdout_write("deleted branch '", 16);
        write_sanitized(STDOUT, dname, dnlen);   # 1.7.6 (R13)
        stdout_write("'\n", 2);
        return 0;
    }

    var name = argv_heap(2);
    var nlen = strlen(name);
    if (ref_name_is_option(name) == 1) { return 1; }   # 1.7.6 (L17)
    # S-02: reject names that don't satisfy git check-ref-format rules.
    if (refname_valid(name) == 0) {
        eprintln("sit: invalid branch name (see git check-ref-format rules)");
        return 1;
    }
    var path = alloc(16 + nlen + 1);
    memcpy(path, ".sit/refs/heads/", 16);
    memcpy(path + 16, name, nlen);
    store8(path + 16 + nlen, 0);

    if (sf_exists(path) == 1) {
        syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
        syscall(SYS_WRITE, STDERR, name, nlen);
        syscall(SYS_WRITE, STDERR, "' already exists\n", 17);
        return 1;
    }

    var head_hex = read_head_ref();
    if (head_hex == 0) {
        eprintln("sit: cannot create a branch with no commits");
        return 1;
    }

    ensure_parent_dirs(path);
    var buf = alloc(66);
    memcpy(buf, head_hex, 64);
    store8(buf + 64, 10);
    store8(buf + 65, 0);
    if (sf_write_atomic(path, buf, 65) < 0) {
        eprintln("sit: failed to write branch ref");
        return 1;
    }

    # Reflog the new branch's creation (old=zeros). HEAD doesn't move, so
    # only the new branch's log gets an entry — not logs/HEAD.
    var br_ref = alloc(11 + nlen + 1);
    memcpy(br_ref, "refs/heads/", 11);
    memcpy(br_ref + 11, name, nlen);
    store8(br_ref + 11 + nlen, 0);
    reflog_append(br_ref, 0, head_hex, "branch: Created from HEAD");

    stdout_write("created branch '", 16);
    write_sanitized(STDOUT, name, nlen);   # 1.7.6 (R13)
    stdout_write("'\n", 2);
    return 0;
}

# True if there are any staged or unstaged changes vs HEAD. Untracked files
# are not considered dirty (they don't block checkout unless they collide).
fn cmd_checkout() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit checkout [-b] <branch>");
        return 1;
    }

    var create = 0;
    var arg_idx = 2;
    if (streq(argv(2), "-b") == 1) {
        create = 1;
        arg_idx = 3;
        if (argc() < 4) {
            eprintln("usage: sit checkout -b <branch>");
            return 1;
        }
    }
    var target = argv_heap(arg_idx);
    var tlen = strlen(target);
    if (create == 1) { if (ref_name_is_option(target) == 1) { return 1; } }   # 1.7.6 (L17)

    # S-02 for every checkout, not only -b (1.6.4, E7): `sit checkout
    # ../tags/lt` was accepted and wrote `ref: refs/heads/../tags/lt` into HEAD,
    # which every reader then rejected — HEAD bricked until hand-edited.
    if (refname_valid(target) == 0) {
        eprintln("sit: invalid branch name (see git check-ref-format rules)");
        return 1;
    }
    # 1.7.6 (L2): an operation in progress belongs to this branch. Switching away
    # carried its MERGE_HEAD (or CHERRY_PICK_HEAD / REVERT_HEAD) along, and the
    # next commit there recorded it. `checkout -b` stays allowed: committing an
    # in-progress merge onto a new branch is what that is for.
    if (create == 0) {
        var in_prog = 0;
        if (sf_exists(".sit/MERGE_HEAD") == 1) { in_prog = 1; }
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) { in_prog = 1; }
        if (sf_exists(".sit/REVERT_HEAD") == 1) { in_prog = 1; }
        if (in_prog == 1) {
            eprintln("sit: a merge, cherry-pick or revert is in progress — commit it first,");
            eprintln("sit:   or drop it with 'sit merge --abort' / 'sit reset --hard'");
            return 1;
        }
    }

    if (create == 1) {
        var new_branch = alloc(16 + tlen + 1);
        memcpy(new_branch, ".sit/refs/heads/", 16);
        memcpy(new_branch + 16, target, tlen);
        store8(new_branch + 16 + tlen, 0);
        if (sf_exists(new_branch) == 1) {
            syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
            syscall(SYS_WRITE, STDERR, target, tlen);
            syscall(SYS_WRITE, STDERR, "' already exists\n", 17);
            return 1;
        }
        var head_hex = read_head_ref();
        if (head_hex == 0) {
            eprintln("sit: cannot create a branch with no commits");
            return 1;
        }
        ensure_parent_dirs(new_branch);
        var buf = alloc(66);
        memcpy(buf, head_hex, 64);
        store8(buf + 64, 10);
        store8(buf + 65, 0);
        if (sf_write_atomic(new_branch, buf, 65) < 0) {
            eprintln("sit: failed to write branch ref");
            return 1;
        }
        # Reflog the -b branch creation (old=zeros) to the new branch's log.
        var nb_ref = alloc(11 + tlen + 1);
        memcpy(nb_ref, "refs/heads/", 11);
        memcpy(nb_ref + 11, target, tlen);
        store8(nb_ref + 11 + tlen, 0);
        reflog_append(nb_ref, 0, head_hex, "branch: Created from HEAD");
    }

    var target_ref_len = 11 + tlen;
    var target_ref = alloc(target_ref_len + 1);
    memcpy(target_ref, "refs/heads/", 11);
    memcpy(target_ref + 11, target, tlen);
    store8(target_ref + target_ref_len, 0);

    var target_path = alloc(5 + target_ref_len + 1);
    memcpy(target_path, ".sit/", 5);
    memcpy(target_path + 5, target_ref, target_ref_len);
    store8(target_path + 5 + target_ref_len, 0);

    if (sf_exists(target_path) != 1) {
        syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
        syscall(SYS_WRITE, STDERR, target, tlen);
        syscall(SYS_WRITE, STDERR, "' not found\n", 12);
        return 1;
    }

    var curr = current_branch_name();
    if (curr != 0) {
        if (streq(curr, target) == 1) {
            stdout_write("already on '", 12);
            write_sanitized(STDOUT, target, tlen);   # 1.7.6 (R13)
            stdout_write("'\n", 2);
            return 0;
        }
    }

    if (is_dirty() == 1) {
        eprintln("sit: working tree has uncommitted changes");
        eprintln("sit:   commit or revert before switching branches");
        return 1;
    }

    var target_fd = sf_open(target_path, 0, 0);
    if (target_fd < 0) {
        eprintln("sit: cannot read target branch ref");
        return 1;
    }
    var target_hex = alloc(80);
    var n = file_read(target_fd, target_hex, 80);
    file_close(target_fd);
    if (n < 64) {
        eprintln("sit: target ref is invalid");
        return 1;
    }
    # S-25: apply the S-11 hex gate here too. `cmd_checkout` read the ref file
    # and NUL-terminated at 64 without validating the bytes, so a corrupt or
    # hand-written ref sent raw content into commit_tree_entries -> read_object,
    # where it is interpolated into a patra SQL string literal and recorded in
    # the reflog. Every other ref consumer already gates on hex_prefix_valid.
    if (hex_prefix_valid(target_hex, 64) == 0) {
        eprintln("sit: target ref is invalid");
        return 1;
    }
    store8(target_hex + 64, 0);

    # Untracked files in the way, symlinked parents, and a failed write all
    # refuse inside materialize_target_safe (is_dirty already ran above). Its
    # failure must stop the switch: through 1.6.3 the return was ignored, so
    # HEAD moved onto a tree the worktree and index did not hold and the next
    # commit silently reverted the branch.
    if (materialize_target_safe(target_hex, 1) != 0) {
        eprintln("sit: checkout aborted — HEAD unchanged");
        return 1;
    }

    # Capture the old HEAD tip before the symref moves (materialize doesn't
    # touch refs, so this still resolves the branch we're leaving).
    var co_old = read_head_ref();
    if (set_head_ref(target_ref) != 0) {
        eprintln("sit: failed to update HEAD");
        return 1;
    }

    # Reflog the branch switch to logs/HEAD only (no branch-tip moved):
    # "checkout: moving from <old> to <new>".
    var co_oldname = curr;
    if (co_oldname == 0) { co_oldname = "HEAD"; }
    var co_onl = strlen(co_oldname);
    var co_msg = alloc(30 + co_onl + tlen);
    var co_mp = 0;
    memcpy(co_msg + co_mp, "checkout: moving from ", 22); co_mp = co_mp + 22;
    memcpy(co_msg + co_mp, co_oldname, co_onl); co_mp = co_mp + co_onl;
    memcpy(co_msg + co_mp, " to ", 4); co_mp = co_mp + 4;
    memcpy(co_msg + co_mp, target, tlen); co_mp = co_mp + tlen;
    store8(co_msg + co_mp, 0);
    reflog_append("HEAD", co_old, target_hex, co_msg);

    stdout_write("switched to branch '", 20);
    write_sanitized(STDOUT, target, tlen);
    stdout_write("'\n", 2);
    return 0;
}

