# git_read.cyr — read-only .git/ backend (roadmap 1.2.0).
#
# Reads an EXISTING git repository (SHA-1 default / SHA-256, loose objects +
# refs; packfiles land in bite 2) through the same readers sit uses for its
# native .sit/ store. Strictly read-only: .git/ is consumed, never mutated —
# sit stays .sit/-native for its own repos. See ADR 0011.
#
# STORAGE SEAM: sit_repo_open() calls _detect_repo_backend() to set the
# process-global `_repo_backend`; the three storage-touching primitives
# (read_object / read_head_ref / resolve_ref_name) dispatch on it. Every layer
# above them (tree walk, diff, status, log) stays storage-agnostic. The only
# format divergence a caller could see is object-id WIDTH — handled centrally
# by _id_hexlen() / _id_rawlen() so the 64-hex / 32-raw literals scattered
# across the read path collapse to two helpers.
#
# One-repo-per-process contract (api.cyr:26-30): the backend is a global, not a
# per-handle field, matching the existing "sit_repo_open chdirs the process"
# model. A future multi-handle API would move these onto a repo struct.

# --- Backend state -----------------------------------------------------------
# _repo_backend: 0 = SIT (.sit/, patra, SHA-256), 1 = GIT (.git/, loose+pack).
# Default 0 so every pre-1.2.0 code path is byte-identical until a .git/ repo
# is opened.
var _repo_backend = 0;
# _git_hash_algo (GIT mode only): 0 = SHA-1 (git default), 1 = SHA-256.
var _git_hash_algo = 0;

# --- Active-backend object-id widths ----------------------------------------
# SIT is always SHA-256 (32 raw / 64 hex). GIT is SHA-1 (20/40) unless the repo
# declares extensions.objectFormat = sha256 (32/64). These two helpers replace
# every hardcoded 64 / 32 in the read path.
fn _id_hexlen() {
    if (_repo_backend == 1) {
        if (_git_hash_algo == 1) { return 64; }
        return 40;
    }
    return 64;
}
fn _id_rawlen() {
    if (_repo_backend == 1) {
        if (_git_hash_algo == 1) { return 32; }
        return 20;
    }
    return 32;
}

# --- .git/config hash-algo detection ----------------------------------------
# SHA-256 git repos carry `[extensions]\n\tobjectFormat = sha256` (and
# repositoryFormatVersion = 1). Best-effort: an unreadable config falls back to
# SHA-1 (git's default), which is correct for the overwhelming majority.
#
# S-25: this used to be a whole-file substring scan for "sha256", justified by
# the claim that "the token appears nowhere else in a normal config". That claim
# is false, and the failure is silent and consumer-visible. ANY occurrence flips
# a SHA-1 repo into 64-hex mode, after which every width gate below rejects and
# `read_head_ref` returns 0 — but `sit_repo_open` still returns 1 and
# `sit_repo_branch` still returns the right name, so `sit_repo_status` reports a
# clean tree as ALL FILES UNTRACKED. owl / thoth get a confident wrong answer
# rather than an error.
#
# The token reaches .git/config through paths an attacker controls, not just
# user typos: a submodule NAME chosen by the attacker's .gitmodules is copied
# verbatim into the superproject's .git/config by `git submodule update --init`,
# and a repository whose own name contains "sha256" lands in the cloned-in
# remote URL. Both are ordinary content in a repo cloned from an untrusted
# remote — the exact threat model `.git/` read-mode exists for.
#
# Fixed by anchoring to the actual `objectFormat` KEY rather than scanning
# values. Section headers (`[submodule "sha256-x"]`) and other keys' values
# (`url = .../sha256-utils.git`) no longer match.

# Skip spaces and tabs from `i`, returning the first other index (or n).
fn _git_skip_ws(p, i, n) {
    var j = i;
    var go = 1;
    while (go == 1) {
        if (j >= n) { go = 0; }
        else {
            var c = load8(p + j) & 0xFF;
            if (c == 32) { j = j + 1; }
            else {
                if (c == 9) { j = j + 1; }
                else { go = 0; }
            }
        }
    }
    return j;
}

# ASCII case-insensitive compare of `litlen` bytes at p+i against a lowercase
# literal. git config keys are case-insensitive.
fn _git_ieq(p, i, n, lit, litlen) {
    if (i + litlen > n) { return 0; }
    var k = 0;
    var ok = 1;
    while (k < litlen) {
        var c = load8(p + i + k) & 0xFF;
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (c != (load8(lit + k) & 0xFF)) { ok = 0; }
        k = k + 1;
    }
    return ok;
}

# Is this config line exactly `objectFormat = sha256` (any spacing / case)?
fn _git_line_is_objectformat_sha256(p, n) {
    var i = _git_skip_ws(p, 0, n);
    if (_git_ieq(p, i, n, "objectformat", 12) == 0) { return 0; }
    i = _git_skip_ws(p, i + 12, n);
    if (i >= n) { return 0; }
    if ((load8(p + i) & 0xFF) != 61) { return 0; }        # '='
    i = _git_skip_ws(p, i + 1, n);
    if (_git_ieq(p, i, n, "sha256", 6) == 0) { return 0; }
    # Nothing but trailing whitespace / CR may follow the value.
    var j = _git_skip_ws(p, i + 6, n);
    while (j < n) {
        if ((load8(p + j) & 0xFF) != 13) { return 0; }
        j = j + 1;
    }
    return 1;
}

fn _git_detect_hash_algo() {
    var pair[16];
    # 1.12.2 (G5): a freelist buffer, freed below. Every sit_repo_open (owl and
    # thoth call it per refresh) kept the whole of .git/config on the heap.
    if (read_file_fl(".git/config", &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    var pos = 0;
    var found = 0;
    while (pos < len) {
        var le = pos;
        var scanning = 1;
        while (scanning == 1) {
            if (le >= len) { scanning = 0; }
            else {
                if (load8(buf + le) == 10) { scanning = 0; }
                else { le = le + 1; }
            }
        }
        if (found == 0) {
            if (_git_line_is_objectformat_sha256(buf + pos, le - pos) == 1) { found = 1; }
        }
        pos = le + 1;
    }
    fl_free(buf);
    return found;
}

# --- Loose-object read -------------------------------------------------------
# Reads .git/objects/<xx>/<rest>, zlib-inflates the whole file (git loose
# objects are one RFC-1950 zlib stream of "<type> <len>\0<content>"), and
# writes read_object()'s exact 24-byte out contract:
#   out[0]  = decompressed buffer pointer
#   out[8]  = decompressed length (framing + content)
#   out[16] = content offset (first byte past the framing NUL)
# so every downstream reader (parse_tree, read_blob_content, commit parse) is
# reused unchanged. Decompression is read_object()'s own (obj_inflate_fl,
# 1.7.6), so failure modes line up.
# Returns 0 on success, negative on error.
#
# 1.7.5: the file is read into a freelist buffer freed once it is inflated, and
# its path is built on the stack. read_file_heap kept every compressed object on
# the heap — and the first inflate buffer too when the retry ran — once per
# read, in-process for owl and thoth.
var _GIT_LOOSE_MAX = 67108864;   # read_file_heap's S-06 cap, kept

fn _git_read_loose(hex, out) {
    # 1.12.0 (R2): this repository's objects, then each alternate's.
    var dirs = _git_object_dirs();
    var rc = 0 - 1;
    var i = 0;
    while (i < vec_len(dirs)) {
        if (rc != 0) { rc = _git_read_loose_in(vec_get(dirs, i), hex, out); }
        i = i + 1;
    }
    return rc;
}

# _git_read_loose in the objects directory `objdir` (".git/objects", or an
# alternate's): reads <objdir>/<xx>/<rest>.
fn _git_read_loose_in(objdir, hex, out) {
    var dl = strlen(objdir);
    var hl = _id_hexlen();
    if (dl + hl + 3 > 4096) { return 0 - 1; }
    var path[4096];
    memcpy(&path, objdir, dl);
    store8(&path + dl, 47);
    store8(&path + dl + 1, load8(hex));
    store8(&path + dl + 2, load8(hex + 1));
    store8(&path + dl + 3, 47);
    memcpy(&path + dl + 4, hex + 2, hl - 2);
    store8(&path + dl + 4 + hl - 2, 0);
    var abuf[4352];
    var ap = sit_abs_into(&path, &abuf, 4352);
    if (ap == 0) { return 0 - 1; }
    if (path_is_regular(ap) == 0) { return 0 - 1; }   # 1.7.6 (R11): not a FIFO
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var size = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    syscall(SYS_LSEEK, fd, 0, SEEK_SET);
    if (size < 0) { file_close(fd); return 0 - 1; }
    if (size > _GIT_LOOSE_MAX) { file_close(fd); return 0 - 1; }
    var compressed = fl_alloc(size + 1);
    if (compressed == 0) { file_close(fd); return 0 - 1; }
    var blen = 0;
    var reading = 1;
    while (reading == 1) {
        if (blen >= size) { reading = 0; }
        else {
            var got = file_read(fd, compressed + blen, size - blen);
            if (got <= 0) { reading = 0; }
            else { blen = blen + got; }
        }
    }
    file_close(fd);
    if (blen <= 0) { fl_free(compressed); return 0 - 2; }

    # 1.7.6 (R10): the shared inflate, sized from the object's header.
    var ir = obj_inflate_fl(compressed, blen, out);
    fl_free(compressed);
    if (ir == 0 - 2) { return 0 - 3; }
    if (ir == 0 - 3) { return 0 - 4; }
    if (ir != 0) { return 0 - 5; }
    # The inflated object is the caller's (freelist memory, never freed by
    # read_object's callers, like the pack reader's results since 1.7.4).
    return 0;
}

# --- Alternates (1.12.0, R2) ----------------------------------------------------
# `.git/objects/info/alternates` names further object directories, one per line
# (`#` comments; a relative path is relative to the objects directory holding
# the file). `git clone --shared` and `--reference` make one, and the repository
# then stores nothing those directories hold — so every such object read as
# missing, and every file of the clone as untracked. Followed as git follows
# them: each alternate's own alternates too, at most _GIT_ALT_MAX directories.
# A listed directory that does not exist is said once, on stderr, and skipped.
# Like git, sit then reads objects from wherever the repository points.

var _GIT_ALT_MAX = 6;
var _GIT_ALT_LINES = 64;        # alternates entries looked at per file (G5)
var _git_objdirs = 0;          # this repository's objects directories, listed once

# Forget the listed objects directories (a repository is being opened).
fn _git_objdirs_reset() {
    _git_objdirs = 0;
    return 0;
}

# The objects directories of the open `.git/` repository: ".git/objects" first,
# then its alternates (see above), as heap cstrings.
fn _git_object_dirs() {
    if (_git_objdirs != 0) { return _git_objdirs; }
    var v = vec_new();
    vec_push(v, ".git/objects");
    var i = 0;
    while (i < vec_len(v)) {
        if (vec_len(v) < _GIT_ALT_MAX) { _git_alt_load(vec_get(v, i), v); }
        i = i + 1;
    }
    _git_objdirs = v;
    return v;
}

# Append the alternates `objdir/info/alternates` lists to `v`, skipping ones
# already there, stopping at _GIT_ALT_MAX.
fn _git_alt_load(objdir, v) {
    var dl = strlen(objdir);
    var ap = alloc_or_die(dl + 18);
    memcpy(ap, objdir, dl);
    memcpy(ap + dl, "/info/alternates", 17);
    var pair[16];
    if (read_file_fl(ap, &pair) != 0) { return 0; }       # freed below (1.12.2, G5)
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    var s = 0;
    var examined = 0;
    var i = 0;
    while (i <= len) {
        var eol = 0;
        if (i == len) { eol = 1; }
        else { if (load8(buf + i) == 10) { eol = 1; } }
        if (eol == 1) {
            var e = i;
            if (e > s) { if (load8(buf + e - 1) == 13) { e = e - 1; } }
            var keep = 1;
            if (e <= s) { keep = 0; }
            if (keep == 1) { if (load8(buf + s) == 35) { keep = 0; } }   # '#'
            if (keep == 1) {
                if (vec_len(v) >= _GIT_ALT_MAX) { keep = 0; }
            }
            # 1.12.2 (G5): at most _GIT_ALT_LINES entries are looked at. Ones
            # that name no directory never filled the list, so 300,000 of them
            # cost 13 MB and as many warnings on every open.
            if (keep == 1) {
                if (examined >= _GIT_ALT_LINES) { keep = 0; }
                else { examined = examined + 1; }
            }
            # K5: no path that long is a directory; it is passed over unread.
            if (keep == 1) {
                if (e - s > 4096) { keep = 0; }
            }
            if (keep == 1) {
                var ll = e - s;
                var p = 0;
                # K5: freelist memory, kept only for a directory that is listed.
                if (load8(buf + s) == 47) {
                    p = fl_alloc(ll + 1);
                    if (p == 0) { fl_free(buf); return 0; }
                    memcpy(p, buf + s, ll);
                    store8(p + ll, 0);
                }
                else {
                    p = fl_alloc(dl + 1 + ll + 1);
                    if (p == 0) { fl_free(buf); return 0; }
                    memcpy(p, objdir, dl);
                    store8(p + dl, 47);
                    memcpy(p + dl + 1, buf + s, ll);
                    store8(p + dl + 1 + ll, 0);
                }
                var dup = 0;
                var k = 0;
                while (k < vec_len(v)) {
                    if (streq(vec_get(v, k), p) == 1) { dup = 1; }
                    k = k + 1;
                }
                if (dup == 0) {
                    var st[256];
                    var ok = 0;
                    var pb[4352];
                    var pa = sit_abs_into(p, &pb, 4352);
                    if (pa != 0) {
                        if (xstat(pa, &st) == 0) {
                            if ((load32(&st + STAT_MODE) & 0xF000) == 0x4000) { ok = 1; }
                        }
                    }
                    if (ok == 1) { vec_push(v, p); }
                    else {
                        var miss = " does not exist; its objects read as missing\n";
                        eprint3("sit: warning: alternate object directory ", p, miss);
                        fl_free(p);
                    }
                }
                else { fl_free(p); }
            }
            s = i + 1;
        }
        i = i + 1;
    }
    fl_free(buf);
    return 0;
}

# --- Backend detection -------------------------------------------------------
# Probe order: .sit/ wins over .git/ so a repo that is somehow both stays
# sit-native (sit never writes .git/). Sets the process-globals and returns the
# selected backend id, or -1 if neither store is present.
fn _detect_repo_backend() {
    if (sf_exists(".sit/HEAD") == 1) {
        _repo_backend = 0;
        _git_hash_algo = 0;
        return 0;
    }
    if (sf_exists(".git/HEAD") == 1) {
        _repo_backend = 1;
        _git_hash_algo = _git_detect_hash_algo();
        return 1;
    }
    return 0 - 1;
}

# A heap copy of the object id at `hex`, as many hex digits as the open
# backend's ids have (64, or 40 for a SHA-1 `.git/`). 1.12.0: the read commands
# copied a fixed 64, which on a SHA-1 id read past its 41-byte string.
fn _id_dup(hex) {
    var n = _id_hexlen();
    var c = alloc_or_die(n + 1);
    memcpy(c, hex, n);
    store8(c + n, 0);
    return c;
}

# The repository a read-only command works on (1.12.0, `.git/` CLI parity):
# `.sit/` as ever, else an existing `.git/` repository read through this seam.
# 0 (sit) or 1 (git); -1 when there is neither, which is said. Commands that
# write keep their `.sit/HEAD` gate — sit never writes a `.git/` repository.
fn cli_read_repo() {
    var b = _detect_repo_backend();
    if (b < 0) { eprintln("sit: not a sit repository (run 'sit init')"); }
    return b;
}

# --- Ref backend -------------------------------------------------------------
# The active store's 5-char directory prefix. ".sit/" and ".git/" are both
# exactly 5 bytes and the ref/HEAD subpaths are length-identical, so only the
# middle three bytes ever differ — read_head_ref_path builds the HEAD path from
# this, and the git-side ref readers below hardcode ".git/".
fn _repo_dir() {
    if (_repo_backend == 1) { return ".git/"; }
    return ".sit/";
}

# The active backend's ignore-file name. load_sitignore reads this so the
# working-tree walk honours .gitignore on a git repo (top-level only for v1 —
# nested .gitignore / info/exclude / global excludes are not consulted).
fn _ignore_filename() {
    if (_repo_backend == 1) { return ".gitignore"; }
    return ".sitignore";
}

# Read a loose ref file .git/<refpath> as a bare OID. Returns a heap cstring of
# _id_hexlen() hex chars (NUL-terminated) or 0 if the file is absent / not hex.
# Simplification: a loose ref that is itself a "ref: <path>" symref (rare
# outside HEAD) is treated as a miss — HEAD is the only symref sit follows.
fn _git_read_loose_ref(refpath) {
    var rp_len = strlen(refpath);
    var full = alloc(5 + rp_len + 1);
    memcpy(full, ".git/", 5);
    memcpy(full + 5, refpath, rp_len);
    store8(full + 5 + rp_len, 0);
    if (sf_exists(full) != 1) { return 0; }
    var fd = sf_open(full, 0, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(96);
    var n = file_read(fd, buf, 96);
    file_close(fd);
    var hexlen = _id_hexlen();
    if (n < hexlen) { return 0; }
    if (hex_prefix_valid(buf, hexlen) == 0) { return 0; }
    store8(buf + hexlen, 0);
    return buf;
}

# Pure scanner over a packed-refs buffer, split out of
# `_git_packed_ref_lookup` in v1.4.7 so the parse can be fuzzed in-process.
# The lookup reads `.git/packed-refs` itself, which made its parsing
# unreachable from a fuzz harness without writing that file — and the
# harness runs from the repo root, where doing so would clobber a real
# `.git/`. Splitting the buffer walk out is the same move the pack varint
# decoders already had by construction, and it is why they had a target
# while this did not. Contract is unchanged: writes `_id_hexlen()` hex
# chars + NUL into `out_buf` and returns 1 on hit, else 0.
fn _git_packed_ref_scan(buf, len, refname, out_buf) {
    var hexlen = _id_hexlen();
    var rn_len = strlen(refname);

    var pos = 0;
    var result = 0;
    while (pos < len) {
        if (result == 0) {
            var eol = pos;
            while (eol < len) {
                if (load8(buf + eol) == 10) { break; }
                eol = eol + 1;
            }
            var line_len = eol - pos;
            var first = load8(buf + pos);
            # A ref line is exactly "<hexlen hex> <refname>": length matches and
            # a space sits at the OID boundary. '#' (35) and '^' (94) are skipped.
            if (first != 35) {
                if (first != 94) {
                    if (line_len == hexlen + 1 + rn_len) {
                        if (load8(buf + pos + hexlen) == 32) {
                            if (hex_prefix_valid(buf + pos, hexlen) == 1) {
                                if (memeq(buf + pos + hexlen + 1, refname, rn_len) == 1) {
                                    memcpy(out_buf, buf + pos, hexlen);
                                    store8(out_buf + hexlen, 0);
                                    result = 1;
                                }
                            }
                        }
                    }
                }
            }
            pos = eol + 1;
        } else {
            pos = len;
        }
    }
    return result;
}

# Look up a full refname (e.g. "refs/heads/main") in .git/packed-refs. Writes
# _id_hexlen() hex chars + NUL into out_buf and returns 1 on hit, else 0. Lines:
# "<oid> <refname>\n"; '#' header/comment lines and '^' peeled-tag lines are
# skipped (a ref name resolves to its own object, not a tag's peeled target).
fn _git_packed_ref_lookup(refname, out_buf) {
    var pair[16];
    if (read_file_fl(".git/packed-refs", &pair) != 0) { return 0; }
    var r = _git_packed_ref_scan(load64(&pair), load64(&pair + 8), refname, out_buf);
    fl_free(load64(&pair));           # 1.7.6 (R1): read per lookup, kept no longer
    return r;
}

# git-mode read_head_ref: resolve .git/HEAD. Symref → loose ref then packed-refs;
# detached (bare OID in HEAD) → that OID. Returns heap hex cstring or 0.
fn _git_read_head_ref() {
    var ref_path = read_head_ref_path();
    if (ref_path == 0) {
        # Detached HEAD: .git/HEAD holds a bare OID (no "ref: " prefix).
        var pair[16];
        if (read_file_fl(".git/HEAD", &pair) != 0) { return 0; }
        var hb = load64(&pair);
        var hn = load64(&pair + 8);
        var hexlen = _id_hexlen();
        var oid = 0;
        if (hn >= hexlen) {
            if (hex_prefix_valid(hb, hexlen) == 1) {
                oid = alloc(hexlen + 1);
                memcpy(oid, hb, hexlen);
                store8(oid + hexlen, 0);
            }
        }
        fl_free(hb);
        return oid;
    }
    var loose = _git_read_loose_ref(ref_path);
    if (loose != 0) { return loose; }
    var out = alloc(96);
    if (_git_packed_ref_lookup(ref_path, out) == 1) { return out; }
    return 0;
}

# Try a full refname (loose then packed-refs), writing hex+NUL into out_buf.
# Returns 1 on hit, 0 miss.
fn _git_try_full_ref(refname, out_buf) {
    var loose = _git_read_loose_ref(refname);
    if (loose != 0) {
        var hexlen = _id_hexlen();
        memcpy(out_buf, loose, hexlen);
        store8(out_buf + hexlen, 0);
        return 1;
    }
    if (_git_packed_ref_lookup(refname, out_buf) == 1) { return 1; }
    return 0;
}

# git-mode resolve_ref_name: HEAD, then refs/tags|heads|remotes/<name> (loose or
# packed), matching the .sit resolution order. Writes hex+NUL, returns 1/0.
fn _git_resolve_ref_name(name, out_buf) {
    if (streq(name, "HEAD") == 1) {
        var h = read_head_ref();
        if (h == 0) { return 0; }
        var hexlen = _id_hexlen();
        memcpy(out_buf, h, hexlen);
        store8(out_buf + hexlen, 0);
        return 1;
    }

    var name_len = strlen(name);

    var tag_ref = alloc(10 + name_len + 1);
    memcpy(tag_ref, "refs/tags/", 10);
    memcpy(tag_ref + 10, name, name_len);
    store8(tag_ref + 10 + name_len, 0);
    if (_git_try_full_ref(tag_ref, out_buf) == 1) { return 1; }

    var head_ref = alloc(11 + name_len + 1);
    memcpy(head_ref, "refs/heads/", 11);
    memcpy(head_ref + 11, name, name_len);
    store8(head_ref + 11 + name_len, 0);
    if (_git_try_full_ref(head_ref, out_buf) == 1) { return 1; }

    var rem_ref = alloc(13 + name_len + 1);
    memcpy(rem_ref, "refs/remotes/", 13);
    memcpy(rem_ref + 13, name, name_len);
    store8(rem_ref + 13 + name_len, 0);
    if (_git_try_full_ref(rem_ref, out_buf) == 1) { return 1; }

    return 0;
}
