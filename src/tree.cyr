# tree.cyr — sit tree objects.
#
# Top-level tree layout for subdirectory grouping (`tlvl_*`), git-SHA-256-compatible
# tree entry parse / build / flatten, and tree_find lookups. Trees encode
# directories as `40000 <name>\0<32B hash>` entries and files as `100644 ...`.

# Mode of a build_tree level entry.
fn tlvl_mode(e) { return load64(e); }
# Name of a build_tree level entry.
fn tlvl_name(e) { return load64(e + 8); }
# Raw (binary) id of a build_tree level entry.
fn tlvl_bytes(e) { return load64(e + 16); }

# Recursive tree writer.
# `entries` is a slice of the sorted+deduped staging index; all entries passed
# at a given call share the same prefix of length `prefix_len` (empty at root).
# Lexical sort of full paths produces correct per-tree git order when walked
# depth-first — no separate sort step needed at the level.
# Returns tree hex hash, or 0 on failure.
fn build_tree(entries, prefix_len) {
    var level = vec_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        var full_path = entry_path(e);
        var rest = full_path + prefix_len;
        var rest_len = strlen(full_path) - prefix_len;

        var slash = 0;
        var found = 0;
        while (slash < rest_len) {
            if (load8(rest + slash) == 47) { found = 1; break; }
            slash = slash + 1;
        }

        if (found == 0) {
            var name = alloc_or_die(rest_len + 1);
            memcpy(name, rest, rest_len);
            store8(name + rest_len, 0);

            var le = alloc_or_die(24);
            store64(le, "100644");
            store64(le + 8, name);
            store64(le + 16, entry_hash(e));
            vec_push(level, le);
            i = i + 1;
        }
        else {
            var subdir_name = alloc_or_die(slash + 1);
            memcpy(subdir_name, rest, slash);
            store8(subdir_name + slash, 0);

            var sub_prefix_len = prefix_len + slash + 1;
            var sub_entries = vec_new();

            var collecting = 1;
            while (collecting == 1) {
                if (i >= n) { collecting = 0; }
                else {
                    var ee = vec_get(entries, i);
                    var ee_path = entry_path(ee);
                    var ee_len = strlen(ee_path);
                    var ok = 1;
                    if (ee_len <= prefix_len + slash) { ok = 0; }
                    else {
                        var m = 0;
                        while (m < slash) {
                            if (load8(ee_path + prefix_len + m) != load8(rest + m)) { ok = 0; }
                            m = m + 1;
                        }
                        if (ok == 1) {
                            if (load8(ee_path + prefix_len + slash) != 47) { ok = 0; }
                        }
                    }
                    if (ok == 0) { collecting = 0; }
                    else {
                        vec_push(sub_entries, ee);
                        i = i + 1;
                    }
                }
            }

            var sub_hex = build_tree(sub_entries, sub_prefix_len);
            if (sub_hex == 0) { return 0; }
            var sub_bytes = hex_decode(sub_hex, 64);
            if (sub_bytes == 0) { return 0; }

            var le = alloc_or_die(24);
            store64(le, "40000");
            store64(le + 8, subdir_name);
            store64(le + 16, sub_bytes);
            vec_push(level, le);
        }
    }

    # 1.6.4 (A11): a name may appear once per level. A merge where one side
    # added file `a` and the other `a/b` handed both through as clean, and this
    # wrote a tree naming `a` twice — a file AND a directory — which readers
    # now drop (parse_tree's order check) and git rejects. Refuse to write it.
    var seen_names = map_new();
    var dn = vec_len(level);
    var di = 0;
    while (di < dn) {
        var dname = tlvl_name(vec_get(level, di));
        if (map_has(seen_names, dname) == 1) {
            eprint3("sit: '", dname, "' would be both a file and a directory — resolve the clash first\n");
            return 0;
        }
        map_set(seen_names, dname, 1);
        di = di + 1;
    }

    var body_size = 0;
    var k = 0;
    var nl = vec_len(level);
    while (k < nl) {
        var le = vec_get(level, k);
        body_size = body_size + strlen(tlvl_mode(le)) + 1 + strlen(tlvl_name(le)) + 1 + 32;
        k = k + 1;
    }

    var body = alloc_or_die(body_size);
    var pos = 0;
    k = 0;
    while (k < nl) {
        var le = vec_get(level, k);
        var mode = tlvl_mode(le);
        var name = tlvl_name(le);
        var mlen = strlen(mode);
        var nlen = strlen(name);
        memcpy(body + pos, mode, mlen); pos = pos + mlen;
        store8(body + pos, 32); pos = pos + 1;
        memcpy(body + pos, name, nlen); pos = pos + nlen;
        store8(body + pos, 0); pos = pos + 1;
        memcpy(body + pos, tlvl_bytes(le), 32); pos = pos + 32;
        k = k + 1;
    }

    return write_typed_object("tree", 4, body, body_size);
}

# S-26: count of tree entries `parse_tree` silently discarded (bad mode,
# unsafe name, or — since 1.6.4 — a duplicate or out-of-order name). fsck
# resets this before its walk and treats a non-zero value as structural
# corruption, because a discarded entry's object is invisible to the
# reachability walk and would otherwise be pruned while still referenced.
var _tree_dropped_entries = 0;
# Zero the count of tree entries parse_tree had to drop.
fn tree_dropped_reset() { _tree_dropped_entries = 0; return 0; }
# Tree entries parse_tree dropped since the last reset (fsck refuses to prune if nonzero).
fn tree_dropped_count() { return _tree_dropped_entries; }

# Mode string of a parsed tree entry.
fn tree_entry_mode(e) { return load64(e); }
# Name of a parsed tree entry.
fn tree_entry_name(e) { return load64(e + 8); }
# Hex id of a parsed tree entry.
fn tree_entry_hash(e) { return load64(e + 16); }

# git's tree order (base_name_compare): byte-compare the common prefix; where
# one name ends, a tree continues as if followed by '/', a file by NUL. <0, 0
# or >0, like memcmp.
fn _tree_order_cmp(a, alen, a_tree, b, blen, b_tree) {
    var n = alen;
    if (blen < n) { n = blen; }
    var i = 0;
    while (i < n) {
        var ca = load8(a + i) & 0xFF;
        var cb = load8(b + i) & 0xFF;
        if (ca != cb) { return ca - cb; }
        i = i + 1;
    }
    var c1 = 0;
    var c2 = 0;
    if (alen > n) { c1 = load8(a + n) & 0xFF; }
    else { if (a_tree == 1) { c1 = 47; } }
    if (blen > n) { c2 = load8(b + n) & 0xFF; }
    else { if (b_tree == 1) { c2 = 47; } }
    return c1 - c2;
}

# Parse tree object body. Returns vec of entries.
fn parse_tree(body, body_len) {
    var entries = vec_new();
    # Raw hash width per active backend: 32 (sit SHA-256) or 20 (git SHA-1).
    var rawlen = _id_rawlen();
    var pos = 0;
    # Previous RAW entry (kept or not), for the order / duplicate check below.
    var prev_name = 0;
    var prev_len = 0;
    var prev_tree = 0;
    while (pos < body_len) {
        var sp = pos;
        while (sp < body_len) {
            if (load8(body + sp) == 32) { break; }
            sp = sp + 1;
        }
        if (sp >= body_len) { pos = body_len; }
        else {
            var mode_len = sp - pos;
            var mode = alloc_or_die(mode_len + 1);
            memcpy(mode, body + pos, mode_len);
            store8(mode + mode_len, 0);

            var nu = sp + 1;
            while (nu < body_len) {
                if (load8(body + nu) == 0) { break; }
                nu = nu + 1;
            }
            if (nu >= body_len) { pos = body_len; }
            else {
                var name_len = nu - sp - 1;
                var name = alloc_or_die(name_len + 1);
                memcpy(name, body + sp + 1, name_len);
                store8(name + name_len, 0);

                if (nu + 1 + rawlen > body_len) { pos = body_len; }
                else {
                    # S-03: reject tree entries whose mode isn't allowlisted or
                    # whose name would let an attacker escape the working tree.
                    # Silent drop here means a malicious subtree is treated as
                    # empty — materialize_target won't act on it.
                    #
                    # S-26: the drop must not stay silent for FSCK. A dropped
                    # entry is never enqueued by fsck_walk_reachable, so the
                    # blob or subtree it names is reported `dangling` even though
                    # a live tree still references it — and `fsck --prune-now`
                    # then DELETED it, breaking clone/checkout of that history
                    # with no reflog recovery path. Neither existing tripwire
                    # caught it: `bad` stayed 0 (both objects read fine) and the
                    # all-unreachable check does not apply.
                    #
                    # Reachable without local access: `_serve_rehash_and_insert`
                    # validates framing, type and SHA-256 but never parses a tree
                    # body, so a pushed tree carrying e.g. a `100755` entry is
                    # accepted, and its blob with it.
                    #
                    # The counter lets fsck treat "this tree has entries I could
                    # not parse" as a structural defect and refuse to prune.
                    # 1.6.4: every entry must sort STRICTLY after the one before
                    # it in git order, which rules out duplicate names. A tree
                    # naming `a` twice made `sit show` list both blobs while
                    # checkout wrote the second — the review-vs-checkout split
                    # behind Gitea's CVE-2026-95106 — and fsck called it clean.
                    # git's fsck rejects both shapes (duplicateEntries,
                    # treeNotSorted). Every sit writer sorts before build_tree,
                    # so this never drops an entry sit wrote; a later duplicate
                    # is dropped, leaving every reader the same first entry.
                    var is_tree = 0;
                    if (streq(mode, "40000") == 1) { is_tree = 1; }
                    var in_order = 1;
                    if (prev_name != 0) {
                        if (_tree_order_cmp(prev_name, prev_len, prev_tree,
                            name, name_len, is_tree) >= 0) { in_order = 0; }
                        if (prev_len == name_len) {
                            if (memeq(prev_name, name, name_len) == 1) { in_order = 0; }
                        }
                    }
                    prev_name = name;
                    prev_len = name_len;
                    prev_tree = is_tree;
                    var kept = 0;
                    if (in_order == 1) {
                        if (tree_entry_mode_valid(mode) == 1) {
                            if (tree_entry_name_valid(name) == 1) {
                                var hash_hex = hex_encode(body + nu + 1, rawlen);
                                var e = alloc_or_die(24);
                                store64(e, mode);
                                store64(e + 8, name);
                                store64(e + 16, hash_hex);
                                vec_push(entries, e);
                                kept = 1;
                            }
                        }
                    }
                    if (kept == 0) { _tree_dropped_entries = _tree_dropped_entries + 1; }
                    pos = nu + 1 + rawlen;
                }
            }
        }
    }
    return entries;
}

# Recursively walk a tree, pushing one entry per file to `out` with the full
# path (e.g., "src/main.cyr") stored in the `name` slot. Subtree entries are
# traversed, not emitted. Returned entries can be searched by `tree_find`
# against full paths because it only uses the name/hash slots.
#
# S-14: bounds recursion depth via a module-level counter. 256 levels matches
# git's limit and covers every realistic project hierarchy.

var _TREE_MAX_DEPTH = 256;
var _tree_walk_depth = 0;

# S-25: depth is not the only unbounded dimension.
#
# S-14 capped how DEEP the walk goes, but not how MANY nodes it visits. A tree
# object may reference the same subtree hash many times, and each reference is
# expanded again — so a DAG of k levels where every level names the previous
# subtree N times expands to N^k paths from a repository of only a few hundred
# KB. Depth 256 is never reached; memory is exhausted first, on the read-only
# path owl / thoth call against untrusted repos.
#
# The node budget bounds total expansions per top-level walk. 2M entries is far
# above any real tree (the Linux kernel is ~80k files) and is reached in well
# under a second, so a hostile repo fails fast instead of ballooning.
var _TREE_MAX_NODES = 2000000;
var _tree_walk_nodes = 0;

# Reset the per-walk budgets. Every EXTERNAL entry into flatten_tree must call
# this first; the recursion itself must not.
fn flatten_tree_reset() {
    _tree_walk_depth = 0;
    _tree_walk_nodes = 0;
    return 0;
}

# Push one {mode, full path, hash} entry per file under `tree_hex`; depth- and node-capped.
fn flatten_tree(tree_hex, prefix, out) {
    if (_tree_walk_depth >= _TREE_MAX_DEPTH) {
        eprintln("sit: tree depth exceeds 256 — refusing to walk further");
        return 0 - 2;
    }
    if (_tree_walk_nodes >= _TREE_MAX_NODES) {
        eprintln("sit: tree entry count exceeds the walk limit (malformed or hostile repo?)");
        return 0 - 2;
    }
    _tree_walk_depth = _tree_walk_depth + 1;
    var obj[24];
    if (read_object(tree_hex, &obj) != 0) {
        _tree_walk_depth = _tree_walk_depth - 1;
        return 0 - 1;
    }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);

    var entries = parse_tree(buf + coff, blen - coff);
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        var mode = tree_entry_mode(e);
        var name = tree_entry_name(e);
        var hash_hex = tree_entry_hash(e);
        _tree_walk_nodes = _tree_walk_nodes + 1;   # S-25 node budget

        var prefix_len = strlen(prefix);
        var name_len = strlen(name);

        if (streq(mode, "40000") == 1) {
            var sub_prefix = alloc_or_die(prefix_len + name_len + 2);
            memcpy(sub_prefix, prefix, prefix_len);
            memcpy(sub_prefix + prefix_len, name, name_len);
            store8(sub_prefix + prefix_len + name_len, 47);
            store8(sub_prefix + prefix_len + name_len + 1, 0);
            # 1.7.6 (L8): a subtree that cannot be read (or that trips a
            # budget) fails the whole walk. Its result was discarded, so only a
            # bad ROOT tree failed — a missing `d/` read as an empty directory
            # and checkout / reset / merge deleted everything under it.
            var sr = flatten_tree(hash_hex, sub_prefix, out);
            if (sr < 0) {
                _tree_walk_depth = _tree_walk_depth - 1;
                return sr;
            }
        }
        else {
            var full_path = alloc_or_die(prefix_len + name_len + 1);
            memcpy(full_path, prefix, prefix_len);
            memcpy(full_path + prefix_len, name, name_len);
            store8(full_path + prefix_len + name_len, 0);

            var flat = alloc_or_die(24);
            store64(flat, mode);
            store64(flat + 8, full_path);
            store64(flat + 16, hash_hex);
            vec_push(out, flat);
        }
        i = i + 1;
    }
    _tree_walk_depth = _tree_walk_depth - 1;
    return 0;
}

var _head_tree_warned = 0;

# Read HEAD → commit → tree, recursively flatten into full-path entries.
# Returns vec or 0 if there's no HEAD commit yet — or if HEAD's tree cannot be
# read, which is said on stderr (once per process: the public API runs this per
# status call inside owl / thoth): callers treat 0 as "nothing tracked", the
# safe reading for the dirty / untracked checks.
fn read_head_tree_entries() {
    var head_commit = read_head_ref();
    if (head_commit == 0) { return 0; }
    # 1.7.6 (L8): the same parse as every other tree read (parse_commit_body,
    # the walk's failure propagated). This took any "tree " first line and
    # ignored the walk's result.
    var out = commit_tree_entries(head_commit);
    if (out == 0) {
        if (_head_tree_warned == 0) {
            eprintln("sit: HEAD's tree cannot be read (missing or corrupt objects) — run 'sit fsck'");
            _head_tree_warned = 1;
        }
    }
    return out;
}

# P-10: tree_find cache. The previous O(N) linear scan was called in O(N)
# loops (cmd_status iterating index entries against head_entries; cmd_diff;
# materialize_target; the merge three-way loops). For any entries vec that's
# searched more than once, build a name → entry hashmap on first call and
# reuse it for every subsequent tree_find on the same vec. Cache keyed by
# vec pointer; lifetime = process (sit is short-lived per invocation).
#
# Worst case (one tree_find per vec): one map build + one lookup = O(N) + O(1).
# Same complexity as the old linear scan. Strictly an improvement when called
# more than once on the same vec, which every hot caller does.
var _tree_find_keys = 0;
var _tree_find_maps = 0;

fn _tree_find_map(entries) {
    if (_tree_find_keys == 0) {
        _tree_find_keys = vec_new();
        _tree_find_maps = vec_new();
    }
    var k = vec_len(_tree_find_keys);
    var ki = 0;
    while (ki < k) {
        if (vec_get(_tree_find_keys, ki) == entries) {
            return vec_get(_tree_find_maps, ki);
        }
        ki = ki + 1;
    }
    var m = map_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        map_set(m, tree_entry_name(e), e);
        i = i + 1;
    }
    vec_push(_tree_find_keys, entries);
    vec_push(_tree_find_maps, m);
    return m;
}

# Drop `entries`' cached map (1.7.6, R1). A caller that builds a vec per call
# and is called again and again — the public API, in owl / thoth — releases it
# when done; otherwise every call left one more key for every later tree_find
# to scan past.
fn tree_find_release(entries) {
    if (_tree_find_keys == 0) { return 0; }
    var k = vec_len(_tree_find_keys);
    var ki = 0;
    var at = 0 - 1;
    while (ki < k) {
        if (at < 0) { if (vec_get(_tree_find_keys, ki) == entries) { at = ki; } }
        ki = ki + 1;
    }
    if (at < 0) { return 0; }
    var last = k - 1;
    if (at != last) {
        vec_set(_tree_find_keys, at, vec_get(_tree_find_keys, last));
        vec_set(_tree_find_maps, at, vec_get(_tree_find_maps, last));
    }
    vec_pop(_tree_find_keys);
    vec_pop(_tree_find_maps);
    return 0;
}

# Entry named `name` in a parsed tree (hashmap-backed), or 0.
fn tree_find(entries, name) {
    if (entries == 0) { return 0; }
    var m = _tree_find_map(entries);
    return map_get(m, name);
}

# Hex id of the entry at `path`, or 0.
fn tree_find_hash(entries, path) {
    if (entries == 0) { return 0; }
    var e = tree_find(entries, path);
    if (e == 0) { return 0; }
    return tree_entry_hash(e);
}

# Union of paths across three flattened tree entry vecs. Returns a vec of
# heap-copied path cstrings, each unique.
#
# P-18: dedup via hashmap rather than the O(N²) nested-streq scan over the
# growing `paths` vec. For three trees of N entries each, the old loop did
# ~3N × (3N/2) = ~4.5N² streqs; with the map it's 3N inserts + 3N membership
# checks, all O(1) amortized.
fn three_way_path_set(base, ours, theirs) {
    var paths = vec_new();
    var seen = map_new();
    var sources_cnt = 3;
    var sources[24];
    store64(&sources + 0, base);
    store64(&sources + 8, ours);
    store64(&sources + 16, theirs);

    var si = 0;
    while (si < sources_cnt) {
        var entries = load64(&sources + si * 8);
        if (entries != 0) {
            var n = vec_len(entries);
            var i = 0;
            while (i < n) {
                var e = vec_get(entries, i);
                var p = tree_entry_name(e);
                if (map_has(seen, p) == 0) {
                    var plen = strlen(p);
                    var copy = alloc_or_die(plen + 1);
                    memcpy(copy, p, plen);
                    store8(copy + plen, 0);
                    map_set(seen, copy, 1);
                    vec_push(paths, copy);
                }
                i = i + 1;
            }
        }
        si = si + 1;
    }
    return paths;
}

# Walk descendant's parent chain; return 1 if ancestor_hex is descendant
# or any of its ancestors. Linear — sit has no merge commits yet.
