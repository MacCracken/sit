# object_db.cyr — patra object store, compression / framing, read commands.
#
# Content-addressed via sigil SHA-256 over the git-SHA-256-compatible framing
# "<type> <len>\0<content>". Zlib compression via sankoch. Objects live in
# .sit/objects.patra (`objects(hash STR, ty INT, content BYTES)`). Legacy
# loose-file layout auto-migrates on first access. Read verbs: cat-file,
# owl-file, fsck. Also the blob-hash primitives used by add + status.

# Write the loose-object path .sit/objects/xx/<62 hex> into `buf`; returns its length (78).
fn object_path(buf, hex) {
    memcpy(buf, ".sit/objects/", 13);
    store8(buf + 13, load8(hex));
    store8(buf + 14, load8(hex + 1));
    store8(buf + 15, 47);
    memcpy(buf + 16, hex + 2, 62);
    store8(buf + 78, 0);
    return 78;
}

# Try to resolve `name` as a ref: HEAD, refs/tags/<name>, or refs/heads/<name>
# in that order. On success, writes the 64-char hash into out_buf and returns 1.
# Returns 0 if no ref matches.
fn resolve_hash(prefix, out_buf) {
    var plen = strlen(prefix);
    var hexlen = _id_hexlen();
    if (plen == hexlen) {
        # S-01: a full-length hash must still be hex — otherwise the
        # short-circuit here would pass garbage bytes straight through.
        if (hex_prefix_valid(prefix, hexlen) == 0) { return 0; }
        memcpy(out_buf, prefix, hexlen);
        store8(out_buf + hexlen, 0);
        return 1;
    }

    # Try as a ref name first (HEAD, tags, branches)
    if (resolve_ref_name(prefix, out_buf) == 1) { return 1; }

    # git mode: objects live in loose files and packs, not patra. 1.12.0: a
    # short id is looked up there too — loose fanout and every pack index, this
    # repository's and its alternates' (_git_resolve_prefix, git_pack.cyr).
    if (_repo_backend == 1) {
        if (plen < 4) { return 0 - 2; }
        if (hex_prefix_valid(prefix, plen) == 0) { return 0; }
        var gc = _git_resolve_prefix(prefix, plen, out_buf);
        if (gc > 1) { return 0 - 1; }
        return gc;
    }

    if (plen < 4) { return 0 - 2; }

    # S-01: reject any non-hex character before interpolating into LIKE.
    # Without this, a prefix containing `'` would break / inject the SQL.
    if (hex_prefix_valid(prefix, plen) == 0) { return 0; }

    var db = get_object_db();
    if (db == 0) { return 0; }

    # S-24: SQL strings on the freelist instead of bump heap so they don't
    # accumulate per-call.
    var sql = fl_alloc(64 + plen);
    memcpy(sql, "SELECT hash FROM objects WHERE hash LIKE '", 42);
    memcpy(sql + 42, prefix, plen);
    memcpy(sql + 42 + plen, "%'", 2);
    store8(sql + 42 + plen + 2, 0);

    var rs = patra_query(db, sql);
    fl_free(sql);
    if (rs == 0) { return 0; }
    var count = patra_result_count(rs);
    var ret = 0;
    if (count == 1) {
        var hash_str = patra_result_get_str(rs, 0, 0);
        memcpy(out_buf, hash_str, 64);
        store8(out_buf + 64, 0);
        ret = 1;
    }
    else {
        if (count > 1) { ret = 0 - 1; }
    }
    patra_result_free(rs);
    # 1.10.0: and the packed objects. One object both packed and a row is one match.
    if (ret >= 0) {
        var phex[72];
        var pc = sit_pack_prefix(0, prefix, plen, &phex);
        if (pc > 1) { ret = 0 - 1; }
        if (pc == 1) {
            if (ret == 0) {
                memcpy(out_buf, &phex, 64);
                store8(out_buf + 64, 0);
                ret = 1;
            }
            else {
                if (memeq(out_buf, &phex, 64) == 0) { ret = 0 - 1; }
            }
        }
    }
    return ret;
}

# 1.7.6 (R10): the one inflate for a stored object, "<type> <len>\0<content>"
# under zlib. It replaces seven copies of the same sizing (4x the compressed
# size, retried at the 16 MiB ceiling), and sizes the retry from the object's
# own header instead: a blob compressing better than 4:1 used to take a fresh
# 16 MiB buffer per read — on the bump heap at most sites, so never returned.
# A clone of 2,000 such 20 KB blobs peaked at 4.4 GB RSS with transparent
# huge pages on. The result is a freelist buffer of about the object's size.
#
# Writes {ptr, dlen, content_off} to out24; the buffer is the caller's to
# fl_free (or keep). Returns 0, -2 out of memory, -3 not a valid stream (or
# past the ratio / 16 MiB caps), -4 no framing NUL.
var _OBJ_INFLATE_MAX = 16777216;

# Inflate stored object bytes into a freelist buffer sized for them (see above).
fn obj_inflate_fl(compressed, clen, out24) {
    var dec_cap = clen * 4;
    if (dec_cap < 4096) { dec_cap = 4096; }
    if (dec_cap > _OBJ_INFLATE_MAX) { dec_cap = _OBJ_INFLATE_MAX; }
    var buf = fl_alloc(dec_cap);
    if (buf == 0) { return 0 - 2; }
    # Stale freelist bytes must not read as a header the inflate never wrote.
    store64(buf, 0); store64(buf + 8, 0); store64(buf + 16, 0); store64(buf + 24, 0);
    var dlen = zlib_decompress_with_ratio_cap(compressed, clen, buf, dec_cap, SIT_MAX_INFLATE_RATIO);
    if (dlen == 0 - ERR_BUFFER_TOO_SMALL) {
        if (dec_cap < _OBJ_INFLATE_MAX) {
            # The output is written in order, so the header is in `buf`.
            var want = obj_frame_total(buf, 32);
            if (want > _OBJ_INFLATE_MAX) { fl_free(buf); return 0 - 3; }
            var cap2 = want + 16;
            if (want <= dec_cap) { cap2 = _OBJ_INFLATE_MAX; }   # header unreadable or lying
            if (cap2 > _OBJ_INFLATE_MAX) { cap2 = _OBJ_INFLATE_MAX; }
            fl_free(buf);
            buf = fl_alloc(cap2);
            if (buf == 0) { return 0 - 2; }
            dlen = zlib_decompress_with_ratio_cap(compressed, clen, buf, cap2, SIT_MAX_INFLATE_RATIO);
        }
    }
    if (dlen <= 0) { fl_free(buf); return 0 - 3; }
    var nul = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (nul >= dlen) { scanning = 0; }
        else {
            if (load8(buf + nul) == 0) { scanning = 0; }
            else { nul = nul + 1; }
        }
    }
    if (nul >= dlen) { fl_free(buf); return 0 - 4; }
    store64(out24, buf);
    store64(out24 + 8, dlen);
    store64(out24 + 16, nul + 1);
    return 0;
}

# The whole framed length an object header at `buf` declares — "<type> <n>\0"
# plus n — reading at most `avail` bytes; -1 when no well-formed header is there.
fn obj_frame_total(buf, avail) {
    var sp = 0 - 1;
    var i = 0;
    while (i < avail) {
        if (sp < 0) {
            var c = load8(buf + i) & 0xFF;
            if (c == 32) { sp = i; }
            else {
                if (c < 97) { i = avail; }
                if (c > 122) { i = avail; }
            }
        }
        i = i + 1;
    }
    if (sp < 1) { return 0 - 1; }
    var n = 0;
    var j = sp + 1;
    var digits = 0;
    var end = 0 - 1;
    while (j < avail) {
        if (end < 0) {
            var d = load8(buf + j) & 0xFF;
            if (d == 0) { end = j; }
            else {
                if (d < 48) { j = avail; }
                else {
                    if (d > 57) { j = avail; }
                    else {
                        n = n * 10 + (d - 48);
                        digits = digits + 1;
                        if (digits > 10) { j = avail; }
                    }
                }
            }
        }
        j = j + 1;
    }
    if (end < 0) { return 0 - 1; }
    if (digits == 0) { return 0 - 1; }
    if (digits > 10) { return 0 - 1; }
    return end + 1 + n;
}

# ── Packs (1.10.0) ─────────────────────────────────────────────────
#
# `sit gc` moves every reachable object into a pack, `.sit/packs/pack-<id>.pack`
# beside its `.idx`, in git's SHA-256 pack v2 / idx v2 format: byte for byte,
# so `git index-pack` rebuilds the same .idx. Each object is a delta against the
# newer version at the same path where that wins. git_pack.cyr's reader serves
# them (OFS_DELTA only: a REF_DELTA is refused, so a sit pack is always
# self-contained), and sit_pack_read frames the result like a stored row. Rows
# in objects.patra are the loose objects: whatever was written since, and
# whatever gc found unreachable. See ADR 0016.
#
# A store's pack list is read once per process. Packs change only under gc,
# which runs alone (the store lock, below) and resets the list itself.

# Store root ("" = this repository) -> vec of 16-byte {idx path, pack path} cells.
var _sit_pack_lists = 0;

# `root` as an absolute path. Another repository's root is relative to the
# process cwd, as its patra_open is, but the pack reader resolves a relative
# path against this repository's root (sit_abs) — so `sit clone ../src dst`,
# with the root set to dst, looked for dst/../src's packs. agnos has no cwd and
# takes absolute paths only.
fn _sit_root_abs(root) {
    if (load8(root) == 47) { return root; }
    #ifdef CYRIUS_TARGET_AGNOS
    return root;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var cwd[4096];
    if (syscall(SYS_GETCWD, &cwd, 4096) <= 0) { return root; }
    var cl = strlen(&cwd);
    var rl = strlen(root);
    var p = alloc_or_die(cl + rl + 2);
    memcpy(p, &cwd, cl);
    store8(p + cl, 47);
    memcpy(p + cl + 1, root, rl);
    store8(p + cl + 1 + rl, 0);
    return p;
    #endif
}

# The packs directory of the store at `root` (0 = this repository).
fn _sit_packdir(root) {
    if (root == 0) { return ".sit/packs"; }
    var ar = _sit_root_abs(root);
    var rl = strlen(ar);
    var p = alloc_or_die(rl + 12);
    memcpy(p, ar, rl);
    memcpy(p + rl, "/.sit/packs", 11);
    store8(p + rl + 11, 0);
    return p;
}

# A pack file path sit_packs built for the store at `root`, as lstat needs it:
# this repository's are relative to its root (0), another's are absolute.
fn _sit_pack_path_abs(root, path) {
    if (root == 0) { return sit_abs(path); }
    return path;
}

# 1 when `nm` (`n` bytes) is a pack index name gc writes: `pack-<64 hex>.idx`.
fn _sit_pack_idx_name(nm, n) {
    if (n != 73) { return 0; }
    if (memeq(nm, "pack-", 5) == 0) { return 0; }
    if (memeq(nm + 69, ".idx", 4) == 0) { return 0; }
    return hex_prefix_valid(nm + 5, 64);
}

# The packs of the store at `root`, listed on first use: a vec of {idx path,
# pack path} cells. A packs directory that is not a plain directory (a planted
# symlink) has none.
fn sit_packs(root) {
    if (_sit_pack_lists == 0) { _sit_pack_lists = map_new(); }
    # 1.11.0 (R6): this repository's list is keyed by its root, so a process
    # that opens another (the read API, sit serve --repos) lists that one's.
    var key = root;
    if (key == 0) { key = _repo_root; }
    if (key == 0) { key = ""; }
    var hit = map_get(_sit_pack_lists, key);
    if (hit != 0) { return hit; }
    var packs = vec_new();
    var dir = _sit_packdir(root);
    var dl = strlen(dir);
    var adir = dir;
    if (root == 0) { adir = sit_abs(dir); }
    if (path_lstat_kind(adir) == 0x4000) {
        var names = dir_list(str_from(adir));
        var i = 0;
        while (i < vec_len(names)) {
            var ns = vec_get(names, i);
            var nm = str_data(ns);
            var nl = str_len(ns);
            if (_sit_pack_idx_name(nm, nl) == 1) {
                var ip = alloc_or_die(dl + 1 + nl + 1);
                memcpy(ip, dir, dl);
                store8(ip + dl, 47);
                memcpy(ip + dl + 1, nm, nl);
                store8(ip + dl + 1 + nl, 0);
                var pp = alloc_or_die(dl + 1 + nl + 2);
                memcpy(pp, ip, dl + 1 + nl - 4);
                memcpy(pp + dl + 1 + nl - 4, ".pack", 5);
                store8(pp + dl + 1 + nl + 1, 0);
                # 1.12.2 (S4): regular files only. gc never writes a link here,
                # and a pack linked in from another repository was served as
                # this one's — another tenant's history, under --repos.
                var real = 1;
                if (path_lstat_kind(_sit_pack_path_abs(root, ip)) != 0x8000) { real = 0; }
                if (path_lstat_kind(_sit_pack_path_abs(root, pp)) != 0x8000) { real = 0; }
                if (real == 1) {
                    var cell = alloc_or_die(16);
                    store64(cell, ip);
                    store64(cell + 8, pp);
                    vec_push(packs, cell);
                }
            }
            i = i + 1;
        }
    }
    var kl = strlen(key);
    var kc = alloc_or_die(kl + 1);
    memcpy(kc, key, kl);
    store8(kc + kl, 0);
    map_set(_sit_pack_lists, kc, packs);
    return packs;
}

# Forget the pack list of the store at `root` (0: this repository's), so the
# next sit_packs lists its directory again.
fn sit_packs_forget(root) {
    if (_sit_pack_lists == 0) { return 0; }
    var key = root;
    if (key == 0) { key = _repo_root; }
    if (key == 0) { key = ""; }
    if (map_has(_sit_pack_lists, key) == 1) { map_delete(_sit_pack_lists, key); }
    return 0;
}

# Forget every store's pack list (gc, after installing or removing a pack).
fn sit_packs_reset() {
    _sit_pack_lists = 0;
    return 0;
}

# How many packs the store at `root` has.
fn sit_pack_count(root) {
    return vec_len(sit_packs(root));
}

# Find `hex` (64 hex) in the store's packs: {pack data, pack len, offset} at
# out24 and 0; -3 when no pack holds it, -2 when `hex` is not an id.
fn sit_pack_locate(root, hex, out24) {
    var packs = sit_packs(root);
    var n = vec_len(packs);
    if (n == 0) { return 0 - 3; }
    var raw[32];
    if (hex_decode_into(hex, 64, &raw) == 0) { return 0 - 2; }
    # 1.12.2 (P6): the pack that answered last is asked first, as git mode's
    # reader has done since 1.7.6. A walk reads a delta chain, or one commit's
    # tree, from one pack; asking every pack in turn made N objects in N packs
    # (a file:// remote's) cost N² index lookups.
    if (_sit_pack_last_list == packs) {
        if (_sit_pack_try(_sit_pack_last, &raw, out24) == 0) { return 0; }
    }
    var rc = 0 - 3;
    var i = 0;
    while (i < n) {
        if (rc != 0) {
            var cell = vec_get(packs, i);
            if (_sit_pack_try(cell, &raw, out24) == 0) {
                rc = 0;
                _sit_pack_last = cell;
                _sit_pack_last_list = packs;
            }
        }
        i = i + 1;
    }
    return rc;
}

# The {idx, pack} cell that answered sit_pack_locate last, and the pack list it
# came from (a list replaced by sit_packs_reset / _forget is never this one).
var _sit_pack_last = 0;
var _sit_pack_last_list = 0;

# Look the 32-byte id `raw` up in the pack `cell` {idx path, pack path}: 0 with
# {pack data, pack len, offset} at out24, or -1.
fn _sit_pack_try(cell, raw, out24) {
    var off = _git_idx_lookup(load64(cell), raw, 32);
    if (off < 0) { return 0 - 1; }
    var pp[16];
    if (_git_load_pack(load64(cell + 8), &pp) != 0) { return 0 - 1; }
    store64(out24, load64(&pp));
    store64(out24 + 8, load64(&pp + 8));
    store64(out24 + 16, off);
    return 0;
}

# 1 when one of the store's packs holds `hex`, else 0.
fn sit_pack_has(root, hex) {
    var loc[24];
    if (sit_pack_locate(root, hex, &loc) == 0) { return 1; }
    return 0;
}

# The framing word of pack type `t` (1 commit, 2 tree, 3 blob, 4 tag), or 0.
fn _pack_type_word(t) {
    if (t == 1) { return "commit"; }
    if (t == 2) { return "tree"; }
    if (t == 3) { return "blob"; }
    if (t == 4) { return "tag"; }
    return 0;
}

# Read `hex` from the store's packs into the read_object contract: a freelist
# buffer holding "<type> <len>\0<content>" with its content offset. Returns 0,
# -3 when no pack holds it, -6 out of memory, -7 when the entry does not
# reconstruct. Like a row read, this does not re-hash; fsck and gc do.
fn sit_pack_read(root, hex, out24) {
    var loc[24];
    var lr = sit_pack_locate(root, hex, &loc);
    if (lr != 0) { return lr; }
    var res[24];
    var ptype[8];
    store64(&ptype, 0);
    if (_pack_obj_ex(load64(&loc), load64(&loc + 8), load64(&loc + 16), &res, &ptype, 0) != 0) {
        return 0 - 7;
    }
    var body = load64(&res);
    var blen = load64(&res + 8);
    var word = _pack_type_word(load64(&ptype));
    if (word == 0) { fl_free(body); return 0 - 7; }
    var wl = strlen(word);
    var hdr[32];
    memcpy(&hdr, word, wl);
    store8(&hdr + wl, 32);
    var dg = write_decimal(&hdr + wl + 1, blen);
    store8(&hdr + wl + 1 + dg, 0);
    var hl = wl + dg + 2;
    var framed = fl_alloc(hl + blen + 1);
    if (framed == 0) { fl_free(body); return 0 - 6; }
    memcpy(framed, &hdr, hl);
    _pack_copy(framed + hl, body, blen);
    fl_free(body);
    store64(out24, framed);
    store64(out24 + 8, hl + blen);
    store64(out24 + 16, hl);
    return 0;
}

# Validate the .idx at `path` (v2, 32-byte ids) and write {data, len, count}
# to out24. Returns 0, or -1 when it is unreadable or malformed. The checks are
# _git_idx_lookup's: magic, version, and a count the file can hold.
fn _sit_idx_open(path, out24) {
    var pr[16];
    if (_git_file_cached(path, &pr) != 0) { return 0 - 1; }
    var d = load64(&pr);
    var len = load64(&pr + 8);
    if (len < 1032 + 64) { return 0 - 1; }
    if ((load8(d) & 0xFF) != 255) { return 0 - 1; }
    if (memeq(d + 1, "tOc", 3) == 0) { return 0 - 1; }
    if (_be32(d + 4) != 2) { return 0 - 1; }
    var n = _be32(d + 8 + 255 * 4);
    if (n < 0) { return 0 - 1; }
    if (n > (len - 1032 - 64) / 40) { return 0 - 1; }
    store64(out24, d);
    store64(out24 + 8, len);
    store64(out24 + 16, n);
    return 0;
}

# Count the packed objects whose id starts with `prefix` (`plen` hex digits,
# at least 2, already validated), up to 2, writing the first one's 64 hex to
# `out` (65 bytes). resolve_hash's pack half.
fn sit_pack_prefix(root, prefix, plen, out) {
    var packs = sit_packs(root);
    var found = 0;
    var hx[72];
    var b0 = 0;
    var i = 0;
    while (i < 2) {
        var c = load8(prefix + i) & 0xFF;
        var v = 0;
        if (c >= 97) { v = c - 87; }
        else {
            if (c >= 65) { v = c - 55; }
            else { v = c - 48; }
        }
        b0 = b0 * 16 + v;
        i = i + 1;
    }
    var pi = 0;
    while (pi < vec_len(packs)) {
        var ix[24];
        if (_sit_idx_open(load64(vec_get(packs, pi)), &ix) == 0) {
            var d = load64(&ix);
            var lo = 0;
            if (b0 > 0) { lo = _be32(d + 8 + (b0 - 1) * 4); }
            var hi = _be32(d + 8 + b0 * 4);
            if (hi > load64(&ix + 16)) { hi = 0; }
            var k = lo;
            while (k < hi) {
                if (found < 2) {
                    _hex_into(d + 1032 + k * 32, 32, &hx);
                    if (memeq(&hx, prefix, plen) == 1) {
                        if (found == 0) {
                            memcpy(out, &hx, 64);
                            store8(out + 64, 0);
                            found = 1;
                        }
                        else {
                            if (memeq(out, &hx, 64) == 0) { found = 2; }
                        }
                    }
                }
                k = k + 1;
            }
        }
        pi = pi + 1;
    }
    return found;
}

# Push the 64-hex id (a heap cstring) of every object in the store's packs
# onto `out`. An object two packs hold appears twice. Returns how many were
# pushed, or -1 when an .idx is malformed.
fn sit_pack_oids(root, out) {
    var packs = sit_packs(root);
    var total = 0;
    var pi = 0;
    while (pi < vec_len(packs)) {
        var ix[24];
        if (_sit_idx_open(load64(vec_get(packs, pi)), &ix) != 0) { return 0 - 1; }
        var d = load64(&ix);
        var n = load64(&ix + 16);
        var k = 0;
        while (k < n) {
            var hx = alloc_or_die(72);
            _hex_into(d + 1032 + k * 32, 32, hx);
            vec_push(out, hx);
            k = k + 1;
        }
        total = total + n;
        pi = pi + 1;
    }
    return total;
}

# 1 when the last 32 bytes of {d, len} are the SHA-256 of everything before.
fn _sit_trailer_ok(d, len) {
    if (len < 32) { return 0; }
    var h[32];
    sha256(d, len - 32, &h);
    return memeq(&h, d + len - 32, 32);
}

# fsck's check of the pack files themselves: every pack's trailing SHA-256 and
# its .idx's, and that the .idx names its pack's. Reports each failure on
# stderr and returns how many there were.
fn sit_pack_verify_files(root) {
    var packs = sit_packs(root);
    var bad = 0;
    var pi = 0;
    while (pi < vec_len(packs)) {
        var cell = vec_get(packs, pi);
        var ok = 0;
        var ix[24];
        var pp[16];
        if (_sit_idx_open(load64(cell), &ix) == 0) {
            if (_git_load_pack(load64(cell + 8), &pp) == 0) {
                var d = load64(&ix);
                var il = load64(&ix + 8);
                var pd = load64(&pp);
                var pl = load64(&pp + 8);
                if (_sit_trailer_ok(d, il) == 1) {
                    if (_sit_trailer_ok(pd, pl) == 1) {
                        if (memeq(d + il - 64, pd + pl - 32, 32) == 1) { ok = 1; }
                    }
                }
            }
        }
        if (ok == 0) {
            var ip = load64(cell);
            syscall(SYS_WRITE, STDERR, "bad pack ", 9);
            syscall(SYS_WRITE, STDERR, ip, strlen(ip));
            syscall(SYS_WRITE, STDERR, "\n", 1);
            bad = bad + 1;
        }
        pi = pi + 1;
    }
    return bad;
}

# Read and decompress an object by full 64-char hex hash.
# On success, writes to out (24 bytes):
#   out[0..8)    decompressed buffer ptr
#   out[8..16)   decompressed length (framing + content)
#   out[16..24)  content offset (first byte past framing \0)
# Returns 0 on success, negative on error.
fn read_object(hex, out) {
    # Storage seam (roadmap 1.2.0): a .git/ repo has no patra store — objects
    # are loose files or packed. _git_read_any tries loose then every packfile.
    # Dispatch on the backend set by sit_repo_open's _detect_repo_backend.
    # SIT mode (default) is unchanged.
    #
    # 1.6.4 (D8): the gate below now covers this branch too, at the backend's
    # width (40 or 64). git mode returned before it, so a hostile `.git/` whose
    # tree header was `../../outside/evil` made _git_read_any open and inflate
    # a path outside .git/objects — the S-25 "single check covers every one of
    # them" claim did not hold in git mode.
    if (_repo_backend == 1) {
        if (hex_prefix_valid(hex, _id_hexlen()) == 0) { return 0 - 1; }
        return _git_read_any(hex, out);
    }

    # S-25: gate the object id HERE, at the choke point.
    #
    # The 64 bytes below are memcpy'd verbatim into a patra SQL string literal,
    # and `hex` reaches this function from a dozen places — commit `tree` /
    # `parent` header fields, tree entry hashes, ref files, the reflog, wire
    # responses — several of which had no gate of their own. A single check here
    # covers every one of them and is the same defence `resolve_hash` and the
    # serve endpoints already apply individually.
    #
    # It also bounds the read: the memcpy takes 64 bytes unconditionally, so a
    # shorter string was an out-of-bounds read. hex_prefix_valid stops at the
    # first non-hex byte, and a NUL terminator is not a hex digit.
    if (hex_prefix_valid(hex, 64) == 0) { return 0 - 1; }

    var db = get_object_db();
    if (db == 0) { return 0 - 1; }

    # 1.10.0: packs first when there are any. After a gc nearly every object is
    # packed, and an index probe in a mapped .idx is cheaper than the row miss.
    if (sit_pack_count(0) > 0) {
        if (sit_pack_read(0, hex, out) == 0) { return 0; }
    }
    return db_row_read(db, hex, out);
}

# read_object's row half: the loose object `hex` (already validated) from the
# patra store `db`, inflated. Same contract and return codes as read_object;
# fsck calls it directly to check rows apart from packs.
fn db_row_read(db, hex, out) {
    # S-24: SQL string via fl_alloc + fl_free; freed before any non-trivial
    # work below so we don't hold both the buffer and the result-set.
    var sql = fl_alloc(128);
    memcpy(sql, "SELECT content FROM objects WHERE hash = '", 42);
    memcpy(sql + 42, hex, 64);
    memcpy(sql + 42 + 64, "'", 1);
    store8(sql + 42 + 64 + 1, 0);

    var rs = patra_query(db, sql);
    fl_free(sql);
    if (rs == 0) { return 0 - 2; }
    if (patra_result_count(rs) == 0) {
        patra_result_free(rs);
        return 0 - 3;
    }

    var blen = patra_result_get_bytes_len(rs, 0, 0);
    if (blen <= 0) {
        patra_result_free(rs);
        return 0 - 4;
    }

    var compressed = fl_alloc(blen);
    if (compressed == 0) {
        patra_result_free(rs);
        return 0 - 6;
    }
    if (patra_result_read_bytes(db, rs, 0, 0, compressed) != 0) {
        fl_free(compressed);
        patra_result_free(rs);
        return 0 - 5;
    }
    patra_result_free(rs);

    # 1.7.6 (R10): obj_inflate_fl — freelist, sized from the header; the
    # compressed copy is freed rather than kept on the bump heap per read.
    var ir = obj_inflate_fl(compressed, blen, out);
    fl_free(compressed);
    if (ir == 0 - 2) { return 0 - 6; }
    if (ir == 0 - 3) { return 0 - 7; }
    if (ir != 0) { return 0 - 8; }
    return 0;
}

# Frame `<type> <len>\0<content>`, hash it, compress and store it; returns the 64-hex id or 0.
fn write_typed_object(type_str, type_len, content, content_len) {
    # 1.12.2 (L10): both working buffers on the freelist, freed before return.
    # They were bump-allocated and kept, about twice each object's size, so
    # `sit add` of forty 15 MB files peaked at 1.8 GB.
    var hdr_max = 32;
    var full_cap = hdr_max + content_len;
    var full = fl_alloc(full_cap);
    if (full == 0) { return 0; }
    memcpy(full, type_str, type_len);
    store8(full + type_len, 32);
    var digits = write_decimal(full + type_len + 1, content_len);
    store8(full + type_len + 1 + digits, 0);
    var hdr_len = type_len + 1 + digits + 1;
    memcpy(full + hdr_len, content, content_len);
    var full_len = hdr_len + content_len;

    var hex = hash_data(full, full_len);

    var out_cap = full_len + 64 + full_len / 10;
    if (out_cap < 128) { out_cap = 128; }
    var compressed = fl_alloc(out_cap);
    if (compressed == 0) { fl_free(full); return 0; }
    var clen = zlib_compress(full, full_len, compressed, out_cap);
    fl_free(full);
    var r = 0;
    if (clen > 0) { r = _write_object_row(type_str, type_len, hex, compressed, clen); }
    fl_free(compressed);
    return r;
}

# Store the compressed object `hex` as a row unless the store has it already
# (packed, or a row). Returns `hex`, or 0 when the insert was refused.
fn _write_object_row(type_str, type_len, hex, compressed, clen) {
    var db = get_object_db();
    if (db == 0) { return 0; }

    # Content-addressed — skip if hash already present: packed (1.10.0), or a row.
    if (sit_pack_has(0, hex) == 1) { return hex; }
    # S-24: SQL on the freelist; freed before the insert path runs.
    var check_sql = fl_alloc(128);
    memcpy(check_sql, "SELECT hash FROM objects WHERE hash = '", 39);
    memcpy(check_sql + 39, hex, 64);
    memcpy(check_sql + 39 + 64, "'", 1);
    store8(check_sql + 39 + 64 + 1, 0);
    var rs = patra_query(db, check_sql);
    fl_free(check_sql);
    var exists = 0;
    if (rs != 0) {
        if (patra_result_count(rs) > 0) { exists = 1; }
        patra_result_free(rs);
    }

    if (exists == 0) {
        var type_code = type_code_of(type_str, type_len);
        var types[24];
        store64(&types + 0, 1);
        store64(&types + 8, 0);
        store64(&types + 16, 2);
        var ivals[24];
        store64(&ivals + 8, type_code);
        var sptrs[24];
        store64(&sptrs + 0, hex);
        var slens[24];
        store64(&slens + 0, 64);
        var bptrs[24];
        store64(&bptrs + 16, compressed);
        var blens[24];
        store64(&blens + 16, clen);
        # 1.7.1: a refused insert is a failure, not a stored object. Handing
        # back the hash anyway let add / commit record an id that was never
        # written. Since patra 1.16.2 a failed fdatasync also lands here.
        if (patra_insert_row(db, "objects", 7, 3,
            &types, &ivals, &sptrs, &slens, &bptrs, &blens) != PATRA_OK) { return 0; }
    }
    return hex;
}

# write_typed_object for a blob.
fn write_blob_object(content, content_len) {
    return write_typed_object("blob", 4, content, content_len);
}

# Shared front half of cat-file / owl-file: detect the backend, resolve argv[2]'s prefix, read the object.
fn resolve_and_read(obj_out, hex_out) {
    # Backend detection (roadmap 1.2.0): read verbs work on a native .sit/ or an
    # existing .git/ repo; sets the process-global backend that read_object /
    # resolve_hash dispatch on. Non-repos still error as before.
    if (_detect_repo_backend() < 0) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    var prefix = argv_heap(2);
    var rr = resolve_hash(prefix, hex_out);
    if (rr == 0 - 2) { eprintln("sit: hash prefix too short (min 4 chars)"); return 1; }
    if (rr == 0 - 1) { eprintln("sit: ambiguous hash prefix"); return 1; }
    if (rr == 0)     { eprintln("sit: no object matches"); return 1; }

    var er = read_object(hex_out, obj_out);
    if (er != 0) {
        eprintln("sit: cannot read object (corrupt or missing)");
        return 1;
    }
    return 0;
}

# `sit cat-file <hash>` — write an object's content to stdout (plumbing; .sit/ or .git/).
fn cmd_cat_file() {
    if (argc() < 3) {
        eprintln("usage: sit cat-file <hash>");
        return 1;
    }

    var hex[72];
    var obj[24];
    var r = resolve_and_read(&obj, &hex);
    if (r != 0) { return r; }

    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    stdout_write(buf + coff, blen - coff);
    return 0;
}

# Locate the owl binary. Priority: SIT_OWL env var (explicit override) →
# /usr/local/bin/owl → /usr/bin/owl → /opt/owl/bin/owl. Returns a C-string
# path or 0 if not found. S-09: each candidate is lstat-checked; symlinks
# are accepted (owl is usually installed this way via package managers)
# but anything in a world-writable directory is logged and rejected.
#
# Writable-dir detection is coarse today — we only check the candidate path
# lstat mode, not the directory's perms up the chain. That's a best-effort
# defense-in-depth; a properly locked-down system has /usr/bin etc. already
# root-owned 0755.
fn find_owl() {
    var env_owl = getenv("SIT_OWL");
    if (env_owl != 0) {
        if (file_exists(env_owl) == 1) { return env_owl; }
        eprintln("sit: SIT_OWL points at a nonexistent file — falling back to system paths");
    }
    if (file_exists("/usr/local/bin/owl") == 1) { return "/usr/local/bin/owl"; }
    if (file_exists("/usr/bin/owl") == 1)       { return "/usr/bin/owl"; }
    if (file_exists("/opt/owl/bin/owl") == 1)   { return "/opt/owl/bin/owl"; }
    return 0;
}

# `sit owl-file <hash>` — view an object through owl, falling back to raw content if owl is absent.
fn cmd_owl_file() {
    if (argc() < 3) {
        eprintln("usage: sit owl-file <hash>");
        return 1;
    }

    var hex[72];
    var obj[24];
    var r = resolve_and_read(&obj, &hex);
    if (r != 0) { return r; }

    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var content = buf + coff;
    var content_len = blen - coff;

    # S-10: write content to $XDG_RUNTIME_DIR (or $HOME/.cache/sit as fallback)
    # with O_CREAT | O_EXCL | O_WRONLY and mode 0600, so we can't be tricked
    # into writing through an attacker-planted symlink at /tmp and other local
    # users can't read the blob.
    var xdg = getenv("XDG_RUNTIME_DIR");
    var home = getenv("HOME");
    var dir_base = 0;
    if (xdg != 0) { dir_base = xdg; }
    else {
        if (home != 0) {
            var hlen = strlen(home);
            var cache = alloc_or_die(hlen + 12);
            memcpy(cache, home, hlen);
            memcpy(cache + hlen, "/.cache/sit", 11);
            store8(cache + hlen + 11, 0);
            var parent = alloc_or_die(hlen + 8);
            memcpy(parent, home, hlen);
            memcpy(parent + hlen, "/.cache", 7);
            store8(parent + hlen + 7, 0);
            ensure_dir(parent);
            ensure_dir(cache);
            dir_base = cache;
        }
        else {
            dir_base = "/tmp";
        }
    }
    var db_len = strlen(dir_base);
    var tmppath = alloc_or_die(db_len + 32);
    memcpy(tmppath, dir_base, db_len);
    memcpy(tmppath + db_len, "/sit-owl-", 9);
    memcpy(tmppath + db_len + 9, &hex, 12);
    store8(tmppath + db_len + 9 + 12, 0);

    # O_WRONLY | O_CREAT | O_EXCL = 1 | 64 | 128 = 193. Mode 0o600 = 0x180.
    # O_EXCL refuses to follow a pre-existing symlink and refuses EEXIST,
    # closing the TOCTOU window. file_open (io.cyr) is the length-carrying
    # bridge — sys_open(tmppath, 193, 0x180) verbatim on Linux/macOS; on agnos
    # it strlen()s the path and maps to AO_* (O_EXCL unavailable there).
    var tfd = file_open(tmppath, 193, 0x180);
    if (tfd < 0) {
        eprintln("sit: cannot create tempfile");
        return 1;
    }
    if (syscall(SYS_WRITE, tfd, content, content_len) < 0) {
        sys_close(tfd);
        # S-16: best-effort tempfile cleanup. Tempfiles live in
        # $XDG_RUNTIME_DIR/sit/ so a leak gets reaped eventually; a stderr
        # warning makes it loud rather than silent.
        if (xunlink(tmppath) != 0) {
            eprintln("sit: warning: failed to remove owl tempfile after write error");
        }
        eprintln("sit: cannot write tempfile");
        return 1;
    }
    sys_close(tfd);

    var owl = find_owl();
    if (owl == 0) {
        eprintln("sit: owl not installed — emitting raw content");
        eprintln("sit:   (owl is pre-1.0; https://github.com/MacCracken/owl)");
        stdout_write(content, content_len);
        if (xunlink(tmppath) != 0) {
            eprintln("sit: warning: failed to remove owl tempfile");
        }
        return 0;
    }

    var args = vec_new();
    vec_push(args, owl);
    vec_push(args, tmppath);
    var rc = exec_vec(args);
    if (xunlink(tmppath) != 0) {
        eprintln("sit: warning: failed to remove owl tempfile after exec");
    }
    return rc;
}

# Type codes stored in the objects.type INT column.
fn type_code_of(type_str, type_len) {
    if (type_len == 4) {
        if (memeq(type_str, "blob", 4) == 1) { return 0; }
        if (memeq(type_str, "tree", 4) == 1) { return 1; }
    }
    if (type_len == 6) {
        if (memeq(type_str, "commit", 6) == 1) { return 2; }
    }
    if (type_len == 3) {
        if (memeq(type_str, "tag", 3) == 1) { return 3; }
    }
    return 0 - 1;
}

# Open (or create) the patra-backed object store. Returns db handle, or 0.
# Used by the wire protocol when it needs an explicit handle (push/fetch
# open both ends with named locals); hot read paths should go through
# get_object_db() instead.
# P-11a: the `objects` table carries a B-tree index on `hash`.
#
# Without one, patra's `_patra_query_exec` cannot take its indexed-WHERE path and
# falls back to a FULL TABLE SCAN — so every `read_object`, `db_object_has` and
# `resolve_hash` was O(rows). Measured before this landed, with an identical 50
# commit reads and only the table size varying:
#
#     ~300 objects  -> log -n 50 : 14, 15, 15 ms
#     ~1200 objects -> log -n 50 : 44, 43, 45 ms
#
# 4x the table for 3x the time on the same work — the signature of a scan. It made
# `log` / `status` / `diff` / `clone` quadratic in repository size, which the
# 100-commit benchmark fixture understates badly.
#
# The index is ALSO the precondition for `patra_insert_row_or_ignore`: its
# conflict probe needs `SCH_IDX_ROOT`, and with no index it silently falls
# through and always inserts. Wiring or-ignore without this would have written
# duplicate rows rather than deduping.
#
# `CREATE INDEX` rebuilds the tree over every existing row, so it must run ONCE,
# not per open. `.sit/objects.indexed` is the marker; it is written only after a
# successful build, so an interrupted migration simply retries next open. Fresh
# repos build an empty tree (free); pre-1.4.1 repos pay one rebuild on first open.
fn _ensure_object_index(db) {
    if (sf_exists(".sit/objects.indexed") == 1) { return 0; }
    if (patra_exec(db, "CREATE INDEX ON objects (hash)") != 0) { return 0 - 1; }
    if (sf_write_atomic(".sit/objects.indexed", "1\n", 2) < 0) { return 0 - 1; }
    return 0;
}

# Open (creating if needed) .sit/objects.patra with its objects table and hash index.
fn object_db_open() {
    # 1.7.2: patra_init reports a refused allocation since patra 1.16.1.
    if (patra_init() != PATRA_OK) { return 0; }
    var db = sf_patra_open(".sit/objects.patra");
    if (db == 0) { return 0; }
    patra_exec(db, "CREATE TABLE objects (hash STR, ty INT, content BYTES)");
    _ensure_object_index(db);
    return db;
}

# v0.6.4: process-wide cached handle for .sit/objects.patra. Collapses
# P-01/02/05/08/12/25 — every read_object / write_typed_object /
# resolve_hash previously did patra_init + patra_open + CREATE TABLE +
# loose-migration check + patra_close on every call. With the cache:
# first call opens + migrates once; subsequent calls reuse the handle;
# fd dies with the process (patra_close just frees in-process buffers
# and closes the fd — no WAL flush — so skipping it at exit is safe).
var _object_db_cached = 0;

# ── Store lock (1.10.0) ────────────────────────────────────────────
#
# `sit gc` replaces `.sit/objects.patra` and deletes packs, so it must run with
# no other process holding the store open: one that opened the old file would
# go on writing into a file nothing reads any more, and lose those objects.
# Every process that opens a store first takes a shared flock on
# `<repo>/.sit/objects.flock` and holds it until it exits; gc takes it exclusive
# and refuses when it cannot. A command started while gc runs waits for it, then
# opens the store gc left. See ADR 0016 and architecture 008.
#
# The file is only ever locked, never written, so it is opened read-only, and
# created O_CREAT|O_EXCL, which refuses a symlink planted at the path. Where it
# cannot be opened (a read-only repository) the store opens unlocked: nothing
# in that process can write it, and gc cannot run there either. agnos has only
# non-blocking flock, so there a command does not wait for gc (accepted, as for
# its other locks).

var _store_lock_fd = 0 - 1;     # this repository's lock file, once opened
var _store_lock_held = 0;       # 0 not held, 1 shared, 2 exclusive (gc)
# The device and inode of the objects.patra the cached handle has open
# (1.11.0): a store session that finds another file there knows a gc replaced it.
var _store_id_a = 0;
var _store_id_b = 0;

# O_CLOEXEC where the target has it: a child (an editor, ssh, owl) must not
# inherit the lock and hold off gc after sit has exited.
fn _store_lock_cloexec() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return O_CLOEXEC;
    #endif
}

# O_NONBLOCK where the target names it (agnos's stdlib does not, and has no
# FIFOs to guard against).
fn _store_lock_nonblock() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return O_NONBLOCK;
    #endif
}

# Open, creating if needed, the lock file at the resolved path `ap`: an fd, or
# -1 when it cannot be opened or is not a regular file. 1.12.2 (P5): opened
# without blocking and checked on the fd, so a FIFO swapped in after the lstat
# (in a file:// remote another user can write) is refused instead of hanging
# the open.
fn _store_lock_open(ap) {
    var kind = path_lstat_kind(ap);
    if (kind < 0) {
        var cfd = file_open(ap, O_RDONLY | O_CREAT | O_EXCL | _store_lock_cloexec(), 0x1A4);
        if (cfd >= 0) { return cfd; }
        kind = path_lstat_kind(ap);               # another process created it meanwhile
    }
    if (kind != 0x8000) { return 0 - 1; }
    var fd = file_open(ap, O_RDONLY | _store_lock_cloexec() | _store_lock_nonblock(), 0);
    if (fd < 0) { return 0 - 1; }
    var st[256];
    if (sys_fstat(fd, &st) == 0) {
        if ((load32(&st + STAT_MODE) & 0xF000) != 0x8000) {
            file_close(fd);
            return 0 - 1;
        }
    }
    return fd;
}

# How long this process waits for its own repository's shared lock while a gc
# holds it, in ms: -1 for as long as the gc runs (a command, the read API, a
# one-repository server), 0 not at all (`sit serve --repos`, whose requests
# answer 503 instead: one repository's gc stalled the whole server, 1.12.2 X6).
var _store_session_wait_ms = 0 - 1;

# How long a file:// remote's lock is waited for, in ms (1.12.2, P5): anyone who
# can read that repository can hold its lock, and the wait had no end.
var STORE_REMOTE_LOCK_WAIT_MS = 60000;

# Take `fd`'s shared lock: 0, or -1 when it was not taken within `wait_ms`
# (-1 = no limit; 0 = one try). 1.12.2 (P11): a try and 50 ms naps, not a
# blocking flock, which agnos does not have: there a command started during gc
# went on without the lock, into the store gc was about to replace.
fn _store_lock_wait_shared(fd, wait_ms) {
    if (xflock(fd, LOCK_SH | LOCK_NB) == 0) { return 0; }
    if (wait_ms == 0) { return 0 - 1; }
    eprintln("sit: waiting for `sit gc` to finish with the object store");
    var waited = 0;
    var got = 0;
    var going = 1;
    while (going == 1) {
        sleep_ms(50);
        waited = waited + 50;
        if (xflock(fd, LOCK_SH | LOCK_NB) == 0) { got = 1; going = 0; }
        else {
            if (wait_ms > 0) {
                if (waited >= wait_ms) { going = 0; }
            }
        }
    }
    if (got == 1) { return 0; }
    return 0 - 1;
}

# Take the shared store lock of the repository at `root` (0 = this one). A
# command keeps it for the life of the process; a store session (below) gives
# this repository's back between requests. Returns the fd, -1 when there is no
# lock to take (the store is used unlocked, as architecture 008 says), or -2
# when a gc (or another holder) kept it past the wait.
fn store_lock_shared(root) {
    if (root == 0) {
        if (_store_lock_held != 0) { return _store_lock_fd; }
        if (_store_lock_fd < 0) {
            # Retried per request where it cannot be opened, so on the stack.
            if (_sf_parent_symlink(".sit/objects.flock") == 1) { return 0 - 1; }
            var lb[4352];
            var lp = sit_abs_into(".sit/objects.flock", &lb, 4352);
            if (lp == 0) { return 0 - 1; }
            _store_lock_fd = _store_lock_open(lp);
            if (_store_lock_fd < 0) { return 0 - 1; }
        }
        if (_store_lock_wait_shared(_store_lock_fd, _store_session_wait_ms) != 0) { return 0 - 2; }
        _store_lock_held = 1;
        return _store_lock_fd;
    }
    var rl = strlen(root);
    var ap = alloc_or_die(rl + 20);
    memcpy(ap, root, rl);
    memcpy(ap + rl, "/.sit/objects.flock", 19);
    store8(ap + rl + 19, 0);
    var fd = _store_lock_open(ap);
    if (fd < 0) { return 0 - 1; }
    if (_store_lock_wait_shared(fd, STORE_REMOTE_LOCK_WAIT_MS) != 0) {
        file_close(fd);
        return 0 - 2;
    }
    return fd;
}

# Take this repository's store lock exclusively, without waiting: 0, -1 when
# another process holds the store open, -2 when there is no lock file to take
# (the repository is read-only, or .sit/ is not a plain directory). For gc,
# before anything in the process opens the store.
fn store_lock_exclusive() {
    if (_store_lock_held != 0) { return 0 - 1; }
    if (_store_lock_fd < 0) {
        if (_sf_parent_symlink(".sit/objects.flock") == 1) { return 0 - 2; }
        _store_lock_fd = _store_lock_open(sit_abs(".sit/objects.flock"));
        if (_store_lock_fd < 0) { return 0 - 2; }
    }
    if (file_trylock(_store_lock_fd) != 0) { return 0 - 1; }
    _store_lock_held = 2;
    return 0;
}

# ── Store sessions (1.11.0) ────────────────────────────────────────
#
# A long-lived process — `sit serve`, or owl / thoth through the read API —
# held the shared lock from its first read until it exited, so `sit gc` refused
# for as long as it ran. Such a process now brackets each stretch of store use
# (a request, an API call) with store_enter / store_leave and holds the lock
# only inside them. Between them a gc may replace objects.patra and its packs,
# so store_enter compares the store file's device and inode with the ones the
# cached handle opened; on a difference it drops the handle, the pack list and
# the mappings of packs that are gone, and the next read opens what gc left.
# A command (one process per command) never leaves: it keeps the lock to exit.
# See architecture 008.

# The device and inode of this repository's objects.patra, at out16. 0, or -1.
# Linux keeps st_dev at offset 0 and st_ino at 8 on both architectures (and
# macOS, st_ino at 8); agnos declares STAT_INO.
fn _store_file_id(out16) {
    var pb[4352];
    var ap = sit_abs_into(".sit/objects.patra", &pb, 4352);   # per request: nothing kept
    if (ap == 0) { return 0 - 1; }
    return path_file_id(ap, out16);
}

# Close the cached store handle and forget what came from it: the pack lists,
# and the mappings of pack files that no longer exist (git_pack.cyr).
fn store_drop() {
    if (_object_db_cached != 0) {
        patra_close(_object_db_cached);
        _object_db_cached = 0;
    }
    sit_packs_reset();
    _git_file_forget_missing();
    return 0;
}

# Begin a stretch of store use (see above): take the shared lock, and drop the
# cached handle when gc has replaced the file it has open.
#
# 1.12.2 (S1 / P2): the comparison runs on every session, against the store file
# seen at the last one, not only while a handle is open. Under --repos a
# repository evicted from the 64 came back with no handle and its old pack
# list, so after a gc its packed objects answered 404 until the server
# restarted. A store file that is not there yet reads as {0, 0}.
fn store_enter() {
    if (store_lock_shared(0) == 0 - 2) { return 0 - 1; }
    var id[16];
    store64(&id, 0);
    store64(&id + 8, 0);
    _store_file_id(&id);
    var same = 0;
    if (load64(&id) == _store_id_a) {
        if (load64(&id + 8) == _store_id_b) { same = 1; }
    }
    if (same == 0) {
        if (_object_db_cached != 0) {
            patra_close(_object_db_cached);
            _object_db_cached = 0;
        }
        sit_packs_forget(0);
        _git_file_forget_missing();
        _store_id_a = load64(&id);
        _store_id_b = load64(&id + 8);
    }
    return 0;
}

# End a stretch of store use: give the shared lock back, so a gc can run.
fn store_leave() {
    if (_store_lock_held == 1) {
        xflock(_store_lock_fd, LOCK_UN);
        _store_lock_held = 0;
    }
    return 0;
}

# Forget everything held for the open repository's store — the handle, the
# lock, the pack lists — before another repository is opened in this process
# (sit_repo_open; 1.11.0, R6). The stale handle answered for the new repository.
fn store_repo_reset() {
    store_drop();
    if (_store_lock_fd >= 0) {
        file_close(_store_lock_fd);
        _store_lock_fd = 0 - 1;
    }
    _store_lock_held = 0;
    _store_id_a = 0;
    _store_id_b = 0;
    return 0;
}

# A repository's store state while another is the open one (sit serve --repos,
# 1.11.0): {root, store handle, lock fd, id a, id b}. store_ctx_load makes it
# the open one; store_ctx_save puts it back after the request. The lock is never
# held across a switch: the request has left by then.
var STORE_CTX = 40;

# A fresh store state for the repository at `root` (a heap cstring kept with it).
fn store_ctx_new(root) {
    var c = alloc_or_die(STORE_CTX);
    store64(c, root);
    store64(c + 8, 0);
    store64(c + 16, 0 - 1);
    store64(c + 24, 0);
    store64(c + 32, 0);
    return c;
}

# Make the store state `c` the open repository's.
fn store_ctx_load(c) {
    sit_set_repo_root(load64(c));
    _object_db_cached = load64(c + 8);
    _store_lock_fd = load64(c + 16);
    _store_lock_held = 0;
    _store_id_a = load64(c + 24);
    _store_id_b = load64(c + 32);
    return 0;
}

# Keep the open repository's store state in `c` (after store_leave).
fn store_ctx_save(c) {
    store64(c + 8, _object_db_cached);
    store64(c + 16, _store_lock_fd);
    store64(c + 24, _store_id_a);
    store64(c + 32, _store_id_b);
    return 0;
}

# Close a store state for good (sit serve --repos evicting a repository).
fn store_ctx_close(c) {
    if (load64(c + 8) != 0) { patra_close(load64(c + 8)); }
    if (load64(c + 16) >= 0) { file_close(load64(c + 16)); }
    store64(c + 8, 0);
    store64(c + 16, 0 - 1);
    return 0;
}

# Stores opened from another repository (a file:// remote), and the root each
# was opened at, so the wire layer finds that store's packs from its handle.
# The local store is never listed: its root is 0.
var _store_roots = 0;

# Record that the patra handle `db` is the store of the repository at `root`.
fn store_register_root(db, root) {
    if (_store_roots == 0) { _store_roots = vec_new(); }
    var cell = alloc_or_die(16);
    store64(cell, db);
    store64(cell + 8, root);
    vec_push(_store_roots, cell);
    return 0;
}

# Forget `db` before it is closed: patra may hand the same address to the next open.
fn store_forget_root(db) {
    if (_store_roots == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_store_roots)) {
        var cell = vec_get(_store_roots, i);
        if (load64(cell) == db) { store64(cell, 0); }
        i = i + 1;
    }
    return 0;
}

# The repository root whose store `db` is: 0 for this repository's.
fn store_root_of(db) {
    if (_store_roots == 0) { return 0; }
    if (db == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_store_roots)) {
        var cell = vec_get(_store_roots, i);
        if (load64(cell) == db) { return load64(cell + 8); }
        i = i + 1;
    }
    return 0;
}

# Process-cached object DB handle; migrates loose objects into patra on first open.
fn get_object_db() {
    if (_object_db_cached != 0) { return _object_db_cached; }
    # 1.10.0: the store lock comes before the store is opened (see above).
    store_lock_shared(0);
    _object_db_cached = object_db_open();
    # 1.11.0: and which file it opened, for a store session to compare later.
    var id[16];
    store64(&id, 0);
    store64(&id + 8, 0);
    _store_file_id(&id);
    _store_id_a = load64(&id);
    _store_id_b = load64(&id + 8);
    if (_object_db_cached == 0) { return 0; }
    # v0.6.10 — investigated patra 1.8's BATCH sync mode here and reverted:
    # the cache never closes the handle (fd dies with the process, no
    # patra_close call), so BATCH-pending writes between the every-64-writes
    # auto-flush would be lost on power loss within the kernel writeback
    # window. `copy_objects` already wraps its hot loop in patra_begin /
    # patra_commit (v0.6.5 P-03), which gets the same fsync amortization on
    # the only batch-shaped write path. Stay on FULL (default) for now;  #skip-lint
    # revisit if/when sit grows explicit patra_flush() calls at command exit.
    object_db_migrate_from_loose(_object_db_cached);
    return _object_db_cached;
}

# Migrate legacy loose-file objects (under .sit/objects/<xx>/<yy...>) into
# the patra table. No-op if no legacy files present. Deletes loose files
# + empty 2-char directories as they're migrated.
fn object_db_migrate_from_loose(db) {
    if (sf_exists(".sit/objects") != 1) { return 0; }

    var dirs = sf_dir_list(str_from(".sit/objects"));
    var dn = vec_len(dirs);
    var di = 0;
    while (di < dn) {
        var s = vec_get(dirs, di);
        var sdata = str_data(s);
        var slen = str_len(s);

        if (slen == 2) {
            var sub_path = alloc_or_die(16);
            memcpy(sub_path, ".sit/objects/", 13);
            memcpy(sub_path + 13, sdata, 2);
            store8(sub_path + 15, 0);

            var files = sf_dir_list(str_from(sub_path));
            var fn_ct = vec_len(files);
            var fi = 0;
            while (fi < fn_ct) {
                var f = vec_get(files, fi);
                var fdata = str_data(f);
                var flen = str_len(f);

                if (flen == 62) {
                    var hex = alloc_or_die(65);
                    memcpy(hex, sdata, 2);
                    memcpy(hex + 2, fdata, 62);
                    store8(hex + 64, 0);

                    var loose_path = alloc_or_die(96);
                    object_path(loose_path, hex);
                    var pair[16];
                    if (read_file_heap(loose_path, &pair) == 0) {
                        var compressed = load64(&pair);
                        var clen = load64(&pair + 8);

                        # Sniff type from decompressed header for the INT column
                        # (obj_inflate_fl, 1.7.6 — freed once sniffed).
                        var sniff[24];
                        var type_code = 0;
                        if (obj_inflate_fl(compressed, clen, &sniff) == 0) {
                            var decompressed = load64(&sniff);
                            var dlen = load64(&sniff + 8);
                            if (dlen > 5) {
                                if (memeq(decompressed, "blob ", 5) == 1) { type_code = 0; }
                                else {
                                    if (memeq(decompressed, "tree ", 5) == 1) { type_code = 1; }
                                    else {
                                        if (dlen > 7) {
                                            if (memeq(decompressed, "commit ", 7) == 1) { type_code = 2; }
                                        }
                                    }
                                }
                            }
                            fl_free(decompressed);
                        }

                        var types[24];
                        store64(&types + 0, 1);
                        store64(&types + 8, 0);
                        store64(&types + 16, 2);
                        var ivals[24];
                        store64(&ivals + 8, type_code);
                        var sptrs[24];
                        store64(&sptrs + 0, hex);
                        var slens[24];
                        store64(&slens + 0, 64);
                        var bptrs[24];
                        store64(&bptrs + 16, compressed);
                        var blens[24];
                        store64(&blens + 16, clen);
                        # 1.7.1: unlink only what the table now holds. A
                        # refused insert keeps the loose file for the next open;
                        # or-ignore makes that retry skip a row that did land.
                        if (patra_insert_row_or_ignore(db, "objects", 7, 3,
                            &types, &ivals, &sptrs, &slens, &bptrs, &blens) == PATRA_OK) {
                            sf_unlink(loose_path);
                        }
                    }
                }
                fi = fi + 1;
            }
            sf_rmdir(sub_path);
        }
        di = di + 1;
    }
    return 0;
}

# Read a ref tip file (heads/tags/remotes leaf) — trim trailing CR/LF,
# validate 64-hex, return a heap-allocated 65-byte cstring or 0 on
# malformed content. Caller does not free (bump-allocated for the life
# of the fsck pass).
fn fsck_read_ref_tip(path) {
    var pair[16];
    if (read_file_heap(path, &pair) != 0) {
        if (path_lstat_kind(sit_abs(path)) >= 0) { _fsck_unread(path); }
        return 0;
    }
    var data = load64(&pair);
    var len = load64(&pair + 8);
    # Trim trailing CR/LF (cyrius `break` in while-with-var is unreliable,
    # so use a flag).
    var trimming = 1;
    while (trimming == 1) {
        if (len == 0) { trimming = 0; }
        else {
            var lc = load8(data + len - 1) & 0xFF;
            if (lc == 10) { len = len - 1; }
            else {
                if (lc == 13) { len = len - 1; }
                else { trimming = 0; }
            }
        }
    }
    # 1.6.4 (D9): accept exactly what the ref resolver accepts (refs.cyr: the
    # first 64 bytes hex, whatever follows). Requiring exactly 64 bytes made a
    # ref with a trailing space or a comment usable by every command yet NOT an
    # fsck root, so with no reflog behind it `--prune-now` deleted the branch.
    # A root that is too generous only keeps objects; a strict one loses them.
    if (len < 64) { return 0; }
    if (hex_prefix_valid(data, 64) == 0) { return 0; }
    var out = alloc(65);
    memcpy(out, data, 64);
    store8(out + 64, 0);
    return out;
}

# Walk one refs subtree (`.sit/refs/heads` etc.) and push every valid
# tip hex into `roots`. Missing dir is a no-op. Malformed ref files are
# silently skipped — the integrity pass surfaces unreachable objects,
# and a broken ref shows up there as a dangling chain.
fn fsck_walk_refs_dir(dir, roots) {
    var ad = sit_abs(dir);                      # abs: cwd-independent (fsck off-cwd / agnos)
    if (path_lstat_kind(ad) < 0) { return 0; }
    var files = vec_new();
    _fsck_walk_files(ad, files, 0);
    var i = 0;
    while (i < vec_len(files)) {
        var hex = fsck_read_ref_tip(vec_get(files, i));
        if (hex != 0) { vec_push(roots, hex); }
        i = i + 1;
    }
    return 0;
}

# Refs, refs directories and logs that exist but could not be read while the
# roots were collected (1.12.2, L2 / L5). Each one names objects the walk then
# cannot protect, so `fsck --prune` refuses while it is non-zero. Before, an
# unreadable branch, stash or reflog read as absent, and `--prune-now` deleted
# what it named with exit 0 (the architecture 007 rule: existence is lstat's).
var _fsck_roots_unread = 0;

# Count `path` as a root that exists but cannot be read, and say so.
fn _fsck_unread(path) {
    _fsck_roots_unread = _fsck_roots_unread + 1;
    eprint3("sit: warning: cannot read ", path, "; the objects it names are not counted as reachable\n");
    return 0;
}

# 1 when the directory at `ap` (absolute) can be listed. A read-only open answers
# it on Linux. agnos routes a directory open by its own flag, so there the probe
# is skipped and an unreadable subtree goes unnoticed, as it did before.
fn _fsck_dir_readable(ap) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0; }
    file_close(fd);
    return 1;
    #endif
}

# Push every file under the directory `ap` (absolute) onto `out` as a heap
# cstring, as dir_walk does, but count a directory that cannot be listed (or a
# tree deeper than 64) with _fsck_unread: dir_walk skipped one in silence.
# Uses only stdlib API the consumers' older toolchains have (dir_walk_checked
# arrived in cyrius 6.6.10).
fn _fsck_walk_files(ap, out, depth) {
    if (depth > 64) { _fsck_unread(ap); return 0; }
    # A directory, by lstat, before anything opens it: a FIFO at .sit/refs/heads
    # (or a link there) hung the walk in open(2) (K9).
    if (path_lstat_kind(ap) != 0x4000) { _fsck_unread(ap); return 0; }
    if (_fsck_dir_readable(ap) == 0) { _fsck_unread(ap); return 0; }
    var names = dir_list(str_from(ap));
    var al = strlen(ap);
    var i = 0;
    while (i < vec_len(names)) {
        var nm = vec_get(names, i);
        var nl = str_len(nm);
        var child = alloc(al + nl + 2);
        memcpy(child, ap, al);
        store8(child + al, 47);
        memcpy(child + al + 1, str_data(nm), nl);
        store8(child + al + 1 + nl, 0);
        var k = path_lstat_kind(child);
        if (k == 0x4000) { _fsck_walk_files(child, out, depth + 1); }
        else {
            if (k >= 0) { vec_push(out, child); }
        }
        i = i + 1;
    }
    return 0;
}

# Collect every reachability root from the on-disk refs:
#   .sit/refs/heads/<*>, .sit/refs/tags/<*>, .sit/refs/remotes/<*>/<*>
# plus .sit/HEAD when it's a raw hex (detached) rather than symbolic.
# Symbolic HEAD targets are already covered by the matching ref file.
# Add every reflog entry's old+new oid (across all .sit/logs/** files) to
# `roots`. This is the reflog-reachability half of the v1.1.0 prune grace:
# an object referenced by any reflog entry is reachable, so `fsck --prune`
# won't drop the very commits the reflog exists to recover (e.g. the tip a
# `reset --hard` discarded). Mirrors git fsck's default reflog-as-roots.
fn fsck_collect_reflog_roots(roots) {
    var ad = sit_abs(".sit/logs");                     # abs: cwd-independent
    if (path_lstat_kind(ad) < 0) { return 0; }
    var files = vec_new();
    _fsck_walk_files(ad, files, 0);
    var i = 0;
    while (i < vec_len(files)) {
        var fc = vec_get(files, i);
        var pair[16];
        if (read_file_heap(fc, &pair) == 0) {
            _reflog_collect_oids(load64(&pair), load64(&pair + 8), roots);
        }
        else { _fsck_unread(fc); }      # unreadable, or past read_file_heap's 64 MiB (L5)
        i = i + 1;
    }
    return 0;
}

# Collect ONLY the refs/HEAD roots (heads, tags, remotes, detached HEAD).
# Reflog roots are collected separately by cmd_fsck via
# fsck_collect_reflog_roots so the "every object unreachable" prune tripwire
# can judge corruption from the refs set alone — a stale reflog must not mask
# a wiped HEAD/refs and let --prune delete a ref-only-reachable branch.
fn fsck_collect_roots() {
    var roots = vec_new();
    fsck_walk_refs_dir(".sit/refs/heads",   roots);
    fsck_walk_refs_dir(".sit/refs/tags",    roots);
    fsck_walk_refs_dir(".sit/refs/remotes", roots);

    # v1.5.1: .sit/refs/stash is a root. It is a single ref file rather than a
    # directory, so the refs-dir walk above never sees it — and without this
    # every stashed blob and tree reads as dangling and `fsck --prune-now`
    # DELETES the stash. Same class as the 1.5.0 tag-object bug and the S-27
    # missing-referent bug: the walk not knowing about an edge.
    if (path_lstat_kind(sit_abs(".sit/refs/stash")) >= 0) {
        var spair[16];
        if (read_file_heap(".sit/refs/stash", &spair) != 0) { _fsck_unread(".sit/refs/stash"); }
        else {
            var sdata = load64(&spair);
            var slen = load64(&spair + 8);
            if (slen >= 64) {
                if (hex_prefix_valid(sdata, 64) == 1) {
                    var shex = alloc(65);
                    memcpy(shex, sdata, 64);
                    store8(shex + 64, 0);
                    vec_push(roots, shex);
                }
            }
        }
    }

    if (sf_exists(".sit/HEAD") == 1) {
        var pair[16];
        if (read_file_heap(".sit/HEAD", &pair) == 0) {
            var data = load64(&pair);
            var len = load64(&pair + 8);
            var trimming = 1;
            while (trimming == 1) {
                if (len == 0) { trimming = 0; }
                else {
                    var lc = load8(data + len - 1) & 0xFF;
                    if (lc == 10) { len = len - 1; }
                    else {
                        if (lc == 13) { len = len - 1; }
                        else { trimming = 0; }
                    }
                }
            }
            if (len == 64) {
                if (hex_prefix_valid(data, 64) == 1) {
                    var hex = alloc(65);
                    memcpy(hex, data, 64);
                    store8(hex + 64, 0);
                    vec_push(roots, hex);
                }
            }
        }
    }
    return roots;
}

# Extract every `parent <hex>\n` from a commit body and push each as a
# fresh 65-byte cstring into `parents`. Distinct from parse_commit_body,
# which captures only the LAST parent line (merge commits have two);
# reachability MUST follow both legs or merged-only objects appear
# dangling. Stops at the first blank line (end of headers).
fn fsck_collect_commit_parents(body, body_len, parents) {
    var pos = 0;
    var done = 0;
    while (done == 0) {
        if (pos >= body_len) { done = 1; }
        else {
            # Find end of current line (cyrius `break` in while-with-var
            # is unreliable, so use a flag).
            var le = pos;
            var scanning = 1;
            while (scanning == 1) {
                if (le >= body_len) { scanning = 0; }
                else {
                    if (load8(body + le) == 10) { scanning = 0; }
                    else { le = le + 1; }
                }
            }
            var line_len = le - pos;
            if (line_len == 0) { done = 1; }
            else {
                if (line_len >= 71) {
                    if (memeq(body + pos, "parent ", 7) == 1) {
                        if (hex_prefix_valid(body + pos + 7, 64) == 1) {
                            var p = alloc(65);
                            memcpy(p, body + pos + 7, 64);
                            store8(p + 64, 0);
                            vec_push(parents, p);
                        }
                    }
                }
                pos = le + 1;
            }
        }
    }
    return 0;
}

# Extract `tree <hex>\n` from a commit body. Returns a heap-allocated
# 65-byte hex cstring, or 0 if absent / malformed. Looks at the first
# line only — git always emits `tree` as the very first header.
fn fsck_extract_commit_tree(body, body_len) {
    # 1.6.4 (D4): the SAME header parser log, show, checkout and the wire walk
    # use. This accepted `tree` only on the first line while parse_commit_body
    # takes it from any header line, so a commit with `parent` first (a hostile
    # fetch or push could deliver one) was fully usable everywhere — yet fsck
    # never walked its tree, and `--prune-now` deleted it.
    var info[56];
    if (parse_commit_body(body, body_len, &info) != 0) { return 0; }
    var t = load64(&info);
    if (t == 0) { return 0; }
    if (hex_prefix_valid(t, 64) == 0) { return 0; }
    return t;
}

# Reachability walker for fsck. BFS from `root` over the object graph,
# marking each visited hex in `seen` (map_new, cstr-keyed). Commits
# enqueue their tree + every parent hex; trees enqueue every entry
# (sub-trees and blobs); blobs are leaves. Missing / unreadable objects
# get marked in `seen` so we don't loop, but no children are enqueued.
# Type detection is by framing prefix ("blob "/"tree "/"commit ").
#
# Distinct from `walk_reachable_phased` in src/wire.cyr: that walker
# only follows the first parse_commit_body-captured parent (which is
# actually the LAST parent line in the body — a pre-existing limitation
# that doesn't show up in CI because the fixtures are linear).
# Reachability must traverse every parent edge or merge-only objects
# look dangling.
# S-27: referents the reachability walk could not resolve.
#
# `fsck` enumerated only objects that are IN the store, flagging those it could
# not read as `unreadable`. An object that is simply ABSENT — a commit whose
# `parent` or `tree` names an oid the store does not contain — was never
# enumerated at all, and the walk below silently skipped what it could not read.
# So the canonical broken-repo shape reported `0 bad, 0 dangling`. That is the
# single most useful thing fsck can tell you, and sit did not say it.
#
# These record every hex whose read failed during the walk. `cmd_fsck` then
# splits them: already in the store => the integrity pass has already reported
# it `unreadable` (do not double-count); not in the store => report `missing`,
# which is what git calls it, and count it toward `bad`.
var _fsck_missing = 0;
var _fsck_missing_seen = 0;

# Shallow-clone boundary set: the commits in `.sit/shallow` whose parents were
# deliberately NOT fetched (v0.8.12 `clone --depth`). Defined here rather than in
# commit.cyr because `object_db.cyr` precedes it in the include chain and the
# dist bundle is single-pass — fsck needs it, and cmd_log (later) reuses it.
#
# S-27: this is why `missing` detection cannot simply flag every unresolvable
# referent. A shallow clone's boundary parents are absent BY DESIGN, and the
# integration suite already asserted `--depth 1` fscks clean — it caught the
# first cut of this change immediately. git draws the same distinction via
# `.git/shallow`.
fn load_shallow_set() {
    var shallow = map_new();
    if (sf_exists(".sit/shallow") == 1) {
        var spair[16];
        if (read_file_heap(".sit/shallow", &spair) == 0) {
            var sbuf = load64(&spair);
            var slen = load64(&spair + 8);
            var sp = 0;
            while (sp + 64 <= slen) {
                var hh = alloc_or_die(65);
                memcpy(hh, sbuf + sp, 64);
                store8(hh + 64, 0);
                map_set(shallow, hh, 1);
                sp = sp + 65;
            }
        }
    }
    return shallow;
}

# Boundary set for the active fsck walk; 0 outside one.
var _fsck_shallow = 0;
# Oids a shallow boundary commit names as parents: walked when present, never
# reported missing when absent (D2, 1.6.4). Reset per fsck run.
var _fsck_optional = 0;

# 1.7.6 (R12): reachable commits whose headers do not parse (no `tree` on line
# 1, a second `tree`, a parent after other headers). Every reader refuses such
# a commit, and the walk cannot follow its tree — so it is corruption, counted
# toward `bad`, which also keeps `--prune` from deleting what it names.
var _fsck_malformed = 0;

# Reset fsck's missing-object list and its dedup set.
fn fsck_missing_reset() {
    _fsck_missing = vec_new();
    _fsck_missing_seen = map_new();
    _fsck_malformed = vec_new();
    return 0;
}

# Record `hex` as referenced-but-missing, once.
fn fsck_missing_record(hex) {
    if (_fsck_missing_seen == 0) { return 0; }
    if (map_has(_fsck_missing_seen, hex) == 1) { return 0; }
    map_set(_fsck_missing_seen, hex, 1);
    var copy = alloc(65);
    memcpy(copy, hex, 64);
    store8(copy + 64, 0);
    vec_push(_fsck_missing, copy);
    return 0;
}

# Objects fsck found referenced but absent.
fn fsck_missing_vec() { return _fsck_missing; }

# Mark every object reachable from `root` in `seen`, recording referenced-but-missing ones.
fn fsck_walk_reachable(root, seen) {
    var queue = vec_new();
    vec_push(queue, root);
    while (vec_len(queue) > 0) {
        var hex = vec_get(queue, vec_len(queue) - 1);
        vec_pop(queue);
        if (map_has(seen, hex) == 0) {
            map_set(seen, hex, 1);
            var obj[24];
            # One read, branched on — fsck walks the whole graph, so a second
            # probe here would double every object's DB read.
            var rc = read_object(hex, &obj);
            if (rc != 0) {
                # A shallow boundary's parent may legitimately be absent.
                var optional = 0;
                if (_fsck_optional != 0) { optional = map_has(_fsck_optional, hex); }
                if (optional == 0) { fsck_missing_record(hex); }
            }
            if (rc == 0) {
                var buf = load64(&obj);
                var blen = load64(&obj + 8);
                var coff = load64(&obj + 16);
                var body = buf + coff;
                var body_len = blen - coff;
                # Classify by framing prefix.
                if (blen >= 7) {
                    if (memeq(buf, "commit ", 7) == 1) {
                        var t = fsck_extract_commit_tree(body, body_len);
                        if (t != 0) {
                            if (map_has(seen, t) == 0) { vec_push(queue, t); }
                        }
                        else {
                            if (_fsck_malformed != 0) { vec_push(_fsck_malformed, hex); }
                        }
                        # S-27: a shallow boundary commit's parents were never
                        # fetched, so they may be absent on purpose — don't
                        # record them as missing.
                        #
                        # 1.6.4 (D2): but DO walk the ones that are present.
                        # This skipped them outright, and `fetch` on a shallow
                        # clone brings the full history in without touching
                        # .sit/shallow — so every fetched ancestor read as
                        # dangling and `--prune-now` deleted the history,
                        # which the repo then served to clones as missing.
                        var at_boundary = 0;
                        if (_fsck_shallow != 0) {
                            if (map_has(_fsck_shallow, hex) == 1) { at_boundary = 1; }
                        }
                        var parents = vec_new();
                        fsck_collect_commit_parents(body, body_len, parents);
                        var pi = 0;
                        while (pi < vec_len(parents)) {
                            var p = vec_get(parents, pi);
                            if (at_boundary == 1) {
                                if (_fsck_optional == 0) { _fsck_optional = map_new(); }
                                map_set(_fsck_optional, p, 1);
                            }
                            if (map_has(seen, p) == 0) { vec_push(queue, p); }
                            pi = pi + 1;
                        }
                    }
                }
                if (blen >= 5) {
                    if (memeq(buf, "tree ", 5) == 1) {
                        var entries = parse_tree(body, body_len);
                        var en = vec_len(entries);
                        var ei = 0;
                        while (ei < en) {
                            var e = vec_get(entries, ei);
                            var ehash = tree_entry_hash(e);
                            if (map_has(seen, ehash) == 0) {
                                var ec = alloc(65);
                                memcpy(ec, ehash, 64);
                                store8(ec + 64, 0);
                                vec_push(queue, ec);
                            }
                            ei = ei + 1;
                        }
                    }
                }
                # v1.5.0: an annotated tag object names its target in an
                # `object` header. Without this the walk treats a tag as a LEAF
                # and never reaches the commit it tags — so a commit reachable
                # only through a tag reads as dangling, and `fsck --prune-now`
                # deletes it. Same shape as the S-27 missing-referent bug: the
                # walk not knowing about an edge, not the edge being absent.
                #
                # "tag " (4) cannot collide with "tree " (5) — second byte
                # differs — so the prefix test is unambiguous.
                if (blen >= 4) {
                    if (memeq(buf, "tag ", 4) == 1) {
                        var tinfo[40];
                        if (parse_tag_body(body, body_len, &tinfo) == 0) {
                            var tgt = load64(&tinfo);
                            if (tgt != 0) {
                                if (map_has(seen, tgt) == 0) { vec_push(queue, tgt); }
                            }
                        }
                    }
                }
                # blob: leaf — no further enqueue.
            }
        }
    }
    return 0;
}

# Map the patra `ty` INT back to the canonical word for dangling
# output. Returns 0 if unknown — caller falls back to "object".
fn fsck_ty_word(ty) {
    if (ty == 0) { return "blob"; }
    if (ty == 1) { return "tree"; }
    if (ty == 2) { return "commit"; }
    if (ty == 3) { return "tag"; }
    return 0;
}

# fsck — integrity + reachability.
#
# Integrity pass: SELECT every (hash, ty) from .sit/objects.patra; for
# each, read+decompress and sigil-rehash the framed body against the
# stored hex. Mismatch / unreadable rows are emitted on stderr and
# count toward `bad`.
#
# Reachability pass (v0.8.5): collect roots from refs/heads/tags/remotes
# + detached HEAD + every staged index entry; BFS the object graph
# from each root marking `seen`; any object in the integrity inventory
# that isn't in `seen` is dangling. Dangling objects are reported on
# stdout one per line in `dangling <type> <hex>` format (git-shaped);
# they don't fail the command — only integrity errors set non-zero
# exit, mirroring git's policy that dangling objects are expected
# after resets / rewinds.
# Delete a single object row by hex (v0.8.14, fsck --prune). The hex is
# validated 64-char hex before interpolation — even though it comes from the
# inventory SELECT, never build SQL from unchecked bytes. Returns patra_exec's
# code (0 = ok), or -1 if the hex fails validation.
fn db_object_delete(db, hex) {
    if (hex_prefix_valid(hex, 64) == 0) { return 0 - 1; }
    var sql = alloc(128);
    memcpy(sql, "DELETE FROM objects WHERE hash = '", 34);
    memcpy(sql + 34, hex, 64);
    memcpy(sql + 34 + 64, "'", 1);
    store8(sql + 34 + 64 + 1, 0);
    return patra_exec(db, sql);
}

# Extract a commit's author timestamp (unix seconds) from its raw body, for
# the prune age-window check. The ident line is "author NAME <EMAIL> TS TZ";
# TS is the second-to-last space-delimited token. Returns 0 if no parseable
# author line (caller then treats the object as undatable). Self-contained
# (parse_commit_body lives in the later commit.cyr module, out of bundle reach).
fn _fsck_commit_author_ts(body, len) {
    var i = 0;
    var astart = 0 - 1;
    var scanning = 1;
    while (scanning == 1) {
        if (i + 7 > len) { scanning = 0; }
        else {
            var at_ls = 0;
            if (i == 0) { at_ls = 1; }
            else { if (load8(body + i - 1) == 10) { at_ls = 1; } }
            if (at_ls == 1) {
                if (memeq(body + i, "author ", 7) == 1) { astart = i + 7; scanning = 0; }
            }
            if (scanning == 1) { i = i + 1; }
        }
    }
    if (astart < 0) { return 0; }

    var aend = astart;
    var f2 = 1;
    while (f2 == 1) {
        if (aend >= len) { f2 = 0; }
        else { if (load8(body + aend) == 10) { f2 = 0; } else { aend = aend + 1; } }
    }

    # Walk back over the TZ token to the space before it → that's ts_end.
    var p = aend - 1;
    var s1 = 1;
    while (s1 == 1) {
        if (p < astart) { s1 = 0; }
        else { if (load8(body + p) == 32) { s1 = 0; } else { p = p - 1; } }
    }
    var ts_end = p;
    # ts_start = one past the previous space.
    var ts_start = ts_end;
    var s2 = 1;
    while (s2 == 1) {
        if (ts_start - 1 < astart) { s2 = 0; }
        else {
            if (load8(body + ts_start - 1) == 32) { s2 = 0; }
            else { ts_start = ts_start - 1; }
        }
    }
    if (ts_start >= ts_end) { return 0; }

    var val = 0;
    var k = ts_start;
    var okp = 1;
    while (k < ts_end) {
        var d = load8(body + k);
        if (d < 48) { okp = 0; k = ts_end; }
        else {
            if (d > 57) { okp = 0; k = ts_end; }
            else { val = val * 10 + (d - 48); k = k + 1; }
        }
    }
    if (okp == 0) { return 0; }
    return val;
}

# `sit fsck [--prune|--prune-now]` — verify object integrity and reachability; --prune removes dangling objects.
fn cmd_fsck() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    # `--prune` removes dangling (unreachable) objects this walk identifies.
    # v1.1.0 added two grace mechanisms vs the old unconditional --prune=now:
    #   (1) reflog reachability — every .sit/logs/** entry's oids are roots
    #       (fsck_collect_reflog_roots), so a reset-discarded tip is protected
    #       as long as its reflog entry exists; and
    #   (2) an age window — a still-dangling object is kept unless it's older
    #       than the grace window. Datable objects are commits (author ts);
    #       trees/blobs can't be dated, so a positive window keeps them.
    # `--prune` uses a 90-day window (git's gc.reflogExpire default); the
    # legacy immediate behaviour is `--prune-now` (grace 0, like
    # `git gc --prune=now`). Both are refused mid-merge (.sit/MERGE_HEAD).
    var prune = 0;
    var grace_days = 90;
    var ai = 2;
    while (ai < argc()) {
        if (streq(argv(ai), "--prune") == 1) { prune = 1; }
        if (streq(argv(ai), "--prune-now") == 1) { prune = 1; grace_days = 0; }
        ai = ai + 1;
    }
    if (prune == 1) {
        # 1.6.4 (A9): a rebase, cherry-pick or revert in progress holds commits
        # only its state files name — the original tip in REBASE_ORIG, the rest
        # of the branch in rebase-todo. With the reflog gone those were pruned,
        # and --abort then wrote a dangling oid and emptied the worktree.
        # 1.12.2: present by lstat — an unreadable state file is still a merge
        # (or rebase, …) in progress, not its absence.
        if (path_lstat_kind(sit_abs(".sit/REBASE_ORIG")) >= 0) {
            eprintln("sit: refusing --prune during an in-progress rebase (.sit/REBASE_ORIG present)");
            return 1;
        }
        if (path_lstat_kind(sit_abs(".sit/CHERRY_PICK_HEAD")) >= 0) {
            eprintln("sit: refusing --prune during an in-progress cherry-pick (.sit/CHERRY_PICK_HEAD present)");
            return 1;
        }
        if (path_lstat_kind(sit_abs(".sit/REVERT_HEAD")) >= 0) {
            eprintln("sit: refusing --prune during an in-progress revert (.sit/REVERT_HEAD present)");
            return 1;
        }
        if (path_lstat_kind(sit_abs(".sit/MERGE_HEAD")) >= 0) {
            eprintln("sit: refusing --prune during an in-progress merge (.sit/MERGE_HEAD present)");
            return 1;
        }
        # 1.12.2 (X2): deletes run alone, as gc's do. Under the shared lock a
        # prune ran beside a fetch or a served push and deleted objects that
        # had arrived but that no ref named yet; the ref then moved onto a hole.
        # `sit serve` holds the store per request, so a prune runs between them.
        var plr = store_lock_exclusive();
        if (plr == 0 - 1) {
            eprintln("sit: refusing --prune: another sit process has the object store open");
            eprintln("sit:   (a `sit serve` request, or a command still running); run it when that is done");
            return 1;
        }
        if (plr != 0) {
            eprintln("sit: refusing --prune: cannot take the store lock (.sit/objects.flock)");
            return 1;
        }
    }

    var db = get_object_db();
    if (db == 0) {
        stdout_write("checked 0 objects, 0 bad, 0 dangling\n", 37);
        return 0;
    }

    # Integrity pass. v0.8.5: pull `ty` alongside `hash` so the
    # reachability report can emit `dangling <type> <hex>` without a
    # second read per dangling object.
    var rs = patra_query(db, "SELECT hash, ty FROM objects");
    var total = 0;
    var bad = 0;
    var hashes = vec_new();
    var ty_map = map_new();
    if (rs != 0) {
        var count = patra_result_count(rs);
        var i = 0;
        while (i < count) {
            var s = patra_result_get_str(rs, i, 0);
            var ty = patra_result_get_int(rs, i, 1);
            var copy = alloc_or_die(65);
            memcpy(copy, s, 64);
            store8(copy + 64, 0);
            vec_push(hashes, copy);
            map_set(ty_map, copy, ty + 1);
            i = i + 1;
        }
        patra_result_free(rs);
    }

    # 1.10.0: rows and packs are checked apart, each through its own reader —
    # read_object tries the packs first, so a row that duplicates a packed
    # object would otherwise never be read. An object both hold is checked in
    # both, and counted once.
    var nrows = vec_len(hashes);
    var packed = map_new();
    var poids = vec_new();
    if (sit_pack_oids(0, poids) < 0) {
        eprintln("bad pack index under .sit/packs (malformed .idx)");
        bad = bad + 1;
    }
    bad = bad + sit_pack_verify_files(0);
    var pk = 0;
    while (pk < vec_len(poids)) {
        var ph = vec_get(poids, pk);
        if (map_has(packed, ph) == 0) {
            map_set(packed, ph, 1);
            if (map_has(ty_map, ph) == 0) { vec_push(hashes, ph); }
        }
        pk = pk + 1;
    }

    var hn = vec_len(hashes);
    var hi = 0;
    while (hi < hn) {
        var hex = vec_get(hashes, hi);
        var from_row = 0;
        if (hi < nrows) { from_row = 1; }
        var readable = 0;
        var step = 0;
        while (step < 2) {
            var want = 0;
            if (step == 0) { want = from_row; }
            else { want = map_has(packed, hex); }
            if (want == 1) {
                var obj[24];
                var rr = 0;
                if (step == 0) { rr = db_row_read(db, hex, &obj); }
                else { rr = sit_pack_read(0, hex, &obj); }
                if (rr == 0) {
                    readable = 1;
                    var buf = load64(&obj);
                    var blen = load64(&obj + 8);
                    var actual = hash_data(buf, blen);
                    if (streq(hex, actual) == 0) {
                        syscall(SYS_WRITE, STDERR, "bad object ", 11);
                        syscall(SYS_WRITE, STDERR, hex, 64);
                        syscall(SYS_WRITE, STDERR, "\n", 1);
                        bad = bad + 1;
                    }
                    else {
                        # A packed object's type comes from its framing.
                        if (map_has(ty_map, hex) == 0) {
                            var sp0 = 0;
                            while (load8(buf + sp0) != 32) { sp0 = sp0 + 1; }
                            map_set(ty_map, hex, type_code_of(buf, sp0) + 1);
                        }
                    }
                    fl_free(buf);
                }
                else {
                    syscall(SYS_WRITE, STDERR, "unreadable ", 11);
                    syscall(SYS_WRITE, STDERR, hex, 64);
                    syscall(SYS_WRITE, STDERR, "\n", 1);
                    bad = bad + 1;
                }
            }
            step = step + 1;
        }
        total = total + readable;
        # An unreadable packed object still counts as stored (S-27 below).
        if (map_has(ty_map, hex) == 0) { map_set(ty_map, hex, 0 - 1); }
        hi = hi + 1;
    }

    # Reachability pass (v0.8.5). Refs/HEAD roots first (count retained for
    # the prune corrupt-roots tripwire), then reflog roots appended (v1.1.0).
    var seen = map_new();
    # S-26: parse_tree silently discards entries with a bad mode or unsafe name,
    # so their objects are never enqueued below. Track that across the walk.
    tree_dropped_reset();
    # S-27: collect referents the walk cannot resolve (see fsck_missing_*),
    # and load the shallow boundary set so intentionally-absent parents of a
    # `clone --depth` boundary are not mistaken for corruption.
    fsck_missing_reset();
    _fsck_shallow = load_shallow_set();
    _fsck_optional = 0;
    _fsck_roots_unread = 0;
    var roots = fsck_collect_roots();
    var ref_root_count = vec_len(roots);
    fsck_collect_reflog_roots(roots);
    var ri = 0;
    while (ri < vec_len(roots)) {
        fsck_walk_reachable(vec_get(roots, ri), seen);
        ri = ri + 1;
    }

    # Staged blobs count as roots — without this, every `sit add` that
    # hasn't been committed yet would look dangling. (Mirrors git's
    # implicit-keep of `git ls-files` blobs during fsck.)
    var idx_entries = parse_index();
    # 1.7.2: an index on disk that will not open (an unfinished v0.1
    # migration, a corrupt index.patra) reads as "nothing staged" here, so
    # every blob only it references would look dangling.
    var idx_unreadable = 0;
    if (idx_entries == 0) {
        if (index_files_present() == 1) {
            if (get_index_db() == 0) { idx_unreadable = 1; }
        }
    }
    if (idx_unreadable == 1) {
        eprintln("sit: warning: the staging index cannot be read; blobs it stages count as dangling");
    }
    if (idx_entries != 0) {
        var ii = 0;
        while (ii < vec_len(idx_entries)) {
            var e = vec_get(idx_entries, ii);
            var bin = entry_hash(e);
            var ihex = hex_encode(bin, 32);
            if (map_has(seen, ihex) == 0) { map_set(seen, ihex, 1); }
            ii = ii + 1;
        }
    }

    # Diff: objects in the inventory but not reachable.
    var dangling = 0;
    var dangling_hexes = vec_new();
    var di = 0;
    while (di < hn) {
        var hex2 = vec_get(hashes, di);
        if (map_has(seen, hex2) == 0) {
            var stored = map_get(ty_map, hex2);
            var ty_word = 0;
            if (stored > 0) { ty_word = fsck_ty_word(stored - 1); }
            if (ty_word == 0) { ty_word = "object"; }
            stdout_write("dangling ", 9);
            stdout_write(ty_word, strlen(ty_word));
            stdout_write(" ", 1);
            stdout_write(hex2, 64);
            stdout_write("\n", 1);
            dangling = dangling + 1;
            vec_push(dangling_hexes, hex2);
        }
        di = di + 1;
    }

    # S-27: report referents that could not be resolved at all.
    #
    # A hex recorded by the walk is one whose read failed. Split it:
    #   * present in ty_map => it IS stored, just unreadable — the integrity
    #     pass above already printed `unreadable` and counted it. Skip, or the
    #     same object is counted twice.
    #   * absent from ty_map => nothing in the store has that oid, yet a live
    #     commit or tree references it. That is git's `missing`, and it is the
    #     broken-repo shape sit previously called clean.
    #
    # Counted toward `bad` so the `--prune` tripwire covers it for free: pruning
    # a repo that is already missing objects would compound the damage.
    var miss_vec = fsck_missing_vec();
    var mi = 0;
    while (mi < vec_len(miss_vec)) {
        var mhex = vec_get(miss_vec, mi);
        if (map_get(ty_map, mhex) == 0) {
            syscall(SYS_WRITE, STDERR, "missing ", 8);
            syscall(SYS_WRITE, STDERR, mhex, 64);
            syscall(SYS_WRITE, STDERR, "\n", 1);
            bad = bad + 1;
        }
        mi = mi + 1;
    }

    var mal = _fsck_malformed;
    var mli = 0;
    if (mal != 0) {
        while (mli < vec_len(mal)) {
            syscall(SYS_WRITE, STDERR, "malformed commit ", 17);
            syscall(SYS_WRITE, STDERR, vec_get(mal, mli), 64);
            syscall(SYS_WRITE, STDERR, " (header order: tree first, once; parents next)\n", 48);
            bad = bad + 1;
            mli = mli + 1;
        }
    }

    # 1.6.4: a reachable tree with entries parse_tree had to drop (bad mode,
    # unsafe name, duplicate or out-of-order name) is a structural defect in
    # its own right — git's fsck errors on duplicateEntries / treeNotSorted —
    # not only a reason to refuse --prune (below). Report it and fail.
    var dropped = tree_dropped_count();
    if (dropped > 0) {
        var dbuf[24];
        var dd = write_decimal(&dbuf, dropped);
        syscall(SYS_WRITE, STDERR, "malformed tree entries: ", 24);
        syscall(SYS_WRITE, STDERR, &dbuf, dd);
        syscall(SYS_WRITE, STDERR, " (bad mode, unsafe name, duplicate or out-of-order) — checkout ignores them\n", 78);
    }

    stdout_write("checked ", 8);
    write_unsigned(total);
    stdout_write(" objects, ", 10);
    write_unsigned(bad);
    stdout_write(" bad, ", 6);
    write_unsigned(dangling);
    stdout_write(" dangling\n", 10);

    # v0.8.14: prune the dangling set. Deletes each unreachable object, then
    # flushes (the main trailer only flushes stdout, not patra) so the removal
    # is durable across the process exit. Reachable history is untouched —
    # only objects absent from the reachability walk are removed.
    if (prune == 1) {
        # Data-loss guard: the reachability walk SKIPS unreadable objects
        # (read_object failure → its children are never enqueued), so a single
        # corrupt interior commit/tree would orphan its whole subgraph into the
        # dangling set. Pruning then deletes genuinely-reachable objects with no
        # reflog to recover them. Refuse while any object is bad/unreadable.
        if (bad > 0) {
            eprintln("sit: refusing --prune with bad/unreadable objects — resolve integrity first");
            return 1;
        }
        # S-26: the same data-loss shape, one level down. An UNREADABLE object
        # orphans its subgraph (guarded above); an object that reads fine but
        # whose tree body carries an entry parse_tree discards — a non-allowlisted
        # mode like 100755, or a name like `.git` — orphans that entry's blob or
        # subtree just as thoroughly, while `bad` stays 0 and the walk reports it
        # as merely `dangling`. Pruning then deleted an object a live tree still
        # references. A malformed tree is structural corruption; refuse.
        if (tree_dropped_count() > 0) {
            eprintln("sit: refusing --prune — a reachable tree has entries sit cannot use (see above)");
            eprintln("sit:   their objects cannot be proven reachable and would be deleted while still referenced");
            return 1;
        }
        if (idx_unreadable == 1) {
            eprintln("sit: refusing --prune — the staging index cannot be read (see above)");
            return 1;
        }
        if (_fsck_roots_unread > 0) {
            eprintln("sit: refusing --prune — a ref or reflog cannot be read (see above)");
            eprintln("sit:   the objects it names would be deleted");
            return 1;
        }
        # If EVERY object is unreachable, the roots are almost certainly broken
        # (corrupt / missing HEAD or refs), not the objects. Pruning would wipe
        # the whole store. Refuse.
        if (total > 0) {
            if (dangling == total) {
                eprintln("sit: refusing --prune — every object is unreachable (corrupt or missing HEAD/refs?)");
                return 1;
            }
        }
        # Corrupt-roots tripwire: a stale .sit/logs must not stand in for a
        # wiped HEAD/refs. If there are NO refs/HEAD roots (only reflog roots),
        # the ref store is broken — pruning would delete any branch that was
        # never reflogged. Refuse unless there are objects but genuinely no
        # refs at all is impossible after init (HEAD always resolves once a
        # commit exists), so an empty ref-root set with objects present is the
        # corruption signal.
        if (total > 0) {
            if (ref_root_count == 0) {
                eprintln("sit: refusing --prune — no valid refs/HEAD roots (corrupt or missing HEAD/refs?)");
                return 1;
            }
        }
        # Age window: keep a still-dangling object unless it's older than the
        # grace window (grace 0 deletes everything dangling — the old
        # --prune=now behaviour). Only commits carry a timestamp (author ts).
        #
        # 1.8.0: trees and blobs are dated by the commits that reach them. One
        # reachable only from dangling commits past the window goes with them;
        # one a kept dangling commit reaches stays; one no dangling commit
        # reaches (a blob staged and abandoned) is undatable and stays. Before,
        # every dangling tree and blob was kept under a positive window, so
        # expiring the reflog let `--prune` drop an old discarded commit but
        # never what it held.
        var now = clock_epoch_secs();
        var grace_secs = grace_days * 86400;
        var pruned = 0;
        var kept = 0;
        var kept_packed = 0;
        var nd = vec_len(dangling_hexes);
        var verdict = alloc_or_die(nd + 1);           # 0 delete, 1 keep, 2 tree/blob: decide below
        var expired_reach = map_new();
        var kept_reach = map_new();
        var pi = 0;
        while (pi < nd) {
            var dhex = vec_get(dangling_hexes, pi);
            store8(verdict + pi, 0);
            if (grace_secs > 0) {
                # Conservative default under a positive window: KEEP unless we
                # can positively date the object past the window. An undatable
                # commit (unreadable body or unparseable ts) is kept — never
                # delete something we can't prove is old.
                store8(verdict + pi, 1);
                var dstored = map_get(ty_map, dhex);
                if (dstored == 3) {                 # ty 2 (commit) + 1
                    var co[24];
                    var old = 0;
                    if (read_object(dhex, &co) == 0) {
                        var cts = _fsck_commit_author_ts(load64(&co), load64(&co + 8));
                        if (cts > 0) {
                            if (now - cts >= grace_secs) { old = 1; }
                        }
                    }
                    if (old == 1) {
                        store8(verdict + pi, 0);
                        fsck_walk_reachable(dhex, expired_reach);
                    }
                    else { fsck_walk_reachable(dhex, kept_reach); }
                }
                else {
                    if (dstored == 1) { store8(verdict + pi, 2); }    # blob
                    if (dstored == 2) { store8(verdict + pi, 2); }    # tree
                    if (dstored == 4) { fsck_walk_reachable(dhex, kept_reach); }   # tag (ty 3): kept
                }
            }
            pi = pi + 1;
        }
        # 1.12.2 (L1): a tree no expired commit reaches is undatable and kept,
        # so what it holds is kept too.
        pi = 0;
        while (pi < nd) {
            if (load8(verdict + pi) == 2) {
                var th = vec_get(dangling_hexes, pi);
                if (map_get(ty_map, th) == 2) {
                    if (map_has(expired_reach, th) == 0) { fsck_walk_reachable(th, kept_reach); }
                }
            }
            pi = pi + 1;
        }
        pi = 0;
        while (pi < nd) {
            var dh = vec_get(dangling_hexes, pi);
            var v = load8(verdict + pi);
            if (v == 2) {
                v = 1;
                if (map_has(expired_reach, dh) == 1) {
                    if (map_has(kept_reach, dh) == 0) { v = 0; }
                }
            }
            # 1.12.2 (L1): whatever a kept dangling object reaches is kept,
            # commits too, as git's prune keeps what a recent object reaches. A
            # commit past the window was deleted on its own date even when a
            # kept commit or tag sat on top of it, leaving that one with a hole
            # (and fsck reporting `missing` from then on).
            if (v == 0) {
                if (map_has(kept_reach, dh) == 1) { v = 1; }
            }
            # 1.10.0: a packed object is not a row to delete. It stays until the
            # next gc, which writes what is unreachable back as rows ("loosens"
            # it, as git's repack -A does) for a later --prune to judge.
            if (map_has(packed, dh) == 1) { v = 3; }
            if (v == 1) { kept = kept + 1; }
            if (v == 3) { kept_packed = kept_packed + 1; }
            if (v == 0) {
                if (db_object_delete(db, dh) == 0) { pruned = pruned + 1; }
            }
            pi = pi + 1;
        }
        # 1.7.2: since patra 1.16.2 a failed fdatasync is reported, and it
        # sticks to the handle, so this one flush answers for every DELETE.
        var flush_rc = patra_flush(db);
        stdout_write("pruned ", 7);
        write_unsigned(pruned);
        stdout_write(" objects", 8);
        if (kept > 0) {
            stdout_write(", kept ", 7);
            write_unsigned(kept);
            stdout_write(" within grace", 13);
        }
        if (kept_packed > 0) {
            stdout_write(", kept ", 7);
            write_unsigned(kept_packed);
            var kpm = " packed (the next `sit gc` loosens them)";
            stdout_write(kpm, strlen(kpm));
        }
        stdout_write("\n", 1);
        if (flush_rc != PATRA_OK) {
            eprintln("sit: the object store could not be synced; the pruning may not be durable");
            return 1;
        }
    }

    if (bad > 0) { return 1; }
    if (dropped > 0) { return 1; }
    return 0;
}

# The blob id `content` would get, without storing it.
fn hash_blob_of_content(content, content_len) {
    var full_cap = 32 + content_len;
    var full = alloc_or_die(full_cap);
    memcpy(full, "blob ", 5);
    var digits = write_decimal(full + 5, content_len);
    store8(full + 5 + digits, 0);
    var hdr_len = 5 + digits + 1;
    memcpy(full + hdr_len, content, content_len);
    return hash_data(full, hdr_len + content_len);
}

# Read a regular file into a heap buffer. Stores (buf_ptr, len) to out_pair.
# Returns 0 on success, negative on error.
fn hash_file_as_blob(path) {
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0; }
    return hash_blob_of_content(load64(&pair), load64(&pair + 8));
}

# Tree entry layout (24 bytes):
#   0..8:   mode ptr (heap cstring, e.g. "100644")
#   8..16:  name ptr (heap cstring)
#   16..24: hash_hex ptr (heap cstring, 64 chars + null)
