# Upper bound on the branch-range walk, mirroring SIT_DESCRIBE_MAX.
var SIT_REBASE_MAX = 100000;

# rebase.cyr — `sit rebase <upstream>`.
#
# A rebase is cherry-pick in a loop: reset the branch to <upstream>, then replay
# each commit that was on the branch but not on upstream. 1.5.1 already built
# the per-commit half as `_apply_one_commit` (history.cyr), which is why this
# file is short — what it adds is the loop, the resumable state, and the
# guarantee that a failure leaves the branch exactly where it started.
#
# State lives in two files, both under .sit/ and both removed on completion:
#   .sit/REBASE_ORIG   the branch tip before the rebase began (for --abort)
#   .sit/rebase-todo   one oid per line, oldest first, of what is left to apply
#
# ⚠ Rebase REWRITES history: the replayed commits are new objects with new oids.
# The originals stay reachable through the reflog, which is what makes --abort
# and after-the-fact recovery possible, and is why this waited for 1.1.0.

# State file holding the branch tip saved before a rebase moves anything.
fn rebase_orig_path() { return ".sit/REBASE_ORIG"; }
# State file listing the commits a rebase still has to replay.
fn rebase_todo_path() { return ".sit/rebase-todo"; }

# A heap copy of a 64-hex commit id.
fn _rebase_hex_dup(h) {
    var c = alloc_or_die(65);
    memcpy(c, h, 64);
    store8(c + 64, 0);
    return c;
}

# The commits a rebase replays: reachable from `tip` over every parent, not
# reachable from `upstream`, merge commits left out, oldest-first in
# topological order (each commit after all of its parents). That is git's
# default `upstream..tip`, linearized.
#
# 1.7.3 (A8): this used to follow first parents from `tip` down to the merge
# base. When upstream had been merged INTO the branch, the base was reachable
# only through that merge's second parent, the walk never met it, and rebase
# replayed everything down to the root, upstream's own commits included.
# Merges are dropped as git drops them: the branch-only commits they brought
# in are in the set themselves, and what they brought from upstream is
# already on upstream.
fn _rebase_pending(tip, upstream) {
    # Phase 1: everything upstream already has (the same full-DAG walk
    # find_merge_base makes of one side).
    var have = map_new();
    var q = vec_new();
    vec_push(q, _rebase_hex_dup(upstream));
    while (vec_len(q) > 0) {
        var cur = vec_get(q, vec_len(q) - 1);
        vec_pop(q);
        if (map_has(have, cur) == 0) {
            map_set(have, cur, 1);
            var pv = commit_parents_of(cur);
            if (pv != 0) {
                var pi = 0;
                while (pi < vec_len(pv)) {
                    vec_push(q, vec_get(pv, pi));
                    pi = pi + 1;
                }
            }
        }
    }

    # Phase 2: iterative post-order DFS from `tip`, pruned at `have`. A commit
    # is emitted once every parent has been, so the list comes out
    # oldest-first; parents are taken in order, so a first-parent line stays
    # together. Three parallel stacks: the commit, its parents, the next
    # parent to visit.
    var out = vec_new();
    var seen = map_new();
    var st_c = vec_new();
    var st_p = vec_new();
    var st_k = vec_new();
    var t = _rebase_hex_dup(tip);
    if (map_has(have, t) == 0) {
        map_set(seen, t, 1);
        vec_push(st_c, t);
        vec_push(st_p, commit_parents_of(t));
        vec_push(st_k, 0);
    }
    while (vec_len(st_c) > 0) {
        var top = vec_len(st_c) - 1;
        var c = vec_get(st_c, top);
        var parents = vec_get(st_p, top);
        var k = vec_get(st_k, top);
        var np = 0;
        if (parents != 0) { np = vec_len(parents); }
        if (k < np) {
            vec_set(st_k, top, k + 1);
            var p = vec_get(parents, k);
            if (map_has(have, p) == 0) {
                if (map_has(seen, p) == 0) {
                    map_set(seen, p, 1);
                    vec_push(st_c, p);
                    vec_push(st_p, commit_parents_of(p));
                    vec_push(st_k, 0);
                }
            }
        }
        else {
            vec_pop(st_c);
            vec_pop(st_p);
            vec_pop(st_k);
            if (np <= 1) {
                vec_push(out, c);
                if (vec_len(out) > SIT_REBASE_MAX) {
                    eprintln("sit: rebase range too long");
                    return 0;
                }
            }
        }
    }
    return out;
}

fn _rebase_write_todo(todo, from_index) {
    var n = vec_len(todo);
    var cap = (n - from_index) * 65 + 1;
    if (cap < 1) { cap = 1; }
    var buf = alloc_or_die(cap);
    var w = 0;
    var i = from_index;
    while (i < n) {
        memcpy(buf + w, vec_get(todo, i), 64);
        w = w + 64;
        store8(buf + w, 10);
        w = w + 1;
        i = i + 1;
    }
    if (w == 0) {
        if (sf_exists(rebase_todo_path()) == 1) { return sf_unlink(rebase_todo_path()); }
        return 0;
    }
    if (sf_write_atomic(rebase_todo_path(), buf, w) < 0) { return 0 - 1; }
    return 0;
}

# The todo list as a vec of 64-hex oids; 0 if the file is present but not
# exactly a sequence of `<64 hex>\n` records naming readable objects.
#
# 1.6.4 (A7): this skipped any record that failed the hex check and stepped a
# fixed 65 bytes regardless, so one stray byte (a CRLF from an editor, say)
# misaligned every later record and the rebase "completed" having silently
# dropped the rest of the branch. A corrupt todo now stops the rebase instead.
fn _rebase_read_todo() {
    var out = vec_new();
    if (sf_exists(rebase_todo_path()) != 1) { return out; }
    var pair[16];
    if (read_file_heap(rebase_todo_path(), &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    if (len % 65 != 0) { return 0; }
    var pos = 0;
    while (pos < len) {
        if (hex_prefix_valid(buf + pos, 64) == 0) { return 0; }
        if (load8(buf + pos + 64) != 10) { return 0; }
        var c = alloc(65);
        memcpy(c, buf + pos, 64);
        store8(c + 64, 0);
        var probe[24];
        if (read_object(c, &probe) != 0) { return 0; }
        vec_push(out, c);
        pos = pos + 65;
    }
    return out;
}

# Read .sit/REBASE_ORIG — `<64 hex>\n` then (since 1.6.4) the branch's ref path
# and `\n`. Fills `out_hex` (65 bytes); returns the saved ref path (heap
# cstring), "" for a pre-1.6.4 file without one, or 0 if the state is corrupt.
#
# 1.6.4 (A7): --abort trusted any 64 bytes here. NUL bytes or an oid naming a
# missing object made materialize treat the "commit" as an empty tree, delete
# every tracked file, write the junk into the branch ref, and report success.
fn _rebase_read_orig(out_hex) {
    var pair[16];
    if (read_file_heap(rebase_orig_path(), &pair) != 0) { return 0; }
    var b = load64(&pair);
    var blen = load64(&pair + 8);
    if (blen < 65) { return 0; }
    if (hex_prefix_valid(b, 64) == 0) { return 0; }
    if (load8(b + 64) != 10) { return 0; }
    memcpy(out_hex, b, 64);
    store8(out_hex + 64, 0);
    var probe[24];
    if (read_object(out_hex, &probe) != 0) { return 0; }
    var rl = blen - 65;
    if (rl > 0) { if (load8(b + blen - 1) == 10) { rl = rl - 1; } }
    var ref = alloc_or_die(rl + 1);
    memcpy(ref, b + 65, rl);
    store8(ref + rl, 0);
    return ref;
}

# 1 if HEAD is still on the branch a rebase was started on (`saved_ref`, "" for
# a pre-1.6.4 state file, which carries no branch). 1.6.4 (A6): --abort and
# --continue wrote whatever branch HEAD named, so `checkout main` mid-rebase
# followed by --abort reset MAIN to the feature tip.
fn _rebase_on_saved_branch(saved_ref) {
    if (strlen(saved_ref) == 0) { return 1; }
    var cur = read_head_ref_path();
    if (cur == 0) { return 0; }
    return streq(cur, saved_ref);
}

fn _rebase_clear_state() {
    if (sf_exists(rebase_todo_path()) == 1) { sf_unlink(rebase_todo_path()); }
    if (sf_exists(rebase_orig_path()) == 1) { sf_unlink(rebase_orig_path()); }
    return 0;
}

# Apply `todo` from `start` onward. Returns 0 when the whole list lands.
fn _rebase_run(todo, start) {
    var n = vec_len(todo);
    var i = start;
    while (i < n) {
        var c = vec_get(todo, i);
        # _apply_one_commit is cherry-pick: (base = parent(c), ours = HEAD,
        # theirs = c). On conflict it writes the marker files and returns
        # non-zero, and HEAD is left where it was — so the todo we persist
        # starts AT this commit, and --continue re-applies it after the user
        # resolves.
        if (_apply_one_commit(c, 0, cherry_pick_head_path(), "rebase", 6) != 0) {
            # A todo that could not be saved would make --continue see an empty
            # list and announce "rebase complete" with the rest unapplied.
            if (_rebase_write_todo(todo, i) != 0) {
                eprintln("sit: cannot save the rebase todo — 'sit rebase --abort' to restore the branch");
                return 1;
            }
            syscall(SYS_WRITE, STDERR, "sit: rebase stopped at ", 23);
            syscall(SYS_WRITE, STDERR, c, 12);
            syscall(SYS_WRITE, STDERR, " — resolve, 'sit add', then 'sit rebase --continue'\n", 54);
            return 1;
        }
        i = i + 1;
    }
    _rebase_clear_state();
    stdout_write("rebase complete\n", 16);
    return 0;
}

# `sit rebase <upstream> | --continue | --abort` — replay this branch's commits onto <upstream>.
fn cmd_rebase() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit rebase <upstream> | sit rebase --continue | --abort");
        return 1;
    }
    var arg = argv_heap(2);

    if (streq(arg, "--abort") == 1) {
        if (sf_exists(rebase_orig_path()) != 1) {
            eprintln("sit: no rebase in progress");
            return 1;
        }
        var orig = alloc(65);
        var saved_ref = _rebase_read_orig(orig);
        if (saved_ref == 0) {
            eprintln("sit: corrupt rebase state (.sit/REBASE_ORIG) — nothing changed");
            return 1;
        }
        if (_rebase_on_saved_branch(saved_ref) == 0) {
            eprint3("sit: this rebase was started on '", saved_ref, "' — check it out before --abort\n");
            return 1;
        }
        var before_abort = read_head_ref();
        # Materialize before the ref moves — see the note in cmd_merge.
        if (materialize_target(orig) != 0) {
            eprintln("sit: failed to restore the working tree — branch unchanged");
            return 1;
        }
        if (write_head_ref(orig) != 0) {
            eprintln("sit: failed to restore the branch ref");
            return 1;
        }
        reflog_head_move(before_abort, orig, "rebase: aborted");
        conflicts_clear();
        _rebase_clear_state();
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) { sf_unlink(".sit/CHERRY_PICK_HEAD"); }
        stdout_write("rebase aborted; branch restored to ", 35);
        stdout_write(orig, 12);
        stdout_write("\n", 1);
        return 0;
    }

    if (streq(arg, "--continue") == 1) {
        if (sf_exists(rebase_orig_path()) != 1) {
            eprintln("sit: no rebase in progress");
            return 1;
        }
        var corig = alloc(65);
        var csaved = _rebase_read_orig(corig);
        if (csaved == 0) {
            eprintln("sit: corrupt rebase state (.sit/REBASE_ORIG) — 'sit rebase --abort' cannot help; inspect it");
            return 1;
        }
        if (_rebase_on_saved_branch(csaved) == 0) {
            eprint3("sit: this rebase was started on '", csaved, "' — check it out before --continue\n");
            return 1;
        }
        var todo = _rebase_read_todo();
        if (todo == 0) {
            eprintln("sit: corrupt .sit/rebase-todo — 'sit rebase --abort' to restore the branch");
            return 1;
        }
        # 1.7.6 (L7): a step can stop without a conflict — an untracked file in
        # the way, a symlinked parent — before anything of it is applied.
        # --continue committed the index (the previous step's tree) under its
        # message, so the commit's change was silently dropped and an empty
        # commit took its place. Only a conflict stop leaves these files.
        var conflict_stop = 0;
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) { conflict_stop = 1; }
        if (sf_exists(conflicts_path()) == 1) { conflict_stop = 1; }
        # The resolution is committed FROM THE INDEX, and the worktree is then
        # rewritten to match it; an edit that was never `sit add`ed would be
        # discarded without a word. git refuses here too.
        if (vec_len(todo) > 0) {
            if (conflicts_check_resolved() != 0) {
                eprintln("sit: rebase --continue refused — resolve and 'sit add' the conflicted files first");
                return 1;
            }
            if (worktree_differs_from_index() == 1) {
                eprintln("sit: you have unstaged changes — 'sit add' the resolved files before --continue");
                return 1;
            }
        }
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) { sf_unlink(".sit/CHERRY_PICK_HEAD"); }
        if (vec_len(todo) == 0) {
            _rebase_clear_state();
            stdout_write("rebase complete\n", 16);
            return 0;
        }
        # The stopped commit is todo[0]. After a conflict the user has resolved
        # and staged it, so that resolution is committed rather than the same
        # conflict re-applied.
        var head_now = read_head_ref();
        var msg = commit_message_of(vec_get(todo, 0));
        if (msg == 0) { msg = "rebase: resolved"; }
        var entries = parse_index();
        if (entries == 0) { entries = vec_new(); }
        sort_entries(entries);
        var tree_hex = build_tree(entries, 0);
        if (tree_hex == 0) { eprintln("sit: failed to write tree"); return 1; }
        var cur_tree = commit_tree_hex(head_now);
        var at_head = 0;
        if (cur_tree != 0) { if (streq(tree_hex, cur_tree) == 1) { at_head = 1; } }
        # A stop that was no conflict and left the index at HEAD's tree applied
        # nothing: re-apply the step. One that got as far as writing the step's
        # tree (its ref write failed) is committed below — re-applying it would
        # refuse the now-"dirty" tree on every --continue.
        if (conflict_stop == 0) { if (at_head == 1) { return _rebase_run(todo, 0); } }
        # Resolved to HEAD's tree (or already committed by hand): the step has
        # nothing left to record, and an empty commit is not a resolution.
        if (at_head == 1) {
            stdout_write("nothing to commit for this step — skipped\n", 44);
            conflicts_clear();
            return _rebase_run(todo, 1);
        }
        var new_hex = build_commit_signed(tree_hex, head_now, msg, 0);
        if (new_hex == 0) { eprintln("sit: failed to write commit"); return 1; }
        if (materialize_target(new_hex) != 0) {
            eprintln("sit: commit written but working tree not updated");
            return 1;
        }
        if (write_head_ref(new_hex) != 0) { eprintln("sit: failed to update branch ref"); return 1; }
        reflog_head_move(head_now, new_hex, reflog_msg_subject("rebase (continue): ", msg));
        conflicts_clear();
        return _rebase_run(todo, 1);
    }

    if (sf_exists(rebase_orig_path()) == 1) {
        eprintln("sit: a rebase is already in progress ('--continue' or '--abort')");
        return 1;
    }
    if (sf_exists(".sit/MERGE_HEAD") == 1) {
        eprintln("sit: a merge is in progress — finish it before rebasing");
        return 1;
    }

    var up[72];
    if (resolve_commit_hash(arg, &up) != 1) {
        eprintln("sit: cannot resolve upstream");
        return 1;
    }
    var head_hex = read_head_ref();
    if (head_hex == 0) { eprintln("sit: no commits yet"); return 1; }
    # A1: the branch is about to be rewritten under the worktree.
    if (is_dirty() == 1) {
        eprintln("sit: working tree has uncommitted changes — commit or stash them before rebasing");
        return 1;
    }
    var head_ref = read_head_ref_path();
    if (head_ref == 0) {
        eprintln("sit: HEAD is detached — check out the branch to rebase");
        return 1;
    }

    var todo = _rebase_pending(head_hex, &up);
    if (todo == 0) { return 1; }
    if (vec_len(todo) == 0) {
        stdout_write("already up to date — nothing to rebase\n", 41);
        return 0;
    }

    # Save the original tip FIRST: everything after this is recoverable with
    # --abort, and the reflog keeps the original commits reachable regardless.
    # `<tip>\n<branch ref>\n` — the branch is what --abort / --continue check.
    var hrl = strlen(head_ref);
    var obuf = alloc(66 + hrl + 1);
    memcpy(obuf, head_hex, 64);
    store8(obuf + 64, 10);
    memcpy(obuf + 65, head_ref, hrl);
    store8(obuf + 65 + hrl, 10);
    if (sf_write_atomic(rebase_orig_path(), obuf, 65 + hrl + 1) < 0) {
        eprintln("sit: cannot save rebase state");
        return 1;
    }

    # Move the branch to upstream, then replay.
    if (materialize_target_safe(&up, 1) != 0) {
        eprintln("sit: failed to check out upstream — branch unchanged");
        _rebase_clear_state();
        return 1;
    }
    if (write_head_ref(&up) != 0) {
        # 1.7.6: the worktree is on upstream now and the branch is not. Clearing
        # the state there left a tree a later commit would record as reverting
        # the branch. Put the (clean, checked above) worktree back first.
        if (materialize_target(head_hex) != 0) {
            eprintln("sit: failed to move the branch ref, and the working tree is still on upstream");
            eprintln("sit:   'sit rebase --abort' to restore it");
            return 1;
        }
        eprintln("sit: failed to move the branch ref — nothing changed");
        _rebase_clear_state();
        return 1;
    }
    reflog_head_move(head_hex, &up, reflog_msg_subject("rebase: onto ", arg));

    stdout_write("rebasing ", 9);
    var nb[24];
    var d = write_decimal(&nb, vec_len(todo));
    stdout_write(&nb, d);
    stdout_write(" commit(s) onto ", 16);
    stdout_write(&up, 12);
    stdout_write("\n", 1);
    return _rebase_run(todo, 0);
}
