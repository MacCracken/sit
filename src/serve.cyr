# serve.cyr — sit's HTTP daemon.
#
# Read-only endpoints — exposes an opened sit repo over the
# `/sit/v1/...` wire protocol per the v0.7.x plan.
#
#   GET /sit/v1/capabilities    → server identity + advertised limits
#   GET /sit/v1/refs            → all heads + tags as JSON
#   GET /sit/v1/objects/<hash>  → raw compressed object bytes;
#                                 X-Sit-Type: <patra-ty> header
#                                 carries the type code
#
# Later patches added: POST /want batched stream (v0.7.4), POST
# /objects + POST /refs + bearer auth (v0.7.6), TLS / HTTPS (v0.8.8);
# mTLS is deferred to the 1.7.0 transport-trust minor (roadmap: TLS trust
# hardening; it was 1.5.0 until the themed minor line shifted +1 at 1.4.0).
#
# Bound to 127.0.0.1 only — listening on 0.0.0.0 / a routable
# interface needs explicit threat-model review (a no-auth read path
# leaks ref topology + object content; bearer auth — v0.7.6 — guards
# writes only). Lifting the loopback lock is the 1.5.0 minor.

var SIT_SERVE_DEFAULT_PORT = 8484;
var SIT_SERVE_MAX_BODY = 16777216;  # 16 MiB — advertised in capabilities
# The largest whole request (headers + body) every serve loop buffers: the
# advertised body plus 64 KiB of headers. 1.7.6 (N2): all three loops buffered
# 64 KiB, sandhi's default, while capabilities advertised 16 MiB, so pushing any
# object over ~64 KiB failed over http, https and ssh, and a branch holding one
# could never be pushed again. Literal, not SIT_SERVE_MAX_BODY + 65536, so it
# stays a static initializer.
var SERVE_REQ_MAX = 16842752;
# v0.7.4: cap on the count field of a single POST /want body. 512 × 64-byte
# hashes + the 8-byte count is ~32 KiB, which fit the 64 KiB request buffer the
# server had then; it is a protocol constant now (advertised as batch_max), not
# a buffer bound. See ADR 0006.
var SIT_WANT_MAX_COUNT = 512;

# v0.7.6: bearer auth. ~/.sit/serve.token is the canonical path;
# operators may pin a different file with --token. Token must be
# 16+ hex chars (64-bit minimum entropy assuming random-hex input)
# and the file must be 0600 — anything else is a config bug we
# refuse to start with rather than silently accept a weaker posture.
# `_serve_token` is the loaded value; `_serve_require_auth` is 1
# when --require-auth was set on the command line. POST handlers
# consult both before doing any DB work; GET endpoints stay
# anonymous (the per-ADR-0007 deployment surface assumes loopback
# anyway, so anonymous read is a feature, not a vulnerability).
var _serve_require_auth = 0;
var _serve_token = 0;

# Per-connection TLS context for the response path (bite 3). 0 = plain HTTP
# (responses go through sandhi's raw-socket senders); non-zero = an active
# tls_native server ctx, so the _serve_send_* wrappers build the HTTP/1.0 bytes
# and write them through TLS. The serve loop is single-threaded (sequential
# accept), so a process-global is safe: set before handling a connection,
# cleared after. Default 0 keeps the plain http:// path byte-identical.
var _serve_tls_ctx = 0;
fn _serve_set_tls_ctx(ctx) { _serve_tls_ctx = ctx; return 0; }

# Set when a response write on the TLS keep-alive connection fails part-way.
# The client reads each response by exact Content-Length, so after a partial
# write the stream is desynchronised: the accept loop must close the connection
# rather than read the next request off it. Only the --tls path touches this,
# and that loop is single-threaded (it is why _serve_tls_ctx can be a global).
var _serve_tls_send_failed = 0;

# Time a --tls client gets to finish the handshake, and then each request and
# its response: 60 s, sandhi's plain-HTTP request budget (C2, 1.6.4).
var SERVE_TLS_DEADLINE_NS = 60000000000;

# ── Request arena (C1, 1.7.4) ─────────────────────
#
# The global heap is a bump allocator with no free, and `sit serve` runs until
# it is killed, so anything a request allocates there is kept for good. 1.6.4
# moved the large per-request buffers (object bytes, inflate, /want streams) to
# the freelist; what was left was about 3 KB per request of small allocations,
# and more per ref on GET /refs.
#
# Everything a request allocates now comes from this arena: the parsed method,
# path and headers, the response head, the JSON bodies, the refs walk, the paths
# the push handlers build. serve_handle_request rewinds it before routing, so
# the server settles at its largest request and stops growing. It also covers
# what the stdio and TLS loops allocate while framing a request, since that is
# done before the dispatch that rewinds it.
#
# ⚠ Nothing allocated here may outlive the request. A cached value (the object
# DB handle, the bearer token, TLS credentials) stays on the global heap.
#
# A growable arena: a request that outgrows the first chunk chains another, and
# the chain is kept across rewinds, so a large /refs costs its memory once.
var SERVE_REQ_ARENA_CHUNK = 65536;
var _serve_req_al = 0;

# The request arena, created on first use. The serve loops are single-threaded
# (sandhi_server_run, the --tls loop, --stdio), which is why one is enough.
fn _serve_req_alloc() {
    if (_serve_req_al == 0) {
        _serve_req_al = arena_allocator_growable(SERVE_REQ_ARENA_CHUNK);
        if (_serve_req_al == 0) {
            eprintln("sit: cannot allocate the serve request arena");
            syscall(SYS_EXIT, 1);
        }
    }
    return _serve_req_al;
}

# Content-Length of the request in buf, with the header value taken from `a`.
# sandhi_server_content_length reads it into the global heap on every call, and
# sandhi has no allocator-taking form, so this is the same parse over
# sandhi_server_find_header_a: 0 when absent or malformed, 0 - 1 when the
# digits exceed 0x7FFFFFFF, else the value. Surrounding spaces and tabs are
# allowed; anything else is malformed (RFC 7230 §3.3.2, no "10, 20"). The unit
# and fuzz suites compare the two parsers byte for byte.
var SERVE_CL_MAX = 2147483647;

fn _serve_content_length(a, buf, n) {
    var v = sandhi_server_find_header_a(a, buf, n, "Content-Length");
    if (v == 0) { return 0; }
    var vlen = strlen(v);
    var i = skip_ws(v, 0, vlen);
    if (i >= vlen) { return 0; }
    var val = 0;
    var seen = 0;
    var digits = 1;
    while (digits == 1) {
        var c = load8(v + i);
        if (c < 48) { digits = 0; }
        if (c > 57) { digits = 0; }
        if (digits == 1) {
            val = val * 10 + (c - 48);
            if (val > SERVE_CL_MAX) { return 0 - 1; }
            seen = 1;
            i = i + 1;
        }
    }
    if (seen == 0) { return 0; }
    i = skip_ws(v, i, vlen);
    if (i < vlen) { return 0; }
    return val;
}

# ── Ref-file reader ───────────────────────────────
#
# Read a ref file's content as a 64-char SHA-256 hex string. Strips
# the trailing newline conventionally written by `write_head_ref`
# and friends; rejects anything that doesn't pass `hex_prefix_valid`.
# Returns 0 on any failure (so callers can skip the entry instead of
# aborting the response).
#
# 1.7.4: the file is read into a stack buffer, not the global heap, and only the
# 64 hex are copied out, into `a`. `path` is opened as given: the refs walk
# passes it already resolved. A ref file is 65 bytes, so the read stops past
# SERVE_REF_READ_MAX and a longer file is not a ref. (Through 1.7.3 the whole
# file was read, up to read_file_heap's 64 MiB, to the same verdict.)
var SERVE_REF_READ_MAX = 128;

# Read a ref file for the server: exactly 64 hex after trimming CR/LF, else 0.
fn serve_read_ref_file(a, path) {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var rb[136];                                   # SERVE_REF_READ_MAX + 1 bytes are read at most
    var len = 0;
    var reading = 1;
    while (reading == 1) {
        var got = file_read(fd, &rb + len, SERVE_REF_READ_MAX + 1 - len);
        if (got <= 0) { reading = 0; }
        else {
            len = len + got;
            if (len > SERVE_REF_READ_MAX) { reading = 0; }
        }
    }
    file_close(fd);
    if (len > SERVE_REF_READ_MAX) { return 0; }
    var trimming = 1;
    while (trimming == 1) {
        if (len == 0) { trimming = 0; }
        else {
            var lc = load8(&rb + len - 1) & 0xFF;
            if (lc == 10) { len = len - 1; }
            else {
                if (lc == 13) { len = len - 1; }
                else { trimming = 0; }
            }
        }
    }
    if (len != 64) { return 0; }
    if (hex_prefix_valid(&rb, 64) == 0) { return 0; }
    var out = alloc_via(a, 65);
    if (out == 0) { return 0; }
    memcpy(out, &rb, 64);
    store8(out + 64, 0);
    return out;
}

# ── JSON builders ────────────────────────────────
#
# Hand-rolled JSON because the response shapes are tiny and
# entirely under our control — every field name we emit is a
# constant, and every value either passes `refname_valid` (no
# JSON-escapable bytes) or `hex_prefix_valid` (digits + a-f only).
# Pulling `lib/json.cyr` here would buy nothing and add a dep
# surface inside the hot serve loop.

# Each builder allocates in `a` (the request arena) and returns the body, or 0
# when `a` refused a grow: the `_a` appends then leave the builder unchanged, and
# a refs list short of a ref is worse than a 500.

# JSON body for GET /sit/v1/capabilities, or 0.
fn serve_build_capabilities(a) {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    var bad = 0;
    # The "sit" string identifies the wire-protocol release line the server
    # promises. v1.4.8: it now comes from `sit_version_string()` in the
    # GENERATED src/version.cyr, so it tracks VERSION by construction rather
    # than by hand. It was hand-copied from v0.8.2 through v1.4.7 and drifted
    # twice in that span — stuck at 0.8.10 through v1.0.3, and missed again at
    # 1.4.6 — each time caught only by the CI gate that exists to catch it.
    # Regenerate with scripts/gen-version.sh; CI diffs it like dist/ sync.
    bad = bad | str_builder_add_cstr_a(a, sb, "{\"sit\":\"");
    bad = bad | str_builder_add_cstr_a(a, sb, sit_version_string());
    bad = bad | str_builder_add_cstr_a(a, sb, "\",\"max_body\":");
    bad = bad | str_builder_add_int_a(a, sb, SIT_SERVE_MAX_BODY);
    bad = bad | str_builder_add_cstr_a(a, sb, ",\"auth\":[");
    if (_serve_require_auth == 1) {
        bad = bad | str_builder_add_cstr_a(a, sb, "\"bearer\"");
    }
    else {
        bad = bad | str_builder_add_cstr_a(a, sb, "\"none\"");
    }
    bad = bad | str_builder_add_cstr_a(a, sb, "],\"objects\":true,\"batch\":true,\"batch_max\":");
    bad = bad | str_builder_add_int_a(a, sb, SIT_WANT_MAX_COUNT);
    bad = bad | str_builder_add_cstr_a(a, sb, ",\"push\":true}");
    if (bad != 0) { return 0; }
    var built = str_builder_build_a(a, sb);
    if (built == 0) { return 0; }
    return str_data(built);
}

# Recursively walk one refs subtree (`.sit/refs/heads` or
# `.sit/refs/tags`) appending one JSON object per ref to `sb`.
# `prefix` is the ref namespace ("refs/heads/" / "refs/tags/");
# `dir` is the on-disk path to the corresponding directory;
# `st` is the walk's 16-byte state, shared across BOTH subtrees:
#   +0  1 until the first ref is emitted (later ones get a leading comma)
#   +8  set when `a` refused a grow (the body is then dropped for a 500)
#
# Errors (missing dir, malformed ref content, refnames that fail
# `refname_valid`) silently omit the entry rather than fail the
# whole response. `sit fsck` is the right tool to surface a broken
# ref file; `serve` should keep listing what it can.
#
# 1.7.4 (C1): the walk allocates only in `a`. It used dir_walk, which builds a
# Str, a vec slot and a joined path per entry on the global heap, and those were
# kept for the life of the server: 3.5 KB per GET /refs with two refs, more per
# ref. It now lists each directory with dir_list_into, into buffers taken from
# `a`, and visits entries in the same order dir_walk did (directory order,
# depth-first), so the body is byte-identical.

# dir_list_into's buffers for one directory: the getdents batch, the packed
# names and the offset table. A directory that does not fit is listed again with
# the names and offsets doubled, up to SERVE_DIRLIST_TRIES listings.
var SERVE_DIRLIST_SCRATCH = 4096;
var SERVE_DIRLIST_NAMES = 8192;
var SERVE_DIRLIST_ENTRIES = 256;
var SERVE_DIRLIST_TRIES = 16;
# dir_walk's depth bound (DIR_WALK_MAX_DEPTH), kept from the walk this replaces.
var SERVE_REFS_MAX_DEPTH = 64;

# Append every valid ref under `dir` to the refs JSON being built.
fn serve_emit_refs_subtree(a, sb, prefix, dir, st) {
    # Walk the repo-root-ABSOLUTE dir: the walk is cwd-relative, and over SSH
    # the session cwd is $HOME, not the served repo, so a raw ".sit/refs/heads"
    # walk saw nothing and `serve` advertised zero refs (1.3.2).
    var adir = sit_abs_a(a, dir);
    if (adir == 0) { store64(st + 8, 1); return 0; }
    # 1.12.2 (S4, K4): a real directory, reached through real directories. A
    # `.sit/refs/heads` linked to another repository's listed all its heads.
    if (_sf_parent_symlink(dir) == 1) { return 0; }
    if (path_lstat_kind(adir) != 0x4000) { return 0; }
    return _serve_emit_refs_dir(a, sb, prefix, adir, 0, st);
}

# One directory of the walk: `adir` is its resolved path and `prefix` its ref
# name with the trailing '/'. A real directory is descended. A regular file, or a
# symlink to one, is read as a ref, as dir_walk listed both. Anything else is
# skipped: through 1.7.3 a FIFO (or a symlink to one) was opened for reading,
# which blocked the single-threaded server until a writer appeared.
fn _serve_emit_refs_dir(a, sb, prefix, adir, depth, st) {
    if (depth > SERVE_REFS_MAX_DEPTH) { return 0; }
    var path_str = str_from_a(a, adir);
    var scratch = alloc_via(a, SERVE_DIRLIST_SCRATCH);
    if (path_str == 0) { store64(st + 8, 1); return 0; }
    if (scratch == 0) { store64(st + 8, 1); return 0; }
    var names_cap = SERVE_DIRLIST_NAMES;
    var max_entries = SERVE_DIRLIST_ENTRIES;
    var names = 0;
    var offs = 0;
    var count = 0;
    var tries = 0;
    var listing = 1;
    while (listing == 1) {
        names = alloc_via(a, names_cap);
        offs = alloc_via(a, max_entries * 8);
        if (names == 0) { store64(st + 8, 1); return 0; }
        if (offs == 0) { store64(st + 8, 1); return 0; }
        count = dir_list_into(path_str, scratch, SERVE_DIRLIST_SCRATCH,
          names, names_cap, offs, max_entries);
        listing = 0;
        tries = tries + 1;
        if (tries < SERVE_DIRLIST_TRIES) {
            if (count == 0 - 3) { names_cap = names_cap * 2; listing = 1; }
            if (count == 0 - 4) { max_entries = max_entries * 2; listing = 1; }
        }
    }
    if (count < 0) { return 0; }                   # unreadable: omitted, as dir_walk did
    var plen = strlen(prefix);
    var dlen = strlen(adir);
    var i = 0;
    while (i < count) {
        var nm = names + load64(offs + i * 8);
        var nl = strlen(nm);
        var child = alloc_via(a, dlen + 1 + nl + 1);
        var rname = alloc_via(a, plen + nl + 2);
        if (child == 0) { store64(st + 8, 1); return 0; }
        if (rname == 0) { store64(st + 8, 1); return 0; }
        memcpy(child, adir, dlen);
        store8(child + dlen, 47);                  # '/'
        memcpy(child + dlen + 1, nm, nl);
        store8(child + dlen + 1 + nl, 0);
        memcpy(rname, prefix, plen);
        memcpy(rname + plen, nm, nl);
        store8(rname + plen + nl, 0);
        var kind = path_lstat_kind(child);
        if (kind == 0x4000) {
            store8(rname + plen + nl, 47);         # "<prefix><dir>/"
            store8(rname + plen + nl + 1, 0);
            _serve_emit_refs_dir(a, sb, rname, child, depth + 1, st);
        }
        if (kind == 0x8000) { _serve_emit_ref(a, sb, rname, child, st); }
        # A link to a ref file is listed, as dir_walk listed it — 1.12.2 (S4):
        # only one that stays in the refs tree. A link planted in a served
        # repository published whatever 64 hex it reached, another repository's
        # tips among them (under --repos, another tenant's).
        if (kind == 0xA000) {
            if (_serve_ref_link_inside(child) == 1) { _serve_emit_ref(a, sb, rname, child, st); }
        }
        i = i + 1;
    }
    return 0;
}

# 1 when the symlink at `path` (a ref) names, relatively and without `..`, a
# regular file beside or below it through real directories: one hop, inside the
# refs tree. (K4: a directory link on the way, `d -> <elsewhere>` with
# `evil -> d/main`, reached out of it.)
fn _serve_ref_link_inside(path) {
    var t[256];
    var tn = xreadlink(path, &t, 255);
    if (tn <= 0) { return 0; }
    if (tn >= 255) { return 0; }
    store8(&t + tn, 0);
    if (load8(&t) == 47) { return 0; }
    if (strstr(&t, "..") >= 0) { return 0; }
    var pl = strlen(path);
    var d = pl;
    var seeking = 1;
    while (seeking == 1) {
        if (d <= 0) { seeking = 0; }
        else {
            if (load8(path + d - 1) == 47) { seeking = 0; }
            else { d = d - 1; }
        }
    }
    if (d + tn + 1 > 4352) { return 0; }
    var j[4352];
    memcpy(&j, path, d);
    memcpy(&j + d, &t, tn + 1);
    var k = 0;
    var ok = 1;
    while (k < tn) {
        if (load8(&t + k) == 47) {
            store8(&j + d + k, 0);
            if (path_lstat_kind(&j) != 0x4000) { ok = 0; }
            store8(&j + d + k, 47);
        }
        k = k + 1;
    }
    if (ok == 0) { return 0; }
    if (path_lstat_kind(&j) != 0x8000) { return 0; }
    return 1;
}

# Append `{"name":…,"hash":…}` for the ref file at `path`, if the name is a valid
# ref name and the file holds one.
fn _serve_emit_ref(a, sb, rname, path, st) {
    if (refname_valid(rname) == 0) { return 0; }
    var hex = serve_read_ref_file(a, path);
    if (hex == 0) { return 0; }
    var bad = 0;
    if (load64(st) == 0) { bad = bad | str_builder_add_cstr_a(a, sb, ","); }
    bad = bad | str_builder_add_cstr_a(a, sb, "{\"name\":\"");
    bad = bad | str_builder_add_cstr_a(a, sb, rname);
    bad = bad | str_builder_add_cstr_a(a, sb, "\",\"hash\":\"");
    bad = bad | str_builder_add_cstr_a(a, sb, hex);
    bad = bad | str_builder_add_cstr_a(a, sb, "\"}");
    if (bad != 0) { store64(st + 8, 1); }
    store64(st, 0);
    return 0;
}

# JSON body for GET /sit/v1/refs (heads and tags), or 0.
fn serve_build_refs(a) {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    var st[16];
    store64(&st, 1);
    store64(&st + 8, 0);
    if (str_builder_add_cstr_a(a, sb, "{\"refs\":[") != 0) { return 0; }
    serve_emit_refs_subtree(a, sb, "refs/heads/", ".sit/refs/heads", &st);
    serve_emit_refs_subtree(a, sb, "refs/tags/",  ".sit/refs/tags",  &st);
    if (str_builder_add_cstr_a(a, sb, "]}") != 0) { return 0; }
    if (load64(&st + 8) != 0) { return 0; }
    var built = str_builder_build_a(a, sb);
    if (built == 0) { return 0; }
    return str_data(built);
}

# ── TLS-aware response senders (bite 3) ──
#
# Every serve handler emits through these instead of sandhi_server_send_*
# directly. On a plain HTTP connection (_serve_tls_ctx == 0) they delegate
# verbatim to sandhi (byte-identical to the pre-bite-3 behavior). On a TLS
# connection they build the same HTTP/1.0 response and write it through
# tls_native via _wire_io_send (which fragments into <= 16 KB records). The
# `extra` header string (e.g. "X-Sit-Type: <n>\r\n") already carries its own
# trailing CRLF, so it is appended verbatim.

# Emit "HTTP/1.0 <code> <msg>\r\n" into buf at pos; returns the new pos.
fn _serve_emit_status_line(buf, pos, code, msg) {
    memcpy(buf + pos, "HTTP/1.0 ", 9); pos = pos + 9;
    pos = pos + write_decimal(buf + pos, code);
    store8(buf + pos, 32); pos = pos + 1;          # ' '
    var ml = strlen(msg);
    memcpy(buf + pos, msg, ml); pos = pos + ml;
    store8(buf + pos, 13); pos = pos + 1;          # \r
    store8(buf + pos, 10); pos = pos + 1;          # \n
    return pos;
}

# Both senders build the response head in the request arena (C1, 1.7.4).
fn _serve_send_status(cfd, code, msg) {
    var a = _serve_req_alloc();
    if (_serve_tls_ctx == 0) { return sandhi_server_send_status_a(a, cfd, code, msg); }
    var ml = strlen(msg);
    var buf = alloc_via(a, 64 + ml);
    if (buf == 0) {
        _serve_tls_send_failed = 1;                # no response: close, don't leave the client waiting
        return 0 - 1;
    }
    var pos = _serve_emit_status_line(buf, 0, code, msg);
    memcpy(buf + pos, "Content-Length: 0\r\nConnection: keep-alive\r\n\r\n", 45);
    pos = pos + 45;
    if (_wire_io_send(_serve_tls_ctx, cfd, buf, pos) != 0) {
        _serve_tls_send_failed = 1;
        return 0 - 1;
    }
    return 0;
}

fn _serve_send_response(cfd, code, msg, ctype, body, body_len, extra) {
    var a = _serve_req_alloc();
    if (_serve_tls_ctx == 0) {
        return sandhi_server_send_response_a(a, cfd, code, msg, ctype, body, body_len, extra);
    }
    var ctl = strlen(ctype);
    var el = 0;
    if (extra != 0) { el = strlen(extra); }
    var clen_buf[24];
    var clen_digits = write_decimal(&clen_buf, body_len);
    var hdr = alloc_via(a, 96 + ctl + el + clen_digits);
    if (hdr == 0) {
        _serve_tls_send_failed = 1;
        return 0 - 1;
    }
    var pos = _serve_emit_status_line(hdr, 0, code, msg);
    memcpy(hdr + pos, "Content-Type: ", 14); pos = pos + 14;
    memcpy(hdr + pos, ctype, ctl); pos = pos + ctl;
    store8(hdr + pos, 13); pos = pos + 1; store8(hdr + pos, 10); pos = pos + 1;
    memcpy(hdr + pos, "Content-Length: ", 16); pos = pos + 16;
    memcpy(hdr + pos, &clen_buf, clen_digits); pos = pos + clen_digits;
    store8(hdr + pos, 13); pos = pos + 1; store8(hdr + pos, 10); pos = pos + 1;
    if (el > 0) { memcpy(hdr + pos, extra, el); pos = pos + el; }   # extra carries its own CRLF
    memcpy(hdr + pos, "Connection: keep-alive\r\n\r\n", 26); pos = pos + 26;
    var send_rc = _wire_io_send(_serve_tls_ctx, cfd, hdr, pos);
    if (send_rc == 0) {
        if (body_len > 0) { send_rc = _wire_io_send(_serve_tls_ctx, cfd, body, body_len); }
    }
    if (send_rc != 0) {
        _serve_tls_send_failed = 1;
        return 0 - 1;
    }
    return 0;
}

# ── /sit/v1/objects/<hash> handler ──────────────────────────
#
# Returns the raw compressed bytes of an object addressed by its
# 64-hex SHA-256. The patra type code rides on an X-Sit-Type
# response header so the client can persist it in its local
# objects.patra without re-deriving from the decompressed body.
#
# The request hash is validated as 64-hex via hex_prefix_valid
# before any DB lookup — we won't hand attacker-controlled bytes
# to a string-concatenated SQL statement, even though
# db_object_read_raw embeds it inside single quotes (the validator
# is the trust boundary; the SQL shape is a defence in depth).
#
# 400 if the path tail isn't 64 hex chars; 404 if the object isn't
# present; 200 with the compressed bytes otherwise. No retry/range
# semantics in v0.7.3 — the body is sent in one shot under the
# advertised SIT_SERVE_MAX_BODY ceiling. Decompression bombs are
# not a serve concern: the bytes are the bytes the repo already
# stores, and the server-side store has already accepted them.

var SIT_OBJECT_PATH_PREFIX = "/sit/v1/objects/";
var SIT_OBJECT_PATH_PREFIX_LEN = 16;

# GET /sit/v1/objects/<hex>: the stored compressed bytes, type in X-Sit-Type.
fn serve_handle_object(cfd, path) {
    var plen = strlen(path);
    if (plen != SIT_OBJECT_PATH_PREFIX_LEN + 64) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    var hex = path + SIT_OBJECT_PATH_PREFIX_LEN;
    if (hex_prefix_valid(hex, 64) == 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    var db = get_object_db();
    if (db == 0) {
        _serve_send_status(cfd, 500, "Internal Server Error");
        return 0;
    }
    # db_object_read_raw is in wire.cyr; out layout is
    # {compressed_ptr@0, clen@8, ty@16}. Returns 0 on success,
    # negative on missing/error — we map both to 404 so we don't
    # leak whether the row missed vs the read error'd.
    var raw[24];
    if (db_object_read_raw(db, hex, &raw) != 0) {
        _serve_send_status(cfd, 404, "Not Found");
        return 0;
    }
    var compressed = load64(&raw);
    var clen = load64(&raw + 8);
    var ty = load64(&raw + 16);
    if (clen <= 0) {
        _serve_send_status(cfd, 404, "Not Found");
        return 0;
    }
    if (clen > SIT_SERVE_MAX_BODY) {
        # An object larger than the advertised cap means the repo
        # has accreted state newer than this server promises to
        # serve. Refuse rather than misadvertise.
        fl_free(compressed);
        _serve_send_status(cfd, 413, "Payload Too Large");
        return 0;
    }
    # Build "X-Sit-Type: <int>\r\n" — sandhi appends extra_headers
    # verbatim to the response, so the trailing CRLF is on us.
    var ty_buf[24];
    var ty_digits = write_decimal(&ty_buf, ty);
    var hdr_len = 13 + ty_digits + 2;
    var hdr = alloc_via(_serve_req_alloc(), hdr_len + 1);
    if (hdr == 0) {
        fl_free(compressed);
        _serve_send_status(cfd, 500, "Internal Server Error");
        return 0;
    }
    memcpy(hdr, "X-Sit-Type: ", 12);
    memcpy(hdr + 12, &ty_buf, ty_digits);
    store8(hdr + 12 + ty_digits, 13);
    store8(hdr + 12 + ty_digits + 1, 10);
    store8(hdr + 12 + ty_digits + 2, 0);
    _serve_send_response(cfd, 200, "OK", "application/octet-stream",
      compressed, clen, hdr);
    # C1 (1.6.4): db_object_read_raw hands back freelist memory; a long-running
    # server releases it after every response (it grew ~1 MiB of RSS per GET
    # of a 1 MiB object, from anonymous clients, without bound).
    fl_free(compressed);
    return 0;
}

# ── /sit/v1/want batched object stream (v0.7.4) ────────────────────
#
# Request body shape (per ADR 0006):
#   8 bytes  : count (i64 LE)
#   count*64 : ASCII hex hashes
#
# Response body: concatenation of per-object frames:
#   64 bytes : ASCII hex hash
#    8 bytes : ty (i64 LE) — 0=blob, 1=tree, 2=commit
#    8 bytes : clen (i64 LE) — compressed payload length
#    clen B  : zlib-compressed object content
#
# Hashes the server doesn't have are silently omitted from the
# response. The client compares response frame count to the request
# count to detect missing objects (and fall back to per-object GET
# for those, or report failure to the user).
#
# Validation: any malformed input → 400. Body length must equal
# 8 + count*64 exactly; count must fit in [0, SIT_WANT_MAX_COUNT];
# every 64-byte hash slot must pass hex_prefix_valid before any DB
# lookup. Endianness: native LE on x86_64/aarch64 — load64/store64
# do the right thing without explicit byteswaps.

# POST /sit/v1/want: batched object fetch (ADR 0006 frame format).
fn serve_handle_want(cfd, buf, n) {
    var body_off = sandhi_server_body_offset(buf, n);
    if (body_off < 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    # S-25: cap before the `body_off + clen` sum below, so a near-i64-max
    # Content-Length cannot wrap it negative and slip past the framing check.
    # (The exact `clen != expected_clen` test further down happened to catch
    # that case anyway; this makes it structural rather than incidental, and
    # matches the ordering already used by serve_handle_put_object.)
    var clen = content_length_sane(
      _serve_content_length(_serve_req_alloc(), buf, n), SIT_SERVE_MAX_BODY);
    if (clen <= 0) {
        _serve_send_status(cfd, 411, "Length Required");
        return 0;
    }
    if (clen < 8) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    if (body_off + clen > n) {
        # sandhi_server_recv_request reads until full body; if we land
        # here the request was malformed at the framing layer.
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    var body = buf + body_off;
    var count = load64(body);
    if (count < 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    if (count > SIT_WANT_MAX_COUNT) {
        _serve_send_status(cfd, 413, "Payload Too Large");
        return 0;
    }
    var expected_clen = 8 + count * 64;
    if (clen != expected_clen) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }

    # Pre-validate every hash before any DB work — keeps the failure
    # mode "all 400 or full success", no half-emitted response.
    var i = 0;
    while (i < count) {
        if (hex_prefix_valid(body + 8 + i * 64, 64) == 0) {
            _serve_send_status(cfd, 400, "Bad Request");
            return 0;
        }
        i = i + 1;
    }

    var db = get_object_db();
    if (db == 0) {
        _serve_send_status(cfd, 500, "Internal Server Error");
        return 0;
    }

    # Build the response stream into a growing fl_alloc buffer.
    var resp_cap = 65536;
    var resp = fl_alloc(resp_cap);
    if (resp == 0) {
        _serve_send_status(cfd, 500, "Internal Server Error");
        return 0;
    }
    var resp_used = 0;
    i = 0;
    while (i < count) {
        var hex = body + 8 + i * 64;
        var raw[24];
        if (db_object_read_raw(db, hex, &raw) == 0) {
            var compressed = load64(&raw);
            var obj_clen = load64(&raw + 8);
            var ty = load64(&raw + 16);
            if (obj_clen > 0) {
                var frame_len = 64 + 8 + 8 + obj_clen;
                # Grow the response buffer: double until the frame fits or the
                # body ceiling is reached. 1.6.4 (C8): this refused as soon as
                # ONE doubling was not enough, so any first frame over ~128 KiB
                # got 413 (the "grow again" branch was dead) and the client fell
                # back to per-object GETs for the rest of the fetch.
                if (resp_used + frame_len > resp_cap) {
                    var new_cap = resp_cap;
                    var growing = 1;
                    while (growing == 1) {
                        new_cap = new_cap * 2;
                        if (new_cap >= resp_used + frame_len) { growing = 0; }
                        if (new_cap >= SIT_SERVE_MAX_BODY) { growing = 0; }
                    }
                    if (new_cap > SIT_SERVE_MAX_BODY) { new_cap = SIT_SERVE_MAX_BODY; }
                    if (resp_used + frame_len > new_cap) {
                        # At the ceiling and it still doesn't fit — refuse
                        # rather than serve a truncated stream.
                        fl_free(compressed);
                        fl_free(resp);
                        _serve_send_status(cfd, 413, "Payload Too Large");
                        return 0;
                    }
                    var new_resp = fl_alloc(new_cap);
                    if (new_resp == 0) {
                        fl_free(compressed);
                        fl_free(resp);
                        _serve_send_status(cfd, 500, "Internal Server Error");
                        return 0;
                    }
                    memcpy(new_resp, resp, resp_used);
                    fl_free(resp);
                    resp = new_resp;
                    resp_cap = new_cap;
                }
                memcpy(resp + resp_used, hex, 64);
                store64(resp + resp_used + 64, ty);
                store64(resp + resp_used + 72, obj_clen);
                memcpy(resp + resp_used + 80, compressed, obj_clen);
                resp_used = resp_used + frame_len;
            }
            # C1: the object copy is freelist memory — release it per object
            # rather than holding every one for the life of the server.
            fl_free(compressed);
        }
        # else: object missing from this DB — silently omit.
        i = i + 1;
    }

    _serve_send_response(cfd, 200, "OK", "application/octet-stream",
      resp, resp_used, 0);
    fl_free(resp);
    return 0;
}

# ── Bearer auth (v0.7.6) ──────────────────────────────
#
# `_serve_load_token(path)` — read a token file from disk. Returns
# the heap-allocated cstring on success, 0 on any failure (missing
# file, wrong perms, too-short content, embedded NUL/control bytes).
# Caller (cmd_serve) refuses to start the server if 0 is returned
# so the auth posture is "strictly enforced or absent" — never a
# silent fall-through to no-auth.
#
# Perm check: must be 0600 exactly. fstat via newfstatat (validate.cyr's
# AT_FDCWD shape). Stricter than git's "<= 0600" — sit's token file
# has no legitimate group/world-readable use, so any wider mode is
# a configuration mistake worth refusing.
fn _serve_load_token(path) {
    return token_file_load(path, "serve token");
}

# Returns 1 if the request carries a valid `Authorization: Bearer <token>`
# header that constant-time-equals the loaded `_serve_token`. Returns 0
# otherwise. Consulted by POST handlers when `_serve_require_auth == 1`.
# Constant-time comparison: walk the full minimum length even on a length
# mismatch so the timing doesn't reveal the prefix the attacker got right.
fn _serve_auth_ok(buf, n) {
    if (_serve_require_auth == 0) { return 1; }
    if (_serve_token == 0) { return 0; }
    var hdr = sandhi_server_find_header_a(_serve_req_alloc(), buf, n, "Authorization");
    if (hdr == 0) { return 0; }
    # Expect literal "Bearer " prefix (case-sensitive, matching git's
    # http.extraHeader convention). Eight bytes including the space.
    var hlen = strlen(hdr);
    if (hlen <= 7) { return 0; }
    if (memeq(hdr, "Bearer ", 7) == 0) { return 0; }
    var presented = hdr + 7;
    var plen = hlen - 7;
    var tlen = strlen(_serve_token);
    # Constant-time compare across max(plen, tlen) — works even when
    # lengths differ. Mismatch-flag accumulates via OR across all bytes.
    var max_len = plen;
    if (tlen > max_len) { max_len = tlen; }
    var mismatch = 0;
    if (plen != tlen) { mismatch = 1; }
    var ci = 0;
    while (ci < max_len) {
        var pc = 0;
        var tc = 0;
        if (ci < plen) { pc = load8(presented + ci) & 0xFF; }
        if (ci < tlen) { tc = load8(_serve_token + ci) & 0xFF; }
        if ((pc ^ tc) != 0) { mismatch = 1; }
        ci = ci + 1;
    }
    if (mismatch == 0) { return 1; }
    return 0;
}

# ── /sit/v1/objects/<hash> POST handler (v0.7.6) ──────────────────
#
# Accepts a single compressed sit object from a pushing client.
# Trust boundary: the server REHASHES every uploaded object. The
# claimed hex in the URL must match the SHA-256 of the decompressed
# content (in its full `<type> <len>\0<content>` framed form, the
# same shape that `write_typed_object` hashes locally). The X-Sit-
# Type request header must also agree with the type prefix on the
# decompressed body. Either mismatch → 400.
#
# The rehash is the only place sit pays SHA-256 cost on the wire
# path (CLAUDE.md "SHA-256 roundtrips belong in fsck, not the hot
# path") — but accepted-from-the-network bytes are precisely the
# point where the trust boundary lives. fetch + clone copy raw
# compressed bytes from a server we already trust; push has no such
# upstream trust and must verify what the client claims to be
# uploading.
#
# Returns: 201 Created on success (object stored); 200 OK if already
# present (idempotent); 400 on any validation failure (hex format,
# ty range, body framing, hash mismatch, type-prefix mismatch);
# 401/403 from the caller-side auth wrapper if not authenticated;
# 500 on DB / OOM. Body of any error response is empty (don't leak
# which validation step failed — the caller can compare locally).

fn _serve_rehash_and_insert(cfd, hex, claimed_ty, compressed, clen) {
    # Decompress to verify framing + recompute hash. _decompress_raw_into
    # (src/wire.cyr) inflates through obj_inflate_fl, the shared sizing.
    # raw[24] = {compressed, clen, ty}.
    var raw[24];
    store64(&raw,      compressed);
    store64(&raw +  8, clen);
    store64(&raw + 16, claimed_ty);
    var deco[24];
    if (_decompress_raw_into(&raw, &deco) != 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    var code = _serve_verify_and_insert(hex, claimed_ty, compressed, clen, &deco);
    # C1 (1.6.4): the inflate buffer (up to 16 MiB) is freed per push.
    fl_free(load64(&deco));
    if (code == 200) { _serve_send_status(cfd, 200, "OK"); return 0; }
    if (code == 201) { _serve_send_status(cfd, 201, "Created"); return 0; }
    if (code == 500) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    _serve_send_status(cfd, 400, "Bad Request");
    return 0;
}

# The checks behind _serve_rehash_and_insert, on an already-inflated object:
# framing type == claimed type, SHA-256 == the requested id, then insert.
# Returns the HTTP status to answer with (200 already present, 201 stored,
# 400 rejected, 500 storage error).
fn _serve_verify_and_insert(hex, claimed_ty, compressed, clen, deco) {
    # Framing type == claimed type, SHA-256 of the framed bytes == the id: the
    # same check fetch makes on what it receives (1.7.6, _object_verify).
    if (_object_verify(hex, claimed_ty, deco) != 0) { return 400; }
    # 1.7.6 (R12): a commit every reader refuses (headers out of git's order)
    # is not taken in — the server's own fsck would call it bad.
    if (claimed_ty == 2) {
        var cinfo[56];
        var cb = load64(deco);
        var cl = load64(deco + 8);
        var co = load64(deco + 16);
        if (parse_commit_body_a(_serve_req_alloc(), cb + co, cl - co, &cinfo) != 0) { return 400; }
    }

    # Hash matches. Insert the original compressed bytes. db_object_insert_raw
    # returns 0 on actual insert, 1 on already-present, negative on error.
    var db = get_object_db();
    if (db == 0) { return 500; }
    var rc = db_object_insert_raw(db, hex, claimed_ty, compressed, clen);
    if (rc < 0) { return 500; }
    if (rc == 1) { return 200; }
    return 201;
}

# POST /sit/v1/objects/<hex>: validate framing, type and SHA-256, then store.
fn serve_handle_put_object(cfd, path, buf, n) {
    var plen = strlen(path);
    if (plen != SIT_OBJECT_PATH_PREFIX_LEN + 64) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    var hex = path + SIT_OBJECT_PATH_PREFIX_LEN;
    if (hex_prefix_valid(hex, 64) == 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    var ty_hdr = sandhi_server_find_header_a(_serve_req_alloc(), buf, n, "X-Sit-Type");
    if (ty_hdr == 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    # Parse decimal int from header value. Accept exactly one of "0", "1", "2".
    var ty_len = strlen(ty_hdr);
    if (ty_len != 1) { _serve_send_status(cfd, 400, "Bad Request"); return 0; }
    var ty_c = load8(ty_hdr);
    if (ty_c < 48) { _serve_send_status(cfd, 400, "Bad Request"); return 0; }
    if (ty_c > 50) { _serve_send_status(cfd, 400, "Bad Request"); return 0; }
    var ty = ty_c - 48;

    var body_off = sandhi_server_body_offset(buf, n);
    if (body_off < 0) { _serve_send_status(cfd, 400, "Bad Request"); return 0; }
    var clen = _serve_content_length(_serve_req_alloc(), buf, n);
    if (clen <= 0) { _serve_send_status(cfd, 411, "Length Required"); return 0; }
    if (clen > SIT_SERVE_MAX_BODY) { _serve_send_status(cfd, 413, "Payload Too Large"); return 0; }
    if (body_off + clen > n) { _serve_send_status(cfd, 400, "Bad Request"); return 0; }

    var compressed = buf + body_off;
    return _serve_rehash_and_insert(cfd, hex, ty, compressed, clen);
}

# ── /sit/v1/refs/<name> POST handler (v0.7.6) ─────────────────────
#
# Updates a single ref. Path tail is the ref name (without the
# `refs/heads/` or `refs/tags/` prefix that GET /refs returns —
# clients pass the namespace); body is the new 64-hex tip optionally
# followed by `\n`. Refs in `refs/remotes/...` are server-side
# state that clients can't directly write — refused with 400.
#
# Fast-forward gate: if the ref already exists, the new tip must be
# a descendant of the current tip. Non-FF returns 409 Conflict.
# Refs that don't exist yet are created (initial push).
#
# The new tip's commit must already be in objects.patra — push
# clients are expected to upload all reachable objects before the
# ref update. We don't transitively walk to verify completeness
# (that's the client's job per ADR 0006's protocol shape); we DO
# require the tip to exist locally, which is a cheap defense
# against accidentally pointing a ref at a hash the server has
# never seen.

var SIT_REF_PUT_PREFIX = "/sit/v1/refs/";
var SIT_REF_PUT_PREFIX_LEN = 13;

# POST /sit/v1/refs/<name>: validate the ref name and hex, then update the ref.
fn serve_handle_put_ref(cfd, path, buf, n) {
    var plen = strlen(path);
    if (plen <= SIT_REF_PUT_PREFIX_LEN) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    var rname_start = path + SIT_REF_PUT_PREFIX_LEN;
    var rname_len = plen - SIT_REF_PUT_PREFIX_LEN;
    # Materialize as a cstring for refname_valid. Every buffer this handler
    # builds comes from the request arena (C1, 1.7.4).
    var a = _serve_req_alloc();
    var rname = alloc_via(a, rname_len + 1);
    if (rname == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    memcpy(rname, rname_start, rname_len);
    store8(rname + rname_len, 0);
    if (refname_valid(rname) == 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    # Refuse refs/remotes/* — those are local state for tracking other
    # remotes; they have no meaning on the server side and would let a
    # malicious client smuggle a fake remote-tracking entry.
    # `refs/remotes/` is 13 bytes, so the guard is >= 13. At rname_len == 12 the
    # old `>= 12` guard let memeq read the 13th byte — in bounds (the buffer is
    # rname_len + 1 and byte 12 is the NUL) and the comparison still failed
    # correctly, but the guard read as an overread. Tightened for clarity.
    if (rname_len >= 13) {
        if (memeq(rname, "refs/remotes/", 13) == 1) {
            _serve_send_status(cfd, 400, "Bad Request");
            return 0;
        }
    }
    # Restrict v0.7.6 to refs/heads/* and refs/tags/* explicitly. Other
    # namespaces (refs/notes/*, refs/keep/*) aren't part of sit's wire
    # vocabulary today.
    var is_head = 0;
    var is_tag = 0;
    if (rname_len > 11) { if (memeq(rname, "refs/heads/", 11) == 1) { is_head = 1; } }
    if (rname_len > 10) { if (memeq(rname, "refs/tags/",  10) == 1) { is_tag  = 1; } }
    if (is_head == 0) {
        if (is_tag == 0) {
            _serve_send_status(cfd, 400, "Bad Request");
            return 0;
        }
    }

    # v0.8.4: denyCurrentBranch. Mirrors git's default behavior — refuse
    # pushes whose target branch is the server's checked-out HEAD. Pushing
    # to the checked-out branch silently advances the ref while leaving the
    # working tree stale, which surprises anyone editing on the remote.
    # 423 Locked distinguishes this from 409 Conflict (non-FF) on the wire
    # so the client can surface the right error.
    #
    # Only matters for refs/heads/* — tags don't have a "checked-out"
    # concept. Detached HEAD (HEAD content is a raw hash, not "ref:") makes
    # read_head_ref_path return 0, so the check no-ops in that state.
    #
    # Initial pushes to empty remotes: if the target ref file doesn't
    # exist yet, allow — matches git's denyCurrentBranch behavior.
    # First push to a fresh remote is the canonical way to bootstrap.
    # The existence check happens against the same on-disk ref path the FF
    # check below uses.
    #
    # The on-disk path: ".sit/<rname>". rname already passed refname_valid so
    # no traversal possible. `adisk` is it resolved against the repo root.
    var disk_path = alloc_via(a, rname_len + 6);
    if (disk_path == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    memcpy(disk_path, ".sit/", 5);
    memcpy(disk_path + 5, rname, rname_len);
    store8(disk_path + 5 + rname_len, 0);
    var adisk = sit_abs_a(a, disk_path);
    if (adisk == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    if (is_head == 1) {
        var server_head = read_head_ref_path_a(a);
        if (server_head != 0) {
            if (streq(server_head, rname) == 1) {
                # Probe the on-disk ref to gate the bypass; ensure_parent_dirs
                # happens at write time so this read is safe pre-write. 1.7.6:
                # lstat — file_exists opens it, so an unreadable ref looked
                # absent and a FIFO there blocked the server.
                if (path_lstat_kind(adisk) >= 0) {
                    var msg = "refusing to update checked-out branch (denyCurrentBranch)\n";
                    _serve_send_response(cfd, 423, "Locked", "text/plain",
                      msg, strlen(msg), 0);
                    return 0;
                }
            }
        }
    }

    var body_off = sandhi_server_body_offset(buf, n);
    if (body_off < 0) { _serve_send_status(cfd, 400, "Bad Request"); return 0; }
    var clen = _serve_content_length(_serve_req_alloc(), buf, n);
    # Body must be exactly 64 hex chars, optionally followed by '\n'.
    if (clen != 64) {
        if (clen != 65) {
            _serve_send_status(cfd, 400, "Bad Request");
            return 0;
        }
    }
    if (body_off + clen > n) { _serve_send_status(cfd, 400, "Bad Request"); return 0; }
    var body = buf + body_off;
    if (hex_prefix_valid(body, 64) == 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }
    if (clen == 65) {
        if (load8(body + 64) != 10) {
            _serve_send_status(cfd, 400, "Bad Request");
            return 0;
        }
    }
    var new_hex = alloc_via(a, 65);
    if (new_hex == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    memcpy(new_hex, body, 64);
    store8(new_hex + 64, 0);

    # The new tip must already be in objects.patra (pushed by the
    # client via /sit/v1/objects before this call). No transitive
    # check.
    var db = get_object_db();
    if (db == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    # 1.7.6 (N4): and it must be something a ref can name — a commit for a
    # branch, a commit or an annotated tag for a tag. Existence alone let a push
    # point a branch at a blob.
    var nty = db_object_type(db, new_hex);
    var ty_ok = 0;
    if (nty == 2) { ty_ok = 1; }
    if (is_tag == 1) { if (nty == 3) { ty_ok = 1; } }
    if (ty_ok == 0) {
        _serve_send_status(cfd, 400, "Bad Request");
        return 0;
    }

    # Existing tip? FF check via is_ancestor_in_db.
    #
    # 1.7.6: existence is lstat's answer. file_exists opens the file, so a ref
    # that could not be read was "absent" — the push then created it over the
    # old tip with no fast-forward check — and a FIFO there blocked the server.
    var rkind = path_lstat_kind(adisk);
    if (rkind >= 0) {
        # Refuse to follow a symlink on the ref file itself (S-04), or to read
        # anything but a regular file. 1.7.4: on the resolved path. It was
        # handed the repo-relative one, so with the served repo anywhere but the
        # cwd the guard looked at the wrong file (sf_write_atomic below refuses
        # to write through a symlink regardless).
        if (rkind != 0x8000) {
            _serve_send_status(cfd, 500, "Internal Server Error");
            return 0;
        }
        var rbuf[128];
        var nr = file_read_all(adisk, &rbuf, 128);
        if (nr < 64) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
        if (hex_prefix_valid(&rbuf, 64) == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
        var cur = alloc_via(a, 65);
        if (cur == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
        memcpy(cur, &rbuf, 64);
        store8(cur + 64, 0);
        if (memeq(cur, new_hex, 64) == 1) {
            # No-op update — tip already at the new hex.
            _serve_send_status(cfd, 200, "OK");
            return 0;
        }
        # Heads must be FF; tags are immutable (any update — including
        # the same value — is a no-op above; a different value is
        # refused).
        if (is_tag == 1) {
            _serve_send_status(cfd, 409, "Conflict");
            return 0;
        }
        # 1.7.6 (N4): the walk gets the request budget the TLS loop already
        # gives a request (60 s); past it the push is answered 503.
        _wire_walk_deadline_ns = clock_now_ns() + SERVE_TLS_DEADLINE_NS;
        var anc = is_ancestor_in_db(db, cur, new_hex);
        _wire_walk_deadline_ns = 0;
        if (anc < 0) {
            _serve_send_status(cfd, 503, "Service Unavailable");
            return 0;
        }
        if (anc == 0) {
            _serve_send_status(cfd, 409, "Conflict");
            return 0;
        }
    }

    # Written through `<ref>.lock` (O_EXCL), fsync, rename (1.7.6, N6): a
    # crash leaves the old tip or the new one, never an empty ref, and a second
    # writer racing this one is refused rather than interleaved.
    var wbuf[72];
    memcpy(&wbuf, new_hex, 64);
    store8(&wbuf + 64, 10);
    ensure_parent_dirs(disk_path);
    if (sf_write_atomic(disk_path, &wbuf, 65) < 0) {
        _serve_send_status(cfd, 500, "Internal Server Error");
        return 0;
    }
    _serve_send_status(cfd, 200, "OK");
    return 0;
}

# ── Request dispatcher ──────────────────────────────
#
# Signature dictated by sandhi: (ctx, cfd, req_buf, req_len) → 0.
# `ctx` is unused in v0.7.3; v0.7.5+ will pass the bearer-token
# config + auth state through it.

# Route one parsed request to its handler.
#
# C1 (1.7.4): the request arena is rewound first, which reclaims the previous
# request and whatever its loop allocated framing this one. Nothing in it is
# read after the rewind: every handler has sent its response by the time it
# returns, and the loops keep only integers (lengths, offsets) across it.
#
# 1.11.0: each request is a store session (object_db.cyr) — the store lock is
# held for the request, not from the first request to exit, so `sit gc` can run
# between requests and the next one reads what it left. Under `--repos` the
# request's path names the repository first (`/<name>/sit/v1/…`), whose store
# state is made the open one for the request.
fn serve_handle_request(ctx, cfd, buf, n) {
    var a = _serve_req_alloc();
    reset_via(a);
    var method = sandhi_server_get_method_a(a, buf, n);
    var path_with_query = sandhi_server_get_path_a(a, buf, n);
    var path = 0;
    if (path_with_query != 0) { path = sandhi_server_path_only_a(a, path_with_query); }
    if (method == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    if (path == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
    var rc = 0;
    if (_serve_repos_dir == 0) {
        store_enter();
        rc = _serve_route(cfd, buf, n, method, path);
        store_leave();
        return rc;
    }
    var subp[8];
    var rctx = _serve_repo_for(path, &subp);
    if (rctx == 0) { _serve_send_status(cfd, 404, "Not Found"); return 0; }
    store_ctx_load(rctx);
    # 1.12.2 (X6): a repository whose store a gc holds answers 503 at once; its
    # wait stalled every request to every repository behind it.
    if (store_enter() != 0) {
        store_ctx_save(rctx);
        _serve_send_status(cfd, 503, "Service Unavailable");
        return 0;
    }
    rc = _serve_route(cfd, buf, n, method, load64(&subp));
    store_leave();
    store_ctx_save(rctx);
    return rc;
}

# ── Many repositories (1.11.0) ─────────────────────────────────────
#
# `sit serve <dir> --repos` serves every sit repository under <dir>: a request
# for `/<name>/sit/v1/…` goes to `<dir>/<name>`, where <name> is one or more
# path segments. Each segment is checked before it touches the filesystem
# (letters, digits, `.`, `_`, `-`; not starting with `.`, so never `..`), each
# directory on the way must be a real directory (not a symlink), and the last
# one must hold `.sit/HEAD`. Anything else is a 404, the same answer whether or
# not something is there. A repository's store state is kept between its
# requests, for up to SERVE_REPOS_OPEN of them; past that the least recently
# used one is closed.

var _serve_repos_dir = 0;           # the <dir> of --repos, or 0: one repository
var _serve_repos = 0;               # name -> {store state, last use}
var _serve_repos_tick = 0;
var SERVE_REPOS_OPEN = 64;
var SERVE_REPO_NAME_MAX = 1024;
var SERVE_REPO_SEGMENTS_MAX = 16;

# 1 when `len` bytes at `p` are a repository name --repos serves (see above).
fn _serve_repo_name_valid(p, len) {
    if (len < 1) { return 0; }
    if (len > SERVE_REPO_NAME_MAX) { return 0; }
    var segs = 0;
    var seglen = 0;
    var i = 0;
    var ok = 1;
    while (i <= len) {
        var c = 47;
        if (i < len) { c = load8(p + i) & 0xFF; }
        if (c == 47) {
            if (seglen == 0) { ok = 0; }
            if (seglen > 255) { ok = 0; }
            segs = segs + 1;
            seglen = 0;
        }
        else {
            var good = 0;
            if (c >= 48) { if (c <= 57) { good = 1; } }
            if (c >= 65) { if (c <= 90) { good = 1; } }
            if (c >= 97) { if (c <= 122) { good = 1; } }
            if (c == 95) { good = 1; }
            if (c == 45) { good = 1; }
            if (c == 46) {
                if (seglen > 0) { good = 1; }        # a segment may not start with '.'
            }
            if (good == 0) { ok = 0; }
            seglen = seglen + 1;
        }
        i = i + 1;
    }
    if (segs > SERVE_REPO_SEGMENTS_MAX) { ok = 0; }
    return ok;
}

# The repository a --repos request names, made the one its store state is kept
# for; writes the path past the name (`/sit/v1/…`) to *sub_out. 0 when the path
# names no repository this server serves.
fn _serve_repo_for(path, sub_out) {
    var plen = strlen(path);
    if (plen < 2) { return 0; }
    if (load8(path) != 47) { return 0; }
    # The name runs to the first "/sit/v1/" after the leading '/'.
    var k = 0 - 1;
    var i = 1;
    while (i + 8 <= plen) {
        if (k < 0) {
            if (memeq(path + i, "/sit/v1/", 8) == 1) { k = i; }
        }
        i = i + 1;
    }
    if (k < 2) { return 0; }
    var nlen = k - 1;
    if (_serve_repo_name_valid(path + 1, nlen) == 0) { return 0; }
    var name[1032];
    memcpy(&name, path + 1, nlen);
    store8(&name + nlen, 0);
    if (_serve_repos == 0) { _serve_repos = map_new(); }
    _serve_repos_tick = _serve_repos_tick + 1;
    var cell = map_get(_serve_repos, &name);
    if (cell != 0) {
        # 1.12.2 (X3 / S3): a kept repository is checked again on every request,
        # and must still be the directory it was. The path was checked once and
        # then trusted, so a directory under <dir> swapped for a symlink served,
        # and took pushes into, a repository outside <dir> — through the old
        # lock descriptor, which a gc there did not see. A repository replaced
        # by another real directory (restored from a backup) was served through
        # the old one's store handle.
        if (_serve_repo_kept(cell) == 0) {
            store_ctx_close(load64(cell));
            map_delete(_serve_repos, &name);
            cell = 0;
        }
    }
    if (cell == 0) {
        var root = _serve_repo_resolve(&name, nlen);
        if (root == 0) { return 0; }
        if (map_size(_serve_repos) >= SERVE_REPOS_OPEN) { _serve_repos_evict(); }
        cell = alloc_or_die(32);
        store64(cell, store_ctx_new(root));
        if (path_file_id(root, cell + 16) != 0) { return 0; }
        var kc = alloc_or_die(nlen + 1);
        memcpy(kc, &name, nlen + 1);
        map_set(_serve_repos, kc, cell);
    }
    store64(cell + 8, _serve_repos_tick);
    store64(sub_out, path + k);
    return load64(cell);
}

# `<dir>/<name>` as a heap cstring when it passes _serve_repo_check, else 0.
fn _serve_repo_resolve(name, nlen) {
    var dl = strlen(_serve_repos_dir);
    var root = alloc_or_die(dl + 1 + nlen + 1);
    memcpy(root, _serve_repos_dir, dl);
    store8(root + dl, 47);
    memcpy(root + dl + 1, name, nlen);
    store8(root + dl + 1 + nlen, 0);
    if (_serve_repo_check(root) == 0) { return 0; }
    return root;
}

# 1 when `root` (`<dir>/<name>`) is a repository --repos serves: every directory
# below <dir> on the way is a real directory, not a symlink, and the last holds
# a `.sit` directory with `.sit/HEAD` a regular file. Nothing is allocated.
fn _serve_repo_check(root) {
    var rl = strlen(root);
    var dl = strlen(_serve_repos_dir);
    if (rl + 12 > 4352) { return 0; }
    var b[4352];
    memcpy(&b, root, rl + 1);
    var i = dl + 1;
    var ok = 1;
    while (i <= rl) {
        if (ok == 1) {
            var c = load8(&b + i);
            if (c == 47) {
                store8(&b + i, 0);
                if (path_lstat_kind(&b) != 0x4000) { ok = 0; }
                store8(&b + i, 47);
            }
            if (c == 0) {
                if (path_lstat_kind(&b) != 0x4000) { ok = 0; }
            }
        }
        i = i + 1;
    }
    if (ok == 0) { return 0; }
    memcpy(&b + rl, "/.sit", 6);
    if (path_lstat_kind(&b) != 0x4000) { return 0; }
    memcpy(&b + rl, "/.sit/HEAD", 11);
    if (path_lstat_kind(&b) != 0x8000) { return 0; }
    return 1;
}

# 1 when the repository a kept cell {store state, last use, dev, ino} names
# still passes _serve_repo_check and is the same directory as when it was kept.
fn _serve_repo_kept(cell) {
    var root = load64(load64(cell));             # store_ctx_new keeps root first
    if (_serve_repo_check(root) == 0) { return 0; }
    var id[16];
    if (path_file_id(root, &id) != 0) { return 0; }
    if (load64(&id) != load64(cell + 16)) { return 0; }
    if (load64(&id + 8) != load64(cell + 24)) { return 0; }
    return 1;
}

# Close the least recently used repository's store state, making room.
fn _serve_repos_evict() {
    var keys = map_keys(_serve_repos);
    var best = 0;
    var best_tick = 0;
    var i = 0;
    while (i < vec_len(keys)) {
        var c = map_get(_serve_repos, vec_get(keys, i));
        if (c != 0) {
            if (best == 0) { best = vec_get(keys, i); best_tick = load64(c + 8); }
            else {
                if (load64(c + 8) < best_tick) { best = vec_get(keys, i); best_tick = load64(c + 8); }
            }
        }
        i = i + 1;
    }
    if (best == 0) { return 0; }
    var victim = map_get(_serve_repos, best);
    store_ctx_close(load64(victim));
    map_delete(_serve_repos, best);
    return 0;
}

# Route one request, by method and the path within its repository.
fn _serve_route(cfd, buf, n, method, path) {
    var a = _serve_req_alloc();
    if (streq(method, "GET") == 1) {
        if (streq(path, "/sit/v1/capabilities") == 1) {
            var b1 = serve_build_capabilities(a);
            if (b1 == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
            _serve_send_response(cfd, 200, "OK", "application/json",
              b1, strlen(b1), 0);
            return 0;
        }
        if (streq(path, "/sit/v1/refs") == 1) {
            var b2 = serve_build_refs(a);
            if (b2 == 0) { _serve_send_status(cfd, 500, "Internal Server Error"); return 0; }
            _serve_send_response(cfd, 200, "OK", "application/json",
              b2, strlen(b2), 0);
            return 0;
        }
        # /sit/v1/objects/<64-hex>: prefix-match (path is the path-only
        # form, query string already stripped by sandhi_server_path_only).
        var plen = strlen(path);
        if (plen >= SIT_OBJECT_PATH_PREFIX_LEN) {
            if (memeq(path, SIT_OBJECT_PATH_PREFIX,
                SIT_OBJECT_PATH_PREFIX_LEN) == 1) {
                return serve_handle_object(cfd, path);
            }
        }
    }
    if (streq(method, "POST") == 1) {
        # /want is read-shaped (bulk fetch) so it stays anonymous in
        # both auth modes. /objects + /refs (push) are auth-gated when
        # --require-auth is set.
        if (streq(path, "/sit/v1/want") == 1) {
            return serve_handle_want(cfd, buf, n);
        }
        var plen3 = strlen(path);
        var is_put_object = 0;
        var is_put_ref = 0;
        if (plen3 >= SIT_OBJECT_PATH_PREFIX_LEN) {
            if (memeq(path, SIT_OBJECT_PATH_PREFIX,
                SIT_OBJECT_PATH_PREFIX_LEN) == 1) { is_put_object = 1; }
        }
        if (plen3 >= SIT_REF_PUT_PREFIX_LEN) {
            if (memeq(path, SIT_REF_PUT_PREFIX,
                SIT_REF_PUT_PREFIX_LEN) == 1) { is_put_ref = 1; }
        }
        if (is_put_object == 1) {
            if (_serve_auth_ok(buf, n) == 0) {
                _serve_send_status(cfd, 401, "Unauthorized");
                return 0;
            }
            return serve_handle_put_object(cfd, path, buf, n);
        }
        if (is_put_ref == 1) {
            if (_serve_auth_ok(buf, n) == 0) {
                _serve_send_status(cfd, 401, "Unauthorized");
                return 0;
            }
            return serve_handle_put_ref(cfd, path, buf, n);
        }
    }
    _serve_send_status(cfd, 404, "Not Found");
    return 0;
}

# ── --listen parser ───────────────────────────────
#
# Parses "<addr>:<port>" into *out_addr (packed IPv4) and *out_port.
# Returns 1 on success, 0 on any malformation.
#
# v1.6.0 lifts the loopback lock: any IPv4 literal, plus "localhost", is
# accepted here. **Whether a non-loopback bind is ALLOWED is decided by the
# caller, not here** — cmd_serve refuses one unless `--tls` is on, because the
# thing that made the lock necessary was shipping an unencrypted, optionally
# unauthenticated daemon onto a routable interface. Parsing and policy are kept
# apart so the policy is stated once, in one place, rather than smuggled into a
# string comparison.
fn serve_parse_listen(arg, out_addr, out_port) {
    var alen = strlen(arg);
    var colon = 0 - 1;
    var i = 0;
    var seen = 0;
    while (i < alen) {
        if (seen == 0) {
            if (load8(arg + i) == 58) {
                colon = i;
                seen = 1;
            }
        }
        i = i + 1;
    }
    if (colon < 0) { return 0; }
    if (colon == 0) { return 0; }

    var hbuf = alloc_or_die(colon + 1);
    memcpy(hbuf, arg, colon);
    store8(hbuf + colon, 0);
    var addr = sandhi_net_parse_ipv4(hbuf);
    if (addr < 0) {
        if (streq(hbuf, "localhost") == 1) { addr = INADDR_LOOPBACK(); }
        else { return 0; }
    }
    store64(out_addr, addr);

    var port = 0;
    var j = colon + 1;
    var saw_digit = 0;
    while (j < alen) {
        var c = load8(arg + j) & 0xFF;
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        port = port * 10 + (c - 48);
        if (port > 65535) { return 0; }
        saw_digit = 1;
        j = j + 1;
    }
    if (saw_digit == 0) { return 0; }
    if (port < 1) { return 0; }
    store64(out_port, port);
    return 1;
}

# ── --stdio dispatch loop (v0.8.2) ──────────────────────────
#
# When invoked as `sit serve <repo> --stdio`, sit reads HTTP/1.1
# requests from STDIN and writes responses to STDOUT — no socket. The
# canonical use case is being exec'd as the remote side of an SSH
# connection: `ssh user@host -- sit serve <repo> --stdio` pipes the
# wire over SSH's stdin/stdout channel. SSH owns encryption + auth;
# sit's wire (the same HTTP/1.1 we already speak over TCP) just rides
# the bytes through. Process boundary, not FFI — sit consumes the
# ssh binary, no crypto in sit's address space.
#
# Framing: each request carries Content-Length, so the server reads
# until headers + body are complete, dispatches one request, writes
# one response (with Content-Length), and loops. Client closes STDIN
# to signal end-of-session; recv returns 0, loop exits.
#
# Reuses sandhi's send/recv functions because `sock_send` / `sock_recv`
# are just `sys_write` / `sys_read` (see lib/net.cyr) — they work
# unchanged on pipe fds. The fd we pass to dispatch is STDOUT_FILENO=1.
var STDIN_FILENO = 0;
var STDOUT_FILENO = 1;

# Pipelining-safe stdin recv. Reads until one HTTP request is complete
# (headers + Content-Length body), preserving any trailing bytes that
# belong to a subsequent request. `start_have` is the carryover count
# from the previous iteration; if non-zero, those bytes are already at
# the head of `buf` and we try to parse the header against them before
# blocking on another sys_read.
#
# Returns the total bytes in buf belonging to the first request (the
# caller computes the request boundary via body_offset + content_length
# and moves the trailing bytes to offset 0 for the next call). 0 on
# clean EOF, -1 on read error.
fn _stdio_recv_request(buf, max, start_have) {
    var have = start_have;
    var need_body = 0 - 1;

    if (have > 0) {
        store8(buf + have, 0);
        var bo0 = sandhi_server_body_offset(buf, have);
        if (bo0 >= 0) {
            var clen0 = _serve_content_length(_serve_req_alloc(), buf, have);
            need_body = bo0 + clen0;
            if (have >= need_body) { return have; }
        }
    }

    while (have < max) {
        var r_t, r_v = sock_recv(STDIN_FILENO, buf + have, max - have);
        if (is_err_result(r_t) == 1) { return 0 - 1; }
        var n = r_v;
        if (n <= 0) {
            store8(buf + have, 0);
            return have;
        }
        have = have + n;

        if (need_body == 0 - 1) {
            store8(buf + have, 0);
            var bo = sandhi_server_body_offset(buf, have);
            if (bo >= 0) {
                var clen = _serve_content_length(_serve_req_alloc(), buf, have);
                need_body = bo + clen;
            }
        }
        if (need_body != 0 - 1) {
            if (have >= need_body) {
                store8(buf + have, 0);
                return have;
            }
        }
    }
    store8(buf + have, 0);
    return have;
}

fn _serve_run_stdio() {
    # One request buffer for the session, SERVE_REQ_MAX like the other loops
    # (pages are touched only as a request fills them).
    var buf = alloc(SERVE_REQ_MAX);
    var carry = 0;

    while (1 == 1) {
        var n = _stdio_recv_request(buf, SERVE_REQ_MAX - 1, carry);
        if (n <= 0) {
            stdout_flush();
            if (n < 0) { return 1; }
            return 0;
        }

        # Compute the request-1 boundary so any pipelined request-2
        # bytes can carry over to the next iteration. Malformed
        # headers (no body offset) abort the session.
        var bo = sandhi_server_body_offset(buf, n);
        if (bo < 0) {
            _serve_send_status(STDOUT_FILENO, 400, "Bad Request");
            stdout_flush();
            return 1;
        }
        # S-25: bound the claimed Content-Length, then clamp the dispatch length
        # to the bytes ACTUALLY read.
        #
        # `req_end` used to be `bo + clen` unclamped and was passed straight in
        # as `n` below. `_stdio_recv_request` returns at most SERVE_REQ_MAX-1
        # bytes and never loops to complete an oversized body, so a client that
        # claimed a Content-Length larger than it sent turned every POST
        # handler's completeness check — `if (body_off + clen > n)` — into the
        # tautology `X > X`, which never fires. `serve_handle_put_object` then
        # handed that claimed length (up to 16 MiB) to `zlib_decompress` over a
        # 64 KiB buffer, reading out of bounds.
        var clen = content_length_sane(
          _serve_content_length(_serve_req_alloc(), buf, n), SIT_SERVE_MAX_BODY);
        if (clen < 0) {
            _serve_send_status(STDOUT_FILENO, 400, "Bad Request");
            stdout_flush();
            return 1;
        }
        var req_end = bo + clen;
        # A body we never received is a truncated request, not a short one —
        # refuse rather than dispatching a handler over bytes that aren't there.
        if (req_end > n) {
            _serve_send_status(STDOUT_FILENO, 400, "Bad Request");
            stdout_flush();
            return 1;
        }
        var leftover = n - req_end;
        if (leftover < 0) { leftover = 0; }

        # Dispatch just request-1's bytes. The sandhi parsers take
        # `(buf, n)` and bound their reads by `n`, so any pipelined
        # request-2 bytes sitting in `buf[req_end:]` are ignored — we
        # MUST NOT NUL-terminate at req_end, that would overwrite the
        # first byte of request 2 before the carryover memcpy.
        serve_handle_request(0, STDOUT_FILENO, buf, req_end);
        stdout_flush();

        # Shift carryover to the front of buf for the next iteration.
        # memcpy is safe here because dst (buf) < src (buf + req_end);
        # forward-copy semantics never overwrite a yet-to-be-read source byte.
        if (leftover > 0) {
            memcpy(buf, buf + req_end, leftover);
        }
        carry = leftover;
    }
    return 0;
}

# ── Top-level command ───────────────────────────────

# ── TLS server (bite 3b) ──
#
# `sit serve --tls --cert <file> --key <file>`. The cert is DER, or PEM (auto-
# decoded via sigil's pem_decode_certs); the key is PEM or DER (tls_native
# detects). Per ADR 0007 the only TLS is tls_native (first-party Cyrius) — no
# libssl. sit's own client pushes over http and ssh only (https push stays gated
# at wire_transport_check_writable), but any client can POST here, so the loop
# buffers SERVE_REQ_MAX like the others and frames requests as strictly.

var SERVE_TLS_CONN_ARENA_CHUNK = 131072;   # one handshake's state fits; more chains a chunk

# Load a certificate file as DER. Accepts PEM (decoded via pem_decode_certs) or
# raw DER. Writes [der_ptr, der_len] to out_pair (16 bytes). Returns 0 on
# success, negative on read failure.
fn _serve_load_cert(path, out_pair) {
    var fp[16];
    if (read_file_heap(path, &fp) != 0) { return 0 - 1; }
    var data = load64(&fp);
    var len = load64(&fp + 8);
    var chain[16];
    var nc = pem_decode_certs(data, len, &chain, 1);
    if (nc >= 1) {
        store64(out_pair, load64(&chain));
        store64(out_pair + 8, load64(&chain + 8));
        return 0;
    }
    store64(out_pair, data);          # not PEM → assume DER
    store64(out_pair + 8, len);
    return 0;
}

# Read one request off a TLS connection into buf (cap `max`). Returns its length
# (headers + declared body) once all of it has arrived, with `*extra` set to how
# many bytes past it were read (a pipelined request); 0 when the peer closed or
# timed out before sending anything; or a refusal:
#   -SERVE_TLS_INCOMPLETE  the stream ended or failed mid-request
#   -SERVE_TLS_TOO_LARGE   the request does not fit `max`, or its Content-Length
#                          is not representable (413)
#   -SERVE_TLS_BAD_FRAMING Content-Length with Transfer-Encoding, or a duplicated
#                          Content-Length / Transfer-Encoding / Host (400)
#   -SERVE_TLS_UNSUPPORTED a Transfer-Encoding sit does not decode (501)
#
# 1.7.6 (N5): the same framing rules as sandhi's plain loop. Through 1.7.5 this
# returned whatever it had read: an oversized request was dispatched truncated
# and its remainder parsed as the next request, a chunked body was framed as
# requests, and pipelined bytes went to the handler.
var SERVE_TLS_INCOMPLETE = 1;
var SERVE_TLS_TOO_LARGE = 2;
var SERVE_TLS_BAD_FRAMING = 3;
var SERVE_TLS_UNSUPPORTED = 4;

fn _serve_tls_recv_request(ctx, buf, max, extra) {
    store64(extra, 0);
    var used = 0;
    var need = 0 - 1;                              # request length once the headers are in
    var rgo = 1;
    while (rgo == 1) {
        if (used >= max) { rgo = 0; }
        else {
            var n = tls_native_read(ctx, buf + used, max - used);
            if (n <= 0) { rgo = 0; }
            else {
                used = used + n;
                if (need < 0) {
                    var bo = sandhi_server_body_offset(buf, used);
                    if (bo > 0) {
                        var bad = 0;
                        if (sandhi_server_request_has_cl_te_conflict(buf, bo) == 1) { bad = SERVE_TLS_BAD_FRAMING; }
                        if (sandhi_server_request_has_dup_smuggling_header(buf, bo) == 1) {
                            bad = SERVE_TLS_BAD_FRAMING;
                        }
                        if (bad == 0) {
                            if (sandhi_server_request_has_unsupported_te(buf, bo) == 1) { bad = SERVE_TLS_UNSUPPORTED; }
                        }
                        if (bad != 0) { return 0 - bad; }
                        var clen = _serve_content_length(_serve_req_alloc(), buf, bo);
                        if (clen < 0) { return 0 - SERVE_TLS_TOO_LARGE; }
                        if (clen > max - bo) { return 0 - SERVE_TLS_TOO_LARGE; }
                        need = bo + clen;
                    }
                }
                if (need >= 0) {
                    if (used >= need) { rgo = 0; }
                }
            }
        }
    }
    if (need < 0) {
        if (used >= max) { return 0 - SERVE_TLS_TOO_LARGE; }   # no header block in a full buffer
        if (used == 0) { return 0; }
        return 0 - SERVE_TLS_INCOMPLETE;
    }
    if (used < need) { return 0 - SERVE_TLS_INCOMPLETE; }
    store64(extra, used - need);
    return need;
}

# TLS accept loop: accept → a server ctx in the per-connection arena → handshake
# → serve requests on the connection (keep-alive, v0.8.9) until the client
# closes, a deadline passes, or a request is refused → close. Each request is
# dispatched with _serve_tls_ctx set so the response goes back over TLS.
# Single-threaded/sequential like sandhi_server_run, so the global ctx is
# connection-safe. cert/key DER buffers are loaded once by the caller.
fn _serve_run_tls(listen_addr, port, cert, cert_len, key, key_len) {
    var sfd_r_t, sfd_r_v = tcp_socket();
    if (is_err_result(sfd_r_t) == 1) { eprintln("sit: tcp_socket failed"); return 1; }
    var sfd = sfd_r_v;
    sock_reuse(sfd);
    if (is_err_result(sock_bind(sfd, listen_addr, port)) == 1) {
        eprintln("sit: bind failed"); return 1;
    }
    if (is_err_result(sock_listen(sfd, 16)) == 1) {
        eprintln("sit: listen failed"); return 1;
    }
    var reqbuf = alloc(SERVE_REQ_MAX);
    # C1 (1.7.4): each connection's TLS state — the ctx, the handshake, the
    # transcript and key schedule, the record buffers — is built in this arena
    # and reclaimed when the connection closes. tls_native_new_server builds it
    # on the global heap, where it stayed: about 74 KB per connection, so 1,000
    # handshakes kept 74 MB.
    var conn_al = arena_allocator_growable(SERVE_TLS_CONN_ARENA_CHUNK);
    if (conn_al == 0) { eprintln("sit: cannot allocate the TLS connection arena"); return 1; }
    while (1 == 1) {
        var cr_t, cr_v = sock_accept(sfd);
        if (is_err_result(cr_t) == 0) {
            var cfd = cr_v;
            # 30s recv timeout per connection — slowloris bound on the TLS
            # handshake + request read (v0.8.9 hardening; mirrors what
            # sandhi_server_run_opts does for the plain-http path).
            sock_set_recv_timeout(cfd, 30, 0);
            # The previous connection's ctx was closed before its socket, so
            # nothing in the arena is live here.
            reset_via(conn_al);
            var ctx = tls_native_new_server_in(conn_al, cert, cert_len, key, key_len);
            if (ctx != 0) {
                # 1.6.4 (C2): whole-handshake and whole-request DEADLINES, as
                # sandhi's plain-HTTP loop has (60 s). The 30 s SO_RCVTIMEO above
                # bounds each read, not the total, so one client trickling a
                # byte every 10 s — before or after the handshake — held this
                # single-threaded loop for as long as it liked.
                tls_native_set_deadline(ctx, clock_now_ns() + SERVE_TLS_DEADLINE_NS);
                if (tls_native_server_load_creds(ctx) == TLS_OK) {
                    if (tls_native_accept(ctx, cfd) == TLS_OK) {
                        # v0.8.9 keep-alive: serve every request on this TLS
                        # connection until the client closes (recv returns 0) or
                        # the 30s SO_RCVTIMEO fires. The client (wire_https) reads
                        # each response by exact Content-Length, so the stream
                        # stays framed across requests.
                        var alive = 1;
                        var extra[8];
                        while (alive == 1) {
                            tls_native_set_deadline(ctx, clock_now_ns() + SERVE_TLS_DEADLINE_NS);
                            var n = _serve_tls_recv_request(ctx, reqbuf, SERVE_REQ_MAX, &extra);
                            if (n <= 0) {
                                alive = 0;
                                # A refused request is answered, then the connection
                                # closes: what follows it cannot be framed.
                                var code = 0;
                                if (n == 0 - SERVE_TLS_TOO_LARGE) { code = 413; }
                                if (n == 0 - SERVE_TLS_BAD_FRAMING) { code = 400; }
                                if (n == 0 - SERVE_TLS_UNSUPPORTED) { code = 501; }
                                if (code != 0) {
                                    tls_native_set_deadline(ctx, clock_now_ns() + SERVE_TLS_DEADLINE_NS);
                                    _serve_set_tls_ctx(ctx);
                                    if (code == 413) { _serve_send_status(cfd, 413, "Payload Too Large"); }
                                    if (code == 400) { _serve_send_status(cfd, 400, "Bad Request"); }
                                    if (code == 501) { _serve_send_status(cfd, 501, "Not Implemented"); }   #skip-lint: HTTP 501, as sandhi answers it
                                    _serve_set_tls_ctx(0);
                                }
                            }
                            else {
                                _serve_tls_send_failed = 0;
                                tls_native_set_deadline(ctx, clock_now_ns() + SERVE_TLS_DEADLINE_NS);
                                _serve_set_tls_ctx(ctx);
                                serve_handle_request(0, cfd, reqbuf, n);
                                _serve_set_tls_ctx(0);
                                if (_serve_tls_send_failed == 1) { alive = 0; }
                                # Pipelined bytes are not carried over: answer this
                                # request, then close (sit's client never pipelines).
                                if (load64(&extra) > 0) { alive = 0; }
                            }
                        }
                    }
                    tls_native_close(ctx);
                }
            }
            sock_close(cfd);
        }
    }
    return 0;
}

# Report the address actually bound, not a hardcoded 127.0.0.1 — since v1.6.0
# that is no longer always true, and a banner that lies about the exposure is
# worse than no banner.
fn _serve_print_banner(addr, tls_on, auth_on) {
    stdout_write("sit serve listening on ", 23);
    var a0 = addr & 0xFF;
    var a1 = (addr >> 8) & 0xFF;
    var a2 = (addr >> 16) & 0xFF;
    var a3 = (addr >> 24) & 0xFF;
    var nb[24];
    var d = write_decimal(&nb, a0); stdout_write(&nb, d); stdout_write(".", 1);
    d = write_decimal(&nb, a1); stdout_write(&nb, d); stdout_write(".", 1);
    d = write_decimal(&nb, a2); stdout_write(&nb, d); stdout_write(".", 1);
    d = write_decimal(&nb, a3); stdout_write(&nb, d);
    if (tls_on == 1) { stdout_write(" (tls, auth: ", 13); }
    else { stdout_write(" (auth: ", 8); }
    if (auth_on == 1) { stdout_write("bearer)", 7); }
    else { stdout_write("none)", 5); }
    stdout_write("\n", 1);
    if (_serve_repos_dir != 0) {
        var rm = "serving the sit repositories under ";
        stdout_write(rm, strlen(rm));
        stdout_write(_serve_repos_dir, strlen(_serve_repos_dir));
        var rm2 = " at /<name>/sit/v1/\n";
        stdout_write(rm2, strlen(rm2));
    }
    return 0;
}

# `sit serve <repo> [--stdio | --listen <addr>:<port>] [--tls] [--require-auth]` — the sit/v1 daemon.
fn cmd_serve() {
    if (argc() < 3) {
        eprintln("usage: sit serve <repo-path> [--stdio | --listen <addr>:<port>]");
        eprintln("                 [--tls --cert <f> --key <f>] [--require-auth] [--token <path>]");
        eprintln("       sit serve <dir> --repos [--listen …] [--tls …] [--require-auth] [--token …]");
        return 1;
    }
    var repos_mode = 0;
    var repo_path = argv_heap(2);
    var port = SIT_SERVE_DEFAULT_PORT;
    var bind_addr = INADDR_LOOPBACK();
    var stdio_mode = 0;
    var token_path = "~/.sit/serve.token";   # default; overridable via --token
    var custom_token_path = 0;
    var tls_mode = 0;
    var cert_path = 0;
    var key_path = 0;
    var cert_pair[16];
    var key_pair[16];
    var ai = 3;
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "--stdio") == 1) {
            stdio_mode = 1;
            ai = ai + 1;
            continue;
        }
        if (streq(a, "--repos") == 1) {
            repos_mode = 1;
            ai = ai + 1;
            continue;
        }
        if (streq(a, "--listen") == 1) {
            if (ai + 1 >= argc()) {
                eprintln("sit: --listen requires an argument");
                return 1;
            }
            var port_cell = alloc(8);
            var addr_cell = alloc(8);
            store64(port_cell, 0);
            store64(addr_cell, 0);
            if (serve_parse_listen(argv(ai + 1), addr_cell, port_cell) != 1) {
                eprintln("sit: --listen requires <ipv4>:<port> or localhost:<port>");
                return 1;
            }
            port = load64(port_cell);
            bind_addr = load64(addr_cell);
            ai = ai + 2;
        }
        else {
            if (streq(a, "--require-auth") == 1) {
                _serve_require_auth = 1;
                ai = ai + 1;
            }
            else {
                if (streq(a, "--token") == 1) {
                    if (ai + 1 >= argc()) {
                        eprintln("sit: --token requires a path argument");
                        return 1;
                    }
                    token_path = argv_heap(ai + 1);
                    custom_token_path = 1;
                    ai = ai + 2;
                }
                else {
                    if (streq(a, "--tls") == 1) {
                        tls_mode = 1;
                        ai = ai + 1;
                    }
                    else {
                        if (streq(a, "--cert") == 1) {
                            if (ai + 1 >= argc()) {
                                eprintln("sit: --cert requires a path argument");
                                return 1;
                            }
                            cert_path = argv_heap(ai + 1);
                            ai = ai + 2;
                        }
                        else {
                            if (streq(a, "--key") == 1) {
                                if (ai + 1 >= argc()) {
                                    eprintln("sit: --key requires a path argument");
                                    return 1;
                                }
                                key_path = argv_heap(ai + 1);
                                ai = ai + 2;
                            }
                            else {
                                eprintln("sit: unknown serve option");
                                return 1;
                            }
                        }
                    }
                }
            }
        }
    }

    # --stdio + --listen are mutually exclusive transport modes.
    if (stdio_mode == 1) {
        if (port != SIT_SERVE_DEFAULT_PORT) {
            eprintln("sit: --stdio and --listen are mutually exclusive");
            return 1;
        }
        # An ssh:// URL names its repository by path already.
        if (repos_mode == 1) {
            eprintln("sit: --repos and --stdio are mutually exclusive");
            return 1;
        }
    }

    # If --require-auth: load the token before chdir'ing into the repo
    # (default token path is ~/.sit/serve.token, which is HOME-relative,
    # not repo-relative). Refuse to start if the token doesn't load —
    # the auth posture is "strictly enforced or absent" per ADR 0007.
    if (_serve_require_auth == 1) {
        var resolved = token_path;
        if (custom_token_path == 0) {
            var home = getenv("HOME");
            if (home == 0) {
                eprintln("sit: $HOME not set; pass --token <path> explicitly");
                return 1;
            }
            var hl = strlen(home);
            resolved = alloc(hl + 18);
            memcpy(resolved, home, hl);
            memcpy(resolved + hl, "/.sit/serve.token", 17);
            store8(resolved + hl + 17, 0);
        }
        _serve_token = _serve_load_token(resolved);
        if (_serve_token == 0) {
            eprintln("sit: --require-auth set but token failed to load — refusing to start");
            return 1;
        }
    }

    # Load TLS creds before chdir — --cert/--key are relative to the invocation
    # cwd, not the repo (same reasoning as the token path above).
    if (tls_mode == 1) {
        if (stdio_mode == 1) {
            eprintln("sit: --tls and --stdio are mutually exclusive");
            return 1;
        }
        if (cert_path == 0) {
            eprintln("sit: --tls requires --cert <file>");
            return 1;
        }
        if (key_path == 0) {
            eprintln("sit: --tls requires --key <file>");
            return 1;
        }
        if (_serve_load_cert(cert_path, &cert_pair) != 0) {
            eprintln("sit: cannot read --cert file");
            return 1;
        }
        if (read_file_heap(key_path, &key_pair) != 0) {
            eprintln("sit: cannot read --key file");
            return 1;
        }
    }

    # Set the repo root so .sit/refs/* and .sit/objects.patra resolve via
    # sit_abs in every dependent helper. Replaces the old chdir — agnos has
    # no chdir/getcwd. Cert/key + token were loaded ABOVE (while _repo_root
    # was still 0), so their paths stay unprefixed. On Linux repo_path is a
    # real path → reads resolve absolutely; the pre-refactor chdir semantics
    # are preserved without touching process cwd.
    if (repos_mode == 1) {
        # 1.11.0: each request names its repository under this directory.
        var dst[256];
        var dok = 0;
        if (xstat(repo_path, &dst) == 0) {
            if ((load32(&dst + STAT_MODE) & 0xF000) == 0x4000) { dok = 1; }
        }
        if (dok == 0) {
            eprintln("sit: --repos needs a directory");
            return 1;
        }
        var rpl = strlen(repo_path);
        while (rpl > 1) {
            if (load8(repo_path + rpl - 1) == 47) { rpl = rpl - 1; store8(repo_path + rpl, 0); }
            else { rpl = 0; }
        }
        _serve_repos_dir = repo_path;
        _store_session_wait_ms = 0;        # 1.12.2 (X6): 503, not a stalled server
    }
    else {
        sit_set_repo_root(repo_path);
        if (sf_exists(".sit/HEAD") != 1) {
            eprintln("sit: not a sit repository at given path");
            return 1;
        }
    }

    # In --stdio mode any chatter on stdout would land between HTTP
    # responses and corrupt the wire — log the listening posture to
    # stderr instead. Bearer auth still applies; it just runs over
    # the SSH-encrypted pipe rather than a TCP socket.
    if (stdio_mode == 1) {
        if (_serve_require_auth == 1) {
            eprintln("sit serve --stdio (auth: bearer)");
        }
        else {
            eprintln("sit serve --stdio (auth: none)");
        }
        return _serve_run_stdio();
    }

    # v1.6.0 — the loopback lock becomes a POLICY, stated once, here.
    #
    # Until now `--listen` refused anything but 127.0.0.1, because the daemon
    # can be unencrypted and optionally unauthenticated: putting that on a
    # routable interface is what the lock existed to prevent. Encryption is what
    # changes the calculus, so a non-loopback bind now requires --tls.
    #
    # Note what is deliberately NOT required: bearer auth. A public read-only
    # mirror over HTTPS is a legitimate deployment and `--require-auth` stays the
    # operator's call. What is not negotiable is that bytes on a routable
    # interface are encrypted.
    if (bind_addr != INADDR_LOOPBACK()) {
        if (tls_mode == 0) {
            eprintln("sit: refusing to serve plain HTTP on a non-loopback address");
            eprintln("sit:   add --tls --cert <f> --key <f>, or bind 127.0.0.1");
            return 1;
        }
    }

    if (tls_mode == 1) {
        if (_serve_require_auth == 1) {
            _serve_print_banner(bind_addr, 1, 1);
        }
        else {
            _serve_print_banner(bind_addr, 1, 0);
        }
        stdout_flush();
        return _serve_run_tls(bind_addr, port, load64(&cert_pair), load64(&cert_pair + 8),
          load64(&key_pair), load64(&key_pair + 8));
    }

    if (_serve_require_auth == 1) {
        _serve_print_banner(bind_addr, 0, 1);
    }
    else {
        _serve_print_banner(bind_addr, 0, 0);
    }
    stdout_flush();
    # 1.7.6 (N2): an options struct only to raise the request cap to
    # SERVE_REQ_MAX. Every other option keeps the default sandhi_server_run
    # used (30 s idle, 60 s per request, no stop flag).
    var opts = sandhi_server_options_new();
    if (opts == 0) { eprintln("sit: cannot allocate server options"); return 1; }
    sandhi_server_options_max_request(opts, SERVE_REQ_MAX);
    return sandhi_server_run_opts(bind_addr, port, &serve_handle_request, 0, opts);
}
