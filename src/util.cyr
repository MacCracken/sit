# util.cyr — universal helpers.
#
# Everything here is consumed by two or more domain modules. Keep this file
# free of sit-specific domain knowledge — no refs, no objects, no patra.

var SEEK_SET = 0;
var SEEK_END = 2;

# ================================================================
# Repo-root prefixing (agnos support).
# ================================================================
# AGNOS's frozen syscall floor has NO chdir/getcwd/openat — "CWD is
# userland-owned, absolute paths" (ABI §3.2). sit historically leaned
# on process-cwd (`chdir` into the repo, then read ".sit/..." relative).
# That is portability-hostile. The fix: carry an explicit repo root and
# funnel every repo-relative FS access through sit_abs(), which prefixes
# it.
#
# `_repo_root` == 0 is the LINUX DEFAULT: no prefix, cwd-relative,
# byte-identical to pre-refactor behavior. On agnos, entry points set it
# to an absolute repo-root cstring so reads resolve without a cwd.
var _repo_root = 0;

# Store the repo root (an absolute-path cstring), or 0 to clear it.
fn sit_set_repo_root(root) {
    _repo_root = root;
    return 0;
}

# The ONE prefix point. Rules, in order:
#   (1) rel already absolute (byte 0 == '/') → return UNCHANGED.
#       (cert/token/HOME paths pass straight through.)
#   (2) _repo_root == 0 (Linux default) → return rel UNCHANGED
#       (preserves cwd-relative behavior exactly — a true no-op).
#   (3) else → heap-alloc "<_repo_root>/<rel>" and return it.
#       Caller-owns the result.
# On Linux and for already-absolute paths this is a no-op, so the whole
# change is behavior-preserving there.
fn sit_abs(rel) {
    return sit_abs_a(0, rel);
}

# sit_abs with the joined path drawn from allocator `a`: `sit serve` passes its
# request arena, so a path built for one request is reclaimed with it (C1,
# 1.7.4). `a` == 0 is sit_abs itself: the global heap, dying on OOM. Otherwise
# 0 comes back when `a` cannot serve the bytes.
fn sit_abs_a(a, rel) {
    var n = _sit_abs_len(rel);
    if (n == 0) { return rel; }
    var out = 0;
    if (a == 0) { out = alloc_or_die(n); }
    else {
        out = alloc_via(a, n);
        if (out == 0) { return 0; }
    }
    return _sit_abs_fill(out, rel);
}

# sit_abs into a caller's buffer of `cap` bytes: `buf` holding the joined path,
# `rel` itself when the rules use it as given, or 0 when the join does not fit.
# 1.7.5: for the git read path, which runs per object in-process for owl and
# thoth and so keeps nothing on the heap.
fn sit_abs_into(rel, buf, cap) {
    var n = _sit_abs_len(rel);
    if (n == 0) { return rel; }
    if (n > cap) { return 0; }
    return _sit_abs_fill(buf, rel);
}

# The rules above: the bytes "<root>/<rel>" + NUL needs, or 0 when `rel` is
# used as given.
fn _sit_abs_len(rel) {
    if (rel == 0) { return 0; }
    if (load8(rel) == 47) { return 0; }              # '/'
    if (_repo_root == 0) { return 0; }
    # A "." root means "current directory" — prefixing "./" is redundant
    # and would break Linux byte-for-byte parity. Treat it as no-prefix so
    # cmd_init's explicit sit_set_repo_root(".") stays a Linux no-op.
    if (load8(_repo_root) == 46) { if (load8(_repo_root + 1) == 0) { return 0; } }
    return strlen(_repo_root) + 1 + strlen(rel) + 1;
}

# Write "<root>/<rel>" + NUL at `out`, sized by _sit_abs_len. Returns `out`.
fn _sit_abs_fill(out, rel) {
    var rlen = strlen(_repo_root);
    var plen = strlen(rel);
    memcpy(out, _repo_root, rlen);
    store8(out + rlen, 47);                          # '/'
    memcpy(out + rlen + 1, rel, plen);
    store8(out + rlen + 1 + plen, 0);
    return out;
}

# Str-aware variant of sit_abs for FS primitives that take a Str
# (e.g. dir_list). Applies the same prefixing rules to the Str's bytes
# and returns a new Str; a no-op case returns the input Str unchanged.
fn sit_abs_str(rel) {
    if (rel == 0) { return rel; }
    var data = str_data(rel);
    if (str_len(rel) > 0) { if (load8(data) == 47) { return rel; } }
    if (_repo_root == 0) { return rel; }
    return str_from(sit_abs(str_cstr(rel)));
}

# ----------------------------------------------------------------
# Portable directory create/remove (agnos ABI bridge).
# ----------------------------------------------------------------
# Linux/macOS and agnos disagree on the mkdir/rmdir call shape:
#   - Linux/macOS: sys_mkdir(path, mode)   / sys_rmdir(path)
#   - agnos:       sys_mkdir(path, pathlen) / sys_rmdir(path, pathlen)
# agnos's frozen floor carries an explicit byte length (no NUL scan in the
# kernel) and picks the directory mode itself, so a raw Linux-shaped
# sys_mkdir(path, 0755) lands 0755 in `pathlen` — a silent ABI miscompile.
# The stdlib bridges open/stat/unlink (io.cyr's file_open / xstat / xunlink)
# but does NOT yet bridge mkdir/rmdir, so sit carries these two here; if the
# stdlib grows xmkdir/xrmdir they fold out. `path` is already repo-absolute
# (callers pass sit_abs(...)). The #ifdef wraps the whole branch — an early
# `return` does NOT stop the compiler type-checking the code that follows it
# (see lib/io.cyr's v6.2.25 wrapper-set note), so both shapes are #-guarded.
fn sit_mkdir(path, mode) {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_mkdir(path, strlen(path));
    #else
    return sys_mkdir(path, mode);
    #endif
}

# rmdir counterpart of sit_mkdir: the AGNOS syscall takes a length, Linux does not.
fn sit_rmdir(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path, strlen(path));
    #else
    return sys_rmdir(path);
    #endif
}

# ── Filesystem symlink guard (S-04, S-12) ────────────────────────
#
# Calls newfstatat(AT_FDCWD, path, &stat, AT_SYMLINK_NOFOLLOW) and returns:
#   1 if path exists and is a SYMLINK
#   0 if path exists and is NOT a symlink (regular file, dir, etc.)
#  -1 if path does not exist or stat failed
#
# st_mode is read at the per-target STAT_MODE offset (24 on x86_64 Linux, 16 on
# aarch64 Linux). Through 1.6.3 it was a hardcoded 24, which on arm64 read st_uid,
# so every lstat-based guard was a no-op there.
# S_IFMT = 0xF000, S_IFLNK = 0xA000.

var VAL_AT_FDCWD = 0 - 100;
var VAL_AT_SYMLINK_NOFOLLOW = 256;

# 1 if `path` is a symlink (lstat), 0 if not, -1 if lstat fails.
fn path_is_symlink(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos's frozen ABI has no lstat / newfstatat (§4.1 exposes only the
    # symlink-FOLLOWING sys_stat), so a planted symlink resolves to its target
    # and cannot be flagged here. Report 0 (not-a-symlink) for any path that
    # exists, -1 if stat fails — preserving the contract while the S-12 guard
    # degrades to a no-op on agnos (whose single-user capability floor has no
    # attacker-writable symlink-plant vector today). Accepted degradation,
    # matching darshini's lstat→stat fallback.
    var abuf[128];
    if (sys_stat(path, strlen(path), &abuf) < 0) { return 0 - 1; }
    return 0;
    #else
    var stbuf[144];
    var rc = syscall(262, VAL_AT_FDCWD, path, &stbuf, VAL_AT_SYMLINK_NOFOLLOW);
    if (rc < 0) { return 0 - 1; }
    var mode = load32(&stbuf + STAT_MODE);
    var fmt = mode & 0xF000;
    if (fmt == 0xA000) { return 1; }
    return 0;
    #endif
}

# 1 when `apath` (already joined to the repo root) names a regular file,
# following symlinks; 0 otherwise. 1.7.6 (R11): checked before opening a file
# sit only reads — open(2) on a FIFO blocks until a writer appears, and a
# hostile tarball can put one wherever a repo file is expected.
fn path_is_regular(apath) {
    var st[256];
    if (xstat(apath, &st) != 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) == 0x8000) { return 1; }
    return 0;
}

# File-type bits (S_IFMT-masked mode) of `path` via lstat — without following
# symlinks — or -1 if stat failed. Callers compare against 0xA000 (symlink),
# 0x4000 (dir), 0x8000 (regular), etc.: S-04's "is this a directory", S-25's
# "does the target already exist as something other than a dir", and since
# 1.7.6 every "does it exist" (architecture 007: sf_exists means readable).
fn path_lstat_kind(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    # No lstat on agnos (see path_is_symlink): sys_stat FOLLOWS symlinks, so a
    # symlink-to-dir reports 0x4000 (dir), not 0xA000 (symlink). Accepted
    # degradation. STAT_MODE is the agnos struct-stat mode offset (per-target).
    var abuf[128];
    if (sys_stat(path, strlen(path), &abuf) < 0) { return 0 - 1; }
    return load32(&abuf + STAT_MODE) & 0xF000;
    #else
    var stbuf[144];
    var rc = syscall(262, VAL_AT_FDCWD, path, &stbuf, VAL_AT_SYMLINK_NOFOLLOW);
    if (rc < 0) { return 0 - 1; }
    var mode = load32(&stbuf + STAT_MODE);
    return mode & 0xF000;
    #endif
}

# ----------------------------------------------------------------
# sit-owned FS wrappers (sf_*). Every repo FS access funnels through
# one of these so the prefixing lives in a single place. The inner
# calls use the portable, length-carrying wrappers (io.cyr's file_open /
# xstat / xunlink, plus sit_mkdir / sit_rmdir above) so the same call is
# ABI-correct on Linux/macOS AND agnos — a raw Linux-shaped sys_open /
# sys_stat / sys_unlink would silently miscompile off Linux (agnos reads
# its 2nd arg as a byte length). Absolute/HOME/cert/token paths pass
# through sit_abs unchanged (rule 1), and on Linux (_repo_root == 0) every
# wrapper is a transparent forward (rule 2).
# ----------------------------------------------------------------
fn sf_exists(p) {
    # 1.7.6 (R11): file_exists opens the path, and open(2) on a FIFO blocks
    # until a writer appears — `.sit/HEAD` or `.git/HEAD` as a FIFO (a tarball
    # can ship one) hung every command at its first probe. Only regular files
    # and directories are opened; anything else reads as absent.
    var abuf[4352];
    var ap = sit_abs_into(p, &abuf, 4352);
    if (ap == 0) { ap = sit_abs(p); }
    if (_sf_special(ap) == 1) { return 0; }
    return file_exists(ap);
}

# 1 when `apath` exists and is neither a regular file nor a directory (a FIFO,
# socket or device: opening one to read can block, or reach hardware), else 0.
fn _sf_special(apath) {
    var st[256];
    if (xstat(apath, &st) != 0) { return 0; }
    var k = load32(&st + STAT_MODE) & 0xF000;
    if (k == 0x8000) { return 0; }
    if (k == 0x4000) { return 0; }
    return 1;
}

# 1 if a proper prefix of the repo-relative path `p` ("a", "a/b" for "a/b/c")
# is a symlink. Absolute paths (HOME, cert and token files) are not checked: a
# symlinked home directory is legitimate, and those paths are not repo content.
#
# 1.7.5: the prefixes and their joined paths are built on the stack. A heap
# copy of the path, and a joined path per segment, were kept for good on every
# write — `sit serve` pays this per ref push, a checkout per file.
fn _sf_parent_symlink(p) {
    if (p == 0) { return 0; }
    if (load8(p) == 47) { return 0; }
    var len = strlen(p);
    var sbuf[4096];
    var pre = &sbuf;
    if (len + 1 > 4096) { pre = alloc_or_die(len + 1); }   # past PATH_MAX: as before
    var abuf[4352];
    var i = 0;
    while (i < len) {
        if (load8(p + i) == 47) {
            if (i > 0) {
                memcpy(pre, p, i);
                store8(pre + i, 0);
                if (path_is_symlink(_sf_abs(pre, &abuf)) == 1) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# sit_abs into `abuf`, a 4352-byte buffer the caller owns (on its stack), or on
# the heap as sit_abs does when the join does not fit.
fn _sf_abs(rel, abuf) {
    var ap = sit_abs_into(rel, abuf, 4352);
    if (ap == 0) { ap = sit_abs(rel); }
    return ap;
}

# Write all `len` bytes to `fd`, looping over short writes (EINTR retried).
# Returns `len`, or a negative errno — never a silent partial count. sit's own,
# on the public `file_write`, so the consumer bundles need nothing newer than
# the toolchains they pin (owl: 6.6.2, which predates stdlib's `_io_write_full`).
fn sit_write_full(fd, buf, len) {
    var off = 0;
    var rc = 0;
    var going = 1;
    while (going == 1) {
        if (off >= len) { going = 0; }
        else {
            var n = file_write(fd, buf + off, len - off);
            if (n == 0 - 4) { }                          # EINTR: nothing written, retry
            else {
                if (n > 0) { off = off + n; }
                else {
                    rc = n;
                    if (n == 0) { rc = 0 - 5; }          # EIO: no progress
                    going = 0;
                }
            }
        }
    }
    if (rc < 0) { return rc; }
    return len;
}

# Write a whole file at a repo-root-relative path, never through a symlink.
#
# 1.6.4: this was a bare file_write_all (O_TRUNC, no O_NOFOLLOW), so a symlink at
# a ref, HEAD, config or worktree path — or at any directory above it — was
# written THROUGH: a `.sit/refs/heads/main -> ~/file` made an ordinary `sit
# commit` truncate ~/file, and a worktree `docs -> /elsewhere` made checkout /
# pull write into /elsewhere (the CVE-2021-21300 "beyond a symlink" class).
#
# Now a symlinked parent refuses with -ELOOP, and whatever sits AT the path is
# removed (a symlink is removed itself, not its target) and the file created
# with O_CREAT|O_EXCL — which also refuses a symlink planted in between, and is
# the same bit on every target (O_NOFOLLOW is not: aarch64 differs, and older
# stdlibs do not name it). Absolute paths (HOME-side files, not repo content)
# keep plain write-through semantics: a symlinked dotfile there is the user's.
fn sf_write_all(p, buf, len) {
    if (load8(p) == 47) { return file_write_all(p, buf, len); }
    if (_sf_parent_symlink(p) == 1) { return 0 - 40; }          # -ELOOP
    var abuf[4352];
    var ap = _sf_abs(p, &abuf);
    if (path_lstat_kind(ap) >= 0) { xunlink(ap); }
    var fd = file_open(ap, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);
    if (fd < 0) { return fd; }
    var written = sit_write_full(fd, buf, len);
    file_close(fd);
    return written;
}

# ── Atomic replace (1.7.6, L5) ──────────────────────────────────
#
# Refs and repository state (HEAD, refs/*, config, MERGE_HEAD, CONFLICTS, the
# stash and rebase state, the shallow list) are replaced, never rewritten:
#   1. `<path>.lock` is created O_CREAT|O_EXCL — it refuses an existing lock
#      (another sit is writing, or one died holding it; the error names the
#      file) and a symlink planted at the lock path,
#   2. the bytes are written in full and fsynced,
#   3. the lock is renamed over the path. rename replaces a symlink at the
#      target rather than following it, and readers see the old file or the new
#      one, never a cut.
# Through 1.7.5 these went through sf_write_all, which removed the old file
# before writing the new one: a failed write (disk full, quota, EIO) or a crash
# between the two left the ref empty or missing, and an empty branch ref then
# read as "unborn", so the next commit started a new root over the history.
# Worktree files keep sf_write_all: an fsync per checked-out file would cost
# more than it protects, and git does not do it either.

# rename(2) on every target: agnos carries explicit lengths.
fn _sit_rename_raw(old, new) {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_RENAME, old, strlen(old), new, strlen(new));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_rename(old, new);
    #endif
}

# Replace the file at the resolved path `ap` with `len` bytes through
# `<ap>.lock`. Returns `len`, or a negative errno (-17 EEXIST: the lock is held).
fn _write_replace(ap, buf, len) {
    var al = strlen(ap);
    var lbuf[4360];
    var lp = &lbuf;
    if (al + 6 > 4360) { lp = alloc_or_die(al + 6); }
    memcpy(lp, ap, al);
    memcpy(lp + al, ".lock", 5);
    store8(lp + al + 5, 0);
    var fd = file_open(lp, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);
    if (fd < 0) {
        if (fd == 0 - 17) {
            eprint3("sit: ", lp, " exists — another sit is writing it, or one stopped; remove it if not\n");
        }
        return fd;
    }
    # The replacement keeps the replaced file's permission bits: a 0600
    # ~/.sitconfig must not come back 0644 (umask-filtered 0644 is only the
    # mode of a file that did not exist).
    #ifndef CYRIUS_TARGET_AGNOS
    var ost[256];
    if (xstat(ap, &ost) == 0) { syscall(SYS_FCHMOD, fd, load32(&ost + STAT_MODE) & 4095); }
    #endif
    var written = sit_write_full(fd, buf, len);
    var rc = 0;
    if (written != len) { rc = written; if (rc >= 0) { rc = 0 - 5; } }
    if (rc == 0) { if (xfsync(fd) != 0) { rc = 0 - 5; } }
    file_close(fd);
    if (rc == 0) {
        var rr = _sit_rename_raw(lp, ap);
        if (rr != 0) { rc = rr; }
    }
    if (rc != 0) { xunlink(lp); return rc; }
    return len;
}

# Atomically replace the file at `p` (repo-root-relative, or absolute) with
# `len` bytes. A repo-relative path refuses (-ELOOP) a symlinked directory above
# it, as sf_write_all does; an absolute (HOME-side) path is the user's to link.
# Returns `len` or a negative errno.
fn sf_write_atomic(p, buf, len) {
    if (load8(p) != 47) {
        if (_sf_parent_symlink(p) == 1) { return 0 - 40; }          # -ELOOP
    }
    else {
        # A HOME-side file that is itself a symlink (a dotfile manager's link) is
        # written through, as before: replacing it would break the user's link.
        if (path_is_symlink(p) == 1) { return file_write_all(p, buf, len); }
    }
    var abuf[4352];
    var ap = _sf_abs(p, &abuf);
    return _write_replace(ap, buf, len);
}

# sf_write_atomic for a path `rel` inside ANOTHER repository rooted at `root`
# (a file:// push target): no directory between `root` and the file may be a
# symlink, and missing ones are created. `root` itself is the remote the user
# named. Returns `len` or a negative errno. 1.7.6 (L11 / X1): pushes wrote the
# remote's refs with a raw file_write_all, which followed a symlink planted in
# the remote at the ref or at any directory above it.
fn sf_write_atomic_at(root, rel, buf, len) {
    if (load8(rel) == 47) { return 0 - 22; }                     # -EINVAL: must be relative
    var rl = strlen(root);
    var pl = strlen(rel);
    var pbuf[4352];
    var path = &pbuf;
    if (rl + 1 + pl + 1 > 4352) { path = alloc_or_die(rl + 1 + pl + 1); }
    memcpy(path, root, rl);
    store8(path + rl, 47);
    memcpy(path + rl + 1, rel, pl);
    store8(path + rl + 1 + pl, 0);
    # Walk each directory below the root: refuse a symlink, create what is missing.
    var i = rl + 1;
    while (i < rl + 1 + pl) {
        if (load8(path + i) == 47) {
            store8(path + i, 0);
            var kind = path_lstat_kind(path);
            if (kind == 0xA000) { store8(path + i, 47); return 0 - 40; }
            if (kind < 0) { sit_mkdir(path, 0x1ED); }
            store8(path + i, 47);
        }
        i = i + 1;
    }
    return _write_replace(path, buf, len);
}

# file_open on a repo-root-relative path. A read-only open refuses a FIFO,
# socket or device (-6, ENXIO): see sf_exists (1.7.6, R11).
fn sf_open(p, flags, mode) {
    var abuf[4352];
    var ap = sit_abs_into(p, &abuf, 4352);
    if (ap == 0) { ap = sit_abs(p); }
    if (flags == 0) { if (_sf_special(ap) == 1) { return 0 - 6; } }
    return file_open(ap, flags, mode);
}

# file_read_all on a repo-root-relative path.
fn sf_read_all(p, buf, maxlen) {
    return file_read_all(sit_abs(p), buf, maxlen);
}

# file_append_locked on a repo-root-relative path; refuses (-ELOOP) to append
# through a symlink at the path or above it (a `.sit/logs/HEAD -> ~/x` made every
# reflog entry land in ~/x through 1.6.3).
fn sf_append_locked(p, buf, len) {
    if (_sf_parent_symlink(p) == 1) { return 0 - 40; }
    var ap = sit_abs(p);
    if (path_is_symlink(ap) == 1) { return 0 - 40; }
    return file_append_locked(ap, buf, len);
}

# sit_mkdir on a repo-root-relative path.
fn sf_mkdir(p, mode) {
    return sit_mkdir(sit_abs(p), mode);
}

# NOTE: no sf_ensure_dir / sf_ensure_parent_dirs / sf_read_file_heap —
# those three sit-owned fns prefix INTERNALLY (see below), so their
# existing callers stay unchanged. Wrapping them here would double-prefix.
#
# `sf_mkdir` and `sf_stat` currently have no in-tree caller and the 2026-08-17
# dead-code audit deliberately KEPT them; `sf_read_all` joined them in 1.7.4,
# when `sit serve`'s ref push moved to a resolved path, and the 1.7.6 closeout
# kept it for the same reason. They complete the sf_* family, and an
# asymmetric family is a trap: the next person needing a prefixed stat finds no
# wrapper and reaches for raw `xstat` / `sit_mkdir`, which is precisely the
# unprefixed-path bug class the seam exists to prevent (and the Linux-shaped
# syscall class fixed in 1.3.4). DCE strips both from the binary, so the only
# cost is these lines.

# unlink a repo-root-relative path; refuses (-ELOOP) when a directory above it
# is a symlink, so a removal can never reach outside the repository.
fn sf_unlink(p) {
    if (_sf_parent_symlink(p) == 1) { return 0 - 40; }
    return xunlink(sit_abs(p));
}

# rmdir a repo-root-relative path.
fn sf_rmdir(p) {
    return sit_rmdir(sit_abs(p));
}

# Remove the now-empty directories above `path`, deepest first, stopping at the
# first one that is not empty (rmdir refuses those). A stale file's directory
# would otherwise survive and block a later file of the same name (`d/x` → `d`).
fn _rmdir_empty_parents(path) {
    var len = strlen(path);
    var buf = alloc_or_die(len + 1);
    memcpy(buf, path, len);
    store8(buf + len, 0);
    var i = len - 1;
    var go = 1;
    while (go == 1) {
        if (i <= 0) { go = 0; }
        else {
            if (load8(buf + i) == 47) {
                store8(buf + i, 0);
                if (sf_rmdir(buf) != 0) { go = 0; }
            }
            i = i - 1;
        }
    }
    return 0;
}

# xstat on a repo-root-relative path.
fn sf_stat(p, buf) {
    return xstat(sit_abs(p), buf);
}

# dir_list takes a Str; route through the Str-aware prefixer.
fn sf_dir_list(p) {
    return dir_list(sit_abs_str(p));
}

# patra_open takes a cstring path (external dep).
fn sf_patra_open(p) {
    return patra_open(sit_abs(p));
}

# P-12: relative bound on inflate, layered under the absolute 16 MiB ceiling.
#
# Every `zlib_decompress` site in sit now goes through sankoch's
# `zlib_decompress_with_ratio_cap`, which rejects a stream whose output exceeds
# `ratio * src_len` — checked INCREMENTALLY during inflate, so a bomb is stopped
# while expanding rather than after.
#
# ⚠ Be honest about how much this buys. zlib's theoretical maximum is ~1032:1, so
# 1000 rejects almost nothing a real encoder can emit, and the 16 MiB absolute
# ceiling remains the load-bearing bound. What it *does* close is the specific
# decompression-bomb shape the absolute cap handles worst: a TINY input engineered
# to expand to the full ceiling — 16 KiB → 16 MiB is ratio 1024, now refused after
# ~16 MB of work instead of completing. It is a narrow backstop, not a headline
# defence.
#
# Deliberately NOT tighter. sit stores whatever a user commits, and legitimately
# repetitive content compresses hard: 1 MiB of identical bytes lands near 1000:1.
# A cap of, say, 200 would reject real objects — trading a rare correctness
# failure for a marginal security gain on a path the absolute ceiling already
# bounds. Wrong trade for a VCS.
#
# ⛔ 1.6.4: and 1000 was ALREADY that wrong trade. sankoch emits 1006:1 for 2 MiB
# of one byte and 1017:1 for 16 MiB, so `sit add` of a disk image or a padded
# binary wrote a blob every later read refused — checkout aborted, fsck counted
# it bad (which also blocks --prune forever), and objects written before 1.4.1
# turned unreadable on upgrade. The cap now sits above deflate's ~1032:1
# maximum, so it rejects no valid stream; the 16 MiB ceiling is the bound.
var SIT_MAX_INFLATE_RATIO = 1100;

# Largest file `sit add` accepts: the read path inflates an object into at most
# 16 MiB, framing header included, so anything bigger could be committed but
# never read back (1.6.4; the add cap used to be 1 GiB).
var SIT_MAX_BLOB = 16777152;

# S-25: validate a Content-Length taken off the wire.
#
# Every caller of this is parsing a header written by the other end — a remote
# server for the wire clients, a client for `sit serve` — so the value is fully
# attacker-controlled. Returns the length when it is a sane body size, or
# (0 - 1) otherwise; callers MUST treat (0 - 1) as a protocol error and abort
# the exchange rather than continuing with a nonsense length.
#
# Two distinct failure modes this closes:
#
#  1. **Overflow.** The idiomatic completeness test is `used >= body_off + clen`.
#     With clen near i64 max that sum wraps NEGATIVE, so the test passes on the
#     first pass and the reader proceeds as though it had received a body it
#     never read — then hands the bogus length to a decompressor or memcpy.
#  2. **Huge-but-positive.** A length past the buffer cap makes callers size or
#     read memory they do not own.
#
# `max` is the caller's ceiling (WIRE_HTTP_MAX_BODY / SIT_SERVE_MAX_BODY, both
# 16 MiB) so the failure modes line up across transports.
fn content_length_sane(v, max) {
    if (v < 0) { return 0 - 1; }
    if (v > max) { return 0 - 1; }
    return v;
}

# Write three cstrings to stderr, unbuffered — "<a><path><b>" — so messages
# that wrap a path need no hand-counted byte lengths (several were short by the
# 3-byte em dash and lost their newline).
fn eprint3(a, path, b) {
    syscall(SYS_WRITE, STDERR, a, strlen(a));
    syscall(SYS_WRITE, STDERR, path, strlen(path));
    syscall(SYS_WRITE, STDERR, b, strlen(b));
    return 0;
}

# Write `s` and a newline to stderr, unbuffered.
fn eprintln(s) {
    var len = strlen(s);
    syscall(SYS_WRITE, STDERR, s, len);
    syscall(SYS_WRITE, STDERR, "\n", 1);
    return 0;
}

# P-17: buffered stdout. Without this, sit's command output is dozens to
# thousands of separate syscall(SYS_WRITE, STDOUT, ...) calls — `cmd_diff`
# on a 500-line edit emits 3000+ writes. With a single 64KB heap buffer +
# explicit flush at command end, the same workload lands in a handful of
# syscalls. STDERR (eprintln) stays direct so error output is immediate
# even when the process is being killed mid-command.
var STDOUT_BUF_SIZE = 65536;
var _stdout_buf = 0;
var _stdout_pos = 0;

# Buffered stdout write; writes at least STDOUT_BUF_SIZE go straight to the kernel.
fn stdout_write(data, len) {
    if (len <= 0) { return 0; }
    if (_stdout_buf == 0) {
        _stdout_buf = alloc_or_die(STDOUT_BUF_SIZE);
    }
    # Writes larger than the buffer go straight to the kernel after a flush
    # of any pending bytes — no point copying into a buffer we'd just empty.
    if (len >= STDOUT_BUF_SIZE) {
        stdout_flush();
        syscall(SYS_WRITE, STDOUT, data, len);
        return 0;
    }
    if (_stdout_pos + len > STDOUT_BUF_SIZE) {
        stdout_flush();
    }
    memcpy(_stdout_buf + _stdout_pos, data, len);
    _stdout_pos = _stdout_pos + len;
    return 0;
}

# Flush the stdout buffer.
fn stdout_flush() {
    if (_stdout_pos == 0) { return 0; }
    syscall(SYS_WRITE, STDOUT, _stdout_buf, _stdout_pos);
    _stdout_pos = 0;
    return 0;
}

# S-17: alloc-or-die wrapper for the common case where OOM is unrecoverable
# (no transactional rollback in sit; a half-filled buffer will be memcpy'd
# from address 0 if alloc returns null and we don't notice). Use this at
# every fixed-shape `alloc(N)` site in object_db / tree / commit / merge
# instead of bare alloc; reserve bare alloc for the few callers that
# genuinely have a propagation path (read_file_heap, read_object).
fn alloc_or_die(size) {
    # 1.7.6 (L18): alloc(0) returns 0, which read as out-of-memory — an empty
    # tree (revert of a root commit, a stash of all-deleted files) could not be
    # built. A zero-byte request gets one byte.
    if (size < 1) { size = 1; }
    var p = alloc(size);
    if (p == 0) {
        eprintln("sit: out of memory");
        syscall(SYS_EXIT, 1);
    }
    return p;
}

# mkdir(path, 0o755), tolerating EEXIST (-17).
# sit-owned: prefixes `path` with the repo root (sit_abs) INTERNALLY so
# every caller (incl. ensure_parent_dirs) can pass a repo-relative path.
fn ensure_dir(path) {
    var abuf[4352];
    var r = sit_mkdir(_sf_abs(path, &abuf), 0x1ED);
    if (r == 0) { return 0; }
    if (r == 0 - 17) { return 0; }
    return r;
}

# Walk `path`, mkdir every '/'-delimited directory prefix. Used by ref writers
# so `.sit/refs/heads/feature/foo` creates `.sit/refs/heads/feature/` on demand.
# sit-owned: each derived segment is repo-relative and gets prefixed by
# ensure_dir's internal sit_abs — so this fn stays cwd-relative here and
# must NOT prefix `path` itself (that would double-prefix each segment).
#
# 1.6.4: stops (-ELOOP) at a repo-relative segment that is a symlink rather than
# creating directories beyond it. mkdir's EEXIST used to read a symlinked
# directory as "already there", so later segments were created outside the repo.
#
# 1.7.5: one segment buffer on the stack (a heap copy per '/' was kept for good).
fn ensure_parent_dirs(path) {
    var len = strlen(path);
    var abs_path = 0;
    if (len > 0) { if (load8(path) == 47) { abs_path = 1; } }
    var sbuf[4096];
    var segment = &sbuf;
    if (len + 1 > 4096) { segment = alloc_or_die(len + 1); }   # past PATH_MAX: as before
    var abuf[4352];
    var i = 0;
    var rc = 0;
    while (i < len) {
        if (rc == 0) {
            if (load8(path + i) == 47) {
                if (i > 0) {
                    memcpy(segment, path, i);
                    store8(segment + i, 0);
                    ensure_dir(segment);
                    if (abs_path == 0) {
                        if (path_is_symlink(_sf_abs(segment, &abuf)) == 1) { rc = 0 - 40; }
                    }
                }
            }
        }
        i = i + 1;
    }
    return rc;
}

# Write decimal representation of n into buf. Returns digit count.
fn write_decimal(buf, n) {
    if (n == 0) { store8(buf, 48); return 1; }
    var digits = 0;
    var m = n;
    while (m > 0) { digits = digits + 1; m = m / 10; }
    m = n;
    var i = digits - 1;
    while (m > 0) {
        store8(buf + i, 48 + m % 10);
        i = i - 1;
        m = m / 10;
    }
    return digits;
}

# Copy argv(n) into a heap-owned, null-terminated string. See
# docs/architecture/001 — argv pointers alias post-return stack memory,
# so we must copy before doing anything stack-heavy.
fn argv_heap(n) {
    var raw = argv(n);
    var len = strlen(raw);
    var s = alloc(len + 1);
    memcpy(s, raw, len);
    store8(s + len, 0);
    return s;
}

# Advance past any run of spaces or tabs in [pos, stop).
fn skip_ws(data, pos, stop) {
    var i = pos;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= stop) { scanning = 0; }
        else {
            var c = load8(data + i);
            if (c == 32) { i = i + 1; }
            else {
                if (c == 9) { i = i + 1; }
                else { scanning = 0; }
            }
        }
    }
    return i;
}

# Byte-wise compare of two cstrings: -1, 0 or 1.
fn strcmp_cstr(a, b) {
    var i = 0;
    var done = 0;
    var result = 0;
    while (done == 0) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) {
            if (ca < cb) { result = 0 - 1; }
            else { result = 1; }
            done = 1;
        }
        else {
            if (ca == 0) { done = 1; }
            else { i = i + 1; }
        }
    }
    return result;
}

# Insertion-sort a vec of cstrings in place (ascending).
fn sort_cstrings(vec) {
    var n = vec_len(vec);
    var i = 1;
    while (i < n) {
        var cur = vec_get(vec, i);
        var j = i - 1;
        var placed = 0;
        while (placed == 0) {
            if (j < 0) { placed = 1; }
            else {
                var prev = vec_get(vec, j);
                if (strcmp_cstr(cur, prev) >= 0) { placed = 1; }
                else {
                    vec_set(vec, j + 1, prev);
                    j = j - 1;
                }
            }
        }
        vec_set(vec, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Write a sanitized copy of `bytes[len]` to `fd`, replacing ASCII control
# chars (< 0x20 except \t, plus \x7f) with '?'. Used (S-21) for attacker-
# controlled commit body fragments like Author identity so a malicious commit
# can't emit ANSI escape sequences that forge log output or manipulate the
# terminal. Builds the sanitized output into a heap buffer in one pass and
# emits via a single write — both for perf (no per-char syscall) and so the
# STDOUT path stays in order with the surrounding stdout_write calls (P-17).
# S-27: sanitize an identity component for the OBJECT-WRITE path.
#
# `write_sanitized` below guards every DISPLAY path (S-21), but the commit and
# merge builders memcpy the author/committer name and email straight into the
# object body, where the ident line is `author <NAME> <<EMAIL>> <ts> +0000\n`.
# A newline in either component forges a header line — verified:
# `SIT_AUTHOR_NAME=$'evil\nparent <64-hex>'` produced a commit object carrying a
# fabricated `parent`, which every downstream parent walk then believes.
#
# This is the CVE-2023-29007 shape one layer in. Scope note, because it is
# narrower than it looks: the `.sit/config` route is already closed (the config
# parser is line-based, so `user.name` can never carry a newline), leaving the
# `SIT_AUTHOR_*` environment variables — i.e. self-inflicted. It is fixed
# anyway because a forged parent is repository corruption regardless of who
# caused it, and because "the parser happens to stop it" is not a guarantee.
#
# Drops rather than substitutes, mirroring git's ident "crud" removal: control
# bytes (which includes NL/CR/tab) plus the `<` and `>` that delimit the email.
# Returns a fresh cstring; never returns 0.
fn ident_sanitized(s) {
    if (s == 0) { return ""; }
    var n = strlen(s);
    var out = alloc_or_die(n + 1);
    var i = 0;
    var o = 0;
    while (i < n) {
        var c = load8(s + i) & 0xFF;
        var keep = 1;
        if (c < 32) { keep = 0; }        # NL, CR, tab, every control byte
        if (c == 127) { keep = 0; }      # DEL
        if (c == 60) { keep = 0; }       # '<'
        if (c == 62) { keep = 0; }       # '>'
        if (keep == 1) { store8(out + o, c); o = o + 1; }
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

# Classify the run starting at `p` (`n` bytes left) for display: returns
# -len for a run to keep as is, +len for a run to replace with one '?'.
#
# 1.7.2 (E10): bytes >= 0x80 used to pass untouched, so a UTF-8 C1 control
# (U+009B is CSI) or a bidi override in a ref name or commit message reached
# the terminal. git allows non-ASCII ref names, so the bytes are escaped on
# output, not refused on input. UTF-8 is decoded rather than byte-matched:
# 0x80-0x9F are also ordinary continuation bytes ("é" is C3 A9).
fn _text_run(p, n) {
    var c = load8(p) & 0xFF;
    if (c < 32) {
        if (c == 9) { return 0 - 1; }                 # tab stays
        return 1;                                     # C0 control
    }
    if (c == 127) { return 1; }                       # DEL
    if (c < 128) { return 0 - 1; }
    # One UTF-8 sequence. A malformed one is unsafe byte by byte: an 8-bit
    # terminal reads a lone 0x9B as CSI.
    var need = 0;
    var cp = 0;
    if (c >= 0xC2) { if (c <= 0xDF) { need = 1; cp = c & 0x1F; } }
    if (c >= 0xE0) { if (c <= 0xEF) { need = 2; cp = c & 0x0F; } }
    if (c >= 0xF0) { if (c <= 0xF4) { need = 3; cp = c & 0x07; } }
    if (need == 0) { return 1; }                      # continuation or bad lead
    if (need >= n) { return 1; }                      # truncated
    var k = 1;
    while (k <= need) {
        var cc = load8(p + k) & 0xFF;
        if ((cc & 0xC0) != 0x80) { return 1; }
        cp = (cp << 6) | (cc & 0x3F);
        k = k + 1;
    }
    if (need == 2) {
        if (cp < 0x800) { return 1; }                 # overlong
        if (cp >= 0xD800) { if (cp <= 0xDFFF) { return 1; } }   # surrogate
    }
    if (need == 3) {
        if (cp < 0x10000) { return 1; }               # overlong
        if (cp > 0x10FFFF) { return 1; }
    }
    var run = need + 1;
    if (cp <= 0x9F) { return run; }                   # C1 control (U+0080-U+009F)
    # Bidi controls (Trojan Source, CVE-2021-42574): ALM, LRM / RLM,
    # LRE / RLE / PDF / LRO / RLO, LRI / RLI / FSI / PDI.
    if (cp == 0x061C) { return run; }
    if (cp == 0x200E) { return run; }
    if (cp == 0x200F) { return run; }
    if (cp >= 0x202A) { if (cp <= 0x202E) { return run; } }
    if (cp >= 0x2066) { if (cp <= 0x2069) { return run; } }
    return 0 - run;
}

# A display-safe copy of bytes[0, len): each C0 control (except tab), DEL, C1
# control, bidi control and malformed UTF-8 byte becomes one '?'. Returns a
# fresh cstring and writes its length to `out_len`; never longer than `len`.
fn text_sanitized(bytes, len, out_len) {
    var out = alloc_or_die(len + 1);
    var i = 0;
    var o = 0;
    while (i < len) {
        var r = _text_run(bytes + i, len - i);
        if (r > 0) {
            store8(out + o, 63);                      # '?'
            o = o + 1;
            i = i + r;
        }
        else {
            memcpy(out + o, bytes + i, 0 - r);
            o = o + (0 - r);
            i = i + (0 - r);
        }
    }
    store8(out + o, 0);
    store64(out_len, o);
    return out;
}

# Write bytes to `fd` made display-safe by text_sanitized.
fn write_sanitized(fd, bytes, len) {
    if (len <= 0) { return 0; }
    var olen[8];
    var out = text_sanitized(bytes, len, &olen);
    if (fd == STDOUT) { stdout_write(out, load64(&olen)); }
    else { syscall(SYS_WRITE, fd, out, load64(&olen)); }
    return 0;
}

# Read an entire file into a heap buffer. Writes (ptr, len) to out_pair.
# Returns 0 on success, negative on failure.
# sit-owned: prefixes `path` with the repo root (sit_abs) INTERNALLY so
# its many callers need no change.
fn read_file_heap(path, out_pair) {
    return _read_whole(path, out_pair, 0);
}

# read_file_heap into a freelist buffer the caller frees with fl_free (1.7.6,
# R1): for reads a long-lived consumer repeats — `.git/packed-refs` on every
# HEAD lookup was kept on the bump heap each time.
fn read_file_fl(path, out_pair) {
    return _read_whole(path, out_pair, 1);
}

fn _read_whole(path, out_pair, use_fl) {
    # 1.7.6 (R1 / R11): the joined path on the stack (sit_abs kept one on the
    # heap per call when the root is absolute), and only a regular file is
    # opened — a FIFO at `.git/HEAD` or `.git/config` (a tarball can ship one)
    # blocked the open forever.
    var abuf[4352];
    var ap = sit_abs_into(path, &abuf, 4352);
    if (ap == 0) { ap = sit_abs(path); }
    if (path_is_regular(ap) == 0) { return 0 - 1; }
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var size = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    syscall(SYS_LSEEK, fd, 0, SEEK_SET);
    if (size < 0) { file_close(fd); return 0 - 2; }
    # S-06: read_file_heap is used for config files and ref files, which should
    # never exceed a few KB. Cap at 64 MiB to keep a hostile / accidentally-huge
    # file from triggering a multi-GB allocation here.
    if (size > 67108864) { file_close(fd); return 0 - 4; }
    var buf = 0;
    if (use_fl == 1) { buf = fl_alloc(size + 1); }
    else { buf = alloc(size + 1); }
    if (buf == 0) { file_close(fd); return 0 - 3; }
    var total = 0;
    var rgo = 1;
    var rerr = 0;
    while (rgo == 1) {
        var n = file_read(fd, buf + total, size - total);
        if (n < 0) { rerr = 1; rgo = 0; }
        else {
            if (n == 0) { rgo = 0; }
            else { total = total + n; if (total >= size) { rgo = 0; } }
        }
    }
    file_close(fd);
    # 1.7.6: a read that failed part-way is a failure, not a short file — a
    # config or state file read as its first half is rewritten as that half.
    if (rerr == 1) {
        if (use_fl == 1) { fl_free(buf); }
        return 0 - 5;
    }
    store64(out_pair, buf);
    store64(out_pair + 8, total);
    return 0;
}
