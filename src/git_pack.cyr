# git_pack.cyr — read-only git packfile decode (roadmap 1.2.0, bite 2).
#
# Reads objects out of .git/objects/pack/*.{idx,pack}: binary-search the v2
# .idx for an oid -> pack offset, parse the pack v2 object header, inflate
# non-delta objects (sankoch zlib — no new dep), and reconstruct OFS_DELTA /
# REF_DELTA objects via a self-written copy/insert delta interpreter. Byte
# formats per gitformat-pack. Ordered AFTER git_read.cyr (uses _id_hexlen /
# _id_rawlen / _git_read_loose) and BEFORE object_db.cyr (read_object dispatches
# to _git_read_any) so the single-pass dist bundle stays forward-only.
#
# Shifts are written as * / to avoid any dependence on << / >>. All the object
# out-params use read_object's 24-byte contract {content_ptr, content_len,
# content_off}; pack objects carry no loose framing, so content_off is 0.

# Deepest delta chain a read follows: git's own ceiling (pack.depth is capped at
# 4095). 1.7.3 resolved chains by recursion and stopped at 64, so the deeper
# objects of a repo repacked with `--depth=250` (git gc --aggressive's old
# default, and still common advice) read as missing (D6, 1.7.4).
var _PACK_DELTA_MAX_DEPTH = 4095;
# 1.7.6 (R4): the most a single read may produce across its whole delta chain.
# Each step is held to 16 MiB, but 4095 such steps is 64 GiB of work — a 114 KB
# crafted pack took `sit cat-file` 244 s of CPU on 1.7.5. 4 GiB covers a
# `git repack --depth=250` (still common advice) of a blob at sit's 16 MiB
# object ceiling; 1 GiB, the first cut, refused the older revisions of a 12 MB
# file repacked that way, which git reads. Past it the object reads as missing.
var _PACK_CHAIN_MAX_OUT = 4294967296;
# One link of a chain being resolved: the delta object's pack {data, len}, where
# its zlib payload starts, and its declared (inflated) size.
var _PACK_LINK = 32;

# Reject an absurd object size from a hostile pack header before allocating.
#
# NOTE (v1.3.5): this is not the binding limit in practice. sankoch enforces
# DECOMPRESS_MAX_OUTPUT = 16 MiB inside its deflate decoder, and as of sankoch
# 2.5.10 that ceiling covers stored (uncompressed) blocks too — the one loophole
# that previously let a >16 MiB object through. So a pack object larger than
# 16 MiB now fails closed at the `zlib_decompress` calls below with
# -ERR_OUTPUT_LIMIT rather than reaching this bound. That is a clean read
# failure, never corruption, and huffman-coded blocks over 16 MiB already
# behaved this way. Kept at 256 MiB as the pre-allocation sanity gate it was
# written to be; the effective object ceiling is sankoch's 16 MiB.
var _PACK_MAX_OBJ = 268435456;   # 256 MiB
# Largest object a delta may reconstruct — the 16 MiB ceiling read_object
# enforces everywhere else (D5, 1.6.4).
var _DELTA_MAX_RESULT = 16777216;

# --- big-endian readers ------------------------------------------------------
fn _be32(p) {
    var v = load8(p) & 0xFF;
    v = v * 256 + (load8(p + 1) & 0xFF);
    v = v * 256 + (load8(p + 2) & 0xFF);
    v = v * 256 + (load8(p + 3) & 0xFF);
    return v;
}
fn _be64(p) {
    var v = load8(p) & 0xFF;
    var i = 1;
    while (i < 8) {
        v = v * 256 + (load8(p + i) & 0xFF);
        i = i + 1;
    }
    return v;
}

# Lexicographic compare of n bytes. <0 / 0 / >0 (sign of first differing byte).
fn _memcmp_n(a, b, n) {
    var i = 0;
    var result = 0;
    while (i < n) {
        if (result == 0) {
            var av = load8(a + i) & 0xFF;
            var bv = load8(b + i) & 0xFF;
            if (av != bv) { result = av - bv; }
        }
        i = i + 1;
    }
    return result;
}

# Read one byte at the cursor and advance it. Callers MUST have already checked
# that the byte is in bounds — every call site below pre-validates the whole
# run of bytes an opcode needs (see `_delta_op_bytes`), so this stays branchless.
fn _next_byte(data, curptr) {
    var b = load8(data + load64(curptr)) & 0xFF;
    store64(curptr, load64(curptr) + 1);
    return b;
}

# Number of trailing operand bytes a delta COPY opcode encodes: one per set bit
# in the low 7 bits (4 offset bytes, 3 size bytes). Used to bounds-check the
# whole operand run before `_next_byte` consumes any of it.
fn _delta_op_bytes(op) {
    var n = 0;
    if ((op & 0x01) != 0) { n = n + 1; }
    if ((op & 0x02) != 0) { n = n + 1; }
    if ((op & 0x04) != 0) { n = n + 1; }
    if ((op & 0x08) != 0) { n = n + 1; }
    if ((op & 0x10) != 0) { n = n + 1; }
    if ((op & 0x20) != 0) { n = n + 1; }
    if ((op & 0x40) != 0) { n = n + 1; }
    return n;
}

# Max continuation bytes any pack varint may carry. git's size/offset varints
# are 7 bits per byte, so 10 bytes covers the full i64 range; anything longer is
# a hostile encoding padded to overflow the accumulator.
var _PACK_VARINT_MAX = 10;

# --- .idx v2 lookup ----------------------------------------------------------
# Binary-search idx_path (v2) for oid_raw (rawlen bytes) -> pack byte offset.
# Returns the offset (>= 12) on hit, or -1 (miss / unreadable / v1 idx / bad
# magic). rawlen is 20 (SHA-1) or 32 (SHA-256).
fn _git_idx_lookup(idx_path, oid_raw, rawlen) {
    var pr[16];
    if (_git_file_cached(idx_path, &pr) != 0) { return 0 - 1; }
    var d = load64(&pr);
    var len = load64(&pr + 8);
    if (len < 1032) { return 0 - 1; }
    # magic 0xFF 't' 'O' 'c'; absence => v1 idx (unsupported here).
    if ((load8(d) & 0xFF) != 255) { return 0 - 1; }
    if ((load8(d + 1) & 0xFF) != 116) { return 0 - 1; }
    if ((load8(d + 2) & 0xFF) != 79) { return 0 - 1; }
    if ((load8(d + 3) & 0xFF) != 99) { return 0 - 1; }
    if (_be32(d + 4) != 2) { return 0 - 1; }

    var fanout = d + 8;
    var N = _be32(fanout + 255 * 4);
    # S-24: N and the fanout bounds are all attacker-supplied. Every table
    # address below is derived from them, so validate against the actual file
    # length before any of them becomes a load address. Without this a crafted
    # .idx whose fanout claims ~1e9 entries drove `oid_table + mid * rawlen`
    # gigabytes past the mapping — a reproducible SIGSEGV on `sit cat-file`
    # against a hostile repo, and an out-of-bounds read at milder offsets.
    if (N < 0) { return 0 - 1; }
    if (rawlen <= 0) { return 0 - 1; }
    # oids + CRCs + short offsets must all fit: 1032 + N*(rawlen + 4 + 4).
    if (N > (len - 1032) / (rawlen + 8)) { return 0 - 1; }

    var b0 = load8(oid_raw) & 0xFF;
    var lo = 0;
    if (b0 != 0) { lo = _be32(fanout + (b0 - 1) * 4); }
    var hi = _be32(fanout + b0 * 4);
    # The fanout is cumulative and must be monotonic within [0, N].
    if (lo < 0) { return 0 - 1; }
    if (hi > N) { return 0 - 1; }
    if (lo > hi) { return 0 - 1; }
    var oid_table = d + 1032;

    var mid = 0;
    var found = 0 - 1;
    while (lo < hi) {
        if (found < 0) {
            mid = (lo + hi) / 2;
            var cmp = _memcmp_n(oid_table + mid * rawlen, oid_raw, rawlen);
            if (cmp == 0) { found = mid; lo = hi; }
            else {
                if (cmp < 0) { lo = mid + 1; }
                else { hi = mid; }
            }
        }
        else { lo = hi; }
    }
    if (found < 0) { return 0 - 1; }

    var off_table = oid_table + N * rawlen + N * 4;   # skip oids + CRCs
    var off32 = _be32(off_table + found * 4);
    if ((off32 & 2147483648) == 0) { return off32; }
    # Large-offset (>2 GiB) entry: the 8-byte table sits after the 4-byte one,
    # and is NOT covered by the size gate above — bound it against `len` here.
    var large_table = off_table + N * 4;
    var idx2 = off32 & 2147483647;
    var large_off = 1032 + N * (rawlen + 8) + idx2 * 8;
    if (large_off < 0) { return 0 - 1; }
    if (large_off + 8 > len) { return 0 - 1; }
    return _be64(large_table + idx2 * 8);
}

# --- .idx / .pack load (cached per path) ------------------------------------
# Every .idx and .pack is read ONCE per process and kept.
#
# 1.6.4 (D3): only the most recent pack was cached, and every object lookup
# re-read every .idx in full. sit's heap is a bump allocator that never frees,
# so memory grew as (objects read) x (total idx size): sit_repo_status — which
# reads every tracked blob — peaked at 263 MB on a 3,000-file repo and 4 GB on
# 12,000 files, and owl / thoth run it in-process. Two packs read alternately
# re-read both on every switch the same way. Now each file costs its size once.
#
# 1.7.4 (D6): each file is mapped read-only rather than copied onto the heap.
# read_file_heap refuses anything over 64 MiB (S-06), so a larger pack — or the
# .idx of a repo with a few million objects — read as absent, and every object in
# it as missing: sit_repo_status then called a clean file modified or untracked.
# A mapping costs no heap at any size; the kernel pages it in as objects are read.
# Where mmap is unavailable (agnos), or refused, the file is read as before.
# Like git, which maps its packs too, this assumes a pack is never truncated in
# place (git writes a new one and renames it); reading past a truncation faults.
var _git_file_cache = 0;

# Map `path` read-only into out_pair {addr, len}. 0, or -1 when it cannot be
# opened, is empty, or mmap refuses.
#
# 1.7.6: -1 when it cannot be opened (or is not a regular file — a FIFO
# blocked the open forever, R11), -2 when it opened but mmap refused, which is
# the only case _git_file_cached falls back to reading. The joined path is on
# the stack (R14): sit_abs kept ~320 B on the heap per lookup of an .idx that
# cannot be opened, since failures are not cached.
fn _git_file_map(path, out_pair) {
    var abuf[4352];
    var ap = sit_abs_into(path, &abuf, 4352);
    if (ap == 0) { return 0 - 1; }
    if (path_is_regular(ap) == 0) { return 0 - 1; }
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var size = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    if (size <= 0) { file_close(fd); return 0 - 1; }
    var addr = mmap_file_ro(fd, size);
    file_close(fd);                                # the mapping outlives the fd
    if (addr == 0) { return 0 - 2; }
    store64(out_pair, addr);
    store64(out_pair + 8, size);
    return 0;
}

fn _git_file_cached(path, out_pair) {
    if (_git_file_cache == 0) { _git_file_cache = map_new(); }
    var hit = map_get(_git_file_cache, path);
    if (hit != 0) {
        store64(out_pair, load64(hit));
        store64(out_pair + 8, load64(hit + 8));
        return 0;
    }
    var pr[16];
    var mr = _git_file_map(path, &pr);
    if (mr == 0 - 1) { return 0 - 1; }
    if (mr != 0) {
        if (read_file_heap(path, &pr) != 0) { return 0 - 1; }
    }
    var cell = alloc_or_die(16);
    store64(cell, load64(&pr));
    store64(cell + 8, load64(&pr + 8));
    var pl = strlen(path);
    var key = alloc_or_die(pl + 1);
    memcpy(key, path, pl);
    store8(key + pl, 0);
    map_set(_git_file_cache, key, cell);
    store64(out_pair, load64(cell));
    store64(out_pair + 8, load64(cell + 8));
    return 0;
}

fn _git_load_pack(path, out_pair) {
    return _git_file_cached(path, out_pair);
}

# --- varint decoders (cursor is an i64 slot, advanced in place) --------------
# Pack object header: byte0 = [cont|3-bit type|4-bit size-low]; continuation
# bytes add 7 bits each (little-endian). Writes type to out_type, returns size.
# S-24: `limit` is the length of `data`. A hostile pack can set the continuation
# bit on its final byte, so every one of these fails closed (returns a negative
# sentinel) on overrun rather than walking off the buffer. They also cap the
# continuation run at `_PACK_VARINT_MAX` and reject a wrapped accumulator, so a
# padded varint can't overflow `size` negative and slip past the `> _PACK_MAX_OBJ`
# gate. Callers MUST check the sentinel before using the result.
fn _pack_obj_header(data, curptr, out_type, limit) {
    if (load64(curptr) < 0) { return 0 - 1; }
    if (load64(curptr) >= limit) { return 0 - 1; }
    var c = load8(data + load64(curptr)) & 0xFF;
    store64(curptr, load64(curptr) + 1);
    var type = (c / 16) & 7;
    var size = c & 0x0F;
    var mult = 16;
    var cont = c & 0x80;
    var used = 0;
    var bad = 0;
    while (cont != 0) {
        if (load64(curptr) >= limit) { cont = 0; bad = 1; }
        else {
            if (used >= _PACK_VARINT_MAX) { cont = 0; bad = 1; }
            else {
                var b = load8(data + load64(curptr)) & 0xFF;
                store64(curptr, load64(curptr) + 1);
                used = used + 1;
                size = size + (b & 0x7F) * mult;
                mult = mult * 128;
                cont = b & 0x80;
            }
        }
    }
    if (bad != 0) { return 0 - 1; }
    if (size < 0) { return 0 - 1; }
    store64(out_type, type);
    return size;
}

# OFS_DELTA base-offset varint (the ((ofs+1)<<7)|next biased big-endian scheme).
fn _ofs_varint(data, curptr, limit) {
    if (load64(curptr) < 0) { return 0 - 1; }
    if (load64(curptr) >= limit) { return 0 - 1; }
    var b = load8(data + load64(curptr)) & 0xFF;
    store64(curptr, load64(curptr) + 1);
    var ofs = b & 0x7F;
    var cont = b & 0x80;
    var used = 0;
    var bad = 0;
    while (cont != 0) {
        if (load64(curptr) >= limit) { cont = 0; bad = 1; }
        else {
            if (used >= _PACK_VARINT_MAX) { cont = 0; bad = 1; }
            else {
                b = load8(data + load64(curptr)) & 0xFF;
                store64(curptr, load64(curptr) + 1);
                used = used + 1;
                ofs = (ofs + 1) * 128 + (b & 0x7F);
                cont = b & 0x80;
            }
        }
    }
    if (bad != 0) { return 0 - 1; }
    if (ofs < 0) { return 0 - 1; }
    return ofs;
}

# Delta size varint: pure 7-bit little-endian chunks from byte 0.
fn _delta_varint(data, curptr, limit) {
    var val = 0;
    var mult = 1;
    var cont = 1;
    var used = 0;
    var bad = 0;
    while (cont != 0) {
        if (load64(curptr) >= limit) { cont = 0; bad = 1; }
        else {
            if (used >= _PACK_VARINT_MAX) { cont = 0; bad = 1; }
            else {
                var b = load8(data + load64(curptr)) & 0xFF;
                store64(curptr, load64(curptr) + 1);
                used = used + 1;
                val = val + (b & 0x7F) * mult;
                mult = mult * 128;
                cont = b & 0x80;
            }
        }
    }
    if (bad != 0) { return 0 - 1; }
    if (val < 0) { return 0 - 1; }
    return val;
}

# --- delta apply -------------------------------------------------------------
# The result size a delta declares, once its header checks out against the base
# it is applied to; -1 otherwise. `cur` (an i64 slot) is left at the first
# instruction.
fn _git_delta_header(base_len, delta, delta_len, cur) {
    store64(cur, 0);
    if (base_len < 0) { return 0 - 1; }
    if (delta_len <= 0) { return 0 - 1; }
    # 1.6.4 (D10): git's patch_delta rejects a delta whose declared base size is
    # not the base it is applied to; this read the field and discarded it, so a
    # delta against the wrong base reconstructed wrong content whenever its
    # copies happened to fit.
    var declared_base = _delta_varint(delta, cur, delta_len);
    if (declared_base < 0) { return 0 - 1; }
    if (declared_base != base_len) { return 0 - 1; }
    var result_size = _delta_varint(delta, cur, delta_len);
    if (result_size <= 0) { return 0 - 1; }
    # 1.6.4 (D5): held to the same 16 MiB object ceiling as every other read.
    # The 256 MiB pack-entry cap let a small hostile delta make an in-process
    # consumer allocate and fill 256 MiB per chain level.
    if (result_size > _DELTA_MAX_RESULT) { return 0 - 1; }
    return result_size;
}

# Reconstruct a target object from base + delta instruction stream. Writes the
# read_object contract into out24 (content_off 0), in a freelist buffer the
# caller owns. Returns 0 or negative.
fn _git_apply_delta(base, base_len, delta, delta_len, out24) {
    var cur[8];
    var result_size = _git_delta_header(base_len, delta, delta_len, &cur);
    if (result_size < 0) { return 0 - 1; }
    var out = fl_alloc(result_size);
    if (out == 0) { return 0 - 2; }
    var r = _git_apply_delta_into(base, base_len, delta, delta_len, out, result_size);
    if (r < 0) { fl_free(out); return r; }
    store64(out24, out);
    store64(out24 + 8, r);
    store64(out24 + 16, 0);
    return 0;
}

# Copy `n` bytes, eight at a time (1.7.6, R4). Delta copy ops go through this:
# stdlib memcpy is a byte loop (~140 MB/s), which made a deep chain of large
# results cost minutes. The source (a base or a delta) never overlaps `dst`.
fn _pack_copy(dst, src, n) {
    var i = 0;
    var w = n - 7;
    while (i < w) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    while (i < n) {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
    return dst;
}

# _git_apply_delta into a caller's buffer of `out_cap` bytes. Returns the result
# length, or negative: -1 a bad header, -2 `out_cap` below the declared size,
# -3..-9 a bad instruction. 1.7.4 (D6): split out so a delta chain reuses two
# buffers for all its steps rather than allocating one per step.
fn _git_apply_delta_into(base, base_len, delta, delta_len, out, out_cap) {
    # S-24: `base` / `delta` are both attacker-controlled in a hostile repo, so
    # validate the pair before touching either.
    if (base == 0) { return 0 - 1; }
    var cur[8];
    var result_size = _git_delta_header(base_len, delta, delta_len, &cur);
    if (result_size < 0) { return 0 - 1; }
    if (out == 0) { return 0 - 2; }
    if (out_cap < result_size) { return 0 - 2; }
    var op_out = 0;
    var err = 0;
    while (load64(&cur) < delta_len) {
        if (err == 0) {
            var op = load8(delta + load64(&cur)) & 0xFF;
            store64(&cur, load64(&cur) + 1);
            if ((op & 0x80) != 0) {
                # S-24: the operand run must be fully in bounds before
                # `_next_byte` consumes any of it — a COPY opcode in the final
                # bytes of the delta would otherwise read past `delta_len`.
                if (load64(&cur) + _delta_op_bytes(op) > delta_len) { err = 0 - 8; }
                else {
                    var coff = 0;
                    var csize = 0;
                    if ((op & 0x01) != 0) { coff = coff + _next_byte(delta, &cur); }
                    if ((op & 0x02) != 0) { coff = coff + _next_byte(delta, &cur) * 256; }
                    if ((op & 0x04) != 0) { coff = coff + _next_byte(delta, &cur) * 65536; }
                    if ((op & 0x08) != 0) { coff = coff + _next_byte(delta, &cur) * 16777216; }
                    if ((op & 0x10) != 0) { csize = csize + _next_byte(delta, &cur); }
                    if ((op & 0x20) != 0) { csize = csize + _next_byte(delta, &cur) * 256; }
                    if ((op & 0x40) != 0) { csize = csize + _next_byte(delta, &cur) * 65536; }
                    if (csize == 0) { csize = 65536; }
                    if (coff + csize > base_len) { err = 0 - 3; }
                    else {
                        if (op_out + csize > result_size) { err = 0 - 4; }
                        else {
                            _pack_copy(out + op_out, base + coff, csize);
                            op_out = op_out + csize;
                        }
                    }
                }
            }
            else {
                if (op != 0) {
                    var lit = op & 0x7F;
                    # S-24: bound the literal against the DELTA (source) as well
                    # as the result buffer (destination). Only the destination
                    # was checked before, so a literal opcode declaring more
                    # bytes than the delta has left copied up to 127 bytes of
                    # adjacent heap into the reconstructed object — readable by
                    # the user via `sit cat-file`.
                    if (load64(&cur) + lit > delta_len) { err = 0 - 9; }
                    else {
                        if (op_out + lit > result_size) { err = 0 - 5; }
                        else {
                            memcpy(out + op_out, delta + load64(&cur), lit);
                            store64(&cur, load64(&cur) + lit);
                            op_out = op_out + lit;
                        }
                    }
                }
                else { err = 0 - 6; }
            }
        }
        else { store64(&cur, delta_len); }
    }
    if (err != 0) { return err; }
    if (op_out != result_size) { return 0 - 7; }
    return result_size;
}

# --- pack object reconstruct -------------------------------------------------
# Reconstruct the object at `offset` in the in-memory pack {pdata,plen}. Writes
# read_object contract into out24 (content_off 0).
#
# 1.7.4 (D6): iterative. The chain is walked down to its base first, recording
# each delta it passes (an OFS_DELTA steps back in the same pack; a REF_DELTA
# names its base by id, which may be loose or in another pack). Then the deltas
# are applied from the base upward. Every intermediate base and delta buffer is
# freed once the next step has used it, so a read keeps only its result: the
# recursion this replaces kept every level of every chain on the bump heap, which
# owl and thoth pay in-process for each blob sit_repo_status reads.
#
# The chain is bounded at _PACK_DELTA_MAX_DEPTH links. An OFS_DELTA chain cannot
# loop (each base lies strictly before its delta); a REF_DELTA cycle stops there.
# Each step's result is held to 16 MiB (D5), so the worst a hostile chain costs is
# 4095 such steps, the bound git itself accepts.

# Write `n` raw bytes as lowercase hex into `out` (2n bytes + NUL).
fn _hex_into(raw, n, out) {
    var digits = "0123456789abcdef";
    var i = 0;
    while (i < n) {
        var b = load8(raw + i) & 0xFF;
        store8(out + i * 2, load8(digits + b / 16));
        store8(out + i * 2 + 1, load8(digits + (b & 15)));
        i = i + 1;
    }
    store8(out + n * 2, 0);
    return 0;
}

# Inflate `size` declared bytes at `body` of {pdata,plen} into a fresh freelist
# buffer. Returns the buffer and stores the inflated length at `out_len`, or 0.
fn _pack_inflate(pdata, plen, body, size, out_len) {
    # S-24: a header that consumed the whole buffer leaves body == plen, making
    # `plen - body` zero or negative — never hand that to the decompressor.
    if (body >= plen) { return 0; }
    var buf = fl_alloc(size + 16);
    if (buf == 0) { return 0; }
    var got = zlib_decompress_with_ratio_cap(pdata + body, plen - body,
      buf, size + 16, SIT_MAX_INFLATE_RATIO);
    # 1.7.6 (R3): errors are negative; 0 bytes is a valid inflate (an empty
    # file — `__init__.py`, `.gitkeep` — packs to exactly that), and was read
    # as a failure, so every empty blob in a gc'd repo was unreadable. git
    # requires the result to be the size the header declared; so does this.
    if (got < 0) { fl_free(buf); return 0; }
    if (got != size) { fl_free(buf); return 0; }
    store64(out_len, got);
    return buf;
}

fn _git_pack_obj(pdata, plen, offset, out24) {
    var links_cap = 16;
    var links = fl_alloc(links_cap * _PACK_LINK);
    if (links == 0) { return 0 - 11; }
    var nlinks = 0;
    var cp = pdata;
    var cl = plen;
    var co = offset;
    var base = 0;            # the base's bytes once found
    var base_len = 0;
    var base_owned = 0;      # 1 when `base` is a freelist buffer this read made
    var loose_buf = 0;       # a loose base's own buffer, freed when the chain is done
    var rc = 0;
    var walking = 1;
    while (walking == 1) {
        # S-24: `co` comes from the .idx offset table (attacker-supplied, up to
        # 2^63 via the large-offset table) or an OFS_DELTA back-reference. The
        # pack v2 header is 12 bytes, so any real object starts at >= 12.
        if (cp == 0) { rc = 0 - 10; }
        if (rc == 0) { if (co < 12) { rc = 0 - 10; } }
        if (rc == 0) { if (co >= cl) { rc = 0 - 10; } }
        var cur[8];
        var type_slot[8];
        var size = 0;
        var type = 0;
        if (rc == 0) {
            store64(&cur, co);
            store64(&type_slot, 0);
            size = _pack_obj_header(cp, &cur, &type_slot, cl);
            if (size < 0) { rc = 0 - 10; }
            if (size > _PACK_MAX_OBJ) { rc = 0 - 10; }
            type = load64(&type_slot);
        }
        if (rc == 0) {
            if (type >= 1) {
                if (type <= 4) {
                    var got[8];
                    base = _pack_inflate(cp, cl, load64(&cur), size, &got);
                    if (base == 0) { rc = 0 - 12; }
                    else { base_len = load64(&got); base_owned = 1; }
                    walking = 0;
                }
            }
        }
        if (rc == 0) {
            if (walking == 1) {
                if (type != 6) { if (type != 7) { rc = 0 - 21; } }
                if (rc == 0) { if (nlinks >= _PACK_DELTA_MAX_DEPTH) { rc = 0 - 13; } }
            }
        }
        if (rc == 0) {
            if (walking == 1) {
                if (nlinks >= links_cap) {
                    var grown = fl_alloc(links_cap * 2 * _PACK_LINK);
                    if (grown == 0) { rc = 0 - 11; }
                    else {
                        memcpy(grown, links, nlinks * _PACK_LINK);
                        fl_free(links);
                        links = grown;
                        links_cap = links_cap * 2;
                    }
                }
            }
        }
        if (rc == 0) {
            if (walking == 1) {
                if (type == 6) {
                    var ofs = _ofs_varint(cp, &cur, cl);
                    # S-24: a zero-distance back-reference would make the object its
                    # own base.
                    if (ofs <= 0) { rc = 0 - 14; }
                    if (rc == 0) { if (co - ofs < 0) { rc = 0 - 14; } }
                    if (rc == 0) {
                        var lk = links + nlinks * _PACK_LINK;
                        store64(lk, cp);
                        store64(lk + 8, cl);
                        store64(lk + 16, load64(&cur));
                        store64(lk + 24, size);
                        nlinks = nlinks + 1;
                        co = co - ofs;
                    }
                }
                else {
                    # REF_DELTA: the base id is `rawlen` raw bytes at the cursor.
                    var rawlen = _id_rawlen();
                    # S-24: bound the whole run before it is read.
                    if (load64(&cur) + rawlen > cl) { rc = 0 - 18; }
                    var base_hex[72];
                    if (rc == 0) {
                        _hex_into(cp + load64(&cur), rawlen, &base_hex);
                        var lk2 = links + nlinks * _PACK_LINK;
                        store64(lk2, cp);
                        store64(lk2 + 8, cl);
                        store64(lk2 + 16, load64(&cur) + rawlen);
                        store64(lk2 + 24, size);
                        nlinks = nlinks + 1;
                        var loose24[24];
                        if (_git_read_loose(&base_hex, &loose24) == 0) {
                            # A loose base carries its framing; step past it.
                            # 1.7.6 (R5): the buffer is the loose reader's
                            # freelist allocation, handed to this read — it was
                            # never freed, so a 4 MiB loose base was kept on
                            # every read through it.
                            loose_buf = load64(&loose24);
                            base = load64(&loose24) + load64(&loose24 + 16);
                            base_len = load64(&loose24 + 8) - load64(&loose24 + 16);
                            if (base_len < 0) { rc = 0 - 18; }
                            walking = 0;
                        }
                        else {
                            var loc[24];
                            if (_git_pack_locate(&base_hex, &loc) != 0) { rc = 0 - 18; }
                            else {
                                cp = load64(&loc);
                                cl = load64(&loc + 8);
                                co = load64(&loc + 16);
                            }
                        }
                    }
                }
            }
        }
        if (rc != 0) { walking = 0; }
    }
    # Apply the deltas from the base upward: the last link recorded is the one
    # nearest the base. Two result buffers take turns as each step's base and
    # output, and one holds the inflated delta. Each is replaced only when a step
    # needs more room, so a chain costs a few allocations however deep it is:
    # one per step measured 28% slower, every buffer over 4 KiB being its own
    # mapping.
    var base_cap = base_len;           # an inflated base's buffer is reusable
    var other = 0;
    var other_cap = 0;
    var dbuf = 0;
    var dcap = 0;
    var chain_out = 0;
    var li = nlinks - 1;
    while (li >= 0) {
        if (rc == 0) {
            var l = links + li * _PACK_LINK;
            var lp = load64(l);
            var lplen = load64(l + 8);
            var body = load64(l + 16);
            var need = load64(l + 24) + 16;
            if (body >= lplen) { rc = 0 - 17; }  # S-24: never a non-positive inflate length
            if (rc == 0) {
                if (dcap < need) {
                    if (dbuf != 0) { fl_free(dbuf); }
                    dbuf = fl_alloc(need);
                    dcap = need;
                    if (dbuf == 0) { dcap = 0; rc = 0 - 17; }
                }
            }
            var dlen = 0;
            if (rc == 0) {
                dlen = zlib_decompress_with_ratio_cap(lp + body, lplen - body, dbuf, need,
                  SIT_MAX_INFLATE_RATIO);
                if (dlen <= 0) { rc = 0 - 17; }
            }
            var hcur[8];
            var rsize = 0;
            if (rc == 0) {
                rsize = _git_delta_header(base_len, dbuf, dlen, &hcur);
                if (rsize < 0) { rc = 0 - 1; }
            }
            if (rc == 0) {
                if (other_cap < rsize) {
                    if (other != 0) { fl_free(other); }
                    other = fl_alloc(rsize);
                    other_cap = rsize;
                    if (other == 0) { other_cap = 0; rc = 0 - 2; }
                }
            }
            if (rc == 0) {
                var ar = _git_apply_delta_into(base, base_len, dbuf, dlen, other, other_cap);
                if (ar >= 0) {
                    chain_out = chain_out + ar;
                    if (chain_out > _PACK_CHAIN_MAX_OUT) { ar = 0 - 19; }
                }
                if (ar < 0) { rc = ar; }
                else {
                    # The output becomes the next base; the old base's buffer, if
                    # it is this read's, becomes the next output.
                    var prev = base;
                    var prev_cap = base_cap;
                    var prev_owned = base_owned;
                    base = other;
                    base_len = ar;
                    base_cap = other_cap;
                    base_owned = 1;
                    other = 0;
                    other_cap = 0;
                    if (prev_owned == 1) { other = prev; other_cap = prev_cap; }
                }
            }
        }
        li = li - 1;
    }
    if (dbuf != 0) { fl_free(dbuf); }
    if (other != 0) { fl_free(other); }
    if (loose_buf != 0) { fl_free(loose_buf); }      # never `base` by now (R5)
    fl_free(links);
    if (rc != 0) {
        if (base_owned == 1) { fl_free(base); }
        return rc;
    }
    # The result is the caller's. (A loose base is only reached through a link,
    # so by now at least one delta has been applied and `base` is this read's.)
    store64(out24, base);
    store64(out24 + 8, base_len);
    store64(out24 + 16, 0);
    return 0;
}

# --- top-level packfile read -------------------------------------------------
# Find `hex` across every .git/objects/pack/*.idx. On a hit, writes the matching
# pack's {data, len} and the object's offset to out24 and returns 0; negative
# when there is no pack directory (-1), `hex` is not an id (-2), or no pack
# holds it (-3).
#
# 1.7.5: nothing is left on the heap. The directory is listed with
# dir_list_into into freelist buffers freed before returning, and the paths are
# built on the stack. sf_dir_list built a vec and a Str per entry, and each
# .idx / .pack path was alloc'd, on every lookup: 672 bytes per object read,
# kept for good, so ~8 MB for sit_repo_status on 12,000 files in owl or thoth.
# The listing is redone per lookup on purpose: a long-lived consumer must see
# the packs a later `git gc` writes.

# dir_list_into's name and offset buffers for the pack directory, doubled and
# listed again when a directory does not fit, up to _GIT_PACKDIR_TRIES times.
var _GIT_PACKDIR_NAMES = 4096;
var _GIT_PACKDIR_ENTRIES = 64;
var _GIT_PACKDIR_TRIES = 16;
# Longest pack file name kept: `pack-<64 hex>.idx` is 74 bytes. A longer name
# is not a pack git wrote, and is skipped.
var _GIT_PACKNAME_MAX = 255;

# 1.7.6 (R4): the .idx / .pack of the last hit, tried before the directory is
# listed. Reads cluster in one pack, and a REF_DELTA base is usually beside its
# delta; every lookup re-listed the directory and probed every .idx, so a
# REF chain beside 1,000 other packs cost 10 s per read. A hit is an id that
# pack holds, so it is the right object; a miss falls through to the listing,
# which still finds packs a later `git gc` wrote.
var _git_last_idx = 0;
var _git_last_pack = 0;

# Forget the last hit. Called when a repo is opened: its path is repo-relative,
# and another repo's .idx must never answer for this one's ids.
fn _git_pack_forget_last() {
    if (_git_last_idx != 0) { store8(_git_last_idx, 0); }
    return 0;
}

fn _git_pack_locate(hex, out24) {
    var have_last = 0;
    if (_git_last_idx != 0) { if (load8(_git_last_idx) != 0) { have_last = 1; } }
    if (have_last == 1) {
        var qraw[32];
        if (hex_decode_into(hex, _id_hexlen(), &qraw) != 0) {
            var qoff = _git_idx_lookup(_git_last_idx, &qraw, _id_rawlen());
            if (qoff >= 0) {
                var qp[16];
                if (_git_load_pack(_git_last_pack, &qp) == 0) {
                    store64(out24, load64(&qp));
                    store64(out24 + 8, load64(&qp + 8));
                    store64(out24 + 16, qoff);
                    return 0;
                }
            }
        }
    }
    var packdir = ".git/objects/pack";
    var dlen = 17;                                     # strlen(packdir)
    # S-26: route through the sit_abs seam like every other repo path (on agnos
    # the root is a real absolute path and there is no cwd to fall back on).
    var abuf[4352];
    var apath = sit_abs_into(packdir, &abuf, 4352);
    if (apath == 0) { return 0 - 1; }
    var pstr[16];                                      # a Str {data, len} (str.cyr's layout)
    store64(&pstr, apath);
    store64(&pstr + 8, strlen(apath));
    var scratch[4096];
    var names_cap = _GIT_PACKDIR_NAMES;
    var max_entries = _GIT_PACKDIR_ENTRIES;
    var names = 0;
    var offs = 0;
    var n = 0 - 3;
    var tries = 0;
    var listing = 1;
    while (listing == 1) {
        names = fl_alloc(names_cap);
        offs = fl_alloc(max_entries * 8);
        n = 0 - 5;
        if (names != 0) {
            if (offs != 0) {
                n = dir_list_into(&pstr, &scratch, 4096, names, names_cap, offs, max_entries);
            }
        }
        listing = 0;
        tries = tries + 1;
        if (tries < _GIT_PACKDIR_TRIES) {
            if (n == 0 - 3) { names_cap = names_cap * 2; listing = 1; }
            if (n == 0 - 4) { max_entries = max_entries * 2; listing = 1; }
        }
        if (listing == 1) {
            fl_free(names);
            fl_free(offs);
        }
    }
    var rc = 0 - 3;
    if (n < 0) { rc = 0 - 1; }                        # no pack directory, or unreadable
    var rawlen = _id_rawlen();
    var oid_raw[32];
    if (rc == 0 - 3) {
        if (hex_decode_into(hex, _id_hexlen(), &oid_raw) == 0) { rc = 0 - 2; }
    }
    var ipath[288];
    var ppath[288];
    var i = 0;
    while (i < n) {
        if (rc == 0 - 3) {
            var nm = names + load64(offs + i * 8);
            var sl = strlen(nm);
            if (sl > 4) {
                if (sl <= _GIT_PACKNAME_MAX) {
                    if (memeq(nm + sl - 4, ".idx", 4) == 1) {
                        memcpy(&ipath, packdir, dlen);
                        store8(&ipath + dlen, 47);
                        memcpy(&ipath + dlen + 1, nm, sl);
                        store8(&ipath + dlen + 1 + sl, 0);
                        var offset = _git_idx_lookup(&ipath, &oid_raw, rawlen);
                        if (offset >= 0) {
                            var nb = sl - 4;   # name minus ".idx"
                            memcpy(&ppath, packdir, dlen);
                            store8(&ppath + dlen, 47);
                            memcpy(&ppath + dlen + 1, nm, nb);
                            memcpy(&ppath + dlen + 1 + nb, ".pack", 5);
                            store8(&ppath + dlen + 1 + nb + 5, 0);
                            var pkp[16];
                            if (_git_load_pack(&ppath, &pkp) == 0) {
                                store64(out24, load64(&pkp));
                                store64(out24 + 8, load64(&pkp + 8));
                                store64(out24 + 16, offset);
                                rc = 0;
                                if (_git_last_idx == 0) {
                                    _git_last_idx = alloc_or_die(288);
                                    _git_last_pack = alloc_or_die(288);
                                }
                                memcpy(_git_last_idx, &ipath, 288);
                                memcpy(_git_last_pack, &ppath, 288);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if (names != 0) { fl_free(names); }
    if (offs != 0) { fl_free(offs); }
    return rc;
}

# Look up `hex` across every .git/objects/pack/*.idx; on a hit, reconstruct the
# object from the matching .pack. Writes read_object contract to out24. Returns
# 0 on success, negative if not found in any pack (or no pack dir).
fn _git_read_pack(hex, out24) {
    var loc[24];
    var lr = _git_pack_locate(hex, &loc);
    if (lr != 0) { return lr; }
    return _git_pack_obj(load64(&loc), load64(&loc + 8), load64(&loc + 16), out24);
}

# Loose-first, then packfile: the git-mode object read used by read_object and
# by REF_DELTA base resolution. On-disk (non-thin) packs are self-contained, so
# a REF_DELTA base is always present as loose or in some pack.
fn _git_read_any(hex, out24) {
    if (_git_read_loose(hex, out24) == 0) { return 0; }
    return _git_read_pack(hex, out24);
}
