# history.cyr — cherry-pick and revert.
#
# Both are one operation with the three merge roles assigned differently:
#
#   cherry-pick C:  base = parent(C)   ours = HEAD   theirs = C
#   revert      C:  base = C           ours = HEAD   theirs = parent(C)
#
# That is the whole difference — revert is a cherry-pick with base and theirs
# swapped, which is why applying a commit and undoing it share this file rather
# than carrying two copies of the same tree walk. Both route through
# `three_way_merge_entries` (merge.cyr), so the diff3 line-level merge, the
# conflict-marker files and the S-26 auto-merge write-back behave identically
# to `sit merge`.
#
# ⚠ The merge core is the part of sit with the most history of getting this
# wrong — 1.3.8 found `three_way_line_merge` could not terminate on an
# insert-only hunk. These commands exercise it harder than `merge` does,
# because they run it against a *parent* tree rather than a merge base, so the
# "identical on both sides" shortcut fires far less often.

# In-progress markers, mirroring .sit/MERGE_HEAD.
fn cherry_pick_head_path() { return ".sit/CHERRY_PICK_HEAD"; }
fn revert_head_path() { return ".sit/REVERT_HEAD"; }

# Tree entries of a commit's first parent, or an empty vec for a root commit.
# A root commit legitimately has no parent: cherry-picking one means "add
# everything it introduced", reverting one means "remove everything it
# introduced", and an empty base/theirs expresses exactly that.
fn _parent_tree_entries(commit_hex) {
    var parents = commit_parents_of(commit_hex);
    if (parents == 0) { return vec_new(); }
    if (vec_len(parents) == 0) { return vec_new(); }
    var e = commit_tree_entries(vec_get(parents, 0));
    if (e == 0) { return vec_new(); }
    return e;
}

# A commit's tree oid as a heap cstring, or 0.
fn commit_tree_hex(commit_hex) {
    var obj[24];
    if (read_object(commit_hex, &obj) != 0) { return 0; }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var info[56];
    if (parse_commit_body(buf + coff, blen - coff, &info) != 0) { return 0; }
    return load64(&info);
}

# Read a commit's message as a heap cstring, or 0.
fn commit_message_of(commit_hex) {
    var obj[24];
    if (read_object(commit_hex, &obj) != 0) { return 0; }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var body = buf + coff;
    var body_len = blen - coff;
    var info[56];
    if (parse_commit_body(body, body_len, &info) != 0) { return 0; }
    var mstart = load64(&info + 40);
    if (mstart == 0) { return 0; }
    if (mstart >= body_len) { return 0; }
    var mlen = body_len - mstart;
    # Trim a single trailing newline so the message round-trips unchanged.
    if (mlen > 0) {
        if (load8(body + mstart + mlen - 1) == 10) { mlen = mlen - 1; }
    }
    var out = alloc_or_die(mlen + 1);
    memcpy(out, body + mstart, mlen);
    store8(out + mlen, 0);
    return out;
}

# Shared body for cherry-pick and revert.
#   invert = 0 -> cherry-pick, 1 -> revert
# Returns 0 on success, non-zero on failure or conflict.
fn _apply_one_commit(target_hex, invert, marker_path, verb, verb_len) {
    var head_hex = read_head_ref();
    if (head_hex == 0) {
        eprintln("sit: no commits yet");
        return 1;
    }

    var target_tree = commit_tree_entries(target_hex);
    if (target_tree == 0) { target_tree = vec_new(); }
    var parent_tree = _parent_tree_entries(target_hex);
    var ours_entries = commit_tree_entries(head_hex);
    if (ours_entries == 0) { ours_entries = vec_new(); }

    var base_entries = parent_tree;
    var theirs_entries = target_tree;
    if (invert == 1) {
        base_entries = target_tree;
        theirs_entries = parent_tree;
    }

    var merged = vec_new();
    var conflicts = vec_new();
    three_way_merge_entries(base_entries, ours_entries, theirs_entries, merged, conflicts);

    if (vec_len(conflicts) > 0) {
        # Same shape as cmd_merge's conflict path: write the auto-merged files
        # so cleanly-merged paths don't sit at stale content while the user
        # resolves the rest, then the marker files, then refuse.
        var mi = 0;
        var mn = vec_len(merged);
        while (mi < mn) {
            var me = vec_get(merged, mi);
            var mpath = load64(me + 32);
            var mhex = hex_encode(me, 32);
            ensure_parent_dirs(mpath);
            var mp[16];
            if (read_blob_content(mhex, &mp) == 0) {
                if (sf_write_all(mpath, load64(&mp), load64(&mp + 8)) < 0) {
                    syscall(SYS_WRITE, STDERR, "sit: cannot write auto-merged file '", 36);
                    syscall(SYS_WRITE, STDERR, mpath, strlen(mpath));
                    syscall(SYS_WRITE, STDERR, "' — resolve manually before committing\n", 39);
                }
            }
            mi = mi + 1;
        }
        var ci = 0;
        while (ci < vec_len(conflicts)) {
            var cp = vec_get(conflicts, ci);
            write_conflict_file(cp, tree_find_hash(ours_entries, cp),
              tree_find_hash(theirs_entries, cp), verb);
            ci = ci + 1;
        }
        # Record what was being applied so the next commit can say so.
        var mbuf = alloc(66);
        memcpy(mbuf, target_hex, 64);
        store8(mbuf + 64, 10);
        sf_write_all(marker_path, mbuf, 65);

        syscall(SYS_WRITE, STDERR, "sit: ", 5);
        syscall(SYS_WRITE, STDERR, verb, verb_len);
        syscall(SYS_WRITE, STDERR, " conflict in ", 13);
        var nb[24];
        var d = write_decimal(&nb, vec_len(conflicts));
        syscall(SYS_WRITE, STDERR, &nb, d);
        syscall(SYS_WRITE, STDERR, " file(s) — resolve, then 'sit add' + 'sit commit'\n", 50);
        return 1;
    }

    sort_entries(merged);
    var tree_hex = build_tree(merged, 0);
    if (tree_hex == 0) {
        eprintln("sit: failed to write tree");
        return 1;
    }

    # Nothing to do is not a failure, but it must not create an empty commit.
    var head_tree_hex = commit_tree_hex(head_hex);
    if (head_tree_hex != 0) {
        if (streq(tree_hex, head_tree_hex) == 1) {
            stdout_write("nothing to ", 11);
            stdout_write(verb, verb_len);
            stdout_write(" — tree unchanged\n", 18);
            return 0;
        }
    }

    var orig_msg = commit_message_of(target_hex);
    if (orig_msg == 0) { orig_msg = "(no message)"; }
    var msg = orig_msg;
    if (invert == 1) {
        var omlen = strlen(orig_msg);
        var cap = omlen + 16;
        msg = alloc_or_die(cap);
        memcpy(msg, "Revert \"", 8);
        memcpy(msg + 8, orig_msg, omlen);
        store8(msg + 8 + omlen, 34);
        store8(msg + 8 + omlen + 1, 0);
    }

    var new_hex = build_commit_signed(tree_hex, head_hex, msg, 0);
    if (new_hex == 0) {
        eprintln("sit: failed to write commit");
        return 1;
    }
    # Materialize BEFORE the ref moves — see the note in cmd_merge: the stale
    # -path removal inside materialize_target compares against HEAD's current
    # tree, so moving HEAD first would make it a no-op and leave a reverted
    # file sitting on disk.
    if (materialize_target(new_hex) != 0) {
        eprintln("sit: commit written but working tree not updated — HEAD unchanged");
        return 1;
    }
    if (write_head_ref(new_hex) != 0) {
        eprintln("sit: failed to update branch ref");
        return 1;
    }

    stdout_write(verb, verb_len);
    stdout_write(" ", 1);
    stdout_write(new_hex, 12);
    stdout_write(": ", 2);
    stdout_write(msg, strlen(msg));
    stdout_write("\n", 1);
    return 0;
}

fn cmd_cherry_pick() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit cherry-pick <commit>");
        return 1;
    }
    var hex[72];
    if (resolve_commit_hash(argv_heap(2), &hex) != 1) {
        eprintln("sit: cannot resolve commit");
        return 1;
    }
    return _apply_one_commit(&hex, 0, cherry_pick_head_path(), "cherry-pick", 11);
}

fn cmd_revert() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit revert <commit>");
        return 1;
    }
    var hex[72];
    if (resolve_commit_hash(argv_heap(2), &hex) != 1) {
        eprintln("sit: cannot resolve commit");
        return 1;
    }
    return _apply_one_commit(&hex, 1, revert_head_path(), "revert", 6);
}

# ── stash ────────────────────────────────────────────────────────────
#
# A stash entry is a real commit, so it is reachable, fsck-clean, and readable
# with the ordinary tools. `.sit/refs/stash` names the newest entry; each entry
# carries HEAD-at-stash-time as its first parent and the PREVIOUS stash as its
# second, so the stack is the parent chain rather than a side file that could
# drift out of sync with the objects it names.
#
# Only TRACKED files are stashed, which is git's default. An untracked file is
# not sit's to move out from under the user.
fn stash_ref_path() { return ".sit/refs/stash"; }

# Newest stash commit oid (heap cstring), or 0 if the stack is empty.
fn stash_read_top() {
    var p = stash_ref_path();
    if (sf_exists(p) != 1) { return 0; }
    var pair[16];
    if (read_file_heap(p, &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    if (len < 64) { return 0; }
    if (hex_prefix_valid(buf, 64) == 0) { return 0; }
    var hex = alloc(65);
    memcpy(hex, buf, 64);
    store8(hex + 64, 0);
    return hex;
}

fn stash_write_top(hex) {
    var p = stash_ref_path();
    if (hex == 0) {
        if (sf_exists(p) == 1) { return sf_unlink(p); }
        return 0;
    }
    var buf = alloc(66);
    memcpy(buf, hex, 64);
    store8(buf + 64, 10);
    ensure_parent_dirs(p);
    if (sf_write_all(p, buf, 65) < 0) { return 0 - 1; }
    return 0;
}

# Build a tree from the CURRENT working content of every tracked path. This is
# what makes a stash a snapshot of your edits rather than of the last commit:
# each index entry is re-hashed from disk, and a tracked path deleted in the
# working tree is simply absent from the tree.
fn _stash_working_tree() {
    var entries = parse_index();
    if (entries == 0) { return 0; }
    var out = vec_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        var path = entry_path(e);
        if (sf_exists(path) == 1) {
            # write_blob_object, NOT hash_file_as_blob: the latter only hashes
            # (status uses it to compare), so a tree built from it names blobs
            # the store does not contain and `stash pop` fails with "cannot
            # read blob". The stash has to persist the content it snapshots.
            var pair[16];
            var hex = 0;
            if (read_file_heap(path, &pair) == 0) {
                hex = write_blob_object(load64(&pair), load64(&pair + 8));
            }
            if (hex != 0) {
                var bytes = hex_decode(hex, 64);
                if (bytes != 0) {
                    var ne = alloc_or_die(40);
                    memcpy(ne, bytes, 32);
                    var pl = strlen(path);
                    var pc = alloc_or_die(pl + 1);
                    memcpy(pc, path, pl);
                    store8(pc + pl, 0);
                    store64(ne + 32, pc);
                    vec_push(out, ne);
                }
            }
        }
        i = i + 1;
    }
    sort_entries(out);
    return build_tree(out, 0);
}

fn _stash_push() {
    var head_hex = read_head_ref();
    if (head_hex == 0) {
        eprintln("sit: no commits yet — nothing to stash against");
        return 1;
    }
    var tree_hex = _stash_working_tree();
    if (tree_hex == 0) {
        eprintln("sit: nothing tracked to stash");
        return 1;
    }
    var head_tree = commit_tree_hex(head_hex);
    if (head_tree != 0) {
        if (streq(tree_hex, head_tree) == 1) {
            stdout_write("no local changes to save\n", 25);
            return 0;
        }
    }

    var branch = current_branch_name();
    if (branch == 0) { branch = "HEAD"; }
    var blen = strlen(branch);
    var msg = alloc_or_die(64 + blen);
    memcpy(msg, "WIP on ", 7);
    memcpy(msg + 7, branch, blen);
    memcpy(msg + 7 + blen, ": ", 2);
    memcpy(msg + 7 + blen + 2, head_hex, 12);
    store8(msg + 7 + blen + 14, 0);

    var prev = stash_read_top();
    var stash_hex = 0;
    if (prev == 0) { stash_hex = build_commit_signed(tree_hex, head_hex, msg, 0); }
    else { stash_hex = build_merge_commit_signed(tree_hex, head_hex, prev, msg, 0); }
    if (stash_hex == 0) {
        eprintln("sit: failed to write stash commit");
        return 1;
    }
    if (stash_write_top(stash_hex) != 0) {
        eprintln("sit: failed to update stash ref");
        return 1;
    }

    # Restore the working tree to HEAD. materialize_target compares against
    # HEAD's tree, and HEAD has not moved, so its stale-path removal correctly
    # drops files the stash added.
    if (materialize_target(head_hex) != 0) {
        eprintln("sit: stash saved but working tree not restored");
        return 1;
    }
    stdout_write("saved working directory: ", 25);
    stdout_write(msg, strlen(msg));
    stdout_write("\n", 1);
    return 0;
}

fn _stash_list() {
    var cur = stash_read_top();
    var idx = 0;
    while (cur != 0) {
        var m = commit_message_of(cur);
        if (m == 0) { m = "(no message)"; }
        stdout_write("stash@{", 7);
        var nb[24];
        var d = write_decimal(&nb, idx);
        stdout_write(&nb, d);
        stdout_write("}: ", 3);
        stdout_write(m, strlen(m));
        stdout_write("\n", 1);
        # Second parent is the previous stash; its absence ends the stack.
        var parents = commit_parents_of(cur);
        cur = 0;
        if (parents != 0) {
            if (vec_len(parents) > 1) { cur = vec_get(parents, 1); }
        }
        idx = idx + 1;
        if (idx > 4096) { cur = 0; }
    }
    if (idx == 0) { stdout_write("no stash entries\n", 17); }
    return 0;
}

fn _stash_pop(drop_only) {
    var top = stash_read_top();
    if (top == 0) {
        eprintln("sit: no stash entries");
        return 1;
    }
    var parents = commit_parents_of(top);
    var prev = 0;
    if (parents != 0) {
        if (vec_len(parents) > 1) { prev = vec_get(parents, 1); }
    }

    if (drop_only == 0) {
        # Restore the snapshot. HEAD does not move — a stash is working-tree
        # state, not history — so materialize_target's stale removal compares
        # the stash tree against HEAD's and drops what the stash did not carry.
        if (materialize_target(top) != 0) {
            eprintln("sit: failed to restore stash — stack unchanged");
            return 1;
        }
    }
    if (stash_write_top(prev) != 0) {
        eprintln("sit: restored but failed to pop the stash ref");
        return 1;
    }
    if (drop_only == 1) { stdout_write("dropped stash@{0}\n", 18); }
    else { stdout_write("restored stash@{0}\n", 19); }
    return 0;
}

fn cmd_stash() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) { return _stash_push(); }
    var sub = argv(2);
    if (streq(sub, "push") == 1) { return _stash_push(); }
    if (streq(sub, "list") == 1) { return _stash_list(); }
    if (streq(sub, "pop")  == 1) { return _stash_pop(0); }
    if (streq(sub, "drop") == 1) { return _stash_pop(1); }
    eprintln("usage: sit stash [push | list | pop | drop]");
    return 1;
}
