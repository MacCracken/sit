# --- util.cyr ---

# util.cyr — universal helpers.
#
# Everything here is consumed by two or more domain modules. Keep this file
# free of sit-specific domain knowledge — no refs, no objects, no patra.

var SEEK_SET = 0;
var SEEK_END = 2;

# ================================================================
# Repo-root prefixing (agnos support).
# ================================================================
# AGNOS's frozen syscall floor has NO chdir/getcwd/openat — "CWD is
# userland-owned, absolute paths" (ABI §3.2). sit historically leaned
# on process-cwd (`chdir` into the repo, then read ".sit/..." relative).
# That is portability-hostile. The fix: carry an explicit repo root and
# funnel every repo-relative FS access through sit_abs(), which prefixes
# it.
#
# `_repo_root` == 0 is the LINUX DEFAULT: no prefix, cwd-relative,
# byte-identical to pre-refactor behavior. On agnos, entry points set it
# to an absolute repo-root cstring so reads resolve without a cwd.
var _repo_root = 0;

# Store the repo root (an absolute-path cstring), or 0 to clear it.
fn sit_set_repo_root(root) {
    _repo_root = root;
    return 0;
}

# The ONE prefix point. Rules, in order:
#   (1) rel already absolute (byte 0 == '/') → return UNCHANGED.
#       (cert/token/HOME paths pass straight through.)
#   (2) _repo_root == 0 (Linux default) → return rel UNCHANGED
#       (preserves cwd-relative behavior exactly — a true no-op).
#   (3) else → heap-alloc "<_repo_root>/<rel>" and return it.
#       Caller-owns the result.
# On Linux and for already-absolute paths this is a no-op, so the whole
# change is behavior-preserving there.
fn sit_abs(rel) {
    return sit_abs_a(0, rel);
}

# sit_abs with the joined path drawn from allocator `a`: `sit serve` passes its
# request arena, so a path built for one request is reclaimed with it (C1,
# 1.7.4). `a` == 0 is sit_abs itself: the global heap, dying on OOM. Otherwise
# 0 comes back when `a` cannot serve the bytes.
fn sit_abs_a(a, rel) {
    var n = _sit_abs_len(rel);
    if (n == 0) { return rel; }
    var out = 0;
    if (a == 0) { out = alloc_or_die(n); }
    else {
        out = alloc_via(a, n);
        if (out == 0) { return 0; }
    }
    return _sit_abs_fill(out, rel);
}

# sit_abs into a caller's buffer of `cap` bytes: `buf` holding the joined path,
# `rel` itself when the rules use it as given, or 0 when the join does not fit.
# 1.7.5: for the git read path, which runs per object in-process for owl and
# thoth and so keeps nothing on the heap.
fn sit_abs_into(rel, buf, cap) {
    var n = _sit_abs_len(rel);
    if (n == 0) { return rel; }
    if (n > cap) { return 0; }
    return _sit_abs_fill(buf, rel);
}

# The rules above: the bytes "<root>/<rel>" + NUL needs, or 0 when `rel` is
# used as given.
fn _sit_abs_len(rel) {
    if (rel == 0) { return 0; }
    if (load8(rel) == 47) { return 0; }              # '/'
    if (_repo_root == 0) { return 0; }
    # A "." root means "current directory" — prefixing "./" is redundant
    # and would break Linux byte-for-byte parity. Treat it as no-prefix so
    # cmd_init's explicit sit_set_repo_root(".") stays a Linux no-op.
    if (load8(_repo_root) == 46) { if (load8(_repo_root + 1) == 0) { return 0; } }
    return strlen(_repo_root) + 1 + strlen(rel) + 1;
}

# Write "<root>/<rel>" + NUL at `out`, sized by _sit_abs_len. Returns `out`.
fn _sit_abs_fill(out, rel) {
    var rlen = strlen(_repo_root);
    var plen = strlen(rel);
    memcpy(out, _repo_root, rlen);
    store8(out + rlen, 47);                          # '/'
    memcpy(out + rlen + 1, rel, plen);
    store8(out + rlen + 1 + plen, 0);
    return out;
}

# Str-aware variant of sit_abs for FS primitives that take a Str
# (e.g. dir_list). Applies the same prefixing rules to the Str's bytes
# and returns a new Str; a no-op case returns the input Str unchanged.
fn sit_abs_str(rel) {
    if (rel == 0) { return rel; }
    var data = str_data(rel);
    if (str_len(rel) > 0) { if (load8(data) == 47) { return rel; } }
    if (_repo_root == 0) { return rel; }
    return str_from(sit_abs(str_cstr(rel)));
}

# ----------------------------------------------------------------
# Portable directory create/remove (agnos ABI bridge).
# ----------------------------------------------------------------
# Linux/macOS and agnos disagree on the mkdir/rmdir call shape:
#   - Linux/macOS: sys_mkdir(path, mode)   / sys_rmdir(path)
#   - agnos:       sys_mkdir(path, pathlen) / sys_rmdir(path, pathlen)
# agnos's frozen floor carries an explicit byte length (no NUL scan in the
# kernel) and picks the directory mode itself, so a raw Linux-shaped
# sys_mkdir(path, 0755) lands 0755 in `pathlen` — a silent ABI miscompile.
# The stdlib bridges open/stat/unlink (io.cyr's file_open / xstat / xunlink)
# but does NOT yet bridge mkdir/rmdir, so sit carries these two here; if the
# stdlib grows xmkdir/xrmdir they fold out. `path` is already repo-absolute
# (callers pass sit_abs(...)). The #ifdef wraps the whole branch — an early
# `return` does NOT stop the compiler type-checking the code that follows it
# (see lib/io.cyr's v6.2.25 wrapper-set note), so both shapes are #-guarded.
fn sit_mkdir(path, mode) {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_mkdir(path, strlen(path));
    #else
    return sys_mkdir(path, mode);
    #endif
}

# rmdir counterpart of sit_mkdir: the AGNOS syscall takes a length, Linux does not.
fn sit_rmdir(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path, strlen(path));
    #else
    return sys_rmdir(path);
    #endif
}

# ── Filesystem symlink guard (S-04, S-12) ────────────────────────
#
# Calls newfstatat(AT_FDCWD, path, &stat, AT_SYMLINK_NOFOLLOW) and returns:
#   1 if path exists and is a SYMLINK
#   0 if path exists and is NOT a symlink (regular file, dir, etc.)
#  -1 if path does not exist or stat failed
#
# st_mode is read at the per-target STAT_MODE offset (24 on x86_64 Linux, 16 on
# aarch64 Linux). Through 1.6.3 it was a hardcoded 24, which on arm64 read st_uid,
# so every lstat-based guard was a no-op there.
# S_IFMT = 0xF000, S_IFLNK = 0xA000.

var VAL_AT_FDCWD = 0 - 100;
var VAL_AT_SYMLINK_NOFOLLOW = 256;

# 1 if `path` is a symlink (lstat), 0 if not, -1 if lstat fails.
fn path_is_symlink(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos's frozen ABI has no lstat / newfstatat (§4.1 exposes only the
    # symlink-FOLLOWING sys_stat), so a planted symlink resolves to its target
    # and cannot be flagged here. Report 0 (not-a-symlink) for any path that
    # exists, -1 if stat fails — preserving the contract while the S-12 guard
    # degrades to a no-op on agnos (whose single-user capability floor has no
    # attacker-writable symlink-plant vector today). Accepted degradation,
    # matching darshini's lstat→stat fallback.
    var abuf[128];
    if (sys_stat(path, strlen(path), &abuf) < 0) { return 0 - 1; }
    return 0;
    #else
    var stbuf[144];
    var rc = syscall(262, VAL_AT_FDCWD, path, &stbuf, VAL_AT_SYMLINK_NOFOLLOW);
    if (rc < 0) { return 0 - 1; }
    var mode = load32(&stbuf + STAT_MODE);
    var fmt = mode & 0xF000;
    if (fmt == 0xA000) { return 1; }
    return 0;
    #endif
}

# 1 when `apath` (already joined to the repo root) names a regular file,
# following symlinks; 0 otherwise. 1.7.6 (R11): checked before opening a file
# sit only reads — open(2) on a FIFO blocks until a writer appears, and a
# hostile tarball can put one wherever a repo file is expected.
fn path_is_regular(apath) {
    var st[256];
    if (xstat(apath, &st) != 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) == 0x8000) { return 1; }
    return 0;
}

# File-type bits (S_IFMT-masked mode) of `path` via lstat — without following
# symlinks — or -1 if stat failed. Callers compare against 0xA000 (symlink),
# 0x4000 (dir), 0x8000 (regular), etc.: S-04's "is this a directory", S-25's
# "does the target already exist as something other than a dir", and since
# 1.7.6 every "does it exist" (architecture 007: sf_exists means readable).
fn path_lstat_kind(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    # No lstat on agnos (see path_is_symlink): sys_stat FOLLOWS symlinks, so a
    # symlink-to-dir reports 0x4000 (dir), not 0xA000 (symlink). Accepted
    # degradation. STAT_MODE is the agnos struct-stat mode offset (per-target).
    var abuf[128];
    if (sys_stat(path, strlen(path), &abuf) < 0) { return 0 - 1; }
    return load32(&abuf + STAT_MODE) & 0xF000;
    #else
    var stbuf[144];
    var rc = syscall(262, VAL_AT_FDCWD, path, &stbuf, VAL_AT_SYMLINK_NOFOLLOW);
    if (rc < 0) { return 0 - 1; }
    var mode = load32(&stbuf + STAT_MODE);
    return mode & 0xF000;
    #endif
}

# ----------------------------------------------------------------
# sit-owned FS wrappers (sf_*). Every repo FS access funnels through
# one of these so the prefixing lives in a single place. The inner
# calls use the portable, length-carrying wrappers (io.cyr's file_open /
# xstat / xunlink, plus sit_mkdir / sit_rmdir above) so the same call is
# ABI-correct on Linux/macOS AND agnos — a raw Linux-shaped sys_open /
# sys_stat / sys_unlink would silently miscompile off Linux (agnos reads
# its 2nd arg as a byte length). Absolute/HOME/cert/token paths pass
# through sit_abs unchanged (rule 1), and on Linux (_repo_root == 0) every
# wrapper is a transparent forward (rule 2).
# ----------------------------------------------------------------
fn sf_exists(p) {
    # 1.7.6 (R11): file_exists opens the path, and open(2) on a FIFO blocks
    # until a writer appears — `.sit/HEAD` or `.git/HEAD` as a FIFO (a tarball
    # can ship one) hung every command at its first probe. Only regular files
    # and directories are opened; anything else reads as absent.
    var abuf[4352];
    var ap = sit_abs_into(p, &abuf, 4352);
    if (ap == 0) { ap = sit_abs(p); }
    if (_sf_special(ap) == 1) { return 0; }
    return file_exists(ap);
}

# 1 when `apath` exists and is neither a regular file nor a directory (a FIFO,
# socket or device: opening one to read can block, or reach hardware), else 0.
fn _sf_special(apath) {
    var st[256];
    if (xstat(apath, &st) != 0) { return 0; }
    var k = load32(&st + STAT_MODE) & 0xF000;
    if (k == 0x8000) { return 0; }
    if (k == 0x4000) { return 0; }
    return 1;
}

# 1 if a proper prefix of the repo-relative path `p` ("a", "a/b" for "a/b/c")
# is a symlink. Absolute paths (HOME, cert and token files) are not checked: a
# symlinked home directory is legitimate, and those paths are not repo content.
#
# 1.7.5: the prefixes and their joined paths are built on the stack. A heap
# copy of the path, and a joined path per segment, were kept for good on every
# write — `sit serve` pays this per ref push, a checkout per file.
fn _sf_parent_symlink(p) {
    if (p == 0) { return 0; }
    if (load8(p) == 47) { return 0; }
    var len = strlen(p);
    var sbuf[4096];
    var pre = &sbuf;
    if (len + 1 > 4096) { pre = alloc_or_die(len + 1); }   # past PATH_MAX: as before
    var abuf[4352];
    var i = 0;
    while (i < len) {
        if (load8(p + i) == 47) {
            if (i > 0) {
                memcpy(pre, p, i);
                store8(pre + i, 0);
                if (path_is_symlink(_sf_abs(pre, &abuf)) == 1) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# sit_abs into `abuf`, a 4352-byte buffer the caller owns (on its stack), or on
# the heap as sit_abs does when the join does not fit.
fn _sf_abs(rel, abuf) {
    var ap = sit_abs_into(rel, abuf, 4352);
    if (ap == 0) { ap = sit_abs(rel); }
    return ap;
}

# Write all `len` bytes to `fd`, looping over short writes (EINTR retried).
# Returns `len`, or a negative errno — never a silent partial count. sit's own,
# on the public `file_write`, so the consumer bundles need nothing newer than
# the toolchains they pin (owl: 6.6.2, which predates stdlib's `_io_write_full`).
fn sit_write_full(fd, buf, len) {
    var off = 0;
    var rc = 0;
    var going = 1;
    while (going == 1) {
        if (off >= len) { going = 0; }
        else {
            var n = file_write(fd, buf + off, len - off);
            if (n == 0 - 4) { }                          # EINTR: nothing written, retry
            else {
                if (n > 0) { off = off + n; }
                else {
                    rc = n;
                    if (n == 0) { rc = 0 - 5; }          # EIO: no progress
                    going = 0;
                }
            }
        }
    }
    if (rc < 0) { return rc; }
    return len;
}

# Write a whole file at a repo-root-relative path, never through a symlink.
#
# 1.6.4: this was a bare file_write_all (O_TRUNC, no O_NOFOLLOW), so a symlink at
# a ref, HEAD, config or worktree path — or at any directory above it — was
# written THROUGH: a `.sit/refs/heads/main -> ~/file` made an ordinary `sit
# commit` truncate ~/file, and a worktree `docs -> /elsewhere` made checkout /
# pull write into /elsewhere (the CVE-2021-21300 "beyond a symlink" class).
#
# Now a symlinked parent refuses with -ELOOP, and whatever sits AT the path is
# removed (a symlink is removed itself, not its target) and the file created
# with O_CREAT|O_EXCL — which also refuses a symlink planted in between, and is
# the same bit on every target (O_NOFOLLOW is not: aarch64 differs, and older
# stdlibs do not name it). Absolute paths (HOME-side files, not repo content)
# keep plain write-through semantics: a symlinked dotfile there is the user's.
fn sf_write_all(p, buf, len) {
    if (load8(p) == 47) { return file_write_all(p, buf, len); }
    if (_sf_parent_symlink(p) == 1) { return 0 - 40; }          # -ELOOP
    var abuf[4352];
    var ap = _sf_abs(p, &abuf);
    if (path_lstat_kind(ap) >= 0) { xunlink(ap); }
    var fd = file_open(ap, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);
    if (fd < 0) { return fd; }
    var written = sit_write_full(fd, buf, len);
    file_close(fd);
    return written;
}

# ── Atomic replace (1.7.6, L5) ──────────────────────────────────
#
# Refs and repository state (HEAD, refs/*, config, MERGE_HEAD, CONFLICTS, the
# stash and rebase state, the shallow list) are replaced, never rewritten:
#   1. `<path>.lock` is created O_CREAT|O_EXCL — it refuses an existing lock
#      (another sit is writing, or one died holding it; the error names the
#      file) and a symlink planted at the lock path,
#   2. the bytes are written in full and fsynced,
#   3. the lock is renamed over the path. rename replaces a symlink at the
#      target rather than following it, and readers see the old file or the new
#      one, never a cut.
# Through 1.7.5 these went through sf_write_all, which removed the old file
# before writing the new one: a failed write (disk full, quota, EIO) or a crash
# between the two left the ref empty or missing, and an empty branch ref then
# read as "unborn", so the next commit started a new root over the history.
# Worktree files keep sf_write_all: an fsync per checked-out file would cost
# more than it protects, and git does not do it either.

# rename(2) on every target: agnos carries explicit lengths.
fn _sit_rename_raw(old, new) {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_RENAME, old, strlen(old), new, strlen(new));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_rename(old, new);
    #endif
}

# Replace the file at the resolved path `ap` with `len` bytes through
# `<ap>.lock`. Returns `len`, or a negative errno (-17 EEXIST: the lock is held).
fn _write_replace(ap, buf, len) {
    var al = strlen(ap);
    var lbuf[4360];
    var lp = &lbuf;
    if (al + 6 > 4360) { lp = alloc_or_die(al + 6); }
    memcpy(lp, ap, al);
    memcpy(lp + al, ".lock", 5);
    store8(lp + al + 5, 0);
    var fd = file_open(lp, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);
    if (fd < 0) {
        if (fd == 0 - 17) {
            eprint3("sit: ", lp, " exists — another sit is writing it, or one stopped; remove it if not\n");
        }
        return fd;
    }
    # The replacement keeps the replaced file's permission bits: a 0600
    # ~/.sitconfig must not come back 0644 (umask-filtered 0644 is only the
    # mode of a file that did not exist).
    #ifndef CYRIUS_TARGET_AGNOS
    var ost[256];
    if (xstat(ap, &ost) == 0) { syscall(SYS_FCHMOD, fd, load32(&ost + STAT_MODE) & 4095); }
    #endif
    var written = sit_write_full(fd, buf, len);
    var rc = 0;
    if (written != len) { rc = written; if (rc >= 0) { rc = 0 - 5; } }
    if (rc == 0) { if (xfsync(fd) != 0) { rc = 0 - 5; } }
    file_close(fd);
    if (rc == 0) {
        var rr = _sit_rename_raw(lp, ap);
        if (rr != 0) { rc = rr; }
    }
    if (rc != 0) { xunlink(lp); return rc; }
    return len;
}

# Atomically replace the file at `p` (repo-root-relative, or absolute) with
# `len` bytes. A repo-relative path refuses (-ELOOP) a symlinked directory above
# it, as sf_write_all does; an absolute (HOME-side) path is the user's to link.
# Returns `len` or a negative errno.
fn sf_write_atomic(p, buf, len) {
    if (load8(p) != 47) {
        if (_sf_parent_symlink(p) == 1) { return 0 - 40; }          # -ELOOP
    }
    else {
        # A HOME-side file that is itself a symlink (a dotfile manager's link) is
        # written through, as before: replacing it would break the user's link.
        if (path_is_symlink(p) == 1) { return file_write_all(p, buf, len); }
    }
    var abuf[4352];
    var ap = _sf_abs(p, &abuf);
    return _write_replace(ap, buf, len);
}

# sf_write_atomic for a path `rel` inside ANOTHER repository rooted at `root`
# (a file:// push target): no directory between `root` and the file may be a
# symlink, and missing ones are created. `root` itself is the remote the user
# named. Returns `len` or a negative errno. 1.7.6 (L11 / X1): pushes wrote the
# remote's refs with a raw file_write_all, which followed a symlink planted in
# the remote at the ref or at any directory above it.
fn sf_write_atomic_at(root, rel, buf, len) {
    if (load8(rel) == 47) { return 0 - 22; }                     # -EINVAL: must be relative
    var rl = strlen(root);
    var pl = strlen(rel);
    var pbuf[4352];
    var path = &pbuf;
    if (rl + 1 + pl + 1 > 4352) { path = alloc_or_die(rl + 1 + pl + 1); }
    memcpy(path, root, rl);
    store8(path + rl, 47);
    memcpy(path + rl + 1, rel, pl);
    store8(path + rl + 1 + pl, 0);
    # Walk each directory below the root: refuse a symlink, create what is missing.
    var i = rl + 1;
    while (i < rl + 1 + pl) {
        if (load8(path + i) == 47) {
            store8(path + i, 0);
            var kind = path_lstat_kind(path);
            if (kind == 0xA000) { store8(path + i, 47); return 0 - 40; }
            if (kind < 0) { sit_mkdir(path, 0x1ED); }
            store8(path + i, 47);
        }
        i = i + 1;
    }
    return _write_replace(path, buf, len);
}

# file_open on a repo-root-relative path. A read-only open refuses a FIFO,
# socket or device (-6, ENXIO): see sf_exists (1.7.6, R11).
fn sf_open(p, flags, mode) {
    var abuf[4352];
    var ap = sit_abs_into(p, &abuf, 4352);
    if (ap == 0) { ap = sit_abs(p); }
    if (flags == 0) { if (_sf_special(ap) == 1) { return 0 - 6; } }
    return file_open(ap, flags, mode);
}

# file_read_all on a repo-root-relative path.
fn sf_read_all(p, buf, maxlen) {
    return file_read_all(sit_abs(p), buf, maxlen);
}

# file_append_locked on a repo-root-relative path; refuses (-ELOOP) to append
# through a symlink at the path or above it (a `.sit/logs/HEAD -> ~/x` made every
# reflog entry land in ~/x through 1.6.3).
fn sf_append_locked(p, buf, len) {
    if (_sf_parent_symlink(p) == 1) { return 0 - 40; }
    var ap = sit_abs(p);
    if (path_is_symlink(ap) == 1) { return 0 - 40; }
    return file_append_locked(ap, buf, len);
}

# sit_mkdir on a repo-root-relative path.
fn sf_mkdir(p, mode) {
    return sit_mkdir(sit_abs(p), mode);
}

# NOTE: no sf_ensure_dir / sf_ensure_parent_dirs / sf_read_file_heap —
# those three sit-owned fns prefix INTERNALLY (see below), so their
# existing callers stay unchanged. Wrapping them here would double-prefix.
#
# `sf_mkdir` and `sf_stat` currently have no in-tree caller and the 2026-08-17
# dead-code audit deliberately KEPT them; `sf_read_all` joined them in 1.7.4,
# when `sit serve`'s ref push moved to a resolved path, and the 1.7.6 closeout
# kept it for the same reason. They complete the sf_* family, and an
# asymmetric family is a trap: the next person needing a prefixed stat finds no
# wrapper and reaches for raw `xstat` / `sit_mkdir`, which is precisely the
# unprefixed-path bug class the seam exists to prevent (and the Linux-shaped
# syscall class fixed in 1.3.4). DCE strips both from the binary, so the only
# cost is these lines.

# unlink a repo-root-relative path; refuses (-ELOOP) when a directory above it
# is a symlink, so a removal can never reach outside the repository.
fn sf_unlink(p) {
    if (_sf_parent_symlink(p) == 1) { return 0 - 40; }
    return xunlink(sit_abs(p));
}

# rmdir a repo-root-relative path.
fn sf_rmdir(p) {
    return sit_rmdir(sit_abs(p));
}

# Remove the now-empty directories above `path`, deepest first, stopping at the
# first one that is not empty (rmdir refuses those). A stale file's directory
# would otherwise survive and block a later file of the same name (`d/x` → `d`).
fn _rmdir_empty_parents(path) {
    var len = strlen(path);
    var buf = alloc_or_die(len + 1);
    memcpy(buf, path, len);
    store8(buf + len, 0);
    var i = len - 1;
    var go = 1;
    while (go == 1) {
        if (i <= 0) { go = 0; }
        else {
            if (load8(buf + i) == 47) {
                store8(buf + i, 0);
                if (sf_rmdir(buf) != 0) { go = 0; }
            }
            i = i - 1;
        }
    }
    return 0;
}

# xstat on a repo-root-relative path.
fn sf_stat(p, buf) {
    return xstat(sit_abs(p), buf);
}

# dir_list takes a Str; route through the Str-aware prefixer.
fn sf_dir_list(p) {
    return dir_list(sit_abs_str(p));
}

# patra_open takes a cstring path (external dep).
fn sf_patra_open(p) {
    return patra_open(sit_abs(p));
}

# P-12: relative bound on inflate, layered under the absolute 16 MiB ceiling.
#
# Every `zlib_decompress` site in sit now goes through sankoch's
# `zlib_decompress_with_ratio_cap`, which rejects a stream whose output exceeds
# `ratio * src_len` — checked INCREMENTALLY during inflate, so a bomb is stopped
# while expanding rather than after.
#
# ⚠ Be honest about how much this buys. zlib's theoretical maximum is ~1032:1, so
# 1000 rejects almost nothing a real encoder can emit, and the 16 MiB absolute
# ceiling remains the load-bearing bound. What it *does* close is the specific
# decompression-bomb shape the absolute cap handles worst: a TINY input engineered
# to expand to the full ceiling — 16 KiB → 16 MiB is ratio 1024, now refused after
# ~16 MB of work instead of completing. It is a narrow backstop, not a headline
# defence.
#
# Deliberately NOT tighter. sit stores whatever a user commits, and legitimately
# repetitive content compresses hard: 1 MiB of identical bytes lands near 1000:1.
# A cap of, say, 200 would reject real objects — trading a rare correctness
# failure for a marginal security gain on a path the absolute ceiling already
# bounds. Wrong trade for a VCS.
#
# ⛔ 1.6.4: and 1000 was ALREADY that wrong trade. sankoch emits 1006:1 for 2 MiB
# of one byte and 1017:1 for 16 MiB, so `sit add` of a disk image or a padded
# binary wrote a blob every later read refused — checkout aborted, fsck counted
# it bad (which also blocks --prune forever), and objects written before 1.4.1
# turned unreadable on upgrade. The cap now sits above deflate's ~1032:1
# maximum, so it rejects no valid stream; the 16 MiB ceiling is the bound.
var SIT_MAX_INFLATE_RATIO = 1100;

# Largest file `sit add` accepts: the read path inflates an object into at most
# 16 MiB, framing header included, so anything bigger could be committed but
# never read back (1.6.4; the add cap used to be 1 GiB).
var SIT_MAX_BLOB = 16777152;

# S-25: validate a Content-Length taken off the wire.
#
# Every caller of this is parsing a header written by the other end — a remote
# server for the wire clients, a client for `sit serve` — so the value is fully
# attacker-controlled. Returns the length when it is a sane body size, or
# (0 - 1) otherwise; callers MUST treat (0 - 1) as a protocol error and abort
# the exchange rather than continuing with a nonsense length.
#
# Two distinct failure modes this closes:
#
#  1. **Overflow.** The idiomatic completeness test is `used >= body_off + clen`.
#     With clen near i64 max that sum wraps NEGATIVE, so the test passes on the
#     first pass and the reader proceeds as though it had received a body it
#     never read — then hands the bogus length to a decompressor or memcpy.
#  2. **Huge-but-positive.** A length past the buffer cap makes callers size or
#     read memory they do not own.
#
# `max` is the caller's ceiling (WIRE_HTTP_MAX_BODY / SIT_SERVE_MAX_BODY, both
# 16 MiB) so the failure modes line up across transports.
fn content_length_sane(v, max) {
    if (v < 0) { return 0 - 1; }
    if (v > max) { return 0 - 1; }
    return v;
}

# Write three cstrings to stderr, unbuffered — "<a><path><b>" — so messages
# that wrap a path need no hand-counted byte lengths (several were short by the
# 3-byte em dash and lost their newline).
fn eprint3(a, path, b) {
    syscall(SYS_WRITE, STDERR, a, strlen(a));
    syscall(SYS_WRITE, STDERR, path, strlen(path));
    syscall(SYS_WRITE, STDERR, b, strlen(b));
    return 0;
}

# Write `s` and a newline to stderr, unbuffered.
fn eprintln(s) {
    var len = strlen(s);
    syscall(SYS_WRITE, STDERR, s, len);
    syscall(SYS_WRITE, STDERR, "\n", 1);
    return 0;
}

# P-17: buffered stdout. Without this, sit's command output is dozens to
# thousands of separate syscall(SYS_WRITE, STDOUT, ...) calls — `cmd_diff`
# on a 500-line edit emits 3000+ writes. With a single 64KB heap buffer +
# explicit flush at command end, the same workload lands in a handful of
# syscalls. STDERR (eprintln) stays direct so error output is immediate
# even when the process is being killed mid-command.
var STDOUT_BUF_SIZE = 65536;
var _stdout_buf = 0;
var _stdout_pos = 0;

# Buffered stdout write; writes at least STDOUT_BUF_SIZE go straight to the kernel.
fn stdout_write(data, len) {
    if (len <= 0) { return 0; }
    if (_stdout_buf == 0) {
        _stdout_buf = alloc_or_die(STDOUT_BUF_SIZE);
    }
    # Writes larger than the buffer go straight to the kernel after a flush
    # of any pending bytes — no point copying into a buffer we'd just empty.
    if (len >= STDOUT_BUF_SIZE) {
        stdout_flush();
        syscall(SYS_WRITE, STDOUT, data, len);
        return 0;
    }
    if (_stdout_pos + len > STDOUT_BUF_SIZE) {
        stdout_flush();
    }
    memcpy(_stdout_buf + _stdout_pos, data, len);
    _stdout_pos = _stdout_pos + len;
    return 0;
}

# Flush the stdout buffer.
fn stdout_flush() {
    if (_stdout_pos == 0) { return 0; }
    syscall(SYS_WRITE, STDOUT, _stdout_buf, _stdout_pos);
    _stdout_pos = 0;
    return 0;
}

# S-17: alloc-or-die wrapper for the common case where OOM is unrecoverable
# (no transactional rollback in sit; a half-filled buffer will be memcpy'd
# from address 0 if alloc returns null and we don't notice). Use this at
# every fixed-shape `alloc(N)` site in object_db / tree / commit / merge
# instead of bare alloc; reserve bare alloc for the few callers that
# genuinely have a propagation path (read_file_heap, read_object).
fn alloc_or_die(size) {
    # 1.7.6 (L18): alloc(0) returns 0, which read as out-of-memory — an empty
    # tree (revert of a root commit, a stash of all-deleted files) could not be
    # built. A zero-byte request gets one byte.
    if (size < 1) { size = 1; }
    var p = alloc(size);
    if (p == 0) {
        eprintln("sit: out of memory");
        syscall(SYS_EXIT, 1);
    }
    return p;
}

# mkdir(path, 0o755), tolerating EEXIST (-17).
# sit-owned: prefixes `path` with the repo root (sit_abs) INTERNALLY so
# every caller (incl. ensure_parent_dirs) can pass a repo-relative path.
fn ensure_dir(path) {
    var abuf[4352];
    var r = sit_mkdir(_sf_abs(path, &abuf), 0x1ED);
    if (r == 0) { return 0; }
    if (r == 0 - 17) { return 0; }
    return r;
}

# Walk `path`, mkdir every '/'-delimited directory prefix. Used by ref writers
# so `.sit/refs/heads/feature/foo` creates `.sit/refs/heads/feature/` on demand.
# sit-owned: each derived segment is repo-relative and gets prefixed by
# ensure_dir's internal sit_abs — so this fn stays cwd-relative here and
# must NOT prefix `path` itself (that would double-prefix each segment).
#
# 1.6.4: stops (-ELOOP) at a repo-relative segment that is a symlink rather than
# creating directories beyond it. mkdir's EEXIST used to read a symlinked
# directory as "already there", so later segments were created outside the repo.
#
# 1.7.5: one segment buffer on the stack (a heap copy per '/' was kept for good).
fn ensure_parent_dirs(path) {
    var len = strlen(path);
    var abs_path = 0;
    if (len > 0) { if (load8(path) == 47) { abs_path = 1; } }
    var sbuf[4096];
    var segment = &sbuf;
    if (len + 1 > 4096) { segment = alloc_or_die(len + 1); }   # past PATH_MAX: as before
    var abuf[4352];
    var i = 0;
    var rc = 0;
    while (i < len) {
        if (rc == 0) {
            if (load8(path + i) == 47) {
                if (i > 0) {
                    memcpy(segment, path, i);
                    store8(segment + i, 0);
                    ensure_dir(segment);
                    if (abs_path == 0) {
                        if (path_is_symlink(_sf_abs(segment, &abuf)) == 1) { rc = 0 - 40; }
                    }
                }
            }
        }
        i = i + 1;
    }
    return rc;
}

# Write decimal representation of n into buf. Returns digit count.
fn write_decimal(buf, n) {
    if (n == 0) { store8(buf, 48); return 1; }
    var digits = 0;
    var m = n;
    while (m > 0) { digits = digits + 1; m = m / 10; }
    m = n;
    var i = digits - 1;
    while (m > 0) {
        store8(buf + i, 48 + m % 10);
        i = i - 1;
        m = m / 10;
    }
    return digits;
}

# Copy argv(n) into a heap-owned, null-terminated string. See
# docs/architecture/001 — argv pointers alias post-return stack memory,
# so we must copy before doing anything stack-heavy.
fn argv_heap(n) {
    var raw = argv(n);
    var len = strlen(raw);
    var s = alloc(len + 1);
    memcpy(s, raw, len);
    store8(s + len, 0);
    return s;
}

# Advance past any run of spaces or tabs in [pos, stop).
fn skip_ws(data, pos, stop) {
    var i = pos;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= stop) { scanning = 0; }
        else {
            var c = load8(data + i);
            if (c == 32) { i = i + 1; }
            else {
                if (c == 9) { i = i + 1; }
                else { scanning = 0; }
            }
        }
    }
    return i;
}

# Byte-wise compare of two cstrings: -1, 0 or 1.
fn strcmp_cstr(a, b) {
    var i = 0;
    var done = 0;
    var result = 0;
    while (done == 0) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) {
            if (ca < cb) { result = 0 - 1; }
            else { result = 1; }
            done = 1;
        }
        else {
            if (ca == 0) { done = 1; }
            else { i = i + 1; }
        }
    }
    return result;
}

# Insertion-sort a vec of cstrings in place (ascending).
fn sort_cstrings(vec) {
    var n = vec_len(vec);
    var i = 1;
    while (i < n) {
        var cur = vec_get(vec, i);
        var j = i - 1;
        var placed = 0;
        while (placed == 0) {
            if (j < 0) { placed = 1; }
            else {
                var prev = vec_get(vec, j);
                if (strcmp_cstr(cur, prev) >= 0) { placed = 1; }
                else {
                    vec_set(vec, j + 1, prev);
                    j = j - 1;
                }
            }
        }
        vec_set(vec, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Write a sanitized copy of `bytes[len]` to `fd`, replacing ASCII control
# chars (< 0x20 except \t, plus \x7f) with '?'. Used (S-21) for attacker-
# controlled commit body fragments like Author identity so a malicious commit
# can't emit ANSI escape sequences that forge log output or manipulate the
# terminal. Builds the sanitized output into a heap buffer in one pass and
# emits via a single write — both for perf (no per-char syscall) and so the
# STDOUT path stays in order with the surrounding stdout_write calls (P-17).
# S-27: sanitize an identity component for the OBJECT-WRITE path.
#
# `write_sanitized` below guards every DISPLAY path (S-21), but the commit and
# merge builders memcpy the author/committer name and email straight into the
# object body, where the ident line is `author <NAME> <<EMAIL>> <ts> +0000\n`.
# A newline in either component forges a header line — verified:
# `SIT_AUTHOR_NAME=$'evil\nparent <64-hex>'` produced a commit object carrying a
# fabricated `parent`, which every downstream parent walk then believes.
#
# This is the CVE-2023-29007 shape one layer in. Scope note, because it is
# narrower than it looks: the `.sit/config` route is already closed (the config
# parser is line-based, so `user.name` can never carry a newline), leaving the
# `SIT_AUTHOR_*` environment variables — i.e. self-inflicted. It is fixed
# anyway because a forged parent is repository corruption regardless of who
# caused it, and because "the parser happens to stop it" is not a guarantee.
#
# Drops rather than substitutes, mirroring git's ident "crud" removal: control
# bytes (which includes NL/CR/tab) plus the `<` and `>` that delimit the email.
# Returns a fresh cstring; never returns 0.
fn ident_sanitized(s) {
    if (s == 0) { return ""; }
    var n = strlen(s);
    var out = alloc_or_die(n + 1);
    var i = 0;
    var o = 0;
    while (i < n) {
        var c = load8(s + i) & 0xFF;
        var keep = 1;
        if (c < 32) { keep = 0; }        # NL, CR, tab, every control byte
        if (c == 127) { keep = 0; }      # DEL
        if (c == 60) { keep = 0; }       # '<'
        if (c == 62) { keep = 0; }       # '>'
        if (keep == 1) { store8(out + o, c); o = o + 1; }
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

# Classify the run starting at `p` (`n` bytes left) for display: returns
# -len for a run to keep as is, +len for a run to replace with one '?'.
#
# 1.7.2 (E10): bytes >= 0x80 used to pass untouched, so a UTF-8 C1 control
# (U+009B is CSI) or a bidi override in a ref name or commit message reached
# the terminal. git allows non-ASCII ref names, so the bytes are escaped on
# output, not refused on input. UTF-8 is decoded rather than byte-matched:
# 0x80-0x9F are also ordinary continuation bytes ("é" is C3 A9).
fn _text_run(p, n) {
    var c = load8(p) & 0xFF;
    if (c < 32) {
        if (c == 9) { return 0 - 1; }                 # tab stays
        return 1;                                     # C0 control
    }
    if (c == 127) { return 1; }                       # DEL
    if (c < 128) { return 0 - 1; }
    # One UTF-8 sequence. A malformed one is unsafe byte by byte: an 8-bit
    # terminal reads a lone 0x9B as CSI.
    var need = 0;
    var cp = 0;
    if (c >= 0xC2) { if (c <= 0xDF) { need = 1; cp = c & 0x1F; } }
    if (c >= 0xE0) { if (c <= 0xEF) { need = 2; cp = c & 0x0F; } }
    if (c >= 0xF0) { if (c <= 0xF4) { need = 3; cp = c & 0x07; } }
    if (need == 0) { return 1; }                      # continuation or bad lead
    if (need >= n) { return 1; }                      # truncated
    var k = 1;
    while (k <= need) {
        var cc = load8(p + k) & 0xFF;
        if ((cc & 0xC0) != 0x80) { return 1; }
        cp = (cp << 6) | (cc & 0x3F);
        k = k + 1;
    }
    if (need == 2) {
        if (cp < 0x800) { return 1; }                 # overlong
        if (cp >= 0xD800) { if (cp <= 0xDFFF) { return 1; } }   # surrogate
    }
    if (need == 3) {
        if (cp < 0x10000) { return 1; }               # overlong
        if (cp > 0x10FFFF) { return 1; }
    }
    var run = need + 1;
    if (cp <= 0x9F) { return run; }                   # C1 control (U+0080-U+009F)
    # Bidi controls (Trojan Source, CVE-2021-42574): ALM, LRM / RLM,
    # LRE / RLE / PDF / LRO / RLO, LRI / RLI / FSI / PDI.
    if (cp == 0x061C) { return run; }
    if (cp == 0x200E) { return run; }
    if (cp == 0x200F) { return run; }
    if (cp >= 0x202A) { if (cp <= 0x202E) { return run; } }
    if (cp >= 0x2066) { if (cp <= 0x2069) { return run; } }
    return 0 - run;
}

# A display-safe copy of bytes[0, len): each C0 control (except tab), DEL, C1
# control, bidi control and malformed UTF-8 byte becomes one '?'. Returns a
# fresh cstring and writes its length to `out_len`; never longer than `len`.
fn text_sanitized(bytes, len, out_len) {
    var out = alloc_or_die(len + 1);
    var i = 0;
    var o = 0;
    while (i < len) {
        var r = _text_run(bytes + i, len - i);
        if (r > 0) {
            store8(out + o, 63);                      # '?'
            o = o + 1;
            i = i + r;
        }
        else {
            memcpy(out + o, bytes + i, 0 - r);
            o = o + (0 - r);
            i = i + (0 - r);
        }
    }
    store8(out + o, 0);
    store64(out_len, o);
    return out;
}

# Write bytes to `fd` made display-safe by text_sanitized.
fn write_sanitized(fd, bytes, len) {
    if (len <= 0) { return 0; }
    var olen[8];
    var out = text_sanitized(bytes, len, &olen);
    if (fd == STDOUT) { stdout_write(out, load64(&olen)); }
    else { syscall(SYS_WRITE, fd, out, load64(&olen)); }
    return 0;
}

# Read an entire file into a heap buffer. Writes (ptr, len) to out_pair.
# Returns 0 on success, negative on failure.
# sit-owned: prefixes `path` with the repo root (sit_abs) INTERNALLY so
# its many callers need no change.
fn read_file_heap(path, out_pair) {
    return _read_whole(path, out_pair, 0);
}

# read_file_heap into a freelist buffer the caller frees with fl_free (1.7.6,
# R1): for reads a long-lived consumer repeats — `.git/packed-refs` on every
# HEAD lookup was kept on the bump heap each time.
fn read_file_fl(path, out_pair) {
    return _read_whole(path, out_pair, 1);
}

fn _read_whole(path, out_pair, use_fl) {
    # 1.7.6 (R1 / R11): the joined path on the stack (sit_abs kept one on the
    # heap per call when the root is absolute), and only a regular file is
    # opened — a FIFO at `.git/HEAD` or `.git/config` (a tarball can ship one)
    # blocked the open forever.
    var abuf[4352];
    var ap = sit_abs_into(path, &abuf, 4352);
    if (ap == 0) { ap = sit_abs(path); }
    if (path_is_regular(ap) == 0) { return 0 - 1; }
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var size = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    syscall(SYS_LSEEK, fd, 0, SEEK_SET);
    if (size < 0) { file_close(fd); return 0 - 2; }
    # S-06: read_file_heap is used for config files and ref files, which should
    # never exceed a few KB. Cap at 64 MiB to keep a hostile / accidentally-huge
    # file from triggering a multi-GB allocation here.
    if (size > 67108864) { file_close(fd); return 0 - 4; }
    var buf = 0;
    if (use_fl == 1) { buf = fl_alloc(size + 1); }
    else { buf = alloc(size + 1); }
    if (buf == 0) { file_close(fd); return 0 - 3; }
    var total = 0;
    var rgo = 1;
    var rerr = 0;
    while (rgo == 1) {
        var n = file_read(fd, buf + total, size - total);
        if (n < 0) { rerr = 1; rgo = 0; }
        else {
            if (n == 0) { rgo = 0; }
            else { total = total + n; if (total >= size) { rgo = 0; } }
        }
    }
    file_close(fd);
    # 1.7.6: a read that failed part-way is a failure, not a short file — a
    # config or state file read as its first half is rewritten as that half.
    if (rerr == 1) {
        if (use_fl == 1) { fl_free(buf); }
        return 0 - 5;
    }
    store64(out_pair, buf);
    store64(out_pair + 8, total);
    return 0;
}

# --- validate.cyr ---

# validate.cyr — input validators for the P(-1) audit fixes.
#
# Every validator is PURE: returns 1 if the input is acceptable, 0 otherwise.
# No stdout, no side effects. Callers decide the error message and disposition.
#
# See docs/audit/2026-04-24-audit.md for the finding-by-finding rationale.

# Length caps picked to match git conventions where they exist and to avoid
# pathological allocations where they don't.
var VAL_REFNAME_MAX = 255;         # S-02 / S-26
var VAL_TREE_NAME_MAX = 255;       # S-03
var VAL_CONFIG_VALUE_MAX = 1024;   # S-05
var VAL_CONFIG_KEY_MAX = 128;      # S-05
var VAL_REMOTE_URL_MAX = 4096;     # S-04

# ── Hex prefix (S-01) ───────────────────────────────
#
# Accept only [0-9a-f], length 4..64. Used by resolve_hash before interpolating
# the prefix into `LIKE '<prefix>%'`. Preserves sit's existing "too short" (-2)
# behavior by letting the caller check length separately first; this validator
# only checks the CHARACTER set so callers can distinguish "too short" from
# "has bogus characters".

# 1 if the first `len` bytes (1..64) are lowercase hex.
fn hex_prefix_valid(s, len) {
    if (len == 0) { return 0; }
    if (len > 64) { return 0; }
    var i = 0;
    while (i < len) {
        var c = load8(s + i) & 0xFF;
        var ok = 0;
        if (c >= 48) { if (c <= 57) { ok = 1; } }  # 0-9
        if (c >= 97) { if (c <= 102) { ok = 1; } } # a-f
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ── Ref name (S-02, S-26) ─────────────────────────────
#
# Enforces git check-ref-format rules:
#   - non-empty, <= VAL_REFNAME_MAX
#   - no component begins with '.'
#   - no component ends with '.lock'
#   - no '..' anywhere
#   - no ASCII control chars (< 0x20 or == 0x7F)
#   - no space, '~', '^', ':', '?', '*', '['
#   - cannot begin or end with '/', no '//'
#   - cannot end with '.'
#   - no '@{'
#   - cannot be the single '@'
#   - no '\'

fn _ref_is_bad_char(c) {
    if (c < 32) { return 1; }
    if (c == 127) { return 1; }
    if (c == 32) { return 1; }       # space
    if (c == 126) { return 1; }      # ~
    if (c == 94) { return 1; }       # ^
    if (c == 58) { return 1; }       # :
    if (c == 63) { return 1; }       # ?
    if (c == 42) { return 1; }       # *
    if (c == 91) { return 1; }       # [
    if (c == 92) { return 1; }       # backslash
    return 0;
}

# 1 if `name` is a safe ref name (git check-ref-format rules, no traversal or control bytes).
fn refname_valid(name) {
    if (name == 0) { return 0; }
    var len = strlen(name);
    if (len == 0) { return 0; }
    if (len > VAL_REFNAME_MAX) { return 0; }

    # Single-char '@' rejected
    if (len == 1) {
        if (load8(name) == 64) { return 0; }
    }

    # First or last char cannot be '/'
    if (load8(name) == 47) { return 0; }
    if (load8(name + len - 1) == 47) { return 0; }
    # Last char cannot be '.'
    if (load8(name + len - 1) == 46) { return 0; }

    var i = 0;
    var comp_start = 0;  # Start offset of current '/'-separated component
    while (i < len) {
        var c = load8(name + i) & 0xFF;
        if (_ref_is_bad_char(c) == 1) { return 0; }

        # Check for '@{' sequence. This rejects '@{' in ref-NAME context so
        # a name like main@{0} never becomes a .sit/refs/.../main@{0} file.
        # It does NOT gate '@{N}' in REVISION context — that ordinal reflog
        # selector is parsed in resolve_reflog_spec (refs.cyr) before any ref
        # lookup, so `sit reset --hard HEAD@{1}` resolves via .sit/logs/.
        if (c == 64) {
            if (i + 1 < len) {
                if (load8(name + i + 1) == 123) { return 0; }
            }
        }

        # Check for '..' sequence
        if (c == 46) {
            if (i + 1 < len) {
                if (load8(name + i + 1) == 46) { return 0; }
            }
        }

        if (c == 47) {
            # End of a component: validate it was nonempty (i.e. no '//'),
            # didn't end with .lock, didn't start with '.', etc.
            if (i == comp_start) { return 0; }  # '//'
            # Component-start checks already handled at the boundary transition below.
            # Component-end .lock check: does component end with ".lock"?
            var comp_len = i - comp_start;
            if (comp_len >= 5) {
                if (memeq(name + i - 5, ".lock", 5) == 1) { return 0; }
            }
            # Next component starts right after the '/'
            comp_start = i + 1;
            # Must not start with '.'
            if (comp_start < len) {
                if (load8(name + comp_start) == 46) { return 0; }
            }
        }
        i = i + 1;
    }

    # First component: name cannot begin with '.'
    if (load8(name) == 46) { return 0; }

    # Final component .lock check
    var final_len = len - comp_start;
    if (final_len >= 5) {
        if (memeq(name + len - 5, ".lock", 5) == 1) { return 0; }
    }

    return 1;
}

# ── Tree entry name (S-03) ─────────────────────────────
#
# Called by parse_tree on each entry, AND by materialize_target before the
# write, so attackers have to clear two hurdles. Belt-and-suspenders.
#
# Rejects:
#   - empty
#   - ".", ".."
#   - any '/' or '\' or NUL
#   - any ':' (NTFS ADS + Windows drive letter)
#   - any ASCII control char (< 0x20 or == 0x7F)
#   - trailing space or dot (Windows)
#   - case-fold-equal to ".sit", ".git", ".ssh"
#   - NTFS reserved names (CON, PRN, NUL, AUX, COM1-9, LPT1-9)
#   - length > VAL_TREE_NAME_MAX
#
#   - HFS-ignorable Unicode spellings of the guarded dot-directories (v1.4.8,
#     see _name_iequal_hfs below). Carried unimplemented from v0.7 to v1.4.7
#     behind a dead version tag; the 1.4.7 deferral sweep gave it a real home
#     and 1.4.8 closed it.

fn _ascii_tolower(c) {
    if (c >= 65) { if (c <= 90) { return c + 32; } }
    return c;
}

# Case-insensitive match: is `name` equal to `lower_ref` ignoring ASCII case?
# `lower_ref` must already be lowercase (saves an op per char).
fn _name_iequal_ascii(name, name_len, lower_ref, ref_len) {
    if (name_len != ref_len) { return 0; }
    var i = 0;
    while (i < name_len) {
        var nc = _ascii_tolower(load8(name + i) & 0xFF);
        var rc = load8(lower_ref + i) & 0xFF;
        if (nc != rc) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _is_ntfs_reserved(name, name_len) {
    # Strip trailing extension for comparison: CON, CON.txt both reserved.
    var stem_len = name_len;
    var i = 0;
    while (i < name_len) {
        if (load8(name + i) == 46) { stem_len = i; i = name_len; }
        else { i = i + 1; }
    }
    if (stem_len == 3) {
        if (_name_iequal_ascii(name, 3, "con", 3) == 1) { return 1; }
        if (_name_iequal_ascii(name, 3, "prn", 3) == 1) { return 1; }
        if (_name_iequal_ascii(name, 3, "nul", 3) == 1) { return 1; }
        if (_name_iequal_ascii(name, 3, "aux", 3) == 1) { return 1; }
    }
    if (stem_len == 4) {
        # COM1..COM9, LPT1..LPT9
        var c0 = _ascii_tolower(load8(name) & 0xFF);
        var c1 = _ascii_tolower(load8(name + 1) & 0xFF);
        var c2 = _ascii_tolower(load8(name + 2) & 0xFF);
        var c3 = load8(name + 3) & 0xFF;
        if (c3 >= 49) {
            if (c3 <= 57) {
                if (c0 == 99) {
                    if (c1 == 111) {
                        if (c2 == 109) { return 1; }  # com1..com9
                    }
                }
                if (c0 == 108) {
                    if (c1 == 112) {
                        if (c2 == 116) { return 1; }  # lpt1..lpt9
                    }
                }
            }
        }
    }
    return 0;
}

# ── HFS-ignorable codepoints (v1.4.8) ─────────────────────────
#
# macOS HFS+ ignores a set of Unicode formatting codepoints when comparing
# filenames, so `.g<U+200C>it` and `.git` name the SAME directory there while
# differing byte-for-byte. A byte comparison therefore lets a tree entry carry
# a name that resolves to `.git` / `.sit` on checkout — the CVE-2014-9390
# class, which git closed with `is_hfs_dotgit()`.
#
# sit is exposed through two doors: `parse_tree` reads these names out of an
# object that may have come from any remote, and `_serve_rehash_and_insert`
# validates framing, type and SHA-256 on a pushed object but never parses a
# tree body — so a hostile tree reaches the store either way. `.sit` matters as
# much as `.git` here, since that is where sit keeps its own refs and index.
#
# The ignorable set matches git's `next_hfs_char()` (utf8.c).
fn _hfs_ignorable(cp) {
    if (cp == 0x200C) { return 1; }     # ZERO WIDTH NON-JOINER
    if (cp == 0x200D) { return 1; }     # ZERO WIDTH JOINER
    if (cp == 0x200E) { return 1; }     # LEFT-TO-RIGHT MARK
    if (cp == 0x200F) { return 1; }     # RIGHT-TO-LEFT MARK
    if (cp >= 0x202A) { if (cp <= 0x202E) { return 1; } }   # bidi embed/override
    if (cp >= 0x206A) { if (cp <= 0x206F) { return 1; } }   # shaping selectors
    if (cp == 0xFEFF) { return 1; }     # ZERO WIDTH NO-BREAK SPACE (BOM)
    return 0;
}

# Decode one UTF-8 codepoint at *pos_ptr, advancing it. Returns 0 at end.
#
# A malformed, truncated or overlong sequence yields the raw lead byte and
# advances one. That is the conservative direction on purpose: a decode failure
# can only make a name compare as MORE distinct from ".git", never less, so a
# hostile encoding cannot use it to slip a guarded name through.
fn _utf8_next(name, len, pos_ptr) {
    var p = load64(pos_ptr);
    if (p >= len) { return 0; }
    var b0 = load8(name + p) & 0xFF;
    if (b0 < 0x80) { store64(pos_ptr, p + 1); return b0; }

    var need = 0;
    var cp = 0;
    if (b0 >= 0xC2) { if (b0 <= 0xDF) { need = 1; cp = b0 & 0x1F; } }
    if (b0 >= 0xE0) { if (b0 <= 0xEF) { need = 2; cp = b0 & 0x0F; } }
    if (b0 >= 0xF0) { if (b0 <= 0xF4) { need = 3; cp = b0 & 0x07; } }
    if (need == 0) { store64(pos_ptr, p + 1); return b0; }
    if (p + need >= len) { store64(pos_ptr, p + 1); return b0; }

    var k = 1;
    var good = 1;
    while (k <= need) {
        var bk = load8(name + p + k) & 0xFF;
        if (bk < 0x80) { good = 0; }
        else {
            if (bk > 0xBF) { good = 0; }
        }
        if (good == 1) { cp = (cp << 6) | (bk & 0x3F); }
        k = k + 1;
    }
    if (good == 0) { store64(pos_ptr, p + 1); return b0; }
    store64(pos_ptr, p + need + 1);
    return cp;
}

# Case-insensitive compare that also skips HFS-ignorable codepoints, so ".git",
# ".GIT" and ".g<ZWNJ>it" all match the reference ".git". `lower_ref` must
# already be lowercase ASCII. With no ignorables present this is exactly
# _name_iequal_ascii, which is why it replaces it at the dot-directory checks
# rather than being bolted on beside it.
fn _name_iequal_hfs(name, name_len, lower_ref, ref_len) {
    var pos[8];
    store64(&pos, 0);
    var ri = 0;
    var mismatch = 0;
    var running = 1;
    while (running == 1) {
        var cp = 0;
        var scanning = 1;
        while (scanning == 1) {
            cp = _utf8_next(name, name_len, &pos);
            if (cp == 0) { scanning = 0; }
            else {
                if (_hfs_ignorable(cp) == 0) { scanning = 0; }
            }
        }
        if (cp == 0) { running = 0; }
        else {
            if (ri >= ref_len) { mismatch = 1; running = 0; }
            else {
                var lc = _ascii_tolower(cp);
                if (lc != (load8(lower_ref + ri) & 0xFF)) { mismatch = 1; running = 0; }
                ri = ri + 1;
            }
        }
    }
    if (mismatch == 1) { return 0; }
    if (ri != ref_len) { return 0; }
    return 1;
}

# Cheap pre-filter for the dot-directory checks. All three guarded names begin
# with '.', so a name whose first SIGNIFICANT codepoint is not '.' cannot match
# any of them and can skip all three UTF-8 decodes.
#
# It must be the first *significant* codepoint, not the first byte: `<ZWNJ>.git`
# is a valid spoof, and a naive `load8(name) == 46` test would wave it through.
#
# This exists because the v1.4.8 HFS comparison replaced an O(1) length-mismatch
# reject with a full decode, costing **+63% on `tree_entry_name_valid-good`**
# (79 → 129 ns) — a measured benchmark on a path `parse_tree` runs per entry and
# `materialize_target` runs per write. With the pre-filter an ordinary name
# decodes exactly one codepoint.
fn _starts_with_dot_hfs(name, len) {
    var pos[8];
    store64(&pos, 0);
    var cp = 0;
    var scanning = 1;
    while (scanning == 1) {
        cp = _utf8_next(name, len, &pos);
        if (cp == 0) { scanning = 0; }
        else {
            if (_hfs_ignorable(cp) == 0) { scanning = 0; }
        }
    }
    if (cp == 46) { return 1; }
    return 0;
}

# 1 if a tree entry name cannot escape the worktree or spoof .sit / .git.
fn tree_entry_name_valid(name) {
    if (name == 0) { return 0; }
    var len = strlen(name);
    if (len == 0) { return 0; }
    if (len > VAL_TREE_NAME_MAX) { return 0; }

    # Reject "." and ".."
    if (len == 1) {
        if (load8(name) == 46) { return 0; }
    }
    if (len == 2) {
        if (load8(name) == 46) {
            if (load8(name + 1) == 46) { return 0; }
        }
    }

    # Character-by-character sweep
    var i = 0;
    while (i < len) {
        var c = load8(name + i) & 0xFF;
        if (c == 0) { return 0; }       # embedded NUL
        if (c < 32) { return 0; }       # control char
        if (c == 127) { return 0; }     # DEL
        if (c == 47) { return 0; }      # /
        if (c == 92) { return 0; }      # \
        if (c == 58) { return 0; }      # :
        i = i + 1;
    }

    # Trailing space or dot (Windows)
    var last = load8(name + len - 1) & 0xFF;
    if (last == 32) { return 0; }
    if (last == 46) { return 0; }

    # Case-fold comparison to dot-directories we guard, skipping HFS-ignorable
    # codepoints so `.g<ZWNJ>it` cannot spell `.git` past this check (v1.4.8).
    # Gated on the first significant codepoint being '.' — see the note on
    # _starts_with_dot_hfs for why that guard is not just `load8(name) == 46`.
    if (_starts_with_dot_hfs(name, len) == 1) {
        if (_name_iequal_hfs(name, len, ".sit", 4) == 1) { return 0; }
        if (_name_iequal_hfs(name, len, ".git", 4) == 1) { return 0; }
        if (_name_iequal_hfs(name, len, ".ssh", 4) == 1) { return 0; }
    }

    # NTFS reserved names
    if (_is_ntfs_reserved(name, len) == 1) { return 0; }

    # 1.6.4 (E12): NTFS 8.3 short names of the guarded dot-directories. On NTFS
    # `GIT~1` / `SIT~1` resolve to `.git` / `.sit`, so a tree entry spelled that
    # way writes into repository metadata (CVE-2014-9390 / CVE-2019-1353 class;
    # git rejects these by default on every platform). Trailing dots and spaces
    # are already refused above, so the exact five bytes are the whole check.
    if (len == 5) {
        if ((load8(name + 3) & 0xFF) == 126) {
            if ((load8(name + 4) & 0xFF) == 49) {
                var c0 = load8(name) & 0xDF;       # ASCII upper-case fold
                var c1 = load8(name + 1) & 0xDF;
                var c2 = load8(name + 2) & 0xDF;
                if (c1 == 73) {
                    if (c2 == 84) {
                        if (c0 == 71) { return 0; }   # GIT~1
                        if (c0 == 83) { return 0; }   # SIT~1
                    }
                }
            }
        }
    }

    return 1;
}

# Flattened tree path (S-03 second gate).
#
# `flatten_tree` concatenates prefix + entry-name producing paths like
# "src/main.cyr". Each segment between '/'s must individually pass
# tree_entry_name_valid; the full path must also be relative and capped.

var VAL_TREE_PATH_MAX = 4096;

# 1 if every '/'-separated segment of a relative path passes tree_entry_name_valid.
fn tree_flat_path_valid(path) {
    if (path == 0) { return 0; }
    var len = strlen(path);
    if (len == 0) { return 0; }
    if (len > VAL_TREE_PATH_MAX) { return 0; }

    # Cannot be absolute — no leading '/'
    if (load8(path) == 47) { return 0; }

    # Walk '/'-separated segments; each must pass tree_entry_name_valid.
    var seg_start = 0;
    var i = 0;
    while (i <= len) {
        var at_end = 0;
        if (i == len) { at_end = 1; }
        else {
            if (load8(path + i) == 47) { at_end = 1; }
        }
        if (at_end == 1) {
            var seg_len = i - seg_start;
            if (seg_len == 0) { return 0; }  # leading/trailing/consecutive '/'
            # Copy segment to a nul-terminated scratch buffer for the validator.
            var seg = alloc(seg_len + 1);
            memcpy(seg, path + seg_start, seg_len);
            store8(seg + seg_len, 0);
            if (tree_entry_name_valid(seg) == 0) { return 0; }
            seg_start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Tree entry mode allowlist (S-03). Only "100644" (regular file) and "40000"
# (directory) are accepted. Reject symlinks (120000), submodules (160000),
# executable (100755) — sit doesn't emit those today; accepting them from a
# remote tree gives an attacker surface we don't need.

# 1 for the two modes sit writes: 100644 (file) and 40000 (tree).
fn tree_entry_mode_valid(mode) {
    if (mode == 0) { return 0; }
    if (streq(mode, "100644") == 1) { return 1; }
    if (streq(mode, "40000") == 1) { return 1; }
    return 0;
}

# ── Config key / value (S-05) ────────────────────────────
#
# Reject control chars (includes \n, \r, \0), cap lengths, and for the key
# require dot-separated tokens that look reasonable.

# 1 if a config value has no NUL, CR or LF and fits VAL_CONFIG_VALUE_MAX.
fn config_value_valid(v) {
    if (v == 0) { return 0; }
    var len = strlen(v);
    if (len > VAL_CONFIG_VALUE_MAX) { return 0; }
    var i = 0;
    while (i < len) {
        var c = load8(v + i) & 0xFF;
        if (c == 0) { return 0; }
        if (c == 10) { return 0; }
        if (c == 13) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if a config key is [A-Za-z0-9._-]+ and fits VAL_CONFIG_KEY_MAX.
fn config_key_valid(k) {
    if (k == 0) { return 0; }
    var len = strlen(k);
    if (len == 0) { return 0; }
    if (len > VAL_CONFIG_KEY_MAX) { return 0; }
    var i = 0;
    while (i < len) {
        var c = load8(k + i) & 0xFF;
        # Keys may contain ASCII letters, digits, '.', '_', '-'
        var ok = 0;
        if (c >= 97) { if (c <= 122) { ok = 1; } }  # a-z
        if (c >= 65) { if (c <= 90) { ok = 1; } }   # A-Z
        if (c >= 48) { if (c <= 57) { ok = 1; } }   # 0-9
        if (c == 46) { ok = 1; }  # .
        if (c == 95) { ok = 1; }  # _
        if (c == 45) { ok = 1; }  # -
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ── Remote URL (S-04) ───────────────────────────────
#
# Scheme-aware validator. v0.6.x accepted only local-path schemes; v0.7.1
# extends acceptance to http://, https://, ssh:// (transport itself lands in
# v0.7.2+, but URLs validate at remote-add time so users can wire config in
# advance without seeing parse errors when transport ships).
#
# Per-scheme strictness is deliberately conservative: control-char / NUL /
# leading-dash gates apply uniformly; the network-scheme path then runs the
# authority+path body through a whitelist character set. v0.7.3 (HTTP fetch)
# and v0.7.8 (SSH transport) tighten further as those code paths land —
# e.g. RFC3986 host-label rules, port range enforcement, no-`..`-segments.
#
# CVE-2017-1000117 prophylactic: any URL with a leading '-' is rejected so
# the day a transport forks a subprocess, an attacker-controlled URL cannot
# masquerade as a flag.

var URL_SCHEME_INVALID = 0 - 1;
var URL_SCHEME_FILE = 0;
var URL_SCHEME_HTTP = 1;
var URL_SCHEME_HTTPS = 2;
var URL_SCHEME_SSH = 3;

# Classify a URL by its scheme prefix. Path-shaped inputs ('/abs', './rel',
# '../rel') classify as FILE so callers can dispatch with a single switch.
# Returns INVALID for empty / NULL / unrecognized-scheme inputs. Does NOT
# perform body validation — pair with remote_url_valid for the full check.
fn url_scheme(url) {
    if (url == 0) { return URL_SCHEME_INVALID; }
    var len = strlen(url);
    if (len == 0) { return URL_SCHEME_INVALID; }
    if (len >= 8) {
        if (memeq(url, "https://", 8) == 1) { return URL_SCHEME_HTTPS; }
    }
    if (len >= 7) {
        if (memeq(url, "file://", 7) == 1) { return URL_SCHEME_FILE; }
        if (memeq(url, "http://",  7) == 1) { return URL_SCHEME_HTTP;  }
    }
    if (len >= 6) {
        if (memeq(url, "ssh://",   6) == 1) { return URL_SCHEME_SSH;   }
    }
    # Bare paths: absolute (/…) or relative (./…, ../…).
    if (load8(url) == 47) { return URL_SCHEME_FILE; }
    if (load8(url) == 46) { return URL_SCHEME_FILE; }
    return URL_SCHEME_INVALID;
}

# Whitelist body validator for the authority+path of a network URL. Accepts
# alphanumeric plus . - _ / : @ % ~ — sufficient to express
# user@host:port/path-with-encoded-segments without admitting shell or SQL
# metachars. Empty body and leading '-' are rejected (the latter as a second
# layer of CVE-2017-1000117 defense if the scheme prefix was 7+ bytes long).
fn url_authority_path_valid(s, len) {
    if (len == 0) { return 0; }
    if (load8(s) == 45) { return 0; }
    var i = 0;
    while (i < len) {
        var c = load8(s + i) & 0xFF;
        var ok = 0;
        if (c >= 48) { if (c <=  57) { ok = 1; } }  # 0-9
        if (c >= 65) { if (c <=  90) { ok = 1; } }  # A-Z
        if (c >= 97) { if (c <= 122) { ok = 1; } }  # a-z
        if (c == 46) { ok = 1; }  # .
        if (c == 45) { ok = 1; }  # -
        if (c == 95) { ok = 1; }  # _
        if (c == 47) { ok = 1; }  # /
        if (c == 58) { ok = 1; }  # :
        if (c == 64) { ok = 1; }  # @
        if (c == 37) { ok = 1; }  # %
        if (c == 126) { ok = 1; } # ~
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if a remote URL is safe to store and hand to a transport (no leading '-', no control bytes).
fn remote_url_valid(url) {
    if (url == 0) { return 0; }
    var len = strlen(url);
    if (len == 0) { return 0; }
    if (len > VAL_REMOTE_URL_MAX) { return 0; }

    # CVE-2017-1000117 prophylactic
    if (load8(url) == 45) { return 0; }

    # Control chars / NUL
    var i = 0;
    while (i < len) {
        var c = load8(url + i) & 0xFF;
        if (c == 0) { return 0; }
        if (c == 10) { return 0; }
        if (c == 13) { return 0; }
        i = i + 1;
    }

    var s = url_scheme(url);
    if (s == URL_SCHEME_FILE) {
        # Already passed control-char + leading-dash gates above; file://
        # plus bare absolute/relative paths are accepted as-is.
        return 1;
    }
    if (s == URL_SCHEME_HTTP) {
        return url_authority_path_valid(url + 7, len - 7);
    }
    if (s == URL_SCHEME_HTTPS) {
        return url_authority_path_valid(url + 8, len - 8);
    }
    if (s == URL_SCHEME_SSH) {
        return url_authority_path_valid(url + 6, len - 6);
    }
    return 0;
}

# --- config.cyr ---

# config.cyr — sit config file parsing + cmd_config.
#
# Flat `key = value` format. Local at .sit/config; global at ~/.sitconfig.
# Resolution priority: env (at call sites) → local → global → fallback.

# Advance past any run of spaces or tabs in [pos, stop).
# Parse a `key = value` line in [start, stop). Returns heap cstring value
# if the key matches, else 0. Tolerates arbitrary whitespace and skips
# `#`-comment / blank lines.
fn config_parse_value(data, start, stop, key, key_len) {
    var i = skip_ws(data, start, stop);
    if (i >= stop) { return 0; }
    if (load8(data + i) == 35) { return 0; }

    if (stop - i < key_len) { return 0; }
    if (memeq(data + i, key, key_len) == 0) { return 0; }
    i = i + key_len;

    i = skip_ws(data, i, stop);
    if (i >= stop) { return 0; }
    if (load8(data + i) != 61) { return 0; }
    i = i + 1;

    i = skip_ws(data, i, stop);

    var end = stop;
    var trimming = 1;
    while (trimming == 1) {
        if (end <= i) { trimming = 0; }
        else {
            var c = load8(data + end - 1);
            if (c == 32) { end = end - 1; }
            else {
                if (c == 9) { end = end - 1; }
                else { trimming = 0; }
            }
        }
    }

    var value_len = end - i;
    var val = alloc(value_len + 1);
    memcpy(val, data + i, value_len);
    store8(val + value_len, 0);
    return val;
}

# Look up `key` in a single config file. Returns heap cstring value or 0.
fn config_file_get(path, key) {
    if (sf_exists(path) != 1) { return 0; }
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0; }
    var data = load64(&pair);
    var len = load64(&pair + 8);
    var key_len = strlen(key);

    var pos = 0;
    while (pos < len) {
        var le = pos;
        var finding = 1;
        while (finding == 1) {
            if (le >= len) { finding = 0; }
            else {
                if (load8(data + le) == 10) { finding = 0; }
                else { le = le + 1; }
            }
        }
        var stop = le;
        if (stop > pos) {
            if (load8(data + stop - 1) == 13) { stop = stop - 1; }
        }
        var v = config_parse_value(data, pos, stop, key, key_len);
        if (v != 0) { return v; }
        pos = le + 1;
    }
    return 0;
}

# 1.7.6 (X5): config_get for keys that decide where a credential goes or how a
# server is trusted — remote.<name>.tokenFile, http.sslVerify / caBundle /
# sslCert / sslKey. A repo-local value counts only when `.sit/config` belongs
# to this user (git's safe.directory test — ownership, not mode, since a umask
# of 002 makes every file group-writable); a
# `.sit/` someone else made (a shared checkout, a CI workspace) could otherwise
# send any 0600 one-line file as the bearer token to a URL of its choosing, or
# turn certificate checking off. Otherwise ~/.sitconfig decides.
fn config_get_trusted(key) {
    if (_local_config_trusted() == 1) { return config_get(key); }
    var v = config_file_get(".sit/config", key);
    if (v != 0) {
        eprint3("sit: ignoring '", key, "' in .sit/config — the file belongs to another user\n");
    }
    var home = getenv("HOME");
    if (home == 0) { return 0; }
    var hlen = strlen(home);
    var path = alloc(hlen + 12);
    memcpy(path, home, hlen);
    memcpy(path + hlen, "/.sitconfig", 11);
    store8(path + hlen + 11, 0);
    return config_file_get(path, key);
}

# 1 when `.sit/` is owned by the effective uid and `.sit/config` is absent or
# owned by it too; 0 otherwise. Both by lstat: a symlink at `.sit/config` is
# owned by whoever planted it, whatever it points at (following it let another
# user's link to one of this user's files pass). (agnos is single-user and its
# stat has no owner field: always 1 there.)
fn _local_config_trusted() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 1;
    #else
    var euid = syscall(SYS_GETEUID);
    var duid = _lstat_uid(sit_abs(".sit"));
    if (duid >= 0) { if (duid != euid) { return 0; } }
    var cuid = _lstat_uid(sit_abs(".sit/config"));
    if (cuid < 0) { return 1; }                      # no config: nothing to trust
    if (cuid != euid) { return 0; }
    return 1;
    #endif
}

# Owner uid of `apath` itself (a symlink's own owner, not its target's), or -1.
fn _lstat_uid(apath) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #else
    var st[256];
    if (syscall(262, VAL_AT_FDCWD, apath, &st, VAL_AT_SYMLINK_NOFOLLOW) < 0) { return 0 - 1; }
    return load32(&st + STAT_UID);
    #endif
}

# Look up `key` in .sit/config (local, higher precedence) then ~/.sitconfig.
fn config_get(key) {
    var v = config_file_get(".sit/config", key);
    if (v != 0) { return v; }
    var home = getenv("HOME");
    if (home == 0) { return 0; }
    var hlen = strlen(home);
    var path = alloc(hlen + 12);
    memcpy(path, home, hlen);
    memcpy(path + hlen, "/.sitconfig", 11);
    store8(path + hlen + 11, 0);
    return config_file_get(path, key);
}

# Upsert `key = value` in a config file. Replaces the first matching line
# or appends a new one. Returns 0 on success, negative on write failure.
#
# S-05: reject newlines/NUL/control chars in both key and value. Prevents
# `sit remote add origin $'foo\nother = attacker'`-shape injection
# (CVE-2023-29007 / CVE-2025-48384).
fn config_file_set(path, key, value) {
    if (config_key_valid(key) == 0) { return 0 - 2; }
    if (config_value_valid(value) == 0) { return 0 - 2; }
    var key_len = strlen(key);
    var val_len = strlen(value);

    var data = 0;
    var len = 0;
    # sf_exists is "can be opened for reading", so an unreadable config looked
    # absent; lstat says whether there is anything there at all.
    if (path_lstat_kind(sit_abs(path)) >= 0) {
        # 1.7.6 (L15): a config that exists but cannot be read is an error. It
        # was read as empty, and the rewrite below then replaced the whole file
        # with the one key being set — every remote and setting gone.
        var pair[16];
        if (read_file_heap(path, &pair) != 0) { return 0 - 3; }
        data = load64(&pair);
        len = load64(&pair + 8);
    }

    # S-25: size `out` for EVERY matching line, not one.
    #
    # This used to be `alloc(len + key_len + val_len + 8)`, which assumes the key
    # occurs at most once. The rewrite loop below replaces *every* matching line
    # with "<key> = <value>\n", so N occurrences each contribute
    # key_len + 3 + val_len + 1 bytes while the allowance covered a single one.
    # A config holding 2000 short duplicate lines plus a 1000-byte value wrote
    # 2,010,007 bytes into a 9,016-byte allocation — a silent 2 MB heap overflow
    # that exited 0, faulting only if the bump allocator happened to be short of
    # mapped slack. Reachable from `sit config` / `sit remote add` against any
    # repo whose .sit/config arrived from outside (clone, tarball, shared
    # checkout).
    #
    # Count the matches first, then allocate for all of them plus the append
    # case. The counting pass mirrors the rewrite loop's line scan exactly.
    var nmatch = 0;
    var cpos = 0;
    while (cpos < len) {
        var cle = cpos;
        var cfind = 1;
        while (cfind == 1) {
            if (cle >= len) { cfind = 0; }
            else {
                if (load8(data + cle) == 10) { cfind = 0; }
                else { cle = cle + 1; }
            }
        }
        var cstop = cle;
        if (cstop > cpos) {
            if (load8(data + cstop - 1) == 13) { cstop = cstop - 1; }
        }
        if (config_parse_value(data, cpos, cstop, key, key_len) != 0) { nmatch = nmatch + 1; }
        cpos = cle + 1;
    }

    # Each rewritten line costs at most key_len + 3 (" = ") + val_len + 1 ("\n").
    # The trailing +... covers the not-found append path (same shape, plus a
    # possible inserted newline) and keeps the old slack.
    var per_line = key_len + val_len + 4;
    var out_cap = len + nmatch * per_line + per_line + 8;
    var out = alloc_or_die(out_cap);
    var out_pos = 0;
    var replaced = 0;

    var pos = 0;
    while (pos < len) {
        var le = pos;
        var finding = 1;
        while (finding == 1) {
            if (le >= len) { finding = 0; }
            else {
                if (load8(data + le) == 10) { finding = 0; }
                else { le = le + 1; }
            }
        }
        var stop = le;
        if (stop > pos) {
            if (load8(data + stop - 1) == 13) { stop = stop - 1; }
        }

        var v = config_parse_value(data, pos, stop, key, key_len);
        if (v != 0) {
            memcpy(out + out_pos, key, key_len);
            out_pos = out_pos + key_len;
            memcpy(out + out_pos, " = ", 3);
            out_pos = out_pos + 3;
            memcpy(out + out_pos, value, val_len);
            out_pos = out_pos + val_len;
            store8(out + out_pos, 10);
            out_pos = out_pos + 1;
            replaced = 1;
        }
        else {
            var copy_len = le - pos;
            if (le < len) { copy_len = copy_len + 1; }
            memcpy(out + out_pos, data + pos, copy_len);
            out_pos = out_pos + copy_len;
        }
        pos = le + 1;
    }

    if (replaced == 0) {
        if (out_pos > 0) {
            if (load8(out + out_pos - 1) != 10) {
                store8(out + out_pos, 10);
                out_pos = out_pos + 1;
            }
        }
        memcpy(out + out_pos, key, key_len);
        out_pos = out_pos + key_len;
        memcpy(out + out_pos, " = ", 3);
        out_pos = out_pos + 3;
        memcpy(out + out_pos, value, val_len);
        out_pos = out_pos + val_len;
        store8(out + out_pos, 10);
        out_pos = out_pos + 1;
    }

    if (sf_write_atomic(path, out, out_pos) < 0) { return 0 - 1; }
    return 0;
}

# Print every non-blank, non-comment line of a config file to stdout.
fn config_file_list(path) {
    if (sf_exists(path) != 1) { return 0; }
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0; }
    var data = load64(&pair);
    var len = load64(&pair + 8);
    var pos = 0;
    while (pos < len) {
        var le = pos;
        var finding = 1;
        while (finding == 1) {
            if (le >= len) { finding = 0; }
            else {
                if (load8(data + le) == 10) { finding = 0; }
                else { le = le + 1; }
            }
        }
        var stop = le;
        if (stop > pos) {
            if (load8(data + stop - 1) == 13) { stop = stop - 1; }
        }
        var start = skip_ws(data, pos, stop);
        if (start < stop) {
            if (load8(data + start) != 35) {
                # 1.6.4 (E9): sanitized like single-key `sit config <key>`
                # output already was; --list echoed ESC / BEL / CR raw.
                write_sanitized(STDOUT, data + pos, le - pos);
                if (le < len) { stdout_write("\n", 1); }
            }
        }
        pos = le + 1;
    }
    return 0;
}

# Remove the first line matching `key = value` from a config file.
# Returns 0 on success, -1 on I/O failure, -2 if the key wasn't present.
fn config_file_unset(path, key) {
    var key_len = strlen(key);
    if (sf_exists(path) != 1) { return 0 - 2; }
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0 - 1; }
    var data = load64(&pair);
    var len = load64(&pair + 8);

    var out = alloc(len + 1);
    var out_pos = 0;
    var removed = 0;
    var pos = 0;
    while (pos < len) {
        var le = pos;
        var finding = 1;
        while (finding == 1) {
            if (le >= len) { finding = 0; }
            else {
                if (load8(data + le) == 10) { finding = 0; }
                else { le = le + 1; }
            }
        }
        var stop = le;
        if (stop > pos) {
            if (load8(data + stop - 1) == 13) { stop = stop - 1; }
        }
        var v = config_parse_value(data, pos, stop, key, key_len);
        if (v != 0) {
            removed = 1;
        }
        else {
            var copy_len = le - pos;
            if (le < len) { copy_len = copy_len + 1; }
            memcpy(out + out_pos, data + pos, copy_len);
            out_pos = out_pos + copy_len;
        }
        pos = le + 1;
    }
    if (removed == 0) { return 0 - 2; }
    if (sf_write_atomic(path, out, out_pos) < 0) { return 0 - 1; }
    return 0;
}

# `sit config [--global] [--list|--unset] <key> [<value>]` — read or write a config value.
fn cmd_config() {
    var global = 0;
    var arg_base = 2;
    if (argc() >= 3) {
        if (streq(argv(2), "--global") == 1) {
            global = 1;
            arg_base = 3;
        }
    }

    var path = 0;
    if (global == 1) {
        var home = getenv("HOME");
        if (home == 0) {
            eprintln("sit: HOME not set");
            return 1;
        }
        var hlen = strlen(home);
        path = alloc(hlen + 12);
        memcpy(path, home, hlen);
        memcpy(path + hlen, "/.sitconfig", 11);
        store8(path + hlen + 11, 0);
    }
    else {
        if (sf_exists(".sit/HEAD") != 1) {
            eprintln("sit: not a sit repository (run 'sit init')");
            return 1;
        }
        path = ".sit/config";
    }

    if (argc() < arg_base + 1) {
        eprintln("usage: sit config [--global] [--list | --unset <key> | <key> [<value>]]");
        return 1;
    }

    # --list: dump all entries (or nothing if file missing)
    if (streq(argv(arg_base), "--list") == 1) {
        config_file_list(path);
        return 0;
    }

    # --unset <key>: remove key
    if (streq(argv(arg_base), "--unset") == 1) {
        if (argc() < arg_base + 2) {
            eprintln("sit: --unset requires a key");
            return 1;
        }
        var ukey = argv_heap(arg_base + 1);
        var r = config_file_unset(path, ukey);
        if (r == 0 - 2) {
            syscall(SYS_WRITE, STDERR, "sit: '", 6);
            syscall(SYS_WRITE, STDERR, ukey, strlen(ukey));
            syscall(SYS_WRITE, STDERR, "' not set in ", 13);
            syscall(SYS_WRITE, STDERR, path, strlen(path));
            syscall(SYS_WRITE, STDERR, "\n", 1);
            return 1;
        }
        if (r == 0 - 2) {
            eprintln("sit: invalid key or value (no newlines, control chars, or NULs)");
            return 1;
        }
        if (r < 0) {
            eprintln("sit: failed to write config");
            return 1;
        }
        return 0;
    }

    var key = argv_heap(arg_base);
    if (argc() < arg_base + 2) {
        var val = 0;
        if (global == 1) { val = config_file_get(path, key); }
        else             { val = config_get(key); }
        if (val == 0) { return 1; }
        # S-26: scrub control bytes before echoing to the terminal. `sit config`
        # writes go through config_value_valid, but a config file can arrive
        # from outside the process (cloned repo, tarball, shared checkout), so
        # the value READ back is not necessarily one sit wrote. Same defence
        # S-21 already applies to commit author identities.
        stdout_flush();
        write_sanitized(STDOUT, val, strlen(val));
        stdout_write("\n", 1);
        return 0;
    }

    var value = argv_heap(arg_base + 1);
    var set_r = config_file_set(path, key, value);
    if (set_r == 0 - 2) {
        eprintln("sit: invalid key or value (no newlines, control chars, or NULs)");
        return 1;
    }
    if (set_r == 0 - 3) {
        eprintln("sit: cannot read the config file — nothing changed");
        return 1;
    }
    if (set_r < 0) {
        eprintln("sit: failed to write config");
        return 1;
    }
    return 0;
}

# --- reflog.cyr ---

# reflog.cyr — ref-movement journal (.sit/logs/), git-compatible.
#
# Every ref movement appends one line to a per-ref log under .sit/logs/,
# mirroring the ref tree: .sit/logs/HEAD, .sit/logs/refs/heads/<name>,
# .sit/logs/refs/remotes/<remote>/<name>. (Tags are not logged, matching
# git's default.) A branch-tip move that HEAD points at logs TWICE — once
# to the branch log and once to logs/HEAD — see docs/architecture/005.
#
# Line format (byte-compatible with git's SHA-256 reflog):
#   <old64> SP <new64> SP <name> " <" <email> "> " <unixts> " +0000" TAB <msg> LF
# Creation uses 64 ASCII '0' for <old64>. Entries are append-only, newest
# LAST; <ref>@{0} = the last line (current value), @{N} = N moves ago =
# the NEW oid recorded at line (count-1-N). Identity + timestamp + tz
# mirror build_commit_signed (commit.cyr) so the journal matches commits.
#
# This module is intentionally I/O-thin: the pure formatting / indexing
# core (reflog_format_line, _reflog_nth_in_buf, _reflog_count_in_buf) is
# unit-tested directly; the file wrappers (reflog_append, reflog_read_nth)
# are exercised by the CI smoke suite.

# ── Identity (mirrors build_commit_signed's resolution chain) ──────────
# env SIT_AUTHOR_* → .sit/config / ~/.sitconfig user.* → fallback.
# NOTE: commit.cyr and merge.cyr inline this same chain; this is the third
# copy — a shared author_ident() helper is the natural next refactor.
fn _reflog_user_name() {
    var name = getenv("SIT_AUTHOR_NAME");
    if (name == 0) { name = config_get("user.name"); }
    if (name == 0) { name = "sit user"; }
    return name;
}

fn _reflog_user_email() {
    var email = getenv("SIT_AUTHOR_EMAIL");
    if (email == 0) { email = config_get("user.email"); }
    if (email == 0) { email = "user@localhost"; }
    return email;
}

# Copy `len` bytes of message into dst, replacing any control byte
# (< 0x20 or 0x7f) with a space so the entry stays a single line and
# can't forge extra reflog records. Returns bytes written (== len).
fn _reflog_san_into(dst, src, len) {
    var i = 0;
    var o = 0;
    while (i < len) {
        var c = load8(src + i) & 0xFF;
        var bad = 0;
        if (c < 32) { bad = 1; }
        if (c == 127) { bad = 1; }
        if (bad == 1) { store8(dst + o, 32); }
        else { store8(dst + o, c); }
        o = o + 1;
        i = i + 1;
    }
    return o;
}

# Format one reflog line into buf. old_hex == 0 → 64 zeros (creation).
# new_hex must be a 64-char hex cstring. Returns the line length.
# buf must be sized >= 200 + strlen(name) + strlen(email) + strlen(msg).
fn reflog_format_line(buf, old_hex, new_hex, name, email, ts, msg) {
    var pos = 0;
    if (old_hex == 0) {
        var z = 0;
        while (z < 64) { store8(buf + pos, 48); pos = pos + 1; z = z + 1; }
    } else {
        memcpy(buf + pos, old_hex, 64); pos = pos + 64;
    }
    store8(buf + pos, 32); pos = pos + 1;

    memcpy(buf + pos, new_hex, 64); pos = pos + 64;
    store8(buf + pos, 32); pos = pos + 1;

    # Identity is sanitized exactly like the message: a control byte (LF/TAB/
    # …) in SIT_AUTHOR_NAME/EMAIL or a hand-edited config must NOT be able to
    # forge or shift a reflog line. _reflog_san_into preserves length.
    var nl = _reflog_san_into(buf + pos, name, strlen(name)); pos = pos + nl;
    memcpy(buf + pos, " <", 2); pos = pos + 2;
    var el = _reflog_san_into(buf + pos, email, strlen(email)); pos = pos + el;
    memcpy(buf + pos, "> ", 2); pos = pos + 2;

    var d = write_decimal(buf + pos, ts); pos = pos + d;
    memcpy(buf + pos, " +0000", 6); pos = pos + 6;

    store8(buf + pos, 9); pos = pos + 1;            # TAB before message
    var ml = _reflog_san_into(buf + pos, msg, strlen(msg)); pos = pos + ml;
    store8(buf + pos, 10); pos = pos + 1;           # LF terminator
    return pos;
}

# ── Reflog message builders ──────────────

# "<prefix><first line of message>" as a heap cstring for a reflog entry.
# The subject stops at the first LF; reflog_append later sanitizes any
# remaining control bytes. Used for commit/reset entries.
fn reflog_msg_subject(prefix, message) {
    var pl = strlen(prefix);
    var sl = 0;
    var scanning = 1;
    while (scanning == 1) {
        var c = load8(message + sl);
        if (c == 0) { scanning = 0; }
        else {
            if (c == 10) { scanning = 0; }
            else { sl = sl + 1; }
        }
    }
    var out = alloc(pl + sl + 1);
    memcpy(out, prefix, pl);
    memcpy(out + pl, message, sl);
    store8(out + pl + sl, 0);
    return out;
}

# "<a><b><c>" as a heap cstring — e.g. ("merge ", name, ": Fast-forward").
fn reflog_msg_join(a, b, c) {
    var al = strlen(a);
    var bl = strlen(b);
    var cl = strlen(c);
    var out = alloc(al + bl + cl + 1);
    memcpy(out, a, al);
    memcpy(out + al, b, bl);
    memcpy(out + al + bl, c, cl);
    store8(out + al + bl + cl, 0);
    return out;
}

# ── Pure indexing core (LF-terminated, append-only log buffers) ────────

# Count entries (LF-terminated lines) in a log buffer.
fn _reflog_count_in_buf(buf, len) {
    var i = 0;
    var c = 0;
    while (i < len) {
        if (load8(buf + i) == 10) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Byte offset where line `idx` (0-based) starts, or -1 if absent.
fn _reflog_line_start(buf, len, idx) {
    if (idx == 0) { return 0; }
    var i = 0;
    var seen = 0;
    var found = 0 - 1;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= len) { scanning = 0; }
        else {
            if (load8(buf + i) == 10) {
                seen = seen + 1;
                if (seen == idx) { found = i + 1; scanning = 0; }
            }
            i = i + 1;
        }
    }
    return found;
}

# Resolve <ref>@{n} within a log buffer: write the new-oid (field 2) of the
# entry n moves ago into out (65 bytes, nul-terminated). n == 0 is the last
# (current) entry. Returns 1 on success, 0 if n is out of range or the
# target line is malformed. Never reads past `len`.
fn _reflog_nth_in_buf(buf, len, n, out) {
    if (n < 0) { return 0; }
    var c = _reflog_count_in_buf(buf, len);
    if (n >= c) { return 0; }
    var target = c - 1 - n;
    var s = _reflog_line_start(buf, len, target);
    if (s < 0) { return 0; }
    # Layout: old(64) SP new(64) SP ... — need new-oid at [s+65, s+129).
    if (s + 129 > len) { return 0; }
    if (load8(buf + s + 64) != 32) { return 0; }
    if (hex_prefix_valid(buf + s + 65, 64) == 0) { return 0; }
    memcpy(out, buf + s + 65, 64);
    store8(out + 64, 0);
    return 1;
}

# Message field of one line (everything after the first TAB, up to LF).
# Writes {ptr, len} into out_pair (16 bytes). Returns 1 if a TAB was found,
# else 0 (ptr/len zeroed). Used by cmd_reflog rendering.
fn _reflog_line_msg(line, len, out_pair) {
    var i = 0;
    var tab = 0 - 1;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= len) { scanning = 0; }
        else {
            var c = load8(line + i);
            if (c == 9) { tab = i; scanning = 0; }
            else {
                if (c == 10) { scanning = 0; }
                else { i = i + 1; }
            }
        }
    }
    if (tab < 0) { store64(out_pair, 0); store64(out_pair + 8, 0); return 0; }
    var mstart = tab + 1;
    var mend = mstart;
    var scan2 = 1;
    while (scan2 == 1) {
        if (mend >= len) { scan2 = 0; }
        else {
            if (load8(line + mend) == 10) { scan2 = 0; }
            else { mend = mend + 1; }
        }
    }
    store64(out_pair, line + mstart);
    store64(out_pair + 8, mend - mstart);
    return 1;
}

# Parse a "<base>@{<N>}" ordinal selector. On success writes the base ref
# into out (24 bytes: [0]=ptr into `name`, [8]=base byte-length, [16]=N)
# and returns 1. Returns 0 if the string isn't a well-formed @{N} selector:
# no "@{", empty base, no closing "}", a non-digit / empty index, or junk
# after the "}". Only the bare-integer ordinal form is accepted (the
# @{<date>} time form is intentionally unsupported in 1.1.0). Pure — no I/O.
fn _reflog_spec_parse(name, out) {
    var nlen = strlen(name);
    var at = 0 - 1;
    var i = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (i + 1 >= nlen) { scanning = 0; }
        else {
            if (load8(name + i) == 64) {
                if (load8(name + i + 1) == 123) { at = i; scanning = 0; }
                else { i = i + 1; }
            } else { i = i + 1; }
        }
    }
    if (at <= 0) { return 0; }                 # no "@{" or empty base
    var j = at + 2;
    var num = 0;
    var ndig = 0;
    var ok = 1;
    var parsing = 1;
    while (parsing == 1) {
        if (j >= nlen) { ok = 0; parsing = 0; }
        else {
            var c = load8(name + j);
            if (c == 125) { parsing = 0; }     # '}'
            else {
                if (c < 48) { ok = 0; parsing = 0; }
                else {
                    if (c > 57) { ok = 0; parsing = 0; }
                    else { num = num * 10 + (c - 48); ndig = ndig + 1; j = j + 1; }
                }
            }
        }
    }
    if (ok == 0) { return 0; }
    if (ndig == 0) { return 0; }               # "@{}" rejected
    # 1.6.4 (E13): bounded — `num * 10` wrapped, so HEAD@{18446744073709551617}
    # resolved to HEAD@{1}. No reflog is a billion entries deep.
    if (ndig > 9) { return 0; }
    if (j != nlen - 1) { return 0; }           # "}" must be the final byte
    store64(out, name);
    store64(out + 8, at);
    store64(out + 16, num);
    return 1;
}

# Push a 64-hex oid at `p` into the `roots` vec as a fresh 65-byte cstring,
# unless it's invalid hex or the all-zeros creation sentinel. Used by fsck
# to treat reflog entries as reachability roots (prune grace).
fn _reflog_push_oid_if_valid(p, roots) {
    if (hex_prefix_valid(p, 64) == 0) { return 0; }
    var allzero = 1;
    var k = 0;
    while (k < 64) {
        if (load8(p + k) != 48) { allzero = 0; k = 64; }
        else { k = k + 1; }
    }
    if (allzero == 1) { return 0; }
    var hex = alloc(65);
    memcpy(hex, p, 64);
    store8(hex + 64, 0);
    vec_push(roots, hex);
    return 0;
}

# Collect every old+new oid from a reflog buffer into `roots` (skipping the
# all-zeros creation sentinel). Pure parse over one log file's bytes.
#
# 1.7.6 (R7): one pass. Each line's start was found by rescanning from byte 0,
# so N entries cost N²/2 line scans — 75 s of `sit fsck` at 20,000 entries,
# and reflogs never expire. Same lines as before: every LF-terminated one.
fn _reflog_collect_oids(buf, len, roots) {
    var s = 0;
    var i = 0;
    while (i < len) {
        if (load8(buf + i) == 10) {
            if (s + 129 <= len) {
                if (load8(buf + s + 64) == 32) {
                    _reflog_push_oid_if_valid(buf + s, roots);        # old
                    _reflog_push_oid_if_valid(buf + s + 65, roots);   # new
                }
            }
            s = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Start offsets of the LF-terminated lines in `buf`, in order, in one pass
# (1.7.6, R7): line k starts at vec_get(result, k).
fn _reflog_line_starts(buf, len) {
    var starts = vec_new();
    var s = 0;
    var i = 0;
    while (i < len) {
        if (load8(buf + i) == 10) {
            vec_push(starts, s);
            s = i + 1;
        }
        i = i + 1;
    }
    return starts;
}

# ── File wrappers ──────────────

# ".sit/logs/<refpath>" as a heap cstring. refpath is e.g. "HEAD" or
# "refs/heads/main" or "refs/remotes/origin/main".
fn reflog_log_path(refpath) {
    var rl = strlen(refpath);
    var p = alloc(10 + rl + 1);
    memcpy(p, ".sit/logs/", 10);
    memcpy(p + 10, refpath, rl);
    store8(p + 10 + rl, 0);
    return p;
}

# Append one entry to .sit/logs/<refpath> with caller-supplied identity +
# timestamp. old_hex == 0 → creation (zeros). Returns 0 on success, -1 on
# failure. Best-effort: callers log AFTER the ref moves, so a failed append
# never blocks the operation. reflog_head_move uses this to stamp the HEAD
# log and the branch log with ONE identical (ts, name, email) per move.
fn _reflog_append_full(refpath, old_hex, new_hex, msg, name, email, ts) {
    if (new_hex == 0) { return 0 - 1; }
    var cap = 200 + strlen(name) + strlen(email) + strlen(msg);
    var buf = alloc(cap);
    var llen = reflog_format_line(buf, old_hex, new_hex, name, email, ts, msg);
    var path = reflog_log_path(refpath);
    ensure_parent_dirs(path);
    if (sf_append_locked(path, buf, llen) < 0) { return 0 - 1; }
    return 0;
}

# Append one entry, resolving identity + timestamp now. Single-ref convenience
# wrapper around _reflog_append_full (branch-create, fetch remote-tracking).
fn reflog_append(refpath, old_hex, new_hex, msg) {
    return _reflog_append_full(refpath, old_hex, new_hex, msg,
      _reflog_user_name(), _reflog_user_email(), clock_epoch_secs());
}

# Resolve <ref>@{n}: read .sit/logs/<refpath>, write the new-oid of entry n
# into out (65 bytes). Returns 1 on success, 0 if no log / out of range.
fn reflog_read_nth(refpath, n, out) {
    var path = reflog_log_path(refpath);
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    return _reflog_nth_in_buf(buf, len, n, out);
}

# ── `sit reflog` command ───────

# Map a user-facing ref label to its log refpath under .sit/logs/. HEAD →
# "HEAD"; otherwise prefer an existing logs/refs/heads/<label>, then
# logs/refs/remotes/<label>; default to refs/heads/<label> (yields no
# entries if absent). Tags are never logged, so no tags branch.
fn _reflog_log_refpath_for(label) {
    if (streq(label, "HEAD") == 1) { return "HEAD"; }
    var ll = strlen(label);
    var hp = alloc(11 + ll + 1);
    memcpy(hp, "refs/heads/", 11);
    memcpy(hp + 11, label, ll);
    store8(hp + 11 + ll, 0);
    if (sf_exists(reflog_log_path(hp)) == 1) { return hp; }
    var rp = alloc(13 + ll + 1);
    memcpy(rp, "refs/remotes/", 13);
    memcpy(rp + 13, label, ll);
    store8(rp + 13 + ll, 0);
    if (sf_exists(reflog_log_path(rp)) == 1) { return rp; }
    return hp;
}

# sit reflog [-n <count>] [<ref>]
# Print a ref's movement history newest-first, git-shaped:
#   <short-new-oid> <ref>@{N}: <message>
# Defaults to HEAD. Silent (exit 0) when the ref has no log yet.
fn cmd_reflog() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    # 1.8.0: `expire` and `delete` subcommands; `show` is the listing's name
    # (git's), and a bare `sit reflog [<ref>]` still lists.
    var ai = 2;
    if (argc() > 2) {
        var sub = argv(2);
        if (streq(sub, "expire") == 1) { return _reflog_cmd_expire(); }
        if (streq(sub, "delete") == 1) { return _reflog_cmd_delete(); }
        if (streq(sub, "show") == 1) { ai = 3; }
    }
    var ref_label = "HEAD";
    var refpath = "HEAD";
    var limit = 0 - 1;                # -1 = no limit
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "-n") == 1) {
            if (ai + 1 < argc()) { limit = atoi(argv(ai + 1)); ai = ai + 1; }
        } else {
            ref_label = argv_heap(ai);
            # S-02: the label becomes a .sit/logs/ path component; reject
            # traversal ('..', leading '/') and control chars. "HEAD" is the
            # one literal that isn't a refname_valid ref.
            if (streq(ref_label, "HEAD") == 0) {
                if (refname_valid(ref_label) == 0) {
                    eprintln("sit: invalid ref name");
                    return 1;
                }
            }
            refpath = _reflog_log_refpath_for(ref_label);
        }
        ai = ai + 1;
    }

    var path = reflog_log_path(refpath);
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    var starts = _reflog_line_starts(buf, len);       # 1.7.6 (R7): once
    var count = vec_len(starts);
    if (count == 0) { return 0; }

    var label_len = strlen(ref_label);
    var shown = 0;
    var d = 0;
    while (d < count) {
        var stop = 0;
        if (limit >= 0) { if (shown >= limit) { stop = 1; } }
        if (stop == 1) { d = count; }       # terminate (no break with vars)
        else {
            var s = vec_get(starts, count - 1 - d);
            if (s >= 0) {
                if (s + 77 <= len) {
                    # Display sanitization: .sit/logs is on-disk data that
                    # could be corrupt or hand-crafted, so scrub control bytes
                    # (terminal-escape injection) out of the echoed oid + msg
                    # before they hit the terminal. Sanitize into a buffer so
                    # the buffered stdout ordering is preserved (S-21 class).
                    var oidbuf[16];
                    _reflog_san_into(&oidbuf, buf + s + 65, 12);
                    stdout_write(&oidbuf, 12);          # short new-oid
                    stdout_write(" ", 1);
                    stdout_write(ref_label, label_len);
                    stdout_write("@{", 2);
                    var nb[24];
                    var nd = write_decimal(&nb, d);
                    stdout_write(&nb, nd);
                    stdout_write("}: ", 3);
                    var mp[16];
                    if (_reflog_line_msg(buf + s, len - s, &mp) == 1) {
                        var mlen = load64(&mp + 8);
                        var sanmsg = alloc(mlen + 1);
                        _reflog_san_into(sanmsg, load64(&mp), mlen);
                        stdout_write(sanmsg, mlen);
                    }
                    stdout_write("\n", 1);
                    shown = shown + 1;
                }
            }
            d = d + 1;
        }
    }
    stdout_flush();
    return 0;
}

# ── Time specs (1.8.0): `<ref>@{<date>}` and `reflog expire --expire=<when>` ──
#
# All UTC: sit writes every timestamp as `<epoch> +0000`, and has no time-zone
# database to read a local date with. git reads an unzoned date as local time;
# on a UTC host the two agree.

# Days from 1970-01-01 to y-m-d (Gregorian, y >= 1970): Hinnant's
# days_from_civil, positive years only.
fn _reflog_days_from_civil(y, m, d) {
    var yy = y;
    if (m <= 2) { yy = yy - 1; }
    var era = yy / 400;
    var yoe = yy - era * 400;
    var mp = m - 3;
    if (m <= 2) { mp = m + 9; }
    var doy = (153 * mp + 2) / 5 + d - 1;
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

# Days in month m of year y.
fn _reflog_month_days(y, m) {
    if (m == 2) {
        var leap = 0;
        if ((y % 4) == 0) { leap = 1; }
        if ((y % 100) == 0) { leap = 0; }
        if ((y % 400) == 0) { leap = 1; }
        return 28 + leap;
    }
    if (m == 4) { return 30; }
    if (m == 6) { return 30; }
    if (m == 9) { return 30; }
    if (m == 11) { return 30; }
    return 31;
}

# The `n` decimal digits at s, or -1 if any is not a digit.
fn _reflog_fixed_digits(s, n) {
    var v = 0;
    var i = 0;
    var ok = 1;
    while (i < n) {
        var c = load8(s + i) & 0xFF;
        if (c < 48) { ok = 0; }
        if (c > 57) { ok = 0; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (ok == 0) { return 0 - 1; }
    return v;
}

# YYYY-MM-DD[( |T)HH:MM[:SS]] as epoch seconds (UTC), or -1.
fn _reflog_time_absolute(s, len) {
    if (len < 10) { return 0 - 1; }
    if (load8(s + 4) != 45) { return 0 - 1; }
    if (load8(s + 7) != 45) { return 0 - 1; }
    var y = _reflog_fixed_digits(s, 4);
    var m = _reflog_fixed_digits(s + 5, 2);
    var d = _reflog_fixed_digits(s + 8, 2);
    if (y < 1970) { return 0 - 1; }
    if (m < 1) { return 0 - 1; }
    if (m > 12) { return 0 - 1; }
    if (d < 1) { return 0 - 1; }
    if (d > _reflog_month_days(y, m)) { return 0 - 1; }
    var secs = 0;
    if (len > 10) {
        var sep = load8(s + 10);
        var sep_ok = 0;
        if (sep == 32) { sep_ok = 1; }
        if (sep == 84) { sep_ok = 1; }               # 'T'
        if (sep_ok == 0) { return 0 - 1; }
        if (len != 16) { if (len != 19) { return 0 - 1; } }
        if (load8(s + 13) != 58) { return 0 - 1; }
        var hh = _reflog_fixed_digits(s + 11, 2);
        var mi = _reflog_fixed_digits(s + 14, 2);
        var ss = 0;
        if (len == 19) {
            if (load8(s + 16) != 58) { return 0 - 1; }
            ss = _reflog_fixed_digits(s + 17, 2);
        }
        if (hh < 0) { return 0 - 1; }
        if (hh > 23) { return 0 - 1; }
        if (mi < 0) { return 0 - 1; }
        if (mi > 59) { return 0 - 1; }
        if (ss < 0) { return 0 - 1; }
        if (ss > 59) { return 0 - 1; }
        secs = hh * 3600 + mi * 60 + ss;
    }
    return _reflog_days_from_civil(y, m, d) * 86400 + secs;
}

# Seconds in one `unit` (singular or plural word of `ul` bytes), or 0.
fn _reflog_unit_secs(u, ul) {
    var n = ul;
    if (n > 1) { if (load8(u + n - 1) == 115) { n = n - 1; } }   # plural 's'
    if (n == 6) { if (memeq(u, "second", 6) == 1) { return 1; } }
    if (n == 6) { if (memeq(u, "minute", 6) == 1) { return 60; } }
    if (n == 4) { if (memeq(u, "hour", 4) == 1) { return 3600; } }
    if (n == 3) { if (memeq(u, "day", 3) == 1) { return 86400; } }
    if (n == 4) { if (memeq(u, "week", 4) == 1) { return 604800; } }
    if (n == 5) { if (memeq(u, "month", 5) == 1) { return 2592000; } }   # 30 days, as git
    if (n == 4) { if (memeq(u, "year", 4) == 1) { return 31536000; } }   # 365 days
    return 0;
}

# <N>( |.)<unit>[( |.)ago] relative to `now`, or -1.
fn _reflog_time_relative(s, len, now) {
    var i = 0;
    var num = 0;
    var nd = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= len) { scanning = 0; }
        else {
            var c = load8(s + i) & 0xFF;
            if (c < 48) { scanning = 0; }
            else {
                if (c > 57) { scanning = 0; }
                else { num = num * 10 + (c - 48); nd = nd + 1; i = i + 1; }
            }
        }
    }
    if (nd == 0) { return 0 - 1; }
    if (nd > 9) { return 0 - 1; }
    if (i >= len) { return 0 - 1; }
    var sp = load8(s + i);
    if (sp != 32) { if (sp != 46) { return 0 - 1; } }
    i = i + 1;
    var us = i;
    scanning = 1;
    while (scanning == 1) {
        if (i >= len) { scanning = 0; }
        else {
            var c2 = load8(s + i);
            if (c2 == 32) { scanning = 0; }
            else {
                if (c2 == 46) { scanning = 0; }
                else { i = i + 1; }
            }
        }
    }
    var unit = _reflog_unit_secs(s + us, i - us);
    if (unit == 0) { return 0 - 1; }
    if (i < len) {
        # Only "ago" may follow the unit.
        if (len - i != 4) { return 0 - 1; }
        if (memeq(s + i + 1, "ago", 3) == 0) { return 0 - 1; }
    }
    var t = now - num * unit;
    if (t < 0) { t = 0; }
    return t;
}

# Epoch seconds for a time spec of `len` bytes at s, or -1: `now`,
# `yesterday`, `<N> <unit> [ago]` (or dot-separated, as git's `1.week.ago`),
# or `YYYY-MM-DD[ HH:MM[:SS]]`. UTC (see above).
fn reflog_time_parse(s, len, now) {
    if (len == 3) { if (memeq(s, "now", 3) == 1) { return now; } }
    if (len == 9) { if (memeq(s, "yesterday", 9) == 1) { return now - 86400; } }
    if (len >= 10) { if (load8(s + 4) == 45) { return _reflog_time_absolute(s, len); } }
    return _reflog_time_relative(s, len, now);
}

# The timestamp of one log line (`... <email>> <ts> <tz>\t<msg>`), or -1.
fn _reflog_line_ts(line, llen) {
    var t = 0 - 1;
    var i = 0;
    while (i < llen) {
        if (t < 0) { if (load8(line + i) == 9) { t = i; } }
        i = i + 1;
    }
    if (t < 7) { return 0 - 1; }
    if (load8(line + t - 6) != 32) { return 0 - 1; }      # " <ts> " before "+0000"
    var e = t - 6;
    var b = e;
    var scanning = 1;
    while (scanning == 1) {
        if (b <= 0) { scanning = 0; }
        else {
            var c = load8(line + b - 1) & 0xFF;
            if (c < 48) { scanning = 0; }
            else {
                if (c > 57) { scanning = 0; }
                else { b = b - 1; }
            }
        }
    }
    if (b == e) { return 0 - 1; }
    if (e - b > 18) { return 0 - 1; }
    var v = 0;
    var k = b;
    while (k < e) { v = v * 10 + ((load8(line + k) & 0xFF) - 48); k = k + 1; }
    return v;
}

# Resolve `<ref>@{<time>}` within a log buffer: the value the ref had at time
# `t` — the new oid of the newest entry made at or before `t`. Before the first
# entry it is that entry's old oid, or — when the first entry created the ref —
# its new oid, the oldest value known, as git does ("log only goes back to");
# a warning says so. Writes 64 hex + NUL to out; 1 on success, 0 otherwise.
fn _reflog_at_time_in_buf(buf, len, t, out) {
    var starts = _reflog_line_starts(buf, len);
    var n = vec_len(starts);
    if (n == 0) { return 0; }
    var found = 0 - 1;
    var i = n - 1;
    while (i >= 0) {
        if (found < 0) {
            var s = vec_get(starts, i);
            var e = len;
            if (i + 1 < n) { e = vec_get(starts, i + 1); }
            var ts = _reflog_line_ts(buf + s, e - s);
            if (ts >= 0) { if (ts <= t) { found = i; } }
        }
        i = i - 1;
    }
    var off = 65;                                   # the new oid
    var at = 0;
    if (found >= 0) { at = vec_get(starts, found); }
    else { off = 0; }                               # before the log: the old oid
    if (at + 129 > len) { return 0; }
    if (load8(buf + at + 64) != 32) { return 0; }
    if (hex_prefix_valid(buf + at + off, 64) == 0) { return 0; }
    var zero = 1;
    var z = 0;
    while (z < 64) {
        if (load8(buf + at + off + z) != 48) { zero = 0; }
        z = z + 1;
    }
    if (zero == 1) {
        off = 65;
        if (hex_prefix_valid(buf + at + off, 64) == 0) { return 0; }
    }
    if (found < 0) {
        eprintln("sit: warning: the reflog does not go back that far; using its oldest entry");
    }
    memcpy(out, buf + at + off, 64);
    store8(out + 64, 0);
    return 1;
}

# Resolve <ref>@{<time>} for the log at refpath; as reflog_read_nth.
fn reflog_read_at_time(refpath, t, out) {
    var pair[16];
    if (read_file_heap(reflog_log_path(refpath), &pair) != 0) { return 0; }
    return _reflog_at_time_in_buf(load64(&pair), load64(&pair + 8), t, out);
}

# Parse "<base>@{<time>}" (a time spec, not a bare ordinal). On success writes
# the base length to out[0] and the epoch seconds to out[8] and returns 1.
fn _reflog_date_spec_parse(name, now, out) {
    var nlen = strlen(name);
    if (nlen < 4) { return 0; }
    if (load8(name + nlen - 1) != 125) { return 0; }   # '}'
    var at = 0 - 1;
    var i = 0;
    while (i + 1 < nlen) {
        if (at < 0) {
            if (load8(name + i) == 64) { if (load8(name + i + 1) == 123) { at = i; } }
        }
        i = i + 1;
    }
    if (at <= 0) { return 0; }
    var ip = name + at + 2;
    var il = nlen - 1 - (at + 2);
    if (il <= 0) { return 0; }
    var digits = 1;
    var k = 0;
    while (k < il) {
        var c = load8(ip + k) & 0xFF;
        if (c < 48) { digits = 0; }
        if (c > 57) { digits = 0; }
        k = k + 1;
    }
    if (digits == 1) { return 0; }                    # an ordinal: not this form
    var t = reflog_time_parse(ip, il, now);
    if (t < 0) { return 0; }
    store64(out, at);
    store64(out + 8, t);
    return 1;
}

# ── `reflog expire` / `reflog delete` (1.8.0) ──
#
# Both rewrite one log while holding its flock — the lock reflog appends take
# (file_append_locked) — through `<log>.lock` and a rename, so a crash leaves
# the old log or the new one. An append that was waiting on the lock while the
# rewrite ran lands on the replaced file and is lost: one line, never a ref.

# Rewrite the log at `path` (repo-relative) to the lines `keep` marks (one byte
# per line, 1 = keep). Returns the number of lines dropped, or -1.
fn _reflog_write_kept(path, buf, len, starts, keep) {
    var n = vec_len(starts);
    var out = alloc_or_die(len + 1);
    var o = 0;
    var dropped = 0;
    var i = 0;
    while (i < n) {
        var s = vec_get(starts, i);
        var e = len;
        if (i + 1 < n) { e = vec_get(starts, i + 1); }
        if (load8(keep + i) == 1) {
            memcpy(out + o, buf + s, e - s);
            o = o + e - s;
        }
        else { dropped = dropped + 1; }
        i = i + 1;
    }
    if (dropped == 0) { return 0; }
    if (sf_write_atomic(path, out, o) < 0) { return 0 - 1; }
    return dropped;
}

# Open and flock the log at `path`; the fd, or -1 (absent, or not a plain file).
fn _reflog_lock(path) {
    var ap = sit_abs(path);
    if (path_is_regular(ap) == 0) { return 0 - 1; }
    if (path_is_symlink(ap) == 1) { return 0 - 1; }
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0 - 1; }
    file_lock(fd);
    return fd;
}

# Drop the entries of .sit/logs/<refpath> made at or before `cutoff`. Entries
# whose time cannot be read are kept. Returns the number dropped, or -1.
fn _reflog_expire_file(refpath, cutoff) {
    var path = reflog_log_path(refpath);
    var fd = _reflog_lock(path);
    if (fd < 0) { return 0; }                        # no log: nothing to expire
    var pair[16];
    var r = 0 - 1;
    if (read_file_heap(path, &pair) == 0) {
        var buf = load64(&pair);
        var len = load64(&pair + 8);
        var starts = _reflog_line_starts(buf, len);
        var n = vec_len(starts);
        var keep = alloc_or_die(n + 1);
        var i = 0;
        while (i < n) {
            var s = vec_get(starts, i);
            var e = len;
            if (i + 1 < n) { e = vec_get(starts, i + 1); }
            var ts = _reflog_line_ts(buf + s, e - s);
            store8(keep + i, 1);
            if (ts >= 0) { if (ts <= cutoff) { store8(keep + i, 0); } }
            i = i + 1;
        }
        r = _reflog_write_kept(path, buf, len, starts, keep);
    }
    file_unlock(fd);
    file_close(fd);
    return r;
}

# The log refpath a `reflog` ref argument names, or 0 (after saying why).
fn _reflog_arg_refpath(label) {
    if (streq(label, "HEAD") == 1) { return "HEAD"; }
    # S-02: the label becomes a .sit/logs/ path component.
    if (refname_valid(label) == 0) {
        eprint3("sit: invalid ref name '", label, "'\n");
        return 0;
    }
    return _reflog_log_refpath_for(label);
}

# Every log under .sit/logs as a refpath ("HEAD", "refs/heads/x", …).
fn _reflog_all_refpaths() {
    var out = vec_new();
    if (path_lstat_kind(sit_abs(".sit/logs")) != 0x4000) { return out; }
    var root = sit_abs(".sit/logs");
    var rl = strlen(root);
    var files = vec_new();
    dir_walk(str_from(root), files);
    var i = 0;
    while (i < vec_len(files)) {
        var fp = vec_get(files, i);
        var fl = str_len(fp);
        var fd = str_data(fp);
        var take = 1;
        if (fl <= rl + 1) { take = 0; }
        if (take == 1) { if (memeq(fd, root, rl) == 0) { take = 0; } }
        if (take == 1) {
            if (fl >= 5) { if (memeq(fd + fl - 5, ".lock", 5) == 1) { take = 0; } }
        }
        if (take == 1) {
            var rel = alloc_or_die(fl - rl);
            memcpy(rel, fd + rl + 1, fl - rl - 1);
            store8(rel + fl - rl - 1, 0);
            vec_push(out, rel);
        }
        i = i + 1;
    }
    return out;
}

# `sit reflog expire [--expire=<when>] (--all | <ref>...)` — drop old entries.
# The default <when> is 90 days ago (git's gc.reflogExpire), `never` keeps
# everything, `now` drops everything. Objects only the dropped entries kept
# alive become prunable by `sit fsck --prune`.
fn _reflog_cmd_expire() {
    var all = 0;
    var spec = 0;
    var refpaths = vec_new();
    var ai = 3;
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "--all") == 1) { all = 1; }
        else {
            var is_expire = 0;
            if (strlen(a) > 9) { if (memeq(a, "--expire=", 9) == 1) { is_expire = 1; } }
            if (is_expire == 1) { spec = argv_heap(ai) + 9; }
            else {
                if (load8(a) == 45) {
                    eprint3("sit: unknown reflog expire option '", a, "'\n");
                    return 1;
                }
                var rp = _reflog_arg_refpath(argv_heap(ai));
                if (rp == 0) { return 1; }
                vec_push(refpaths, rp);
            }
        }
        ai = ai + 1;
    }
    if (all == 0) {
        if (vec_len(refpaths) == 0) {
            eprintln("usage: sit reflog expire [--expire=<when>] (--all | <ref>...)");
            return 1;
        }
    }
    var now = clock_epoch_secs();
    var cutoff = now - 90 * 86400;
    if (spec != 0) {
        if (streq(spec, "never") == 1) { return 0; }
        var t = reflog_time_parse(spec, strlen(spec), now);
        if (t < 0) {
            eprint3("sit: cannot read the time '", spec, "'\n");
            eprintln("sit:   use now, yesterday, '<N> <unit> ago' or YYYY-MM-DD[ HH:MM[:SS]] (UTC)");
            return 1;
        }
        cutoff = t;
    }
    if (all == 1) { refpaths = _reflog_all_refpaths(); }
    var total = 0;
    var rc = 0;
    var i = 0;
    while (i < vec_len(refpaths)) {
        var r = _reflog_expire_file(vec_get(refpaths, i), cutoff);
        if (r < 0) {
            eprint3("sit: cannot rewrite the reflog for '", vec_get(refpaths, i), "'\n");
            rc = 1;
        }
        else { total = total + r; }
        i = i + 1;
    }
    stdout_write("expired ", 8);
    var nb[24];
    var d = write_decimal(&nb, total);
    stdout_write(&nb, d);
    stdout_write(" reflog entries\n", 16);
    return rc;
}

# `sit reflog delete <ref>@{N}` — remove one entry from that ref's log.
fn _reflog_cmd_delete() {
    if (argc() != 4) {
        eprintln("usage: sit reflog delete <ref>@{N}");
        return 1;
    }
    var spec_s = argv_heap(3);
    var spec[24];
    if (_reflog_spec_parse(spec_s, &spec) == 0) {
        eprint3("sit: '", spec_s, "' is not a <ref>@{N} entry\n");
        return 1;
    }
    var blen = load64(&spec + 8);
    var num = load64(&spec + 16);
    var base = alloc_or_die(blen + 1);
    memcpy(base, spec_s, blen);
    store8(base + blen, 0);
    var refpath = _reflog_arg_refpath(base);
    if (refpath == 0) { return 1; }
    var path = reflog_log_path(refpath);
    var fd = _reflog_lock(path);
    if (fd < 0) {
        eprint3("sit: no reflog for '", base, "'\n");
        return 1;
    }
    var rc = 1;
    var pair[16];
    if (read_file_heap(path, &pair) == 0) {
        var buf = load64(&pair);
        var len = load64(&pair + 8);
        var starts = _reflog_line_starts(buf, len);
        var n = vec_len(starts);
        if (num >= n) {
            eprint3("sit: '", spec_s, "' is past the end of the reflog\n");
        }
        else {
            var keep = alloc_or_die(n + 1);
            var i = 0;
            while (i < n) { store8(keep + i, 1); i = i + 1; }
            store8(keep + (n - 1 - num), 0);
            if (_reflog_write_kept(path, buf, len, starts, keep) == 1) {
                stdout_write("deleted ", 8);
                write_sanitized(STDOUT, spec_s, strlen(spec_s));
                stdout_write("\n", 1);
                rc = 0;
            }
            else { eprintln("sit: cannot rewrite the reflog"); }
        }
    }
    file_unlock(fd);
    file_close(fd);
    return rc;
}

# --- git_read.cyr ---

# git_read.cyr — read-only .git/ backend (roadmap 1.2.0).
#
# Reads an EXISTING git repository (SHA-1 default / SHA-256, loose objects +
# refs; packfiles land in bite 2) through the same readers sit uses for its
# native .sit/ store. Strictly read-only: .git/ is consumed, never mutated —
# sit stays .sit/-native for its own repos. See ADR 0011.
#
# STORAGE SEAM: sit_repo_open() calls _detect_repo_backend() to set the
# process-global `_repo_backend`; the three storage-touching primitives
# (read_object / read_head_ref / resolve_ref_name) dispatch on it. Every layer
# above them (tree walk, diff, status, log) stays storage-agnostic. The only
# format divergence a caller could see is object-id WIDTH — handled centrally
# by _id_hexlen() / _id_rawlen() so the 64-hex / 32-raw literals scattered
# across the read path collapse to two helpers.
#
# One-repo-per-process contract (api.cyr:26-30): the backend is a global, not a
# per-handle field, matching the existing "sit_repo_open chdirs the process"
# model. A future multi-handle API would move these onto a repo struct.

# --- Backend state -----------------------------------------------------------
# _repo_backend: 0 = SIT (.sit/, patra, SHA-256), 1 = GIT (.git/, loose+pack).
# Default 0 so every pre-1.2.0 code path is byte-identical until a .git/ repo
# is opened.
var _repo_backend = 0;
# _git_hash_algo (GIT mode only): 0 = SHA-1 (git default), 1 = SHA-256.
var _git_hash_algo = 0;

# --- Active-backend object-id widths ----------------------------------------
# SIT is always SHA-256 (32 raw / 64 hex). GIT is SHA-1 (20/40) unless the repo
# declares extensions.objectFormat = sha256 (32/64). These two helpers replace
# every hardcoded 64 / 32 in the read path.
fn _id_hexlen() {
    if (_repo_backend == 1) {
        if (_git_hash_algo == 1) { return 64; }
        return 40;
    }
    return 64;
}
fn _id_rawlen() {
    if (_repo_backend == 1) {
        if (_git_hash_algo == 1) { return 32; }
        return 20;
    }
    return 32;
}

# --- .git/config hash-algo detection ----------------------------------------
# SHA-256 git repos carry `[extensions]\n\tobjectFormat = sha256` (and
# repositoryFormatVersion = 1). Best-effort: an unreadable config falls back to
# SHA-1 (git's default), which is correct for the overwhelming majority.
#
# S-25: this used to be a whole-file substring scan for "sha256", justified by
# the claim that "the token appears nowhere else in a normal config". That claim
# is false, and the failure is silent and consumer-visible. ANY occurrence flips
# a SHA-1 repo into 64-hex mode, after which every width gate below rejects and
# `read_head_ref` returns 0 — but `sit_repo_open` still returns 1 and
# `sit_repo_branch` still returns the right name, so `sit_repo_status` reports a
# clean tree as ALL FILES UNTRACKED. owl / thoth get a confident wrong answer
# rather than an error.
#
# The token reaches .git/config through paths an attacker controls, not just
# user typos: a submodule NAME chosen by the attacker's .gitmodules is copied
# verbatim into the superproject's .git/config by `git submodule update --init`,
# and a repository whose own name contains "sha256" lands in the cloned-in
# remote URL. Both are ordinary content in a repo cloned from an untrusted
# remote — the exact threat model `.git/` read-mode exists for.
#
# Fixed by anchoring to the actual `objectFormat` KEY rather than scanning
# values. Section headers (`[submodule "sha256-x"]`) and other keys' values
# (`url = .../sha256-utils.git`) no longer match.

# Skip spaces and tabs from `i`, returning the first other index (or n).
fn _git_skip_ws(p, i, n) {
    var j = i;
    var go = 1;
    while (go == 1) {
        if (j >= n) { go = 0; }
        else {
            var c = load8(p + j) & 0xFF;
            if (c == 32) { j = j + 1; }
            else {
                if (c == 9) { j = j + 1; }
                else { go = 0; }
            }
        }
    }
    return j;
}

# ASCII case-insensitive compare of `litlen` bytes at p+i against a lowercase
# literal. git config keys are case-insensitive.
fn _git_ieq(p, i, n, lit, litlen) {
    if (i + litlen > n) { return 0; }
    var k = 0;
    var ok = 1;
    while (k < litlen) {
        var c = load8(p + i + k) & 0xFF;
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (c != (load8(lit + k) & 0xFF)) { ok = 0; }
        k = k + 1;
    }
    return ok;
}

# Is this config line exactly `objectFormat = sha256` (any spacing / case)?
fn _git_line_is_objectformat_sha256(p, n) {
    var i = _git_skip_ws(p, 0, n);
    if (_git_ieq(p, i, n, "objectformat", 12) == 0) { return 0; }
    i = _git_skip_ws(p, i + 12, n);
    if (i >= n) { return 0; }
    if ((load8(p + i) & 0xFF) != 61) { return 0; }        # '='
    i = _git_skip_ws(p, i + 1, n);
    if (_git_ieq(p, i, n, "sha256", 6) == 0) { return 0; }
    # Nothing but trailing whitespace / CR may follow the value.
    var j = _git_skip_ws(p, i + 6, n);
    while (j < n) {
        if ((load8(p + j) & 0xFF) != 13) { return 0; }
        j = j + 1;
    }
    return 1;
}

fn _git_detect_hash_algo() {
    var pair[16];
    if (read_file_heap(".git/config", &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    var pos = 0;
    var found = 0;
    while (pos < len) {
        var le = pos;
        var scanning = 1;
        while (scanning == 1) {
            if (le >= len) { scanning = 0; }
            else {
                if (load8(buf + le) == 10) { scanning = 0; }
                else { le = le + 1; }
            }
        }
        if (found == 0) {
            if (_git_line_is_objectformat_sha256(buf + pos, le - pos) == 1) { found = 1; }
        }
        pos = le + 1;
    }
    return found;
}

# --- Loose-object path -------------------------------------------------------
# .git/objects/<xx>/<rest> — the id split mirrors object_path()'s .sit layout,
# but the tail is _id_hexlen()-2 chars (38 for SHA-1, 62 for SHA-256) instead
# of a fixed 62. `buf` must hold at least 13 + 2 + 1 + 62 + 1 = 79 bytes.
fn _git_object_path(buf, hex) {
    memcpy(buf, ".git/objects/", 13);
    store8(buf + 13, load8(hex));
    store8(buf + 14, load8(hex + 1));
    store8(buf + 15, 47);
    var rest = _id_hexlen() - 2;
    memcpy(buf + 16, hex + 2, rest);
    store8(buf + 16 + rest, 0);
    return 16 + rest;
}

# --- Loose-object read -------------------------------------------------------
# Reads .git/objects/<xx>/<rest>, zlib-inflates the whole file (git loose
# objects are one RFC-1950 zlib stream of "<type> <len>\0<content>"), and
# writes read_object()'s exact 24-byte out contract:
#   out[0]  = decompressed buffer pointer
#   out[8]  = decompressed length (framing + content)
#   out[16] = content offset (first byte past the framing NUL)
# so every downstream reader (parse_tree, read_blob_content, commit parse) is
# reused unchanged. Decompression is read_object()'s own (obj_inflate_fl,
# 1.7.6), so failure modes line up.
# Returns 0 on success, negative on error.
#
# 1.7.5: the file is read into a freelist buffer freed once it is inflated, and
# its path is built on the stack. read_file_heap kept every compressed object on
# the heap — and the first inflate buffer too when the retry ran — once per
# read, in-process for owl and thoth.
var _GIT_LOOSE_MAX = 67108864;   # read_file_heap's S-06 cap, kept

fn _git_read_loose(hex, out) {
    var path[96];
    _git_object_path(&path, hex);
    var abuf[4352];
    var ap = sit_abs_into(&path, &abuf, 4352);
    if (ap == 0) { return 0 - 1; }
    if (path_is_regular(ap) == 0) { return 0 - 1; }   # 1.7.6 (R11): not a FIFO
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var size = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    syscall(SYS_LSEEK, fd, 0, SEEK_SET);
    if (size < 0) { file_close(fd); return 0 - 1; }
    if (size > _GIT_LOOSE_MAX) { file_close(fd); return 0 - 1; }
    var compressed = fl_alloc(size + 1);
    if (compressed == 0) { file_close(fd); return 0 - 1; }
    var blen = 0;
    var reading = 1;
    while (reading == 1) {
        if (blen >= size) { reading = 0; }
        else {
            var got = file_read(fd, compressed + blen, size - blen);
            if (got <= 0) { reading = 0; }
            else { blen = blen + got; }
        }
    }
    file_close(fd);
    if (blen <= 0) { fl_free(compressed); return 0 - 2; }

    # 1.7.6 (R10): the shared inflate, sized from the object's header.
    var ir = obj_inflate_fl(compressed, blen, out);
    fl_free(compressed);
    if (ir == 0 - 2) { return 0 - 3; }
    if (ir == 0 - 3) { return 0 - 4; }
    if (ir != 0) { return 0 - 5; }
    # The inflated object is the caller's (freelist memory, never freed by
    # read_object's callers, like the pack reader's results since 1.7.4).
    return 0;
}

# --- Backend detection -------------------------------------------------------
# Probe order: .sit/ wins over .git/ so a repo that is somehow both stays
# sit-native (sit never writes .git/). Sets the process-globals and returns the
# selected backend id, or -1 if neither store is present.
fn _detect_repo_backend() {
    if (sf_exists(".sit/HEAD") == 1) {
        _repo_backend = 0;
        _git_hash_algo = 0;
        return 0;
    }
    if (sf_exists(".git/HEAD") == 1) {
        _repo_backend = 1;
        _git_hash_algo = _git_detect_hash_algo();
        return 1;
    }
    return 0 - 1;
}

# --- Ref backend -------------------------------------------------------------
# The active store's 5-char directory prefix. ".sit/" and ".git/" are both
# exactly 5 bytes and the ref/HEAD subpaths are length-identical, so only the
# middle three bytes ever differ — read_head_ref_path builds the HEAD path from
# this, and the git-side ref readers below hardcode ".git/".
fn _repo_dir() {
    if (_repo_backend == 1) { return ".git/"; }
    return ".sit/";
}

# The active backend's ignore-file name. load_sitignore reads this so the
# working-tree walk honours .gitignore on a git repo (top-level only for v1 —
# nested .gitignore / info/exclude / global excludes are not consulted).
fn _ignore_filename() {
    if (_repo_backend == 1) { return ".gitignore"; }
    return ".sitignore";
}

# Read a loose ref file .git/<refpath> as a bare OID. Returns a heap cstring of
# _id_hexlen() hex chars (NUL-terminated) or 0 if the file is absent / not hex.
# Simplification: a loose ref that is itself a "ref: <path>" symref (rare
# outside HEAD) is treated as a miss — HEAD is the only symref sit follows.
fn _git_read_loose_ref(refpath) {
    var rp_len = strlen(refpath);
    var full = alloc(5 + rp_len + 1);
    memcpy(full, ".git/", 5);
    memcpy(full + 5, refpath, rp_len);
    store8(full + 5 + rp_len, 0);
    if (sf_exists(full) != 1) { return 0; }
    var fd = sf_open(full, 0, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(96);
    var n = file_read(fd, buf, 96);
    file_close(fd);
    var hexlen = _id_hexlen();
    if (n < hexlen) { return 0; }
    if (hex_prefix_valid(buf, hexlen) == 0) { return 0; }
    store8(buf + hexlen, 0);
    return buf;
}

# Pure scanner over a packed-refs buffer, split out of
# `_git_packed_ref_lookup` in v1.4.7 so the parse can be fuzzed in-process.
# The lookup reads `.git/packed-refs` itself, which made its parsing
# unreachable from a fuzz harness without writing that file — and the
# harness runs from the repo root, where doing so would clobber a real
# `.git/`. Splitting the buffer walk out is the same move the pack varint
# decoders already had by construction, and it is why they had a target
# while this did not. Contract is unchanged: writes `_id_hexlen()` hex
# chars + NUL into `out_buf` and returns 1 on hit, else 0.
fn _git_packed_ref_scan(buf, len, refname, out_buf) {
    var hexlen = _id_hexlen();
    var rn_len = strlen(refname);

    var pos = 0;
    var result = 0;
    while (pos < len) {
        if (result == 0) {
            var eol = pos;
            while (eol < len) {
                if (load8(buf + eol) == 10) { break; }
                eol = eol + 1;
            }
            var line_len = eol - pos;
            var first = load8(buf + pos);
            # A ref line is exactly "<hexlen hex> <refname>": length matches and
            # a space sits at the OID boundary. '#' (35) and '^' (94) are skipped.
            if (first != 35) {
                if (first != 94) {
                    if (line_len == hexlen + 1 + rn_len) {
                        if (load8(buf + pos + hexlen) == 32) {
                            if (hex_prefix_valid(buf + pos, hexlen) == 1) {
                                if (memeq(buf + pos + hexlen + 1, refname, rn_len) == 1) {
                                    memcpy(out_buf, buf + pos, hexlen);
                                    store8(out_buf + hexlen, 0);
                                    result = 1;
                                }
                            }
                        }
                    }
                }
            }
            pos = eol + 1;
        } else {
            pos = len;
        }
    }
    return result;
}

# Look up a full refname (e.g. "refs/heads/main") in .git/packed-refs. Writes
# _id_hexlen() hex chars + NUL into out_buf and returns 1 on hit, else 0. Lines:
# "<oid> <refname>\n"; '#' header/comment lines and '^' peeled-tag lines are
# skipped (a ref name resolves to its own object, not a tag's peeled target).
fn _git_packed_ref_lookup(refname, out_buf) {
    var pair[16];
    if (read_file_fl(".git/packed-refs", &pair) != 0) { return 0; }
    var r = _git_packed_ref_scan(load64(&pair), load64(&pair + 8), refname, out_buf);
    fl_free(load64(&pair));           # 1.7.6 (R1): read per lookup, kept no longer
    return r;
}

# git-mode read_head_ref: resolve .git/HEAD. Symref → loose ref then packed-refs;
# detached (bare OID in HEAD) → that OID. Returns heap hex cstring or 0.
fn _git_read_head_ref() {
    var ref_path = read_head_ref_path();
    if (ref_path == 0) {
        # Detached HEAD: .git/HEAD holds a bare OID (no "ref: " prefix).
        var pair[16];
        if (read_file_fl(".git/HEAD", &pair) != 0) { return 0; }
        var hb = load64(&pair);
        var hn = load64(&pair + 8);
        var hexlen = _id_hexlen();
        var oid = 0;
        if (hn >= hexlen) {
            if (hex_prefix_valid(hb, hexlen) == 1) {
                oid = alloc(hexlen + 1);
                memcpy(oid, hb, hexlen);
                store8(oid + hexlen, 0);
            }
        }
        fl_free(hb);
        return oid;
    }
    var loose = _git_read_loose_ref(ref_path);
    if (loose != 0) { return loose; }
    var out = alloc(96);
    if (_git_packed_ref_lookup(ref_path, out) == 1) { return out; }
    return 0;
}

# Try a full refname (loose then packed-refs), writing hex+NUL into out_buf.
# Returns 1 on hit, 0 miss.
fn _git_try_full_ref(refname, out_buf) {
    var loose = _git_read_loose_ref(refname);
    if (loose != 0) {
        var hexlen = _id_hexlen();
        memcpy(out_buf, loose, hexlen);
        store8(out_buf + hexlen, 0);
        return 1;
    }
    if (_git_packed_ref_lookup(refname, out_buf) == 1) { return 1; }
    return 0;
}

# git-mode resolve_ref_name: HEAD, then refs/tags|heads|remotes/<name> (loose or
# packed), matching the .sit resolution order. Writes hex+NUL, returns 1/0.
fn _git_resolve_ref_name(name, out_buf) {
    if (streq(name, "HEAD") == 1) {
        var h = read_head_ref();
        if (h == 0) { return 0; }
        var hexlen = _id_hexlen();
        memcpy(out_buf, h, hexlen);
        store8(out_buf + hexlen, 0);
        return 1;
    }

    var name_len = strlen(name);

    var tag_ref = alloc(10 + name_len + 1);
    memcpy(tag_ref, "refs/tags/", 10);
    memcpy(tag_ref + 10, name, name_len);
    store8(tag_ref + 10 + name_len, 0);
    if (_git_try_full_ref(tag_ref, out_buf) == 1) { return 1; }

    var head_ref = alloc(11 + name_len + 1);
    memcpy(head_ref, "refs/heads/", 11);
    memcpy(head_ref + 11, name, name_len);
    store8(head_ref + 11 + name_len, 0);
    if (_git_try_full_ref(head_ref, out_buf) == 1) { return 1; }

    var rem_ref = alloc(13 + name_len + 1);
    memcpy(rem_ref, "refs/remotes/", 13);
    memcpy(rem_ref + 13, name, name_len);
    store8(rem_ref + 13 + name_len, 0);
    if (_git_try_full_ref(rem_ref, out_buf) == 1) { return 1; }

    return 0;
}

# --- git_pack.cyr ---

# git_pack.cyr — read-only git packfile decode (roadmap 1.2.0, bite 2).
#
# Reads objects out of .git/objects/pack/*.{idx,pack}: binary-search the v2
# .idx for an oid -> pack offset, parse the pack v2 object header, inflate
# non-delta objects (sankoch zlib — no new dep), and reconstruct OFS_DELTA /
# REF_DELTA objects via a self-written copy/insert delta interpreter. Byte
# formats per gitformat-pack. Ordered AFTER git_read.cyr (uses _id_hexlen /
# _id_rawlen / _git_read_loose) and BEFORE object_db.cyr (read_object dispatches
# to _git_read_any) so the single-pass dist bundle stays forward-only.
#
# Shifts are written as * / to avoid any dependence on << / >>. All the object
# out-params use read_object's 24-byte contract {content_ptr, content_len,
# content_off}; pack objects carry no loose framing, so content_off is 0.

# Deepest delta chain a read follows: git's own ceiling (pack.depth is capped at
# 4095). 1.7.3 resolved chains by recursion and stopped at 64, so the deeper
# objects of a repo repacked with `--depth=250` (git gc --aggressive's old
# default, and still common advice) read as missing (D6, 1.7.4).
var _PACK_DELTA_MAX_DEPTH = 4095;
# 1.7.6 (R4): the most a single read may produce across its whole delta chain.
# Each step is held to 16 MiB, but 4095 such steps is 64 GiB of work — a 114 KB
# crafted pack took `sit cat-file` 244 s of CPU on 1.7.5. 4 GiB covers a
# `git repack --depth=250` (still common advice) of a blob at sit's 16 MiB
# object ceiling; 1 GiB, the first cut, refused the older revisions of a 12 MB
# file repacked that way, which git reads. Past it the object reads as missing.
var _PACK_CHAIN_MAX_OUT = 4294967296;
# One link of a chain being resolved: the delta object's pack {data, len}, where
# its zlib payload starts, its declared (inflated) size, and (1.10.0) where the
# object itself starts — its key in the delta base cache.
var _PACK_LINK = 40;

# --- delta base cache (1.10.0) ------------------------------------------------
# Objects reconstructed from a pack, by (pack mapping, offset): each step of a
# chain, the base it started from, and the result. A chain read in order — the
# newest version first, as `sit gc` writes and verifies them, as fsck reads them,
# as a clone of a packed repository sends them — then costs one delta per
# object rather than the whole chain. Without it, verifying the 1,600-commit
# fixture's pack (chains up to 50) re-applied 40,000 deltas of ~36 KB. git
# keeps the same (core.deltaBaseCacheLimit, 96 MiB).
#
# Direct-mapped, 32 MiB at most, an entry at most an eighth of that. Copies go
# in and out, so a caller's buffer is always its own. Pack mappings live for
# the process (_git_file_cached), so a key never outlives its pack.
var _DBC_SLOTS = 1024;
var _DBC_SLOT = 40;              # {pack data, offset, buffer, length, type}
var _DBC_LIMIT = 33554432;
var _dbc = 0;
var _dbc_bytes = 0;
var _dbc_evict = 0;

# The cache slot (pack data, offset) maps to, or 0 when the table cannot be made.
fn _dbc_slot(pdata, off) {
    if (_dbc == 0) {
        _dbc = fl_alloc(_DBC_SLOTS * _DBC_SLOT);
        if (_dbc == 0) { return 0; }
        var i = 0;
        while (i < _DBC_SLOTS * _DBC_SLOT) { store64(_dbc + i, 0); i = i + 8; }
    }
    var h = ((pdata >> 4) * 31 + off * 2654435761) & (_DBC_SLOTS - 1);
    return _dbc + h * _DBC_SLOT;
}

# The cached entry for (pack data, offset), or 0.
fn _dbc_get(pdata, off) {
    var s = _dbc_slot(pdata, off);
    if (s == 0) { return 0; }
    if (load64(s + 16) == 0) { return 0; }
    if (load64(s) != pdata) { return 0; }
    if (load64(s + 8) != off) { return 0; }
    return s;
}

# Empty a slot.
fn _dbc_drop(s) {
    if (load64(s + 16) != 0) {
        fl_free(load64(s + 16));
        _dbc_bytes = _dbc_bytes - load64(s + 24);
        store64(s + 16, 0);
    }
    return 0;
}

# Empty the cache. For a caller that rewrites a pack buffer in place (the fuzz
# harness, tests); a mapped pack never changes under its address.
fn _dbc_reset() {
    if (_dbc == 0) { return 0; }
    var i = 0;
    while (i < _DBC_SLOTS) {
        _dbc_drop(_dbc + i * _DBC_SLOT);
        i = i + 1;
    }
    _dbc_bytes = 0;
    return 0;
}

# Drop every cached object read from the pack mapped at `pdata`, before that
# mapping goes away: a later mapping can be given the same address.
fn _dbc_forget(pdata) {
    if (_dbc == 0) { return 0; }
    var i = 0;
    while (i < _DBC_SLOTS) {
        var s = _dbc + i * _DBC_SLOT;
        if (load64(s + 16) != 0) {
            if (load64(s) == pdata) { _dbc_drop(s); }
        }
        i = i + 1;
    }
    return 0;
}

# Keep a copy of `len` bytes at `buf`, the object of pack type `type` at
# (pack data, offset), evicting round-robin to stay under the limit.
fn _dbc_put(pdata, off, buf, len, type) {
    if (type < 1) { return 0; }
    if (len > _DBC_LIMIT / 8) { return 0; }
    var s = _dbc_slot(pdata, off);
    if (s == 0) { return 0; }
    if (load64(s + 16) != 0) {
        if (load64(s) == pdata) { if (load64(s + 8) == off) { return 0; } }
        _dbc_drop(s);
    }
    var guard = 0;
    while (_dbc_bytes + len > _DBC_LIMIT) {
        _dbc_drop(_dbc + _dbc_evict * _DBC_SLOT);
        _dbc_evict = (_dbc_evict + 1) & (_DBC_SLOTS - 1);
        guard = guard + 1;
        if (guard > _DBC_SLOTS) { _dbc_bytes = 0; }
    }
    var copy = fl_alloc(len + 1);
    if (copy == 0) { return 0; }
    _pack_copy(copy, buf, len);
    store64(s, pdata);
    store64(s + 8, off);
    store64(s + 16, copy);
    store64(s + 24, len);
    store64(s + 32, type);
    _dbc_bytes = _dbc_bytes + len;
    return 0;
}

# Reject an absurd object size from a hostile pack header before allocating.
#
# NOTE (v1.3.5): this is not the binding limit in practice. sankoch enforces
# DECOMPRESS_MAX_OUTPUT = 16 MiB inside its deflate decoder, and as of sankoch
# 2.5.10 that ceiling covers stored (uncompressed) blocks too — the one loophole
# that previously let a >16 MiB object through. So a pack object larger than
# 16 MiB now fails closed at the `zlib_decompress` calls below with
# -ERR_OUTPUT_LIMIT rather than reaching this bound. That is a clean read
# failure, never corruption, and huffman-coded blocks over 16 MiB already
# behaved this way. Kept at 256 MiB as the pre-allocation sanity gate it was
# written to be; the effective object ceiling is sankoch's 16 MiB.
var _PACK_MAX_OBJ = 268435456;   # 256 MiB
# Largest object a delta may reconstruct — the 16 MiB ceiling read_object
# enforces everywhere else (D5, 1.6.4).
var _DELTA_MAX_RESULT = 16777216;

# --- big-endian readers ------------------------------------------------------
fn _be32(p) {
    var v = load8(p) & 0xFF;
    v = v * 256 + (load8(p + 1) & 0xFF);
    v = v * 256 + (load8(p + 2) & 0xFF);
    v = v * 256 + (load8(p + 3) & 0xFF);
    return v;
}
fn _be64(p) {
    var v = load8(p) & 0xFF;
    var i = 1;
    while (i < 8) {
        v = v * 256 + (load8(p + i) & 0xFF);
        i = i + 1;
    }
    return v;
}

# Lexicographic compare of n bytes. <0 / 0 / >0 (sign of first differing byte).
fn _memcmp_n(a, b, n) {
    var i = 0;
    var result = 0;
    while (i < n) {
        if (result == 0) {
            var av = load8(a + i) & 0xFF;
            var bv = load8(b + i) & 0xFF;
            if (av != bv) { result = av - bv; }
        }
        i = i + 1;
    }
    return result;
}

# Read one byte at the cursor and advance it. Callers MUST have already checked
# that the byte is in bounds — every call site below pre-validates the whole
# run of bytes an opcode needs (see `_delta_op_bytes`), so this stays branchless.
fn _next_byte(data, curptr) {
    var b = load8(data + load64(curptr)) & 0xFF;
    store64(curptr, load64(curptr) + 1);
    return b;
}

# Number of trailing operand bytes a delta COPY opcode encodes: one per set bit
# in the low 7 bits (4 offset bytes, 3 size bytes). Used to bounds-check the
# whole operand run before `_next_byte` consumes any of it.
fn _delta_op_bytes(op) {
    var n = 0;
    if ((op & 0x01) != 0) { n = n + 1; }
    if ((op & 0x02) != 0) { n = n + 1; }
    if ((op & 0x04) != 0) { n = n + 1; }
    if ((op & 0x08) != 0) { n = n + 1; }
    if ((op & 0x10) != 0) { n = n + 1; }
    if ((op & 0x20) != 0) { n = n + 1; }
    if ((op & 0x40) != 0) { n = n + 1; }
    return n;
}

# Max continuation bytes any pack varint may carry. git's size/offset varints
# are 7 bits per byte, so 10 bytes covers the full i64 range; anything longer is
# a hostile encoding padded to overflow the accumulator.
var _PACK_VARINT_MAX = 10;

# --- .idx v2 lookup ----------------------------------------------------------
# Binary-search idx_path (v2) for oid_raw (rawlen bytes) -> pack byte offset.
# Returns the offset (>= 12) on hit, or -1 (miss / unreadable / v1 idx / bad
# magic). rawlen is 20 (SHA-1) or 32 (SHA-256).
fn _git_idx_lookup(idx_path, oid_raw, rawlen) {
    var pr[16];
    if (_git_file_cached(idx_path, &pr) != 0) { return 0 - 1; }
    var d = load64(&pr);
    var len = load64(&pr + 8);
    if (len < 1032) { return 0 - 1; }
    # magic 0xFF 't' 'O' 'c'; absence => v1 idx (unsupported here).
    if ((load8(d) & 0xFF) != 255) { return 0 - 1; }
    if ((load8(d + 1) & 0xFF) != 116) { return 0 - 1; }
    if ((load8(d + 2) & 0xFF) != 79) { return 0 - 1; }
    if ((load8(d + 3) & 0xFF) != 99) { return 0 - 1; }
    if (_be32(d + 4) != 2) { return 0 - 1; }

    var fanout = d + 8;
    var N = _be32(fanout + 255 * 4);
    # S-24: N and the fanout bounds are all attacker-supplied. Every table
    # address below is derived from them, so validate against the actual file
    # length before any of them becomes a load address. Without this a crafted
    # .idx whose fanout claims ~1e9 entries drove `oid_table + mid * rawlen`
    # gigabytes past the mapping — a reproducible SIGSEGV on `sit cat-file`
    # against a hostile repo, and an out-of-bounds read at milder offsets.
    if (N < 0) { return 0 - 1; }
    if (rawlen <= 0) { return 0 - 1; }
    # oids + CRCs + short offsets must all fit: 1032 + N*(rawlen + 4 + 4).
    if (N > (len - 1032) / (rawlen + 8)) { return 0 - 1; }

    var b0 = load8(oid_raw) & 0xFF;
    var lo = 0;
    if (b0 != 0) { lo = _be32(fanout + (b0 - 1) * 4); }
    var hi = _be32(fanout + b0 * 4);
    # The fanout is cumulative and must be monotonic within [0, N].
    if (lo < 0) { return 0 - 1; }
    if (hi > N) { return 0 - 1; }
    if (lo > hi) { return 0 - 1; }
    var oid_table = d + 1032;

    var mid = 0;
    var found = 0 - 1;
    while (lo < hi) {
        if (found < 0) {
            mid = (lo + hi) / 2;
            var cmp = _memcmp_n(oid_table + mid * rawlen, oid_raw, rawlen);
            if (cmp == 0) { found = mid; lo = hi; }
            else {
                if (cmp < 0) { lo = mid + 1; }
                else { hi = mid; }
            }
        }
        else { lo = hi; }
    }
    if (found < 0) { return 0 - 1; }

    var off_table = oid_table + N * rawlen + N * 4;   # skip oids + CRCs
    var off32 = _be32(off_table + found * 4);
    if ((off32 & 2147483648) == 0) { return off32; }
    # Large-offset (>2 GiB) entry: the 8-byte table sits after the 4-byte one,
    # and is NOT covered by the size gate above — bound it against `len` here.
    var large_table = off_table + N * 4;
    var idx2 = off32 & 2147483647;
    var large_off = 1032 + N * (rawlen + 8) + idx2 * 8;
    if (large_off < 0) { return 0 - 1; }
    if (large_off + 8 > len) { return 0 - 1; }
    return _be64(large_table + idx2 * 8);
}

# --- .idx / .pack load (cached per path) ------------------------------------
# Every .idx and .pack is read ONCE per process and kept.
#
# 1.6.4 (D3): only the most recent pack was cached, and every object lookup
# re-read every .idx in full. sit's heap is a bump allocator that never frees,
# so memory grew as (objects read) x (total idx size): sit_repo_status — which
# reads every tracked blob — peaked at 263 MB on a 3,000-file repo and 4 GB on
# 12,000 files, and owl / thoth run it in-process. Two packs read alternately
# re-read both on every switch the same way. Now each file costs its size once.
#
# 1.7.4 (D6): each file is mapped read-only rather than copied onto the heap.
# read_file_heap refuses anything over 64 MiB (S-06), so a larger pack — or the
# .idx of a repo with a few million objects — read as absent, and every object in
# it as missing: sit_repo_status then called a clean file modified or untracked.
# A mapping costs no heap at any size; the kernel pages it in as objects are read.
# Where mmap is unavailable (agnos), or refused, the file is read as before.
# Like git, which maps its packs too, this assumes a pack is never truncated in
# place (git writes a new one and renames it); reading past a truncation faults.
var _git_file_cache = 0;

# Map `path` read-only into out_pair {addr, len}. 0, or -1 when it cannot be
# opened, is empty, or mmap refuses.
#
# 1.7.6: -1 when it cannot be opened (or is not a regular file — a FIFO
# blocked the open forever, R11), -2 when it opened but mmap refused, which is
# the only case _git_file_cached falls back to reading. The joined path is on
# the stack (R14): sit_abs kept ~320 B on the heap per lookup of an .idx that
# cannot be opened, since failures are not cached.
fn _git_file_map(path, out_pair) {
    var abuf[4352];
    var ap = sit_abs_into(path, &abuf, 4352);
    if (ap == 0) { return 0 - 1; }
    if (path_is_regular(ap) == 0) { return 0 - 1; }
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var size = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    if (size <= 0) { file_close(fd); return 0 - 1; }
    var addr = mmap_file_ro(fd, size);
    file_close(fd);                                # the mapping outlives the fd
    if (addr == 0) { return 0 - 2; }
    store64(out_pair, addr);
    store64(out_pair + 8, size);
    return 0;
}

# 1.11.0 (R6): keyed by the path resolved through the repository root, not the
# repo-relative one. Two repositories opened in one process (the read API, sit
# serve --repos) each have a `.git/objects/pack/pack-<x>.idx`, and git names a
# pack by its object list, so two different packs can share a name: the second
# repository read the first one's bytes at the second one's offsets. A cell is
# {addr, len, 1 when mapped}: a read-in copy (no mmap) cannot be unmapped.
fn _git_file_cached(path, out_pair) {
    if (_git_file_cache == 0) { _git_file_cache = map_new(); }
    var kbuf[4352];
    var kpath = sit_abs_into(path, &kbuf, 4352);
    if (kpath == 0) { return 0 - 1; }
    var hit = map_get(_git_file_cache, kpath);
    if (hit != 0) {
        store64(out_pair, load64(hit));
        store64(out_pair + 8, load64(hit + 8));
        return 0;
    }
    var pr[16];
    var mapped = 1;
    var mr = _git_file_map(path, &pr);
    if (mr == 0 - 1) { return 0 - 1; }
    if (mr != 0) {
        if (read_file_heap(path, &pr) != 0) { return 0 - 1; }
        mapped = 0;
    }
    var cell = alloc_or_die(24);
    store64(cell, load64(&pr));
    store64(cell + 8, load64(&pr + 8));
    store64(cell + 16, mapped);
    var pl = strlen(kpath);
    var key = alloc_or_die(pl + 1);
    memcpy(key, kpath, pl);
    store8(key + pl, 0);
    map_set(_git_file_cache, key, cell);
    store64(out_pair, load64(cell));
    store64(out_pair + 8, load64(cell + 8));
    return 0;
}

# Unmap every cached .idx / .pack whose file is gone (1.11.0, R6), and drop the
# delta base cache's entries from it: a store session after a gc, or a git gc
# under a long-lived reader. Mappings otherwise live for the process, and each
# gc would leave its predecessors' mapped for good.
fn _git_file_forget_missing() {
    if (_git_file_cache == 0) { return 0; }
    var keys = map_keys(_git_file_cache);
    var n = vec_len(keys);
    var i = 0;
    while (i < n) {
        var k = vec_get(keys, i);
        if (path_lstat_kind(k) < 0) {
            var cell = map_get(_git_file_cache, k);
            if (cell != 0) {
                _dbc_forget(load64(cell));
                if (load64(cell + 16) == 1) { cyr_munmap(load64(cell), load64(cell + 8)); }
            }
            map_delete(_git_file_cache, k);
        }
        i = i + 1;
    }
    return 0;
}

fn _git_load_pack(path, out_pair) {
    return _git_file_cached(path, out_pair);
}

# --- varint decoders (cursor is an i64 slot, advanced in place) --------------
# Pack object header: byte0 = [cont|3-bit type|4-bit size-low]; continuation
# bytes add 7 bits each (little-endian). Writes type to out_type, returns size.
# S-24: `limit` is the length of `data`. A hostile pack can set the continuation
# bit on its final byte, so every one of these fails closed (returns a negative
# sentinel) on overrun rather than walking off the buffer. They also cap the
# continuation run at `_PACK_VARINT_MAX` and reject a wrapped accumulator, so a
# padded varint can't overflow `size` negative and slip past the `> _PACK_MAX_OBJ`
# gate. Callers MUST check the sentinel before using the result.
fn _pack_obj_header(data, curptr, out_type, limit) {
    if (load64(curptr) < 0) { return 0 - 1; }
    if (load64(curptr) >= limit) { return 0 - 1; }
    var c = load8(data + load64(curptr)) & 0xFF;
    store64(curptr, load64(curptr) + 1);
    var type = (c / 16) & 7;
    var size = c & 0x0F;
    var mult = 16;
    var cont = c & 0x80;
    var used = 0;
    var bad = 0;
    while (cont != 0) {
        if (load64(curptr) >= limit) { cont = 0; bad = 1; }
        else {
            if (used >= _PACK_VARINT_MAX) { cont = 0; bad = 1; }
            else {
                var b = load8(data + load64(curptr)) & 0xFF;
                store64(curptr, load64(curptr) + 1);
                used = used + 1;
                size = size + (b & 0x7F) * mult;
                mult = mult * 128;
                cont = b & 0x80;
            }
        }
    }
    if (bad != 0) { return 0 - 1; }
    if (size < 0) { return 0 - 1; }
    store64(out_type, type);
    return size;
}

# OFS_DELTA base-offset varint (the ((ofs+1)<<7)|next biased big-endian scheme).
fn _ofs_varint(data, curptr, limit) {
    if (load64(curptr) < 0) { return 0 - 1; }
    if (load64(curptr) >= limit) { return 0 - 1; }
    var b = load8(data + load64(curptr)) & 0xFF;
    store64(curptr, load64(curptr) + 1);
    var ofs = b & 0x7F;
    var cont = b & 0x80;
    var used = 0;
    var bad = 0;
    while (cont != 0) {
        if (load64(curptr) >= limit) { cont = 0; bad = 1; }
        else {
            if (used >= _PACK_VARINT_MAX) { cont = 0; bad = 1; }
            else {
                b = load8(data + load64(curptr)) & 0xFF;
                store64(curptr, load64(curptr) + 1);
                used = used + 1;
                ofs = (ofs + 1) * 128 + (b & 0x7F);
                cont = b & 0x80;
            }
        }
    }
    if (bad != 0) { return 0 - 1; }
    if (ofs < 0) { return 0 - 1; }
    return ofs;
}

# Delta size varint: pure 7-bit little-endian chunks from byte 0.
fn _delta_varint(data, curptr, limit) {
    var val = 0;
    var mult = 1;
    var cont = 1;
    var used = 0;
    var bad = 0;
    while (cont != 0) {
        if (load64(curptr) >= limit) { cont = 0; bad = 1; }
        else {
            if (used >= _PACK_VARINT_MAX) { cont = 0; bad = 1; }
            else {
                var b = load8(data + load64(curptr)) & 0xFF;
                store64(curptr, load64(curptr) + 1);
                used = used + 1;
                val = val + (b & 0x7F) * mult;
                mult = mult * 128;
                cont = b & 0x80;
            }
        }
    }
    if (bad != 0) { return 0 - 1; }
    if (val < 0) { return 0 - 1; }
    return val;
}

# --- delta apply -------------------------------------------------------------
# The result size a delta declares, once its header checks out against the base
# it is applied to; -1 otherwise. `cur` (an i64 slot) is left at the first
# instruction.
fn _git_delta_header(base_len, delta, delta_len, cur) {
    store64(cur, 0);
    if (base_len < 0) { return 0 - 1; }
    if (delta_len <= 0) { return 0 - 1; }
    # 1.6.4 (D10): git's patch_delta rejects a delta whose declared base size is
    # not the base it is applied to; this read the field and discarded it, so a
    # delta against the wrong base reconstructed wrong content whenever its
    # copies happened to fit.
    var declared_base = _delta_varint(delta, cur, delta_len);
    if (declared_base < 0) { return 0 - 1; }
    if (declared_base != base_len) { return 0 - 1; }
    var result_size = _delta_varint(delta, cur, delta_len);
    if (result_size <= 0) { return 0 - 1; }
    # 1.6.4 (D5): held to the same 16 MiB object ceiling as every other read.
    # The 256 MiB pack-entry cap let a small hostile delta make an in-process
    # consumer allocate and fill 256 MiB per chain level.
    if (result_size > _DELTA_MAX_RESULT) { return 0 - 1; }
    return result_size;
}

# Reconstruct a target object from base + delta instruction stream. Writes the
# read_object contract into out24 (content_off 0), in a freelist buffer the
# caller owns. Returns 0 or negative.
fn _git_apply_delta(base, base_len, delta, delta_len, out24) {
    var cur[8];
    var result_size = _git_delta_header(base_len, delta, delta_len, &cur);
    if (result_size < 0) { return 0 - 1; }
    var out = fl_alloc(result_size);
    if (out == 0) { return 0 - 2; }
    var r = _git_apply_delta_into(base, base_len, delta, delta_len, out, result_size);
    if (r < 0) { fl_free(out); return r; }
    store64(out24, out);
    store64(out24 + 8, r);
    store64(out24 + 16, 0);
    return 0;
}

# Copy `n` bytes, eight at a time (1.7.6, R4). Delta copy ops go through this:
# stdlib memcpy is a byte loop (~140 MB/s), which made a deep chain of large
# results cost minutes. The source (a base or a delta) never overlaps `dst`.
fn _pack_copy(dst, src, n) {
    var i = 0;
    var w = n - 7;
    while (i < w) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    while (i < n) {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
    return dst;
}

# _git_apply_delta into a caller's buffer of `out_cap` bytes. Returns the result
# length, or negative: -1 a bad header, -2 `out_cap` below the declared size,
# -3..-9 a bad instruction. 1.7.4 (D6): split out so a delta chain reuses two
# buffers for all its steps rather than allocating one per step.
fn _git_apply_delta_into(base, base_len, delta, delta_len, out, out_cap) {
    # S-24: `base` / `delta` are both attacker-controlled in a hostile repo, so
    # validate the pair before touching either.
    if (base == 0) { return 0 - 1; }
    var cur[8];
    var result_size = _git_delta_header(base_len, delta, delta_len, &cur);
    if (result_size < 0) { return 0 - 1; }
    if (out == 0) { return 0 - 2; }
    if (out_cap < result_size) { return 0 - 2; }
    var op_out = 0;
    var err = 0;
    while (load64(&cur) < delta_len) {
        if (err == 0) {
            var op = load8(delta + load64(&cur)) & 0xFF;
            store64(&cur, load64(&cur) + 1);
            if ((op & 0x80) != 0) {
                # S-24: the operand run must be fully in bounds before
                # `_next_byte` consumes any of it — a COPY opcode in the final
                # bytes of the delta would otherwise read past `delta_len`.
                if (load64(&cur) + _delta_op_bytes(op) > delta_len) { err = 0 - 8; }
                else {
                    var coff = 0;
                    var csize = 0;
                    if ((op & 0x01) != 0) { coff = coff + _next_byte(delta, &cur); }
                    if ((op & 0x02) != 0) { coff = coff + _next_byte(delta, &cur) * 256; }
                    if ((op & 0x04) != 0) { coff = coff + _next_byte(delta, &cur) * 65536; }
                    if ((op & 0x08) != 0) { coff = coff + _next_byte(delta, &cur) * 16777216; }
                    if ((op & 0x10) != 0) { csize = csize + _next_byte(delta, &cur); }
                    if ((op & 0x20) != 0) { csize = csize + _next_byte(delta, &cur) * 256; }
                    if ((op & 0x40) != 0) { csize = csize + _next_byte(delta, &cur) * 65536; }
                    if (csize == 0) { csize = 65536; }
                    if (coff + csize > base_len) { err = 0 - 3; }
                    else {
                        if (op_out + csize > result_size) { err = 0 - 4; }
                        else {
                            _pack_copy(out + op_out, base + coff, csize);
                            op_out = op_out + csize;
                        }
                    }
                }
            }
            else {
                if (op != 0) {
                    var lit = op & 0x7F;
                    # S-24: bound the literal against the DELTA (source) as well
                    # as the result buffer (destination). Only the destination
                    # was checked before, so a literal opcode declaring more
                    # bytes than the delta has left copied up to 127 bytes of
                    # adjacent heap into the reconstructed object — readable by
                    # the user via `sit cat-file`.
                    if (load64(&cur) + lit > delta_len) { err = 0 - 9; }
                    else {
                        if (op_out + lit > result_size) { err = 0 - 5; }
                        else {
                            memcpy(out + op_out, delta + load64(&cur), lit);
                            store64(&cur, load64(&cur) + lit);
                            op_out = op_out + lit;
                        }
                    }
                }
                else { err = 0 - 6; }
            }
        }
        else { store64(&cur, delta_len); }
    }
    if (err != 0) { return err; }
    if (op_out != result_size) { return 0 - 7; }
    return result_size;
}

# --- pack object reconstruct -------------------------------------------------
# Reconstruct the object at `offset` in the in-memory pack {pdata,plen}. Writes
# read_object contract into out24 (content_off 0).
#
# 1.7.4 (D6): iterative. The chain is walked down to its base first, recording
# each delta it passes (an OFS_DELTA steps back in the same pack; a REF_DELTA
# names its base by id, which may be loose or in another pack). Then the deltas
# are applied from the base upward. Every intermediate base and delta buffer is
# freed once the next step has used it, so a read keeps only its result: the
# recursion this replaces kept every level of every chain on the bump heap, which
# owl and thoth pay in-process for each blob sit_repo_status reads.
#
# The chain is bounded at _PACK_DELTA_MAX_DEPTH links. An OFS_DELTA chain cannot
# loop (each base lies strictly before its delta); a REF_DELTA cycle stops there.
# Each step's result is held to 16 MiB (D5), so the worst a hostile chain costs is
# 4095 such steps, the bound git itself accepts.

# Write `n` raw bytes as lowercase hex into `out` (2n bytes + NUL).
fn _hex_into(raw, n, out) {
    var digits = "0123456789abcdef";
    var i = 0;
    while (i < n) {
        var b = load8(raw + i) & 0xFF;
        store8(out + i * 2, load8(digits + b / 16));
        store8(out + i * 2 + 1, load8(digits + (b & 15)));
        i = i + 1;
    }
    store8(out + n * 2, 0);
    return 0;
}

# Inflate `size` declared bytes at `body` of {pdata,plen} into a fresh freelist
# buffer. Returns the buffer and stores the inflated length at `out_len`, or 0.
fn _pack_inflate(pdata, plen, body, size, out_len) {
    # S-24: a header that consumed the whole buffer leaves body == plen, making
    # `plen - body` zero or negative — never hand that to the decompressor.
    if (body >= plen) { return 0; }
    var buf = fl_alloc(size + 16);
    if (buf == 0) { return 0; }
    var got = zlib_decompress_with_ratio_cap(pdata + body, plen - body,
      buf, size + 16, SIT_MAX_INFLATE_RATIO);
    # 1.7.6 (R3): errors are negative; 0 bytes is a valid inflate (an empty
    # file — `__init__.py`, `.gitkeep` — packs to exactly that), and was read
    # as a failure, so every empty blob in a gc'd repo was unreadable. git
    # requires the result to be the size the header declared; so does this.
    if (got < 0) { fl_free(buf); return 0; }
    if (got != size) { fl_free(buf); return 0; }
    store64(out_len, got);
    return buf;
}

fn _git_pack_obj(pdata, plen, offset, out24) {
    return _pack_obj_ex(pdata, plen, offset, out24, 0, 1);
}

# _git_pack_obj, also reporting the object's pack type (1 commit, 2 tree,
# 3 blob, 4 tag: its base's, through any chain) at `type_out` when that is not
# 0. 1.10.0: `allow_ref` 0 refuses a REF_DELTA — sit's own packs (`sit gc`)
# carry OFS_DELTA only, and a REF_DELTA there would resolve its base through
# `.git/` — so a sit pack is always self-contained.
fn _pack_obj_ex(pdata, plen, offset, out24, type_out, allow_ref) {
    var links_cap = 16;
    var links = fl_alloc(links_cap * _PACK_LINK);
    if (links == 0) { return 0 - 11; }
    var nlinks = 0;
    var cp = pdata;
    var cl = plen;
    var co = offset;
    var base = 0;            # the base's bytes once found
    var base_len = 0;
    var base_owned = 0;      # 1 when `base` is a freelist buffer this read made
    var loose_buf = 0;       # a loose base's own buffer, freed when the chain is done
    var base_type = 0;       # the chain's pack type; 0 for a loose base (not cached)
    var base_fresh = 0;      # 1 when the base was inflated here (and so worth caching)
    var rc = 0;
    var walking = 1;
    while (walking == 1) {
        # S-24: `co` comes from the .idx offset table (attacker-supplied, up to
        # 2^63 via the large-offset table) or an OFS_DELTA back-reference. The
        # pack v2 header is 12 bytes, so any real object starts at >= 12.
        if (cp == 0) { rc = 0 - 10; }
        if (rc == 0) { if (co < 12) { rc = 0 - 10; } }
        if (rc == 0) { if (co >= cl) { rc = 0 - 10; } }
        if (rc == 0) {
            # 1.10.0: an object reconstructed already ends the walk here.
            var hit = _dbc_get(cp, co);
            if (hit != 0) {
                base = load64(hit + 16);
                base_len = load64(hit + 24);
                base_owned = 0;
                base_type = load64(hit + 32);
                if (type_out != 0) { store64(type_out, base_type); }
                walking = 0;
            }
        }
        var cur[8];
        var type_slot[8];
        var size = 0;
        var type = 0;
        var reading = 0;
        if (rc == 0) { reading = walking; }
        if (reading == 1) {
            store64(&cur, co);
            store64(&type_slot, 0);
            size = _pack_obj_header(cp, &cur, &type_slot, cl);
            if (size < 0) { rc = 0 - 10; }
            if (size > _PACK_MAX_OBJ) { rc = 0 - 10; }
            type = load64(&type_slot);
        }
        if (rc == 0) {
            if (reading == 1) {
                if (type >= 1) {
                    if (type <= 4) {
                        if (type_out != 0) { store64(type_out, type); }
                        var got[8];
                        base = _pack_inflate(cp, cl, load64(&cur), size, &got);
                        if (base == 0) { rc = 0 - 12; }
                        else {
                            base_len = load64(&got);
                            base_owned = 1;
                            base_type = type;
                            base_fresh = 1;
                        }
                        walking = 0;
                    }
                }
            }
        }
        if (rc == 0) {
            if (walking == 1) {
                if (type != 6) { if (type != 7) { rc = 0 - 21; } }
                if (type == 7) { if (allow_ref == 0) { rc = 0 - 21; } }
                if (rc == 0) { if (nlinks >= _PACK_DELTA_MAX_DEPTH) { rc = 0 - 13; } }
            }
        }
        if (rc == 0) {
            if (walking == 1) {
                if (nlinks >= links_cap) {
                    var grown = fl_alloc(links_cap * 2 * _PACK_LINK);
                    if (grown == 0) { rc = 0 - 11; }
                    else {
                        memcpy(grown, links, nlinks * _PACK_LINK);
                        fl_free(links);
                        links = grown;
                        links_cap = links_cap * 2;
                    }
                }
            }
        }
        if (rc == 0) {
            if (walking == 1) {
                if (type == 6) {
                    var ofs = _ofs_varint(cp, &cur, cl);
                    # S-24: a zero-distance back-reference would make the object its
                    # own base.
                    if (ofs <= 0) { rc = 0 - 14; }
                    if (rc == 0) { if (co - ofs < 0) { rc = 0 - 14; } }
                    if (rc == 0) {
                        var lk = links + nlinks * _PACK_LINK;
                        store64(lk, cp);
                        store64(lk + 8, cl);
                        store64(lk + 16, load64(&cur));
                        store64(lk + 24, size);
                        store64(lk + 32, co);
                        nlinks = nlinks + 1;
                        co = co - ofs;
                    }
                }
                else {
                    # REF_DELTA: the base id is `rawlen` raw bytes at the cursor.
                    var rawlen = _id_rawlen();
                    # S-24: bound the whole run before it is read.
                    if (load64(&cur) + rawlen > cl) { rc = 0 - 18; }
                    var base_hex[72];
                    if (rc == 0) {
                        _hex_into(cp + load64(&cur), rawlen, &base_hex);
                        var lk2 = links + nlinks * _PACK_LINK;
                        store64(lk2, cp);
                        store64(lk2 + 8, cl);
                        store64(lk2 + 16, load64(&cur) + rawlen);
                        store64(lk2 + 24, size);
                        store64(lk2 + 32, co);
                        nlinks = nlinks + 1;
                        var loose24[24];
                        if (_git_read_loose(&base_hex, &loose24) == 0) {
                            # A loose base carries its framing; step past it.
                            # 1.7.6 (R5): the buffer is the loose reader's
                            # freelist allocation, handed to this read — it was
                            # never freed, so a 4 MiB loose base was kept on
                            # every read through it.
                            loose_buf = load64(&loose24);
                            base = load64(&loose24) + load64(&loose24 + 16);
                            base_len = load64(&loose24 + 8) - load64(&loose24 + 16);
                            if (base_len < 0) { rc = 0 - 18; }
                            walking = 0;
                        }
                        else {
                            var loc[24];
                            if (_git_pack_locate(&base_hex, &loc) != 0) { rc = 0 - 18; }
                            else {
                                cp = load64(&loc);
                                cl = load64(&loc + 8);
                                co = load64(&loc + 16);
                            }
                        }
                    }
                }
            }
        }
        if (rc != 0) { walking = 0; }
    }
    # Apply the deltas from the base upward: the last link recorded is the one
    # nearest the base. Two result buffers take turns as each step's base and
    # output, and one holds the inflated delta. Each is replaced only when a step
    # needs more room, so a chain costs a few allocations however deep it is:
    # one per step measured 28% slower, every buffer over 4 KiB being its own
    # mapping.
    var base_cap = base_len;           # an inflated base's buffer is reusable
    if (rc == 0) {
        if (nlinks > 0) {
            if (base_fresh == 1) { _dbc_put(cp, co, base, base_len, base_type); }
        }
    }
    var other = 0;
    var other_cap = 0;
    var dbuf = 0;
    var dcap = 0;
    var chain_out = 0;
    var li = nlinks - 1;
    while (li >= 0) {
        if (rc == 0) {
            var l = links + li * _PACK_LINK;
            var lp = load64(l);
            var lplen = load64(l + 8);
            var body = load64(l + 16);
            var need = load64(l + 24) + 16;
            if (body >= lplen) { rc = 0 - 17; }  # S-24: never a non-positive inflate length
            if (rc == 0) {
                if (dcap < need) {
                    if (dbuf != 0) { fl_free(dbuf); }
                    dbuf = fl_alloc(need);
                    dcap = need;
                    if (dbuf == 0) { dcap = 0; rc = 0 - 17; }
                }
            }
            var dlen = 0;
            if (rc == 0) {
                dlen = zlib_decompress_with_ratio_cap(lp + body, lplen - body, dbuf, need,
                  SIT_MAX_INFLATE_RATIO);
                if (dlen <= 0) { rc = 0 - 17; }
            }
            var hcur[8];
            var rsize = 0;
            if (rc == 0) {
                rsize = _git_delta_header(base_len, dbuf, dlen, &hcur);
                if (rsize < 0) { rc = 0 - 1; }
            }
            if (rc == 0) {
                if (other_cap < rsize) {
                    if (other != 0) { fl_free(other); }
                    other = fl_alloc(rsize);
                    other_cap = rsize;
                    if (other == 0) { other_cap = 0; rc = 0 - 2; }
                }
            }
            if (rc == 0) {
                var ar = _git_apply_delta_into(base, base_len, dbuf, dlen, other, other_cap);
                if (ar >= 0) {
                    chain_out = chain_out + ar;
                    if (chain_out > _PACK_CHAIN_MAX_OUT) { ar = 0 - 19; }
                }
                if (ar < 0) { rc = ar; }
                else {
                    # The output becomes the next base; the old base's buffer, if
                    # it is this read's, becomes the next output.
                    var prev = base;
                    var prev_cap = base_cap;
                    var prev_owned = base_owned;
                    base = other;
                    base_len = ar;
                    base_cap = other_cap;
                    base_owned = 1;
                    other = 0;
                    other_cap = 0;
                    if (prev_owned == 1) { other = prev; other_cap = prev_cap; }
                    _dbc_put(lp, load64(l + 32), base, base_len, base_type);
                }
            }
        }
        li = li - 1;
    }
    if (dbuf != 0) { fl_free(dbuf); }
    if (other != 0) { fl_free(other); }
    if (loose_buf != 0) { fl_free(loose_buf); }      # never `base` by now (R5)
    fl_free(links);
    if (rc != 0) {
        if (base_owned == 1) { fl_free(base); }
        return rc;
    }
    # The result is the caller's. (A loose base is only reached through a link,
    # so by now at least one delta has been applied and `base` is this read's.)
    # A cached object asked for itself is copied out of the cache.
    if (base_owned == 0) {
        var own = fl_alloc(base_len + 1);
        if (own == 0) { return 0 - 11; }
        _pack_copy(own, base, base_len);
        base = own;
    }
    store64(out24, base);
    store64(out24 + 8, base_len);
    store64(out24 + 16, 0);
    return 0;
}

# --- top-level packfile read -------------------------------------------------
# Find `hex` across every .git/objects/pack/*.idx. On a hit, writes the matching
# pack's {data, len} and the object's offset to out24 and returns 0; negative
# when there is no pack directory (-1), `hex` is not an id (-2), or no pack
# holds it (-3).
#
# 1.7.5: nothing is left on the heap. The directory is listed with
# dir_list_into into freelist buffers freed before returning, and the paths are
# built on the stack. sf_dir_list built a vec and a Str per entry, and each
# .idx / .pack path was alloc'd, on every lookup: 672 bytes per object read,
# kept for good, so ~8 MB for sit_repo_status on 12,000 files in owl or thoth.
# The listing is redone per lookup on purpose: a long-lived consumer must see
# the packs a later `git gc` writes.

# dir_list_into's name and offset buffers for the pack directory, doubled and
# listed again when a directory does not fit, up to _GIT_PACKDIR_TRIES times.
var _GIT_PACKDIR_NAMES = 4096;
var _GIT_PACKDIR_ENTRIES = 64;
var _GIT_PACKDIR_TRIES = 16;
# Longest pack file name kept: `pack-<64 hex>.idx` is 74 bytes. A longer name
# is not a pack git wrote, and is skipped.
var _GIT_PACKNAME_MAX = 255;

# 1.7.6 (R4): the .idx / .pack of the last hit, tried before the directory is
# listed. Reads cluster in one pack, and a REF_DELTA base is usually beside its
# delta; every lookup re-listed the directory and probed every .idx, so a
# REF chain beside 1,000 other packs cost 10 s per read. A hit is an id that
# pack holds, so it is the right object; a miss falls through to the listing,
# which still finds packs a later `git gc` wrote.
var _git_last_idx = 0;
var _git_last_pack = 0;

# Forget the last hit. Called when a repo is opened: its path is repo-relative,
# and another repo's .idx must never answer for this one's ids.
fn _git_pack_forget_last() {
    if (_git_last_idx != 0) { store8(_git_last_idx, 0); }
    return 0;
}

fn _git_pack_locate(hex, out24) {
    var have_last = 0;
    if (_git_last_idx != 0) { if (load8(_git_last_idx) != 0) { have_last = 1; } }
    if (have_last == 1) {
        var qraw[32];
        if (hex_decode_into(hex, _id_hexlen(), &qraw) != 0) {
            var qoff = _git_idx_lookup(_git_last_idx, &qraw, _id_rawlen());
            if (qoff >= 0) {
                var qp[16];
                if (_git_load_pack(_git_last_pack, &qp) == 0) {
                    store64(out24, load64(&qp));
                    store64(out24 + 8, load64(&qp + 8));
                    store64(out24 + 16, qoff);
                    return 0;
                }
            }
        }
    }
    var packdir = ".git/objects/pack";
    var dlen = 17;                                     # strlen(packdir)
    # S-26: route through the sit_abs seam like every other repo path (on agnos
    # the root is a real absolute path and there is no cwd to fall back on).
    var abuf[4352];
    var apath = sit_abs_into(packdir, &abuf, 4352);
    if (apath == 0) { return 0 - 1; }
    var pstr[16];                                      # a Str {data, len} (str.cyr's layout)
    store64(&pstr, apath);
    store64(&pstr + 8, strlen(apath));
    var scratch[4096];
    var names_cap = _GIT_PACKDIR_NAMES;
    var max_entries = _GIT_PACKDIR_ENTRIES;
    var names = 0;
    var offs = 0;
    var n = 0 - 3;
    var tries = 0;
    var listing = 1;
    while (listing == 1) {
        names = fl_alloc(names_cap);
        offs = fl_alloc(max_entries * 8);
        n = 0 - 5;
        if (names != 0) {
            if (offs != 0) {
                n = dir_list_into(&pstr, &scratch, 4096, names, names_cap, offs, max_entries);
            }
        }
        listing = 0;
        tries = tries + 1;
        if (tries < _GIT_PACKDIR_TRIES) {
            if (n == 0 - 3) { names_cap = names_cap * 2; listing = 1; }
            if (n == 0 - 4) { max_entries = max_entries * 2; listing = 1; }
        }
        if (listing == 1) {
            fl_free(names);
            fl_free(offs);
        }
    }
    var rc = 0 - 3;
    if (n < 0) { rc = 0 - 1; }                        # no pack directory, or unreadable
    var rawlen = _id_rawlen();
    var oid_raw[32];
    if (rc == 0 - 3) {
        if (hex_decode_into(hex, _id_hexlen(), &oid_raw) == 0) { rc = 0 - 2; }
    }
    var ipath[288];
    var ppath[288];
    var i = 0;
    while (i < n) {
        if (rc == 0 - 3) {
            var nm = names + load64(offs + i * 8);
            var sl = strlen(nm);
            if (sl > 4) {
                if (sl <= _GIT_PACKNAME_MAX) {
                    if (memeq(nm + sl - 4, ".idx", 4) == 1) {
                        memcpy(&ipath, packdir, dlen);
                        store8(&ipath + dlen, 47);
                        memcpy(&ipath + dlen + 1, nm, sl);
                        store8(&ipath + dlen + 1 + sl, 0);
                        var offset = _git_idx_lookup(&ipath, &oid_raw, rawlen);
                        if (offset >= 0) {
                            var nb = sl - 4;   # name minus ".idx"
                            memcpy(&ppath, packdir, dlen);
                            store8(&ppath + dlen, 47);
                            memcpy(&ppath + dlen + 1, nm, nb);
                            memcpy(&ppath + dlen + 1 + nb, ".pack", 5);
                            store8(&ppath + dlen + 1 + nb + 5, 0);
                            var pkp[16];
                            if (_git_load_pack(&ppath, &pkp) == 0) {
                                store64(out24, load64(&pkp));
                                store64(out24 + 8, load64(&pkp + 8));
                                store64(out24 + 16, offset);
                                rc = 0;
                                if (_git_last_idx == 0) {
                                    _git_last_idx = alloc_or_die(288);
                                    _git_last_pack = alloc_or_die(288);
                                }
                                memcpy(_git_last_idx, &ipath, 288);
                                memcpy(_git_last_pack, &ppath, 288);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if (names != 0) { fl_free(names); }
    if (offs != 0) { fl_free(offs); }
    return rc;
}

# Look up `hex` across every .git/objects/pack/*.idx; on a hit, reconstruct the
# object from the matching .pack. Writes read_object contract to out24. Returns
# 0 on success, negative if not found in any pack (or no pack dir).
fn _git_read_pack(hex, out24) {
    var loc[24];
    var lr = _git_pack_locate(hex, &loc);
    if (lr != 0) { return lr; }
    return _git_pack_obj(load64(&loc), load64(&loc + 8), load64(&loc + 16), out24);
}

# Loose-first, then packfile: the git-mode object read used by read_object and
# by REF_DELTA base resolution. On-disk (non-thin) packs are self-contained, so
# a REF_DELTA base is always present as loose or in some pack.
fn _git_read_any(hex, out24) {
    if (_git_read_loose(hex, out24) == 0) { return 0; }
    return _git_read_pack(hex, out24);
}

# --- object_db.cyr ---

# object_db.cyr — patra object store, compression / framing, read commands.
#
# Content-addressed via sigil SHA-256 over the git-SHA-256-compatible framing
# "<type> <len>\0<content>". Zlib compression via sankoch. Objects live in
# .sit/objects.patra (`objects(hash STR, ty INT, content BYTES)`). Legacy
# loose-file layout auto-migrates on first access. Read verbs: cat-file,
# owl-file, fsck. Also the blob-hash primitives used by add + status.

# Write the loose-object path .sit/objects/xx/<62 hex> into `buf`; returns its length (78).
fn object_path(buf, hex) {
    memcpy(buf, ".sit/objects/", 13);
    store8(buf + 13, load8(hex));
    store8(buf + 14, load8(hex + 1));
    store8(buf + 15, 47);
    memcpy(buf + 16, hex + 2, 62);
    store8(buf + 78, 0);
    return 78;
}

# Try to resolve `name` as a ref: HEAD, refs/tags/<name>, or refs/heads/<name>
# in that order. On success, writes the 64-char hash into out_buf and returns 1.
# Returns 0 if no ref matches.
fn resolve_hash(prefix, out_buf) {
    var plen = strlen(prefix);
    var hexlen = _id_hexlen();
    if (plen == hexlen) {
        # S-01: a full-length hash must still be hex — otherwise the
        # short-circuit here would pass garbage bytes straight through.
        if (hex_prefix_valid(prefix, hexlen) == 0) { return 0; }
        memcpy(out_buf, prefix, hexlen);
        store8(out_buf + hexlen, 0);
        return 1;
    }

    # Try as a ref name first (HEAD, tags, branches)
    if (resolve_ref_name(prefix, out_buf) == 1) { return 1; }

    # git mode (roadmap 1.2.0): objects live on the loose/pack filesystem, not
    # patra. Short-prefix disambiguation over loose fanout + pack .idx is a later
    # enhancement — a git object must be named by full oid or a ref for now (roadmap: `.git/` CLI parity).
    if (_repo_backend == 1) { return 0; }

    if (plen < 4) { return 0 - 2; }

    # S-01: reject any non-hex character before interpolating into LIKE.
    # Without this, a prefix containing `'` would break / inject the SQL.
    if (hex_prefix_valid(prefix, plen) == 0) { return 0; }

    var db = get_object_db();
    if (db == 0) { return 0; }

    # S-24: SQL strings on the freelist instead of bump heap so they don't
    # accumulate per-call.
    var sql = fl_alloc(64 + plen);
    memcpy(sql, "SELECT hash FROM objects WHERE hash LIKE '", 42);
    memcpy(sql + 42, prefix, plen);
    memcpy(sql + 42 + plen, "%'", 2);
    store8(sql + 42 + plen + 2, 0);

    var rs = patra_query(db, sql);
    fl_free(sql);
    if (rs == 0) { return 0; }
    var count = patra_result_count(rs);
    var ret = 0;
    if (count == 1) {
        var hash_str = patra_result_get_str(rs, 0, 0);
        memcpy(out_buf, hash_str, 64);
        store8(out_buf + 64, 0);
        ret = 1;
    }
    else {
        if (count > 1) { ret = 0 - 1; }
    }
    patra_result_free(rs);
    # 1.10.0: and the packed objects. One object both packed and a row is one match.
    if (ret >= 0) {
        var phex[72];
        var pc = sit_pack_prefix(0, prefix, plen, &phex);
        if (pc > 1) { ret = 0 - 1; }
        if (pc == 1) {
            if (ret == 0) {
                memcpy(out_buf, &phex, 64);
                store8(out_buf + 64, 0);
                ret = 1;
            }
            else {
                if (memeq(out_buf, &phex, 64) == 0) { ret = 0 - 1; }
            }
        }
    }
    return ret;
}

# 1.7.6 (R10): the one inflate for a stored object, "<type> <len>\0<content>"
# under zlib. It replaces seven copies of the same sizing (4x the compressed
# size, retried at the 16 MiB ceiling), and sizes the retry from the object's
# own header instead: a blob compressing better than 4:1 used to take a fresh
# 16 MiB buffer per read — on the bump heap at most sites, so never returned.
# A clone of 2,000 such 20 KB blobs peaked at 4.4 GB RSS with transparent
# huge pages on. The result is a freelist buffer of about the object's size.
#
# Writes {ptr, dlen, content_off} to out24; the buffer is the caller's to
# fl_free (or keep). Returns 0, -2 out of memory, -3 not a valid stream (or
# past the ratio / 16 MiB caps), -4 no framing NUL.
var _OBJ_INFLATE_MAX = 16777216;

# Inflate stored object bytes into a freelist buffer sized for them (see above).
fn obj_inflate_fl(compressed, clen, out24) {
    var dec_cap = clen * 4;
    if (dec_cap < 4096) { dec_cap = 4096; }
    if (dec_cap > _OBJ_INFLATE_MAX) { dec_cap = _OBJ_INFLATE_MAX; }
    var buf = fl_alloc(dec_cap);
    if (buf == 0) { return 0 - 2; }
    # Stale freelist bytes must not read as a header the inflate never wrote.
    store64(buf, 0); store64(buf + 8, 0); store64(buf + 16, 0); store64(buf + 24, 0);
    var dlen = zlib_decompress_with_ratio_cap(compressed, clen, buf, dec_cap, SIT_MAX_INFLATE_RATIO);
    if (dlen == 0 - ERR_BUFFER_TOO_SMALL) {
        if (dec_cap < _OBJ_INFLATE_MAX) {
            # The output is written in order, so the header is in `buf`.
            var want = obj_frame_total(buf, 32);
            if (want > _OBJ_INFLATE_MAX) { fl_free(buf); return 0 - 3; }
            var cap2 = want + 16;
            if (want <= dec_cap) { cap2 = _OBJ_INFLATE_MAX; }   # header unreadable or lying
            if (cap2 > _OBJ_INFLATE_MAX) { cap2 = _OBJ_INFLATE_MAX; }
            fl_free(buf);
            buf = fl_alloc(cap2);
            if (buf == 0) { return 0 - 2; }
            dlen = zlib_decompress_with_ratio_cap(compressed, clen, buf, cap2, SIT_MAX_INFLATE_RATIO);
        }
    }
    if (dlen <= 0) { fl_free(buf); return 0 - 3; }
    var nul = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (nul >= dlen) { scanning = 0; }
        else {
            if (load8(buf + nul) == 0) { scanning = 0; }
            else { nul = nul + 1; }
        }
    }
    if (nul >= dlen) { fl_free(buf); return 0 - 4; }
    store64(out24, buf);
    store64(out24 + 8, dlen);
    store64(out24 + 16, nul + 1);
    return 0;
}

# The whole framed length an object header at `buf` declares — "<type> <n>\0"
# plus n — reading at most `avail` bytes; -1 when no well-formed header is there.
fn obj_frame_total(buf, avail) {
    var sp = 0 - 1;
    var i = 0;
    while (i < avail) {
        if (sp < 0) {
            var c = load8(buf + i) & 0xFF;
            if (c == 32) { sp = i; }
            else {
                if (c < 97) { i = avail; }
                if (c > 122) { i = avail; }
            }
        }
        i = i + 1;
    }
    if (sp < 1) { return 0 - 1; }
    var n = 0;
    var j = sp + 1;
    var digits = 0;
    var end = 0 - 1;
    while (j < avail) {
        if (end < 0) {
            var d = load8(buf + j) & 0xFF;
            if (d == 0) { end = j; }
            else {
                if (d < 48) { j = avail; }
                else {
                    if (d > 57) { j = avail; }
                    else {
                        n = n * 10 + (d - 48);
                        digits = digits + 1;
                        if (digits > 10) { j = avail; }
                    }
                }
            }
        }
        j = j + 1;
    }
    if (end < 0) { return 0 - 1; }
    if (digits == 0) { return 0 - 1; }
    if (digits > 10) { return 0 - 1; }
    return end + 1 + n;
}

# ── Packs (1.10.0) ─────────────────────────────────────────────────
#
# `sit gc` moves every reachable object into a pack, `.sit/packs/pack-<id>.pack`
# beside its `.idx`, in git's SHA-256 pack v2 / idx v2 format: byte for byte,
# so `git index-pack` rebuilds the same .idx. Each object is a delta against the
# newer version at the same path where that wins. git_pack.cyr's reader serves
# them (OFS_DELTA only: a REF_DELTA is refused, so a sit pack is always
# self-contained), and sit_pack_read frames the result like a stored row. Rows
# in objects.patra are the loose objects: whatever was written since, and
# whatever gc found unreachable. See ADR 0016.
#
# A store's pack list is read once per process. Packs change only under gc,
# which runs alone (the store lock, below) and resets the list itself.

# Store root ("" = this repository) -> vec of 16-byte {idx path, pack path} cells.
var _sit_pack_lists = 0;

# `root` as an absolute path. Another repository's root is relative to the
# process cwd, as its patra_open is, but the pack reader resolves a relative
# path against this repository's root (sit_abs) — so `sit clone ../src dst`,
# with the root set to dst, looked for dst/../src's packs. agnos has no cwd and
# takes absolute paths only.
fn _sit_root_abs(root) {
    if (load8(root) == 47) { return root; }
    #ifdef CYRIUS_TARGET_AGNOS
    return root;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var cwd[4096];
    if (syscall(SYS_GETCWD, &cwd, 4096) <= 0) { return root; }
    var cl = strlen(&cwd);
    var rl = strlen(root);
    var p = alloc_or_die(cl + rl + 2);
    memcpy(p, &cwd, cl);
    store8(p + cl, 47);
    memcpy(p + cl + 1, root, rl);
    store8(p + cl + 1 + rl, 0);
    return p;
    #endif
}

# The packs directory of the store at `root` (0 = this repository).
fn _sit_packdir(root) {
    if (root == 0) { return ".sit/packs"; }
    var ar = _sit_root_abs(root);
    var rl = strlen(ar);
    var p = alloc_or_die(rl + 12);
    memcpy(p, ar, rl);
    memcpy(p + rl, "/.sit/packs", 11);
    store8(p + rl + 11, 0);
    return p;
}

# 1 when `nm` (`n` bytes) is a pack index name gc writes: `pack-<64 hex>.idx`.
fn _sit_pack_idx_name(nm, n) {
    if (n != 73) { return 0; }
    if (memeq(nm, "pack-", 5) == 0) { return 0; }
    if (memeq(nm + 69, ".idx", 4) == 0) { return 0; }
    return hex_prefix_valid(nm + 5, 64);
}

# The packs of the store at `root`, listed on first use: a vec of {idx path,
# pack path} cells. A packs directory that is not a plain directory (a planted
# symlink) has none.
fn sit_packs(root) {
    if (_sit_pack_lists == 0) { _sit_pack_lists = map_new(); }
    # 1.11.0 (R6): this repository's list is keyed by its root, so a process
    # that opens another (the read API, sit serve --repos) lists that one's.
    var key = root;
    if (key == 0) { key = _repo_root; }
    if (key == 0) { key = ""; }
    var hit = map_get(_sit_pack_lists, key);
    if (hit != 0) { return hit; }
    var packs = vec_new();
    var dir = _sit_packdir(root);
    var dl = strlen(dir);
    var adir = dir;
    if (root == 0) { adir = sit_abs(dir); }
    if (path_lstat_kind(adir) == 0x4000) {
        var names = dir_list(str_from(adir));
        var i = 0;
        while (i < vec_len(names)) {
            var ns = vec_get(names, i);
            var nm = str_data(ns);
            var nl = str_len(ns);
            if (_sit_pack_idx_name(nm, nl) == 1) {
                var ip = alloc_or_die(dl + 1 + nl + 1);
                memcpy(ip, dir, dl);
                store8(ip + dl, 47);
                memcpy(ip + dl + 1, nm, nl);
                store8(ip + dl + 1 + nl, 0);
                var pp = alloc_or_die(dl + 1 + nl + 2);
                memcpy(pp, ip, dl + 1 + nl - 4);
                memcpy(pp + dl + 1 + nl - 4, ".pack", 5);
                store8(pp + dl + 1 + nl + 1, 0);
                var cell = alloc_or_die(16);
                store64(cell, ip);
                store64(cell + 8, pp);
                vec_push(packs, cell);
            }
            i = i + 1;
        }
    }
    var kl = strlen(key);
    var kc = alloc_or_die(kl + 1);
    memcpy(kc, key, kl);
    store8(kc + kl, 0);
    map_set(_sit_pack_lists, kc, packs);
    return packs;
}

# Forget every store's pack list (gc, after installing or removing a pack).
fn sit_packs_reset() {
    _sit_pack_lists = 0;
    return 0;
}

# How many packs the store at `root` has.
fn sit_pack_count(root) {
    return vec_len(sit_packs(root));
}

# Find `hex` (64 hex) in the store's packs: {pack data, pack len, offset} at
# out24 and 0; -3 when no pack holds it, -2 when `hex` is not an id.
fn sit_pack_locate(root, hex, out24) {
    var packs = sit_packs(root);
    var n = vec_len(packs);
    if (n == 0) { return 0 - 3; }
    var raw[32];
    if (hex_decode_into(hex, 64, &raw) == 0) { return 0 - 2; }
    var rc = 0 - 3;
    var i = 0;
    while (i < n) {
        if (rc != 0) {
            var cell = vec_get(packs, i);
            var off = _git_idx_lookup(load64(cell), &raw, 32);
            if (off >= 0) {
                var pp[16];
                if (_git_load_pack(load64(cell + 8), &pp) == 0) {
                    store64(out24, load64(&pp));
                    store64(out24 + 8, load64(&pp + 8));
                    store64(out24 + 16, off);
                    rc = 0;
                }
            }
        }
        i = i + 1;
    }
    return rc;
}

# 1 when one of the store's packs holds `hex`, else 0.
fn sit_pack_has(root, hex) {
    var loc[24];
    if (sit_pack_locate(root, hex, &loc) == 0) { return 1; }
    return 0;
}

# The framing word of pack type `t` (1 commit, 2 tree, 3 blob, 4 tag), or 0.
fn _pack_type_word(t) {
    if (t == 1) { return "commit"; }
    if (t == 2) { return "tree"; }
    if (t == 3) { return "blob"; }
    if (t == 4) { return "tag"; }
    return 0;
}

# Read `hex` from the store's packs into the read_object contract: a freelist
# buffer holding "<type> <len>\0<content>" with its content offset. Returns 0,
# -3 when no pack holds it, -6 out of memory, -7 when the entry does not
# reconstruct. Like a row read, this does not re-hash; fsck and gc do.
fn sit_pack_read(root, hex, out24) {
    var loc[24];
    var lr = sit_pack_locate(root, hex, &loc);
    if (lr != 0) { return lr; }
    var res[24];
    var ptype[8];
    store64(&ptype, 0);
    if (_pack_obj_ex(load64(&loc), load64(&loc + 8), load64(&loc + 16), &res, &ptype, 0) != 0) {
        return 0 - 7;
    }
    var body = load64(&res);
    var blen = load64(&res + 8);
    var word = _pack_type_word(load64(&ptype));
    if (word == 0) { fl_free(body); return 0 - 7; }
    var wl = strlen(word);
    var hdr[32];
    memcpy(&hdr, word, wl);
    store8(&hdr + wl, 32);
    var dg = write_decimal(&hdr + wl + 1, blen);
    store8(&hdr + wl + 1 + dg, 0);
    var hl = wl + dg + 2;
    var framed = fl_alloc(hl + blen + 1);
    if (framed == 0) { fl_free(body); return 0 - 6; }
    memcpy(framed, &hdr, hl);
    _pack_copy(framed + hl, body, blen);
    fl_free(body);
    store64(out24, framed);
    store64(out24 + 8, hl + blen);
    store64(out24 + 16, hl);
    return 0;
}

# Validate the .idx at `path` (v2, 32-byte ids) and write {data, len, count}
# to out24. Returns 0, or -1 when it is unreadable or malformed. The checks are
# _git_idx_lookup's: magic, version, and a count the file can hold.
fn _sit_idx_open(path, out24) {
    var pr[16];
    if (_git_file_cached(path, &pr) != 0) { return 0 - 1; }
    var d = load64(&pr);
    var len = load64(&pr + 8);
    if (len < 1032 + 64) { return 0 - 1; }
    if ((load8(d) & 0xFF) != 255) { return 0 - 1; }
    if (memeq(d + 1, "tOc", 3) == 0) { return 0 - 1; }
    if (_be32(d + 4) != 2) { return 0 - 1; }
    var n = _be32(d + 8 + 255 * 4);
    if (n < 0) { return 0 - 1; }
    if (n > (len - 1032 - 64) / 40) { return 0 - 1; }
    store64(out24, d);
    store64(out24 + 8, len);
    store64(out24 + 16, n);
    return 0;
}

# Count the packed objects whose id starts with `prefix` (`plen` hex digits,
# at least 2, already validated), up to 2, writing the first one's 64 hex to
# `out` (65 bytes). resolve_hash's pack half.
fn sit_pack_prefix(root, prefix, plen, out) {
    var packs = sit_packs(root);
    var found = 0;
    var hx[72];
    var b0 = 0;
    var i = 0;
    while (i < 2) {
        var c = load8(prefix + i) & 0xFF;
        var v = 0;
        if (c >= 97) { v = c - 87; }
        else {
            if (c >= 65) { v = c - 55; }
            else { v = c - 48; }
        }
        b0 = b0 * 16 + v;
        i = i + 1;
    }
    var pi = 0;
    while (pi < vec_len(packs)) {
        var ix[24];
        if (_sit_idx_open(load64(vec_get(packs, pi)), &ix) == 0) {
            var d = load64(&ix);
            var lo = 0;
            if (b0 > 0) { lo = _be32(d + 8 + (b0 - 1) * 4); }
            var hi = _be32(d + 8 + b0 * 4);
            if (hi > load64(&ix + 16)) { hi = 0; }
            var k = lo;
            while (k < hi) {
                if (found < 2) {
                    _hex_into(d + 1032 + k * 32, 32, &hx);
                    if (memeq(&hx, prefix, plen) == 1) {
                        if (found == 0) {
                            memcpy(out, &hx, 64);
                            store8(out + 64, 0);
                            found = 1;
                        }
                        else {
                            if (memeq(out, &hx, 64) == 0) { found = 2; }
                        }
                    }
                }
                k = k + 1;
            }
        }
        pi = pi + 1;
    }
    return found;
}

# Push the 64-hex id (a heap cstring) of every object in the store's packs
# onto `out`. An object two packs hold appears twice. Returns how many were
# pushed, or -1 when an .idx is malformed.
fn sit_pack_oids(root, out) {
    var packs = sit_packs(root);
    var total = 0;
    var pi = 0;
    while (pi < vec_len(packs)) {
        var ix[24];
        if (_sit_idx_open(load64(vec_get(packs, pi)), &ix) != 0) { return 0 - 1; }
        var d = load64(&ix);
        var n = load64(&ix + 16);
        var k = 0;
        while (k < n) {
            var hx = alloc_or_die(72);
            _hex_into(d + 1032 + k * 32, 32, hx);
            vec_push(out, hx);
            k = k + 1;
        }
        total = total + n;
        pi = pi + 1;
    }
    return total;
}

# 1 when the last 32 bytes of {d, len} are the SHA-256 of everything before.
fn _sit_trailer_ok(d, len) {
    if (len < 32) { return 0; }
    var h[32];
    sha256(d, len - 32, &h);
    return memeq(&h, d + len - 32, 32);
}

# fsck's check of the pack files themselves: every pack's trailing SHA-256 and
# its .idx's, and that the .idx names its pack's. Reports each failure on
# stderr and returns how many there were.
fn sit_pack_verify_files(root) {
    var packs = sit_packs(root);
    var bad = 0;
    var pi = 0;
    while (pi < vec_len(packs)) {
        var cell = vec_get(packs, pi);
        var ok = 0;
        var ix[24];
        var pp[16];
        if (_sit_idx_open(load64(cell), &ix) == 0) {
            if (_git_load_pack(load64(cell + 8), &pp) == 0) {
                var d = load64(&ix);
                var il = load64(&ix + 8);
                var pd = load64(&pp);
                var pl = load64(&pp + 8);
                if (_sit_trailer_ok(d, il) == 1) {
                    if (_sit_trailer_ok(pd, pl) == 1) {
                        if (memeq(d + il - 64, pd + pl - 32, 32) == 1) { ok = 1; }
                    }
                }
            }
        }
        if (ok == 0) {
            var ip = load64(cell);
            syscall(SYS_WRITE, STDERR, "bad pack ", 9);
            syscall(SYS_WRITE, STDERR, ip, strlen(ip));
            syscall(SYS_WRITE, STDERR, "\n", 1);
            bad = bad + 1;
        }
        pi = pi + 1;
    }
    return bad;
}

# Read and decompress an object by full 64-char hex hash.
# On success, writes to out (24 bytes):
#   out[0..8)    decompressed buffer ptr
#   out[8..16)   decompressed length (framing + content)
#   out[16..24)  content offset (first byte past framing \0)
# Returns 0 on success, negative on error.
fn read_object(hex, out) {
    # Storage seam (roadmap 1.2.0): a .git/ repo has no patra store — objects
    # are loose files or packed. _git_read_any tries loose then every packfile.
    # Dispatch on the backend set by sit_repo_open's _detect_repo_backend.
    # SIT mode (default) is unchanged.
    #
    # 1.6.4 (D8): the gate below now covers this branch too, at the backend's
    # width (40 or 64). git mode returned before it, so a hostile `.git/` whose
    # tree header was `../../outside/evil` made _git_read_any open and inflate
    # a path outside .git/objects — the S-25 "single check covers every one of
    # them" claim did not hold in git mode.
    if (_repo_backend == 1) {
        if (hex_prefix_valid(hex, _id_hexlen()) == 0) { return 0 - 1; }
        return _git_read_any(hex, out);
    }

    # S-25: gate the object id HERE, at the choke point.
    #
    # The 64 bytes below are memcpy'd verbatim into a patra SQL string literal,
    # and `hex` reaches this function from a dozen places — commit `tree` /
    # `parent` header fields, tree entry hashes, ref files, the reflog, wire
    # responses — several of which had no gate of their own. A single check here
    # covers every one of them and is the same defence `resolve_hash` and the
    # serve endpoints already apply individually.
    #
    # It also bounds the read: the memcpy takes 64 bytes unconditionally, so a
    # shorter string was an out-of-bounds read. hex_prefix_valid stops at the
    # first non-hex byte, and a NUL terminator is not a hex digit.
    if (hex_prefix_valid(hex, 64) == 0) { return 0 - 1; }

    var db = get_object_db();
    if (db == 0) { return 0 - 1; }

    # 1.10.0: packs first when there are any. After a gc nearly every object is
    # packed, and an index probe in a mapped .idx is cheaper than the row miss.
    if (sit_pack_count(0) > 0) {
        if (sit_pack_read(0, hex, out) == 0) { return 0; }
    }
    return db_row_read(db, hex, out);
}

# read_object's row half: the loose object `hex` (already validated) from the
# patra store `db`, inflated. Same contract and return codes as read_object;
# fsck calls it directly to check rows apart from packs.
fn db_row_read(db, hex, out) {
    # S-24: SQL string via fl_alloc + fl_free; freed before any non-trivial
    # work below so we don't hold both the buffer and the result-set.
    var sql = fl_alloc(128);
    memcpy(sql, "SELECT content FROM objects WHERE hash = '", 42);
    memcpy(sql + 42, hex, 64);
    memcpy(sql + 42 + 64, "'", 1);
    store8(sql + 42 + 64 + 1, 0);

    var rs = patra_query(db, sql);
    fl_free(sql);
    if (rs == 0) { return 0 - 2; }
    if (patra_result_count(rs) == 0) {
        patra_result_free(rs);
        return 0 - 3;
    }

    var blen = patra_result_get_bytes_len(rs, 0, 0);
    if (blen <= 0) {
        patra_result_free(rs);
        return 0 - 4;
    }

    var compressed = fl_alloc(blen);
    if (compressed == 0) {
        patra_result_free(rs);
        return 0 - 6;
    }
    if (patra_result_read_bytes(db, rs, 0, 0, compressed) != 0) {
        fl_free(compressed);
        patra_result_free(rs);
        return 0 - 5;
    }
    patra_result_free(rs);

    # 1.7.6 (R10): obj_inflate_fl — freelist, sized from the header; the
    # compressed copy is freed rather than kept on the bump heap per read.
    var ir = obj_inflate_fl(compressed, blen, out);
    fl_free(compressed);
    if (ir == 0 - 2) { return 0 - 6; }
    if (ir == 0 - 3) { return 0 - 7; }
    if (ir != 0) { return 0 - 8; }
    return 0;
}

# Frame `<type> <len>\0<content>`, hash it, compress and store it; returns the 64-hex id or 0.
fn write_typed_object(type_str, type_len, content, content_len) {
    var hdr_max = 32;
    var full_cap = hdr_max + content_len;
    var full = alloc_or_die(full_cap);
    memcpy(full, type_str, type_len);
    store8(full + type_len, 32);
    var digits = write_decimal(full + type_len + 1, content_len);
    store8(full + type_len + 1 + digits, 0);
    var hdr_len = type_len + 1 + digits + 1;
    memcpy(full + hdr_len, content, content_len);
    var full_len = hdr_len + content_len;

    var hex = hash_data(full, full_len);

    var out_cap = full_len + 64 + full_len / 10;
    if (out_cap < 128) { out_cap = 128; }
    var compressed = alloc_or_die(out_cap);
    var clen = zlib_compress(full, full_len, compressed, out_cap);
    if (clen <= 0) { return 0; }

    var db = get_object_db();
    if (db == 0) { return 0; }

    # Content-addressed — skip if hash already present: packed (1.10.0), or a row.
    if (sit_pack_has(0, hex) == 1) { return hex; }
    # S-24: SQL on the freelist; freed before the insert path runs.
    var check_sql = fl_alloc(128);
    memcpy(check_sql, "SELECT hash FROM objects WHERE hash = '", 39);
    memcpy(check_sql + 39, hex, 64);
    memcpy(check_sql + 39 + 64, "'", 1);
    store8(check_sql + 39 + 64 + 1, 0);
    var rs = patra_query(db, check_sql);
    fl_free(check_sql);
    var exists = 0;
    if (rs != 0) {
        if (patra_result_count(rs) > 0) { exists = 1; }
        patra_result_free(rs);
    }

    if (exists == 0) {
        var type_code = type_code_of(type_str, type_len);
        var types[24];
        store64(&types + 0, 1);
        store64(&types + 8, 0);
        store64(&types + 16, 2);
        var ivals[24];
        store64(&ivals + 8, type_code);
        var sptrs[24];
        store64(&sptrs + 0, hex);
        var slens[24];
        store64(&slens + 0, 64);
        var bptrs[24];
        store64(&bptrs + 16, compressed);
        var blens[24];
        store64(&blens + 16, clen);
        # 1.7.1: a refused insert is a failure, not a stored object. Handing
        # back the hash anyway let add / commit record an id that was never
        # written. Since patra 1.16.2 a failed fdatasync also lands here.
        if (patra_insert_row(db, "objects", 7, 3,
            &types, &ivals, &sptrs, &slens, &bptrs, &blens) != PATRA_OK) { return 0; }
    }
    return hex;
}

# write_typed_object for a blob.
fn write_blob_object(content, content_len) {
    return write_typed_object("blob", 4, content, content_len);
}

# Shared front half of cat-file / owl-file: detect the backend, resolve argv[2]'s prefix, read the object.
fn resolve_and_read(obj_out, hex_out) {
    # Backend detection (roadmap 1.2.0): read verbs work on a native .sit/ or an
    # existing .git/ repo; sets the process-global backend that read_object /
    # resolve_hash dispatch on. Non-repos still error as before.
    if (_detect_repo_backend() < 0) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    var prefix = argv_heap(2);
    var rr = resolve_hash(prefix, hex_out);
    if (rr == 0 - 2) { eprintln("sit: hash prefix too short (min 4 chars)"); return 1; }
    if (rr == 0 - 1) { eprintln("sit: ambiguous hash prefix"); return 1; }
    if (rr == 0)     { eprintln("sit: no object matches"); return 1; }

    var er = read_object(hex_out, obj_out);
    if (er != 0) {
        eprintln("sit: cannot read object (corrupt or missing)");
        return 1;
    }
    return 0;
}

# `sit cat-file <hash>` — write an object's content to stdout (plumbing; .sit/ or .git/).
fn cmd_cat_file() {
    if (argc() < 3) {
        eprintln("usage: sit cat-file <hash>");
        return 1;
    }

    var hex[72];
    var obj[24];
    var r = resolve_and_read(&obj, &hex);
    if (r != 0) { return r; }

    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    stdout_write(buf + coff, blen - coff);
    return 0;
}

# Locate the owl binary. Priority: SIT_OWL env var (explicit override) →
# /usr/local/bin/owl → /usr/bin/owl → /opt/owl/bin/owl. Returns a C-string
# path or 0 if not found. S-09: each candidate is lstat-checked; symlinks
# are accepted (owl is usually installed this way via package managers)
# but anything in a world-writable directory is logged and rejected.
#
# Writable-dir detection is coarse today — we only check the candidate path
# lstat mode, not the directory's perms up the chain. That's a best-effort
# defense-in-depth; a properly locked-down system has /usr/bin etc. already
# root-owned 0755.
fn find_owl() {
    var env_owl = getenv("SIT_OWL");
    if (env_owl != 0) {
        if (file_exists(env_owl) == 1) { return env_owl; }
        eprintln("sit: SIT_OWL points at a nonexistent file — falling back to system paths");
    }
    if (file_exists("/usr/local/bin/owl") == 1) { return "/usr/local/bin/owl"; }
    if (file_exists("/usr/bin/owl") == 1)       { return "/usr/bin/owl"; }
    if (file_exists("/opt/owl/bin/owl") == 1)   { return "/opt/owl/bin/owl"; }
    return 0;
}

# `sit owl-file <hash>` — view an object through owl, falling back to raw content if owl is absent.
fn cmd_owl_file() {
    if (argc() < 3) {
        eprintln("usage: sit owl-file <hash>");
        return 1;
    }

    var hex[72];
    var obj[24];
    var r = resolve_and_read(&obj, &hex);
    if (r != 0) { return r; }

    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var content = buf + coff;
    var content_len = blen - coff;

    # S-10: write content to $XDG_RUNTIME_DIR (or $HOME/.cache/sit as fallback)
    # with O_CREAT | O_EXCL | O_WRONLY and mode 0600, so we can't be tricked
    # into writing through an attacker-planted symlink at /tmp and other local
    # users can't read the blob.
    var xdg = getenv("XDG_RUNTIME_DIR");
    var home = getenv("HOME");
    var dir_base = 0;
    if (xdg != 0) { dir_base = xdg; }
    else {
        if (home != 0) {
            var hlen = strlen(home);
            var cache = alloc_or_die(hlen + 12);
            memcpy(cache, home, hlen);
            memcpy(cache + hlen, "/.cache/sit", 11);
            store8(cache + hlen + 11, 0);
            var parent = alloc_or_die(hlen + 8);
            memcpy(parent, home, hlen);
            memcpy(parent + hlen, "/.cache", 7);
            store8(parent + hlen + 7, 0);
            ensure_dir(parent);
            ensure_dir(cache);
            dir_base = cache;
        }
        else {
            dir_base = "/tmp";
        }
    }
    var db_len = strlen(dir_base);
    var tmppath = alloc_or_die(db_len + 32);
    memcpy(tmppath, dir_base, db_len);
    memcpy(tmppath + db_len, "/sit-owl-", 9);
    memcpy(tmppath + db_len + 9, &hex, 12);
    store8(tmppath + db_len + 9 + 12, 0);

    # O_WRONLY | O_CREAT | O_EXCL = 1 | 64 | 128 = 193. Mode 0o600 = 0x180.
    # O_EXCL refuses to follow a pre-existing symlink and refuses EEXIST,
    # closing the TOCTOU window. file_open (io.cyr) is the length-carrying
    # bridge — sys_open(tmppath, 193, 0x180) verbatim on Linux/macOS; on agnos
    # it strlen()s the path and maps to AO_* (O_EXCL unavailable there).
    var tfd = file_open(tmppath, 193, 0x180);
    if (tfd < 0) {
        eprintln("sit: cannot create tempfile");
        return 1;
    }
    if (syscall(SYS_WRITE, tfd, content, content_len) < 0) {
        sys_close(tfd);
        # S-16: best-effort tempfile cleanup. Tempfiles live in
        # $XDG_RUNTIME_DIR/sit/ so a leak gets reaped eventually; a stderr
        # warning makes it loud rather than silent.
        if (xunlink(tmppath) != 0) {
            eprintln("sit: warning: failed to remove owl tempfile after write error");
        }
        eprintln("sit: cannot write tempfile");
        return 1;
    }
    sys_close(tfd);

    var owl = find_owl();
    if (owl == 0) {
        eprintln("sit: owl not installed — emitting raw content");
        eprintln("sit:   (owl is pre-1.0; https://github.com/MacCracken/owl)");
        stdout_write(content, content_len);
        if (xunlink(tmppath) != 0) {
            eprintln("sit: warning: failed to remove owl tempfile");
        }
        return 0;
    }

    var args = vec_new();
    vec_push(args, owl);
    vec_push(args, tmppath);
    var rc = exec_vec(args);
    if (xunlink(tmppath) != 0) {
        eprintln("sit: warning: failed to remove owl tempfile after exec");
    }
    return rc;
}

# Type codes stored in the objects.type INT column.
fn type_code_of(type_str, type_len) {
    if (type_len == 4) {
        if (memeq(type_str, "blob", 4) == 1) { return 0; }
        if (memeq(type_str, "tree", 4) == 1) { return 1; }
    }
    if (type_len == 6) {
        if (memeq(type_str, "commit", 6) == 1) { return 2; }
    }
    if (type_len == 3) {
        if (memeq(type_str, "tag", 3) == 1) { return 3; }
    }
    return 0 - 1;
}

# Open (or create) the patra-backed object store. Returns db handle, or 0.
# Used by the wire protocol when it needs an explicit handle (push/fetch
# open both ends with named locals); hot read paths should go through
# get_object_db() instead.
# P-11a: the `objects` table carries a B-tree index on `hash`.
#
# Without one, patra's `_patra_query_exec` cannot take its indexed-WHERE path and
# falls back to a FULL TABLE SCAN — so every `read_object`, `db_object_has` and
# `resolve_hash` was O(rows). Measured before this landed, with an identical 50
# commit reads and only the table size varying:
#
#     ~300 objects  -> log -n 50 : 14, 15, 15 ms
#     ~1200 objects -> log -n 50 : 44, 43, 45 ms
#
# 4x the table for 3x the time on the same work — the signature of a scan. It made
# `log` / `status` / `diff` / `clone` quadratic in repository size, which the
# 100-commit benchmark fixture understates badly.
#
# The index is ALSO the precondition for `patra_insert_row_or_ignore`: its
# conflict probe needs `SCH_IDX_ROOT`, and with no index it silently falls
# through and always inserts. Wiring or-ignore without this would have written
# duplicate rows rather than deduping.
#
# `CREATE INDEX` rebuilds the tree over every existing row, so it must run ONCE,
# not per open. `.sit/objects.indexed` is the marker; it is written only after a
# successful build, so an interrupted migration simply retries next open. Fresh
# repos build an empty tree (free); pre-1.4.1 repos pay one rebuild on first open.
fn _ensure_object_index(db) {
    if (sf_exists(".sit/objects.indexed") == 1) { return 0; }
    if (patra_exec(db, "CREATE INDEX ON objects (hash)") != 0) { return 0 - 1; }
    if (sf_write_atomic(".sit/objects.indexed", "1\n", 2) < 0) { return 0 - 1; }
    return 0;
}

# Open (creating if needed) .sit/objects.patra with its objects table and hash index.
fn object_db_open() {
    # 1.7.2: patra_init reports a refused allocation since patra 1.16.1.
    if (patra_init() != PATRA_OK) { return 0; }
    var db = sf_patra_open(".sit/objects.patra");
    if (db == 0) { return 0; }
    patra_exec(db, "CREATE TABLE objects (hash STR, ty INT, content BYTES)");
    _ensure_object_index(db);
    return db;
}

# v0.6.4: process-wide cached handle for .sit/objects.patra. Collapses
# P-01/02/05/08/12/25 — every read_object / write_typed_object /
# resolve_hash previously did patra_init + patra_open + CREATE TABLE +
# loose-migration check + patra_close on every call. With the cache:
# first call opens + migrates once; subsequent calls reuse the handle;
# fd dies with the process (patra_close just frees in-process buffers
# and closes the fd — no WAL flush — so skipping it at exit is safe).
var _object_db_cached = 0;

# ── Store lock (1.10.0) ────────────────────────────────────────────
#
# `sit gc` replaces `.sit/objects.patra` and deletes packs, so it must run with
# no other process holding the store open: one that opened the old file would
# go on writing into a file nothing reads any more, and lose those objects.
# Every process that opens a store first takes a shared flock on
# `<repo>/.sit/objects.flock` and holds it until it exits; gc takes it exclusive
# and refuses when it cannot. A command started while gc runs waits for it, then
# opens the store gc left. See ADR 0016 and architecture 008.
#
# The file is only ever locked, never written, so it is opened read-only, and
# created O_CREAT|O_EXCL, which refuses a symlink planted at the path. Where it
# cannot be opened (a read-only repository) the store opens unlocked: nothing
# in that process can write it, and gc cannot run there either. agnos has only
# non-blocking flock, so there a command does not wait for gc (accepted, as for
# its other locks).

var _store_lock_fd = 0 - 1;     # this repository's lock file, once opened
var _store_lock_held = 0;       # 0 not held, 1 shared, 2 exclusive (gc)
# The device and inode of the objects.patra the cached handle has open
# (1.11.0): a store session that finds another file there knows a gc replaced it.
var _store_id_a = 0;
var _store_id_b = 0;

# O_CLOEXEC where the target has it: a child (an editor, ssh, owl) must not
# inherit the lock and hold off gc after sit has exited.
fn _store_lock_cloexec() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return O_CLOEXEC;
    #endif
}

# Open, creating if needed, the lock file at the resolved path `ap`: an fd, or
# -1 when it cannot be opened or is not a regular file.
fn _store_lock_open(ap) {
    var kind = path_lstat_kind(ap);
    if (kind < 0) {
        var cfd = file_open(ap, O_RDONLY | O_CREAT | O_EXCL | _store_lock_cloexec(), 0x1A4);
        if (cfd >= 0) { return cfd; }
        kind = path_lstat_kind(ap);               # another process created it meanwhile
    }
    if (kind != 0x8000) { return 0 - 1; }
    return file_open(ap, O_RDONLY | _store_lock_cloexec(), 0);
}

# Take `fd`'s shared lock, waiting while a gc holds it and saying so.
fn _store_lock_wait_shared(fd) {
    if (xflock(fd, LOCK_SH | LOCK_NB) != 0) {
        eprintln("sit: waiting for `sit gc` to finish with the object store");
        file_lock_shared(fd);
    }
    return 0;
}

# Take the shared store lock of the repository at `root` (0 = this one). A
# command keeps it for the life of the process; a store session (below) gives
# this repository's back between requests. Returns the fd, or -1 when there is
# no lock to take.
fn store_lock_shared(root) {
    if (root == 0) {
        if (_store_lock_held != 0) { return _store_lock_fd; }
        if (_store_lock_fd < 0) {
            # Retried per request where it cannot be opened, so on the stack.
            if (_sf_parent_symlink(".sit/objects.flock") == 1) { return 0 - 1; }
            var lb[4352];
            var lp = sit_abs_into(".sit/objects.flock", &lb, 4352);
            if (lp == 0) { return 0 - 1; }
            _store_lock_fd = _store_lock_open(lp);
            if (_store_lock_fd < 0) { return 0 - 1; }
        }
        _store_lock_wait_shared(_store_lock_fd);
        _store_lock_held = 1;
        return _store_lock_fd;
    }
    var rl = strlen(root);
    var ap = alloc_or_die(rl + 20);
    memcpy(ap, root, rl);
    memcpy(ap + rl, "/.sit/objects.flock", 19);
    store8(ap + rl + 19, 0);
    var fd = _store_lock_open(ap);
    if (fd < 0) { return 0 - 1; }
    _store_lock_wait_shared(fd);
    return fd;
}

# Take this repository's store lock exclusively, without waiting: 0, -1 when
# another process holds the store open, -2 when there is no lock file to take
# (the repository is read-only, or .sit/ is not a plain directory). For gc,
# before anything in the process opens the store.
fn store_lock_exclusive() {
    if (_store_lock_held != 0) { return 0 - 1; }
    if (_store_lock_fd < 0) {
        if (_sf_parent_symlink(".sit/objects.flock") == 1) { return 0 - 2; }
        _store_lock_fd = _store_lock_open(sit_abs(".sit/objects.flock"));
        if (_store_lock_fd < 0) { return 0 - 2; }
    }
    if (file_trylock(_store_lock_fd) != 0) { return 0 - 1; }
    _store_lock_held = 2;
    return 0;
}

# ── Store sessions (1.11.0) ────────────────────────────────────────
#
# A long-lived process — `sit serve`, or owl / thoth through the read API —
# held the shared lock from its first read until it exited, so `sit gc` refused
# for as long as it ran. Such a process now brackets each stretch of store use
# (a request, an API call) with store_enter / store_leave and holds the lock
# only inside them. Between them a gc may replace objects.patra and its packs,
# so store_enter compares the store file's device and inode with the ones the
# cached handle opened; on a difference it drops the handle, the pack list and
# the mappings of packs that are gone, and the next read opens what gc left.
# A command (one process per command) never leaves: it keeps the lock to exit.
# See architecture 008.

# The device and inode of this repository's objects.patra, at out16. 0, or -1.
# Linux keeps st_dev at offset 0 and st_ino at 8 on both architectures (and
# macOS, st_ino at 8); agnos declares STAT_INO.
fn _store_file_id(out16) {
    var st[256];
    var pb[4352];
    var ap = sit_abs_into(".sit/objects.patra", &pb, 4352);   # per request: nothing kept
    if (ap == 0) { return 0 - 1; }
    if (xstat(ap, &st) != 0) { return 0 - 1; }
    #ifdef CYRIUS_TARGET_AGNOS
    store64(out16, load64(&st + STAT_INO));
    store64(out16 + 8, 0);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    store64(out16, load64(&st));
    store64(out16 + 8, load64(&st + 8));
    #endif
    return 0;
}

# Close the cached store handle and forget what came from it: the pack lists,
# and the mappings of pack files that no longer exist (git_pack.cyr).
fn store_drop() {
    if (_object_db_cached != 0) {
        patra_close(_object_db_cached);
        _object_db_cached = 0;
    }
    sit_packs_reset();
    _git_file_forget_missing();
    return 0;
}

# Begin a stretch of store use (see above): take the shared lock, and drop the
# cached handle when gc has replaced the file it has open.
fn store_enter() {
    store_lock_shared(0);
    if (_object_db_cached != 0) {
        var id[16];
        var same = 0;
        if (_store_file_id(&id) == 0) {
            if (load64(&id) == _store_id_a) {
                if (load64(&id + 8) == _store_id_b) { same = 1; }
            }
        }
        if (same == 0) { store_drop(); }
    }
    return 0;
}

# End a stretch of store use: give the shared lock back, so a gc can run.
fn store_leave() {
    if (_store_lock_held == 1) {
        xflock(_store_lock_fd, LOCK_UN);
        _store_lock_held = 0;
    }
    return 0;
}

# Forget everything held for the open repository's store — the handle, the
# lock, the pack lists — before another repository is opened in this process
# (sit_repo_open; 1.11.0, R6). The stale handle answered for the new repository.
fn store_repo_reset() {
    store_drop();
    if (_store_lock_fd >= 0) {
        file_close(_store_lock_fd);
        _store_lock_fd = 0 - 1;
    }
    _store_lock_held = 0;
    _store_id_a = 0;
    _store_id_b = 0;
    return 0;
}

# A repository's store state while another is the open one (sit serve --repos,
# 1.11.0): {root, store handle, lock fd, id a, id b}. store_ctx_load makes it
# the open one; store_ctx_save puts it back after the request. The lock is never
# held across a switch: the request has left by then.
var STORE_CTX = 40;

# A fresh store state for the repository at `root` (a heap cstring kept with it).
fn store_ctx_new(root) {
    var c = alloc_or_die(STORE_CTX);
    store64(c, root);
    store64(c + 8, 0);
    store64(c + 16, 0 - 1);
    store64(c + 24, 0);
    store64(c + 32, 0);
    return c;
}

# Make the store state `c` the open repository's.
fn store_ctx_load(c) {
    sit_set_repo_root(load64(c));
    _object_db_cached = load64(c + 8);
    _store_lock_fd = load64(c + 16);
    _store_lock_held = 0;
    _store_id_a = load64(c + 24);
    _store_id_b = load64(c + 32);
    return 0;
}

# Keep the open repository's store state in `c` (after store_leave).
fn store_ctx_save(c) {
    store64(c + 8, _object_db_cached);
    store64(c + 16, _store_lock_fd);
    store64(c + 24, _store_id_a);
    store64(c + 32, _store_id_b);
    return 0;
}

# Close a store state for good (sit serve --repos evicting a repository).
fn store_ctx_close(c) {
    if (load64(c + 8) != 0) { patra_close(load64(c + 8)); }
    if (load64(c + 16) >= 0) { file_close(load64(c + 16)); }
    store64(c + 8, 0);
    store64(c + 16, 0 - 1);
    return 0;
}

# Stores opened from another repository (a file:// remote), and the root each
# was opened at, so the wire layer finds that store's packs from its handle.
# The local store is never listed: its root is 0.
var _store_roots = 0;

# Record that the patra handle `db` is the store of the repository at `root`.
fn store_register_root(db, root) {
    if (_store_roots == 0) { _store_roots = vec_new(); }
    var cell = alloc_or_die(16);
    store64(cell, db);
    store64(cell + 8, root);
    vec_push(_store_roots, cell);
    return 0;
}

# Forget `db` before it is closed: patra may hand the same address to the next open.
fn store_forget_root(db) {
    if (_store_roots == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_store_roots)) {
        var cell = vec_get(_store_roots, i);
        if (load64(cell) == db) { store64(cell, 0); }
        i = i + 1;
    }
    return 0;
}

# The repository root whose store `db` is: 0 for this repository's.
fn store_root_of(db) {
    if (_store_roots == 0) { return 0; }
    if (db == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_store_roots)) {
        var cell = vec_get(_store_roots, i);
        if (load64(cell) == db) { return load64(cell + 8); }
        i = i + 1;
    }
    return 0;
}

# Process-cached object DB handle; migrates loose objects into patra on first open.
fn get_object_db() {
    if (_object_db_cached != 0) { return _object_db_cached; }
    # 1.10.0: the store lock comes before the store is opened (see above).
    store_lock_shared(0);
    _object_db_cached = object_db_open();
    # 1.11.0: and which file it opened, for a store session to compare later.
    var id[16];
    store64(&id, 0);
    store64(&id + 8, 0);
    _store_file_id(&id);
    _store_id_a = load64(&id);
    _store_id_b = load64(&id + 8);
    if (_object_db_cached == 0) { return 0; }
    # v0.6.10 — investigated patra 1.8's BATCH sync mode here and reverted:
    # the cache never closes the handle (fd dies with the process, no
    # patra_close call), so BATCH-pending writes between the every-64-writes
    # auto-flush would be lost on power loss within the kernel writeback
    # window. `copy_objects` already wraps its hot loop in patra_begin /
    # patra_commit (v0.6.5 P-03), which gets the same fsync amortization on
    # the only batch-shaped write path. Stay on FULL (default) for now;  #skip-lint
    # revisit if/when sit grows explicit patra_flush() calls at command exit.
    object_db_migrate_from_loose(_object_db_cached);
    return _object_db_cached;
}

# Migrate legacy loose-file objects (under .sit/objects/<xx>/<yy...>) into
# the patra table. No-op if no legacy files present. Deletes loose files
# + empty 2-char directories as they're migrated.
fn object_db_migrate_from_loose(db) {
    if (sf_exists(".sit/objects") != 1) { return 0; }

    var dirs = sf_dir_list(str_from(".sit/objects"));
    var dn = vec_len(dirs);
    var di = 0;
    while (di < dn) {
        var s = vec_get(dirs, di);
        var sdata = str_data(s);
        var slen = str_len(s);

        if (slen == 2) {
            var sub_path = alloc_or_die(16);
            memcpy(sub_path, ".sit/objects/", 13);
            memcpy(sub_path + 13, sdata, 2);
            store8(sub_path + 15, 0);

            var files = sf_dir_list(str_from(sub_path));
            var fn_ct = vec_len(files);
            var fi = 0;
            while (fi < fn_ct) {
                var f = vec_get(files, fi);
                var fdata = str_data(f);
                var flen = str_len(f);

                if (flen == 62) {
                    var hex = alloc_or_die(65);
                    memcpy(hex, sdata, 2);
                    memcpy(hex + 2, fdata, 62);
                    store8(hex + 64, 0);

                    var loose_path = alloc_or_die(96);
                    object_path(loose_path, hex);
                    var pair[16];
                    if (read_file_heap(loose_path, &pair) == 0) {
                        var compressed = load64(&pair);
                        var clen = load64(&pair + 8);

                        # Sniff type from decompressed header for the INT column
                        # (obj_inflate_fl, 1.7.6 — freed once sniffed).
                        var sniff[24];
                        var type_code = 0;
                        if (obj_inflate_fl(compressed, clen, &sniff) == 0) {
                            var decompressed = load64(&sniff);
                            var dlen = load64(&sniff + 8);
                            if (dlen > 5) {
                                if (memeq(decompressed, "blob ", 5) == 1) { type_code = 0; }
                                else {
                                    if (memeq(decompressed, "tree ", 5) == 1) { type_code = 1; }
                                    else {
                                        if (dlen > 7) {
                                            if (memeq(decompressed, "commit ", 7) == 1) { type_code = 2; }
                                        }
                                    }
                                }
                            }
                            fl_free(decompressed);
                        }

                        var types[24];
                        store64(&types + 0, 1);
                        store64(&types + 8, 0);
                        store64(&types + 16, 2);
                        var ivals[24];
                        store64(&ivals + 8, type_code);
                        var sptrs[24];
                        store64(&sptrs + 0, hex);
                        var slens[24];
                        store64(&slens + 0, 64);
                        var bptrs[24];
                        store64(&bptrs + 16, compressed);
                        var blens[24];
                        store64(&blens + 16, clen);
                        # 1.7.1: unlink only what the table now holds. A
                        # refused insert keeps the loose file for the next open;
                        # or-ignore makes that retry skip a row that did land.
                        if (patra_insert_row_or_ignore(db, "objects", 7, 3,
                            &types, &ivals, &sptrs, &slens, &bptrs, &blens) == PATRA_OK) {
                            sf_unlink(loose_path);
                        }
                    }
                }
                fi = fi + 1;
            }
            sf_rmdir(sub_path);
        }
        di = di + 1;
    }
    return 0;
}

# Read a ref tip file (heads/tags/remotes leaf) — trim trailing CR/LF,
# validate 64-hex, return a heap-allocated 65-byte cstring or 0 on
# malformed content. Caller does not free (bump-allocated for the life
# of the fsck pass).
fn fsck_read_ref_tip(path) {
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0; }
    var data = load64(&pair);
    var len = load64(&pair + 8);
    # Trim trailing CR/LF (cyrius `break` in while-with-var is unreliable,
    # so use a flag).
    var trimming = 1;
    while (trimming == 1) {
        if (len == 0) { trimming = 0; }
        else {
            var lc = load8(data + len - 1) & 0xFF;
            if (lc == 10) { len = len - 1; }
            else {
                if (lc == 13) { len = len - 1; }
                else { trimming = 0; }
            }
        }
    }
    # 1.6.4 (D9): accept exactly what the ref resolver accepts (refs.cyr: the
    # first 64 bytes hex, whatever follows). Requiring exactly 64 bytes made a
    # ref with a trailing space or a comment usable by every command yet NOT an
    # fsck root, so with no reflog behind it `--prune-now` deleted the branch.
    # A root that is too generous only keeps objects; a strict one loses them.
    if (len < 64) { return 0; }
    if (hex_prefix_valid(data, 64) == 0) { return 0; }
    var out = alloc(65);
    memcpy(out, data, 64);
    store8(out + 64, 0);
    return out;
}

# Walk one refs subtree (`.sit/refs/heads` etc.) and push every valid
# tip hex into `roots`. Missing dir is a no-op. Malformed ref files are
# silently skipped — the integrity pass surfaces unreachable objects,
# and a broken ref shows up there as a dangling chain.
fn fsck_walk_refs_dir(dir, roots) {
    if (sf_exists(dir) != 1) { return 0; }
    var files = vec_new();
    dir_walk(str_from(sit_abs(dir)), files);   # abs: cwd-independent (fsck off-cwd / agnos)
    var i = 0;
    while (i < vec_len(files)) {
        var fp_str = vec_get(files, i);
        var fp_len = str_len(fp_str);
        var fp_data = str_data(fp_str);
        var fs_cstr = alloc(fp_len + 1);
        memcpy(fs_cstr, fp_data, fp_len);
        store8(fs_cstr + fp_len, 0);
        var hex = fsck_read_ref_tip(fs_cstr);
        if (hex != 0) { vec_push(roots, hex); }
        i = i + 1;
    }
    return 0;
}

# Collect every reachability root from the on-disk refs:
#   .sit/refs/heads/<*>, .sit/refs/tags/<*>, .sit/refs/remotes/<*>/<*>
# plus .sit/HEAD when it's a raw hex (detached) rather than symbolic.
# Symbolic HEAD targets are already covered by the matching ref file.
# Add every reflog entry's old+new oid (across all .sit/logs/** files) to
# `roots`. This is the reflog-reachability half of the v1.1.0 prune grace:
# an object referenced by any reflog entry is reachable, so `fsck --prune`
# won't drop the very commits the reflog exists to recover (e.g. the tip a
# `reset --hard` discarded). Mirrors git fsck's default reflog-as-roots.
fn fsck_collect_reflog_roots(roots) {
    if (sf_exists(".sit/logs") != 1) { return 0; }
    var files = vec_new();
    dir_walk(str_from(sit_abs(".sit/logs")), files);   # abs: cwd-independent
    var i = 0;
    while (i < vec_len(files)) {
        var fp = vec_get(files, i);
        var fl = str_len(fp);
        var fc = alloc(fl + 1);
        memcpy(fc, str_data(fp), fl);
        store8(fc + fl, 0);
        var pair[16];
        if (read_file_heap(fc, &pair) == 0) {
            _reflog_collect_oids(load64(&pair), load64(&pair + 8), roots);
        }
        i = i + 1;
    }
    return 0;
}

# Collect ONLY the refs/HEAD roots (heads, tags, remotes, detached HEAD).
# Reflog roots are collected separately by cmd_fsck via
# fsck_collect_reflog_roots so the "every object unreachable" prune tripwire
# can judge corruption from the refs set alone — a stale reflog must not mask
# a wiped HEAD/refs and let --prune delete a ref-only-reachable branch.
fn fsck_collect_roots() {
    var roots = vec_new();
    fsck_walk_refs_dir(".sit/refs/heads",   roots);
    fsck_walk_refs_dir(".sit/refs/tags",    roots);
    fsck_walk_refs_dir(".sit/refs/remotes", roots);

    # v1.5.1: .sit/refs/stash is a root. It is a single ref file rather than a
    # directory, so the refs-dir walk above never sees it — and without this
    # every stashed blob and tree reads as dangling and `fsck --prune-now`
    # DELETES the stash. Same class as the 1.5.0 tag-object bug and the S-27
    # missing-referent bug: the walk not knowing about an edge.
    if (sf_exists(".sit/refs/stash") == 1) {
        var spair[16];
        if (read_file_heap(".sit/refs/stash", &spair) == 0) {
            var sdata = load64(&spair);
            var slen = load64(&spair + 8);
            if (slen >= 64) {
                if (hex_prefix_valid(sdata, 64) == 1) {
                    var shex = alloc(65);
                    memcpy(shex, sdata, 64);
                    store8(shex + 64, 0);
                    vec_push(roots, shex);
                }
            }
        }
    }

    if (sf_exists(".sit/HEAD") == 1) {
        var pair[16];
        if (read_file_heap(".sit/HEAD", &pair) == 0) {
            var data = load64(&pair);
            var len = load64(&pair + 8);
            var trimming = 1;
            while (trimming == 1) {
                if (len == 0) { trimming = 0; }
                else {
                    var lc = load8(data + len - 1) & 0xFF;
                    if (lc == 10) { len = len - 1; }
                    else {
                        if (lc == 13) { len = len - 1; }
                        else { trimming = 0; }
                    }
                }
            }
            if (len == 64) {
                if (hex_prefix_valid(data, 64) == 1) {
                    var hex = alloc(65);
                    memcpy(hex, data, 64);
                    store8(hex + 64, 0);
                    vec_push(roots, hex);
                }
            }
        }
    }
    return roots;
}

# Extract every `parent <hex>\n` from a commit body and push each as a
# fresh 65-byte cstring into `parents`. Distinct from parse_commit_body,
# which captures only the LAST parent line (merge commits have two);
# reachability MUST follow both legs or merged-only objects appear
# dangling. Stops at the first blank line (end of headers).
fn fsck_collect_commit_parents(body, body_len, parents) {
    var pos = 0;
    var done = 0;
    while (done == 0) {
        if (pos >= body_len) { done = 1; }
        else {
            # Find end of current line (cyrius `break` in while-with-var
            # is unreliable, so use a flag).
            var le = pos;
            var scanning = 1;
            while (scanning == 1) {
                if (le >= body_len) { scanning = 0; }
                else {
                    if (load8(body + le) == 10) { scanning = 0; }
                    else { le = le + 1; }
                }
            }
            var line_len = le - pos;
            if (line_len == 0) { done = 1; }
            else {
                if (line_len >= 71) {
                    if (memeq(body + pos, "parent ", 7) == 1) {
                        if (hex_prefix_valid(body + pos + 7, 64) == 1) {
                            var p = alloc(65);
                            memcpy(p, body + pos + 7, 64);
                            store8(p + 64, 0);
                            vec_push(parents, p);
                        }
                    }
                }
                pos = le + 1;
            }
        }
    }
    return 0;
}

# Extract `tree <hex>\n` from a commit body. Returns a heap-allocated
# 65-byte hex cstring, or 0 if absent / malformed. Looks at the first
# line only — git always emits `tree` as the very first header.
fn fsck_extract_commit_tree(body, body_len) {
    # 1.6.4 (D4): the SAME header parser log, show, checkout and the wire walk
    # use. This accepted `tree` only on the first line while parse_commit_body
    # takes it from any header line, so a commit with `parent` first (a hostile
    # fetch or push could deliver one) was fully usable everywhere — yet fsck
    # never walked its tree, and `--prune-now` deleted it.
    var info[56];
    if (parse_commit_body(body, body_len, &info) != 0) { return 0; }
    var t = load64(&info);
    if (t == 0) { return 0; }
    if (hex_prefix_valid(t, 64) == 0) { return 0; }
    return t;
}

# Reachability walker for fsck. BFS from `root` over the object graph,
# marking each visited hex in `seen` (map_new, cstr-keyed). Commits
# enqueue their tree + every parent hex; trees enqueue every entry
# (sub-trees and blobs); blobs are leaves. Missing / unreadable objects
# get marked in `seen` so we don't loop, but no children are enqueued.
# Type detection is by framing prefix ("blob "/"tree "/"commit ").
#
# Distinct from `walk_reachable_phased` in src/wire.cyr: that walker
# only follows the first parse_commit_body-captured parent (which is
# actually the LAST parent line in the body — a pre-existing limitation
# that doesn't show up in CI because the fixtures are linear).
# Reachability must traverse every parent edge or merge-only objects
# look dangling.
# S-27: referents the reachability walk could not resolve.
#
# `fsck` enumerated only objects that are IN the store, flagging those it could
# not read as `unreadable`. An object that is simply ABSENT — a commit whose
# `parent` or `tree` names an oid the store does not contain — was never
# enumerated at all, and the walk below silently skipped what it could not read.
# So the canonical broken-repo shape reported `0 bad, 0 dangling`. That is the
# single most useful thing fsck can tell you, and sit did not say it.
#
# These record every hex whose read failed during the walk. `cmd_fsck` then
# splits them: already in the store => the integrity pass has already reported
# it `unreadable` (do not double-count); not in the store => report `missing`,
# which is what git calls it, and count it toward `bad`.
var _fsck_missing = 0;
var _fsck_missing_seen = 0;

# Shallow-clone boundary set: the commits in `.sit/shallow` whose parents were
# deliberately NOT fetched (v0.8.12 `clone --depth`). Defined here rather than in
# commit.cyr because `object_db.cyr` precedes it in the include chain and the
# dist bundle is single-pass — fsck needs it, and cmd_log (later) reuses it.
#
# S-27: this is why `missing` detection cannot simply flag every unresolvable
# referent. A shallow clone's boundary parents are absent BY DESIGN, and the
# integration suite already asserted `--depth 1` fscks clean — it caught the
# first cut of this change immediately. git draws the same distinction via
# `.git/shallow`.
fn load_shallow_set() {
    var shallow = map_new();
    if (sf_exists(".sit/shallow") == 1) {
        var spair[16];
        if (read_file_heap(".sit/shallow", &spair) == 0) {
            var sbuf = load64(&spair);
            var slen = load64(&spair + 8);
            var sp = 0;
            while (sp + 64 <= slen) {
                var hh = alloc_or_die(65);
                memcpy(hh, sbuf + sp, 64);
                store8(hh + 64, 0);
                map_set(shallow, hh, 1);
                sp = sp + 65;
            }
        }
    }
    return shallow;
}

# Boundary set for the active fsck walk; 0 outside one.
var _fsck_shallow = 0;
# Oids a shallow boundary commit names as parents: walked when present, never
# reported missing when absent (D2, 1.6.4). Reset per fsck run.
var _fsck_optional = 0;

# 1.7.6 (R12): reachable commits whose headers do not parse (no `tree` on line
# 1, a second `tree`, a parent after other headers). Every reader refuses such
# a commit, and the walk cannot follow its tree — so it is corruption, counted
# toward `bad`, which also keeps `--prune` from deleting what it names.
var _fsck_malformed = 0;

# Reset fsck's missing-object list and its dedup set.
fn fsck_missing_reset() {
    _fsck_missing = vec_new();
    _fsck_missing_seen = map_new();
    _fsck_malformed = vec_new();
    return 0;
}

# Record `hex` as referenced-but-missing, once.
fn fsck_missing_record(hex) {
    if (_fsck_missing_seen == 0) { return 0; }
    if (map_has(_fsck_missing_seen, hex) == 1) { return 0; }
    map_set(_fsck_missing_seen, hex, 1);
    var copy = alloc(65);
    memcpy(copy, hex, 64);
    store8(copy + 64, 0);
    vec_push(_fsck_missing, copy);
    return 0;
}

# Objects fsck found referenced but absent.
fn fsck_missing_vec() { return _fsck_missing; }

# Mark every object reachable from `root` in `seen`, recording referenced-but-missing ones.
fn fsck_walk_reachable(root, seen) {
    var queue = vec_new();
    vec_push(queue, root);
    while (vec_len(queue) > 0) {
        var hex = vec_get(queue, vec_len(queue) - 1);
        vec_pop(queue);
        if (map_has(seen, hex) == 0) {
            map_set(seen, hex, 1);
            var obj[24];
            # One read, branched on — fsck walks the whole graph, so a second
            # probe here would double every object's DB read.
            var rc = read_object(hex, &obj);
            if (rc != 0) {
                # A shallow boundary's parent may legitimately be absent.
                var optional = 0;
                if (_fsck_optional != 0) { optional = map_has(_fsck_optional, hex); }
                if (optional == 0) { fsck_missing_record(hex); }
            }
            if (rc == 0) {
                var buf = load64(&obj);
                var blen = load64(&obj + 8);
                var coff = load64(&obj + 16);
                var body = buf + coff;
                var body_len = blen - coff;
                # Classify by framing prefix.
                if (blen >= 7) {
                    if (memeq(buf, "commit ", 7) == 1) {
                        var t = fsck_extract_commit_tree(body, body_len);
                        if (t != 0) {
                            if (map_has(seen, t) == 0) { vec_push(queue, t); }
                        }
                        else {
                            if (_fsck_malformed != 0) { vec_push(_fsck_malformed, hex); }
                        }
                        # S-27: a shallow boundary commit's parents were never
                        # fetched, so they may be absent on purpose — don't
                        # record them as missing.
                        #
                        # 1.6.4 (D2): but DO walk the ones that are present.
                        # This skipped them outright, and `fetch` on a shallow
                        # clone brings the full history in without touching
                        # .sit/shallow — so every fetched ancestor read as
                        # dangling and `--prune-now` deleted the history,
                        # which the repo then served to clones as missing.
                        var at_boundary = 0;
                        if (_fsck_shallow != 0) {
                            if (map_has(_fsck_shallow, hex) == 1) { at_boundary = 1; }
                        }
                        var parents = vec_new();
                        fsck_collect_commit_parents(body, body_len, parents);
                        var pi = 0;
                        while (pi < vec_len(parents)) {
                            var p = vec_get(parents, pi);
                            if (at_boundary == 1) {
                                if (_fsck_optional == 0) { _fsck_optional = map_new(); }
                                map_set(_fsck_optional, p, 1);
                            }
                            if (map_has(seen, p) == 0) { vec_push(queue, p); }
                            pi = pi + 1;
                        }
                    }
                }
                if (blen >= 5) {
                    if (memeq(buf, "tree ", 5) == 1) {
                        var entries = parse_tree(body, body_len);
                        var en = vec_len(entries);
                        var ei = 0;
                        while (ei < en) {
                            var e = vec_get(entries, ei);
                            var ehash = tree_entry_hash(e);
                            if (map_has(seen, ehash) == 0) {
                                var ec = alloc(65);
                                memcpy(ec, ehash, 64);
                                store8(ec + 64, 0);
                                vec_push(queue, ec);
                            }
                            ei = ei + 1;
                        }
                    }
                }
                # v1.5.0: an annotated tag object names its target in an
                # `object` header. Without this the walk treats a tag as a LEAF
                # and never reaches the commit it tags — so a commit reachable
                # only through a tag reads as dangling, and `fsck --prune-now`
                # deletes it. Same shape as the S-27 missing-referent bug: the
                # walk not knowing about an edge, not the edge being absent.
                #
                # "tag " (4) cannot collide with "tree " (5) — second byte
                # differs — so the prefix test is unambiguous.
                if (blen >= 4) {
                    if (memeq(buf, "tag ", 4) == 1) {
                        var tinfo[40];
                        if (parse_tag_body(body, body_len, &tinfo) == 0) {
                            var tgt = load64(&tinfo);
                            if (tgt != 0) {
                                if (map_has(seen, tgt) == 0) { vec_push(queue, tgt); }
                            }
                        }
                    }
                }
                # blob: leaf — no further enqueue.
            }
        }
    }
    return 0;
}

# Map the patra `ty` INT back to the canonical word for dangling
# output. Returns 0 if unknown — caller falls back to "object".
fn fsck_ty_word(ty) {
    if (ty == 0) { return "blob"; }
    if (ty == 1) { return "tree"; }
    if (ty == 2) { return "commit"; }
    if (ty == 3) { return "tag"; }
    return 0;
}

# fsck — integrity + reachability.
#
# Integrity pass: SELECT every (hash, ty) from .sit/objects.patra; for
# each, read+decompress and sigil-rehash the framed body against the
# stored hex. Mismatch / unreadable rows are emitted on stderr and
# count toward `bad`.
#
# Reachability pass (v0.8.5): collect roots from refs/heads/tags/remotes
# + detached HEAD + every staged index entry; BFS the object graph
# from each root marking `seen`; any object in the integrity inventory
# that isn't in `seen` is dangling. Dangling objects are reported on
# stdout one per line in `dangling <type> <hex>` format (git-shaped);
# they don't fail the command — only integrity errors set non-zero
# exit, mirroring git's policy that dangling objects are expected
# after resets / rewinds.
# Delete a single object row by hex (v0.8.14, fsck --prune). The hex is
# validated 64-char hex before interpolation — even though it comes from the
# inventory SELECT, never build SQL from unchecked bytes. Returns patra_exec's
# code (0 = ok), or -1 if the hex fails validation.
fn db_object_delete(db, hex) {
    if (hex_prefix_valid(hex, 64) == 0) { return 0 - 1; }
    var sql = alloc(128);
    memcpy(sql, "DELETE FROM objects WHERE hash = '", 34);
    memcpy(sql + 34, hex, 64);
    memcpy(sql + 34 + 64, "'", 1);
    store8(sql + 34 + 64 + 1, 0);
    return patra_exec(db, sql);
}

# Extract a commit's author timestamp (unix seconds) from its raw body, for
# the prune age-window check. The ident line is "author NAME <EMAIL> TS TZ";
# TS is the second-to-last space-delimited token. Returns 0 if no parseable
# author line (caller then treats the object as undatable). Self-contained
# (parse_commit_body lives in the later commit.cyr module, out of bundle reach).
fn _fsck_commit_author_ts(body, len) {
    var i = 0;
    var astart = 0 - 1;
    var scanning = 1;
    while (scanning == 1) {
        if (i + 7 > len) { scanning = 0; }
        else {
            var at_ls = 0;
            if (i == 0) { at_ls = 1; }
            else { if (load8(body + i - 1) == 10) { at_ls = 1; } }
            if (at_ls == 1) {
                if (memeq(body + i, "author ", 7) == 1) { astart = i + 7; scanning = 0; }
            }
            if (scanning == 1) { i = i + 1; }
        }
    }
    if (astart < 0) { return 0; }

    var aend = astart;
    var f2 = 1;
    while (f2 == 1) {
        if (aend >= len) { f2 = 0; }
        else { if (load8(body + aend) == 10) { f2 = 0; } else { aend = aend + 1; } }
    }

    # Walk back over the TZ token to the space before it → that's ts_end.
    var p = aend - 1;
    var s1 = 1;
    while (s1 == 1) {
        if (p < astart) { s1 = 0; }
        else { if (load8(body + p) == 32) { s1 = 0; } else { p = p - 1; } }
    }
    var ts_end = p;
    # ts_start = one past the previous space.
    var ts_start = ts_end;
    var s2 = 1;
    while (s2 == 1) {
        if (ts_start - 1 < astart) { s2 = 0; }
        else {
            if (load8(body + ts_start - 1) == 32) { s2 = 0; }
            else { ts_start = ts_start - 1; }
        }
    }
    if (ts_start >= ts_end) { return 0; }

    var val = 0;
    var k = ts_start;
    var okp = 1;
    while (k < ts_end) {
        var d = load8(body + k);
        if (d < 48) { okp = 0; k = ts_end; }
        else {
            if (d > 57) { okp = 0; k = ts_end; }
            else { val = val * 10 + (d - 48); k = k + 1; }
        }
    }
    if (okp == 0) { return 0; }
    return val;
}

# `sit fsck [--prune|--prune-now]` — verify object integrity and reachability; --prune removes dangling objects.
fn cmd_fsck() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    # `--prune` removes dangling (unreachable) objects this walk identifies.
    # v1.1.0 added two grace mechanisms vs the old unconditional --prune=now:
    #   (1) reflog reachability — every .sit/logs/** entry's oids are roots
    #       (fsck_collect_reflog_roots), so a reset-discarded tip is protected
    #       as long as its reflog entry exists; and
    #   (2) an age window — a still-dangling object is kept unless it's older
    #       than the grace window. Datable objects are commits (author ts);
    #       trees/blobs can't be dated, so a positive window keeps them.
    # `--prune` uses a 90-day window (git's gc.reflogExpire default); the
    # legacy immediate behaviour is `--prune-now` (grace 0, like
    # `git gc --prune=now`). Both are refused mid-merge (.sit/MERGE_HEAD).
    var prune = 0;
    var grace_days = 90;
    var ai = 2;
    while (ai < argc()) {
        if (streq(argv(ai), "--prune") == 1) { prune = 1; }
        if (streq(argv(ai), "--prune-now") == 1) { prune = 1; grace_days = 0; }
        ai = ai + 1;
    }
    if (prune == 1) {
        # 1.6.4 (A9): a rebase, cherry-pick or revert in progress holds commits
        # only its state files name — the original tip in REBASE_ORIG, the rest
        # of the branch in rebase-todo. With the reflog gone those were pruned,
        # and --abort then wrote a dangling oid and emptied the worktree.
        if (sf_exists(".sit/REBASE_ORIG") == 1) {
            eprintln("sit: refusing --prune during an in-progress rebase (.sit/REBASE_ORIG present)");
            return 1;
        }
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) {
            eprintln("sit: refusing --prune during an in-progress cherry-pick (.sit/CHERRY_PICK_HEAD present)");
            return 1;
        }
        if (sf_exists(".sit/REVERT_HEAD") == 1) {
            eprintln("sit: refusing --prune during an in-progress revert (.sit/REVERT_HEAD present)");
            return 1;
        }
        if (sf_exists(".sit/MERGE_HEAD") == 1) {
            eprintln("sit: refusing --prune during an in-progress merge (.sit/MERGE_HEAD present)");
            return 1;
        }
    }

    var db = get_object_db();
    if (db == 0) {
        stdout_write("checked 0 objects, 0 bad, 0 dangling\n", 37);
        return 0;
    }

    # Integrity pass. v0.8.5: pull `ty` alongside `hash` so the
    # reachability report can emit `dangling <type> <hex>` without a
    # second read per dangling object.
    var rs = patra_query(db, "SELECT hash, ty FROM objects");
    var total = 0;
    var bad = 0;
    var hashes = vec_new();
    var ty_map = map_new();
    if (rs != 0) {
        var count = patra_result_count(rs);
        var i = 0;
        while (i < count) {
            var s = patra_result_get_str(rs, i, 0);
            var ty = patra_result_get_int(rs, i, 1);
            var copy = alloc_or_die(65);
            memcpy(copy, s, 64);
            store8(copy + 64, 0);
            vec_push(hashes, copy);
            map_set(ty_map, copy, ty + 1);
            i = i + 1;
        }
        patra_result_free(rs);
    }

    # 1.10.0: rows and packs are checked apart, each through its own reader —
    # read_object tries the packs first, so a row that duplicates a packed
    # object would otherwise never be read. An object both hold is checked in
    # both, and counted once.
    var nrows = vec_len(hashes);
    var packed = map_new();
    var poids = vec_new();
    if (sit_pack_oids(0, poids) < 0) {
        eprintln("bad pack index under .sit/packs (malformed .idx)");
        bad = bad + 1;
    }
    bad = bad + sit_pack_verify_files(0);
    var pk = 0;
    while (pk < vec_len(poids)) {
        var ph = vec_get(poids, pk);
        if (map_has(packed, ph) == 0) {
            map_set(packed, ph, 1);
            if (map_has(ty_map, ph) == 0) { vec_push(hashes, ph); }
        }
        pk = pk + 1;
    }

    var hn = vec_len(hashes);
    var hi = 0;
    while (hi < hn) {
        var hex = vec_get(hashes, hi);
        var from_row = 0;
        if (hi < nrows) { from_row = 1; }
        var readable = 0;
        var step = 0;
        while (step < 2) {
            var want = 0;
            if (step == 0) { want = from_row; }
            else { want = map_has(packed, hex); }
            if (want == 1) {
                var obj[24];
                var rr = 0;
                if (step == 0) { rr = db_row_read(db, hex, &obj); }
                else { rr = sit_pack_read(0, hex, &obj); }
                if (rr == 0) {
                    readable = 1;
                    var buf = load64(&obj);
                    var blen = load64(&obj + 8);
                    var actual = hash_data(buf, blen);
                    if (streq(hex, actual) == 0) {
                        syscall(SYS_WRITE, STDERR, "bad object ", 11);
                        syscall(SYS_WRITE, STDERR, hex, 64);
                        syscall(SYS_WRITE, STDERR, "\n", 1);
                        bad = bad + 1;
                    }
                    else {
                        # A packed object's type comes from its framing.
                        if (map_has(ty_map, hex) == 0) {
                            var sp0 = 0;
                            while (load8(buf + sp0) != 32) { sp0 = sp0 + 1; }
                            map_set(ty_map, hex, type_code_of(buf, sp0) + 1);
                        }
                    }
                    fl_free(buf);
                }
                else {
                    syscall(SYS_WRITE, STDERR, "unreadable ", 11);
                    syscall(SYS_WRITE, STDERR, hex, 64);
                    syscall(SYS_WRITE, STDERR, "\n", 1);
                    bad = bad + 1;
                }
            }
            step = step + 1;
        }
        total = total + readable;
        # An unreadable packed object still counts as stored (S-27 below).
        if (map_has(ty_map, hex) == 0) { map_set(ty_map, hex, 0 - 1); }
        hi = hi + 1;
    }

    # Reachability pass (v0.8.5). Refs/HEAD roots first (count retained for
    # the prune corrupt-roots tripwire), then reflog roots appended (v1.1.0).
    var seen = map_new();
    # S-26: parse_tree silently discards entries with a bad mode or unsafe name,
    # so their objects are never enqueued below. Track that across the walk.
    tree_dropped_reset();
    # S-27: collect referents the walk cannot resolve (see fsck_missing_*),
    # and load the shallow boundary set so intentionally-absent parents of a
    # `clone --depth` boundary are not mistaken for corruption.
    fsck_missing_reset();
    _fsck_shallow = load_shallow_set();
    _fsck_optional = 0;
    var roots = fsck_collect_roots();
    var ref_root_count = vec_len(roots);
    fsck_collect_reflog_roots(roots);
    var ri = 0;
    while (ri < vec_len(roots)) {
        fsck_walk_reachable(vec_get(roots, ri), seen);
        ri = ri + 1;
    }

    # Staged blobs count as roots — without this, every `sit add` that
    # hasn't been committed yet would look dangling. (Mirrors git's
    # implicit-keep of `git ls-files` blobs during fsck.)
    var idx_entries = parse_index();
    # 1.7.2: an index on disk that will not open (an unfinished v0.1
    # migration, a corrupt index.patra) reads as "nothing staged" here, so
    # every blob only it references would look dangling.
    var idx_unreadable = 0;
    if (idx_entries == 0) {
        if (index_files_present() == 1) {
            if (get_index_db() == 0) { idx_unreadable = 1; }
        }
    }
    if (idx_unreadable == 1) {
        eprintln("sit: warning: the staging index cannot be read; blobs it stages count as dangling");
    }
    if (idx_entries != 0) {
        var ii = 0;
        while (ii < vec_len(idx_entries)) {
            var e = vec_get(idx_entries, ii);
            var bin = entry_hash(e);
            var ihex = hex_encode(bin, 32);
            if (map_has(seen, ihex) == 0) { map_set(seen, ihex, 1); }
            ii = ii + 1;
        }
    }

    # Diff: objects in the inventory but not reachable.
    var dangling = 0;
    var dangling_hexes = vec_new();
    var di = 0;
    while (di < hn) {
        var hex2 = vec_get(hashes, di);
        if (map_has(seen, hex2) == 0) {
            var stored = map_get(ty_map, hex2);
            var ty_word = 0;
            if (stored > 0) { ty_word = fsck_ty_word(stored - 1); }
            if (ty_word == 0) { ty_word = "object"; }
            stdout_write("dangling ", 9);
            stdout_write(ty_word, strlen(ty_word));
            stdout_write(" ", 1);
            stdout_write(hex2, 64);
            stdout_write("\n", 1);
            dangling = dangling + 1;
            vec_push(dangling_hexes, hex2);
        }
        di = di + 1;
    }

    # S-27: report referents that could not be resolved at all.
    #
    # A hex recorded by the walk is one whose read failed. Split it:
    #   * present in ty_map => it IS stored, just unreadable — the integrity
    #     pass above already printed `unreadable` and counted it. Skip, or the
    #     same object is counted twice.
    #   * absent from ty_map => nothing in the store has that oid, yet a live
    #     commit or tree references it. That is git's `missing`, and it is the
    #     broken-repo shape sit previously called clean.
    #
    # Counted toward `bad` so the `--prune` tripwire covers it for free: pruning
    # a repo that is already missing objects would compound the damage.
    var miss_vec = fsck_missing_vec();
    var mi = 0;
    while (mi < vec_len(miss_vec)) {
        var mhex = vec_get(miss_vec, mi);
        if (map_get(ty_map, mhex) == 0) {
            syscall(SYS_WRITE, STDERR, "missing ", 8);
            syscall(SYS_WRITE, STDERR, mhex, 64);
            syscall(SYS_WRITE, STDERR, "\n", 1);
            bad = bad + 1;
        }
        mi = mi + 1;
    }

    var mal = _fsck_malformed;
    var mli = 0;
    if (mal != 0) {
        while (mli < vec_len(mal)) {
            syscall(SYS_WRITE, STDERR, "malformed commit ", 17);
            syscall(SYS_WRITE, STDERR, vec_get(mal, mli), 64);
            syscall(SYS_WRITE, STDERR, " (header order: tree first, once; parents next)\n", 48);
            bad = bad + 1;
            mli = mli + 1;
        }
    }

    # 1.6.4: a reachable tree with entries parse_tree had to drop (bad mode,
    # unsafe name, duplicate or out-of-order name) is a structural defect in
    # its own right — git's fsck errors on duplicateEntries / treeNotSorted —
    # not only a reason to refuse --prune (below). Report it and fail.
    var dropped = tree_dropped_count();
    if (dropped > 0) {
        var dbuf[24];
        var dd = write_decimal(&dbuf, dropped);
        syscall(SYS_WRITE, STDERR, "malformed tree entries: ", 24);
        syscall(SYS_WRITE, STDERR, &dbuf, dd);
        syscall(SYS_WRITE, STDERR, " (bad mode, unsafe name, duplicate or out-of-order) — checkout ignores them\n", 78);
    }

    stdout_write("checked ", 8);
    write_unsigned(total);
    stdout_write(" objects, ", 10);
    write_unsigned(bad);
    stdout_write(" bad, ", 6);
    write_unsigned(dangling);
    stdout_write(" dangling\n", 10);

    # v0.8.14: prune the dangling set. Deletes each unreachable object, then
    # flushes (the main trailer only flushes stdout, not patra) so the removal
    # is durable across the process exit. Reachable history is untouched —
    # only objects absent from the reachability walk are removed.
    if (prune == 1) {
        # Data-loss guard: the reachability walk SKIPS unreadable objects
        # (read_object failure → its children are never enqueued), so a single
        # corrupt interior commit/tree would orphan its whole subgraph into the
        # dangling set. Pruning then deletes genuinely-reachable objects with no
        # reflog to recover them. Refuse while any object is bad/unreadable.
        if (bad > 0) {
            eprintln("sit: refusing --prune with bad/unreadable objects — resolve integrity first");
            return 1;
        }
        # S-26: the same data-loss shape, one level down. An UNREADABLE object
        # orphans its subgraph (guarded above); an object that reads fine but
        # whose tree body carries an entry parse_tree discards — a non-allowlisted
        # mode like 100755, or a name like `.git` — orphans that entry's blob or
        # subtree just as thoroughly, while `bad` stays 0 and the walk reports it
        # as merely `dangling`. Pruning then deleted an object a live tree still
        # references. A malformed tree is structural corruption; refuse.
        if (tree_dropped_count() > 0) {
            eprintln("sit: refusing --prune — a reachable tree has entries sit cannot use (see above)");
            eprintln("sit:   their objects cannot be proven reachable and would be deleted while still referenced");
            return 1;
        }
        if (idx_unreadable == 1) {
            eprintln("sit: refusing --prune — the staging index cannot be read (see above)");
            return 1;
        }
        # If EVERY object is unreachable, the roots are almost certainly broken
        # (corrupt / missing HEAD or refs), not the objects. Pruning would wipe
        # the whole store. Refuse.
        if (total > 0) {
            if (dangling == total) {
                eprintln("sit: refusing --prune — every object is unreachable (corrupt or missing HEAD/refs?)");
                return 1;
            }
        }
        # Corrupt-roots tripwire: a stale .sit/logs must not stand in for a
        # wiped HEAD/refs. If there are NO refs/HEAD roots (only reflog roots),
        # the ref store is broken — pruning would delete any branch that was
        # never reflogged. Refuse unless there are objects but genuinely no
        # refs at all is impossible after init (HEAD always resolves once a
        # commit exists), so an empty ref-root set with objects present is the
        # corruption signal.
        if (total > 0) {
            if (ref_root_count == 0) {
                eprintln("sit: refusing --prune — no valid refs/HEAD roots (corrupt or missing HEAD/refs?)");
                return 1;
            }
        }
        # Age window: keep a still-dangling object unless it's older than the
        # grace window (grace 0 deletes everything dangling — the old
        # --prune=now behaviour). Only commits carry a timestamp (author ts).
        #
        # 1.8.0: trees and blobs are dated by the commits that reach them. One
        # reachable only from dangling commits past the window goes with them;
        # one a kept dangling commit reaches stays; one no dangling commit
        # reaches (a blob staged and abandoned) is undatable and stays. Before,
        # every dangling tree and blob was kept under a positive window, so
        # expiring the reflog let `--prune` drop an old discarded commit but
        # never what it held.
        var now = clock_epoch_secs();
        var grace_secs = grace_days * 86400;
        var pruned = 0;
        var kept = 0;
        var kept_packed = 0;
        var nd = vec_len(dangling_hexes);
        var verdict = alloc_or_die(nd + 1);           # 0 delete, 1 keep, 2 tree/blob: decide below
        var expired_reach = map_new();
        var kept_reach = map_new();
        var pi = 0;
        while (pi < nd) {
            var dhex = vec_get(dangling_hexes, pi);
            store8(verdict + pi, 0);
            if (grace_secs > 0) {
                # Conservative default under a positive window: KEEP unless we
                # can positively date the object past the window. An undatable
                # commit (unreadable body or unparseable ts) is kept — never
                # delete something we can't prove is old.
                store8(verdict + pi, 1);
                var dstored = map_get(ty_map, dhex);
                if (dstored == 3) {                 # ty 2 (commit) + 1
                    var co[24];
                    var old = 0;
                    if (read_object(dhex, &co) == 0) {
                        var cts = _fsck_commit_author_ts(load64(&co), load64(&co + 8));
                        if (cts > 0) {
                            if (now - cts >= grace_secs) { old = 1; }
                        }
                    }
                    if (old == 1) {
                        store8(verdict + pi, 0);
                        fsck_walk_reachable(dhex, expired_reach);
                    }
                    else { fsck_walk_reachable(dhex, kept_reach); }
                }
                else {
                    if (dstored == 1) { store8(verdict + pi, 2); }    # blob
                    if (dstored == 2) { store8(verdict + pi, 2); }    # tree
                }
            }
            pi = pi + 1;
        }
        pi = 0;
        while (pi < nd) {
            var dh = vec_get(dangling_hexes, pi);
            var v = load8(verdict + pi);
            if (v == 2) {
                v = 1;
                if (map_has(expired_reach, dh) == 1) {
                    if (map_has(kept_reach, dh) == 0) { v = 0; }
                }
            }
            # 1.10.0: a packed object is not a row to delete. It stays until the
            # next gc, which writes what is unreachable back as rows ("loosens"
            # it, as git's repack -A does) for a later --prune to judge.
            if (map_has(packed, dh) == 1) { v = 3; }
            if (v == 1) { kept = kept + 1; }
            if (v == 3) { kept_packed = kept_packed + 1; }
            if (v == 0) {
                if (db_object_delete(db, dh) == 0) { pruned = pruned + 1; }
            }
            pi = pi + 1;
        }
        # 1.7.2: since patra 1.16.2 a failed fdatasync is reported, and it
        # sticks to the handle, so this one flush answers for every DELETE.
        var flush_rc = patra_flush(db);
        stdout_write("pruned ", 7);
        write_unsigned(pruned);
        stdout_write(" objects", 8);
        if (kept > 0) {
            stdout_write(", kept ", 7);
            write_unsigned(kept);
            stdout_write(" within grace", 13);
        }
        if (kept_packed > 0) {
            stdout_write(", kept ", 7);
            write_unsigned(kept_packed);
            var kpm = " packed (the next `sit gc` loosens them)";
            stdout_write(kpm, strlen(kpm));
        }
        stdout_write("\n", 1);
        if (flush_rc != PATRA_OK) {
            eprintln("sit: the object store could not be synced; the pruning may not be durable");
            return 1;
        }
    }

    if (bad > 0) { return 1; }
    if (dropped > 0) { return 1; }
    return 0;
}

# The blob id `content` would get, without storing it.
fn hash_blob_of_content(content, content_len) {
    var full_cap = 32 + content_len;
    var full = alloc_or_die(full_cap);
    memcpy(full, "blob ", 5);
    var digits = write_decimal(full + 5, content_len);
    store8(full + 5 + digits, 0);
    var hdr_len = 5 + digits + 1;
    memcpy(full + hdr_len, content, content_len);
    return hash_data(full, hdr_len + content_len);
}

# Read a regular file into a heap buffer. Stores (buf_ptr, len) to out_pair.
# Returns 0 on success, negative on error.
fn hash_file_as_blob(path) {
    var pair[16];
    if (read_file_heap(path, &pair) != 0) { return 0; }
    return hash_blob_of_content(load64(&pair), load64(&pair + 8));
}

# Tree entry layout (24 bytes):
#   0..8:   mode ptr (heap cstring, e.g. "100644")
#   8..16:  name ptr (heap cstring)
#   16..24: hash_hex ptr (heap cstring, 64 chars + null)

# --- index.cyr ---

# index.cyr — staging index + .sitignore + cmd_add / cmd_rm / cmd_reset.
#
# Patra-backed index at .sit/index.patra. Git-parity `.sitignore` (v0.8.10):
# `*` / `?` / `[...]` char classes, `**` multi-segment wildcard, `!` negation
# (last match wins), and leading/middle `/` anchoring. See _wildmatch /
# is_ignored / load_sitignore below.

# `sit add [-f] <path>` — hash <path> into a blob and stage it in the index.
fn cmd_add() {
    if (argc() < 3) {
        eprintln("usage: sit add [-f] <path>");
        return 1;
    }

    var forced = 0;
    var arg_idx = 2;
    if (streq(argv(2), "-f") == 1) {
        forced = 1;
        arg_idx = 3;
        if (argc() < 4) {
            eprintln("usage: sit add -f <path>");
            return 1;
        }
    }
    var path = argv_heap(arg_idx);
    # 1.6.4 (B1): normalise and validate before anything is staged. `sit add
    # ./a.txt` used to stage the literal "./a.txt", which build_tree turned into
    # a `.` subtree that every reader drops — the file never reached a clone,
    # status listed it as new forever, and fsck called the live subtree
    # dangling. `..`, absolute paths and `.sit/...` were staged the same way.
    var stripping = 1;
    while (stripping == 1) {
        stripping = 0;
        if (strlen(path) > 2) {
            if (load8(path) == 46) {
                if (load8(path + 1) == 47) { path = path + 2; stripping = 1; }
            }
        }
    }
    var path_len = strlen(path);
    if (tree_flat_path_valid(path) == 0) {
        eprint3("sit: '", path, "' is not a path sit can track (relative, inside the repo, no '.' / '..' / .sit)\n");
        return 1;
    }
    # The index stores paths in a 255-byte column; a longer one could be
    # committed but never staged again (see rewrite_index).
    if (path_len > 255) {
        eprint3("sit: '", path, "' is longer than the 255-byte index path limit\n");
        return 1;
    }

    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    if (forced == 0) {
        if (is_ignored_scoped(path) == 1) {
            syscall(SYS_WRITE, STDERR, "sit: '", 6);
            syscall(SYS_WRITE, STDERR, path, path_len);
            syscall(SYS_WRITE, STDERR, "' matches a .sitignore pattern (use -f to override)\n", 52);
            return 1;
        }
    }

    # 1.7.6 (L14): the path is read, so it must not lead out of the repo. With
    # `linkdir -> /outside`, `sit add linkdir/secret.txt` staged (and the next
    # commit published) a file from outside the worktree; git refuses "beyond a
    # symbolic link". A symlink itself is not followed either: sit has no
    # symlink entries yet (git stores the link, not what it points at), and
    # storing the target's bytes would turn the link into a copy on checkout.
    if (_sf_parent_symlink(path) == 1) {
        eprint3("sit: '", path, "' is beyond a symbolic link\n");
        return 1;
    }
    if (path_lstat_kind(sit_abs(path)) == 0xA000) {
        eprint3("sit: '", path, "' is a symbolic link — sit does not track symlinks yet\n");
        return 1;
    }

    var fd = sf_open(path, 0, 0);
    if (fd < 0) {
        syscall(SYS_WRITE, STDERR, "sit: cannot open '", 18);
        syscall(SYS_WRITE, STDERR, path, path_len);
        syscall(SYS_WRITE, STDERR, "'\n", 2);
        return 1;
    }
    var size = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    syscall(SYS_LSEEK, fd, 0, SEEK_SET);
    if (size < 0) {
        file_close(fd);
        eprintln("sit: cannot stat file");
        return 1;
    }
    # S-06 cap, 1.6.4: at the READ ceiling, not 1 GiB (B5). A 20 MB file was
    # accepted and committed, and then every checkout, clone or reset of that
    # commit aborted on the unreadable blob.
    if (size > SIT_MAX_BLOB) {
        file_close(fd);
        eprintln("sit: file too large (sit stores blobs up to 16 MiB)");
        return 1;
    }

    var content = alloc(size);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var r = file_read(fd, content + total, size - total);
        if (r <= 0) { rgo = 0; }
        else { total = total + r; if (total >= size) { rgo = 0; } }
    }
    file_close(fd);

    var hex = write_blob_object(content, total);
    if (hex == 0) {
        eprintln("sit: failed to write object");
        return 1;
    }

    if (index_upsert(hex, path) != 0) {
        eprintln("sit: failed to update index");
        return 1;
    }

    stdout_write("added ", 6);
    stdout_write(hex, 12);
    stdout_write(" ", 1);
    write_sanitized(STDOUT, path, path_len);   # 1.7.6 (R13)
    stdout_write("\n", 1);
    return 0;
}

# Common setup for read-side commands: parse prefix, resolve to full hash,
# read+decompress. On success: writes 24-byte struct to obj_out, returns 0.
# On error: emits message to stderr and returns non-zero for main to return.
# v1.4.6 — index on entries(path), the precondition for index_upsert's
# targeted `DELETE ... WHERE path = ?`. Without it that delete degrades to a
# full scan and staging N files stays O(N^2) in time even though it is now
# O(N) in rows written.
#
# Same one-shot shape as _ensure_object_index (object_db.cyr): CREATE INDEX
# rebuilds the tree over every existing row, so it must run once, not per
# open. `.sit/index.indexed` is the marker, written only after a successful
# build, so an interrupted migration simply retries on the next open. Fresh
# repos build an empty tree (free); pre-1.4.6 repos pay one rebuild.
fn _ensure_entries_index(db) {
    if (sf_exists(".sit/index.indexed") == 1) { return 0; }
    if (patra_exec(db, "CREATE INDEX ON entries (path)") != 0) { return 0 - 1; }
    if (sf_write_atomic(".sit/index.indexed", "1\n", 2) < 0) { return 0 - 1; }
    return 0;
}

# Open (creating if needed) .sit/index.patra with its entries table and path index.
fn index_db_open() {
    if (patra_init() != PATRA_OK) { return 0; }       # 1.7.2: see object_db_open
    var db = sf_patra_open(".sit/index.patra");
    if (db == 0) { return 0; }
    # Idempotent — second call returns "already exists", which we ignore.
    patra_exec(db, "CREATE TABLE entries (path STR, hash_hex STR)");
    _ensure_entries_index(db);
    return db;
}

# v0.6.4: process-wide cache for .sit/index.patra. Same pattern as
# get_object_db (object_db.cyr). Lazy-open + lazy-migrate-from-plaintext.
var _index_db_cached = 0;
var _index_db_failed = 0;

# Process-cached index DB handle; migrates a v0.1 plaintext index on first open.
# 0 when the index cannot be opened or a pending migration did not finish.
fn get_index_db() {
    if (_index_db_cached != 0) { return _index_db_cached; }
    if (_index_db_failed == 1) { return 0; }
    var db = index_db_open();
    if (db == 0) { return 0; }
    # v0.6.10 — see get_object_db (object_db.cyr) for the BATCH-mode revert
    # rationale. Same shape: cache never closes, so BATCH-pending writes
    # would be lost on power loss before the every-64-writes auto-flush.
    #
    # 1.7.2: an unfinished migration withholds the handle. A table missing
    # the legacy rows would let `commit` record their files as deleted.
    if (index_migrate_from_plaintext(db) != 0) {
        patra_close(db);
        _index_db_failed = 1;
        return 0;
    }
    _index_db_cached = db;
    return _index_db_cached;
}

# Close the cached index handle before another repository is opened in this
# process (sit_repo_open; 1.11.0, R6): it answered for the new one, which made
# a second repository's clean files read as new.
fn index_db_reset() {
    if (_index_db_cached != 0) { patra_close(_index_db_cached); }
    _index_db_cached = 0;
    _index_db_failed = 0;
    return 0;
}

# 1 when a staging index exists on disk (patra or the v0.1 plaintext file).
fn index_files_present() {
    if (sf_exists(".sit/index.patra") == 1) { return 1; }
    if (sf_exists(".sit/index") == 1) { return 1; }
    return 0;
}

# Migrate legacy plaintext .sit/index (v0.1 format) into the patra table.
# No-op if the plaintext file is absent. Deletes it on successful migration.
# Returns 0 when there was nothing to do or every row landed, and -1 with
# `.sit/index` kept when the file could not be read or a row was refused.
fn index_migrate_from_plaintext(db) {
    if (sf_exists(".sit/index") != 1) { return 0; }
    var pair[16];
    if (read_file_heap(".sit/index", &pair) != 0) { return 0 - 1; }
    var data = load64(&pair);
    var len = load64(&pair + 8);

    # 1.7.2: all or nothing. A refused insert used to be dropped and the file
    # deleted anyway, losing those staged entries. The rows now share one
    # transaction; any refusal rolls it back and keeps `.sit/index` for the
    # next open. Or-ignore (`entries(path)` is indexed by now) stops a retry
    # after a refused BEGIN from duplicating paths, and lets an entry staged
    # since then win over the legacy row.
    var in_txn = 0;
    if (patra_begin(db) == PATRA_OK) { in_txn = 1; }
    var landed = 1;
    var dropped = 0;
    var pos = 0;
    while (pos < len) {
        if (pos + 65 > len) { pos = len; }
        else {
            if (load8(data + pos + 64) != 9) { pos = len; }
            else {
                var nl = pos + 65;
                while (nl < len) {
                    if (load8(data + nl) == 10) { break; }
                    nl = nl + 1;
                }
                var plen = nl - pos - 65;
                # S-22: refuse multi-megabyte path lines (a malformed legacy
                # index could otherwise force a single huge alloc on migrate).
                # Real paths fit in a few hundred bytes; 4096 leaves headroom
                # for deep nested cases without paying for a malicious blob.
                if (plen > 4096) { pos = len; }
                else {
                    # A row no current index can hold (a path over the 255-byte
                    # column, an empty path, a non-hex id) would be refused on
                    # every retry and wedge the migration. Drop it, counted.
                    var holdable = 1;
                    if (plen > 255) { holdable = 0; }
                    if (plen == 0) { holdable = 0; }
                    if (hex_prefix_valid(data + pos, 64) == 0) { holdable = 0; }
                    if (holdable == 0) { dropped = dropped + 1; }
                    else {
                        var hash_copy = alloc(65);
                        memcpy(hash_copy, data + pos, 64);
                        store8(hash_copy + 64, 0);
                        var path_copy = alloc(plen + 1);
                        memcpy(path_copy, data + pos + 65, plen);
                        store8(path_copy + plen, 0);

                        var types[16];
                        store64(&types + 0, 1);
                        store64(&types + 8, 1);
                        var ivals[16];
                        var sptrs[16];
                        store64(&sptrs + 0, path_copy);
                        store64(&sptrs + 8, hash_copy);
                        var slens[16];
                        store64(&slens + 0, plen);
                        store64(&slens + 8, 64);
                        var bptrs[16];
                        var blens[16];
                        if (patra_insert_row_or_ignore(db, "entries", 7, 2,
                            &types, &ivals, &sptrs, &slens, &bptrs, &blens) != PATRA_OK) {
                            landed = 0;
                        }
                    }
                    if (landed == 1) { pos = nl + 1; }
                    else { pos = len; }
                }
            }
        }
    }
    if (in_txn == 1) {
        if (landed == 1) {
            if (patra_commit(db) != PATRA_OK) { landed = 0; }
        }
        else { patra_rollback(db); }
    }
    if (landed == 0) {
        eprintln("sit: could not migrate the legacy .sit/index; it is kept for the next run");
        return 0 - 1;
    }
    if (dropped > 0) {
        var nbuf[24];
        var nlen = write_decimal(&nbuf, dropped);
        eprint("sit: dropped ", 13);
        eprint(&nbuf, nlen);
        eprintln(" legacy index entries no index can hold (path over 255 bytes, or a bad id)");
    }
    sf_unlink(".sit/index");
    return 0;
}

# Rewrite the staging index to exactly the given entries (applying only the
# difference), atomically: 0 on success, -1 with the index unchanged.
fn rewrite_index(entries) {
    var db = get_index_db();
    if (db == 0) { return 0 - 1; }

    # v1.6.1 — apply the DIFFERENCE, not a nuke-and-rebuild.
    #
    # This used to run `DELETE FROM entries` and re-insert every row, so a
    # checkout that changes ONE file rewrote all N. patra reclaims emptied data
    # pages since 1.13.9, but the `entries(path)` B-tree churns per row touched
    # and its pages are not reclaimed — so the whole-table rewrite made
    # `.sit/index.patra` grow without bound anyway. Measured: 80 checkout
    # round-trips over 61 entries took the file 56 KB -> 540 KB, while the same
    # workload against a table with no index stayed **flat at 44 KB**. The
    # growth was this function's write volume, not patra's reclamation.
    #
    # Applying the difference touches only paths that actually changed, so the
    # common checkout writes one or two rows instead of 2N.
    var current = parse_index();
    var target_map = map_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        map_set(target_map, entry_path(e), hex_encode(entry_hash(e), 32));
        i = i + 1;
    }

    # 1.6.4: one transaction. The deletes below run before the inserts, so a
    # failure part-way (a patra error, a path too long for the STR column)
    # used to leave the index half old, half new — and callers read the -1 as
    # nothing. Now any failure rolls back to the index as it was.
    if (patra_begin(db) != PATRA_OK) { return 0 - 1; }

    # Paths present now but absent from the target, or whose hash changed, are
    # removed. A changed path is removed here and re-inserted below, which is
    # what index_upsert does for a single path.
    if (current != 0) {
        var cn = vec_len(current);
        var ci = 0;
        while (ci < cn) {
            var ce = vec_get(current, ci);
            var cpath = entry_path(ce);
            var want = map_get(target_map, cpath);
            var drop = 0;
            if (want == 0) { drop = 1; }
            else {
                if (streq(want, hex_encode(entry_hash(ce), 32)) == 0) { drop = 1; }
            }
            if (drop == 1) {
                if (_index_delete_row(db, cpath) != 0) { patra_rollback(db); return 0 - 1; }
            }
            ci = ci + 1;
        }
    }

    # Insert paths that are new, or whose hash changed (removed just above).
    var current_map = map_new();
    if (current != 0) {
        var kn = vec_len(current);
        var ki = 0;
        while (ki < kn) {
            var ke = vec_get(current, ki);
            map_set(current_map, entry_path(ke), hex_encode(entry_hash(ke), 32));
            ki = ki + 1;
        }
    }
    var j = 0;
    while (j < n) {
        var te = vec_get(entries, j);
        var tpath = entry_path(te);
        var thex = hex_encode(entry_hash(te), 32);
        var had = map_get(current_map, tpath);
        var need = 0;
        if (had == 0) { need = 1; }
        else {
            if (streq(had, thex) == 0) { need = 1; }
        }
        if (need == 1) {
            var types[16];
            store64(&types + 0, 1);
            store64(&types + 8, 1);
            var ivals[16];
            var sptrs[16];
            store64(&sptrs + 0, tpath);
            store64(&sptrs + 8, thex);
            var slens[16];
            store64(&slens + 0, strlen(tpath));
            store64(&slens + 8, 64);
            var bptrs[16];
            var blens[16];
            if (patra_insert_row(db, "entries", 7, 2,
                &types, &ivals, &sptrs, &slens, &bptrs, &blens) != 0) {
                patra_rollback(db);
                return 0 - 1;
            }
        }
        j = j + 1;
    }
    if (patra_commit(db) != PATRA_OK) { return 0 - 1; }
    return 0;
}

# Upsert a single (hash, path) entry — replaces any existing row for that path.
# Used by `sit add` to stage a file.
#
# v1.4.6 — this used to read the whole index, filter `path` out in memory, and
# hand the survivors to rewrite_index(), i.e. DELETE-all + re-INSERT every row,
# for EACH file staged. Staging N files therefore wrote O(N^2) rows. patra's
# DELETE does not return emptied pages to a freelist, so that write volume also
# landed on disk permanently: a 1,000-file fixture reached a 277 MB
# .sit/index.patra holding 1,000 live entries, and `sit status` full-scans that
# file on every invocation. Measured: 10x the files cost 59x the index-parse
# time — the superlinearity 1.4.5 went looking for and did not find.
#
# Now: delete only this path's row, insert only this path's row. O(1) rows
# written per staged file, so the index tracks live entries rather than total
# stagings ever performed.
fn index_upsert(hash_hex, path) {
    var db = get_index_db();
    if (db == 0) { return 0 - 1; }

    # Validate before writing anything — a bad hash must not leave the row
    # deleted with no replacement.
    var bytes = hex_decode(hash_hex, 64);
    if (bytes == 0) { return 0 - 1; }
    if (strlen(path) == 0) { return 0 - 1; }

    # 1.7.6 (L12): one transaction. In autocommit a failed page write inside
    # patra's insert was not reported (the header write after it succeeded),
    # so `sit add` printed "added" with nothing staged — and the DELETE before
    # the INSERT was its own statement, so a refused INSERT left the path
    # unstaged. In a transaction both statements land or neither does, and the
    # commit reports a write that did not.
    if (patra_begin(db) != PATRA_OK) { return 0 - 1; }
    if (_index_delete_row(db, path) != 0) { patra_rollback(db); return 0 - 1; }
    if (_index_insert_row(db, hash_hex, path) != 0) { patra_rollback(db); return 0 - 1; }
    if (patra_commit(db) != PATRA_OK) { return 0 - 1; }
    return 0;
}

# Move one staged entry from `src` to `dst` (a `sit mv`), in one transaction:
# the old row goes and the new one arrives, or the index is unchanged.
fn index_rename_path(src, dst, hash_hex) {
    var db = get_index_db();
    if (db == 0) { return 0 - 1; }
    if (hex_decode(hash_hex, 64) == 0) { return 0 - 1; }
    if (strlen(src) == 0) { return 0 - 1; }
    if (strlen(dst) == 0) { return 0 - 1; }
    if (patra_begin(db) != PATRA_OK) { return 0 - 1; }
    if (_index_delete_row(db, src) != 0) { patra_rollback(db); return 0 - 1; }
    if (_index_delete_row(db, dst) != 0) { patra_rollback(db); return 0 - 1; }
    if (_index_insert_row(db, hash_hex, dst) != 0) { patra_rollback(db); return 0 - 1; }
    if (patra_commit(db) != PATRA_OK) { return 0 - 1; }
    return 0;
}

# DELETE the row for `path`. No transaction of its own — callers hold one.
fn _index_delete_row(db, path) {
    var plen = strlen(path);
    # `path` is external data (a working-tree filename), so it is escaped into
    # the statement rather than concatenated raw. patra_quote_str doubles each
    # embedded single quote, so the escaped form is at most 2*plen bytes.
    var sql = alloc_or_die(plen + plen + 64);
    var pfx = "DELETE FROM entries WHERE path = '";
    var pl = strlen(pfx);
    memcpy(sql, pfx, pl);
    var w = pl + patra_quote_str(sql + pl, path, plen);
    store8(sql + w, 39);
    w = w + 1;
    store8(sql + w, 0);
    if (patra_exec(db, sql) != 0) { return 0 - 1; }
    return 0;
}

# INSERT one (path, hash) row. No transaction of its own — callers hold one.
fn _index_insert_row(db, hash_hex, path) {
    var types[16];
    store64(&types + 0, 1);
    store64(&types + 8, 1);
    var ivals[16];
    var sptrs[16];
    store64(&sptrs + 0, path);
    store64(&sptrs + 8, hash_hex);
    var slens[16];
    store64(&slens + 0, strlen(path));
    store64(&slens + 8, 64);
    var bptrs[16];
    var blens[16];
    if (patra_insert_row(db, "entries", 7, 2,
        &types, &ivals, &sptrs, &slens, &bptrs, &blens) != 0) { return 0 - 1; }
    return 0;
}

# Staging entry layout (40 bytes):
#   0..32:  raw hash bytes (SHA-256, decoded from the hex in .sit/index)
#   32..40: path ptr (heap, null-terminated)
fn entry_hash(e) { return e; }
# Path of an index entry.
fn entry_path(e) { return load64(e + 32); }

# Load staging index from .sit/index.patra. Returns vec of entries or 0.
# Auto-migrates plaintext .sit/index from v0.1 layout if present.
fn parse_index() {
    # Nothing to load if neither file exists
    if (sf_exists(".sit/index.patra") != 1) {
        if (sf_exists(".sit/index") != 1) { return 0; }
    }

    var db = get_index_db();
    if (db == 0) { return 0; }

    # v1.4.6 — the ORDER BY that P-20 (v0.6.11) added here is gone. It was
    # meant to let sit's insertion sort fall through in O(N), but patra's sort
    # is itself superlinear (42,150 us vs 3,753 us on 1,000 rows, growing 38x
    # per 10x rows against the unordered scan's 9x), so it moved the cost
    # rather than removing it. sort_entries is now an O(N log N) merge sort and
    # is applied below, so this query only has to scan.
    var rs = patra_query(db, "SELECT path, hash_hex FROM entries");
    if (rs == 0) { return 0; }

    var count = patra_result_count(rs);
    if (count == 0) {
        patra_result_free(rs);
        return 0;
    }

    var entries = vec_new();
    var i = 0;
    while (i < count) {
        var path_str = patra_result_get_str(rs, i, 0);
        var hash_str = patra_result_get_str(rs, i, 1);

        var bytes = hex_decode(hash_str, 64);
        if (bytes != 0) {
            var entry = alloc(40);
            memcpy(entry, bytes, 32);
            # S-31 RESOLVED in v0.6.10: patra 1.6.1 shipped a sized accessor
            # `patra_result_get_str_len` that bound-walks within the
            # COL_STR_SZ slot. Replaces the v0.6.3 strnlen(path_str, 256)
            # workaround — same safety property at the read site, but now
            # asked of patra's API directly instead of guarded in sit.
            var plen = patra_result_get_str_len(rs, i, 0);
            var p = alloc(plen + 1);
            memcpy(p, path_str, plen);
            store8(p + plen, 0);
            store64(entry + 32, p);
            vec_push(entries, entry);
        }
        i = i + 1;
    }

    patra_result_free(rs);
    if (vec_len(entries) == 0) { return 0; }
    # Rows now arrive in insertion order, so the sorted-by-path contract every
    # parse_index caller has relied on since v0.6.11 is restored here instead
    # of by the query.
    sort_entries(entries);
    return entries;
}

# Byte-wise compare two null-terminated C strings. Returns -1/0/+1.
# Insertion-sort entries vec by path name (ascending). In place.
# Sort entries by path. Stable bottom-up merge sort, O(N log N).
#
# v1.4.6 — this was an insertion sort, O(N^2) on unsorted input. It survived
# because P-20 (v0.6.11) had parse_index ask patra for `ORDER BY path`, so the
# vec always arrived pre-sorted and the insertion sort fell through in O(N).
# That pushed the sort into patra, where it turned out to BE the quadratic:
# on a 1,000-row index, `ORDER BY path` cost 42,150 us against 3,753 us for
# the same scan unordered, growing 38x for 10x the rows where the unordered
# scan grows 9x. Sorting here instead removes the dependency on patra's sort
# and is O(N log N) regardless of the order rows arrive in.
fn sort_entries(entries) {
    var n = vec_len(entries);
    if (n < 2) { return entries; }

    # Scratch vec of the same length; merge writes into it, then it is copied
    # back so `entries` (which callers hold by reference) stays the result.
    var buf = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(buf, vec_get(entries, i));
        i = i + 1;
    }

    var width = 1;
    while (width < n) {
        var lo = 0;
        while (lo < n) {
            var mid = lo + width;
            var hi = lo + width + width;
            if (mid > n) { mid = n; }
            if (hi > n) { hi = n; }
            var a = lo;
            var b = mid;
            var w = lo;
            while (w < hi) {
                var take_a = 0;
                if (a >= mid) { take_a = 0; }
                else {
                    if (b >= hi) { take_a = 1; }
                    else {
                        var ea = vec_get(entries, a);
                        var eb = vec_get(entries, b);
                        if (strcmp_cstr(entry_path(ea), entry_path(eb)) <= 0) {
                            take_a = 1;
                        }
                    }
                }
                if (take_a == 1) {
                    vec_set(buf, w, vec_get(entries, a));
                    a = a + 1;
                }
                else {
                    vec_set(buf, w, vec_get(entries, b));
                    b = b + 1;
                }
                w = w + 1;
            }
            lo = lo + width + width;
        }
        var k = 0;
        while (k < n) {
            vec_set(entries, k, vec_get(buf, k));
            k = k + 1;
        }
        width = width + width;
    }
    return entries;
}

# After sorting, keep only the last entry for each path (staged-twice wins).
fn dedupe_entries(entries) {
    var n = vec_len(entries);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var cur = vec_get(entries, i);
        var is_last = 1;
        if (i + 1 < n) {
            var nxt = vec_get(entries, i + 1);
            if (strcmp_cstr(entry_path(cur), entry_path(nxt)) == 0) { is_last = 0; }
        }
        if (is_last == 1) { vec_push(out, cur); }
        i = i + 1;
    }
    return out;
}

# Internal tree-level entry (24 bytes):
#   0..8:   mode ptr ("100644" for files, "40000" for dirs)
#   8..16:  name ptr (heap, null-term; leaf name only)
#   16..24: hash bytes ptr (heap, 32 raw bytes)
fn cmd_reset() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit reset <path> | sit reset --hard <ref>");
        return 1;
    }

    # --hard <ref>: move current branch ref to <ref>, overwrite working + index.
    if (streq(argv(2), "--hard") == 1) {
        if (argc() < 4) {
            eprintln("usage: sit reset --hard <ref>");
            return 1;
        }
        var target = argv_heap(3);
        var hex[72];
        var rr = resolve_commit_hash(target, &hex);
        if (rr != 1) {
            syscall(SYS_WRITE, STDERR, "sit: cannot resolve '", 21);
            syscall(SYS_WRITE, STDERR, target, strlen(target));
            syscall(SYS_WRITE, STDERR, "'\n", 2);
            return 1;
        }
        var rl_old = read_head_ref();
        # v1.5.1: materialize BEFORE the ref moves. materialize_target removes
        # paths that HEAD's CURRENT tree has and the target's does not, and it
        # finds "current" by reading HEAD — so moving the ref first makes that
        # removal a no-op and leaves stale files on disk. `checkout` already had
        # this order (with a comment saying why); `reset --hard` and `merge` did
        # not, so their stale-file removal had never run. Doing it in this order
        # is also the safer failure mode: a materialize that fails leaves HEAD
        # where it was.
        if (materialize_target(&hex) != 0) {
            eprintln("sit: failed to update working tree — HEAD unchanged");
            return 1;
        }
        if (write_head_ref(&hex) != 0) {
            eprintln("sit: failed to update branch ref");
            return 1;
        }
        reflog_head_move(rl_old, &hex, reflog_msg_subject("reset: moving to ", target));
        conflicts_clear();      # the conflict it recorded is gone with the worktree
        # 1.7.6 (L2): and so is the operation that was in progress, as git's
        # `reset --hard` removes it. MERGE_HEAD survived, so after the habitual
        # `merge` → conflict → `reset --hard HEAD`, the next commit — on this
        # branch or, after a checkout, any other — recorded a two-parent merge
        # of a branch none of whose content it held, and that branch could
        # never be merged again ("already up to date").
        if (sf_exists(".sit/MERGE_HEAD") == 1) { sf_unlink(".sit/MERGE_HEAD"); }
        merge_msg_clear();
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) { sf_unlink(".sit/CHERRY_PICK_HEAD"); }
        if (sf_exists(".sit/REVERT_HEAD") == 1) { sf_unlink(".sit/REVERT_HEAD"); }
        stdout_write("HEAD reset --hard to ", 21);
        stdout_write(&hex, 12);
        stdout_write("\n", 1);
        return 0;
    }

    # sit reset <path>: unstage the path — set its index entry to HEAD's hash,
    # or remove it from the index if HEAD doesn't have it.
    var path = argv_heap(2);
    var path_len = strlen(path);

    var head_entries = read_head_tree_entries();
    var head_ent = tree_find(head_entries, path);

    var index_entries = parse_index();
    if (index_entries != 0) {
        sort_entries(index_entries);
        index_entries = dedupe_entries(index_entries);
    }

    var filtered = vec_new();
    if (index_entries != 0) {
        var n = vec_len(index_entries);
        var i = 0;
        while (i < n) {
            var e = vec_get(index_entries, i);
            if (streq(entry_path(e), path) == 0) { vec_push(filtered, e); }
            i = i + 1;
        }
    }

    if (head_ent != 0) {
        var head_hash_hex = tree_entry_hash(head_ent);
        var bytes = hex_decode(head_hash_hex, 64);
        if (bytes != 0) {
            var new_e = alloc(40);
            memcpy(new_e, bytes, 32);
            var pcopy = alloc(path_len + 1);
            memcpy(pcopy, path, path_len);
            store8(pcopy + path_len, 0);
            store64(new_e + 32, pcopy);
            vec_push(filtered, new_e);
        }
    }

    if (rewrite_index(filtered) != 0) {
        eprintln("sit: failed to update index");
        return 1;
    }
    stdout_write("unstaged '", 10);
    write_sanitized(STDOUT, path, path_len);   # 1.7.6 (R13)
    stdout_write("'\n", 2);
    return 0;
}

# `sit rm [--cached] <path>` — untrack <path>; also deletes it from the worktree unless --cached.
fn cmd_rm() {
    if (argc() < 3) {
        eprintln("usage: sit rm [--cached] <path>");
        return 1;
    }
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    var cached = 0;
    var arg_idx = 2;
    if (streq(argv(2), "--cached") == 1) {
        cached = 1;
        arg_idx = 3;
        if (argc() < 4) {
            eprintln("usage: sit rm --cached <path>");
            return 1;
        }
    }
    var path = argv_heap(arg_idx);
    var path_len = strlen(path);

    var index_entries = parse_index();
    if (index_entries != 0) {
        sort_entries(index_entries);
        index_entries = dedupe_entries(index_entries);
    }

    var head_entries = read_head_tree_entries();

    var in_index = 0;
    if (index_entries != 0) {
        if (index_find(index_entries, path) != 0) { in_index = 1; }
    }
    var in_head = 0;
    if (tree_find(head_entries, path) != 0) { in_head = 1; }

    if (in_index == 0) {
        if (in_head == 0) {
            syscall(SYS_WRITE, STDERR, "sit: '", 6);
            syscall(SYS_WRITE, STDERR, path, path_len);
            syscall(SYS_WRITE, STDERR, "' is not tracked\n", 17);
            return 1;
        }
    }

    # 1.7.6 (L4): never delete work. Without --cached the file on disk must be
    # exactly what HEAD has (or, for a path HEAD lacks, what is staged), and the
    # index must agree. `sit rm` deleted a file with unstaged edits, and the edit
    # was never hashed, so nothing could bring it back (git refuses: "has local
    # modifications"). `sit rm --cached`, then deleting the file, does it on
    # purpose.
    if (cached == 0) {
        if (path_lstat_kind(sit_abs(path)) == 0x8000) {
            var disk_hex = hash_file_as_blob(path);
            var want = 0;
            if (in_head == 1) { want = tree_find_hash(head_entries, path); }
            var ie = 0;
            if (in_index == 1) { ie = index_find(index_entries, path); }
            var differs = 0;
            if (disk_hex == 0) { differs = 1; }
            if (differs == 0) {
                if (ie != 0) {
                    if (memeq(hex_encode(entry_hash(ie), 32), disk_hex, 64) == 0) { differs = 1; }
                }
                if (want != 0) {
                    if (memeq(want, disk_hex, 64) == 0) { differs = 1; }
                }
                else { if (ie != 0) { differs = 1; } }   # staged but not committed
            }
            if (differs == 1) {
                eprint3("sit: '", path, "' has changes not in HEAD — nothing removed\n");
                eprintln("sit:   to discard them, `sit rm --cached` it and delete the file yourself");
                return 1;
            }
        }
    }

    if (index_entries != 0) {
        var filtered = vec_new();
        var n = vec_len(index_entries);
        var i = 0;
        while (i < n) {
            var e = vec_get(index_entries, i);
            if (streq(entry_path(e), path) == 0) { vec_push(filtered, e); }
            i = i + 1;
        }
        if (rewrite_index(filtered) != 0) {
            eprintln("sit: failed to rewrite index");
            return 1;
        }
    }

    if (cached == 0) {
        if (sf_exists(path) == 1) {
            if (sf_unlink(path) != 0) {
                syscall(SYS_WRITE, STDERR, "sit: failed to remove '", 23);
                syscall(SYS_WRITE, STDERR, path, path_len);
                syscall(SYS_WRITE, STDERR, "'\n", 2);
                return 1;
            }
            # Like git, an emptied directory goes too; it would otherwise block
            # a later file of the same name.
            _rmdir_empty_parents(path);
        }
    }

    stdout_write("rm '", 4);
    write_sanitized(STDOUT, path, path_len);   # 1.7.6 (R13)
    stdout_write("'\n", 2);
    return 0;
}

# P-10b (v1.4.5): index_find cache — the same fix tree_find got in v0.6.6, on the
# function that was missed.
#
# `index_find` was an O(N) linear scan called from O(N) loops: `cmd_status` runs it
# once per WORKING FILE and again once per HEAD TREE ENTRY, and `cmd_diff` /
# `cmd_rm` do the same. That is O(N²) in repository size, and the 100-commit
# benchmark fixture could not see it — the v1.4.4 large tier measured `status` at
# **1.78x git on 100 files and 26.64x on 1000** (sit growing 24x for 10x the work
# where git grows 1.6x), which is what surfaced it.
#
# Cache keyed by vec pointer, lifetime = process (sit is short-lived per
# invocation), mirroring `_tree_find_map` exactly.
#
# SAFETY — why a pointer-keyed cache cannot go stale here: an index entries vec is
# built entirely inside `parse_index` (the only `vec_push` is at its construction
# site) and never appended to or removed from afterwards. `sort_entries` reorders
# in place, which does not change the path -> entry mapping; `dedupe_entries`
# returns a NEW vec, so it gets a different pointer and therefore its own map.
# Entry payloads come from `alloc()` (bump, never freed), so an address is never
# recycled into a different vec within one process.
#
# Worst case (one lookup per vec): one map build + one lookup = O(N) + O(1) — the
# same complexity as the scan it replaces, so no caller regresses.
var _index_find_keys = 0;
var _index_find_maps = 0;

fn _index_find_map(entries) {
    if (_index_find_keys == 0) {
        _index_find_keys = vec_new();
        _index_find_maps = vec_new();
    }
    var k = vec_len(_index_find_keys);
    var ki = 0;
    while (ki < k) {
        if (vec_get(_index_find_keys, ki) == entries) {
            return vec_get(_index_find_maps, ki);
        }
        ki = ki + 1;
    }
    var m = map_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        map_set(m, entry_path(e), e);
        i = i + 1;
    }
    vec_push(_index_find_keys, entries);
    vec_push(_index_find_maps, m);
    return m;
}

# Index entry for `path` (hashmap-backed lookup), or 0.
fn index_find(entries, path) {
    if (entries == 0) { return 0; }
    var m = _index_find_map(entries);
    return map_get(m, path);
}

# gitignore-style wildmatch (v0.8.10 — WM_PATHNAME semantics):
#   '*'     a run of non-'/' chars
#   '?'     one non-'/' char
#   '[...]' a char class for one non-'/' char ('!' negates; 'a-z' ranges;
#           a leading ']' is a literal member)
#   '**'    (two+ stars) a run that MAY cross '/'; a following '/' allows zero
#           dirs, so '**/foo' matches 'foo' at any depth and '/**/' collapses
#   '/'     a literal separator
# Trailing match also succeeds at a '/' boundary in str — directory exclusion:
# 'foo/bar' matches 'foo/bar/baz'. Pattern length capped (S-15) against crafted
# '*'-heavy patterns forcing exponential backtracking.
#
# Simplification vs git: any '**' crosses '/', even when not a whole path
# segment (git only crosses for a segment-bounded '**'). 'a**b' is vanishingly
# rare in real ignore files; the segment cases ('**/x', 'x/**', 'a/**/b') are
# exact.
var _GLOB_PAT_MAX = 256;

# S-25: step budget for one top-level match.
#
# `_wildmatch_rec` is an unmemoized backtracking matcher: every `*` branches
# into "match empty" and "consume one byte", so k star-groups against an n-byte
# segment explore exponentially many states. `_GLOB_PAT_MAX` does NOT bound
# that — 8 stars is already enough. A hostile `.sitignore` / `.gitignore` of
# EIGHTEEN bytes (`*a*a*a*a*a*a*a*a*b`) plus a 64-char filename pinned a core
# indefinitely in `sit status`, and the same matcher serves `.gitignore` on the
# `sit_repo_status` read path that owl / thoth call against repos cloned from
# untrusted remotes.
#
# The budget bounds the work per top-level match. Exhaustion returns "no match",
# which for ignore matching is the SAFE direction: the file is reported rather
# than silently hidden.
#
# ⚠ This bounds the resource, it does not make the matcher polynomial — the
# algorithm is still worst-case exponential, it simply can no longer spend more
# than `_GLOB_STEP_MAX` steps proving it. 200k is ~4 orders of magnitude above
# what any realistic ignore pattern needs (real patterns carry 0-2 stars and
# finish in tens of steps) and completes in well under a millisecond. A proper
# fix is memoization over (pattern offset, string offset). v1.4.9 built it,
# measured it, and did NOT take it — see the block below _GLOB_STEP_MAX for the
# numbers and the reasoning (roadmap: the item is closed as won't-do).
var _GLOB_STEP_MAX = 200000;
var _glob_steps = 0;

# ── Memoization was implemented, measured, and REVERTED in v1.4.9 ────
#
# The roadmap carried "memoize _wildmatch" as the proper fix for the residual
# exponential behaviour the 1.3.8 step budget only bounds. It was built and
# benchmarked. Both shapes cost too much on a hot path for what they buy:
#
#   * Arm the memo up front when the pattern has >= 3 star groups — needs a star
#     count per call, and `is_ignored` calls this once per pattern plus once per
#     '/' suffix: **+14% / +15.6% / +18.4%** on `is_ignored-10/50/200pat`.
#   * Escalate on demand — run plain, retry memoized only if the budget was
#     exhausted, so ordinary patterns pay no count, no allocation, no memset.
#     Still **+7% / +7.3% / +8.8%**, because the memo check lands in the `*`
#     branch, which IS the inner loop. (Untouched controls moved -2% to -7% in
#     the same runs, so the gap is real and not machine drift.)
#
# Against that: budget exhaustion returns "no match", so the only wrong answer
# it can produce is a file **appearing** in `sit status` that should have been
# ignored — the safe direction, and benign. Measured threshold: 4 star groups
# over 32 chars completes in 41,448 steps; 6 star groups over 48 chars exhausts.
# Real, but pathological, and it shows a file rather than hiding one.
#
# `is_ignored` runs per file per pattern on every `status` and `add`. Paying
# 10-14% there permanently to fix a benign edge is the wrong trade. If this is
# revisited, the only shape that can win is splitting the recursive core into
# plain and memoized copies so the hot path carries zero memo code — and that
# duplicates ~80 lines of matcher, which is its own correctness hazard.

# Public entry: resets the per-match budget, then runs the recursive core.
# Every EXTERNAL caller must come through here; the core recurses into itself.
fn _wildmatch(pat, plen, str, slen) {
    _glob_steps = 0;
    return _wildmatch_rec(pat, plen, str, slen);
}

fn _wildmatch_rec(pat, plen, str, slen) {
    if (plen > _GLOB_PAT_MAX) { return 0; }
    if (plen == 0) {
        if (slen == 0) { return 1; }
        if ((load8(str) & 0xFF) == 47) { return 1; }   # dir-exclusion
        return 0;
    }
    var pc = load8(pat) & 0xFF;

    if (pc == 42) {   # '*'
        # S-27: charge the step budget HERE, not on every recursive call.
        #
        # 1.3.8 incremented at function entry, which is correct but costs an
        # increment + compare on every character step too — measured at **+11–18%
        # across all three `is_ignored` benchmarks** (50pat 32.4 → 36.4 µs), a
        # real regression on a hot path, since `is_ignored` runs this per pattern
        # per file for `sit status` / `sit add` / `sit_repo_status`.
        #
        # Only the `*` branches can blow up: they fan out into "match empty" and
        # "consume one byte". Every other path (`?`, `/`, a literal, a `[...]`
        # class) consumes one pattern byte AND one string byte per call, so that
        # recursion is already bounded by min(plen, slen) and needs no counter.
        # Charging only here preserves the bound exactly while taking the cost
        # off the common path.
        _glob_steps = _glob_steps + 1;
        if (_glob_steps > _GLOB_STEP_MAX) { return 0; }

        var nstar = 0;
        var counting = 1;
        while (counting == 1) {
            if (nstar < plen) {
                if ((load8(pat + nstar) & 0xFF) == 42) { nstar = nstar + 1; }
                else { counting = 0; }
            }
            else { counting = 0; }
        }
        var rest = pat + nstar;
        var restlen = plen - nstar;
        if (nstar >= 2) {                       # '**' — may cross '/'
            if (restlen == 0) { return 1; }
            if ((load8(rest) & 0xFF) == 47) {   # '**/...' may match zero dirs
                if (_wildmatch_rec(rest + 1, restlen - 1, str, slen) == 1) { return 1; }
            }
            var m = 0;
            var res = 0;
            var done = 0;
            while (done == 0) {
                # 1.6.4 (B10): charge every offset this scan tries. Only entry
                # to the `*` branch was charged, so each charged step could run
                # up to slen uncharged recursions — `**a**a**a**a b` against a
                # 250-byte name took ~250 ms per match, and a 1.6 KB
                # .sitignore made `sit status` take 56 s.
                _glob_steps = _glob_steps + 1;
                if (_glob_steps > _GLOB_STEP_MAX) { done = 1; }
                else {
                    if (_wildmatch_rec(rest, restlen, str + m, slen - m) == 1) { res = 1; done = 1; }
                    else {
                        if (m >= slen) { done = 1; }
                        else { m = m + 1; }
                    }
                }
            }
            return res;
        }
        # single '*' — run of non-'/'
        if (_wildmatch_rec(rest, restlen, str, slen) == 1) { return 1; }
        if (slen == 0) { return 0; }
        if ((load8(str) & 0xFF) == 47) { return 0; }
        return _wildmatch_rec(pat, plen, str + 1, slen - 1);
    }

    if (pc == 47) {   # '/'
        if (slen == 0) { return 0; }
        if ((load8(str) & 0xFF) != 47) { return 0; }
        return _wildmatch_rec(pat + 1, plen - 1, str + 1, slen - 1);
    }

    if (slen == 0) { return 0; }
    var sc = load8(str) & 0xFF;

    if (pc == 63) {   # '?'
        if (sc == 47) { return 0; }
        return _wildmatch_rec(pat + 1, plen - 1, str + 1, slen - 1);
    }

    if (pc == 91) {   # '[' char class
        if (sc == 47) { return 0; }
        var ci = 1;
        var negate = 0;
        if (ci < plen) {
            if ((load8(pat + ci) & 0xFF) == 33) { negate = 1; ci = ci + 1; }
        }
        var matched = 0;
        var first = 1;
        var closed = 0;
        var bad = 0;
        while (closed == 0) {
            if (ci >= plen) { bad = 1; closed = 1; }   # unterminated class
            else {
                var cc = load8(pat + ci) & 0xFF;
                if (cc == 93) {                        # ']'
                    if (first == 1) {                  # literal ']' as first member
                        if (sc == 93) { matched = 1; }
                        ci = ci + 1;
                        first = 0;
                    }
                    else { closed = 1; ci = ci + 1; }
                }
                else {
                    first = 0;
                    var is_range = 0;
                    if (ci + 2 < plen) {
                        if ((load8(pat + ci + 1) & 0xFF) == 45) {
                            if ((load8(pat + ci + 2) & 0xFF) != 93) { is_range = 1; }
                        }
                    }
                    if (is_range == 1) {
                        var lo = cc;
                        var hi = load8(pat + ci + 2) & 0xFF;
                        if (sc >= lo) { if (sc <= hi) { matched = 1; } }
                        ci = ci + 3;
                    }
                    else {
                        if (sc == cc) { matched = 1; }
                        ci = ci + 1;
                    }
                }
            }
        }
        if (bad == 1) { return 0; }
        var ok = matched;
        if (negate == 1) {
            if (matched == 1) { ok = 0; }
            else { ok = 1; }
        }
        if (ok == 0) { return 0; }
        return _wildmatch_rec(pat + ci, plen - ci, str + 1, slen - 1);
    }

    if (pc != sc) { return 0; }
    return _wildmatch_rec(pat + 1, plen - 1, str + 1, slen - 1);
}

# True if `path` (repo-relative, e.g. "src/build/foo.o") is ignored. Patterns are
# evaluated IN ORDER and the LAST matching pattern wins — so a later `!pattern`
# re-includes a file an earlier pattern excluded (git semantics). Each pattern is
# a struct: [text, text_len, negated, anchored, scope] (see _parse_ignore_file).
#
#   dir_only (v1.5.2): the pattern ended in '/', so it matches directories only.
#     `is_ignored` (no kind) passes "not a directory", which is the conservative
#     direction — a dir-only rule simply does not fire for a caller that cannot
#     say. The working-tree walk knows, and passes it.
#   scope (v1.4.9): 0 for a root-level rule, else the directory prefix the rule
#     came from, WITH its trailing '/' (e.g. "sub/"). A scoped rule only applies
#     to paths under that directory and is matched against the path relative to
#     it, which is git's nested-.gitignore semantics.
#
#   anchored (pattern had a leading or middle '/'): matched against the full path
#     from the repo root via _wildmatch (its '**' handles any-depth cases).
#   non-anchored (no '/'): matches at ANY level — tried against the full path and
#     against every suffix beginning just after a '/'.
# Kind-aware ignore test. `path_is_dir` lets a trailing-slash rule (`build/`)
# match a directory and not a same-named file. Callers that do not know the
# kind use is_ignored, which passes 0 — a dir-only rule then does not fire,
# which errs toward SHOWING a file rather than silently hiding it.
fn is_ignored(path, patterns) {
    return is_ignored_kind(path, patterns, 0);
}

# 1 if the file `path` (repo-relative) is ignored exactly as the working-tree
# walk (list_working_walk) would ignore it. 1.7.2 (B13): `add` used to test only
# the root rules, with no kind, so `sit add build/foo.o` succeeded under a
# `build/` rule, and a nested ignore file was never read. Each ancestor
# directory is now tested AS a directory with the rules inherited from above
# it (an ignored directory hides everything below), and then contributes its
# own ignore file, scoped to it.
fn is_ignored_scoped(path) {
    var patterns = load_sitignore();
    var ig_name = _ignore_filename();
    var ig_nlen = strlen(ig_name);
    var plen = strlen(path);
    var i = 0;
    while (i < plen) {
        if (load8(path + i) == 47) {
            var dir = alloc(i + ig_nlen + 2);
            memcpy(dir, path, i);
            store8(dir + i, 0);
            if (is_ignored_kind(dir, patterns, 1) == 1) { return 1; }
            # `dir` grows into "<dir>/<ignore file>" in place; the scope is
            # "<dir>/", the same prefix the walk passes.
            store8(dir + i, 47);
            memcpy(dir + i + 1, ig_name, ig_nlen);
            store8(dir + i + 1 + ig_nlen, 0);
            if (sf_exists(dir) == 1) {
                var scoped = vec_new();
                if (patterns != 0) {
                    var k = 0;
                    while (k < vec_len(patterns)) {
                        vec_push(scoped, vec_get(patterns, k));
                        k = k + 1;
                    }
                }
                var scope = alloc(i + 2);
                memcpy(scope, path, i + 1);
                store8(scope + i + 1, 0);
                _parse_ignore_file(dir, scoped, scope);
                patterns = scoped;
            }
        }
        i = i + 1;
    }
    return is_ignored_kind(path, patterns, 0);
}

# 1 if `path` is ignored by `patterns`; last matching rule wins, dir-only rules need path_is_dir.
fn is_ignored_kind(path, patterns, path_is_dir) {
    if (patterns == 0) { return 0; }
    var path_len = strlen(path);
    var n = vec_len(patterns);
    var i = 0;
    var result = 0;   # 0 = not ignored; the last matching pattern overwrites this
    while (i < n) {
        var p = vec_get(patterns, i);
        var text = load64(p);
        var tlen = load64(p + 8);
        var negated = load64(p + 16);
        var anchored = load64(p + 24);
        var scope = load64(p + 32);
        var dir_only = load64(p + 40);

        # A scoped rule (from a nested ignore file) only applies below its own
        # directory, and matches against the path relative to it.
        var mpath = path;
        var mlen = path_len;
        var applies = 1;
        if (dir_only == 1) {
            if (path_is_dir != 1) { applies = 0; }
        }
        if (scope != 0) {
            var sclen = strlen(scope);
            if (path_len <= sclen) { applies = 0; }
            else {
                if (memeq(path, scope, sclen) == 1) {
                    mpath = path + sclen;
                    mlen = path_len - sclen;
                }
                else { applies = 0; }
            }
        }

        var m = 0;
        if (applies == 1) {
            if (anchored == 1) {
                m = _wildmatch(text, tlen, mpath, mlen);
            }
            else {
                if (_wildmatch(text, tlen, mpath, mlen) == 1) { m = 1; }
                else {
                    var k = 0;
                    while (k < mlen) {
                        if (load8(mpath + k) == 47) {
                            if (_wildmatch(text, tlen, mpath + k + 1, mlen - k - 1) == 1) {
                                m = 1;
                                k = mlen;
                            }
                        }
                        if (k < mlen) { k = k + 1; }
                    }
                }
            }
        }

        if (m == 1) {
            if (negated == 1) { result = 0; }
            else { result = 1; }
        }
        i = i + 1;
    }
    return result;
}

# Read `.sitignore` into a vec of pattern structs (32 bytes each):
#   [0]  text ptr (NUL-terminated, with leading `!` / leading `/` / trailing `/`
#        stripped), [8] text_len, [16] negated (leading `!`), [24] anchored
#        (leading or middle `/` → matched from the repo root).
# Blank lines and `#` comments are skipped; `\!` / `\#` escape a literal first
# char; a trailing `/` (directory hint) is stripped (dir-only is not enforced —
# the same simplification as before).
# Parse one ignore file into `patterns`, appending. Split out of
# load_sitignore in v1.4.9 so more than one file can feed the same pattern
# list — `is_ignored` is last-match-wins, so append order IS precedence order.
# Returns the number of patterns added.
fn _parse_ignore_file(fname, patterns, scope) {
    if (sf_exists(fname) != 1) { return 0; }
    var pair[16];
    if (read_file_heap(fname, &pair) != 0) { return 0; }
    var data = load64(&pair);
    var len = load64(&pair + 8);

    var added = 0;
    var pos = 0;
    while (pos < len) {
        var line_end = pos;
        while (line_end < len) {
            if (load8(data + line_end) == 10) { break; }
            line_end = line_end + 1;
        }

        var ls = pos;
        var le = line_end;
        if (le > ls) {
            if (load8(data + le - 1) == 13) { le = le - 1; }   # strip CR
        }

        var keep = 1;
        if (le == ls) { keep = 0; }                            # blank line
        else {
            if (load8(data + ls) == 35) { keep = 0; }          # '#' comment
        }

        if (keep == 1) {
            var s = ls;
            var negated = 0;
            var c0 = load8(data + s) & 0xFF;
            if (c0 == 33) { negated = 1; s = s + 1; }           # leading '!'
            else {
                if (c0 == 92) {                                 # '\' escape
                    if (s + 1 < le) {
                        var nx = load8(data + s + 1) & 0xFF;
                        if (nx == 33) { s = s + 1; }             # '\!' -> literal '!'
                        else {
                            if (nx == 35) { s = s + 1; }         # '\#' -> literal '#'
                        }
                    }
                }
            }

            var anchored = 0;
            if (s < le) {
                if (load8(data + s) == 47) { anchored = 1; s = s + 1; }   # leading '/'
            }
            var e = le;
            var dir_only = 0;
            if (e > s) {
                # v1.5.2: a trailing '/' means DIRECTORY-ONLY, not decoration.
                # `build/` must not match a plain file named `build`. The slash
                # is still stripped from the match text; the fact that it was
                # there is now carried on the pattern.
                if (load8(data + e - 1) == 47) { e = e - 1; dir_only = 1; }
            }
            if (anchored == 0) {
                var k = s;
                while (k < e) {
                    if (load8(data + k) == 47) { anchored = 1; k = e; }   # middle '/'
                    else { k = k + 1; }
                }
            }

            var tlen = e - s;
            if (tlen > 0) {
                var text = alloc(tlen + 1);
                memcpy(text, data + s, tlen);
                store8(text + tlen, 0);
                var p = alloc(48);
                store64(p, text);
                store64(p + 8, tlen);
                store64(p + 16, negated);
                store64(p + 24, anchored);
                store64(p + 32, scope);
                store64(p + 40, dir_only);
                vec_push(patterns, p);
                added = added + 1;
            }
        }
        pos = line_end + 1;
    }
    return added;
}

# Load the active backend's ignore rules.
#
# v1.4.9: `<repo-dir>/info/exclude` is now consulted, matching git. Order is
# precedence: `is_ignored` lets the LAST matching pattern win, so info/exclude
# is parsed first and the top-level ignore file second — a `.gitignore` rule
# (including a `!` re-include) overrides info/exclude, which is git's ordering.
# Global/core.excludesFile is still not consulted; nested ignore files are
# added per directory by list_working_walk (diff.cyr) and is_ignored_scoped.
fn load_sitignore() {
    var patterns = vec_new();

    # <repo-dir> is exactly 5 bytes (".sit/" / ".git/"); + "info/exclude" = 12.
    var rd = _repo_dir();
    var ex = alloc(18);
    memcpy(ex, rd, 5);
    memcpy(ex + 5, "info/exclude", 12);
    store8(ex + 17, 0);
    _parse_ignore_file(ex, patterns, 0);

    # Backend-aware ignore file: .sitignore (sit) or .gitignore (git read-mode).
    _parse_ignore_file(_ignore_filename(), patterns, 0);

    if (vec_len(patterns) == 0) { return 0; }
    return patterns;
}

# Recursive working-dir walker. Entries are pushed as full repo-relative
# paths ("src/main.cyr"). Hardcoded skip: `.sit/`. Everything else is
# included unless it matches a `.sitignore` pattern.

# Rename a path on disk.
#
# Linux is `rename(old, new)`; AGNOS is `rename(old, oldlen, new, newlen)` —
# different ARITY, and cyrius has treated a syscall-arity mismatch as a hard
# error since 6.5.4 (it is a static check, not reachability-based), so the two
# forms must be split textually rather than behind a runtime branch. Same shape
# as wire_ssh.cyr's SYS_ACCESS gate.
#
# ⚠ The non-AGNOS arm goes through the stdlib's `sys_rename`, NOT a raw
# `syscall(SYS_RENAME, ...)`. **arm64 Linux has no `rename` syscall at all** —
# it was never given one; `lib/syscalls_aarch64_linux.cyr` therefore defines
# only `SYS_RENAMEAT = 38` and implements `sys_rename` as
# `sys_renameat(AT_FDCWD, old, AT_FDCWD, new)`. Naming the constant directly
# broke every aarch64 consumer of the read bundle with
# `undefined variable 'SYS_RENAME'`, and because the check is static rather
# than reachability-based it broke them even though `sf_rename` is only
# reachable from `sit mv`, which a read-only consumer never calls. The stdlib
# wrapper is 2-arg and present on x86_64 Linux, aarch64 Linux and macOS alike,
# so one arm now covers all three.
fn sf_rename(old, new) {
    # 1.6.4 (E11): never across a symlinked directory — `sit mv c.txt
    # link/c.txt` moved a tracked file OUT of the repository, and through a
    # `meta -> .sit` link into .sit/refs/heads as a bogus branch.
    if (_sf_parent_symlink(old) == 1) { return 0 - 40; }
    if (_sf_parent_symlink(new) == 1) { return 0 - 40; }
    # 1.7.6 (K1): resolved through the repo root like every other sf_* wrapper.
    # On Linux the CLI root is the cwd, so nothing changed there; on agnos, where
    # the root is an absolute path and there is no cwd, `sit mv` renamed the
    # wrong paths.
    var ob[4352];
    var nb[4352];
    return _sit_rename_raw(_sf_abs(old, &ob), _sf_abs(new, &nb));
}

# `sit mv <src> <dst>` — rename in the working tree AND restage in one step.
#
# The point is the index half: `mv` on its own leaves the old path staged and
# the new one untracked, so the next commit records a delete plus an unrelated
# add. Doing both together keeps the staged content identical and only the path
# changes — which is what makes a rename readable in history.
fn cmd_mv() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 4) {
        eprintln("usage: sit mv <src> <dst>");
        return 1;
    }
    var src = argv_heap(2);
    var dst = argv_heap(3);

    # Both paths are external input that become on-disk targets AND tree entry
    # names, so they get the same gate `add` applies (S-03): no traversal, no
    # absolute path, no reserved or unsafe name.
    if (tree_flat_path_valid(src) == 0) {
        eprintln("sit: invalid source path");
        return 1;
    }
    if (tree_flat_path_valid(dst) == 0) {
        eprintln("sit: invalid destination path");
        return 1;
    }
    if (streq(src, dst) == 1) {
        eprintln("sit: source and destination are the same path");
        return 1;
    }
    # 1.7.6 (L13): add's 255-byte column limit, checked BEFORE the rename. A
    # longer name was renamed on disk, unstaged at the source, then refused at
    # the destination — leaving a staged deletion the next commit recorded.
    if (strlen(dst) > 255) {
        eprint3("sit: '", dst, "' is longer than the 255-byte index path limit\n");
        return 1;
    }
    if (sf_exists(src) != 1) {
        eprintln("sit: source path does not exist");
        return 1;
    }
    if (sf_exists(dst) == 1) {
        eprintln("sit: destination already exists");
        return 1;
    }

    # The source must be tracked; moving an untracked file is `mv`, not `sit mv`,
    # and silently staging it would be a surprise.
    var entries = parse_index();
    var e = index_find(entries, src);
    if (e == 0) {
        eprintln("sit: source path is not tracked (run 'sit add' first)");
        return 1;
    }
    var hash_hex = hex_encode(entry_hash(e), 32);

    ensure_parent_dirs(dst);
    if (sf_rename(src, dst) != 0) {
        eprintln("sit: failed to rename");
        return 1;
    }

    # Index: drop the old path, stage the new one at the SAME blob. No rehash —
    # the content did not change, and rehashing would be both wasted work and a
    # chance for the two paths to disagree. One transaction (1.7.6, L13): if it
    # is refused the index is as it was, and the file goes back where it was.
    if (index_rename_path(src, dst, hash_hex) != 0) {
        if (sf_rename(dst, src) != 0) {
            eprint3("sit: failed to update the index, and could not move the file back — it is at '", dst, "'\n");
            return 1;
        }
        eprintln("sit: failed to update the index — nothing moved");
        return 1;
    }

    stdout_write("renamed ", 8);
    write_sanitized(STDOUT, src, strlen(src));   # 1.7.6 (R13)
    stdout_write(" -> ", 4);
    write_sanitized(STDOUT, dst, strlen(dst));
    stdout_write("\n", 1);
    return 0;
}

# --- refs.cyr ---

# refs.cyr — HEAD / branch / tag / resolution.
#
# Refs live at .sit/HEAD (symbolic), .sit/refs/heads/<name>, .sit/refs/tags/<name>,
# and .sit/refs/remotes/<remote>/<name>. ensure_parent_dirs (util.cyr) is called
# by every write path so nested names like feature/foo work.

# Resolve a reflog selector to an oid: "<base>@{N}" — the new-oid recorded N
# moves ago — or, since 1.8.0, "<base>@{<time>}" — the value the ref had then
# (`HEAD@{yesterday}`, `main@{2 days ago}`, `main@{2026-10-01}`; UTC). Writes
# 64-hex + nul into out_buf. Returns 1 on success, 0 if `name` isn't a reflog
# selector or the base has no log / the entry is out of range. The base's log
# is found by class: HEAD → logs/HEAD; otherwise logs/refs/heads/<base>, then
# logs/refs/remotes/<base> (tags aren't logged). Called from resolve_ref_name
# in REVISION context — distinct from refname_valid, which rejects '@{' in
# ref-NAME context (so x@{0} never becomes a ref file).
fn resolve_reflog_spec(name, out_buf) {
    var spec[24];
    var blen = 0;
    var num = 0;
    var when = 0 - 1;
    if (_reflog_spec_parse(name, &spec) == 1) {
        blen = load64(&spec + 8);
        num = load64(&spec + 16);
    }
    else {
        var ds[16];
        if (_reflog_date_spec_parse(name, clock_epoch_secs(), &ds) == 0) { return 0; }
        blen = load64(&ds);
        when = load64(&ds + 8);
    }
    var base = alloc(blen + 1);
    memcpy(base, name, blen);
    store8(base + blen, 0);
    var refpath = _reflog_spec_refpath(base);
    if (refpath == 0) { return 0; }
    if (when >= 0) { return reflog_read_at_time(refpath, when, out_buf); }
    return reflog_read_nth(refpath, num, out_buf);
}

# The log refpath a selector's base names — "HEAD", or the branch or
# remote-tracking ref that has a log — or 0.
fn _reflog_spec_refpath(base) {
    if (streq(base, "HEAD") == 1) { return "HEAD"; }

    # S-02: the base becomes a .sit/logs/ path component below; reject
    # traversal ('..', leading '/') and control chars before it does. An
    # invalid base simply isn't a resolvable selector → fall through (0).
    if (refname_valid(base) == 0) { return 0; }
    var blen = strlen(base);

    var hp = alloc(11 + blen + 1);
    memcpy(hp, "refs/heads/", 11);
    memcpy(hp + 11, base, blen);
    store8(hp + 11 + blen, 0);
    if (sf_exists(reflog_log_path(hp)) == 1) { return hp; }

    var rp = alloc(13 + blen + 1);
    memcpy(rp, "refs/remotes/", 13);
    memcpy(rp + 13, base, blen);
    store8(rp + 13 + blen, 0);
    if (sf_exists(reflog_log_path(rp)) == 1) { return rp; }
    return 0;
}

# Resolve a ref name (HEAD, <ref>@{N}, or a name under refs/) to 64-hex in `out_buf`; 1 on success.
fn resolve_ref_name(name, out_buf) {
    # Storage seam (roadmap 1.2.0): a .git/ repo resolves refs from .git/HEAD,
    # .git/refs/, and .git/packed-refs. @{N} reflog specs are .sit-only for now (roadmap: `.git/` CLI parity).
    if (_repo_backend == 1) { return _git_resolve_ref_name(name, out_buf); }

    # Reflog selector <ref>@{N} takes precedence over plain-name lookup.
    if (resolve_reflog_spec(name, out_buf) == 1) { return 1; }
    if (streq(name, "HEAD") == 1) {
        var h = read_head_ref();
        if (h == 0) { return 0; }
        memcpy(out_buf, h, 64);
        store8(out_buf + 64, 0);
        return 1;
    }

    var name_len = strlen(name);

    var tag_path = alloc(15 + name_len + 1);
    memcpy(tag_path, ".sit/refs/tags/", 15);
    memcpy(tag_path + 15, name, name_len);
    store8(tag_path + 15 + name_len, 0);
    # S-11: all three ref-file readers below validate that the first 64 bytes
    # are actual hex before accepting. A garbage or attacker-crafted ref is
    # treated as "no such ref" rather than flowed through as a "hash".
    if (sf_exists(tag_path) == 1) {
        var tfd = sf_open(tag_path, 0, 0);
        if (tfd >= 0) {
            var tbuf = alloc(80);
            var tn = file_read(tfd, tbuf, 80);
            file_close(tfd);
            if (tn >= 64) {
                if (hex_prefix_valid(tbuf, 64) == 1) {
                    memcpy(out_buf, tbuf, 64);
                    store8(out_buf + 64, 0);
                    return 1;
                }
            }
        }
    }

    var head_path = alloc(16 + name_len + 1);
    memcpy(head_path, ".sit/refs/heads/", 16);
    memcpy(head_path + 16, name, name_len);
    store8(head_path + 16 + name_len, 0);
    if (sf_exists(head_path) == 1) {
        var hfd = sf_open(head_path, 0, 0);
        if (hfd >= 0) {
            var hbuf = alloc(80);
            var hn = file_read(hfd, hbuf, 80);
            file_close(hfd);
            if (hn >= 64) {
                if (hex_prefix_valid(hbuf, 64) == 1) {
                    memcpy(out_buf, hbuf, 64);
                    store8(out_buf + 64, 0);
                    return 1;
                }
            }
        }
    }

    # Remote-tracking ref (e.g. "origin/main" → .sit/refs/remotes/origin/main)
    var rem_path = alloc(18 + name_len + 1);
    memcpy(rem_path, ".sit/refs/remotes/", 18);
    memcpy(rem_path + 18, name, name_len);
    store8(rem_path + 18 + name_len, 0);
    if (sf_exists(rem_path) == 1) {
        var rfd = sf_open(rem_path, 0, 0);
        if (rfd >= 0) {
            var rbuf = alloc(80);
            var rn = file_read(rfd, rbuf, 80);
            file_close(rfd);
            if (rn >= 64) {
                if (hex_prefix_valid(rbuf, 64) == 1) {
                    memcpy(out_buf, rbuf, 64);
                    store8(out_buf + 64, 0);
                    return 1;
                }
            }
        }
    }

    return 0;
}

# Resolve a reference: either a symbolic name (HEAD, tag, branch) or a hex hash
# (full 64 chars or a prefix of 4+). Writes null-terminated hash into out_buf
# (65 bytes) and returns:
#    1  exact match
#    0  no match
#   -1  ambiguous
#   -2  prefix too short
fn read_head_ref_path() {
    return read_head_ref_path_a(0);
}

# How much of HEAD read_head_ref_path_a reads. Past "ref: " and a name of
# VAL_REFNAME_MAX bytes nothing can validate, so a longer HEAD is refused here
# exactly as reading it all would refuse it.
var HEAD_READ_MAX = 1024;

# read_head_ref_path with the returned name drawn from `a` (0 = the global
# heap). 1.7.5: HEAD is read into a stack buffer, not through read_file_heap,
# which kept the file and its joined path on the heap per call — once per ref
# push in `sit serve`, which passes its request arena here.
fn read_head_ref_path_a(a) {
    # Backend-aware HEAD path: ".sit/HEAD" or ".git/HEAD" (both 9 bytes; the
    # "ref: <path>" symref format is identical across backends).
    var hp[12];
    memcpy(&hp, _repo_dir(), 5);
    memcpy(&hp + 5, "HEAD", 4);
    store8(&hp + 9, 0);
    var abuf[4352];
    var ap = sit_abs_into(&hp, &abuf, 4352);
    if (ap == 0) { return 0; }
    if (_sf_special(ap) == 1) { return 0; }          # 1.7.6 (R11): not a FIFO
    var fd = file_open(ap, 0, 0);
    if (fd < 0) { return 0; }
    var hbuf[1032];                                # HEAD_READ_MAX bytes are read at most
    var buf = &hbuf;
    var len = 0;
    var reading = 1;
    while (reading == 1) {
        if (len >= HEAD_READ_MAX) { reading = 0; }
        else {
            var got = file_read(fd, buf + len, HEAD_READ_MAX - len);
            if (got <= 0) { reading = 0; }
            else { len = len + got; }
        }
    }
    file_close(fd);

    if (len < 5) { return 0; }
    if (memeq(buf, "ref: ", 5) == 0) { return 0; }

    var stop = 5;
    var scanning = 1;
    while (scanning == 1) {
        if (stop >= len) { scanning = 0; }
        else {
            var c = load8(buf + stop);
            if (c == 10) { scanning = 0; }
            else {
                if (c == 13) { scanning = 0; }
                else { stop = stop + 1; }
            }
        }
    }

    var ref_len = stop - 5;
    if (ref_len == 0) { return 0; }
    if (ref_len > VAL_REFNAME_MAX) { return 0; }   # refname_valid's verdict, before the copy

    var ref = 0;
    if (a == 0) { ref = alloc(ref_len + 1); }
    else { ref = alloc_via(a, ref_len + 1); }
    if (ref == 0) { return 0; }
    memcpy(ref, buf + 5, ref_len);
    store8(ref + ref_len, 0);
    # S-25: validate the symref TARGET before anyone builds a path out of it.
    #
    # This is the single choke point feeding read_head_ref (read path),
    # write_head_ref (".sit/" + target) and reflog_head_move (".sit/logs/" +
    # target). It used to return the raw bytes after "ref: " unchecked, so a
    # HEAD file reading `ref: ../../PWNED` made `sit commit` write 64 hex chars
    # + LF to a file OUTSIDE the repository — verified end to end — and
    # `refs/heads/../../../../home/u/.bashrc` additionally passed the
    # memeq("refs/heads/", 11) test in reflog_head_move, appending reflog lines
    # (which carry the user's commit message) onto that path.
    #
    # Reachable from any repo whose .sit/ arrived from outside: tarball, shared
    # checkout, restored backup, CI workspace. git blocks the same shape via
    # check_refname_format() on the referent in parse_loose_ref_contents.
    # refname_valid rejects `..` components, leading/trailing '/', and the
    # control/space/special bytes git forbids.
    if (refname_valid(ref) == 0) { return 0; }
    # 1.6.4 (E2): and it must name something under refs/, as git requires of
    # HEAD. refname_valid accepts single-component names, so `ref:
    # objects.patra` passed, and the next `sit commit` overwrote the whole
    # object database with 65 bytes (likewise config, index.patra, HEAD).
    if (ref_len < 6) { return 0; }
    if (memeq(ref, "refs/", 5) == 0) { return 0; }
    return ref;
}

# Read the ref file pointed at by HEAD. Returns 64-char hex or 0.
fn read_head_ref() {
    # Storage seam (roadmap 1.2.0): git refs may be loose or in packed-refs, and
    # the id width is _id_hexlen(). Dispatch to the git reader before the .sit path.
    if (_repo_backend == 1) { return _git_read_head_ref(); }

    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0; }
    var ref_len = strlen(ref_path);
    var full = alloc(5 + ref_len + 1);
    memcpy(full, ".sit/", 5);
    memcpy(full + 5, ref_path, ref_len);
    store8(full + 5 + ref_len, 0);

    if (sf_exists(full) != 1) { return 0; }
    var fd = sf_open(full, 0, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(80);
    var n = file_read(fd, buf, 80);
    file_close(fd);
    if (n < 64) { return 0; }
    # S-11: validate the first 64 bytes are actual hex before returning —
    # otherwise a corrupt or hostile ref file flows garbage through the
    # whole stack (and into resolve_hash's LIKE after S-01 rejects it).
    if (hex_prefix_valid(buf, 64) == 0) { return 0; }
    store8(buf + 64, 0);
    return buf;
}

# 1 when HEAD's branch ref exists but holds no valid id — empty, short,
# non-hex or unreadable — as opposed to an unborn branch, whose ref file does
# not exist. read_head_ref answers 0 for both. 1.7.6 (L5): commit and pull took
# a broken ref for an unborn branch, so the next commit started a new root over
# the history and `fsck --prune` could then delete it; they refuse instead, as
# git does ("reference broken").
fn head_ref_broken() {
    if (_repo_backend == 1) { return 0; }
    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0; }
    var ref_len = strlen(ref_path);
    var full = alloc(5 + ref_len + 1);
    memcpy(full, ".sit/", 5);
    memcpy(full + 5, ref_path, ref_len);
    store8(full + 5 + ref_len, 0);
    if (path_lstat_kind(sit_abs(full)) < 0) { return 0; }   # absent: unborn
    if (read_head_ref() == 0) { return 1; }
    return 0;
}

# Write the given 64-char hex to the ref file HEAD points at.
fn write_head_ref(hex) {
    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0 - 1; }
    var ref_len = strlen(ref_path);
    var full = alloc(5 + ref_len + 1);
    memcpy(full, ".sit/", 5);
    memcpy(full + 5, ref_path, ref_len);
    store8(full + 5 + ref_len, 0);
    ensure_parent_dirs(full);

    var out = alloc(66);
    memcpy(out, hex, 64);
    store8(out + 64, 10);
    store8(out + 65, 0);
    if (sf_write_atomic(full, out, 65) < 0) { return 0 - 1; }
    return 0;
}

# Record a HEAD movement in the reflog. A branch-tip move that HEAD points
# at is logged TWICE per git semantics — once to .sit/logs/HEAD and once to
# the branch log (.sit/logs/refs/heads/<b>); a detached HEAD logs only to
# .sit/logs/HEAD. Call this AFTER a successful write_head_ref, passing the
# tip read BEFORE the write as old_hex (0 → creation). Best-effort: a failed
# append never propagates, so logging can't undo a committed ref move.
# Lives here (not reflog.cyr) because it reads read_head_ref_path, which is
# defined later than reflog.cyr in the single-pass dist bundle order.
fn reflog_head_move(old_hex, new_hex, msg) {
    # Resolve identity + timestamp ONCE so the HEAD log and the branch log
    # record an identical (ts, name, email) for this one atomic move (git's
    # single-timestamp-per-transaction behaviour).
    var nm = _reflog_user_name();
    var em = _reflog_user_email();
    var ts = clock_epoch_secs();
    _reflog_append_full("HEAD", old_hex, new_hex, msg, nm, em, ts);
    var branch = read_head_ref_path();
    if (branch != 0) {
        if (memeq(branch, "refs/heads/", 11) == 1) {
            _reflog_append_full(branch, old_hex, new_hex, msg, nm, em, ts);
        }
    }
    return 0;
}

# Extract the branch name from HEAD (e.g. "main" from "refs/heads/main").
# Returns heap cstring or 0 if HEAD isn't a branch ref.
fn current_branch_name() {
    var ref_path = read_head_ref_path();
    if (ref_path == 0) { return 0; }
    var ref_len = strlen(ref_path);
    if (ref_len <= 11) { return ref_path; }
    if (memeq(ref_path, "refs/heads/", 11) == 0) { return ref_path; }
    var name_len = ref_len - 11;
    var name = alloc(name_len + 1);
    memcpy(name, ref_path + 11, name_len);
    store8(name + name_len, 0);
    return name;
}

# Build and write a commit object. Returns hex hash or 0.
fn set_head_ref(ref_path) {
    var rlen = strlen(ref_path);
    var total = 5 + rlen + 1;
    var buf = alloc(total + 1);
    memcpy(buf, "ref: ", 5);
    memcpy(buf + 5, ref_path, rlen);
    store8(buf + 5 + rlen, 10);
    store8(buf + total, 0);
    if (sf_write_atomic(".sit/HEAD", buf, total) < 0) { return 0 - 1; }
    return 0;
}

# Every ref under `dir` (".sit/refs/tags", ".sit/refs/heads"), named by its
# path relative to it ("release/v1"), sorted. 1.7.3 (E14): the tag and branch
# listings, and describe, read one level, so a nested name listed as its
# directory ("release") and describe never saw the ref. fsck's root walk
# (dir_walk) always recursed.
fn ref_names_under(dir) {
    var names = vec_new();
    if (sf_exists(dir) != 1) { return names; }
    _ref_names_walk(dir, "", names, 0);
    sort_cstrings(names);
    return names;
}

# Recursive half of ref_names_under. Only a real directory is descended (a
# symlinked one is a leaf, as in the worktree walk), 64 levels at most.
fn _ref_names_walk(fs_dir, prefix, names, depth) {
    if (depth > 64) { return 0; }
    var raw = sf_dir_list(str_from(fs_dir));
    var dl = strlen(fs_dir);
    var pl = strlen(prefix);
    var i = 0;
    while (i < vec_len(raw)) {
        var s = vec_get(raw, i);
        var sl = str_len(s);
        var child = alloc(dl + 1 + sl + 1);
        memcpy(child, fs_dir, dl);
        store8(child + dl, 47);
        memcpy(child + dl + 1, str_data(s), sl);
        store8(child + dl + 1 + sl, 0);
        var name = alloc(pl + sl + 2);
        memcpy(name, prefix, pl);
        memcpy(name + pl, str_data(s), sl);
        store8(name + pl + sl, 0);
        if (path_lstat_kind(sit_abs(child)) == 0x4000) {
            store8(name + pl + sl, 47);                  # "<prefix><dir>/"
            store8(name + pl + sl + 1, 0);
            _ref_names_walk(child, name, names, depth + 1);
        }
        else { vec_push(names, name); }
        i = i + 1;
    }
    return 0;
}

# Remove the directories a nested ref's deletion left empty between `path` and
# its root (the first `root_len` bytes, e.g. ".sit/refs/heads"), deepest first;
# the root itself always stays. An empty `feature/` would otherwise block a
# later ref named `feature`, as it does in git.
fn _ref_prune_empty_dirs(path, root_len) {
    var len = strlen(path);
    var buf = alloc(len + 1);
    memcpy(buf, path, len);
    store8(buf + len, 0);
    var i = len - 1;
    var go = 1;
    while (go == 1) {
        if (i <= root_len) { go = 0; }
        else {
            if (load8(buf + i) == 47) {
                store8(buf + i, 0);
                if (sf_rmdir(buf) != 0) { go = 0; }
            }
            i = i - 1;
        }
    }
    return 0;
}

# 1.7.6 (L17): a name being CREATED that starts with '-' is an option sit does
# not have — `sit branch -D feature` made a branch named "-D", `sit tag -f v1`
# a tag named "-f". git refuses such names too. Says so and returns 1.
fn ref_name_is_option(name) {
    if (load8(name) != 45) { return 0; }
    eprint3("sit: unknown option '", name, "'\n");
    return 1;
}

# `sit tag [-a|-s] [-d <name> | <name> [-m <msg>] [<commit>]]` — list, create or delete tags.
fn cmd_tag() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    if (argc() < 3) {
        if (sf_exists(".sit/refs/tags") != 1) { return 0; }
        var names = ref_names_under(".sit/refs/tags");
        var m = vec_len(names);
        var i = 0;
        while (i < m) {
            var nm = vec_get(names, i);
            # 1.6.4 (E8): names come from the directory listing, not from
            # refname_valid — a `.sit/refs/tags/$'\e]0;...'` file set the
            # terminal title. Control bytes print as '?'.
            write_sanitized(STDOUT, nm, strlen(nm));
            stdout_write("\n", 1);
            i = i + 1;
        }
        return 0;
    }

    # Deletion: sit tag -d <name>
    if (streq(argv(2), "-d") == 1) {
        if (argc() < 4) {
            eprintln("usage: sit tag -d <name>");
            return 1;
        }
        var dname = argv_heap(3);
        # S-25: the CREATE path below validates the name (S-02) but the DELETE
        # path did not, so `sit tag -d ../../..<path>` built an unlink target
        # outside .sit/refs/tags/. Same grammar, same gate, both directions.
        if (refname_valid(dname) == 0) {
            eprintln("sit: invalid tag name (see git check-ref-format rules)");
            return 1;
        }
        var dnlen = strlen(dname);
        var dpath = alloc(15 + dnlen + 1);
        memcpy(dpath, ".sit/refs/tags/", 15);
        memcpy(dpath + 15, dname, dnlen);
        store8(dpath + 15 + dnlen, 0);
        if (sf_exists(dpath) != 1) {
            syscall(SYS_WRITE, STDERR, "sit: tag '", 10);
            syscall(SYS_WRITE, STDERR, dname, dnlen);
            syscall(SYS_WRITE, STDERR, "' not found\n", 12);
            return 1;
        }
        if (sf_unlink(dpath) != 0) {
            eprintln("sit: failed to remove tag ref");
            return 1;
        }
        _ref_prune_empty_dirs(dpath, 14);                # ".sit/refs/tags"
        stdout_write("deleted tag '", 13);
        write_sanitized(STDOUT, dname, dnlen);   # 1.7.6 (R13)
        stdout_write("'\n", 2);
        return 0;
    }

    # v1.5.0: -a (annotated) / -s (annotated + signed) write a real tag object
    # and point the ref at IT rather than at the commit. Without either flag a
    # tag stays lightweight — a ref file holding a commit oid — which is what
    # every tag before 1.5.0 was, and what git does too.
    var annotated = 0;
    var sign_tag = 0;
    var argi = 2;
    if (streq(argv(2), "-a") == 1) { annotated = 1; argi = 3; }
    else {
        if (streq(argv(2), "-s") == 1) { annotated = 1; sign_tag = 1; argi = 3; }
    }

    var tagmsg = 0;
    if (annotated == 1) {
        if (argc() <= argi) {
            eprintln("usage: sit tag -a|-s <name> [-m <msg>] [<commit>]");
            return 1;
        }
    }

    var name = argv_heap(argi);
    var nlen = strlen(name);
    if (ref_name_is_option(name) == 1) { return 1; }   # 1.7.6 (L17)
    # S-02: tag names follow the same ref-format grammar as branches.
    if (refname_valid(name) == 0) {
        eprintln("sit: invalid tag name (see git check-ref-format rules)");
        return 1;
    }
    var path = alloc(15 + nlen + 1);
    memcpy(path, ".sit/refs/tags/", 15);
    memcpy(path + 15, name, nlen);
    store8(path + 15 + nlen, 0);

    if (sf_exists(path) == 1) {
        syscall(SYS_WRITE, STDERR, "sit: tag '", 10);
        syscall(SYS_WRITE, STDERR, name, nlen);
        syscall(SYS_WRITE, STDERR, "' already exists\n", 17);
        return 1;
    }

    # -m <msg> and an optional <commit>, in either order after the name.
    var targ_i = argi + 1;
    if (annotated == 1) {
        if (argc() > targ_i) {
            if (streq(argv(targ_i), "-m") == 1) {
                if (argc() <= targ_i + 1) {
                    eprintln("sit: -m requires a message");
                    return 1;
                }
                tagmsg = argv_heap(targ_i + 1);
                targ_i = targ_i + 2;
            }
        }
        if (tagmsg == 0) { tagmsg = name; }
    }

    var target_hex = 0;
    if (argc() > targ_i) {
        var prefix = argv_heap(targ_i);
        var hex[72];
        var rr = resolve_hash(prefix, &hex);
        if (rr != 1) {
            eprintln("sit: cannot resolve target commit");
            return 1;
        }
        target_hex = alloc(65);
        memcpy(target_hex, &hex, 64);
        store8(target_hex + 64, 0);
    }
    else {
        target_hex = read_head_ref();
        if (target_hex == 0) {
            eprintln("sit: cannot tag with no commits");
            return 1;
        }
    }

    ensure_dir(".sit/refs/tags");
    ensure_parent_dirs(path);

    # An annotated tag stores an object and the ref points at THAT; the commit
    # is reachable by peeling. fsck's reachability walk peels the same way, so
    # the tagged commit is not reported dangling.
    var ref_hex = target_hex;
    if (annotated == 1) {
        var seed = 0;
        if (sign_tag == 1) {
            seed = load_signing_seed();
            if (seed == 0) {
                eprintln("sit: no signing key (run 'sit key generate')");
                return 1;
            }
        }
        var tag_hex = write_tag_object(target_hex, name, tagmsg, seed);
        if (tag_hex == 0) {
            eprintln("sit: failed to write tag object");
            return 1;
        }
        ref_hex = tag_hex;
    }

    var buf = alloc(66);
    memcpy(buf, ref_hex, 64);
    store8(buf + 64, 10);
    store8(buf + 65, 0);
    if (sf_write_atomic(path, buf, 65) < 0) {
        eprintln("sit: failed to write tag ref");
        return 1;
    }

    stdout_write("created tag '", 13);
    write_sanitized(STDOUT, name, nlen);   # 1.7.6 (R13)
    stdout_write("'\n", 2);
    return 0;
}

# `sit branch [-d <name> | <name>]` — list, create or delete a branch.
fn cmd_branch() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    if (argc() < 3) {
        if (sf_exists(".sit/refs/heads") != 1) { return 0; }
        var names = ref_names_under(".sit/refs/heads");
        var curr = current_branch_name();
        var i = 0;
        var m = vec_len(names);
        while (i < m) {
            var nm = vec_get(names, i);
            var is_current = 0;
            if (curr != 0) {
                if (streq(nm, curr) == 1) { is_current = 1; }
            }
            if (is_current == 1) { stdout_write("* ", 2); }
            else                 { stdout_write("  ", 2); }
            write_sanitized(STDOUT, nm, strlen(nm));   # E8, as for tags
            stdout_write("\n", 1);
            i = i + 1;
        }
        return 0;
    }

    # Deletion: sit branch -d <name>
    if (streq(argv(2), "-d") == 1) {
        if (argc() < 4) {
            eprintln("usage: sit branch -d <name>");
            return 1;
        }
        var dname = argv_heap(3);
        # S-25: same gap as `sit tag -d` — the create path validates, the delete
        # path did not, so the unlink target could escape .sit/refs/heads/.
        # Note this also gates the reflog unlink below (reflog_log_path(dlref)).
        if (refname_valid(dname) == 0) {
            eprintln("sit: invalid branch name (see git check-ref-format rules)");
            return 1;
        }
        var dnlen = strlen(dname);
        var dpath = alloc(16 + dnlen + 1);
        memcpy(dpath, ".sit/refs/heads/", 16);
        memcpy(dpath + 16, dname, dnlen);
        store8(dpath + 16 + dnlen, 0);
        if (sf_exists(dpath) != 1) {
            syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
            syscall(SYS_WRITE, STDERR, dname, dnlen);
            syscall(SYS_WRITE, STDERR, "' not found\n", 12);
            return 1;
        }
        var curr_br = current_branch_name();
        if (curr_br != 0) {
            if (streq(curr_br, dname) == 1) {
                eprintln("sit: cannot delete the currently checked-out branch");
                return 1;
            }
        }
        if (sf_unlink(dpath) != 0) {
            eprintln("sit: failed to remove branch ref");
            return 1;
        }
        # Mirror git: deleting a branch deletes its reflog too. Leaving the
        # log orphaned would pin the branch's objects against fsck --prune
        # forever (it walks every .sit/logs/** file) and corrupt <name>@{N}
        # if the branch were later recreated (append to a stale log). Best-
        # effort unlink — a missing log (branch never logged) is fine.
        var dlref = alloc(11 + dnlen + 1);
        memcpy(dlref, "refs/heads/", 11);
        memcpy(dlref + 11, dname, dnlen);
        store8(dlref + 11 + dnlen, 0);
        var dlog = reflog_log_path(dlref);
        sf_unlink(dlog);
        _ref_prune_empty_dirs(dpath, 15);                # ".sit/refs/heads"
        _ref_prune_empty_dirs(dlog, strlen(dlog) - dnlen - 1);   # ".../logs/refs/heads"
        stdout_write("deleted branch '", 16);
        write_sanitized(STDOUT, dname, dnlen);   # 1.7.6 (R13)
        stdout_write("'\n", 2);
        return 0;
    }

    var name = argv_heap(2);
    var nlen = strlen(name);
    if (ref_name_is_option(name) == 1) { return 1; }   # 1.7.6 (L17)
    # S-02: reject names that don't satisfy git check-ref-format rules.
    if (refname_valid(name) == 0) {
        eprintln("sit: invalid branch name (see git check-ref-format rules)");
        return 1;
    }
    var path = alloc(16 + nlen + 1);
    memcpy(path, ".sit/refs/heads/", 16);
    memcpy(path + 16, name, nlen);
    store8(path + 16 + nlen, 0);

    if (sf_exists(path) == 1) {
        syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
        syscall(SYS_WRITE, STDERR, name, nlen);
        syscall(SYS_WRITE, STDERR, "' already exists\n", 17);
        return 1;
    }

    var head_hex = read_head_ref();
    if (head_hex == 0) {
        eprintln("sit: cannot create a branch with no commits");
        return 1;
    }

    ensure_parent_dirs(path);
    var buf = alloc(66);
    memcpy(buf, head_hex, 64);
    store8(buf + 64, 10);
    store8(buf + 65, 0);
    if (sf_write_atomic(path, buf, 65) < 0) {
        eprintln("sit: failed to write branch ref");
        return 1;
    }

    # Reflog the new branch's creation (old=zeros). HEAD doesn't move, so
    # only the new branch's log gets an entry — not logs/HEAD.
    var br_ref = alloc(11 + nlen + 1);
    memcpy(br_ref, "refs/heads/", 11);
    memcpy(br_ref + 11, name, nlen);
    store8(br_ref + 11 + nlen, 0);
    reflog_append(br_ref, 0, head_hex, "branch: Created from HEAD");

    stdout_write("created branch '", 16);
    write_sanitized(STDOUT, name, nlen);   # 1.7.6 (R13)
    stdout_write("'\n", 2);
    return 0;
}

# True if there are any staged or unstaged changes vs HEAD. Untracked files
# are not considered dirty (they don't block checkout unless they collide).
fn cmd_checkout() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit checkout [-b] <branch>");
        return 1;
    }

    var create = 0;
    var arg_idx = 2;
    if (streq(argv(2), "-b") == 1) {
        create = 1;
        arg_idx = 3;
        if (argc() < 4) {
            eprintln("usage: sit checkout -b <branch>");
            return 1;
        }
    }
    var target = argv_heap(arg_idx);
    var tlen = strlen(target);
    if (create == 1) { if (ref_name_is_option(target) == 1) { return 1; } }   # 1.7.6 (L17)

    # S-02 for every checkout, not only -b (1.6.4, E7): `sit checkout
    # ../tags/lt` was accepted and wrote `ref: refs/heads/../tags/lt` into HEAD,
    # which every reader then rejected — HEAD bricked until hand-edited.
    if (refname_valid(target) == 0) {
        eprintln("sit: invalid branch name (see git check-ref-format rules)");
        return 1;
    }
    # 1.7.6 (L2): an operation in progress belongs to this branch. Switching away
    # carried its MERGE_HEAD (or CHERRY_PICK_HEAD / REVERT_HEAD) along, and the
    # next commit there recorded it. `checkout -b` stays allowed: committing an
    # in-progress merge onto a new branch is what that is for.
    if (create == 0) {
        var in_prog = 0;
        if (sf_exists(".sit/MERGE_HEAD") == 1) { in_prog = 1; }
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) { in_prog = 1; }
        if (sf_exists(".sit/REVERT_HEAD") == 1) { in_prog = 1; }
        if (in_prog == 1) {
            eprintln("sit: a merge, cherry-pick or revert is in progress — commit it first,");
            eprintln("sit:   or drop it with 'sit merge --abort' / 'sit reset --hard'");
            return 1;
        }
    }

    if (create == 1) {
        var new_branch = alloc(16 + tlen + 1);
        memcpy(new_branch, ".sit/refs/heads/", 16);
        memcpy(new_branch + 16, target, tlen);
        store8(new_branch + 16 + tlen, 0);
        if (sf_exists(new_branch) == 1) {
            syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
            syscall(SYS_WRITE, STDERR, target, tlen);
            syscall(SYS_WRITE, STDERR, "' already exists\n", 17);
            return 1;
        }
        var head_hex = read_head_ref();
        if (head_hex == 0) {
            eprintln("sit: cannot create a branch with no commits");
            return 1;
        }
        ensure_parent_dirs(new_branch);
        var buf = alloc(66);
        memcpy(buf, head_hex, 64);
        store8(buf + 64, 10);
        store8(buf + 65, 0);
        if (sf_write_atomic(new_branch, buf, 65) < 0) {
            eprintln("sit: failed to write branch ref");
            return 1;
        }
        # Reflog the -b branch creation (old=zeros) to the new branch's log.
        var nb_ref = alloc(11 + tlen + 1);
        memcpy(nb_ref, "refs/heads/", 11);
        memcpy(nb_ref + 11, target, tlen);
        store8(nb_ref + 11 + tlen, 0);
        reflog_append(nb_ref, 0, head_hex, "branch: Created from HEAD");
    }

    var target_ref_len = 11 + tlen;
    var target_ref = alloc(target_ref_len + 1);
    memcpy(target_ref, "refs/heads/", 11);
    memcpy(target_ref + 11, target, tlen);
    store8(target_ref + target_ref_len, 0);

    var target_path = alloc(5 + target_ref_len + 1);
    memcpy(target_path, ".sit/", 5);
    memcpy(target_path + 5, target_ref, target_ref_len);
    store8(target_path + 5 + target_ref_len, 0);

    if (sf_exists(target_path) != 1) {
        syscall(SYS_WRITE, STDERR, "sit: branch '", 13);
        syscall(SYS_WRITE, STDERR, target, tlen);
        syscall(SYS_WRITE, STDERR, "' not found\n", 12);
        return 1;
    }

    var curr = current_branch_name();
    if (curr != 0) {
        if (streq(curr, target) == 1) {
            stdout_write("already on '", 12);
            write_sanitized(STDOUT, target, tlen);   # 1.7.6 (R13)
            stdout_write("'\n", 2);
            return 0;
        }
    }

    if (is_dirty() == 1) {
        eprintln("sit: working tree has uncommitted changes");
        eprintln("sit:   commit or revert before switching branches");
        return 1;
    }

    var target_fd = sf_open(target_path, 0, 0);
    if (target_fd < 0) {
        eprintln("sit: cannot read target branch ref");
        return 1;
    }
    var target_hex = alloc(80);
    var n = file_read(target_fd, target_hex, 80);
    file_close(target_fd);
    if (n < 64) {
        eprintln("sit: target ref is invalid");
        return 1;
    }
    # S-25: apply the S-11 hex gate here too. `cmd_checkout` read the ref file
    # and NUL-terminated at 64 without validating the bytes, so a corrupt or
    # hand-written ref sent raw content into commit_tree_entries -> read_object,
    # where it is interpolated into a patra SQL string literal and recorded in
    # the reflog. Every other ref consumer already gates on hex_prefix_valid.
    if (hex_prefix_valid(target_hex, 64) == 0) {
        eprintln("sit: target ref is invalid");
        return 1;
    }
    store8(target_hex + 64, 0);

    # Untracked files in the way, symlinked parents, and a failed write all
    # refuse inside materialize_target_safe (is_dirty already ran above). Its
    # failure must stop the switch: through 1.6.3 the return was ignored, so
    # HEAD moved onto a tree the worktree and index did not hold and the next
    # commit silently reverted the branch.
    if (materialize_target_safe(target_hex, 1) != 0) {
        eprintln("sit: checkout aborted — HEAD unchanged");
        return 1;
    }

    # Capture the old HEAD tip before the symref moves (materialize doesn't
    # touch refs, so this still resolves the branch we're leaving).
    var co_old = read_head_ref();
    if (set_head_ref(target_ref) != 0) {
        eprintln("sit: failed to update HEAD");
        return 1;
    }

    # Reflog the branch switch to logs/HEAD only (no branch-tip moved):
    # "checkout: moving from <old> to <new>".
    var co_oldname = curr;
    if (co_oldname == 0) { co_oldname = "HEAD"; }
    var co_onl = strlen(co_oldname);
    var co_msg = alloc(30 + co_onl + tlen);
    var co_mp = 0;
    memcpy(co_msg + co_mp, "checkout: moving from ", 22); co_mp = co_mp + 22;
    memcpy(co_msg + co_mp, co_oldname, co_onl); co_mp = co_mp + co_onl;
    memcpy(co_msg + co_mp, " to ", 4); co_mp = co_mp + 4;
    memcpy(co_msg + co_mp, target, tlen); co_mp = co_mp + tlen;
    store8(co_msg + co_mp, 0);
    reflog_append("HEAD", co_old, target_hex, co_msg);

    stdout_write("switched to branch '", 20);
    write_sanitized(STDOUT, target, tlen);
    stdout_write("'\n", 2);
    return 0;
}

# --- tree.cyr ---

# tree.cyr — sit tree objects.
#
# Top-level tree layout for subdirectory grouping (`tlvl_*`), git-SHA-256-compatible
# tree entry parse / build / flatten, and tree_find lookups. Trees encode
# directories as `40000 <name>\0<32B hash>` entries and files as `100644 ...`.

# Mode of a build_tree level entry.
fn tlvl_mode(e) { return load64(e); }
# Name of a build_tree level entry.
fn tlvl_name(e) { return load64(e + 8); }
# Raw (binary) id of a build_tree level entry.
fn tlvl_bytes(e) { return load64(e + 16); }

# Recursive tree writer.
# `entries` is a slice of the sorted+deduped staging index; all entries passed
# at a given call share the same prefix of length `prefix_len` (empty at root).
# Lexical sort of full paths produces correct per-tree git order when walked
# depth-first — no separate sort step needed at the level.
# Returns tree hex hash, or 0 on failure.
fn build_tree(entries, prefix_len) {
    var level = vec_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        var full_path = entry_path(e);
        var rest = full_path + prefix_len;
        var rest_len = strlen(full_path) - prefix_len;

        var slash = 0;
        var found = 0;
        while (slash < rest_len) {
            if (load8(rest + slash) == 47) { found = 1; break; }
            slash = slash + 1;
        }

        if (found == 0) {
            var name = alloc_or_die(rest_len + 1);
            memcpy(name, rest, rest_len);
            store8(name + rest_len, 0);

            var le = alloc_or_die(24);
            store64(le, "100644");
            store64(le + 8, name);
            store64(le + 16, entry_hash(e));
            vec_push(level, le);
            i = i + 1;
        }
        else {
            var subdir_name = alloc_or_die(slash + 1);
            memcpy(subdir_name, rest, slash);
            store8(subdir_name + slash, 0);

            var sub_prefix_len = prefix_len + slash + 1;
            var sub_entries = vec_new();

            var collecting = 1;
            while (collecting == 1) {
                if (i >= n) { collecting = 0; }
                else {
                    var ee = vec_get(entries, i);
                    var ee_path = entry_path(ee);
                    var ee_len = strlen(ee_path);
                    var ok = 1;
                    if (ee_len <= prefix_len + slash) { ok = 0; }
                    else {
                        var m = 0;
                        while (m < slash) {
                            if (load8(ee_path + prefix_len + m) != load8(rest + m)) { ok = 0; }
                            m = m + 1;
                        }
                        if (ok == 1) {
                            if (load8(ee_path + prefix_len + slash) != 47) { ok = 0; }
                        }
                    }
                    if (ok == 0) { collecting = 0; }
                    else {
                        vec_push(sub_entries, ee);
                        i = i + 1;
                    }
                }
            }

            var sub_hex = build_tree(sub_entries, sub_prefix_len);
            if (sub_hex == 0) { return 0; }
            var sub_bytes = hex_decode(sub_hex, 64);
            if (sub_bytes == 0) { return 0; }

            var le = alloc_or_die(24);
            store64(le, "40000");
            store64(le + 8, subdir_name);
            store64(le + 16, sub_bytes);
            vec_push(level, le);
        }
    }

    # 1.6.4 (A11): a name may appear once per level. A merge where one side
    # added file `a` and the other `a/b` handed both through as clean, and this
    # wrote a tree naming `a` twice — a file AND a directory — which readers
    # now drop (parse_tree's order check) and git rejects. Refuse to write it.
    var seen_names = map_new();
    var dn = vec_len(level);
    var di = 0;
    while (di < dn) {
        var dname = tlvl_name(vec_get(level, di));
        if (map_has(seen_names, dname) == 1) {
            eprint3("sit: '", dname, "' would be both a file and a directory — resolve the clash first\n");
            return 0;
        }
        map_set(seen_names, dname, 1);
        di = di + 1;
    }

    var body_size = 0;
    var k = 0;
    var nl = vec_len(level);
    while (k < nl) {
        var le = vec_get(level, k);
        body_size = body_size + strlen(tlvl_mode(le)) + 1 + strlen(tlvl_name(le)) + 1 + 32;
        k = k + 1;
    }

    var body = alloc_or_die(body_size);
    var pos = 0;
    k = 0;
    while (k < nl) {
        var le = vec_get(level, k);
        var mode = tlvl_mode(le);
        var name = tlvl_name(le);
        var mlen = strlen(mode);
        var nlen = strlen(name);
        memcpy(body + pos, mode, mlen); pos = pos + mlen;
        store8(body + pos, 32); pos = pos + 1;
        memcpy(body + pos, name, nlen); pos = pos + nlen;
        store8(body + pos, 0); pos = pos + 1;
        memcpy(body + pos, tlvl_bytes(le), 32); pos = pos + 32;
        k = k + 1;
    }

    return write_typed_object("tree", 4, body, body_size);
}

# S-26: count of tree entries `parse_tree` silently discarded (bad mode,
# unsafe name, or — since 1.6.4 — a duplicate or out-of-order name). fsck
# resets this before its walk and treats a non-zero value as structural
# corruption, because a discarded entry's object is invisible to the
# reachability walk and would otherwise be pruned while still referenced.
var _tree_dropped_entries = 0;
# Zero the count of tree entries parse_tree had to drop.
fn tree_dropped_reset() { _tree_dropped_entries = 0; return 0; }
# Tree entries parse_tree dropped since the last reset (fsck refuses to prune if nonzero).
fn tree_dropped_count() { return _tree_dropped_entries; }

# Mode string of a parsed tree entry.
fn tree_entry_mode(e) { return load64(e); }
# Name of a parsed tree entry.
fn tree_entry_name(e) { return load64(e + 8); }
# Hex id of a parsed tree entry.
fn tree_entry_hash(e) { return load64(e + 16); }

# git's tree order (base_name_compare): byte-compare the common prefix; where
# one name ends, a tree continues as if followed by '/', a file by NUL. <0, 0
# or >0, like memcmp.
fn _tree_order_cmp(a, alen, a_tree, b, blen, b_tree) {
    var n = alen;
    if (blen < n) { n = blen; }
    var i = 0;
    while (i < n) {
        var ca = load8(a + i) & 0xFF;
        var cb = load8(b + i) & 0xFF;
        if (ca != cb) { return ca - cb; }
        i = i + 1;
    }
    var c1 = 0;
    var c2 = 0;
    if (alen > n) { c1 = load8(a + n) & 0xFF; }
    else { if (a_tree == 1) { c1 = 47; } }
    if (blen > n) { c2 = load8(b + n) & 0xFF; }
    else { if (b_tree == 1) { c2 = 47; } }
    return c1 - c2;
}

# Parse tree object body. Returns vec of entries.
fn parse_tree(body, body_len) {
    var entries = vec_new();
    # Raw hash width per active backend: 32 (sit SHA-256) or 20 (git SHA-1).
    var rawlen = _id_rawlen();
    var pos = 0;
    # Previous RAW entry (kept or not), for the order / duplicate check below.
    var prev_name = 0;
    var prev_len = 0;
    var prev_tree = 0;
    while (pos < body_len) {
        var sp = pos;
        while (sp < body_len) {
            if (load8(body + sp) == 32) { break; }
            sp = sp + 1;
        }
        if (sp >= body_len) { pos = body_len; }
        else {
            var mode_len = sp - pos;
            var mode = alloc_or_die(mode_len + 1);
            memcpy(mode, body + pos, mode_len);
            store8(mode + mode_len, 0);

            var nu = sp + 1;
            while (nu < body_len) {
                if (load8(body + nu) == 0) { break; }
                nu = nu + 1;
            }
            if (nu >= body_len) { pos = body_len; }
            else {
                var name_len = nu - sp - 1;
                var name = alloc_or_die(name_len + 1);
                memcpy(name, body + sp + 1, name_len);
                store8(name + name_len, 0);

                if (nu + 1 + rawlen > body_len) { pos = body_len; }
                else {
                    # S-03: reject tree entries whose mode isn't allowlisted or
                    # whose name would let an attacker escape the working tree.
                    # Silent drop here means a malicious subtree is treated as
                    # empty — materialize_target won't act on it.
                    #
                    # S-26: the drop must not stay silent for FSCK. A dropped
                    # entry is never enqueued by fsck_walk_reachable, so the
                    # blob or subtree it names is reported `dangling` even though
                    # a live tree still references it — and `fsck --prune-now`
                    # then DELETED it, breaking clone/checkout of that history
                    # with no reflog recovery path. Neither existing tripwire
                    # caught it: `bad` stayed 0 (both objects read fine) and the
                    # all-unreachable check does not apply.
                    #
                    # Reachable without local access: `_serve_rehash_and_insert`
                    # validates framing, type and SHA-256 but never parses a tree
                    # body, so a pushed tree carrying e.g. a `100755` entry is
                    # accepted, and its blob with it.
                    #
                    # The counter lets fsck treat "this tree has entries I could
                    # not parse" as a structural defect and refuse to prune.
                    # 1.6.4: every entry must sort STRICTLY after the one before
                    # it in git order, which rules out duplicate names. A tree
                    # naming `a` twice made `sit show` list both blobs while
                    # checkout wrote the second — the review-vs-checkout split
                    # behind Gitea's CVE-2026-95106 — and fsck called it clean.
                    # git's fsck rejects both shapes (duplicateEntries,
                    # treeNotSorted). Every sit writer sorts before build_tree,
                    # so this never drops an entry sit wrote; a later duplicate
                    # is dropped, leaving every reader the same first entry.
                    var is_tree = 0;
                    if (streq(mode, "40000") == 1) { is_tree = 1; }
                    var in_order = 1;
                    if (prev_name != 0) {
                        if (_tree_order_cmp(prev_name, prev_len, prev_tree,
                            name, name_len, is_tree) >= 0) { in_order = 0; }
                        if (prev_len == name_len) {
                            if (memeq(prev_name, name, name_len) == 1) { in_order = 0; }
                        }
                    }
                    prev_name = name;
                    prev_len = name_len;
                    prev_tree = is_tree;
                    var kept = 0;
                    if (in_order == 1) {
                        if (tree_entry_mode_valid(mode) == 1) {
                            if (tree_entry_name_valid(name) == 1) {
                                var hash_hex = hex_encode(body + nu + 1, rawlen);
                                var e = alloc_or_die(24);
                                store64(e, mode);
                                store64(e + 8, name);
                                store64(e + 16, hash_hex);
                                vec_push(entries, e);
                                kept = 1;
                            }
                        }
                    }
                    if (kept == 0) { _tree_dropped_entries = _tree_dropped_entries + 1; }
                    pos = nu + 1 + rawlen;
                }
            }
        }
    }
    return entries;
}

# Recursively walk a tree, pushing one entry per file to `out` with the full
# path (e.g., "src/main.cyr") stored in the `name` slot. Subtree entries are
# traversed, not emitted. Returned entries can be searched by `tree_find`
# against full paths because it only uses the name/hash slots.
#
# S-14: bounds recursion depth via a module-level counter. 256 levels matches
# git's limit and covers every realistic project hierarchy.

var _TREE_MAX_DEPTH = 256;
var _tree_walk_depth = 0;

# S-25: depth is not the only unbounded dimension.
#
# S-14 capped how DEEP the walk goes, but not how MANY nodes it visits. A tree
# object may reference the same subtree hash many times, and each reference is
# expanded again — so a DAG of k levels where every level names the previous
# subtree N times expands to N^k paths from a repository of only a few hundred
# KB. Depth 256 is never reached; memory is exhausted first, on the read-only
# path owl / thoth call against untrusted repos.
#
# The node budget bounds total expansions per top-level walk. 2M entries is far
# above any real tree (the Linux kernel is ~80k files) and is reached in well
# under a second, so a hostile repo fails fast instead of ballooning.
var _TREE_MAX_NODES = 2000000;
var _tree_walk_nodes = 0;

# Reset the per-walk budgets. Every EXTERNAL entry into flatten_tree must call
# this first; the recursion itself must not.
fn flatten_tree_reset() {
    _tree_walk_depth = 0;
    _tree_walk_nodes = 0;
    return 0;
}

# Push one {mode, full path, hash} entry per file under `tree_hex`; depth- and node-capped.
fn flatten_tree(tree_hex, prefix, out) {
    if (_tree_walk_depth >= _TREE_MAX_DEPTH) {
        eprintln("sit: tree depth exceeds 256 — refusing to walk further");
        return 0 - 2;
    }
    if (_tree_walk_nodes >= _TREE_MAX_NODES) {
        eprintln("sit: tree entry count exceeds the walk limit (malformed or hostile repo?)");
        return 0 - 2;
    }
    _tree_walk_depth = _tree_walk_depth + 1;
    var obj[24];
    if (read_object(tree_hex, &obj) != 0) {
        _tree_walk_depth = _tree_walk_depth - 1;
        return 0 - 1;
    }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);

    var entries = parse_tree(buf + coff, blen - coff);
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        var mode = tree_entry_mode(e);
        var name = tree_entry_name(e);
        var hash_hex = tree_entry_hash(e);
        _tree_walk_nodes = _tree_walk_nodes + 1;   # S-25 node budget

        var prefix_len = strlen(prefix);
        var name_len = strlen(name);

        if (streq(mode, "40000") == 1) {
            var sub_prefix = alloc_or_die(prefix_len + name_len + 2);
            memcpy(sub_prefix, prefix, prefix_len);
            memcpy(sub_prefix + prefix_len, name, name_len);
            store8(sub_prefix + prefix_len + name_len, 47);
            store8(sub_prefix + prefix_len + name_len + 1, 0);
            # 1.7.6 (L8): a subtree that cannot be read (or that trips a
            # budget) fails the whole walk. Its result was discarded, so only a
            # bad ROOT tree failed — a missing `d/` read as an empty directory
            # and checkout / reset / merge deleted everything under it.
            var sr = flatten_tree(hash_hex, sub_prefix, out);
            if (sr < 0) {
                _tree_walk_depth = _tree_walk_depth - 1;
                return sr;
            }
        }
        else {
            var full_path = alloc_or_die(prefix_len + name_len + 1);
            memcpy(full_path, prefix, prefix_len);
            memcpy(full_path + prefix_len, name, name_len);
            store8(full_path + prefix_len + name_len, 0);

            var flat = alloc_or_die(24);
            store64(flat, mode);
            store64(flat + 8, full_path);
            store64(flat + 16, hash_hex);
            vec_push(out, flat);
        }
        i = i + 1;
    }
    _tree_walk_depth = _tree_walk_depth - 1;
    return 0;
}

var _head_tree_warned = 0;

# Read HEAD → commit → tree, recursively flatten into full-path entries.
# Returns vec or 0 if there's no HEAD commit yet — or if HEAD's tree cannot be
# read, which is said on stderr (once per process: the public API runs this per
# status call inside owl / thoth): callers treat 0 as "nothing tracked", the
# safe reading for the dirty / untracked checks.
fn read_head_tree_entries() {
    var head_commit = read_head_ref();
    if (head_commit == 0) { return 0; }
    # 1.7.6 (L8): the same parse as every other tree read (parse_commit_body,
    # the walk's failure propagated). This took any "tree " first line and
    # ignored the walk's result.
    var out = commit_tree_entries(head_commit);
    if (out == 0) {
        if (_head_tree_warned == 0) {
            eprintln("sit: HEAD's tree cannot be read (missing or corrupt objects) — run 'sit fsck'");
            _head_tree_warned = 1;
        }
    }
    return out;
}

# P-10: tree_find cache. The previous O(N) linear scan was called in O(N)
# loops (cmd_status iterating index entries against head_entries; cmd_diff;
# materialize_target; the merge three-way loops). For any entries vec that's
# searched more than once, build a name → entry hashmap on first call and
# reuse it for every subsequent tree_find on the same vec. Cache keyed by
# vec pointer; lifetime = process (sit is short-lived per invocation).
#
# Worst case (one tree_find per vec): one map build + one lookup = O(N) + O(1).
# Same complexity as the old linear scan. Strictly an improvement when called
# more than once on the same vec, which every hot caller does.
var _tree_find_keys = 0;
var _tree_find_maps = 0;

fn _tree_find_map(entries) {
    if (_tree_find_keys == 0) {
        _tree_find_keys = vec_new();
        _tree_find_maps = vec_new();
    }
    var k = vec_len(_tree_find_keys);
    var ki = 0;
    while (ki < k) {
        if (vec_get(_tree_find_keys, ki) == entries) {
            return vec_get(_tree_find_maps, ki);
        }
        ki = ki + 1;
    }
    var m = map_new();
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        map_set(m, tree_entry_name(e), e);
        i = i + 1;
    }
    vec_push(_tree_find_keys, entries);
    vec_push(_tree_find_maps, m);
    return m;
}

# Drop `entries`' cached map (1.7.6, R1). A caller that builds a vec per call
# and is called again and again — the public API, in owl / thoth — releases it
# when done; otherwise every call left one more key for every later tree_find
# to scan past.
fn tree_find_release(entries) {
    if (_tree_find_keys == 0) { return 0; }
    var k = vec_len(_tree_find_keys);
    var ki = 0;
    var at = 0 - 1;
    while (ki < k) {
        if (at < 0) { if (vec_get(_tree_find_keys, ki) == entries) { at = ki; } }
        ki = ki + 1;
    }
    if (at < 0) { return 0; }
    var last = k - 1;
    if (at != last) {
        vec_set(_tree_find_keys, at, vec_get(_tree_find_keys, last));
        vec_set(_tree_find_maps, at, vec_get(_tree_find_maps, last));
    }
    vec_pop(_tree_find_keys);
    vec_pop(_tree_find_maps);
    return 0;
}

# Entry named `name` in a parsed tree (hashmap-backed), or 0.
fn tree_find(entries, name) {
    if (entries == 0) { return 0; }
    var m = _tree_find_map(entries);
    return map_get(m, name);
}

# Hex id of the entry at `path`, or 0.
fn tree_find_hash(entries, path) {
    if (entries == 0) { return 0; }
    var e = tree_find(entries, path);
    if (e == 0) { return 0; }
    return tree_entry_hash(e);
}

# Union of paths across three flattened tree entry vecs. Returns a vec of
# heap-copied path cstrings, each unique.
#
# P-18: dedup via hashmap rather than the O(N²) nested-streq scan over the
# growing `paths` vec. For three trees of N entries each, the old loop did
# ~3N × (3N/2) = ~4.5N² streqs; with the map it's 3N inserts + 3N membership
# checks, all O(1) amortized.
fn three_way_path_set(base, ours, theirs) {
    var paths = vec_new();
    var seen = map_new();
    var sources_cnt = 3;
    var sources[24];
    store64(&sources + 0, base);
    store64(&sources + 8, ours);
    store64(&sources + 16, theirs);

    var si = 0;
    while (si < sources_cnt) {
        var entries = load64(&sources + si * 8);
        if (entries != 0) {
            var n = vec_len(entries);
            var i = 0;
            while (i < n) {
                var e = vec_get(entries, i);
                var p = tree_entry_name(e);
                if (map_has(seen, p) == 0) {
                    var plen = strlen(p);
                    var copy = alloc_or_die(plen + 1);
                    memcpy(copy, p, plen);
                    store8(copy + plen, 0);
                    map_set(seen, copy, 1);
                    vec_push(paths, copy);
                }
                i = i + 1;
            }
        }
        si = si + 1;
    }
    return paths;
}

# Walk descendant's parent chain; return 1 if ancestor_hex is descendant
# or any of its ancestors. Linear — sit has no merge commits yet.

# --- tag.cyr ---

# tag.cyr — annotated (and signed) tag objects.
#
# Until v1.5.0 every `sit tag` was a LIGHTWEIGHT tag: a file under
# `.sit/refs/tags/<name>` holding a commit oid. That stays the default, exactly
# as in git. `-a` / `-s` instead write a real **tag object** and point the ref
# at that, so the tag carries a tagger, a timestamp and a message of its own.
#
# Body framing is byte-compatible with git's tag object:
#
#   object <64-hex>\n
#   type commit\n
#   tag <name>\n
#   tagger <name> <email> <ts> +0000\n
#   \n
#   <message>\n
#
# A signed tag reuses the commit machinery verbatim — `sign_commit_body` only
# needs a body with a `\n\n` header/message split, which this has, and it signs
# the payload without the sitsig line so `verify_commit_body` re-parses it the
# same way. No tag-specific crypto path exists, and none should: a second
# signing path is a second thing to get wrong.

# patra `ty` code for a tag object. blob=0, tree=1, commit=2 (object_db.cyr).
var OBJ_TY_TAG = 3;

# Max links followed by peel_tag. A tag object may name another tag, and two
# hostile tags can name each other; the cap makes that terminate. Same shape as
# _WIRE_MAX_DEPTH in the tree walk.
var TAG_PEEL_MAX = 16;

# Upper bound on the commits `describe` walks (the described commit's whole
# ancestry since 1.7.3). A larger history is refused rather than walked
# without end on a hostile parent graph.
var SIT_DESCRIBE_MAX = 100000;

# Tags that compete for `describe`, nearest first: one bit each in an i64
# (git's default is 10).
var SIT_DESCRIBE_CANDIDATES = 62;

# Build an annotated tag object body. `seed` non-zero also signs it.
# Returns the heap body with its length at *out_len, or 0 on failure.
fn build_tag_body(target_hex, name, message, seed, out_len) {
    # Same identity resolution and sanitisation as build_commit_signed:
    # env -> .sit/config -> ~/.sitconfig -> fallback, then S-27 stripping of
    # control bytes and <> BEFORE framing, so a newline in SIT_AUTHOR_NAME
    # cannot forge a `object`/`type`/`tag` header line here either.
    var tname = getenv("SIT_AUTHOR_NAME");
    if (tname == 0) { tname = config_get("user.name"); }
    if (tname == 0) { tname = "sit user"; }
    var temail = getenv("SIT_AUTHOR_EMAIL");
    if (temail == 0) { temail = config_get("user.email"); }
    if (temail == 0) { temail = "user@localhost"; }
    tname = ident_sanitized(tname);
    temail = ident_sanitized(temail);
    if (strlen(tname) == 0) { tname = "sit user"; }
    if (strlen(temail) == 0) { temail = "user@localhost"; }

    var ts = clock_epoch_secs();
    var nlen = strlen(name);
    var tnlen = strlen(tname);
    var telen = strlen(temail);
    var mlen = strlen(message);

    var cap = 512 + nlen + tnlen + telen + mlen;
    var body = alloc_or_die(cap);
    var pos = 0;

    memcpy(body + pos, "object ", 7); pos = pos + 7;
    memcpy(body + pos, target_hex, 64); pos = pos + 64;
    store8(body + pos, 10); pos = pos + 1;

    # sit tags always point at a commit today; `type` is emitted anyway so the
    # object stays git-shaped and a future tag-of-tag has somewhere to say so.
    memcpy(body + pos, "type commit\n", 12); pos = pos + 12;

    memcpy(body + pos, "tag ", 4); pos = pos + 4;
    memcpy(body + pos, name, nlen); pos = pos + nlen;
    store8(body + pos, 10); pos = pos + 1;

    memcpy(body + pos, "tagger ", 7); pos = pos + 7;
    memcpy(body + pos, tname, tnlen); pos = pos + tnlen;
    memcpy(body + pos, " <", 2); pos = pos + 2;
    memcpy(body + pos, temail, telen); pos = pos + telen;
    memcpy(body + pos, "> ", 2); pos = pos + 2;
    var digits = write_decimal(body + pos, ts); pos = pos + digits;
    memcpy(body + pos, " +0000\n", 7); pos = pos + 7;

    store8(body + pos, 10); pos = pos + 1;          # blank line
    memcpy(body + pos, message, mlen); pos = pos + mlen;
    if (mlen > 0) {
        if (load8(body + pos - 1) != 10) { store8(body + pos, 10); pos = pos + 1; }
    }

    if (seed == 0) {
        store64(out_len, pos);
        return body;
    }
    var slen[8];
    var signed_body = sign_commit_body(body, pos, seed, &slen);
    if (signed_body == 0) { return 0; }
    store64(out_len, load64(&slen));
    return signed_body;
}

# Write an annotated tag object. Returns its heap hex oid, or 0.
fn write_tag_object(target_hex, name, message, seed) {
    var blen[8];
    var body = build_tag_body(target_hex, name, message, seed, &blen);
    if (body == 0) { return 0; }
    return write_typed_object("tag", 3, body, load64(&blen));
}

# Parse a tag object body. Writes to `out` (40 bytes):
#   0..8   target oid (heap cstring, 64 hex + NUL)
#   8..16  tag name (heap cstring)
#   16..24 tagger line start offset, or 0 - 1 if absent
#   24..32 message start offset, or 0 - 1 if absent
#   32..40 tagger timestamp (epoch secs), or 0
# Returns 0 on success, non-zero if the body is not a well-formed tag.
#
# Every field is bounds-checked against `body_len` before it is read: a tag
# object can arrive from any remote, and `_serve_rehash_and_insert` validates
# framing and SHA-256 but does not parse bodies.
fn parse_tag_body(body, body_len, out) {
    store64(out, 0);
    store64(out + 8, 0);
    store64(out + 16, 0 - 1);
    store64(out + 24, 0 - 1);
    store64(out + 32, 0);

    if (body_len < 7) { return 0 - 1; }
    if (memeq(body, "object ", 7) == 0) { return 0 - 1; }
    if (body_len < 7 + 64 + 1) { return 0 - 1; }
    if (hex_prefix_valid(body + 7, 64) == 0) { return 0 - 1; }
    if (load8(body + 7 + 64) != 10) { return 0 - 1; }
    var target = alloc(65);
    memcpy(target, body + 7, 64);
    store8(target + 64, 0);
    store64(out, target);

    var pos = 7 + 64 + 1;
    var found_name = 0;
    var in_headers = 1;
    while (in_headers == 1) {
        if (pos >= body_len) { in_headers = 0; }
        else {
            if (load8(body + pos) == 10) {
                store64(out + 24, pos + 1);       # blank line ends the headers
                in_headers = 0;
            }
            else {
                var eol = pos;
                while (eol < body_len) {
                    if (load8(body + eol) == 10) { break; }
                    eol = eol + 1;
                }
                var line_len = eol - pos;
                if (line_len > 4) {
                    if (memeq(body + pos, "tag ", 4) == 1) {
                        var tl = line_len - 4;
                        var tg = alloc(tl + 1);
                        memcpy(tg, body + pos + 4, tl);
                        store8(tg + tl, 0);
                        store64(out + 8, tg);
                        found_name = 1;
                    }
                }
                if (line_len > 7) {
                    if (memeq(body + pos, "tagger ", 7) == 1) {
                        store64(out + 16, pos);
                        var info[24];
                        if (parse_author_line(body + pos, line_len, 7, &info) == 0) {
                            store64(out + 32, load64(&info + 8));
                        }
                    }
                }
                if (eol >= body_len) { in_headers = 0; }
                else { pos = eol + 1; }
            }
        }
    }
    if (found_name == 0) { return 0 - 1; }
    return 0;
}

# If `hex` names a tag object, follow `object` until a non-tag is reached and
# return that oid (heap cstring). If it is not a tag, returns a copy of `hex`.
# Returns 0 if an object in the chain is missing or malformed.
#
# Bounded at TAG_PEEL_MAX links: a tag object can name another tag, and a
# hostile pair can name each other. Refusing at the cap is the same shape as
# _WIRE_MAX_DEPTH in the tree walk.
fn peel_tag(hex) {
    var cur = alloc(65);
    memcpy(cur, hex, 64);
    store8(cur + 64, 0);

    var links = 0;
    var peeling = 1;
    while (peeling == 1) {
        var obj[24];
        if (read_object(cur, &obj) != 0) { return 0; }
        var buf = load64(&obj);
        var blen = load64(&obj + 8);
        var coff = load64(&obj + 16);
        if (memeq(buf, "tag ", 4) == 0) { peeling = 0; }
        else {
            links = links + 1;
            if (links > TAG_PEEL_MAX) {
                eprintln("sit: tag chain exceeds 16 links — refusing to peel further");
                return 0;
            }
            var info[40];
            if (parse_tag_body(buf + coff, blen - coff, &info) != 0) { return 0; }
            var nxt = load64(&info);
            if (nxt == 0) { return 0; }
            cur = nxt;
        }
    }
    return cur;
}

# Resolve `prefix` to a COMMIT oid, peeling an annotated tag if that is what it
# names. Same contract as resolve_hash: writes 64 hex + NUL into out_buf and
# returns 1 on success, so it is a drop-in at the sites that need a commit.
#
# Used by the commands that consume a commit (`log`, `diff`, `show`, `reset`,
# `merge`, `merge-base`, `checkout`). Deliberately NOT used by `cat-file`, which
# must show the tag object itself, or by `verify-commit`, which is told exactly
# which object to check.
#
# Costs one extra read_object per command invocation on a non-tag argument —
# once per command, not per object walked.
fn resolve_commit_hash(prefix, out_buf) {
    if (resolve_hash(prefix, out_buf) != 1) { return 0; }
    var peeled = peel_tag(out_buf);
    if (peeled == 0) { return 0; }
    memcpy(out_buf, peeled, 64);
    store8(out_buf + 64, 0);
    # 1.6.4 (E4): and it must BE a commit. A tag (or a typo'd prefix, or a ref)
    # naming a tree went through: `reset --hard <it>` unlinked every tracked
    # file and wrote the tree's oid into the branch, after which `log` failed,
    # `status` said clean, and the next commit recorded the tree as a parent.
    var probe[24];
    if (read_object(out_buf, &probe) != 0) { return 0; }
    var pbuf = load64(&probe);
    var plen = load64(&probe + 8);
    var poff = load64(&probe + 16);
    var is_commit = 0;
    if (_repo_backend == 1) {
        # git packed objects carry no framing — require a parseable `tree` header.
        var info[56];
        if (parse_commit_body(pbuf + poff, plen - poff, &info) == 0) {
            if (load64(&info) != 0) { is_commit = 1; }
        }
    }
    else {
        if (plen >= 7) {
            if (memeq(pbuf, "commit ", 7) == 1) { is_commit = 1; }
        }
    }
    if (is_commit == 0) {
        eprint3("sit: '", prefix, "' does not name a commit\n");
        return 0;
    }
    return 1;
}

# `sit verify-tag [<tag>]` — verify an annotated tag's sitsig signature.
#
# Mirrors cmd_verify_commit, and deliberately does NOT peel: the signature
# covers the TAG object's body, so peeling to the commit would verify the wrong
# object (and would report "no signature" on a perfectly good signed tag whose
# commit happens to be unsigned).
fn cmd_verify_tag() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit verify-tag <tag>");
        return 1;
    }

    var arg = argv_heap(2);
    var hex[72];
    # A bare tag name resolves via refs/tags/; anything else goes through the
    # normal oid/prefix path, so `sit verify-tag <oid>` works too.
    var nlen = strlen(arg);
    var tpath = alloc(15 + nlen + 1);
    memcpy(tpath, ".sit/refs/tags/", 15);
    memcpy(tpath + 15, arg, nlen);
    store8(tpath + 15 + nlen, 0);
    var resolved = 0;
    if (refname_valid(arg) == 1) {
        if (sf_exists(tpath) == 1) {
            var pair[16];
            if (read_file_heap(tpath, &pair) == 0) {
                var rb = load64(&pair);
                var rl = load64(&pair + 8);
                if (rl >= 64) {
                    if (hex_prefix_valid(rb, 64) == 1) {
                        memcpy(&hex, rb, 64);
                        store8(&hex + 64, 0);
                        resolved = 1;
                    }
                }
            }
        }
    }
    if (resolved == 0) {
        var rr = resolve_hash(arg, &hex);
        if (rr == 0 - 2) { eprintln("sit: hash prefix too short (min 4 chars)"); return 1; }
        if (rr == 0 - 1) { eprintln("sit: ambiguous hash prefix"); return 1; }
        if (rr == 0)     { eprintln("sit: no such tag or object"); return 1; }
    }

    var obj[24];
    if (read_object(&hex, &obj) != 0) {
        eprintln("sit: cannot read object");
        return 1;
    }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    if (blen < 4) { eprintln("sit: not a tag object"); return 1; }
    if (memeq(buf, "tag ", 4) == 0) {
        eprintln("sit: not an annotated tag (lightweight tags carry no signature)");
        return 1;
    }
    var body = buf + coff;
    var body_len = blen - coff;

    var pk[32];
    var vr = verify_commit_body(body, body_len, &pk);
    if (vr == 0 - 1) {
        stdout_write("no signature on tag ", 20);
        stdout_write(arg, nlen);
        stdout_write("\n", 1);
        return 1;
    }
    var pk_hex = hex_encode(&pk, 32);
    if (vr == 1) {
        # 1.6.4 (E3): report what the signature actually covers — the SIGNED
        # tag name and target — not the name typed on the command line. A
        # signed `v1.0` copied to refs/tags/v2.1 (or refs/heads/v3.0) verified
        # as "good signature on tag v2.1", a release rollback that a CI gate
        # on verify-tag would wave through. git shows the tag content here.
        var tinfo[40];
        if (parse_tag_body(body, body_len, &tinfo) != 0) {
            eprintln("sit: signature is good but the tag body does not parse — refusing");
            return 1;
        }
        var signed_name = load64(&tinfo + 8);
        var target = load64(&tinfo);
        stdout_write("good signature on tag ", 22);
        # 1.7.6 (R13): the name inside a signed tag object never passed the
        # ref-name check — any signer can put escape bytes in it.
        write_sanitized(STDOUT, signed_name, strlen(signed_name));
        stdout_write(" -> ", 4);
        stdout_write(target, 12);
        stdout_write(" (key ", 6);
        stdout_write(pk_hex, 64);
        stdout_write(")\n", 2);
        if (resolved == 1) {
            if (streq(signed_name, arg) == 0) {
                eprint3("sit: but it was found as refs/tags/", arg,
                  " — this tag object was signed under a different name; refusing\n");
                return 1;
            }
        }
        return 0;
    }
    stdout_write("BAD signature on tag ", 21);
    stdout_write(arg, nlen);
    stdout_write(" (key ", 6);
    stdout_write(pk_hex, 64);
    stdout_write(")\n", 2);
    return 1;
}

# `sit describe [<commit>]` — name a commit by the nearest tag reachable from
# it, git-style: `<tag>` when the commit IS the tag, else
# `<tag>-<n>-g<short>` where n is the number of commits since the tag.
#
# Both tag kinds are honoured: a lightweight tag names its commit directly, an
# annotated tag is peeled first, so `describe` does not care which was used.
fn cmd_describe() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    var start = 0;
    if (argc() >= 3) {
        var hex[72];
        if (resolve_commit_hash(argv_heap(2), &hex) != 1) {
            eprintln("sit: cannot resolve commit");
            return 1;
        }
        start = alloc(65);
        memcpy(start, &hex, 64);
        store8(start + 64, 0);
    }
    else {
        start = read_head_ref();
        if (start == 0) { eprintln("sit: no commits yet"); return 1; }
    }

    # commit-oid -> tag-name, built once. Annotated tags are peeled so both
    # kinds land on the commit they describe. 1.7.3 (E14): names come from the
    # whole refs/tags tree (release/v1 was invisible), and two tags on one
    # commit resolve the same way every run: annotated over lightweight (as
    # git prefers), then the smaller name (the listing is sorted).
    if (sf_exists(".sit/refs/tags") != 1) {
        eprintln("sit: no tags found to describe");
        return 1;
    }
    var names = ref_names_under(".sit/refs/tags");
    var tagmap = map_new();
    var tag_ann = map_new();
    var ti = 0;
    while (ti < vec_len(names)) {
        var nm = vec_get(names, ti);
        var nl = strlen(nm);
        var tpath = alloc(15 + nl + 1);
        memcpy(tpath, ".sit/refs/tags/", 15);
        memcpy(tpath + 15, nm, nl);
        store8(tpath + 15 + nl, 0);
        var pair[16];
        if (read_file_heap(tpath, &pair) == 0) {
            var rb = load64(&pair);
            var rl = load64(&pair + 8);
            if (rl >= 64) {
                if (hex_prefix_valid(rb, 64) == 1) {
                    var oid = alloc(65);
                    memcpy(oid, rb, 64);
                    store8(oid + 64, 0);
                    var peeled = peel_tag(oid);
                    if (peeled != 0) {
                        var annotated = 0;
                        if (streq(peeled, oid) == 0) { annotated = 1; }
                        if (map_has(tagmap, peeled) == 0) {
                            map_set(tagmap, peeled, nm);
                            map_set(tag_ann, peeled, annotated);
                        }
                        else {
                            if (annotated == 1) {
                                if (map_get(tag_ann, peeled) == 0) {
                                    map_set(tagmap, peeled, nm);
                                    map_set(tag_ann, peeled, 1);
                                }
                            }
                        }
                    }
                }
            }
        }
        ti = ti + 1;
    }

    var parents_of = map_new();

    # Fast path, exact: along a chain of single-parent commits from `start`,
    # the first tagged commit T wins outright. Everything past T is T's own
    # ancestry, so every other tag's `tag..start` strictly contains T's. That
    # is the common linear case, and it costs only the distance to T (the full
    # walk below costs the whole history: 1 ms vs 152 ms at 2,000 commits).
    var fc = start;
    var fd = 0;
    var linear = 1;
    while (linear == 1) {
        if (map_has(tagmap, fc) == 1) {
            var hit = map_get(tagmap, fc);
            write_sanitized(STDOUT, hit, strlen(hit));   # E8: a ref filename
            if (fd > 0) {
                stdout_write("-", 1);
                var fbuf[24];
                var fdl = write_decimal(&fbuf, fd);
                stdout_write(&fbuf, fdl);
                stdout_write("-g", 2);
                stdout_write(start, 12);
            }
            stdout_write("\n", 1);
            return 0;
        }
        var fpv = commit_parents_of(fc);
        map_set(parents_of, fc, fpv);
        linear = 0;
        if (fpv != 0) {
            if (vec_len(fpv) == 1) {
                fc = vec_get(fpv, 0);
                fd = fd + 1;
                linear = 1;
                if (fd > SIT_DESCRIBE_MAX) {
                    eprintln("sit: describe: history too long to walk");
                    return 1;
                }
            }
        }
    }

    # 1.7.3 (E14): every parent, as git's describe walks by default. The first
    # tag on the first-parent chain used to win, with its first-parent
    # distance. git's count is the number of commits in `<tag>..<commit>`, and
    # it names the candidate with the smallest count; so does this.
    #
    # Phase 1: the commit's whole ancestry S, in BFS order, with each commit's
    # parents (reusing the fast path's reads) and its number of children in S.
    var kids = map_new();
    var order = vec_new();
    var seen = map_new();
    map_set(seen, start, 1);
    vec_push(order, start);
    var head = 0;
    while (head < vec_len(order)) {
        var c = vec_get(order, head);
        head = head + 1;
        var pv = 0;
        if (map_has(parents_of, c) == 1) { pv = map_get(parents_of, c); }
        else {
            pv = commit_parents_of(c);
            map_set(parents_of, c, pv);
        }
        if (pv != 0) {
            var pi = 0;
            while (pi < vec_len(pv)) {
                var p = vec_get(pv, pi);
                map_set(kids, p, map_get(kids, p) + 1);
                if (map_has(seen, p) == 0) {
                    map_set(seen, p, 1);
                    vec_push(order, p);
                    if (vec_len(order) > SIT_DESCRIBE_MAX) {
                        eprintln("sit: describe: history too long to walk");
                        return 1;
                    }
                }
                pi = pi + 1;
            }
        }
    }

    # The nearest tagged commits (BFS order) are the candidates, one bit each.
    var cand = vec_new();
    var bit_of = map_new();
    var oi = 0;
    while (oi < vec_len(order)) {
        var oc = vec_get(order, oi);
        if (map_has(tagmap, oc) == 1) {
            if (vec_len(cand) < SIT_DESCRIBE_CANDIDATES) {
                map_set(bit_of, oc, 1 << vec_len(cand));
                vec_push(cand, oc);
            }
        }
        oi = oi + 1;
    }
    if (vec_len(cand) == 0) {
        eprintln("sit: no tag found describing this commit");
        return 1;
    }

    # Phase 2: children before parents (Kahn's order from `start`), so a
    # candidate's bit reaches every one of its ancestors. A commit carrying a
    # candidate's bit is reachable from that tag; the rest of S is `tag..start`.
    var flags = map_new();
    var ready = vec_new();
    vec_push(ready, start);
    var rh = 0;
    var within = alloc(8 * SIT_DESCRIBE_CANDIDATES);
    memset(within, 0, 8 * SIT_DESCRIBE_CANDIDATES);
    var nc = vec_len(cand);
    while (rh < vec_len(ready)) {
        var c2 = vec_get(ready, rh);
        rh = rh + 1;
        var f = map_get(flags, c2) | map_get(bit_of, c2);
        var b = 0;
        while (b < nc) {
            if ((f & (1 << b)) != 0) { store64(within + b * 8, load64(within + b * 8) + 1); }
            b = b + 1;
        }
        var pv2 = map_get(parents_of, c2);
        if (pv2 != 0) {
            var pj = 0;
            while (pj < vec_len(pv2)) {
                var p2 = vec_get(pv2, pj);
                map_set(flags, p2, map_get(flags, p2) | f);
                var left = map_get(kids, p2) - 1;
                map_set(kids, p2, left);
                if (left == 0) { vec_push(ready, p2); }
                pj = pj + 1;
            }
        }
    }

    # Smallest count wins; a tie goes to an annotated tag, then the smaller name.
    var total = vec_len(order);
    var best = 0 - 1;
    var best_n = 0;
    var k = 0;
    while (k < nc) {
        var n_k = total - load64(within + k * 8);
        var take = 0;
        if (best < 0) { take = 1; }
        else {
            if (n_k < best_n) { take = 1; }
            if (n_k == best_n) {
                var ck = vec_get(cand, k);
                var cb = vec_get(cand, best);
                var ak = map_get(tag_ann, ck);
                var ab = map_get(tag_ann, cb);
                if (ak > ab) { take = 1; }
                if (ak == ab) {
                    if (strcmp_cstr(map_get(tagmap, ck), map_get(tagmap, cb)) < 0) { take = 1; }
                }
            }
        }
        if (take == 1) { best = k; best_n = n_k; }
        k = k + 1;
    }

    var tagname = map_get(tagmap, vec_get(cand, best));
    write_sanitized(STDOUT, tagname, strlen(tagname));   # E8: a ref filename
    stdout_write("-", 1);
    var nbuf[24];
    var d = write_decimal(&nbuf, best_n);
    stdout_write(&nbuf, d);
    stdout_write("-g", 2);
    stdout_write(start, 12);
    stdout_write("\n", 1);
    return 0;
}

# --- diff.cyr ---

# diff.cyr — unified diff, LCS, hunk grouping, status, show.
#
# Classical LCS on split_lines tables (capped at 16M cells), git-style hunk
# grouping with 3-line context, unified-diff emitter, diffstat variant, and
# cmd_diff / cmd_show / cmd_status which all consume the same primitives.
# Also home to is_dirty and the working-tree walker used by status + add.

# 1 if the index or worktree differs from HEAD's tree (guards checkout / merge / pull).
fn is_dirty() {
    var index_entries = parse_index();
    if (index_entries != 0) {
        sort_entries(index_entries);
        index_entries = dedupe_entries(index_entries);
    }
    var head_entries = read_head_tree_entries();

    if (index_entries != 0) {
        var n = vec_len(index_entries);
        var i = 0;
        while (i < n) {
            var e = vec_get(index_entries, i);
            var path = entry_path(e);
            var idx_hex = hex_encode(entry_hash(e), 32);
            var head_ent = tree_find(head_entries, path);
            if (head_ent == 0) { return 1; }
            if (streq(tree_entry_hash(head_ent), idx_hex) == 0) { return 1; }
            if (sf_exists(path) == 1) {
                # 1.6.4 (B2): a file that cannot be hashed (over the 64 MiB read
                # cap, or a tracked file replaced by a directory) used to count
                # as UNCHANGED, so checkout / merge / pull then overwrote it —
                # a 70 MB uncommitted edit was replaced by the committed 6
                # bytes. Unknown is dirty.
                var wh = hash_file_as_blob(path);
                if (wh == 0) { return 1; }
                if (streq(wh, idx_hex) == 0) { return 1; }
            }
            else { return 1; }
            i = i + 1;
        }
    }

    if (head_entries != 0) {
        var hn = vec_len(head_entries);
        var hi = 0;
        while (hi < hn) {
            var he = vec_get(head_entries, hi);
            if (index_find(index_entries, tree_entry_name(he)) == 0) { return 1; }
            hi = hi + 1;
        }
    }
    return 0;
}

# 1 if any tracked file's worktree content differs from what the index holds
# for it — modified, missing, or unreadable (B2: unknown is "differs"). Staged
# changes do not count; this is the "unstaged changes" test.
fn worktree_differs_from_index() {
    var index_entries = parse_index();
    if (index_entries == 0) { return 0; }
    var n = vec_len(index_entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(index_entries, i);
        var path = entry_path(e);
        if (sf_exists(path) != 1) { return 1; }
        var wh = hash_file_as_blob(path);
        if (wh == 0) { return 1; }
        if (streq(wh, hex_encode(entry_hash(e), 32)) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Recursively collect every non-ignored worktree file under `fs_path` into
# `out` as repo-relative paths (`prefix` + name). Symlinks are leaves.
fn list_working_walk(prefix, fs_path, out, patterns) {
    var raw = sf_dir_list(str_from(fs_path));
    var n = vec_len(raw);
    var fs_path_len = strlen(fs_path);
    var prefix_len = strlen(prefix);
    var i = 0;
    while (i < n) {
        var s = vec_get(raw, i);
        var sdata = str_data(s);
        var slen = str_len(s);

        var skip = 0;
        if (slen == 4) {
            if (memeq(sdata, ".sit", 4) == 1) { skip = 1; }
            # git read-mode: never descend into a .git/ metadata dir.
            if (memeq(sdata, ".git", 4) == 1) { skip = 1; }
        }

        # v1.5.2: the child's path and KIND are needed before the ignore test,
        # because a trailing-slash rule (`build/`) matches directories only.
        # This used to run the ignore test first and discover the kind after.
        var child_fs = alloc(fs_path_len + 1 + slen + 1);
        memcpy(child_fs, fs_path, fs_path_len);
        store8(child_fs + fs_path_len, 47);
        memcpy(child_fs + fs_path_len + 1, sdata, slen);
        store8(child_fs + fs_path_len + 1 + slen, 0);

        var child_is_dir = 0;
        if (skip == 0) {
            # S-25: a symlink is a LEAF, never descended — see the note below.
            # 1.6.4 (D7): one lstat through the repo-root seam. The listing above
            # is root-prefixed (sf_dir_list) but these two probes used the raw
            # cwd-relative path, so `sit_repo_open(<abs>)` from another cwd saw
            # every subdirectory as a plain file and never descended.
            if (path_lstat_kind(sit_abs(child_fs)) == 0x4000) { child_is_dir = 1; }
        }

        if (skip == 0) {
            var rel_path_len = prefix_len + slen;
            var rel_path = alloc(rel_path_len + 1);
            memcpy(rel_path, prefix, prefix_len);
            memcpy(rel_path + prefix_len, sdata, slen);
            store8(rel_path + rel_path_len, 0);
            if (is_ignored_kind(rel_path, patterns, child_is_dir) == 1) { skip = 1; }
        }

        if (skip == 0) {

            # S-25: never DESCEND through a symlink.
            #
            # `is_dir` follows symlinks, so a symlinked directory pointing at
            # `.` or any ancestor made this recurse until the kernel's 40-deep
            # ELOOP cap, emitting nonsense paths
            # (`d/loop/d/loop/d/loop/...`) and allocating a fresh path string at
            # every level. Several such links multiply combinatorially before
            # ELOOP stops any single chain.
            #
            # Treating a symlink as a leaf is also the CORRECT semantics, not
            # merely the safe one: git records a symlink as a symlink blob and
            # never traverses it. So this is emitted as an entry (below) rather
            # than walked.
            if (child_is_dir == 1) {
                var new_prefix = alloc(prefix_len + slen + 2);
                memcpy(new_prefix, prefix, prefix_len);
                memcpy(new_prefix + prefix_len, sdata, slen);
                store8(new_prefix + prefix_len + slen, 47);
                store8(new_prefix + prefix_len + slen + 1, 0);

                # v1.4.9: a nested .gitignore / .sitignore applies to paths
                # under its own directory. Its rules are appended AFTER the
                # inherited ones, and is_ignored is last-match-wins, so a
                # deeper file overrides a shallower one — git's precedence.
                # The inherited vec is only copied when such a file actually
                # exists, so the common case costs one sf_exists per directory.
                var child_patterns = patterns;
                var ig_name = _ignore_filename();
                var ig_nlen = strlen(ig_name);
                var cfs_len = strlen(child_fs);
                var ig_path = alloc(cfs_len + 1 + ig_nlen + 1);
                memcpy(ig_path, child_fs, cfs_len);
                store8(ig_path + cfs_len, 47);
                memcpy(ig_path + cfs_len + 1, ig_name, ig_nlen);
                store8(ig_path + cfs_len + 1 + ig_nlen, 0);
                if (sf_exists(ig_path) == 1) {
                    child_patterns = vec_new();
                    if (patterns != 0) {
                        var ci = 0;
                        var cn = vec_len(patterns);
                        while (ci < cn) {
                            vec_push(child_patterns, vec_get(patterns, ci));
                            ci = ci + 1;
                        }
                    }
                    _parse_ignore_file(ig_path, child_patterns, new_prefix);
                }
                list_working_walk(new_prefix, child_fs, out, child_patterns);
            }
            else {
                var full_len = prefix_len + slen;
                var full = alloc(full_len + 1);
                memcpy(full, prefix, prefix_len);
                memcpy(full + prefix_len, sdata, slen);
                store8(full + full_len, 0);
                vec_push(out, full);
            }
        }
        i = i + 1;
    }
    return 0;
}

# Every non-ignored worktree file, as repo-relative paths.
fn list_working_files() {
    var files = vec_new();
    var patterns = load_sitignore();
    list_working_walk("", ".", files, patterns);
    return files;
}

# A "status item" is a 16-byte (label_ptr, path_ptr) pair.
fn push_status_item(vec, label, path) {
    var item = alloc(16);
    store64(item, label);
    store64(item + 8, path);
    vec_push(vec, item);
    return 0;
}

# Print a status section of {label, path} items; 0 if the section is empty.
fn print_labeled_section(title, title_len, items) {
    if (vec_len(items) == 0) { return 0; }
    stdout_write("\n", 1);
    stdout_write(title, title_len);
    stdout_write("\n", 1);
    var si = 0;
    while (si < vec_len(items)) {
        var it = vec_get(items, si);
        var lab = load64(it);
        var pth = load64(it + 8);
        stdout_write("  ", 2);
        stdout_write(lab, strlen(lab));
        # 1.7.6 (L16): worktree names are external bytes — an escape sequence
        # in a filename reached the terminal raw (the E8 / E10 class).
        write_sanitized(STDOUT, pth, strlen(pth));
        stdout_write("\n", 1);
        si = si + 1;
    }
    return 1;
}

# Print a status section of bare path names; 0 if the section is empty.
fn print_name_section(title, title_len, names) {
    if (vec_len(names) == 0) { return 0; }
    stdout_write("\n", 1);
    stdout_write(title, title_len);
    stdout_write("\n", 1);
    var si = 0;
    while (si < vec_len(names)) {
        var nm = vec_get(names, si);
        stdout_write("  ", 2);
        write_sanitized(STDOUT, nm, strlen(nm));   # 1.7.6 (L16)
        stdout_write("\n", 1);
        si = si + 1;
    }
    return 1;
}

# `sit status` — branch, staged / unstaged changes and untracked files.
fn cmd_status() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    var head_entries = read_head_tree_entries();
    var index_entries = parse_index();
    if (index_entries != 0) {
        sort_entries(index_entries);
        index_entries = dedupe_entries(index_entries);
    }
    var working = list_working_files();

    var staged = vec_new();
    var unstaged = vec_new();
    var untracked = vec_new();

    if (index_entries != 0) {
        var ni = vec_len(index_entries);
        var ii = 0;
        while (ii < ni) {
            var e = vec_get(index_entries, ii);
            var path = entry_path(e);
            var idx_hash_hex = hex_encode(entry_hash(e), 32);

            var head_ent = tree_find(head_entries, path);
            var label = 0;
            if (head_ent == 0) { label = "new file:  "; }
            else {
                if (streq(tree_entry_hash(head_ent), idx_hash_hex) == 0) {
                    label = "modified:  ";
                }
            }
            if (label != 0) { push_status_item(staged, label, path); }

            if (sf_exists(path) == 1) {
                # A file status cannot hash is reported, never assumed clean (B2).
                var working_hex = hash_file_as_blob(path);
                if (working_hex == 0) { push_status_item(unstaged, "modified:  ", path); }
                else {
                    if (streq(working_hex, idx_hash_hex) == 0) {
                        push_status_item(unstaged, "modified:  ", path);
                    }
                }
            }
            else {
                push_status_item(unstaged, "deleted:   ", path);
            }
            ii = ii + 1;
        }
    }

    var nw = vec_len(working);
    var wi = 0;
    while (wi < nw) {
        var name = vec_get(working, wi);
        if (index_find(index_entries, name) == 0) {
            if (tree_find(head_entries, name) == 0) {
                vec_push(untracked, name);
            }
        }
        wi = wi + 1;
    }

    if (head_entries != 0) {
        var hn = vec_len(head_entries);
        var hi = 0;
        while (hi < hn) {
            var he = vec_get(head_entries, hi);
            var hpath = tree_entry_name(he);
            if (index_find(index_entries, hpath) == 0) {
                push_status_item(staged, "deleted:   ", hpath);
            }
            hi = hi + 1;
        }
    }

    var branch = current_branch_name();
    stdout_write("On branch ", 10);
    if (branch != 0) { write_sanitized(STDOUT, branch, strlen(branch)); }   # E10
    else             { stdout_write("(detached)", 10); }
    stdout_write("\n", 1);
    if (read_head_ref() == 0) {
        stdout_write("No commits yet\n", 15);
    }
    if (read_merge_head() != 0) {
        var msg = "Merge in progress. Resolve conflicts and commit, or run 'sit merge --abort'.\n";
        stdout_write(msg, strlen(msg));
    }

    var any = 0;
    # 1.7.0: paths a conflict stop recorded and a commit will refuse.
    var unmerged = conflicts_list();
    if (unmerged != 0) {
        if (print_name_section("Unmerged paths (resolve, then 'sit add'):", 41, unmerged) == 1) { any = 1; }
    }
    if (print_labeled_section("Staged for commit:", 18, staged) == 1)   { any = 1; }
    if (print_labeled_section("Unstaged changes:", 17, unstaged) == 1)   { any = 1; }
    if (print_name_section("Untracked files:", 16, untracked) == 1)      { any = 1; }

    if (any == 0) {
        stdout_write("\nnothing to commit, working tree clean\n", 39);
    }
    return 0;
}

# ---- diff ------------------------------------------------------------------
# Line layout (16 bytes): { ptr_into_data, len_word } — \n excluded. Read it
# through line_ptr / line_len / line_no_eol (the ADR 0009 contract), never raw.
#
# 1.7.2 (B14): the length word carries LINE_NO_EOL on a file's last line when
# the file does not end in \n. Keeping the flag in the word rather than a third
# field lets lines_equal check length AND final-newline state with the single
# compare it already made: a 24-byte record with a separate flag cost the LCS
# inner loop 10-13% (lcs-diff-1000x1000 34.2 -> 38.7 ms).
enum DiffLine {
    LINE_NO_EOL = 0x4000000000000000;
    LINE_LEN_MASK = 0x3FFFFFFFFFFFFFFF;
}
# Pointer to a split_lines record's first byte.
fn line_ptr(l) { return load64(l); }
# Length of a split_lines record, without the LINE_NO_EOL flag.
fn line_len(l) { return load64(l + 8) & LINE_LEN_MASK; }
# 1 for a file's last line when the file does not end in \n.
fn line_no_eol(l) {
    if ((load64(l + 8) & LINE_NO_EOL) != 0) { return 1; }
    return 0;
}

# Split a buffer into line records (LF-separated, no copy). `a\nb` and
# `a\nb\n` used to split identically, so a change that only added the trailing
# newline printed headers and no hunk, and a patch across such a file did not
# round-trip.
fn split_lines(data, len) {
    var lines = vec_new();
    var pos = 0;
    while (pos < len) {
        var start = pos;
        while (pos < len) {
            if (load8(data + pos) == 10) { break; }
            pos = pos + 1;
        }
        var line = alloc(16);
        store64(line, data + start);
        var word = pos - start;
        if (pos == len) { word = word | LINE_NO_EOL; }  # ran off the end: no \n
        store64(line + 8, word);
        vec_push(lines, line);
        if (pos < len) { pos = pos + 1; }
    }
    return lines;
}

# Equality of two split_lines records: the same bytes AND the same
# final-newline state, so `b` and `b\n` differ as they do in git. Comparing the
# raw length words checks both at once.
fn lines_equal(a, b) {
    var aw = load64(a + 8);
    if (aw != load64(b + 8)) { return 0; }
    return memeq(line_ptr(a), line_ptr(b), aw & LINE_LEN_MASK);
}

# Read trace slice for depth `d` at diagonal `kp` (P-14). The slice holds the
# parity-(d-1) V entries in [-(d-1), d-1] that depth d read/produced; `kp` must
# be that parity (the caller only ever asks for valid k±1 / prev_k diagonals).
fn _myers_sget(slice, d, kp) {
    return load64(slice + ((kp + d - 1) / 2) * 8);
}

# Myers O((N+M)D) diff fallback (P-14). Produces the SAME op-tuple format as
# `lcs_diff` (16-byte {kind, line_ptr}, forward order) so callers don't care
# which path ran. Used when the LCS DP table would be too large — Myers needs
# only O(N+M) working space plus an O(D²) backtrack trace, where D is the edit
# distance, so a large-but-similar file (small D) diffs cheaply where the DP
# would allocate 100+ MB. Bounded: if D exceeds `dcap` (a fully-rewritten huge
# file — the rare pathological case) it returns 0, preserving the old "too
# large" refusal. Greedy forward search + trace backtrack, per Myers 1986.
fn myers_diff(a, b) {
    var n = vec_len(a);
    var m = vec_len(b);

    # D is bounded by `dcap`, so k = x - y stays in [-dcap, dcap]: V is sized to
    # that, not to N+M. Trace = Σ(d) i64 ≈ dcap²/2; dcap=4096 → ~67 MB ceiling.
    var dcap = 4096;
    var voff = dcap;
    var vsize = 2 * dcap + 1;
    var V = fl_alloc(vsize * 8);
    if (V == 0) { return 0; }
    store64(V + (1 + voff) * 8, 0);
    var trace = vec_new();

    var searching = 1;
    var found_d = 0 - 1;
    var d = 0;
    while (searching == 1) {
        if (d > dcap) { searching = 0; }
        else {
            # Snapshot V (depth d's inputs) for the backtrack — only d >= 1 is
            # ever read back. Compact: parity-(d-1) entries in [-(d-1), d-1].
            if (d >= 1) {
                var slice = fl_alloc(d * 8);
                var kp = 0 - (d - 1);
                while (kp <= d - 1) {
                    store64(slice + ((kp + d - 1) / 2) * 8, load64(V + (kp + voff) * 8));
                    kp = kp + 2;
                }
                vec_push(trace, slice);
            }
            var k = 0 - d;
            while (k <= d) {
                if (searching == 1) {
                    # x = (k==-d || (k!=d && V[k-1]<V[k+1])) ? V[k+1] : V[k-1]+1
                    var down = 0;
                    if (k == 0 - d) { down = 1; }
                    else {
                        if (k != d) {
                            if (load64(V + (k - 1 + voff) * 8) < load64(V + (k + 1 + voff) * 8)) { down = 1; }
                        }
                    }
                    var x = 0;
                    if (down == 1) { x = load64(V + (k + 1 + voff) * 8); }
                    else { x = load64(V + (k - 1 + voff) * 8) + 1; }
                    var y = x - k;
                    var snaking = 1;
                    while (snaking == 1) {
                        if (x < n) {
                            if (y < m) {
                                if (lines_equal(vec_get(a, x), vec_get(b, y)) == 1) {
                                    x = x + 1;
                                    y = y + 1;
                                }
                                else { snaking = 0; }
                            }
                            else { snaking = 0; }
                        }
                        else { snaking = 0; }
                    }
                    store64(V + (k + voff) * 8, x);
                    if (x >= n) {
                        if (y >= m) { found_d = d; searching = 0; }
                    }
                }
                k = k + 2;
            }
            if (searching == 1) { d = d + 1; }
        }
    }

    if (found_d < 0) {
        # 1.7.6 (R8): the trace slices too — up to 4096 of them, ~67 MB, were
        # kept on every refused diff (a regenerated lockfile, a line-ending
        # change), in the API caller's process.
        fl_free(V);
        var fi = 0;
        while (fi < vec_len(trace)) {
            fl_free(vec_get(trace, fi));
            fi = fi + 1;
        }
        return 0;
    }

    # Backtrack: from (n,m) to the origin, emitting ops in reverse.
    var script = vec_new();
    var x = n;
    var y = m;
    var dd = found_d;
    while (dd >= 1) {
        var slice = vec_get(trace, dd - 1);
        var k = x - y;
        var down = 0;
        if (k == 0 - dd) { down = 1; }
        else {
            if (k != dd) {
                if (_myers_sget(slice, dd, k - 1) < _myers_sget(slice, dd, k + 1)) { down = 1; }
            }
        }
        var prev_k = 0;
        if (down == 1) { prev_k = k + 1; }
        else { prev_k = k - 1; }
        var prev_x = _myers_sget(slice, dd, prev_k);
        var prev_y = prev_x - prev_k;
        var diaging = 1;
        while (diaging == 1) {
            if (x > prev_x) {
                if (y > prev_y) {
                    var op = alloc(16);
                    store64(op, 0);
                    store64(op + 8, vec_get(a, x - 1));
                    vec_push(script, op);
                    x = x - 1;
                    y = y - 1;
                }
                else { diaging = 0; }
            }
            else { diaging = 0; }
        }
        if (down == 1) {
            var op = alloc(16);
            store64(op, 2);
            store64(op + 8, vec_get(b, y - 1));
            vec_push(script, op);
        }
        else {
            var op = alloc(16);
            store64(op, 1);
            store64(op + 8, vec_get(a, x - 1));
            vec_push(script, op);
        }
        x = prev_x;
        y = prev_y;
        dd = dd - 1;
    }
    while (x > 0) {
        var op = alloc(16);
        store64(op, 0);
        store64(op + 8, vec_get(a, x - 1));
        vec_push(script, op);
        x = x - 1;
        y = y - 1;
    }

    # script is reversed; flip into forward order (matches lcs_diff).
    var out = vec_new();
    var si = vec_len(script) - 1;
    while (si >= 0) {
        vec_push(out, vec_get(script, si));
        si = si - 1;
    }
    fl_free(V);
    var ti = 0;
    while (ti < vec_len(trace)) {
        fl_free(vec_get(trace, ti));
        ti = ti + 1;
    }
    return out;
}

# LCS-based diff. Returns a vec of op-tuples (16 bytes):
#   op kind: 0 = keep, 1 = delete, 2 = insert
#   line ptr: points at one of the input line tuples
# For small inputs this is the exact O(N·M) DP; when the DP table would be too
# large it hands off to `myers_diff` (P-14), which only refuses (returns 0) on
# a pathologically large edit distance.
fn lcs_diff(a, b) {
    var n1 = vec_len(a);
    var n2 = vec_len(b);
    if (n1 < 0) { return 0; }
    if (n2 < 0) { return 0; }
    var stride = n2 + 1;
    # S-07 kept overflow safety by capping EACH dimension at 8192 before the
    # multiply. That was sound against overflow but far too blunt: it rejected
    # on a single dimension regardless of the actual table size.
    #
    # S-26: the failure that exposed it — adding or deleting a file of >8192
    # lines. There n1 == 0, so the table is 1 x (n2+1): 8194 cells, ~64 KB,
    # trivially in budget. The old guard still forced the Myers fallback, whose
    # edit-distance cap (dcap 4096) cannot represent a pure insertion of 8193
    # lines, so it refused and sit printed "diff table exceeds cap; file too
    # large" with ZERO content lines. Verified at the exact boundary: 8192 lines
    # diffed fine, 8193 produced a header and nothing else. It hit `sit show`,
    # `sit diff --staged` and `sit_diff_path` (so owl / thoth too) for any large
    # file added or removed — a routine operation.
    #
    # Test the real product instead, by DIVISION so nothing can wrap: the
    # multiply below only runs once it is proven to fit.
    var cell_max = 16 * 1024 * 1024;
    if (stride > cell_max) { return myers_diff(a, b); }
    if (n1 + 1 > cell_max / stride) { return myers_diff(a, b); }
    var cells = (n1 + 1) * stride;
    # P-15 (v0.6.9): the DP table can be up to 128 MB. fl_alloc routes large
    # allocations through mmap directly and we fl_free below before the
    # function returns — diff-heavy commands no longer permanently reserve
    # the table on the bump heap for the life of the process.
    var T = fl_alloc(cells * 8);
    if (T == 0) { return myers_diff(a, b); }

    # Zero the LCS base case — row 0 (`T[0][0..n2]`) and column 0
    # (`T[0..n1][0]`). The DP reads `T[i-1][*]` / `T[*][j-1]`, so the base must
    # be 0. `fl_alloc` only zero-fills fresh mmap pages (large tables); a small
    # table served from the recycled freelist carries stale non-zero values, so
    # without this the DP computed a too-short LCS (non-minimal diff) on the
    # 2nd+ diff in a process. Surfaced by the P-14 Myers differential test.
    var z = 0;
    while (z <= n2) { store64(T + z * 8, 0); z = z + 1; }
    z = 0;
    while (z <= n1) { store64(T + z * stride * 8, 0); z = z + 1; }

    var i = 1;
    while (i <= n1) {
        var j = 1;
        while (j <= n2) {
            var aline = vec_get(a, i - 1);
            var bline = vec_get(b, j - 1);
            var cellval = 0;
            if (lines_equal(aline, bline) == 1) {
                cellval = load64(T + ((i - 1) * stride + (j - 1)) * 8) + 1;
            }
            else {
                var up = load64(T + ((i - 1) * stride + j) * 8);
                var left = load64(T + (i * stride + (j - 1)) * 8);
                if (up >= left) { cellval = up; }
                else { cellval = left; }
            }
            store64(T + (i * stride + j) * 8, cellval);
            j = j + 1;
        }
        i = i + 1;
    }

    var script = vec_new();
    i = n1;
    var j = n2;
    while (i > 0) {
        if (j > 0) {
            if (lines_equal(vec_get(a, i - 1), vec_get(b, j - 1)) == 1) {
                var op = alloc(16);
                store64(op, 0);
                store64(op + 8, vec_get(a, i - 1));
                vec_push(script, op);
                i = i - 1;
                j = j - 1;
            }
            else {
                var up = load64(T + ((i - 1) * stride + j) * 8);
                var left = load64(T + (i * stride + (j - 1)) * 8);
                if (left >= up) {
                    var op = alloc(16);
                    store64(op, 2);
                    store64(op + 8, vec_get(b, j - 1));
                    vec_push(script, op);
                    j = j - 1;
                }
                else {
                    var op = alloc(16);
                    store64(op, 1);
                    store64(op + 8, vec_get(a, i - 1));
                    vec_push(script, op);
                    i = i - 1;
                }
            }
        }
        else {
            var op = alloc(16);
            store64(op, 1);
            store64(op + 8, vec_get(a, i - 1));
            vec_push(script, op);
            i = i - 1;
        }
    }
    while (j > 0) {
        var op = alloc(16);
        store64(op, 2);
        store64(op + 8, vec_get(b, j - 1));
        vec_push(script, op);
        j = j - 1;
    }

    var reversed = vec_new();
    var k = vec_len(script) - 1;
    while (k >= 0) {
        vec_push(reversed, vec_get(script, k));
        k = k - 1;
    }
    fl_free(T);
    return reversed;
}

# Annotated op layout (32 bytes):
#   0..8:   kind (0=keep, 1=del, 2=ins)
#   8..16:  line ptr
#   16..24: old_line (1-indexed; 0 if op has no presence in old)
#   24..32: new_line (1-indexed; 0 if op has no presence in new)
fn ann_kind(a) { return load64(a); }
# Line text pointer of an annotated op.
fn ann_line(a) { return load64(a + 8); }
# 1-indexed line number in the old file (0 for an insert).
fn ann_old(a)  { return load64(a + 16); }
# 1-indexed line number in the new file (0 for a delete).
fn ann_new(a)  { return load64(a + 24); }

# Attach 1-indexed old / new line numbers to raw diff ops (see the ann_* layout above).
fn annotate_ops(ops) {
    var out = vec_new();
    var old_line = 0;
    var new_line = 0;
    var n = vec_len(ops);
    var i = 0;
    while (i < n) {
        var op = vec_get(ops, i);
        var kind = load64(op);
        var line = load64(op + 8);
        var a = alloc(32);
        store64(a, kind);
        store64(a + 8, line);
        if (kind == 0) {
            old_line = old_line + 1;
            new_line = new_line + 1;
            store64(a + 16, old_line);
            store64(a + 24, new_line);
        }
        else {
            if (kind == 1) {
                old_line = old_line + 1;
                store64(a + 16, old_line);
                store64(a + 24, 0);
            }
            else {
                new_line = new_line + 1;
                store64(a + 16, 0);
                store64(a + 24, new_line);
            }
        }
        vec_push(out, a);
        i = i + 1;
    }
    return out;
}

# Group annotated ops into hunks. Each hunk is a vec of ops.
# Algorithm: keep up to N leading-context keeps before the first change of a
# hunk; extend the hunk as long as consecutive keep-runs stay within 2N; when
# we see a (2N+1)-th keep since the last change, trim the hunk's trailing
# keeps to N and close it. The overshoot keep becomes the first of the next
# hunk's leading-context buffer.
# S-26: `ctx` comes from a user-supplied `-U<N>` that `cmd_diff` / `cmd_show`
# accepted with no upper bound. At ctx >= 2^62 the `2 * ctx` below overflows to
# NEGATIVE, so the first context line after any change takes the close branch and
# `while (k < ctx) { vec_pop(hunk); }` spins ~4.6e18 times — `sit show -U<2^62>`
# ran at 100% CPU indefinitely. (vec_pop returns 0 on an empty vec, so it was a
# hang rather than corruption.) No patch has meaningful context beyond a file's
# line count; clamping here covers both callers at one point.
var DIFF_MAX_CTX = 1000000;

# Group annotated ops into hunks with `ctx_in` context lines, clamped to [0, DIFF_MAX_CTX].
fn group_hunks(annotated, ctx_in) {
    var ctx = ctx_in;
    if (ctx < 0) { ctx = 0; }
    if (ctx > DIFF_MAX_CTX) { ctx = DIFF_MAX_CTX; }
    var hunks = vec_new();
    var pending = vec_new();
    var hunk = 0;
    var since_change = 0;

    var n = vec_len(annotated);
    var i = 0;
    while (i < n) {
        var op = vec_get(annotated, i);
        var kind = ann_kind(op);

        if (kind == 0) {
            if (hunk == 0) {
                vec_push(pending, op);
                if (vec_len(pending) > ctx) { vec_remove(pending, 0); }
            }
            else {
                since_change = since_change + 1;
                if (since_change <= 2 * ctx) { vec_push(hunk, op); }
                else {
                    # Close hunk: trim trailing keeps to exactly ctx.
                    var k = 0;
                    while (k < ctx) { vec_pop(hunk); k = k + 1; }
                    vec_push(hunks, hunk);
                    hunk = 0;
                    pending = vec_new();
                    vec_push(pending, op);
                    # S-26: apply the same ctx trim the open-hunk branch above
                    # uses. Without it `pending` never drained at ctx == 0, so
                    # every hunk after the first inherited one leading context
                    # line and `-U0` did not actually emit a zero-context patch
                    # (sit printed `@@ -30,2 +30,2 @@` where GNU diff -U0 prints
                    # `@@ -31 +31 @@`).
                    if (vec_len(pending) > ctx) { vec_remove(pending, 0); }
                    since_change = 0;
                }
            }
        }
        else {
            if (hunk == 0) {
                hunk = vec_new();
                var pi = 0;
                var pn = vec_len(pending);
                while (pi < pn) {
                    vec_push(hunk, vec_get(pending, pi));
                    pi = pi + 1;
                }
                pending = vec_new();
            }
            vec_push(hunk, op);
            since_change = 0;
        }
        i = i + 1;
    }

    if (hunk != 0) {
        var trim = since_change - ctx;
        if (trim > 0) {
            var k = 0;
            while (k < trim) { vec_pop(hunk); k = k + 1; }
        }
        vec_push(hunks, hunk);
    }
    return hunks;
}

# Compute hunk header ranges. Writes to out (32 bytes):
#   0..8:   old_start, 8..16: old_len, 16..24: new_start, 24..32: new_len
fn hunk_ranges(hunk, out) {
    var old_start = 0;
    var new_start = 0;
    var old_len = 0;
    var new_len = 0;
    var n = vec_len(hunk);
    var i = 0;
    while (i < n) {
        var op = vec_get(hunk, i);
        var kind = ann_kind(op);
        if (kind != 2) {
            if (old_start == 0) { old_start = ann_old(op); }
            old_len = old_len + 1;
        }
        if (kind != 1) {
            if (new_start == 0) { new_start = ann_new(op); }
            new_len = new_len + 1;
        }
        i = i + 1;
    }
    # 1.6.4 (B12): a side with no lines starts at the line BEFORE the change
    # (GNU diff / git: `@@ -10,0 +11 @@` inserts after old line 10). It stayed
    # 0, so `-U0` printed `-0,0` / `+0,0` and `patch` applied every pure
    # insert at line 1. The preceding op in the whole-file annotation carries
    # that line number; a hunk with no predecessor really does start at 0.
    if (old_len == 0) { old_start = _hunk_prev_line(hunk, 0); }
    if (new_len == 0) { new_start = _hunk_prev_line(hunk, 1); }
    store64(out, old_start);
    store64(out + 8, old_len);
    store64(out + 16, new_start);
    store64(out + 24, new_len);
    return 0;
}

# The whole-file annotation print_file_diff is emitting hunks from, and a
# forward-only scan position into it (hunks arrive in file order).
var _hunk_ann = 0;
var _hunk_ann_pos = 0;

# Old (side 0) or new (side 1) line number of the op just before `hunk`'s first
# op in _hunk_ann — the last line on that side before the change — or 0.
fn _hunk_prev_line(hunk, side) {
    if (_hunk_ann == 0) { return 0; }
    if (vec_len(hunk) == 0) { return 0; }
    var first = vec_get(hunk, 0);
    var n = vec_len(_hunk_ann);
    var i = _hunk_ann_pos;
    var found = 0 - 1;
    while (i < n) {
        if (vec_get(_hunk_ann, i) == first) { found = i; i = n; }
        else { i = i + 1; }
    }
    if (found < 0) { return 0; }
    _hunk_ann_pos = found;
    var j = found - 1;
    var line = 0;
    while (j >= 0) {
        var op = vec_get(_hunk_ann, j);
        var v = ann_old(op);
        if (side == 1) { v = ann_new(op); }
        if (v > 0) { line = v; j = 0 - 1; }
        else { j = j - 1; }
    }
    return line;
}

# Write a non-negative integer to stdout in decimal.
fn write_unsigned(n) {
    var buf[24];
    var digits = write_decimal(&buf, n);
    stdout_write(&buf, digits);
    return 0;
}

# Print a unified-diff `@@ -a,b +c,d @@` header, omitting `,1` as git does.
fn print_hunk_header(hunk) {
    var r[32];
    hunk_ranges(hunk, &r);
    var old_len = load64(&r + 8);
    var new_len = load64(&r + 24);
    stdout_write("@@ -", 4);
    write_unsigned(load64(&r));
    # Git convention: omit ",1" when the count is 1.
    if (old_len != 1) {
        stdout_write(",", 1);
        write_unsigned(old_len);
    }
    stdout_write(" +", 2);
    write_unsigned(load64(&r + 16));
    if (new_len != 1) {
        stdout_write(",", 1);
        write_unsigned(new_len);
    }
    stdout_write(" @@\n", 4);
    return 0;
}

# Pure compute layer: returns the annotated-ops vec for the (old, new) buffers,
# or 0 if the LCS table exceeds the 16M-cell cap. No I/O; caller owns the
# returned vec. Public API surface — consumed by `sit_diff_path` (the library
# export wrapper) so owl and other downstream consumers can walk the per-line
# annotations without paying for stringification + stdout writes.
fn compute_file_diff(old_buf, old_len, new_buf, new_len) {
    var a = split_lines(old_buf, old_len);
    var b = split_lines(new_buf, new_len);
    var ops = lcs_diff(a, b);
    if (ops == 0) { return 0; }
    return annotate_ops(ops);
}

# Print one file's unified diff (---/+++ headers, then hunks); 1 if the diff table is over its cap.
fn print_file_diff(path, old_buf, old_len, new_buf, new_len, ctx) {
    # 1.7.6 (R13): names are display-safe here too — U+009B / U+202E pass the
    # tree-name byte check (they are UTF-8, not ASCII controls).
    stdout_write("--- a/", 6);
    write_sanitized(STDOUT, path, strlen(path));
    stdout_write("\n+++ b/", 7);
    write_sanitized(STDOUT, path, strlen(path));
    stdout_write("\n", 1);

    var annotated = compute_file_diff(old_buf, old_len, new_buf, new_len);
    if (annotated == 0) {
        eprintln("sit: diff table exceeds cap; file too large");
        return 1;
    }

    var hunks = group_hunks(annotated, ctx);
    _hunk_ann = annotated;
    _hunk_ann_pos = 0;

    var h = 0;
    var hn = vec_len(hunks);
    while (h < hn) {
        var hunk = vec_get(hunks, h);
        print_hunk_header(hunk);

        var ni = 0;
        var nn = vec_len(hunk);
        while (ni < nn) {
            var op = vec_get(hunk, ni);
            var kind = ann_kind(op);
            var l = ann_line(op);
            if (kind == 0) { stdout_write(" ", 1); }
            if (kind == 1) { stdout_write("-", 1); }
            if (kind == 2) { stdout_write("+", 1); }
            stdout_write(line_ptr(l), line_len(l));
            stdout_write("\n", 1);
            if (line_no_eol(l) == 1) { stdout_write("\\ No newline at end of file\n", 28); }
            ni = ni + 1;
        }
        h = h + 1;
    }
    return 0;
}

# Count insertion / deletion lines between two buffers and print a diffstat
# line ` path | +N -M\n`. Writes (ins, del) to out_pair for caller totals.
fn print_file_stat(path, old_buf, old_len, new_buf, new_len, out_pair) {
    var a = split_lines(old_buf, old_len);
    var b = split_lines(new_buf, new_len);
    var ops = lcs_diff(a, b);
    if (ops == 0) {
        store64(out_pair, 0);
        store64(out_pair + 8, 0);
        eprintln("sit: diff table exceeds cap; file too large");
        return 1;
    }
    var ins = 0;
    var del = 0;
    var n = vec_len(ops);
    var i = 0;
    while (i < n) {
        var op = vec_get(ops, i);
        var kind = load64(op);
        if (kind == 1) { del = del + 1; }
        if (kind == 2) { ins = ins + 1; }
        i = i + 1;
    }
    store64(out_pair, ins);
    store64(out_pair + 8, del);
    stdout_write(" ", 1);
    write_sanitized(STDOUT, path, strlen(path));   # 1.7.6 (R13)
    stdout_write(" | +", 4);
    var nbuf[24];
    var d = write_decimal(&nbuf, ins);
    stdout_write(&nbuf, d);
    stdout_write(" -", 2);
    d = write_decimal(&nbuf, del);
    stdout_write(&nbuf, d);
    stdout_write("\n", 1);
    return 0;
}

# Read a blob object by hex hash; write (content_ptr, content_len) to out_pair.
# Returns 0 on success, negative on error.
fn read_blob_content(hex, out_pair) {
    var obj[24];
    if (read_object(hex, &obj) != 0) { return 0 - 1; }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    store64(out_pair, buf + coff);
    store64(out_pair + 8, blen - coff);
    return 0;
}

# `sit diff [--staged|HEAD] [-U<N>]` — unstaged, staged or working-vs-HEAD diffs.
fn cmd_diff() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    # Scan args: --staged flag, -U<N> context width (default 3), optional 1-2 positional refs.
    var staged = 0;
    var ref_a = 0;
    var ref_b = 0;
    var ctx = 3;
    var ai = 2;
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "--staged") == 1) { staged = 1; ai = ai + 1; }
        else {
            # -U<N>: hunk context width (matches `git diff -U<N>` /
            # `diff -U<N>` posix shape). N is a non-negative decimal.
            if (strlen(a) >= 2) {
                if (load8(a) == 45) {
                    if (load8(a + 1) == 85) {
                        var nstr = a + 2;
                        if (strlen(nstr) == 0) {
                            eprintln("usage: sit diff -U<N> [...] (N is a non-negative integer)");
                            return 1;
                        }
                        ctx = atoi(nstr);
                        if (ctx < 0) {
                            eprintln("usage: sit diff -U<N> [...] (N is a non-negative integer)");
                            return 1;
                        }
                        ai = ai + 1;
                        continue;
                    }
                }
            }
            if (ref_a == 0) { ref_a = argv_heap(ai); ai = ai + 1; }
            else {
                if (ref_b == 0) { ref_b = argv_heap(ai); ai = ai + 1; }
                else {
                    eprintln("usage: sit diff [--staged] [-U<N>] [<commit> [<commit>]]");
                    return 1;
                }
            }
        }
    }

    # Resolve any refs to commit trees.
    var tree_a_entries = 0;
    var tree_b_entries = 0;
    if (ref_a != 0) {
        var r[72];
        if (resolve_commit_hash(ref_a, &r) != 1) {
            syscall(SYS_WRITE, STDERR, "sit: cannot resolve '", 21);
            syscall(SYS_WRITE, STDERR, ref_a, strlen(ref_a));
            syscall(SYS_WRITE, STDERR, "'\n", 2);
            return 1;
        }
        var ref_a_hex = alloc(65);
        memcpy(ref_a_hex, &r, 64);
        store8(ref_a_hex + 64, 0);
        tree_a_entries = commit_tree_entries(ref_a_hex);
        # 1.7.6 (L8): an unreadable tree diffed as an empty one.
        if (tree_a_entries == 0) {
            eprintln("sit: cannot read that commit's tree (missing or corrupt objects)");
            return 1;
        }
    }
    if (ref_b != 0) {
        var r[72];
        if (resolve_commit_hash(ref_b, &r) != 1) {
            syscall(SYS_WRITE, STDERR, "sit: cannot resolve '", 21);
            syscall(SYS_WRITE, STDERR, ref_b, strlen(ref_b));
            syscall(SYS_WRITE, STDERR, "'\n", 2);
            return 1;
        }
        var ref_b_hex = alloc(65);
        memcpy(ref_b_hex, &r, 64);
        store8(ref_b_hex + 64, 0);
        tree_b_entries = commit_tree_entries(ref_b_hex);
        # 1.7.6 (L8): an unreadable tree diffed as an empty one.
        if (tree_b_entries == 0) {
            eprintln("sit: cannot read that commit's tree (missing or corrupt objects)");
            return 1;
        }
    }

    # Mode: tree-vs-tree (two refs given).
    if (tree_b_entries != 0) {
        var an = vec_len(tree_a_entries);
        var bn = vec_len(tree_b_entries);
        # For each path in A: if B has it with different hash, diff; if B lacks it, full delete.
        var i = 0;
        while (i < an) {
            var ae = vec_get(tree_a_entries, i);
            var apath = tree_entry_name(ae);
            var ahex = tree_entry_hash(ae);
            var be = tree_find(tree_b_entries, apath);
            if (be == 0) {
                var ap[16];
                if (read_blob_content(ahex, &ap) == 0) {
                    print_file_diff(apath, load64(&ap), load64(&ap + 8), 0, 0, ctx);
                }
            }
            else {
                if (streq(tree_entry_hash(be), ahex) == 0) {
                    var ap[16];
                    var bp[16];
                    if (read_blob_content(ahex, &ap) == 0) {
                        if (read_blob_content(tree_entry_hash(be), &bp) == 0) {
                            print_file_diff(apath,
                              load64(&ap), load64(&ap + 8),
                              load64(&bp), load64(&bp + 8), ctx);
                        }
                    }
                }
            }
            i = i + 1;
        }
        # Then: any path in B not in A → full addition.
        i = 0;
        while (i < bn) {
            var be = vec_get(tree_b_entries, i);
            var bpath = tree_entry_name(be);
            if (tree_find(tree_a_entries, bpath) == 0) {
                var bp[16];
                if (read_blob_content(tree_entry_hash(be), &bp) == 0) {
                    print_file_diff(bpath, 0, 0, load64(&bp), load64(&bp + 8), ctx);
                }
            }
            i = i + 1;
        }
        return 0;
    }

    # Mode: working-vs-ref (one ref given).
    if (tree_a_entries != 0) {
        var head_entries = tree_a_entries;
        var working_files = list_working_files();

        if (head_entries != 0) {
            var hn = vec_len(head_entries);
            var hi = 0;
            while (hi < hn) {
                var he = vec_get(head_entries, hi);
                var path = tree_entry_name(he);
                var head_hex = tree_entry_hash(he);

                if (sf_exists(path) == 1) {
                    var working_hex = hash_file_as_blob(path);
                    if (working_hex != 0) {
                        if (streq(head_hex, working_hex) == 0) {
                            var hp[16];
                            var wp[16];
                            if (read_blob_content(head_hex, &hp) == 0) {
                                if (read_file_heap(path, &wp) == 0) {
                                    print_file_diff(path,
                                      load64(&hp), load64(&hp + 8),
                                      load64(&wp), load64(&wp + 8), ctx);
                                }
                            }
                        }
                    }
                }
                else {
                    var hp[16];
                    if (read_blob_content(head_hex, &hp) == 0) {
                        print_file_diff(path, load64(&hp), load64(&hp + 8), 0, 0, ctx);
                    }
                }
                hi = hi + 1;
            }
        }

        var wn = vec_len(working_files);
        var wi = 0;
        while (wi < wn) {
            var wpath = vec_get(working_files, wi);
            if (tree_find(head_entries, wpath) == 0) {
                var wp[16];
                if (read_file_heap(wpath, &wp) == 0) {
                    print_file_diff(wpath, 0, 0, load64(&wp), load64(&wp + 8), ctx);
                }
            }
            wi = wi + 1;
        }
        return 0;
    }

    var index_entries = parse_index();
    if (index_entries != 0) {
        sort_entries(index_entries);
        index_entries = dedupe_entries(index_entries);
    }

    var head_entries = 0;
    if (staged == 1) { head_entries = read_head_tree_entries(); }

    # Under --staged, emit full-file deletion diffs for HEAD paths absent from index.
    if (staged == 1) {
        if (head_entries != 0) {
            var hn = vec_len(head_entries);
            var hi = 0;
            while (hi < hn) {
                var he = vec_get(head_entries, hi);
                var hpath = tree_entry_name(he);
                if (index_find(index_entries, hpath) == 0) {
                    var op[16];
                    if (read_blob_content(tree_entry_hash(he), &op) == 0) {
                        print_file_diff(hpath, load64(&op), load64(&op + 8), 0, 0, ctx);
                    }
                }
                hi = hi + 1;
            }
        }
    }

    if (index_entries == 0) { return 0; }

    var n = vec_len(index_entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(index_entries, i);
        var path = entry_path(e);
        var idx_hash_hex = hex_encode(entry_hash(e), 32);

        if (staged == 1) {
            var head_ent = tree_find(head_entries, path);
            if (head_ent == 0) {
                var ip[16];
                if (read_blob_content(idx_hash_hex, &ip) == 0) {
                    print_file_diff(path, 0, 0, load64(&ip), load64(&ip + 8), ctx);
                }
            }
            else {
                if (streq(tree_entry_hash(head_ent), idx_hash_hex) == 0) {
                    var hp[16];
                    var ip[16];
                    if (read_blob_content(tree_entry_hash(head_ent), &hp) == 0) {
                        if (read_blob_content(idx_hash_hex, &ip) == 0) {
                            print_file_diff(path,
                              load64(&hp), load64(&hp + 8),
                              load64(&ip), load64(&ip + 8), ctx);
                        }
                    }
                }
            }
        }
        else {
            if (sf_exists(path) == 1) {
                var working_hex = hash_file_as_blob(path);
                if (working_hex != 0) {
                    if (streq(working_hex, idx_hash_hex) == 0) {
                        var ip[16];
                        var wp[16];
                        if (read_blob_content(idx_hash_hex, &ip) == 0) {
                            if (read_file_heap(path, &wp) == 0) {
                                print_file_diff(path,
                                  load64(&ip), load64(&ip + 8),
                                  load64(&wp), load64(&wp + 8), ctx);
                            }
                        }
                    }
                }
            }
            else {
                var ip[16];
                if (read_blob_content(idx_hash_hex, &ip) == 0) {
                    print_file_diff(path, load64(&ip), load64(&ip + 8), 0, 0, ctx);
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Load a commit's tree and return its flattened entries. Returns 0 on error.
fn cmd_show() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    var stat_mode = 0;
    var hash_arg = 0;
    var ctx = 3;
    var ai = 2;
    while (ai < argc()) {
        var aa = argv(ai);
        if (streq(aa, "--stat") == 1) { stat_mode = 1; ai = ai + 1; continue; }
        # -U<N>: hunk context width (matches `git show -U<N>` shape).
        if (strlen(aa) >= 2) {
            if (load8(aa) == 45) {
                if (load8(aa + 1) == 85) {
                    var nstr = aa + 2;
                    if (strlen(nstr) == 0) {
                        eprintln("usage: sit show [--stat] [-U<N>] [<hash>]");
                        return 1;
                    }
                    ctx = atoi(nstr);
                    if (ctx < 0) {
                        eprintln("usage: sit show [--stat] [-U<N>] [<hash>]");
                        return 1;
                    }
                    ai = ai + 1;
                    continue;
                }
            }
        }
        hash_arg = argv_heap(ai);
        ai = ai + 1;
    }

    var hex[72];
    if (hash_arg == 0) {
        var head = read_head_ref();
        if (head == 0) {
            eprintln("sit: no commits yet");
            return 0;
        }
        memcpy(&hex, head, 64);
        store8(&hex + 64, 0);
    }
    else {
        var rr = resolve_commit_hash(hash_arg, &hex);
        if (rr == 0 - 2) { eprintln("sit: hash prefix too short (min 4 chars)"); return 1; }
        if (rr == 0 - 1) { eprintln("sit: ambiguous hash prefix"); return 1; }
        if (rr == 0)     { eprintln("sit: no object matches"); return 1; }
    }

    var obj[24];
    if (read_object(&hex, &obj) != 0) {
        eprintln("sit: cannot read object");
        return 1;
    }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var body = buf + coff;
    var body_len = blen - coff;

    var info[56];
    if (parse_commit_body(body, body_len, &info) != 0) {
        eprintln("sit: object is not a commit");
        return 1;
    }

    print_commit_header(&hex, &info, body, body_len);
    stdout_write("\n", 1);

    # 1.7.6 (L8): an unreadable tree — this commit's, or a parent that is here
    # but whose tree is not — is an error, not a diff. Since the walk stops at
    # the first bad subtree, ignoring it printed every later file as deleted.
    var tree_hex = load64(&info);
    var new_entries = vec_new();
    if (tree_hex != 0) {
        flatten_tree_reset();
        if (flatten_tree(tree_hex, "", new_entries) < 0) {
            eprintln("sit: cannot read that commit's tree (missing or corrupt objects)");
            return 1;
        }
    }

    var parent_hex = load64(&info + 8);
    var old_entries = vec_new();
    if (parent_hex != 0) {
        var po = commit_tree_entries(parent_hex);
        if (po != 0) { old_entries = po; }
        else {
            # Absent parent: a shallow boundary, shown as a root (as before).
            if (commit_tree_hex(parent_hex) != 0) {
                eprintln("sit: cannot read the parent commit's tree (missing or corrupt objects)");
                return 1;
            }
        }
    }

    var tot_files = 0;
    var tot_ins = 0;
    var tot_del = 0;
    var stat_pair[16];

    var n = vec_len(new_entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(new_entries, i);
        var path = tree_entry_name(e);
        var new_hash = tree_entry_hash(e);
        var old_ent = tree_find(old_entries, path);
        if (old_ent == 0) {
            var np[16];
            if (read_blob_content(new_hash, &np) == 0) {
                if (stat_mode == 1) {
                    print_file_stat(path, 0, 0, load64(&np), load64(&np + 8), &stat_pair);
                    tot_files = tot_files + 1;
                    tot_ins = tot_ins + load64(&stat_pair);
                    tot_del = tot_del + load64(&stat_pair + 8);
                }
                else {
                    print_file_diff(path, 0, 0, load64(&np), load64(&np + 8), ctx);
                }
            }
        }
        else {
            if (streq(tree_entry_hash(old_ent), new_hash) == 0) {
                var op[16];
                var np[16];
                if (read_blob_content(tree_entry_hash(old_ent), &op) == 0) {
                    if (read_blob_content(new_hash, &np) == 0) {
                        if (stat_mode == 1) {
                            print_file_stat(path,
                              load64(&op), load64(&op + 8),
                              load64(&np), load64(&np + 8),
                              &stat_pair);
                            tot_files = tot_files + 1;
                            tot_ins = tot_ins + load64(&stat_pair);
                            tot_del = tot_del + load64(&stat_pair + 8);
                        }
                        else {
                            print_file_diff(path,
                              load64(&op), load64(&op + 8),
                              load64(&np), load64(&np + 8), ctx);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    var on = vec_len(old_entries);
    i = 0;
    while (i < on) {
        var e = vec_get(old_entries, i);
        var path = tree_entry_name(e);
        if (tree_find(new_entries, path) == 0) {
            var op[16];
            if (read_blob_content(tree_entry_hash(e), &op) == 0) {
                if (stat_mode == 1) {
                    print_file_stat(path, load64(&op), load64(&op + 8), 0, 0, &stat_pair);
                    tot_files = tot_files + 1;
                    tot_ins = tot_ins + load64(&stat_pair);
                    tot_del = tot_del + load64(&stat_pair + 8);
                }
                else {
                    print_file_diff(path, load64(&op), load64(&op + 8), 0, 0, ctx);
                }
            }
        }
        i = i + 1;
    }

    if (stat_mode == 1) {
        if (tot_files > 0) {
            var sbuf[24];
            var sd = write_decimal(&sbuf, tot_files);
            stdout_write(" ", 1);
            stdout_write(&sbuf, sd);
            if (tot_files == 1) { stdout_write(" file changed, ", 15); }
            else                { stdout_write(" files changed, ", 16); }
            sd = write_decimal(&sbuf, tot_ins);
            stdout_write(&sbuf, sd);
            if (tot_ins == 1) { stdout_write(" insertion(+), ", 15); }
            else              { stdout_write(" insertions(+), ", 16); }
            sd = write_decimal(&sbuf, tot_del);
            stdout_write(&sbuf, sd);
            if (tot_del == 1) { stdout_write(" deletion(-)\n", 13); }
            else              { stdout_write(" deletions(-)\n", 14); }
        }
    }
    return 0;
}

# =====================================================================
# Wire protocol — local-path transport (v0.5.0)
#
# A remote is another sit working-tree directory (the one containing `.sit/`).
# We open its patra object DB directly and walk refs by filesystem path.
# No pack bundles, no network. HTTP and SSH transports are v0.5.x work.
# =====================================================================

# Look up `remote.<name>.url` in the local config. Returns heap cstring or 0.

# --- commit.cyr ---

# commit.cyr — commit objects + log.
#
# Builders for signed and unsigned commit bodies, author-line parser,
# git-style header and oneline renderers, reachability helpers
# (is_ancestor, materialize_target, commit_tree_entries), and cmd_commit /
# cmd_log.

# Unsigned commit — thin wrapper over build_commit_signed (the real builder).
fn build_commit(tree_hex, parent_hex, message) {
    return build_commit_signed(tree_hex, parent_hex, message, 0);
}

# Same as build_commit, but when `seed` is non-zero, signs the commit with
# an ed25519 key derived from the 32-byte seed and injects a sitsig header.
fn build_commit_signed(tree_hex, parent_hex, message, seed) {
    # Priority: env → .sit/config → ~/.sitconfig → fallback
    var name = getenv("SIT_AUTHOR_NAME");
    if (name == 0) { name = config_get("user.name"); }
    if (name == 0) { name = "sit user"; }
    var email = getenv("SIT_AUTHOR_EMAIL");
    if (email == 0) { email = config_get("user.email"); }
    if (email == 0) { email = "user@localhost"; }
    # S-27: strip ident crud (control bytes, `<`, `>`) BEFORE the object is
    # framed — a newline here forges a header line in the commit body.
    # Re-fall-back if sanitizing emptied the field entirely.
    name = ident_sanitized(name);
    email = ident_sanitized(email);
    if (strlen(name) == 0) { name = "sit user"; }
    if (strlen(email) == 0) { email = "user@localhost"; }
    var ts = clock_epoch_secs();

    var name_len = strlen(name);
    var email_len = strlen(email);
    var msg_len = strlen(message);

    var cap = 512 + msg_len + name_len * 2 + email_len * 2;
    if (parent_hex != 0) { cap = cap + 80; }
    var body = alloc_or_die(cap);
    var pos = 0;

    memcpy(body + pos, "tree ", 5); pos = pos + 5;
    memcpy(body + pos, tree_hex, 64); pos = pos + 64;
    store8(body + pos, 10); pos = pos + 1;

    if (parent_hex != 0) {
        memcpy(body + pos, "parent ", 7); pos = pos + 7;
        memcpy(body + pos, parent_hex, 64); pos = pos + 64;
        store8(body + pos, 10); pos = pos + 1;
    }

    memcpy(body + pos, "author ", 7); pos = pos + 7;
    memcpy(body + pos, name, name_len); pos = pos + name_len;
    memcpy(body + pos, " <", 2); pos = pos + 2;
    memcpy(body + pos, email, email_len); pos = pos + email_len;
    memcpy(body + pos, "> ", 2); pos = pos + 2;
    var digits = write_decimal(body + pos, ts); pos = pos + digits;
    memcpy(body + pos, " +0000\n", 7); pos = pos + 7;

    memcpy(body + pos, "committer ", 10); pos = pos + 10;
    memcpy(body + pos, name, name_len); pos = pos + name_len;
    memcpy(body + pos, " <", 2); pos = pos + 2;
    memcpy(body + pos, email, email_len); pos = pos + email_len;
    memcpy(body + pos, "> ", 2); pos = pos + 2;
    digits = write_decimal(body + pos, ts); pos = pos + digits;
    memcpy(body + pos, " +0000\n", 7); pos = pos + 7;

    store8(body + pos, 10); pos = pos + 1;
    memcpy(body + pos, message, msg_len); pos = pos + msg_len;
    if (msg_len == 0) { store8(body + pos, 10); pos = pos + 1; }
    else {
        if (load8(message + msg_len - 1) != 10) {
            store8(body + pos, 10); pos = pos + 1;
        }
    }

    if (seed != 0) {
        var new_len_slot[8];
        store64(&new_len_slot, 0);
        var signed = sign_commit_body(body, pos, seed, &new_len_slot);
        if (signed == 0) {
            return write_typed_object("commit", 6, body, pos);
        }
        return write_typed_object("commit", 6, signed, load64(&new_len_slot));
    }
    return write_typed_object("commit", 6, body, pos);
}

# Read a commit's parent hexes — the out+48 vec from parse_commit_body, or 0
# if the object is unreadable / not a parseable commit. The returned vec holds
# heap-owned 64-char NUL-terminated hex copies (safe to retain across calls).
# Consolidates the read_object → parse_commit_body → load64(out+48) boilerplate
# shared by the pure parent-graph walks (is_ancestor, find_merge_base). [v0.9.0]
fn commit_parents_of(hex) {
    var obj[24];
    if (read_object(hex, &obj) != 0) { return 0; }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var info[56];
    if (parse_commit_body(buf + coff, blen - coff, &info) != 0) { return 0; }
    return load64(&info + 48);
}

# True iff `ancestor_hex` is reachable from `descendant_hex` via any parent
# chain. BFS over the full commit DAG (every parent line, not just the last)
# with a seen-set so merge commits don't hide first-parent-only ancestors and
# diamond histories don't re-walk. Mirrors is_ancestor_in_db (wire.cyr), which
# does the same over a remote patra handle.
fn is_ancestor(ancestor_hex, descendant_hex) {
    if (streq(ancestor_hex, descendant_hex) == 1) { return 1; }

    var queue = vec_new();
    var seen = map_new();
    var start = alloc(65);
    memcpy(start, descendant_hex, 64);
    store8(start + 64, 0);
    vec_push(queue, start);

    while (vec_len(queue) > 0) {
        var cur = vec_get(queue, vec_len(queue) - 1);
        vec_pop(queue);
        if (map_has(seen, cur) == 1) { }
        else {
            map_set(seen, cur, 1);
            if (streq(cur, ancestor_hex) == 1) { return 1; }
            var pv = commit_parents_of(cur);
            if (pv != 0) {
                var pi = 0;
                while (pi < vec_len(pv)) {
                    vec_push(queue, vec_get(pv, pi));
                    pi = pi + 1;
                }
            }
        }
    }
    return 0;
}

# 1.6.4 preflight for materialize: 0 if the switch is safe, -1 (after saying
# why) if it would destroy something. Runs before ANY write, so a refusal leaves
# the worktree, index and HEAD exactly as they were.
#
#   every mode: no path to be written or removed lies beyond a symlink — the
#     write would land outside the repository (CVE-2021-21300 class).
#   mode 1:     the tracked tree must be clean (is_dirty).
#   mode >= 1:  no untracked, non-ignored file may be overwritten, sit inside a
#     directory the target turns into a file, or occupy a path the target needs
#     as a directory. Only `checkout` checked this through 1.6.3 (files only);
#     fast-forward merge, pull, cherry-pick, revert, rebase, octopus merge and
#     stash pop overwrote untracked work silently.
fn _materialize_preflight(target_entries, curr_entries, mode) {
    var cn = vec_len(curr_entries);
    var ci = 0;
    while (ci < cn) {
        var cpath = tree_entry_name(vec_get(curr_entries, ci));
        if (tree_flat_path_valid(cpath) == 1) {
            if (_sf_parent_symlink(cpath) == 1) {
                eprint3("sit: refusing to touch '", cpath, "' — it is beyond a symbolic link\n");
                return 0 - 1;
            }
        }
        ci = ci + 1;
    }
    var tn = vec_len(target_entries);
    var tdirs = map_new();
    var ti = 0;
    while (ti < tn) {
        var tpath = tree_entry_name(vec_get(target_entries, ti));
        if (tree_flat_path_valid(tpath) == 1) {
            if (_sf_parent_symlink(tpath) == 1) {
                eprint3("sit: refusing to write '", tpath, "' — it is beyond a symbolic link\n");
                return 0 - 1;
            }
            # Record every directory prefix the target needs.
            var tl = strlen(tpath);
            var k = 0;
            while (k < tl) {
                if (load8(tpath + k) == 47) {
                    var d = alloc_or_die(k + 1);
                    memcpy(d, tpath, k);
                    store8(d + k, 0);
                    map_set(tdirs, d, 1);
                }
                k = k + 1;
            }
        }
        ti = ti + 1;
    }
    if (mode == 0) { return 0; }
    if (mode == 1) {
        if (is_dirty() == 1) {
            eprintln("sit: working tree has uncommitted changes — commit or stash them first");
            return 0 - 1;
        }
    }

    var working = list_working_files();
    var wn = vec_len(working);
    var wi = 0;
    while (wi < wn) {
        var wpath = vec_get(working, wi);
        if (tree_find(curr_entries, wpath) == 0) {
            # Untracked here. Overwritten outright?
            var te = tree_find(target_entries, wpath);
            if (te != 0) {
                var same = 0;
                if (path_lstat_kind(sit_abs(wpath)) == 0x8000) {
                    var wh = hash_file_as_blob(wpath);
                    if (wh != 0) {
                        if (streq(wh, tree_entry_hash(te)) == 1) { same = 1; }
                    }
                }
                if (same == 0) {
                    eprint3("sit: untracked file '", wpath, "' would be overwritten\n");
                    return 0 - 1;
                }
            }
            # Needed as a directory by the target?
            if (map_has(tdirs, wpath) == 1) {
                eprint3("sit: untracked file '", wpath, "' is in the way of a directory\n");
                return 0 - 1;
            }
            # Inside a directory the target replaces with a file?
            var wl = strlen(wpath);
            var j = 0;
            while (j < wl) {
                if (load8(wpath + j) == 47) {
                    var pre = alloc_or_die(j + 1);
                    memcpy(pre, wpath, j);
                    store8(pre + j, 0);
                    if (tree_find(target_entries, pre) != 0) {
                        eprint3("sit: untracked file '", wpath, "' would be lost\n");
                        return 0 - 1;
                    }
                }
                j = j + 1;
            }
        }
        wi = wi + 1;
    }
    return 0;
}

# Overwrite working tree + index with target commit's tree. Used by reset
# --hard and the abort / restore paths, which mean to discard local state.
# Does NOT update HEAD — caller does that, and only after this returns 0.
fn materialize_target(target_hex) {
    return _materialize(target_hex, 0);
}

# materialize_target for operations that must not destroy uncommitted work
# (checkout, merge, pull, cherry-pick, revert, rebase, stash pop). Refuses up
# front — nothing written — on a dirty tree or untracked files in the way.
# `dirty_checked` = 1 when the caller has already run is_dirty() itself.
fn materialize_target_safe(target_hex, dirty_checked) {
    if (dirty_checked == 1) { return _materialize(target_hex, 2); }
    return _materialize(target_hex, 1);
}

# Shared body; `mode` 0 = forced, 1 = full preflight, 2 = preflight minus is_dirty.
fn _materialize(target_hex, mode) {
    # 1.6.4 (E4): an unreadable target — or one that is not a commit — used to
    # become an EMPTY tree here, so the switch deleted every tracked file and
    # reported success. Nothing is touched now.
    var target_entries = commit_tree_entries(target_hex);
    if (target_entries == 0) {
        eprintln("sit: cannot read the target commit's tree — nothing changed");
        return 0 - 1;
    }
    return _materialize_entries(target_entries, mode);
}

# materialize_target_safe for a tree that is not a commit's: `entries` is a
# flattened tree ({mode, path, hex} records, as flatten_tree builds), and the
# caller has checked the tracked tree is clean. The worktree and index become
# `entries`; HEAD does not move. (1.8.0: a three-way `stash pop`.)
fn materialize_entries_safe(entries) {
    return _materialize_entries(entries, 2);
}

# _materialize's body, on an already-flattened target tree.
fn _materialize_entries(target_entries, mode) {
    var curr_entries = read_head_tree_entries();
    if (curr_entries == 0) { curr_entries = vec_new(); }

    if (_materialize_preflight(target_entries, curr_entries, mode) != 0) { return 0 - 1; }

    # S-03 belt-and-suspenders: `flatten_tree` concatenates prefix + name, so
    # even if parse_tree screened each component, a pre-existing bogus tree
    # in the local store still needs gating before we act on its paths.
    var cn = vec_len(curr_entries);
    var ci = 0;
    while (ci < cn) {
        var ce = vec_get(curr_entries, ci);
        var cpath = tree_entry_name(ce);
        if (tree_flat_path_valid(cpath) == 1) {
            if (tree_find(target_entries, cpath) == 0) {
                if (sf_exists(cpath) == 1) {
                    # S-16: refuse to declare success when a stale file the
                    # target says shouldn't exist couldn't be removed —
                    # otherwise `sit status` after checkout would still see
                    # it as tracked.
                    if (sf_unlink(cpath) != 0) {
                        eprint3("sit: cannot remove stale path '", cpath, "' — materialize aborted\n");
                        return 0 - 1;
                    }
                }
                _rmdir_empty_parents(cpath);
            }
        }
        ci = ci + 1;
    }

    var tn = vec_len(target_entries);
    var ti = 0;
    while (ti < tn) {
        var te = vec_get(target_entries, ti);
        var tpath = tree_entry_name(te);
        var thex = tree_entry_hash(te);
        if (tree_flat_path_valid(tpath) == 0) {
            # Silently skip rather than abort — materialize runs over many
            # paths and we want the valid ones to land. Emit to stderr so
            # operator knows something was filtered.
            eprint3("sit: refusing unsafe tree path: ", tpath, "\n");
        }
        else {
            ensure_parent_dirs(tpath);
            # An EMPTY directory where the target wants a file (left by an
            # earlier removal, or never tracked) is cleared; a non-empty one
            # makes the write below fail and abort.
            if (path_lstat_kind(sit_abs(tpath)) == 0x4000) { sf_rmdir(tpath); }
            var tp[16];
            # S-27: a blob the tree references but the object DB can't read
            # is structural corruption — leaving the file silently absent
            # would mask the failure and produce a half-materialized working
            # tree. Abort with a clear error; callers that want best-effort
            # can re-run after `sit fsck`.
            if (read_blob_content(thex, &tp) != 0) {
                syscall(SYS_WRITE, STDERR, "sit: cannot read blob ", 22);
                syscall(SYS_WRITE, STDERR, thex, strlen(thex));
                eprint3(" for path '", tpath, "' — materialize aborted (working tree may be partial)\n");
                return 0 - 1;
            }
            # S-16: file_write_all returns < 0 on any write or open failure
            # (permissions, ENOSPC, EROFS). Same partial-tree problem as the
            # blob-read failure above; abort with a clear pointer to the path.
            if (sf_write_all(tpath, load64(&tp), load64(&tp + 8)) < 0) {
                eprint3("sit: cannot write '", tpath, "' — materialize aborted (working tree may be partial)\n");
                return 0 - 1;
            }
        }
        ti = ti + 1;
    }

    var new_index = vec_new();
    ti = 0;
    while (ti < tn) {
        var te = vec_get(target_entries, ti);
        var tpath = tree_entry_name(te);
        var thex = tree_entry_hash(te);
        if (tree_flat_path_valid(tpath) == 1) {
            var bytes = hex_decode(thex, 64);
            if (bytes != 0) {
                var entry = alloc_or_die(40);
                memcpy(entry, bytes, 32);
                var plen = strlen(tpath);
                var pcopy = alloc_or_die(plen + 1);
                memcpy(pcopy, tpath, plen);
                store8(pcopy + plen, 0);
                store64(entry + 32, pcopy);
                vec_push(new_index, entry);
            }
        }
        ti = ti + 1;
    }
    # 1.6.4: a failed index rewrite left the worktree switched and the index on
    # the old tree, reported as success — the next commit then reverted the
    # switch. It is a failure like any other.
    if (rewrite_index(new_index) != 0) {
        eprintln("sit: cannot update the index — materialize aborted (run 'sit reset --hard HEAD')");
        return 0 - 1;
    }
    return 0;
}

# Split an author/committer line into ident ("Name <email>") and timestamp; -1 if no closing '>'.
fn parse_author_line(line, line_len, prefix_len, out) {
    return parse_author_line_a(0, line, line_len, prefix_len, out);
}

# Allocate `n` bytes from `a`, or from the global heap (dying on OOM) when `a`
# is 0: the two allocation modes of the `_a` parsers below.
fn _commit_alloc(a, n) {
    if (a == 0) { return alloc_or_die(n); }
    return alloc_via(a, n);
}

# parse_author_line with the ident and tz strings drawn from `a` (0 = the
# global heap). 1.7.5: see parse_commit_body_a.
fn parse_author_line_a(a, line, line_len, prefix_len, out) {
    var p = prefix_len;
    var found_close = 0;
    while (p < line_len) {
        if (load8(line + p) == 62) { found_close = 1; break; }
        p = p + 1;
    }
    if (found_close == 0) { return 0 - 1; }

    var ident_len = p - prefix_len + 1;
    var ident = _commit_alloc(a, ident_len + 1);
    if (ident == 0) { return 0 - 1; }
    memcpy(ident, line + prefix_len, ident_len);
    store8(ident + ident_len, 0);
    store64(out, ident);

    p = p + 1;
    if (p >= line_len) { return 0 - 1; }
    if (load8(line + p) != 32) { return 0 - 1; }
    p = p + 1;

    var ts = 0;
    var digit_count = 0;
    while (p < line_len) {
        var c = load8(line + p);
        if (c < 48) { break; }
        if (c > 57) { break; }
        digit_count = digit_count + 1;
        # S-18: i64 has ~19 decimal digits of range. Refuse 20+ digit
        # timestamps outright, and detect wrap on the 19th via `new < old`
        # (the only path a single decimal digit can produce a smaller value).
        if (digit_count > 19) { return 0 - 1; }
        var new_ts = ts * 10 + (c - 48);
        if (new_ts < ts) { return 0 - 1; }
        ts = new_ts;
        p = p + 1;
    }
    store64(out + 8, ts);

    if (p >= line_len) { return 0 - 1; }
    if (load8(line + p) != 32) { return 0 - 1; }
    p = p + 1;

    var tz_start = p;
    while (p < line_len) { p = p + 1; }
    var tz_len = p - tz_start;
    var tz = _commit_alloc(a, tz_len + 1);
    if (tz == 0) { return 0 - 1; }
    memcpy(tz, line + tz_start, tz_len);
    store8(tz + tz_len, 0);
    store64(out + 16, tz);

    return 0;
}

# Write the message portion of a commit body to stdout, indenting each
# line with four spaces (git-style).
fn print_indented_message(body, msg_start, body_len) {
    var msg_len = body_len - msg_start;
    while (msg_len > 0) {
        if (load8(body + msg_start + msg_len - 1) != 10) { break; }
        msg_len = msg_len - 1;
    }
    var mp = 0;
    while (mp < msg_len) {
        var mnl = mp;
        while (mnl < msg_len) {
            if (load8(body + msg_start + mnl) == 10) { break; }
            mnl = mnl + 1;
        }
        stdout_write("    ", 4);
        write_sanitized(STDOUT, body + msg_start + mp, mnl - mp);   # E10
        stdout_write("\n", 1);
        mp = mnl + 1;
    }
    return 0;
}

# Parse a commit object body. Writes to out (56 bytes):
#   [0..8)   tree_hex ptr (heap, null-term 64 chars)
#   [8..16)  parent_hex ptr (or 0 for root commit) — LAST parent line seen
#   [16..24) author identity ptr (or 0)
#   [24..32) author epoch timestamp
#   [32..40) author tz ptr (or 0)
#   [40..48) msg_start (byte offset into body; 0 if no message)
#   [48..56) parents vec — EVERY parent hex, in body order; 0 for root commit
# Returns 0 on success, -1 if body has no tree line.
#
# out+8 keeps the last-parent pointer for back-compat with single-parent-chain
# readers (cmd_log, merge_base). out+48's vec is the multi-parent surface that
# reachability + ancestor walks consume so merge commits don't drop edges.
# S-25: ceiling on a linear commit-history walk. Well above any real repository
# (the Linux kernel is ~1.3M commits), low enough that a cyclic or corrupt store
# fails in seconds instead of never.
var SIT_MAX_COMMIT_WALK = 10000000;

# S-25: 9999-12-31T23:59:59Z — the largest instant `iso8601` can render in its
# fixed 4-digit year field, and the bound that keeps `epoch_to_date`'s
# year-at-a-time walk from spinning on a hostile commit timestamp.
var SIT_TS_MAX = 253402300799;

# Clamp a commit timestamp into [0, SIT_TS_MAX] so a hostile value cannot drive date math.
fn commit_ts_clamp(ts) {
    if (ts < 0) { return 0; }
    if (ts > SIT_TS_MAX) { return SIT_TS_MAX; }
    return ts;
}

# Parse a commit body's tree / parent / author / committer headers into `out` (56 bytes).
fn parse_commit_body(body, body_len, out) {
    return parse_commit_body_a(0, body, body_len, out);
}

# parse_commit_body with the tree / parent / author strings and the parents vec
# drawn from `a` (0 = the global heap, dying on OOM, as parse_commit_body).
# Returns -1 as well when `a` cannot serve them. 1.7.5: `sit serve`'s
# fast-forward check parses a pushed history with it, on an arena it rewinds
# per walk, so the parse has one implementation rather than a second scanner.
fn parse_commit_body_a(a, body, body_len, out) {
    store64(out, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    store64(out + 24, 0);
    store64(out + 32, 0);
    store64(out + 40, 0);
    store64(out + 48, 0);

    # Object-id hex width per active backend: 64 (sit SHA-256) or 40 (git SHA-1).
    var hexlen = _id_hexlen();
    var pos = 0;
    var in_headers = 1;
    # 1.7.6 (R12 / X4): git's header order, enforced — `tree` is line 1 and
    # occurs once, parents follow it directly. The last `tree` used to win
    # wherever it sat, and HEAD's tree was read by a second scanner that took
    # the first: a pushed commit with two `tree` lines checked out one tree and
    # diffed against the other (a fresh clone showed staged changes, and a
    # reset deleted an untracked file). One reading now, git's, or a refusal.
    var hdr_idx = 0;
    var past_parents = 0;
    while (pos < body_len) {
        if (in_headers == 0) { pos = body_len; }
        else {
            var nl = pos;
            while (nl < body_len) {
                if (load8(body + nl) == 10) { break; }
                nl = nl + 1;
            }
            var line_len = nl - pos;

            if (line_len == 0) {
                in_headers = 0;
                store64(out + 40, nl + 1);
            }
            else {
                var is_tree = 0;
                var is_parent = 0;
                if (line_len > 5) { if (memeq(body + pos, "tree ", 5) == 1) { is_tree = 1; } }
                if (line_len > 7) { if (memeq(body + pos, "parent ", 7) == 1) { is_parent = 1; } }
                if (is_tree == 1) { if (hdr_idx != 0) { return 0 - 1; } }
                if (hdr_idx == 0) { if (is_tree == 0) { return 0 - 1; } }
                if (is_parent == 1) { if (past_parents == 1) { return 0 - 1; } }
                if (hdr_idx > 0) { if (is_parent == 0) { past_parents = 1; } }
                hdr_idx = hdr_idx + 1;
                if (line_len > 5) {
                    if (memeq(body + pos, "tree ", 5) == 1) {
                        if (line_len >= 5 + hexlen) {
                            var t = _commit_alloc(a, hexlen + 1);
                            if (t == 0) { return 0 - 1; }
                            memcpy(t, body + pos + 5, hexlen);
                            store8(t + hexlen, 0);
                            store64(out, t);
                        }
                    }
                }
                if (line_len > 7) {
                    if (memeq(body + pos, "parent ", 7) == 1) {
                        if (line_len >= 7 + hexlen) {
                            var p = _commit_alloc(a, hexlen + 1);
                            if (p == 0) { return 0 - 1; }
                            memcpy(p, body + pos + 7, hexlen);
                            store8(p + hexlen, 0);
                            store64(out + 8, p);
                            # Collect every parent (merge commits have 2+) into a
                            # vec at out+48 so reachability + ancestor walks follow
                            # all edges, not just the last one captured at out+8.
                            var pv = load64(out + 48);
                            if (pv == 0) {
                                if (a == 0) { pv = vec_new(); }
                                else { pv = vec_new_a(a); }
                                if (pv == 0) { return 0 - 1; }
                                store64(out + 48, pv);
                            }
                            if (a == 0) { vec_push(pv, p); }
                            else {
                                if (vec_push_a(a, pv, p) < 0) { return 0 - 1; }
                            }
                        }
                    }
                    if (memeq(body + pos, "author ", 7) == 1) {
                        var ao[24];
                        if (parse_author_line_a(a, body + pos, line_len, 7, &ao) == 0) {
                            store64(out + 16, load64(&ao));
                            # S-25: clamp the author timestamp to a representable
                            # range before anything formats it.
                            #
                            # The commit body is attacker-controlled (cloned or
                            # `.git/`-read repo) and the timestamp went straight
                            # into `iso8601`, whose stdlib `epoch_to_date` walks
                            # forward from 1970 ONE YEAR PER ITERATION. A
                            # timestamp of ~1e18 is tens of billions of
                            # iterations — `sit log` / `sit show` spin for hours
                            # on a single crafted commit.
                            #
                            # SIT_TS_MAX is 9999-12-31T23:59:59Z, which is also
                            # the largest value `iso8601`'s FOUR-digit year field
                            # can render without corrupting its own output, so
                            # the clamp is the formatter's real domain, not an
                            # arbitrary cutoff.
                            store64(out + 24, commit_ts_clamp(load64(&ao + 8)));
                            store64(out + 32, load64(&ao + 16));
                        }
                    }
                }
            }
            pos = nl + 1;
        }
    }
    if (load64(out) == 0) { return 0 - 1; }
    return 0;
}

# Print the "commit <hex> / Author: / Date: / [Signature: ...] / blank / message" block.
fn print_commit_header(commit_hex, info, body, body_len) {
    stdout_write("commit ", 7);
    stdout_write(commit_hex, 64);
    stdout_write("\n", 1);

    var pk[32];
    var vr = verify_commit_body(body, body_len, &pk);
    if (vr == 1) {
        var pk_hex = hex_encode(&pk, 32);
        stdout_write("Signature: good (key ", 21);
        stdout_write(pk_hex, 12);
        stdout_write(")\n", 2);
    }
    if (vr == 0) {
        var pk_hex = hex_encode(&pk, 32);
        stdout_write("Signature: BAD (key ", 20);
        stdout_write(pk_hex, 12);
        stdout_write(")\n", 2);
    }

    var ident = load64(info + 16);
    if (ident != 0) {
        var ts = load64(info + 24);
        stdout_write("Author: ", 8);
        # S-21: author identity is attacker-controlled in a cloned commit.
        # Scrub control chars so a crafted commit can't forge log lines
        # via \r\n or drive terminal-escape attacks via \x1b[.
        write_sanitized(STDOUT, ident, strlen(ident));
        stdout_write("\n", 1);
        var iso = iso8601(ts);
        stdout_write("Date:   ", 8);
        stdout_write(iso, strlen(iso));
        stdout_write("\n", 1);
    }

    stdout_write("\n", 1);
    var msg_start = load64(info + 40);
    if (msg_start > 0) {
        print_indented_message(body, msg_start, body_len);
    }
    return 0;
}

# Print a one-line summary of a commit: "<hex12> <first line of message>".
fn print_commit_oneline(commit_hex, body, body_len, msg_start) {
    stdout_write(commit_hex, 12);
    stdout_write(" ", 1);
    if (msg_start > 0) {
        var p = msg_start;
        while (p < body_len) {
            if (load8(body + p) == 10) { p = body_len; }
            else { p = p + 1; }
        }
        # Walk back to find the first \n after msg_start
        var first_nl = msg_start;
        while (first_nl < body_len) {
            if (load8(body + first_nl) == 10) { break; }
            first_nl = first_nl + 1;
        }
        var subj_len = first_nl - msg_start;
        if (subj_len > 0) {
            write_sanitized(STDOUT, body + msg_start, subj_len);    # E10
        }
    }
    stdout_write("\n", 1);
    return 0;
}

# ── sit log --graph (v0.8.12) ────────────────────────────
#
# An ASCII commit-DAG renderer. Unlike the default `cmd_log` (which walks
# only the first-parent chain via out+8), `--graph` walks the FULL DAG via
# `parse_commit_body`'s out+48 parents vec so merge topology is visible.
#
# Layout uses a position grid: lane k draws at column 2*k; the odd column
# 2*k-1 is the "seam" to its left where merges (`\`) and joins (`/`) connect.
# A commit row shows `*` at the emitting lane and `|` at every other active
# lane; a merge commit (≥2 parents that open a new lane) is followed by a
# `|\` connector; a commit whose parent rejoins an existing lane is followed
# by a `|/` connector. For a linear history this degrades to a column of
# `*`. Emission order is reverse-topological (a commit before its parents),
# newest-first by author timestamp — same primitive a `merge_base` walk wants.
#
# Node layout (48 bytes), keyed by commit hex in `nodes`:
#   [0..8)  parents vec (heap-owned 64-char hex copies, body order)
#   [8..16) pending_children (unemitted children; ready when 0)
#   [16..24) decompressed body ptr (retained for subject rendering)
#   [24..32) body_len
#   [32..40) msg_start (offset into body; 0 if none)
#   [40..48) author epoch timestamp (emission-order key)
#
# Documented simplifications (consistent with the v0.8.10 `.sitignore`
# approach): spacing is sit-native, not byte-identical to git (git pads a
# merge commit row with extra spaces for its lanes; sit uses a single space
# before the commit info). A commit that simultaneously opens a new lane AND
# rejoins an existing one in the same step renders best-effort. Absent
# parents (shallow-clone boundaries) are filtered, so the graph stops cleanly
# at the boundary just like the default log.

fn _graph_build_node(hex) {
    var obj[24];
    if (read_object(hex, &obj) != 0) { return 0; }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var body = buf + coff;
    var body_len = blen - coff;
    var info[56];
    if (parse_commit_body(body, body_len, &info) != 0) { return 0; }
    var node = alloc_or_die(48);
    var pv = load64(&info + 48);
    var mine = vec_new();
    if (pv != 0) {
        var i = 0;
        while (i < vec_len(pv)) {
            var c = alloc_or_die(65);
            memcpy(c, vec_get(pv, i), 64);
            store8(c + 64, 0);
            vec_push(mine, c);
            i = i + 1;
        }
    }
    store64(node, mine);
    store64(node + 8, 0);
    store64(node + 16, body);
    store64(node + 24, body_len);
    store64(node + 32, load64(&info + 40));
    store64(node + 40, load64(&info + 24));
    return node;
}

# Find hex among lanes by string value (vec_find is pointer-equality).
# Returns the lane index, or -1.
fn _graph_lane_find(lanes, hex, excl) {
    var n = vec_len(lanes);
    var i = 0;
    var found = 0 - 1;
    while (i < n) {
        if (found < 0) {
            if (i != excl) {
                if (streq(vec_get(lanes, i), hex) == 1) { found = i; }
            }
        }
        i = i + 1;
    }
    return found;
}

# Write the subject (first message line) of a graph node, sanitized
# (S-21: commit messages are attacker-controlled in a cloned repo).
fn _graph_write_subject(node) {
    var body = load64(node + 16);
    var body_len = load64(node + 24);
    var msg_start = load64(node + 32);
    if (msg_start > 0) {
        var p = msg_start;
        var go = 1;
        while (go == 1) {
            if (p >= body_len) { go = 0; }
            else {
                if (load8(body + p) == 10) { go = 0; }
                else { p = p + 1; }
            }
        }
        var slen = p - msg_start;
        if (slen > 0) { write_sanitized(STDOUT, body + msg_start, slen); }
    }
    return 0;
}

# Emit a buffer trimmed of trailing spaces, plus newline (connector rows).
fn _graph_write_trimmed(buf, width) {
    var end = width;
    var go = 1;
    while (go == 1) {
        if (end <= 0) { go = 0; }
        else {
            if (load8(buf + end - 1) == 32) { end = end - 1; }
            else { go = 0; }
        }
    }
    if (end > 0) { stdout_write(buf, end); }
    stdout_write("\n", 1);
    return 0;
}

# Commit row: `*` at `col`, `|` at every other active lane, then info.
fn _graph_commit_row(lanes, col, hex, node) {
    var nl = vec_len(lanes);
    var width = 2 * nl - 1;
    var buf = alloc_or_die(width);
    var i = 0;
    while (i < width) { store8(buf + i, 32); i = i + 1; }
    var j = 0;
    while (j < nl) {
        var g = 124;
        if (j == col) { g = 42; }
        store8(buf + 2 * j, g);
        j = j + 1;
    }
    stdout_write(buf, width);
    stdout_write(" ", 1);
    stdout_write(hex, 12);
    stdout_write(" ", 1);
    _graph_write_subject(node);
    stdout_write("\n", 1);
    return 0;
}

# Merge connector: `|` at each lane < base, `\` at the seam of each lane
# >= base (the newly opened branches).
fn _graph_merge_connector(lanes, base) {
    var nl = vec_len(lanes);
    var width = 2 * nl - 1;
    var buf = alloc_or_die(width);
    var i = 0;
    while (i < width) { store8(buf + i, 32); i = i + 1; }
    var j = 0;
    while (j < base) { store8(buf + 2 * j, 124); j = j + 1; }
    var k = base;
    # Seam sits at the odd column 2*k-1, left of the new lane. Guard k>0:
    # a branch opened at column 0 has no column to its left (defensive — the
    # join branch needs >=2 lanes so base is normally >=1, but never let the
    # index underflow to buf-1).
    while (k < nl) {
        if (k > 0) { store8(buf + 2 * k - 1, 92); }
        k = k + 1;
    }
    _graph_write_trimmed(buf, width);
    return 0;
}

# Join connector: `|` at each surviving lane, `/` at the seam of the
# collapsing lane `rcol`. Rendered against the pre-removal lane count.
fn _graph_join_connector(old_nl, rcol) {
    var width = 2 * old_nl - 1;
    var buf = alloc_or_die(width);
    var i = 0;
    while (i < width) { store8(buf + i, 32); i = i + 1; }
    var j = 0;
    while (j < old_nl) {
        if (j != rcol) { store8(buf + 2 * j, 124); }
        j = j + 1;
    }
    # Seam at 2*rcol-1 — guard rcol>0 so a lane-0 collapse (the right-lane
    # branch commit being strictly newer than the left) doesn't write buf-1.
    # With rcol==0 there is no column to the left, so no `/` is drawn.
    if (rcol > 0) { store8(buf + 2 * rcol - 1, 47); }
    _graph_write_trimmed(buf, width);
    return 0;
}

# `log --graph`: BFS the DAG from start_hex, then print up to `limit` commits with lane art.
fn print_graph(start_hex, limit) {
    var nodes = map_new();
    var order = vec_new();

    # Pass 1: BFS the full DAG, building one node per reachable commit.
    var queue = vec_new();
    var sc = alloc_or_die(65);
    memcpy(sc, start_hex, 64);
    store8(sc + 64, 0);
    vec_push(queue, sc);
    while (vec_len(queue) > 0) {
        var h = vec_get(queue, vec_len(queue) - 1);
        vec_pop(queue);
        if (map_get(nodes, h) != 0) { }
        else {
            var node = _graph_build_node(h);
            if (node == 0) { }
            else {
                map_set(nodes, h, node);
                vec_push(order, h);
                var pv = load64(node);
                if (pv != 0) {
                    var pi = 0;
                    while (pi < vec_len(pv)) {
                        vec_push(queue, vec_get(pv, pi));
                        pi = pi + 1;
                    }
                }
            }
        }
    }

    # Pass 2: pending_children = number of reachable children per commit.
    var oi = 0;
    while (oi < vec_len(order)) {
        var nn = map_get(nodes, vec_get(order, oi));
        var pv2 = load64(nn);
        if (pv2 != 0) {
            var pj = 0;
            while (pj < vec_len(pv2)) {
                var pn = map_get(nodes, vec_get(pv2, pj));
                if (pn != 0) { store64(pn + 8, load64(pn + 8) + 1); }
                pj = pj + 1;
            }
        }
        oi = oi + 1;
    }

    # Emission: lanes carry the commit each column awaits. Pick the
    # ready lane (pending==0) with the newest timestamp each step.
    var lanes = vec_new();
    var lc = alloc_or_die(65);
    memcpy(lc, start_hex, 64);
    store8(lc + 64, 0);
    vec_push(lanes, lc);
    var shown = 0;
    var cont = 1;
    while (cont == 1) {
        if (vec_len(lanes) == 0) { cont = 0; }
        else { if (limit >= 0) { if (shown >= limit) { cont = 0; } } }
        if (cont == 1) {
            var nl = vec_len(lanes);
            var col = 0 - 1;
            var best = 0 - 1;
            var i = 0;
            while (i < nl) {
                var ln = map_get(nodes, vec_get(lanes, i));
                if (ln != 0) {
                    if (load64(ln + 8) == 0) {
                        var ts = load64(ln + 40);
                        if (col < 0) { col = i; best = ts; }
                        else { if (ts > best) { col = i; best = ts; } }
                    }
                }
                i = i + 1;
            }
            if (col < 0) { col = 0; }
            var cur = vec_get(lanes, col);
            var node = map_get(nodes, cur);
            if (node == 0) { vec_remove(lanes, col); }
            else {
                _graph_commit_row(lanes, col, cur, node);
                shown = shown + 1;

                # Present parents = parents that exist locally (absent =
                # shallow boundary). Decrement each so it can become ready.
                var pv = load64(node);
                var present = vec_new();
                if (pv != 0) {
                    var k = 0;
                    while (k < vec_len(pv)) {
                        var p = vec_get(pv, k);
                        var pn = map_get(nodes, p);
                        if (pn != 0) {
                            store64(pn + 8, load64(pn + 8) - 1);
                            vec_push(present, p);
                        }
                        k = k + 1;
                    }
                }
                var npp = vec_len(present);
                if (npp == 0) { vec_remove(lanes, col); }
                else {
                    var p0 = vec_get(present, 0);
                    var ex0 = _graph_lane_find(lanes, p0, col);
                    if (ex0 >= 0) {
                        _graph_join_connector(vec_len(lanes), col);
                        vec_remove(lanes, col);
                    }
                    else { vec_set(lanes, col, p0); }
                    var base = vec_len(lanes);
                    var did_merge = 0;
                    var m = 1;
                    while (m < npp) {
                        var pk = vec_get(present, m);
                        if (_graph_lane_find(lanes, pk, 0 - 1) >= 0) { }
                        else { vec_push(lanes, pk); did_merge = 1; }
                        m = m + 1;
                    }
                    if (did_merge == 1) { _graph_merge_connector(lanes, base); }
                }
            }
        }
    }
    return 0;
}

# `sit log [--oneline] [--graph]` — commit history from HEAD.
fn cmd_log() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    # argv scan: --oneline, --graph, -n <count>, and an optional positional <ref>.
    var oneline = 0;
    var graph = 0;
    var limit = 0 - 1;
    var start_ref = 0;
    var ai = 2;
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "--oneline") == 1) { oneline = 1; ai = ai + 1; }
        else {
            if (streq(a, "--graph") == 1) { graph = 1; ai = ai + 1; }
            else {
                if (streq(a, "-n") == 1) {
                    if (ai + 1 >= argc()) {
                        eprintln("sit: -n requires a number");
                        return 1;
                    }
                    limit = atoi(argv(ai + 1));
                    ai = ai + 2;
                }
                else {
                    if (start_ref != 0) {
                        eprintln("usage: sit log [--oneline] [--graph] [-n <count>] [<ref>]");
                        return 1;
                    }
                    start_ref = argv_heap(ai);
                    ai = ai + 1;
                }
            }
        }
    }

    var current_hex = 0;
    if (start_ref != 0) {
        var resolved[72];
        var rr = resolve_commit_hash(start_ref, &resolved);
        if (rr != 1) {
            syscall(SYS_WRITE, STDERR, "sit: cannot resolve '", 21);
            syscall(SYS_WRITE, STDERR, start_ref, strlen(start_ref));
            syscall(SYS_WRITE, STDERR, "'\n", 2);
            return 1;
        }
        current_hex = alloc_or_die(65);
        memcpy(current_hex, &resolved, 64);
        store8(current_hex + 64, 0);
    }
    else {
        current_hex = read_head_ref();
    }
    if (current_hex == 0) {
        eprintln("sit: no commits yet");
        return 0;
    }

    # --graph walks the full DAG (out+48 parents); absent boundary parents
    # are filtered inside print_graph, so it's shallow-safe on its own.
    if (graph == 1) { return print_graph(current_hex, limit); }

    # Shallow-clone awareness (v0.8.12): `.sit/shallow` lists boundary
    # commits whose parents were not fetched. When the walk reaches one,
    # stop cleanly instead of erroring on the absent parent object.
    # S-27: shared with fsck's walk — `load_shallow_set` lives in object_db.cyr
    # (earlier in the include chain). This was an inline duplicate of it.
    var shallow = load_shallow_set();

    var first = 1;
    var shown = 0;
    # S-25: bound the parent walk.
    #
    # Objects are content-addressed, so a genuine hash cycle is infeasible to
    # forge — but sit does not re-verify an object's hash on READ (that is
    # fsck's job), so a hand-authored .sit/objects.patra can store a commit
    # under hash X whose body names X (or any descendant) as its parent. The
    # walk then never terminates. `limit` only bounds this when the user passed
    # `-n`; the default walk was unbounded.
    var walked = 0;
    while (current_hex != 0) {
        if (limit >= 0) {
            if (shown >= limit) { current_hex = 0; }
        }
        walked = walked + 1;
        if (walked > SIT_MAX_COMMIT_WALK) {
            eprintln("sit: commit history exceeds the walk limit (cycle or corrupt store?)");
            return 1;
        }
        if (current_hex == 0) { return 0; }

        var obj[24];
        if (read_object(current_hex, &obj) != 0) {
            eprintln("sit: cannot read commit object");
            return 1;
        }
        var buf = load64(&obj);
        var blen = load64(&obj + 8);
        var coff = load64(&obj + 16);
        var body = buf + coff;
        var body_len = blen - coff;

        var info[56];
        if (parse_commit_body(body, body_len, &info) != 0) {
            eprintln("sit: malformed commit");
            return 1;
        }

        if (oneline == 1) {
            print_commit_oneline(current_hex, body, body_len, load64(&info + 40));
        }
        else {
            if (first == 0) { stdout_write("\n", 1); }
            first = 0;
            print_commit_header(current_hex, &info, body, body_len);
        }

        shown = shown + 1;
        if (map_has(shallow, current_hex) == 1) {
            current_hex = 0;
        }
        else {
            current_hex = load64(&info + 8);
        }
    }
    return 0;
}

# Hash arbitrary content with "blob <len>\0" framing without writing.
# Returns 64-char null-terminated hex C-string (matches `sit add`'s hash).
fn commit_tree_entries(commit_hex) {
    var obj[24];
    if (read_object(commit_hex, &obj) != 0) { return 0; }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var body = buf + coff;
    var body_len = blen - coff;

    var info[56];
    if (parse_commit_body(body, body_len, &info) != 0) { return 0; }
    var tree_hex = load64(&info);
    if (tree_hex == 0) { return 0; }

    var out = vec_new();
    flatten_tree_reset();
    # 1.6.4: a subtree that cannot be read is a failure, not an empty
    # directory — ignoring it made every file under it look deleted.
    if (flatten_tree(tree_hex, "", out) < 0) { return 0; }
    return out;
}

# `sit commit [-S] -m <msg>` — record the staged index as a new commit (-S signs it).
fn cmd_commit() {
    var ac = argc();

    # Parse flags + message — support `sit commit <msg>`, `sit commit -m <msg>`,
    # and either of those with `-S` prepended or interleaved.
    var message = 0;
    var sign = 0;
    var k = 2;
    while (k < ac) {
        var a = argv(k);
        if (streq(a, "-S") == 1) { sign = 1; k = k + 1; }
        else {
            if (streq(a, "-m") == 1) {
                if (k + 1 >= ac) {
                    eprintln("sit: -m requires a message argument");
                    return 1;
                }
                message = argv_heap(k + 1);
                k = k + 2;
            }
            else {
                # 1.7.6 (L17): `sit commit --amend` made a commit whose message
                # was "--amend". A bare argument that looks like an option is
                # refused; `-m` still takes any message, dashes and all.
                if (load8(a) == 45) {
                    eprint3("sit: unknown option '", a, "' (use -m for a message that starts with '-')\n");
                    return 1;
                }
                if (message == 0) { message = argv_heap(k); }
                k = k + 1;
            }
        }
    }
    if (message == 0) {
        # 1.8.0: the commit that resolves a `merge -m` conflict stop takes
        # that message when given none (.sit/MERGE_MSG, git's MERGE_MSG).
        message = merge_msg_saved();
        if (message == 0) {
            if (ac < 3) { eprintln("usage: sit commit [-S] [-m] <message>"); }
            else { eprintln("sit: commit message required"); }
            return 1;
        }
    }

    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }

    var seed = 0;
    if (sign == 1) {
        seed = load_signing_seed();
        if (seed == 0) {
            eprintln("sit: no signing key (run 'sit key generate')");
            return 1;
        }
    }

    # 1.7.0: an unresolved conflict cannot be committed (see conflicts_*).
    if (conflicts_check_resolved() != 0) {
        eprintln("sit: commit refused — the last merge / cherry-pick / revert / rebase stop is unresolved");
        return 1;
    }
    var entries = parse_index();
    if (entries == 0) {
        eprintln("sit: nothing to commit (empty or missing index)");
        return 1;
    }

    sort_entries(entries);
    entries = dedupe_entries(entries);

    var tree_hex = build_tree(entries, 0);
    if (tree_hex == 0) {
        eprintln("sit: failed to write tree object");
        return 1;
    }

    if (head_ref_broken() == 1) {
        eprintln("sit: the current branch's ref is broken (not a commit id) — refusing to commit over it");
        return 1;
    }
    var parent_hex = read_head_ref();
    var merge_parent = read_merge_head();

    var commit_hex = 0;
    if (merge_parent != 0) {
        # Resolving an in-progress merge — 2-parent commit; MERGE_HEAD is
        # cleared once the ref has moved (below).
        commit_hex = build_merge_commit_signed(tree_hex, parent_hex, merge_parent, message, seed);
    }
    else {
        commit_hex = build_commit_signed(tree_hex, parent_hex, message, seed);
    }
    if (commit_hex == 0) {
        eprintln("sit: failed to write commit object");
        return 1;
    }

    if (write_head_ref(commit_hex) != 0) {
        eprintln("sit: failed to update HEAD's ref");
        return 1;
    }

    # Reflog: parent_hex (read before the write) is the old tip; 0 → initial.
    var rl_prefix = "commit: ";
    if (merge_parent != 0) { rl_prefix = "commit (merge): "; }
    else { if (parent_hex == 0) { rl_prefix = "commit (initial): "; } }
    reflog_head_move(parent_hex, commit_hex, reflog_msg_subject(rl_prefix, message));

    if (merge_parent != 0) {
        # S-16: a stale MERGE_HEAD silently turns the NEXT `sit commit` into
        # an unintended 2-parent merge. Refuse to declare success on the
        # commit if we couldn't clear it. 1.7.6: only AFTER the ref moved — it
        # was cleared first, so a ref write that then failed left the retry
        # committing without the merge parent.
        if (sf_unlink(".sit/MERGE_HEAD") != 0) {
            eprintln("sit: commit written but .sit/MERGE_HEAD could not be cleared");
            eprintln("sit:   the next commit may wrongly become a merge — remove the file manually");
            return 1;
        }
        merge_msg_clear();
    }

    conflicts_clear();

    # 1.6.4 (A15): a commit is what resolves a conflicted cherry-pick or revert,
    # so it clears their state files the way it clears MERGE_HEAD. They used to
    # linger forever (and `fsck --prune` now refuses while they exist). A rebase
    # owns CHERRY_PICK_HEAD itself and clears it on --continue / --abort.
    if (sf_exists(".sit/REVERT_HEAD") == 1) { sf_unlink(".sit/REVERT_HEAD"); }
    if (sf_exists(".sit/REBASE_ORIG") != 1) {
        if (sf_exists(".sit/CHERRY_PICK_HEAD") == 1) { sf_unlink(".sit/CHERRY_PICK_HEAD"); }
    }

    var branch = current_branch_name();
    stdout_write("[", 1);
    if (branch != 0) { stdout_write(branch, strlen(branch)); }
    else             { stdout_write("detached", 8); }
    stdout_write(" ", 1);
    if (merge_parent != 0) {
        stdout_write("(merge) ", 8);
    }
    else {
        if (parent_hex == 0) {
            stdout_write("(root-commit) ", 14);
        }
    }
    stdout_write(commit_hex, 12);
    stdout_write("] ", 2);
    var msg_len = strlen(message);
    stdout_write(message, msg_len);
    if (msg_len > 0) {
        if (load8(message + msg_len - 1) != 10) {
            stdout_write("\n", 1);
        }
    }
    else { stdout_write("\n", 1); }
    return 0;
}

# Parse an "author ..." or "committer ..." line. prefix_len is 7 or 10.
# Writes to out (24 bytes):
#   out[0..8):   identity ptr (heap-copy, null-terminated) — "NAME <EMAIL>"
#   out[8..16):  timestamp (epoch seconds)
#   out[16..24): tz ptr (heap-copy, null-terminated) — e.g. "+0000"
# Returns 0 on success, -1 on parse error.

# --- merge.cyr ---

# merge.cyr — 3-way line-level merge.
#
# LCS-hunk extractors, overlap detection, three_way_line_merge, conflict-file
# renderer, MERGE_HEAD marker, find_merge_base, signed/unsigned merge commit
# builders, cmd_merge (including --abort).

# Turn a diff op stream into {base_start, base_end, inserts} hunks for the three-way line merge.
# A hunk groups consecutive non-keep ops (deletes and/or inserts) and records the base line
# range it covers along with the replacement lines from the other side. Layout (24 bytes):
#   [0..8)   base_start (inclusive base line index)
#   [8..16)  base_end   (exclusive base line index)
#   [16..24) replacement lines vec (each element is a line-tuple pointer)
fn extract_hunks(ops) {
    var hunks = vec_new();
    var n = vec_len(ops);
    var i = 0;
    var base_pos = 0;
    var in_hunk = 0;
    var hunk_start = 0;
    var hunk_inserts = 0;

    while (i < n) {
        var op = vec_get(ops, i);
        var kind = load64(op);
        var line = load64(op + 8);

        if (kind == 0) {
            # Keep — close any open hunk
            if (in_hunk == 1) {
                var h = alloc_or_die(24);
                store64(h, hunk_start);
                store64(h + 8, base_pos);
                store64(h + 16, hunk_inserts);
                vec_push(hunks, h);
                in_hunk = 0;
            }
            base_pos = base_pos + 1;
        }
        else {
            if (in_hunk == 0) {
                in_hunk = 1;
                hunk_start = base_pos;
                hunk_inserts = vec_new();
            }
            if (kind == 1) { base_pos = base_pos + 1; }
            else { vec_push(hunk_inserts, line); }
        }
        i = i + 1;
    }

    if (in_hunk == 1) {
        var h = alloc_or_die(24);
        store64(h, hunk_start);
        store64(h + 8, base_pos);
        store64(h + 16, hunk_inserts);
        vec_push(hunks, h);
    }
    return hunks;
}

# Two hunks overlap iff their base ranges share at least one line OR one is an
# insert-only hunk (0-length base range) at a position the other's range
# touches, either end included.
fn hunks_overlap(h1, h2) {
    var s1 = load64(h1);
    var e1 = load64(h1 + 8);
    var s2 = load64(h2);
    var e2 = load64(h2 + 8);
    # 1.6.4: a pure insert at the START of the other side's replace / delete
    # lands exactly where that hunk consumes base lines, so the two edits touch
    # the same spot and there is no order-independent answer — git conflicts
    # here too. The range tests below called it disjoint (`e2 <= s1`), and the
    # walk in three_way_line_merge then jumped past the insert: base `a b c`,
    # ours `a B c`, theirs `a x b c` merged "cleanly" to `a B c`, silently
    # dropping `x`. The mirrored case happened to keep both edits, so the
    # result also depended on which side was "ours".
    #
    # 1.7.6 (L9): the mirror image — an insert at the END of the other side's
    # replace / delete — was still called disjoint. With repeated lines (`}`,
    # blank lines) the LCS can place the insert on either side of the removed
    # line, so the merge moved it: base `if x } } end`, ours adds `y` after the
    # first brace, theirs drops one brace → "clean" `if x y } end`, `y` now
    # inside the block. git conflicts here too. So an insert-only hunk at p
    # conflicts with any hunk whose base range touches p, at either end.
    if (s1 == e1) { if (s2 <= s1) { if (s1 <= e2) { return 1; } } }
    if (s2 == e2) { if (s1 <= s2) { if (s2 <= e1) { return 1; } } }
    # Otherwise touching ranges (e1 == s2 OR e2 == s1) consume distinct base
    # lines and do NOT overlap.
    if (e1 <= s2) { return 0; }
    if (e2 <= s1) { return 0; }
    return 1;
}

# Scan two hunk lists; return 1 if any pair overlaps.
fn any_hunk_overlap(hunks_a, hunks_b) {
    var na = vec_len(hunks_a);
    var nb = vec_len(hunks_b);
    var i = 0;
    while (i < na) {
        var j = 0;
        while (j < nb) {
            if (hunks_overlap(vec_get(hunks_a, i), vec_get(hunks_b, j)) == 1) { return 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Append a line-tuple's bytes + "\n" into `buf` starting at `pos`, refusing to
# write past `cap`. Returns the new position, or (0 - 1) if the line would not
# fit.
#
# S-25: this used to take no capacity and memcpy unconditionally. The caller
# sizes `out` from a worst-case estimate, so an estimate that is ever wrong —
# or a caller-side loop that fails to terminate, which is exactly what happened
# — writes attacker-influenced file bytes over adjacent heap objects until it
# reaches an unmapped page. The bound makes any such miscount fail closed (the
# merge degrades to a conflict) instead of corrupting the heap.
fn append_line_to_buf(buf, pos, line_tup, cap) {
    var lp = line_ptr(line_tup);
    var ll = line_len(line_tup);                # without diff.cyr's LINE_NO_EOL flag
    if (ll < 0) { return 0 - 1; }
    if (pos < 0) { return 0 - 1; }
    if (pos + ll + 1 > cap) { return 0 - 1; }
    memcpy(buf + pos, lp, ll);
    store8(buf + pos + ll, 10);
    return pos + ll + 1;
}

# Find a hunk in `hunks` whose base_start == b. Returns the hunk or 0.
fn hunk_starting_at(hunks, b) {
    var n = vec_len(hunks);
    var i = 0;
    while (i < n) {
        var h = vec_get(hunks, i);
        if (load64(h) == b) { return h; }
        i = i + 1;
    }
    return 0;
}

# 1 if the first 8000 bytes of buf contain a NUL — git's binary test.
fn _merge_looks_binary(buf, len) {
    var n = len;
    if (n > 8000) { n = 8000; }
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Three-way line-level merge. Returns a heap pointer to merged content on
# clean merge, or 0 on conflict. Writes the merged length into `out_len_ptr`.
fn three_way_line_merge(base_buf, base_len, ours_buf, ours_len, theirs_buf, theirs_len, out_len_ptr) {
    # 1.6.4 (A12): never line-merge binary content. Two edits to a binary on
    # different "lines" spliced into bytes that are neither version, and were
    # reported as a clean merge. git's heuristic: a NUL in the first 8000 bytes.
    if (_merge_looks_binary(base_buf, base_len) == 1) { return 0; }
    if (_merge_looks_binary(ours_buf, ours_len) == 1) { return 0; }
    if (_merge_looks_binary(theirs_buf, theirs_len) == 1) { return 0; }
    var base_lines = split_lines(base_buf, base_len);
    var ours_lines = split_lines(ours_buf, ours_len);
    var theirs_lines = split_lines(theirs_buf, theirs_len);

    var ops_bo = lcs_diff(base_lines, ours_lines);
    var ops_bt = lcs_diff(base_lines, theirs_lines);
    if (ops_bo == 0) { return 0; }
    if (ops_bt == 0) { return 0; }

    var ours_hunks = extract_hunks(ops_bo);
    var theirs_hunks = extract_hunks(ops_bt);

    if (any_hunk_overlap(ours_hunks, theirs_hunks) == 1) { return 0; }

    # Walk base; at each position, apply any starting hunk from either side.
    var bn = vec_len(base_lines);
    # Worst-case output size: base + ours_inserts + theirs_inserts + deletions
    var cap = base_len + ours_len + theirs_len + 64;
    var out = alloc_or_die(cap);
    var pos = 0;

    # S-25: walk base, applying each side's hunk that starts here.
    #
    # A hunk is {base_start, base_end, inserts} — "replace base[start,end) with
    # inserts". An INSERT-ONLY hunk has start == end, and the previous shape of
    # this loop set `b = load64(oh + 8)` unconditionally, i.e. back to the same
    # `b`. `hunk_starting_at` then re-found the identical hunk and re-appended
    # its lines forever, running `out` past its allocation — a SIGSEGV on an
    # entirely ordinary merge (one side appends a line, the other prepends one;
    # no hostile input required).
    #
    # The fix is to only take a hunk's base_end when it actually consumes base
    # lines. A pure insert emits its lines and leaves `b` alone, so the base
    # line at `b` is still emitted below and `b` advances by one — which is the
    # correct semantics for "insert before base line b" anyway.
    #
    # `err` makes an out-of-capacity append abort the whole merge (returns 0 =
    # conflict) rather than silently truncating the merged file.
    var b = 0;
    var err = 0;
    while (b <= bn) {
        if (err != 0) { b = bn + 1; }
        else {
            var advanced = 0;

            var oh = hunk_starting_at(ours_hunks, b);
            if (oh != 0) {
                var oins = load64(oh + 16);
                var oilen = vec_len(oins);
                var ok2 = 0;
                while (ok2 < oilen) {
                    if (pos >= 0) { pos = append_line_to_buf(out, pos, vec_get(oins, ok2), cap); }
                    ok2 = ok2 + 1;
                }
                var oend = load64(oh + 8);
                if (oend > b) { b = oend; advanced = 1; }
            }

            if (advanced == 0) {
                var th = hunk_starting_at(theirs_hunks, b);
                if (th != 0) {
                    var tins = load64(th + 16);
                    var tilen = vec_len(tins);
                    var tk = 0;
                    while (tk < tilen) {
                        if (pos >= 0) { pos = append_line_to_buf(out, pos, vec_get(tins, tk), cap); }
                        tk = tk + 1;
                    }
                    var tend = load64(th + 8);
                    if (tend > b) { b = tend; advanced = 1; }
                }
            }

            if (advanced == 0) {
                if (b < bn) {
                    if (pos >= 0) { pos = append_line_to_buf(out, pos, vec_get(base_lines, b), cap); }
                }
                b = b + 1;
            }

            if (pos < 0) { err = 1; }
        }
    }

    if (err != 0) { return 0; }
    store64(out_len_ptr, pos);
    return out;
}

# Write `.sit/MERGE_HEAD` pointing at the other-parent commit for an
# in-progress merge. Next `sit commit` will read this and emit a 2-parent
# commit, then unlink it.
fn write_merge_head(hex) {
    var buf = alloc_or_die(66);
    memcpy(buf, hex, 64);
    store8(buf + 64, 10);
    store8(buf + 65, 0);
    if (sf_write_atomic(".sit/MERGE_HEAD", buf, 65) < 0) { return 0 - 1; }
    return 0;
}

# Read `.sit/MERGE_HEAD` if it exists. Returns heap-allocated 64-char hex
# cstring, or 0 if no merge is in progress.
fn read_merge_head() {
    if (sf_exists(".sit/MERGE_HEAD") != 1) { return 0; }
    var fd = sf_open(".sit/MERGE_HEAD", 0, 0);
    if (fd < 0) { return 0; }
    var buf = alloc_or_die(80);
    var n = file_read(fd, buf, 80);
    file_close(fd);
    if (n < 64) { return 0; }
    # S-26: `.sit/MERGE_HEAD` is on-disk state that can arrive from outside the
    # process (a repo handed over mid-merge, a restored backup). Its 64 bytes are
    # memcpy'd verbatim into a commit's `parent` header, so gate them as hex the
    # way every other ref consumer does rather than trusting the file.
    if (hex_prefix_valid(buf, 64) == 0) { return 0; }
    store8(buf + 64, 0);
    return buf;
}

# Write a file with git-style conflict markers for ours/theirs. The markers
# wrap full-file content (we're file-level 3-way, not line-level yet).
#   <<<<<<< HEAD
#   <ours content>
#   =======
#   <theirs content>
#   >>>>>>> <branch_name>
fn write_conflict_file(path, ours_hex, theirs_hex, branch_name) {
    var op[16];
    var tp[16];
    var ours_content = 0;
    var ours_len = 0;
    var theirs_content = 0;
    var theirs_len = 0;
    if (ours_hex != 0) {
        if (read_blob_content(ours_hex, &op) == 0) {
            ours_content = load64(&op);
            ours_len = load64(&op + 8);
        }
    }
    if (theirs_hex != 0) {
        if (read_blob_content(theirs_hex, &tp) == 0) {
            theirs_content = load64(&tp);
            theirs_len = load64(&tp + 8);
        }
    }

    var bn_len = strlen(branch_name);
    var cap = 64 + ours_len + theirs_len + bn_len;
    var out = alloc_or_die(cap);
    var pos = 0;

    memcpy(out + pos, "<<<<<<< HEAD\n", 13); pos = pos + 13;
    if (ours_len > 0) {
        memcpy(out + pos, ours_content, ours_len);
        pos = pos + ours_len;
        if (load8(ours_content + ours_len - 1) != 10) {
            store8(out + pos, 10); pos = pos + 1;
        }
    }
    memcpy(out + pos, "=======\n", 8); pos = pos + 8;
    if (theirs_len > 0) {
        memcpy(out + pos, theirs_content, theirs_len);
        pos = pos + theirs_len;
        if (load8(theirs_content + theirs_len - 1) != 10) {
            store8(out + pos, 10); pos = pos + 1;
        }
    }
    memcpy(out + pos, ">>>>>>> ", 8); pos = pos + 8;
    memcpy(out + pos, branch_name, bn_len); pos = pos + bn_len;
    store8(out + pos, 10); pos = pos + 1;

    ensure_parent_dirs(path);
    if (sf_write_all(path, out, pos) < 0) { return 0 - 1; }
    return 0;
}

# Find the lowest common ancestor of two commits. Walks a's ancestry into a
# set, then walks b's and returns the first hit. Returns 0 if no common
# ancestor exists (disjoint histories).
# Author timestamp of a commit (out+24), or 0 if unreadable. Used only as
# a deterministic tiebreak when a criss-cross history has multiple bases.
fn _merge_commit_ts(hex) {
    var obj[24];
    if (read_object(hex, &obj) != 0) { return 0; }
    var buf = load64(&obj);
    var blen = load64(&obj + 8);
    var coff = load64(&obj + 16);
    var info[56];
    if (parse_commit_body(buf + coff, blen - coff, &info) != 0) { return 0; }
    return load64(&info + 24);
}

# Lowest common ancestor of two commits over the FULL commit DAG (v0.8.13).
#
# The pre-v0.8.13 implementation walked only the single first-parent chain
# (out+8) on both sides, so for any history with a merge it returned a
# too-high ancestor — e.g. in a diamond where one tip reaches the true base
# only through a merge's second parent, it fell back to the root. This walks
# every parent (out+48), so the base is correct across merges.
#
# Algorithm:
#   1. anc_a = full-DAG ancestor set of `a` (includes `a`).
#   2. BFS from `b`; the first time a path hits a commit in anc_a it's a
#      common ancestor — record it and PRUNE (don't expand its parents, they
#      can only be higher/redundant). This yields the frontier of common
#      ancestors cheaply (bounded by merge width, not history length).
#   3. Reduce: a candidate that is an ancestor of another candidate is
#      redundant (the other is lower). The maximal survivors are the merge
#      base(s); return the newest by author timestamp for determinism.
#
# Criss-cross histories can have several equally-valid bases; sit returns one
# (git would do a recursive merge). Returns a 64-char NUL-terminated hex, or
# 0 if the two commits share no ancestor.
fn find_merge_base(a_hex, b_hex) {
    # Phase 1: ancestors of a (full DAG).
    var anc_a = map_new();
    var q = vec_new();
    var sa = alloc_or_die(65);
    memcpy(sa, a_hex, 64);
    store8(sa + 64, 0);
    vec_push(q, sa);
    while (vec_len(q) > 0) {
        var cur = vec_get(q, vec_len(q) - 1);
        vec_pop(q);
        if (map_has(anc_a, cur) == 1) { }
        else {
            map_set(anc_a, cur, 1);
            var pv = commit_parents_of(cur);
            if (pv != 0) {
                var pi = 0;
                while (pi < vec_len(pv)) {
                    vec_push(q, vec_get(pv, pi));
                    pi = pi + 1;
                }
            }
        }
    }

    # Phase 2: prune-BFS from b → frontier of common ancestors.
    var candidates = vec_new();
    var seen_b = map_new();
    var q2 = vec_new();
    var sb = alloc_or_die(65);
    memcpy(sb, b_hex, 64);
    store8(sb + 64, 0);
    vec_push(q2, sb);
    while (vec_len(q2) > 0) {
        var cur = vec_get(q2, vec_len(q2) - 1);
        vec_pop(q2);
        if (map_has(seen_b, cur) == 1) { }
        else {
            map_set(seen_b, cur, 1);
            if (map_has(anc_a, cur) == 1) {
                vec_push(candidates, cur);
            }
            else {
                var pv = commit_parents_of(cur);
                if (pv != 0) {
                    var pi = 0;
                    while (pi < vec_len(pv)) {
                        vec_push(q2, vec_get(pv, pi));
                        pi = pi + 1;
                    }
                }
            }
        }
    }

    var nc = vec_len(candidates);
    if (nc == 0) { return 0; }
    if (nc == 1) { return vec_get(candidates, 0); }

    # Phase 3: drop redundant candidates (ancestor of another), keep the
    # newest maximal one.
    var best = 0;
    var best_ts = 0 - 1;
    var ci = 0;
    while (ci < nc) {
        var c = vec_get(candidates, ci);
        var redundant = 0;
        var cj = 0;
        while (cj < nc) {
            if (cj != ci) {
                var d = vec_get(candidates, cj);
                if (streq(c, d) == 0) {
                    if (is_ancestor(c, d) == 1) { redundant = 1; cj = nc; }
                }
            }
            if (cj < nc) { cj = cj + 1; }
        }
        if (redundant == 0) {
            var ts = _merge_commit_ts(c);
            if (ts > best_ts) { best = c; best_ts = ts; }
        }
        ci = ci + 1;
    }
    # In a well-formed DAG the partial order always has a maximal element, so
    # `best` is set. Guard the corrupt/cyclic case (mutual is_ancestor marks
    # every candidate redundant) — fall back to a real candidate rather than
    # reporting "no common ancestor" when common ancestors demonstrably exist.
    if (best == 0) { best = vec_get(candidates, 0); }
    return best;
}

# Plumbing: `sit merge-base <commit> <commit>` (v0.8.13). Prints the
# full-DAG lowest common ancestor — git's `git merge-base` shape. Both args
# are resolved through resolve_hash (branch / tag / hex-prefix). Exposes the
# LCA so the merge base is testable independent of a full `sit merge`.
fn cmd_merge_base() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 4) {
        eprintln("usage: sit merge-base <commit> <commit>");
        return 1;
    }

    var resa[72];
    if (resolve_commit_hash(argv(2), &resa) != 1) {
        syscall(SYS_WRITE, STDERR, "sit: cannot resolve '", 21);
        syscall(SYS_WRITE, STDERR, argv(2), strlen(argv(2)));
        syscall(SYS_WRITE, STDERR, "'\n", 2);
        return 1;
    }
    var ha = alloc_or_die(65);
    memcpy(ha, &resa, 64);
    store8(ha + 64, 0);

    var resb[72];
    if (resolve_commit_hash(argv(3), &resb) != 1) {
        syscall(SYS_WRITE, STDERR, "sit: cannot resolve '", 21);
        syscall(SYS_WRITE, STDERR, argv(3), strlen(argv(3)));
        syscall(SYS_WRITE, STDERR, "'\n", 2);
        return 1;
    }
    var hb = alloc_or_die(65);
    memcpy(hb, &resb, 64);
    store8(hb + 64, 0);

    var base = find_merge_base(ha, hb);
    if (base == 0) {
        eprintln("sit: no common ancestor");
        return 1;
    }
    stdout_write(base, 64);
    stdout_write("\n", 1);
    return 0;
}

# Build + write a 2-parent merge commit. Mirrors build_commit but emits two
# `parent <hex>\n` header lines. Returns the new commit's hex hash.
fn build_merge_commit(tree_hex, p1_hex, p2_hex, message) {
    return build_merge_commit_signed(tree_hex, p1_hex, p2_hex, message, 0);
}

# Build a two-parent merge commit (signed when `seed` != 0) with a sanitized identity.
fn build_merge_commit_signed(tree_hex, p1_hex, p2_hex, message, seed) {
    var name = getenv("SIT_AUTHOR_NAME");
    if (name == 0) { name = config_get("user.name"); }
    if (name == 0) { name = "sit user"; }
    var email = getenv("SIT_AUTHOR_EMAIL");
    if (email == 0) { email = config_get("user.email"); }
    if (email == 0) { email = "user@localhost"; }
    # S-27: strip ident crud (control bytes, `<`, `>`) BEFORE the object is
    # framed — a newline here forges a header line in the commit body.
    # Re-fall-back if sanitizing emptied the field entirely.
    name = ident_sanitized(name);
    email = ident_sanitized(email);
    if (strlen(name) == 0) { name = "sit user"; }
    if (strlen(email) == 0) { email = "user@localhost"; }
    var ts = clock_epoch_secs();

    var name_len = strlen(name);
    var email_len = strlen(email);
    var msg_len = strlen(message);

    var cap = 512 + msg_len + name_len * 2 + email_len * 2 + 160;
    var body = alloc_or_die(cap);
    var pos = 0;

    memcpy(body + pos, "tree ", 5); pos = pos + 5;
    memcpy(body + pos, tree_hex, 64); pos = pos + 64;
    store8(body + pos, 10); pos = pos + 1;

    memcpy(body + pos, "parent ", 7); pos = pos + 7;
    memcpy(body + pos, p1_hex, 64); pos = pos + 64;
    store8(body + pos, 10); pos = pos + 1;

    memcpy(body + pos, "parent ", 7); pos = pos + 7;
    memcpy(body + pos, p2_hex, 64); pos = pos + 64;
    store8(body + pos, 10); pos = pos + 1;

    memcpy(body + pos, "author ", 7); pos = pos + 7;
    memcpy(body + pos, name, name_len); pos = pos + name_len;
    memcpy(body + pos, " <", 2); pos = pos + 2;
    memcpy(body + pos, email, email_len); pos = pos + email_len;
    memcpy(body + pos, "> ", 2); pos = pos + 2;
    var digits = write_decimal(body + pos, ts); pos = pos + digits;
    memcpy(body + pos, " +0000\n", 7); pos = pos + 7;

    memcpy(body + pos, "committer ", 10); pos = pos + 10;
    memcpy(body + pos, name, name_len); pos = pos + name_len;
    memcpy(body + pos, " <", 2); pos = pos + 2;
    memcpy(body + pos, email, email_len); pos = pos + email_len;
    memcpy(body + pos, "> ", 2); pos = pos + 2;
    digits = write_decimal(body + pos, ts); pos = pos + digits;
    memcpy(body + pos, " +0000\n", 7); pos = pos + 7;

    store8(body + pos, 10); pos = pos + 1;
    memcpy(body + pos, message, msg_len); pos = pos + msg_len;
    if (msg_len == 0) { store8(body + pos, 10); pos = pos + 1; }
    else {
        if (load8(message + msg_len - 1) != 10) {
            store8(body + pos, 10); pos = pos + 1;
        }
    }

    if (seed != 0) {
        var new_len_slot[8];
        store64(&new_len_slot, 0);
        var signed = sign_commit_body(body, pos, seed, &new_len_slot);
        if (signed == 0) {
            return write_typed_object("commit", 6, body, pos);
        }
        return write_typed_object("commit", 6, signed, load64(&new_len_slot));
    }
    return write_typed_object("commit", 6, body, pos);
}

# Find a tree entry's hash_hex for a given path, or 0 if absent.
# Three-way tree merge over entry sets. Fills `merged` with result entries
# (40-byte [raw hash, path ptr] structs) and appends conflicted paths to
# `conflicts`. Line-level diff3 is attempted before a path is declared
# conflicted, so non-overlapping edits to the same file auto-merge.
#
# v1.5.1: extracted from cmd_merge, which had this inline. `cherry-pick` and
# `revert` are the same operation with the three roles assigned differently —
# cherry-pick is (base = the commit's parent, ours = HEAD, theirs = the commit)
# and revert is that with base and theirs swapped — so all three share this
# body rather than carrying three copies of a 130-line merge that 1.3.8 already
# found one non-termination bug in.
fn three_way_merge_entries(base_entries, ours_entries, theirs_entries, merged, conflicts) {
    var paths = three_way_path_set(base_entries, ours_entries, theirs_entries);

    var pn = vec_len(paths);
    var pi = 0;
    while (pi < pn) {
        var p = vec_get(paths, pi);
        var base_h = tree_find_hash(base_entries, p);
        var ours_h = tree_find_hash(ours_entries, p);
        var theirs_h = tree_find_hash(theirs_entries, p);

        # Result hash: 0 means "not in merged tree"
        var result_h = 0;
        var needs_conflict = 0;

        if (ours_h != 0) {
            if (theirs_h != 0) {
                if (streq(ours_h, theirs_h) == 1) {
                    result_h = ours_h;
                }
                else {
                    if (base_h != 0) {
                        if (streq(base_h, ours_h) == 1)   { result_h = theirs_h; }
                        else {
                            if (streq(base_h, theirs_h) == 1) { result_h = ours_h; }
                            else { needs_conflict = 1; }
                        }
                    }
                    else { needs_conflict = 1; }
                }
            }
            else {
                # theirs absent
                if (base_h != 0) {
                    if (streq(base_h, ours_h) == 1) { result_h = 0; }  # deleted by theirs
                    else { needs_conflict = 1; }  # ours modified, theirs deleted
                }
                else {
                    # Added only by ours
                    result_h = ours_h;
                }
            }
        }
        else {
            # ours absent
            if (theirs_h != 0) {
                if (base_h != 0) {
                    if (streq(base_h, theirs_h) == 1) { result_h = 0; }  # deleted by ours
                    else { needs_conflict = 1; }  # theirs modified, ours deleted
                }
                else {
                    result_h = theirs_h;
                }
            }
        }

        # Try line-level diff3 before declaring a file-level conflict.
        # Applies when base/ours/theirs all exist AND hunks don't overlap.
        if (needs_conflict == 1) {
            if (base_h != 0) {
                if (ours_h != 0) {
                    if (theirs_h != 0) {
                        var bp[16]; var op[16]; var tp[16];
                        if (read_blob_content(base_h, &bp) == 0) {
                            if (read_blob_content(ours_h, &op) == 0) {
                                if (read_blob_content(theirs_h, &tp) == 0) {
                                    var merged_len[8];
                                    var merged_buf = three_way_line_merge(
                                      load64(&bp), load64(&bp + 8),
                                      load64(&op), load64(&op + 8),
                                      load64(&tp), load64(&tp + 8),
                                      &merged_len);
                                    if (merged_buf != 0) {
                                        # Line-level merge succeeded — write as a new blob
                                        var new_hex = write_blob_object(merged_buf, load64(&merged_len));
                                        if (new_hex != 0) {
                                            result_h = new_hex;
                                            needs_conflict = 0;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (needs_conflict == 1) {
            var pc = alloc_or_die(strlen(p) + 1);
            memcpy(pc, p, strlen(p));
            store8(pc + strlen(p), 0);
            vec_push(conflicts, pc);
        }
        else {
            if (result_h != 0) {
                var bytes = hex_decode(result_h, 64);
                if (bytes != 0) {
                    var entry = alloc_or_die(40);
                    memcpy(entry, bytes, 32);
                    var pc = alloc_or_die(strlen(p) + 1);
                    memcpy(pc, p, strlen(p));
                    store8(pc + strlen(p), 0);
                    store64(entry + 32, pc);
                    vec_push(merged, entry);
                }
            }
        }
        pi = pi + 1;
    }
    return 0;
}

# `sit merge <branch> [<branch> ...]` — fast-forward, three-way or (2+ branches) octopus merge into HEAD.
fn cmd_merge() {
    if (sf_exists(".sit/HEAD") != 1) {
        eprintln("sit: not a sit repository (run 'sit init')");
        return 1;
    }
    if (argc() < 3) {
        eprintln("usage: sit merge [-S] [-m <msg>] <branch> [<branch> ...] | sit merge --abort");
        return 1;
    }

    # --abort: restore working tree to HEAD, clear MERGE_HEAD.
    if (streq(argv(2), "--abort") == 1) {
        if (sf_exists(".sit/MERGE_HEAD") != 1) {
            eprintln("sit: no merge in progress");
            return 1;
        }
        var head = read_head_ref();
        if (head != 0) {
            # S-16: propagate materialize failure so we don't claim "merge
            # aborted" when the working tree wasn't actually restored.
            if (materialize_target(head) != 0) {
                eprintln("sit: failed to restore working tree from HEAD; .sit/MERGE_HEAD left in place");
                return 1;
            }
        }
        # S-16: a stale MERGE_HEAD silently turns the next commit into a
        # 2-parent merge. Same cliff as cmd_commit's clear path.
        if (sf_unlink(".sit/MERGE_HEAD") != 0) {
            eprintln("sit: failed to clear .sit/MERGE_HEAD");
            eprintln("sit:   the next commit may wrongly become a merge — remove it manually");
            return 1;
        }
        merge_msg_clear();
        conflicts_clear();
        stdout_write("merge aborted\n", 14);
        return 0;
    }

    # 1.8.0: one parse. `-S` (sign) and `-m <msg>` may come anywhere; every
    # other argument is a branch, tag or commit, in order. One target is a
    # two-way merge, two or more an octopus. Through 1.7.x `-m` was accepted
    # and ignored (the message was always "Merge branch '<x>'"), and a flag
    # anywhere turned an octopus into a single-branch merge.
    var targets = vec_new();
    var merge_sign = 0;
    var merge_msg = 0;
    var mk = 2;
    while (mk < argc()) {
        var ma = argv(mk);
        if (streq(ma, "-S") == 1) { merge_sign = 1; mk = mk + 1; }
        else {
            if (streq(ma, "-m") == 1) {
                if (mk + 1 >= argc()) {
                    eprintln("sit: -m requires a message argument");
                    return 1;
                }
                merge_msg = argv_heap(mk + 1);
                mk = mk + 2;
            }
            else {
                if (load8(ma) == 45) {
                    eprint3("sit: unexpected merge argument '", ma, "'\n");
                    return 1;
                }
                vec_push(targets, argv_heap(mk));
                mk = mk + 1;
            }
        }
    }
    if (vec_len(targets) == 0) {
        eprintln("usage: sit merge [-S] [-m <msg>] <branch> [<branch> ...] | sit merge --abort");
        return 1;
    }
    if (vec_len(targets) > 1) { return cmd_merge_octopus(targets, merge_msg, merge_sign); }

    var target_name = vec_get(targets, 0);
    var tnlen = strlen(target_name);

    var target_hex[72];
    var rr = resolve_commit_hash(target_name, &target_hex);
    if (rr == 0 - 2) { eprintln("sit: merge target too short"); return 1; }
    if (rr == 0 - 1) { eprintln("sit: ambiguous merge target"); return 1; }
    if (rr == 0)     {
        syscall(SYS_WRITE, STDERR, "sit: '", 6);
        syscall(SYS_WRITE, STDERR, target_name, tnlen);
        syscall(SYS_WRITE, STDERR, "' is not a known branch, tag, or commit\n", 40);
        return 1;
    }

    var head_hex = read_head_ref();
    if (head_hex == 0) {
        eprintln("sit: current branch has no commits");
        return 1;
    }

    if (streq(&target_hex, head_hex) == 1) {
        stdout_write("already up to date\n", 19);
        return 0;
    }
    if (is_ancestor(&target_hex, head_hex) == 1) {
        stdout_write("already up to date\n", 19);
        return 0;
    }

    if (is_ancestor(head_hex, &target_hex) == 1) {
        if (is_dirty() == 1) {
            eprintln("sit: working tree has uncommitted changes");
            eprintln("sit:   commit or revert before merging");
            return 1;
        }
        # v1.5.1: materialize BEFORE the ref moves. materialize_target removes
        # paths that HEAD's CURRENT tree has and the target's does not, and it
        # finds "current" by reading HEAD — so moving the ref first makes that
        # removal a no-op and leaves stale files on disk. `checkout` already had
        # this order (with a comment saying why); `reset --hard` and `merge` did
        # not, so their stale-file removal had never run. Doing it in this order
        # is also the safer failure mode: a materialize that fails leaves HEAD
        # where it was.
        if (materialize_target_safe(&target_hex, 1) != 0) {
            eprintln("sit: failed to update working tree — HEAD unchanged");
            return 1;
        }
        if (write_head_ref(&target_hex) != 0) {
            eprintln("sit: failed to update branch ref");
            return 1;
        }
        reflog_head_move(head_hex, &target_hex,
          reflog_msg_join("merge ", target_name, ": Fast-forward"));

        stdout_write("fast-forward to ", 16);
        stdout_write(&target_hex, 12);
        stdout_write("\n", 1);
        return 0;
    }

    # Divergent → 3-way merge (file-level)
    if (is_dirty() == 1) {
        eprintln("sit: working tree has uncommitted changes");
        eprintln("sit:   commit or revert before merging");
        return 1;
    }

    var base_hex = find_merge_base(head_hex, &target_hex);
    if (base_hex == 0) {
        eprintln("sit: no common ancestor between current branch and target");
        return 1;
    }

    var base_entries = commit_tree_entries(base_hex);
    var ours_entries = commit_tree_entries(head_hex);
    var theirs_entries = commit_tree_entries(&target_hex);
    # 1.7.6 (L8): an unreadable side is not an empty side — an empty "theirs"
    # merged as "delete every file", an empty base as "both added everything".
    if (base_entries == 0) {
        eprintln("sit: cannot read a tree for this merge (missing or corrupt objects) — nothing changed");
        return 1;
    }
    if (ours_entries == 0) {
        eprintln("sit: cannot read a tree for this merge (missing or corrupt objects) — nothing changed");
        return 1;
    }
    if (theirs_entries == 0) {
        eprintln("sit: cannot read a tree for this merge (missing or corrupt objects) — nothing changed");
        return 1;
    }

    var merged = vec_new();
    var conflicts = vec_new();
    three_way_merge_entries(base_entries, ours_entries, theirs_entries, merged, conflicts);

    if (vec_len(conflicts) > 0) {
        if (_apply_conflicted_merge(merged, conflicts, ours_entries, theirs_entries, target_name) != 0) {
            eprintln("sit: merge stopped — HEAD unchanged");
            return 1;
        }
        var ci = 0;
        # Track MERGE_HEAD so the next sit commit produces a 2-parent commit.
        # Unchecked through 1.6.3: a failed write made the resolving commit a
        # one-parent commit that recorded the merge as never having happened.
        if (write_merge_head(&target_hex) != 0) {
            eprintln("sit: cannot write .sit/MERGE_HEAD — the next commit would not record this merge");
            return 1;
        }
        # 1.8.0: a `-m` message waits for the resolving commit, which takes it
        # when given none of its own (git's MERGE_MSG).
        if (merge_msg != 0) {
            if (sf_write_atomic(merge_msg_path(), merge_msg, strlen(merge_msg)) < 0) {
                eprintln("sit: cannot save the merge message — give it to 'sit commit -m' when you commit");
            }
        }

        syscall(SYS_WRITE, STDERR, "sit: merge conflict in ", 23);
        var buf[24];
        var digits = write_decimal(&buf, vec_len(conflicts));
        syscall(SYS_WRITE, STDERR, &buf, digits);
        syscall(SYS_WRITE, STDERR, " file(s):\n", 10);
        ci = 0;
        while (ci < vec_len(conflicts)) {
            syscall(SYS_WRITE, STDERR, "  ", 2);
            var cp2 = vec_get(conflicts, ci);
            syscall(SYS_WRITE, STDERR, cp2, strlen(cp2));
            syscall(SYS_WRITE, STDERR, "\n", 1);
            ci = ci + 1;
        }
        eprintln("sit: edit the marked files, 'sit add' them, then 'sit commit'");
        eprintln("sit:   'sit merge --abort' to cancel and restore the working tree");
        return 1;
    }

    # Clean merge — sort entries, build tree, create 2-parent commit
    sort_entries(merged);
    var tree_hex = build_tree(merged, 0);
    if (tree_hex == 0) {
        eprintln("sit: failed to write merged tree");
        return 1;
    }

    var msg = merge_msg;
    if (msg == 0) {
        var msg_cap = 64 + tnlen + 32;
        msg = alloc_or_die(msg_cap);
        memcpy(msg, "Merge branch '", 14);
        memcpy(msg + 14, target_name, tnlen);
        memcpy(msg + 14 + tnlen, "'", 1);
        store8(msg + 14 + tnlen + 1, 0);
    }

    var head_copy = alloc_or_die(65);
    memcpy(head_copy, head_hex, 64);
    store8(head_copy + 64, 0);

    var merge_seed = 0;
    if (merge_sign == 1) {
        merge_seed = load_signing_seed();
        if (merge_seed == 0) {
            eprintln("sit: no signing key (run 'sit key generate')");
            return 1;
        }
    }
    var merge_hex = build_merge_commit_signed(tree_hex, head_copy, &target_hex, msg, merge_seed);
    if (merge_hex == 0) {
        eprintln("sit: failed to write merge commit");
        return 1;
    }

    # v1.5.1: materialize BEFORE the ref moves. materialize_target removes
    # paths that HEAD's CURRENT tree has and the target's does not, and it
    # finds "current" by reading HEAD — so moving the ref first makes that
    # removal a no-op and leaves stale files on disk. `checkout` already had
    # this order (with a comment saying why); `reset --hard` and `merge` did
    # not, so their stale-file removal had never run. Doing it in this order
    # is also the safer failure mode: a materialize that fails leaves HEAD
    # where it was.
    if (materialize_target_safe(merge_hex, 1) != 0) {
        eprintln("sit: failed to update working tree — HEAD unchanged");
        return 1;
    }
    if (write_head_ref(merge_hex) != 0) {
        eprintln("sit: failed to update branch ref");
        return 1;
    }
    reflog_head_move(head_copy, merge_hex,
      reflog_msg_join("merge ", target_name, ": Merge made by the '3-way' strategy"));

    stdout_write("merge ", 6);
    stdout_write(merge_hex, 12);
    stdout_write(": ", 2);
    _merge_print_subject(msg);
    stdout_write("\n", 1);
    return 0;
}

# The first line of a commit message, display-safe (a `-m` message is the
# user's, but the default one names a ref the user typed).
fn _merge_print_subject(msg) {
    var n = 0;
    var go = 1;
    while (go == 1) {
        var c = load8(msg + n);
        if (c == 0) { go = 0; }
        else {
            if (c == 10) { go = 0; }
            else { n = n + 1; }
        }
    }
    write_sanitized(STDOUT, msg, n);
    return 0;
}

# `.sit/MERGE_MSG`: a `merge -m` message saved at a conflict stop (1.8.0).
fn merge_msg_path() { return ".sit/MERGE_MSG"; }

# The saved `merge -m` message as a heap cstring, or 0: only while a merge is
# in progress (MERGE_HEAD), so a stale file cannot name an ordinary commit.
fn merge_msg_saved() {
    if (sf_exists(".sit/MERGE_HEAD") != 1) { return 0; }
    var pair[16];
    if (read_file_heap(merge_msg_path(), &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var n = load64(&pair + 8);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);                              # read_file_heap leaves a spare byte
    return buf;
}

# Remove a saved merge message; cleared wherever MERGE_HEAD is.
fn merge_msg_clear() {
    if (path_lstat_kind(sit_abs(merge_msg_path())) >= 0) { sf_unlink(merge_msg_path()); }
    return 0;
}

# N-parent (octopus) commit. Same framing as build_merge_commit_signed, with
# one `parent` header per entry of `parents` in order — first parent first, as
# git writes it, so `log --graph` and first-parent walks behave.
fn build_octopus_commit(tree_hex, parents, message, seed) {
    var name = getenv("SIT_AUTHOR_NAME");
    if (name == 0) { name = config_get("user.name"); }
    if (name == 0) { name = "sit user"; }
    var email = getenv("SIT_AUTHOR_EMAIL");
    if (email == 0) { email = config_get("user.email"); }
    if (email == 0) { email = "user@localhost"; }
    # S-27: sanitize the identity BEFORE framing — a newline here forges a
    # header line, and an octopus body has more header lines to forge into.
    name = ident_sanitized(name);
    email = ident_sanitized(email);
    if (strlen(name) == 0) { name = "sit user"; }
    if (strlen(email) == 0) { email = "user@localhost"; }
    var ts = clock_epoch_secs();

    var name_len = strlen(name);
    var email_len = strlen(email);
    var msg_len = strlen(message);
    var np = vec_len(parents);

    var cap = 512 + msg_len + name_len * 2 + email_len * 2 + np * 80;
    var body = alloc_or_die(cap);
    var pos = 0;

    memcpy(body + pos, "tree ", 5); pos = pos + 5;
    memcpy(body + pos, tree_hex, 64); pos = pos + 64;
    store8(body + pos, 10); pos = pos + 1;

    var pi = 0;
    while (pi < np) {
        memcpy(body + pos, "parent ", 7); pos = pos + 7;
        memcpy(body + pos, vec_get(parents, pi), 64); pos = pos + 64;
        store8(body + pos, 10); pos = pos + 1;
        pi = pi + 1;
    }

    memcpy(body + pos, "author ", 7); pos = pos + 7;
    memcpy(body + pos, name, name_len); pos = pos + name_len;
    memcpy(body + pos, " <", 2); pos = pos + 2;
    memcpy(body + pos, email, email_len); pos = pos + email_len;
    memcpy(body + pos, "> ", 2); pos = pos + 2;
    var digits = write_decimal(body + pos, ts); pos = pos + digits;
    memcpy(body + pos, " +0000\n", 7); pos = pos + 7;

    memcpy(body + pos, "committer ", 10); pos = pos + 10;
    memcpy(body + pos, name, name_len); pos = pos + name_len;
    memcpy(body + pos, " <", 2); pos = pos + 2;
    memcpy(body + pos, email, email_len); pos = pos + email_len;
    memcpy(body + pos, "> ", 2); pos = pos + 2;
    digits = write_decimal(body + pos, ts); pos = pos + digits;
    memcpy(body + pos, " +0000\n", 7); pos = pos + 7;

    store8(body + pos, 10); pos = pos + 1;
    memcpy(body + pos, message, msg_len); pos = pos + msg_len;
    store8(body + pos, 10); pos = pos + 1;

    if (seed != 0) {
        var slen[8];
        var signed_body = sign_commit_body(body, pos, seed, &slen);
        if (signed_body == 0) { return 0; }
        return write_typed_object("commit", 6, signed_body, load64(&slen));
    }
    return write_typed_object("commit", 6, body, pos);
}

# `sit merge <a> <b> [<c> ...]` — octopus merge.
#
# git's octopus refuses to produce conflicts, and so does this: each branch is
# folded in against the merge base it shares with the accumulated result, and
# the FIRST conflict aborts the whole thing with nothing written and HEAD
# untouched. A conflicted octopus has no good resolution story — you cannot tell
# which of N sides a marker came from — so refusing and telling the user to
# merge pairwise is the honest outcome, not a limitation to paper over.
# Convert three_way_merge_entries' OUTPUT back into TREE-entry form.
#
# ⚠ The merge takes 24-byte tree entries ([mode, name, hash_hex] — tree.cyr) and
# returns 40-byte index-style entries ([raw hash, path] — index.cyr), because
# `build_tree` consumes the latter. A single merge never notices, but an octopus
# feeds each result back in as `ours` for the next branch, and passing the wrong
# shape makes `tree_find_hash` dereference a raw hash byte as a pointer. That
# segfaulted on the SECOND branch of every octopus merge until this conversion
# was added.
fn _merged_to_tree_entries(merged) {
    var out = vec_new();
    var n = vec_len(merged);
    var i = 0;
    while (i < n) {
        var m = vec_get(merged, i);
        var e = alloc_or_die(24);
        store64(e, "100644");
        store64(e + 8, load64(m + 32));
        store64(e + 16, hex_encode(m, 32));
        vec_push(out, e);
        i = i + 1;
    }
    return out;
}

# ── Unresolved-conflict tracking (1.7.0) ──────────────────────────
#
# A conflict stop records its conflicted paths in .sit/CONFLICTS, one per line.
# `sit commit` and `rebase --continue` refuse while any of them is unresolved;
# a successful commit, `merge --abort`, `rebase --abort` and `reset --hard`
# clear the file. Through 1.6.4 nothing stopped a commit of a file that still
# held `<<<<<<<` markers once it was `sit add`ed — or a commit with nothing
# resolved at all, which silently kept HEAD's side of every conflict.
fn conflicts_path() { return ".sit/CONFLICTS"; }

# Record `paths` (a vec of cstrings) as the unresolved set. 0, or -1.
fn conflicts_record(paths) {
    var n = vec_len(paths);
    var cap = 1;
    var i = 0;
    while (i < n) { cap = cap + strlen(vec_get(paths, i)) + 1; i = i + 1; }
    var buf = alloc_or_die(cap);
    var w = 0;
    i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        var pl = strlen(p);
        memcpy(buf + w, p, pl);
        w = w + pl;
        store8(buf + w, 10);
        w = w + 1;
        i = i + 1;
    }
    if (sf_write_atomic(conflicts_path(), buf, w) < 0) { return 0 - 1; }
    return 0;
}

# Forget the unresolved set (no-op when there is none).
fn conflicts_clear() {
    if (sf_exists(conflicts_path()) == 1) { sf_unlink(conflicts_path()); }
    return 0;
}

# The recorded conflicted paths, or 0 when none are recorded. Lines that are
# not a valid tree path are skipped — the file is sit's own state, and a
# hand-edited junk line must never become a path sit reads or writes.
fn conflicts_list() {
    if (sf_exists(conflicts_path()) != 1) { return 0; }
    var pair[16];
    if (read_file_heap(conflicts_path(), &pair) != 0) { return 0; }
    var buf = load64(&pair);
    var len = load64(&pair + 8);
    var out = vec_new();
    var pos = 0;
    while (pos < len) {
        var e = pos;
        var scanning = 1;
        while (scanning == 1) {
            if (e >= len) { scanning = 0; }
            else {
                if (load8(buf + e) == 10) { scanning = 0; }
                else { e = e + 1; }
            }
        }
        var ll = e - pos;
        if (ll > 0) {
            var p = alloc_or_die(ll + 1);
            memcpy(p, buf + pos, ll);
            store8(p + ll, 0);
            if (tree_flat_path_valid(p) == 1) { vec_push(out, p); }
        }
        pos = e + 1;
    }
    if (vec_len(out) == 0) { return 0; }
    return out;
}

# 1 if a line of buf starts with a conflict marker sit writes ("<<<<<<< " or
# ">>>>>>> "). The bare "=======" separator is NOT tested: it is legitimate
# text (a setext heading underline, say), and the two fences are enough.
fn _has_conflict_marker(buf, len) {
    var pos = 0;
    while (pos + 8 <= len) {
        if (memeq(buf + pos, "<<<<<<< ", 8) == 1) { return 1; }
        if (memeq(buf + pos, ">>>>>>> ", 8) == 1) { return 1; }
        # advance to the next line start
        var going = 1;
        while (going == 1) {
            if (pos >= len) { going = 0; }
            else {
                if (load8(buf + pos) == 10) { going = 0; }
                pos = pos + 1;
            }
        }
    }
    return 0;
}

# 0 when every recorded conflict is resolved and staged; 1 (after naming each
# offender) otherwise. Resolved means: no marker line left in the worktree
# copy or in the staged copy, and the worktree matches what is staged — so a
# fix that was never `sit add`ed cannot be silently replaced by HEAD's side.
fn conflicts_check_resolved() {
    var paths = conflicts_list();
    if (paths == 0) { return 0; }
    var idx = parse_index();
    var bad = 0;
    var n = vec_len(paths);
    var i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        var on_disk = sf_exists(p);
        var ie = 0;
        if (idx != 0) { ie = index_find(idx, p); }
        var problem = 0;
        if (on_disk == 1) {
            var wp[16];
            if (read_file_heap(p, &wp) == 0) {
                if (_has_conflict_marker(load64(&wp), load64(&wp + 8)) == 1) { problem = 1; }
            }
        }
        if (problem == 0) {
            if (ie != 0) {
                var ihex = hex_encode(entry_hash(ie), 32);
                var bp[16];
                if (read_blob_content(ihex, &bp) == 0) {
                    if (_has_conflict_marker(load64(&bp), load64(&bp + 8)) == 1) { problem = 2; }
                }
                if (problem == 0) {
                    if (on_disk == 1) {
                        var wh = hash_file_as_blob(p);
                        if (wh == 0) { problem = 3; }
                        else { if (streq(wh, ihex) == 0) { problem = 3; } }
                    }
                    else { problem = 4; }
                }
            }
            else {
                if (on_disk == 1) { problem = 3; }
            }
        }
        if (problem == 1) { eprint3("sit: '", p, "' still has conflict markers — resolve it, then 'sit add' it\n"); }
        if (problem == 2) {
            eprint3("sit: '", p, "' is staged with conflict markers — resolve it and 'sit add' it again\n");
        }
        if (problem == 3) { eprint3("sit: '", p, "' is resolved but not staged — 'sit add' it\n"); }
        if (problem == 4) { eprint3("sit: '", p, "' was deleted but is still staged — 'sit rm' it or restore it\n"); }
        if (problem != 0) { bad = 1; }
        i = i + 1;
    }
    return bad;
}

# Apply a three-way result that STOPPED on conflicts: worktree, then index.
# Shared by `merge`, `cherry-pick`, `revert` and `rebase` (via cherry-pick).
#
# 1.6.4 (A3): the clean half of a conflicted merge used to reach the worktree
# only. The index stayed at HEAD, and `sit commit` / `rebase --continue` build
# from the index — so after the user resolved the conflicted file and ran `sit
# add` on it, the commit dropped every OTHER change the merge had made cleanly,
# and `sit merge` afterwards said "already up to date". Now the index holds the
# merged content for every clean path and HEAD's version for each conflicted
# one (until `sit add` stages a resolution), and clean deletions leave the
# worktree too. The untracked/symlink preflight runs first, as for any
# materialize; callers have already checked the tracked tree is clean.
# Returns 0, or -1 (after saying why) with nothing written.
fn _apply_conflicted_merge(merged, conflicts, ours_entries, theirs_entries, label) {
    if (_materialize_preflight(_merged_to_tree_entries(merged), ours_entries, 2) != 0) {
        return 0 - 1;
    }
    # 1.7.6 (L3): the preflight covers the cleanly merged paths; the conflicted
    # ones get marker files written over them, so an untracked file at one —
    # a path ours does not track and theirs adds or keeps — is refused here,
    # before anything is written. It was overwritten with markers (git refuses:
    # "untracked working tree files would be overwritten").
    var cq = 0;
    while (cq < vec_len(conflicts)) {
        var qp = vec_get(conflicts, cq);
        if (tree_find(ours_entries, qp) == 0) {
            if (path_lstat_kind(sit_abs(qp)) >= 0) {
                eprint3("sit: untracked file '", qp, "' would be overwritten by the merge — move or remove it first\n");
                return 0 - 1;
            }
        }
        cq = cq + 1;
    }
    # Recorded before any write (1.7.6): if a write below fails, `sit commit`
    # still refuses until these paths are resolved. Recorded after, a failure
    # here left markers on disk with nothing to stop a commit taking them.
    if (conflicts_record(conflicts) != 0) {
        eprintln("sit: cannot record the conflicted paths in .sit/CONFLICTS — nothing changed");
        return 0 - 1;
    }
    var keep = map_new();
    var mi = 0;
    var mn = vec_len(merged);
    while (mi < mn) {
        var me = vec_get(merged, mi);
        var mpath = load64(me + 32);
        map_set(keep, mpath, 1);
        ensure_parent_dirs(mpath);
        var mp[16];
        # S-26: a dropped write or an unreadable blob here leaves a cleanly
        # merged path at its old content while the user is told only about the
        # conflicted ones — say so rather than lose it quietly.
        if (read_blob_content(hex_encode(me, 32), &mp) != 0) {
            eprint3("sit: cannot read the auto-merged content of '", mpath, "' — resolve manually before committing\n");
        }
        else {
            if (sf_write_all(mpath, load64(&mp), load64(&mp + 8)) < 0) {
                eprint3("sit: cannot write auto-merged file '", mpath, "' — resolve manually before committing\n");
            }
        }
        mi = mi + 1;
    }
    var idx = vec_new();
    var mj = 0;
    while (mj < mn) { vec_push(idx, vec_get(merged, mj)); mj = mj + 1; }
    var ci = 0;
    while (ci < vec_len(conflicts)) {
        var cp = vec_get(conflicts, ci);
        map_set(keep, cp, 1);
        if (write_conflict_file(cp, tree_find_hash(ours_entries, cp),
            tree_find_hash(theirs_entries, cp), label) != 0) {
            eprint3("sit: cannot write conflict markers for '", cp, "'\n");
        }
        var oe = tree_find(ours_entries, cp);
        if (oe != 0) {
            var raw = hex_decode(tree_entry_hash(oe), 64);
            if (raw != 0) {
                var ie = alloc_or_die(40);
                memcpy(ie, raw, 32);
                store64(ie + 32, cp);
                vec_push(idx, ie);
            }
        }
        ci = ci + 1;
    }
    # Clean deletions: tracked by HEAD, absent from the result, not conflicted.
    var on = vec_len(ours_entries);
    var oi = 0;
    while (oi < on) {
        var opath = tree_entry_name(vec_get(ours_entries, oi));
        if (map_has(keep, opath) == 0) {
            if (tree_flat_path_valid(opath) == 1) {
                if (sf_exists(opath) == 1) { sf_unlink(opath); }
                _rmdir_empty_parents(opath);
            }
        }
        oi = oi + 1;
    }
    sort_entries(idx);
    if (rewrite_index(idx) != 0) {
        eprintln("sit: cannot stage the merge result — run 'sit status' before committing");
        return 0 - 1;
    }
    return 0;
}

# Merge base for the next octopus branch `t`, given every commit merged so far
# (`parents`: HEAD, then each branch already folded in). 1.6.4: this used the
# PREVIOUS branch's tip alone, so a change HEAD made after that branch forked
# looked "unchanged on ours" and `t` silently overrode it — a revert on main
# could be undone by an octopus merge that a pairwise merge would not undo.
# git's octopus uses the merge base against all of them; here, the candidate
# every other candidate is an ancestor of. Returns the base, 0 for none, or
# -1 when no single best one exists (criss-cross history — refuse).
fn _octopus_base(parents, t) {
    var cands = vec_new();
    var n = vec_len(parents);
    var i = 0;
    while (i < n) {
        var b = find_merge_base(vec_get(parents, i), t);
        if (b != 0) { vec_push(cands, b); }
        i = i + 1;
    }
    var cn = vec_len(cands);
    if (cn == 0) { return 0; }
    var ci = 0;
    while (ci < cn) {
        var c = vec_get(cands, ci);
        var best = 1;
        var cj = 0;
        while (cj < cn) {
            var o = vec_get(cands, cj);
            if (streq(o, c) == 0) {
                if (is_ancestor(o, c) == 0) { best = 0; }
            }
            cj = cj + 1;
        }
        if (best == 1) { return c; }
        ci = ci + 1;
    }
    return 0 - 1;
}

# Octopus arm of `sit merge`: merge two or more branches (`names`, cstrings in
# order) into HEAD in one commit, refusing on any conflict. `message` is a
# `-m` message or 0 for "Merge branches 'a', 'b'"; `sign` is `-S`.
fn cmd_merge_octopus(names, message, sign) {
    var head_hex = read_head_ref();
    if (head_hex == 0) {
        eprintln("sit: no commits yet");
        return 1;
    }
    if (sf_exists(".sit/MERGE_HEAD") == 1) {
        eprintln("sit: a merge is already in progress — resolve it or 'sit merge --abort'");
        return 1;
    }
    # 1.7.6 (L1): the two-way merge refuses here; the octopus path skipped it and
    # then told materialize the check was done, so an uncommitted edit to any
    # tracked file was overwritten with HEAD's version, rc 0 (an A1 regression).
    if (is_dirty() == 1) {
        eprintln("sit: working tree has uncommitted changes — commit or stash them first");
        return 1;
    }

    var parents = vec_new();
    var head_copy = alloc(65);
    memcpy(head_copy, head_hex, 64);
    store8(head_copy + 64, 0);
    vec_push(parents, head_copy);

    # Accumulated result starts as HEAD's tree.
    var acc_entries = commit_tree_entries(head_copy);
    if (acc_entries == 0) {
        eprintln("sit: cannot read HEAD's tree (missing or corrupt objects) — nothing changed");
        return 1;
    }
    var acc_merged = 0;
    var acc_tip = head_copy;

    var ai = 0;
    var nnames = vec_len(names);
    while (ai < nnames) {
        var nm = vec_get(names, ai);
        var thex[72];
        if (resolve_commit_hash(nm, &thex) != 1) {
            syscall(SYS_WRITE, STDERR, "sit: cannot resolve '", 21);
            syscall(SYS_WRITE, STDERR, nm, strlen(nm));
            syscall(SYS_WRITE, STDERR, "'\n", 2);
            return 1;
        }
        var tcopy = alloc(65);
        memcpy(tcopy, &thex, 64);
        store8(tcopy + 64, 0);

        # 1.6.4: skip a branch HEAD or an earlier argument already contains
        # (git: "Already up to date with X"); it used to become a redundant
        # parent — `sit merge b1 b1` wrote three.
        var contained = 0;
        var pi = 0;
        while (pi < vec_len(parents)) {
            if (contained == 0) {
                var pp = vec_get(parents, pi);
                if (streq(pp, tcopy) == 1) { contained = 1; }
                else { if (is_ancestor(tcopy, pp) == 1) { contained = 1; } }
            }
            pi = pi + 1;
        }
        if (contained == 1) {
            eprint3("sit: already up to date with '", nm, "' — skipped\n");
            ai = ai + 1;
            continue;
        }

        var base = _octopus_base(parents, tcopy);
        if (base == 0 - 1) {
            eprint3("sit: octopus merge: no single best merge base for '", nm, "' — merge pairwise instead\n");
            return 1;
        }
        var base_entries = vec_new();
        var tree_bad = 0;
        if (base != 0) {
            var be = commit_tree_entries(base);
            if (be != 0) { base_entries = be; } else { tree_bad = 1; }
        }
        var their_entries = commit_tree_entries(tcopy);
        if (their_entries == 0) { tree_bad = 1; }
        if (tree_bad == 1) {
            eprint3("sit: cannot read a tree for '", nm, "' (missing or corrupt objects) — nothing changed\n");
            return 1;
        }

        var merged = vec_new();
        var conflicts = vec_new();
        three_way_merge_entries(base_entries, acc_entries, their_entries, merged, conflicts);
        if (vec_len(conflicts) > 0) {
            eprint3("sit: octopus merge conflicts on '", nm, "' — nothing written; merge these pairwise instead\n");
            return 1;
        }
        sort_entries(merged);
        # Back to tree shape before it becomes `ours` for the next branch.
        acc_entries = _merged_to_tree_entries(merged);
        acc_merged = merged;
        acc_tip = tcopy;
        vec_push(parents, tcopy);
        ai = ai + 1;
    }

    if (acc_merged == 0) {
        eprintln("sit: octopus merge needs at least one branch");
        return 1;
    }
    # build_tree wants the index-shaped entries, not the tree-shaped ones.
    var tree_hex = build_tree(acc_merged, 0);
    if (tree_hex == 0) {
        eprintln("sit: failed to write merged tree");
        return 1;
    }

    var msg = message;
    if (msg == 0) {
        var msg_cap = 64;
        var ni = 0;
        while (ni < vec_len(names)) { msg_cap = msg_cap + strlen(vec_get(names, ni)) + 4; ni = ni + 1; }
        msg = alloc_or_die(msg_cap);
        var mp = 0;
        memcpy(msg + mp, "Merge branches ", 15); mp = mp + 15;
        ni = 0;
        while (ni < vec_len(names)) {
            if (ni > 0) { memcpy(msg + mp, ", ", 2); mp = mp + 2; }
            store8(msg + mp, 39); mp = mp + 1;
            var one = vec_get(names, ni);
            memcpy(msg + mp, one, strlen(one)); mp = mp + strlen(one);
            store8(msg + mp, 39); mp = mp + 1;
            ni = ni + 1;
        }
        store8(msg + mp, 0);
    }

    # 1.8.0: `-S` reaches the octopus too — any flag used to send the command
    # down the single-branch path, so an octopus could never be signed.
    var oseed = 0;
    if (sign == 1) {
        oseed = load_signing_seed();
        if (oseed == 0) {
            eprintln("sit: no signing key (run 'sit key generate')");
            return 1;
        }
    }
    var oct_hex = build_octopus_commit(tree_hex, parents, msg, oseed);
    if (oct_hex == 0) {
        eprintln("sit: failed to write octopus commit");
        return 1;
    }
    # Materialize before the ref moves — see the note in cmd_merge.
    if (materialize_target_safe(oct_hex, 0) != 0) {        # full preflight, not "already checked"
        eprintln("sit: failed to update working tree — HEAD unchanged");
        return 1;
    }
    if (write_head_ref(oct_hex) != 0) {
        eprintln("sit: failed to update branch ref");
        return 1;
    }
    reflog_head_move(head_copy, oct_hex, reflog_msg_subject("merge: ", msg));
    stdout_write("octopus merge ", 14);
    stdout_write(oct_hex, 12);
    stdout_write(": ", 2);
    _merge_print_subject(msg);
    stdout_write("\n", 1);
    return 0;
}

# --- api.cyr ---

# api.cyr — sit's stable public API surface for Cyrius consumers.
#
# Downstream Cyrius projects consume sit as a dep:
#
#     [deps.sit]
#     git = "https://github.com/MacCracken/sit.git"
#     tag = "0.8.1"
#     modules = ["dist/sit.cyr"]
#
# Stable surface (governed by ADR 0009):
#   - sit_repo_open(cwd)        — open a sit repository, returns 1 / 0
#   - sit_repo_close(repo)      — release the handle (no-op in v0.8.1)
#   - sit_diff_path(repo, path) — HEAD-blob vs working-tree, returns
#                                 an annotated-ops vec (or 0)
#   - ann_kind / ann_line / ann_old / ann_new — accessors on the
#                                 annotated-op records returned by
#                                 sit_diff_path (defined in diff.cyr)
#
# Identifier convention: any name `_`-prefixed is internal and may
# change without notice. Public names use the `sit_` / `ann_` prefix.
# Breaking changes to anything in this file require a major bump.

# Open the sit/git repository at the process's CURRENT WORKING DIRECTORY.
# Returns 1 on success, 0 if the cwd holds neither a `.sit/` nor a `.git/`
# store (or `cwd` is null). `cwd` is retained for API compatibility but is
# now ADVISORY — pass `"."`; the reads are cwd-relative and this call no
# longer chdirs.
#
# v1.3.1: dropped the `syscall(SYS_CHDIR, cwd)`. It was portability-hostile —
# AGNOS's frozen syscall floor has no chdir (nor openat/getcwd), so the raw
# reference hard-failed the `dist/sit-read.cyr` consumer build on `--agnos`
# (regressing a downstream's AGNOS lane). And it was never load-bearing: every
# consumer opens the repo it is already in via `sit_repo_open(".")` (owl's
# gutter markers `src/vcs.cyr`, thoth's status bar, this repo's git_probe
# integration test) — where `chdir(".")` was a no-op. Removing it is
# behavior-preserving for all callers AND makes the read API AGNOS-native. To
# operate on a repo elsewhere, chdir into it before calling (the CLI does).
# Multiple concurrent handles aren't supported — treat the return as an opaque
# token for sit_repo_close / sit_diff_path.
fn sit_repo_open(cwd) {
    if (cwd == 0) { return 0; }
    # Storage seam (roadmap 1.2.0): succeed on a native .sit/ OR an existing
    # .git/ repo at the cwd; _detect_repo_backend sets the process-global backend
    # that read_object / read_head_ref / resolve_ref_name dispatch on. Returns -1
    # when neither store is present.
    # S-26: set the repo root BEFORE probing for the backend.
    #
    # `_detect_repo_backend` probes via `sf_exists(".sit/HEAD")` /
    # `sf_exists(".git/HEAD")`, and `sf_exists` resolves through `sit_abs`,
    # which needs the root. Detecting first meant the probe ran against the
    # PROCESS cwd while every later read resolved against `cwd` — so a consumer
    # passing a real path (rather than ".") detected the backend of whatever
    # directory the process happened to be in. Invisible on Linux today because
    # every in-tree consumer passes "." (which sit_abs treats as no-prefix), and
    # exactly the case AGNOS needs, since it has no cwd at all.
    #
    # On failure the root is cleared again so a rejected open leaves no state
    # behind for the next call.
    # 1.11.0 (R6): drop what the previous repository left cached — its store
    # handle and lock, its index handle, its pack lists — or the new one is
    # read through them. Mappings are keyed by resolved path, so they stay.
    store_repo_reset();
    index_db_reset();
    sit_set_repo_root(cwd);
    _git_pack_forget_last();          # 1.7.6: per repo (see _git_pack_locate)
    if (_detect_repo_backend() < 0) {
        sit_set_repo_root(0);
        return 0;
    }
    return 1;
}

# Release the sit repository handle. v0.8.1: no-op (no per-repo state).
# Reserved for future use; callers should still call it for forward
# compatibility.
fn sit_repo_close(repo) {
    return 0;
}

# Compute the diff between `path`'s HEAD blob and its working-tree contents.
# Returns a vec of annotated-op records (use `ann_kind` / `ann_line` /
# `ann_old` / `ann_new` to inspect each), or 0 if the file is either
# unchanged, absent from both HEAD and the working tree, or the LCS table
# exceeds its cap (16M cells; see diff.cyr P-15).
#
# Shape: ops are line-level (one per old + new line, per LCS edit script).
# `kind` is 0 = keep / 1 = delete (was in HEAD, removed from working) /
# 2 = add (in working, not in HEAD). Caller owns the returned vec.
fn sit_diff_path(repo, path) {
    _api_enter();
    var ops = _sit_diff_path_in(path);
    _api_leave();
    return ops;
}

# 1.11.0: a consumer calls the API for as long as it runs, so the store lock is
# taken per call (a store session, object_db.cyr), not held from the first read
# to exit — `sit gc` can run between calls, and the next call reads what it left.
# A .git/ repository has no sit store lock.
fn _api_enter() {
    if (_repo_backend == 0) { store_enter(); }
    return 0;
}

# The end of an API call: give the store lock back.
fn _api_leave() {
    if (_repo_backend == 0) { store_leave(); }
    return 0;
}

# sit_diff_path's body, inside a store session.
fn _sit_diff_path_in(path) {
    if (path == 0) { return 0; }

    # Resolve HEAD's blob hash for `path`. Treat "no HEAD" / "path absent
    # from HEAD" the same as "old buffer is empty" so an all-added file
    # still yields useful annotations.
    var head_entries = read_head_tree_entries();
    var old_buf = 0;
    var old_len = 0;
    var old_base = 0;
    var obj[24];
    if (head_entries != 0) {
        var he = tree_find(head_entries, path);
        if (he != 0) {
            var head_hex = tree_entry_hash(he);
            if (read_object(head_hex, &obj) == 0) {
                old_base = load64(&obj);
                old_buf = old_base + load64(&obj + 16);
                old_len = load64(&obj + 8) - load64(&obj + 16);
            }
        }
        tree_find_release(head_entries);    # 1.7.6 (R1)
    }

    # Resolve working-tree contents. Path missing from disk → empty new
    # buffer (yields an all-delete diff against HEAD).
    var new_buf = 0;
    var new_len = 0;
    var wp[16];
    if (sf_exists(path) == 1) {
        if (read_file_fl(path, &wp) == 0) {
            new_buf = load64(&wp);
            new_len = load64(&wp + 8);
        }
    }

    # Nothing on either side: no diff to report.
    if (old_buf == 0) {
        if (new_buf == 0) { return 0; }
    }
    # 1.7.6 (R9): unchanged means 0, as documented above. It was diffed anyway —
    # ~160 B per line, so an unchanged 16 MiB file of newlines (16 KB to ship
    # compressed) cost 2.6 GB in the caller's process. Both buffers are freed.
    if (old_buf != 0) {
        if (new_buf != 0) {
            if (old_len == new_len) {
                if (memeq(old_buf, new_buf, old_len) == 1) {
                    fl_free(new_buf);
                    fl_free(old_base);
                    return 0;
                }
            }
        }
    }

    # The ops point into both buffers, so they stay the caller's with the vec —
    # unless there are none (the diff table's cap), when nothing points at them.
    var ops = compute_file_diff(old_buf, old_len, new_buf, new_len);
    if (ops == 0) {
        if (new_buf != 0) { fl_free(new_buf); }
        if (old_base != 0) { fl_free(old_base); }
    }
    return ops;
}

# Return the current branch name for the open repo as a heap cstring (e.g.
# "main"), or 0 if HEAD is detached or not a branch ref. Backend-aware: reads
# .sit/HEAD or .git/HEAD through the storage seam (roadmap 1.2.0), so it works
# on both sit-native and existing git repositories. Caller owns the cstring.
# New public surface (ADR 0009): additive, SemVer-minor.
#
# 1.7.2 (E10): the name is display-safe (text_sanitized): a C1 or bidi control
# in it comes back as '?', since consumers put it straight on screen.
fn sit_repo_branch(repo) {
    var name = current_branch_name();
    if (name == 0) { return 0; }
    var n[8];
    return text_sanitized(name, strlen(name), &n);
}

# A status record is a 16-byte {path_ptr, kind} pair. Internal builder.
fn _status_push(vec, path, kind) {
    var rec = alloc(16);
    store64(rec, path);
    store64(rec + 8, kind);
    vec_push(vec, rec);
    return 0;
}

# Byte-compare a HEAD blob (named by id `hex`) against working file `path`.
# Returns 1 if they differ (or either can't be read), 0 if identical. Uses a
# content compare rather than a re-hash so it needs no hash primitive — which
# is what lets it work on a git SHA-1 repo without a first-party SHA-1.
#
# 1.7.6 (R1): both buffers are freed before returning. The blob (a freelist
# buffer from either backend) and a heap copy of the worktree file were kept
# per file per call — about 10 MB per sit_repo_status on 200 files of 50 KB, in
# the consumer's process, for as long as it ran.
fn _blob_differs_from_file(hex, path) {
    var obj[24];
    if (read_object(hex, &obj) != 0) { return 1; }
    var ob = load64(&obj) + load64(&obj + 16);
    var ol = load64(&obj + 8) - load64(&obj + 16);
    var wp[16];
    if (read_file_fl(path, &wp) != 0) { fl_free(load64(&obj)); return 1; }
    var nb = load64(&wp);
    var nl = load64(&wp + 8);
    var differ = 0;
    if (ol != nl) { differ = 1; }
    else { if (memeq(ob, nb, ol) == 0) { differ = 1; } }
    fl_free(nb);
    fl_free(load64(&obj));
    return differ;
}

# Per-file HEAD-vs-working-tree status for the open repo. Returns a vec of
# opaque status records — read each with sit_status_path / sit_status_kind.
# Kinds: 1 = modified, 2 = new (untracked), 3 = deleted. Unmodified files are
# omitted. Backend-aware (roadmap 1.2.0): works on sit-native and existing git
# repos. v1 scope is HEAD-vs-worktree only — no staging-index (git .git/index /
# sit patra index) staged/unstaged split, and untracked honours the top-level
# ignore file (.gitignore in git mode). New public surface (ADR 0009): additive,
# SemVer-minor. Caller owns the returned vec.
fn sit_repo_status(repo) {
    _api_enter();
    var out = _sit_repo_status_in();
    _api_leave();
    return out;
}

# sit_repo_status's body, inside a store session.
fn _sit_repo_status_in() {
    var out = vec_new();
    var head_entries = read_head_tree_entries();
    var work_files = list_working_files();

    # Tracked files: deleted (gone from disk) or modified (content differs).
    if (head_entries != 0) {
        var hn = vec_len(head_entries);
        var i = 0;
        while (i < hn) {
            var he = vec_get(head_entries, i);
            var path = tree_entry_name(he);
            if (sf_exists(path) != 1) {
                _status_push(out, path, 3);
            }
            else {
                if (_blob_differs_from_file(tree_entry_hash(he), path) == 1) {
                    _status_push(out, path, 1);
                }
            }
            i = i + 1;
        }
    }

    # Working files absent from HEAD are new (untracked).
    var wn = vec_len(work_files);
    var j = 0;
    while (j < wn) {
        var wf = vec_get(work_files, j);
        var tracked = 0;
        if (head_entries != 0) {
            if (tree_find(head_entries, wf) != 0) { tracked = 1; }
        }
        if (tracked == 0) { _status_push(out, wf, 2); }
        j = j + 1;
    }
    if (head_entries != 0) { tree_find_release(head_entries); }   # 1.7.6 (R1)
    return out;
}

# Accessors on a status record (mirror the ann_* pattern; opaque layout).
fn sit_status_path(rec) { return load64(rec); }
# Status kind of a record: 1 = modified, 2 = new (untracked), 3 = deleted.
fn sit_status_kind(rec) { return load64(rec + 8); }
